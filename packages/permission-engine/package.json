{
  "name": "@specforge/permission-engine",
  "version": "1.0.37",
  "description": "Permission Engine module for SpecForge - Fine-grained access control and authorization",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "clean": "bun ../../scripts/clean-workspace.ts --package permission-engine",
    "lint": "node ../../scripts/lint-package.mjs permission-engine",
    "lint:fix": "node ../../scripts/lint-package.mjs permission-engine --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:property": "vitest run tests/property/",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "dev": "concurrently \"bun run build:watch\" \"bun run test:watch\""
  },
  "keywords": [
    "specforge",
    "permission",
    "authorization",
    "access-control",
    "architecture"
  ],
  "author": "SpecForge Team",
  "license": "MIT",
  "dependencies": {
    "@specforge/types": "workspace:*",
    "yaml": "^2.9.0",
    "zod": "^3.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "@vitest/coverage-v8": "^1.0.0",
    "concurrently": "^8.0.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "fast-check": "^3.0.0",
    "prettier": "3.8.3",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/specforge/specforge.git",
    "directory": "permission-engine"
  },
  "bugs": {
    "url": "https://github.com/specforge/specforge/issues"
  },
  "homepage": "https://github.com/specforge/specforge#readme"
}
