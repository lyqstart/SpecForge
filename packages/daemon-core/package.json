{
  "name": "@specforge/daemon-core",
  "version": "1.0.34",
  "description": "Daemon Core module for SpecForge - Central process and Single Source of Truth",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "bin": {
    "specforged": "dist/specforged.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "bun ../../scripts/clean-workspace.ts --package daemon-core",
    "lint": "node ../../scripts/lint-package.mjs daemon-core",
    "lint:fix": "node ../../scripts/lint-package.mjs daemon-core --fix",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage"
  },
  "keywords": [
    "specforge",
    "daemon"
  ],
  "author": "SpecForge Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "@vitest/coverage-v8": "^3.0.7",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "fast-check": "^4.8.0",
    "prettier": "3.8.3",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "@specforge/configuration": "workspace:*",
    "@specforge/permission-engine": "workspace:*",
    "@specforge/service-management": "workspace:*",
    "@specforge/opencode-adapter": "workspace:*",
    "@specforge/workflow-runtime": "workspace:*",
    "@specforge/observability": "workspace:*",
    "@specforge/types": "workspace:*",
    "@specforge/version-unification": "workspace:*",
    "@specforge/host-profile": "workspace:*",
    "typescript": "^5.8.2",
    "uuid": "^11.1.0"
  },
  "specforgeRelease": {
    "cleanBuildIds": [
      "tool:sf_work_item_create",
      "tool:sf_rollback",
      "tool:sf_handoff",
      "tool:sf_verification"
    ]
  },
  "schema_version": "1.0"
}
