{
  "name": "@specforge/scope-gate",
  "version": "1.0.37",
  "description": "Current-release evidence and artifact-set validator for SpecForge",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "schema_version": "1.0",
  "scripts": {
    "build": "rimraf dist && tsc",
    "build:esbuild": "node esbuild.config.js",
    "build:all": "bun run build && bun run build:esbuild",
    "build:watch": "tsc --watch",
    "clean": "bun ../../scripts/clean-workspace.ts --package scope-gate",
    "lint": "node ../../scripts/lint-package.mjs scope-gate",
    "lint:fix": "node ../../scripts/lint-package.mjs scope-gate --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:property": "vitest run tests/property/",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "dev": "concurrently \"bun run build:watch\" \"bun run test:watch\""
  },
  "keywords": [
    "specforge",
    "release",
    "validation",
    "artifacts",
    "architecture"
  ],
  "author": "SpecForge Team",
  "license": "MIT",
  "dependencies": {
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "@vitest/coverage-v8": "^1.0.0",
    "concurrently": "^8.0.0",
    "esbuild": "^0.20.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "fast-check": "^3.0.0",
    "prettier": "3.8.3",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/specforge/specforge.git",
    "directory": "scope-gate"
  },
  "bugs": {
    "url": "https://github.com/specforge/specforge/issues"
  },
  "homepage": "https://github.com/specforge/specforge#readme",
  "specforgeRelease": {
    "packageExportIds": [
      "scope-gate:release-validator"
    ],
    "cleanBuildIds": [
      "scope-gate:release-validator"
    ]
  }
}
