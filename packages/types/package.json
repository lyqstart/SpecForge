{
  "name": "@specforge/types",
  "version": "0.1.0",
  "description": "Shared TypeScript types for SpecForge V6 modules",
  "main": "src/index.ts",
  "types": "dist/index.d.ts",
  "exports": {
    ".": "./src/index.ts",
    "./directory-layout": "./src/directory-layout.ts",
    "./user-level-paths": {
      "types": "./dist/user-level-paths.d.ts",
      "default": "./src/user-level-paths.ts"
    },
    "./actor-roles": "./src/actor-roles.ts",
    "./constants": "./src/constants.ts",
    "./principal": "./src/principal.ts",
    "./permissions": "./src/permissions.ts",
    "./seal-transitions": "./src/seal-transitions.ts"
  },
  "scripts": {
    "build": "tsc",
    "clean": "rm -rf dist"
  },
  "keywords": ["specforge", "types"],
  "author": "SpecForge Team",
  "license": "MIT",
  "dependencies": {
    "zod": "^3.22.4"
  },
  "devDependencies": {
    "typescript": "^5.8.2"
  },
  "schema_version": "1.0",
  "typesVersions": {
    "*": {
      "directory-layout": [
        "dist/directory-layout.d.ts"
      ],
      "user-level-paths": [
        "dist/user-level-paths.d.ts"
      ],
      "*": [
        "dist/*"
      ]
    }
  }
}
