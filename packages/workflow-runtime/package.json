{
  "name": "@specforge/workflow-runtime",
  "version": "1.0.34",
  "schema_version": "1.0",
  "description": "Workflow Runtime module for SpecForge - Implements compositeGate semantics (Property 29)",
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "scripts": {
    "build": "bun ../../scripts/build-workflow-runtime.ts",
    "build:watch": "tsc --watch",
    "clean": "bun ../../scripts/clean-workspace.ts --package workflow-runtime",
    "lint": "node ../../scripts/lint-package.mjs workflow-runtime",
    "lint:fix": "node ../../scripts/lint-package.mjs workflow-runtime --fix",
    "format": "prettier --write \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format:check": "prettier --check \"src/**/*.ts\" \"tests/**/*.ts\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:property": "vitest run tests/property/",
    "test:unit": "vitest run tests/unit/",
    "test:integration": "vitest run tests/integration/",
    "dev": "concurrently \"bun run build:watch\" \"bun run test:watch\""
  },
  "keywords": [
    "specforge",
    "workflow",
    "runtime",
    "compositeGate",
    "architecture"
  ],
  "author": "SpecForge Team",
  "license": "MIT",
  "dependencies": {
    "@specforge/types": "workspace:*",
    "fast-check": "^3.0.0",
    "uuid": "^10.0.0"
  },
  "devDependencies": {
    "@types/node": "^20.0.0",
    "@types/uuid": "^10.0.0",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "@vitest/coverage-v8": "^1.0.0",
    "concurrently": "^8.0.0",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-import": "2.32.0",
    "prettier": "3.8.3",
    "rimraf": "^5.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/specforge/specforge.git",
    "directory": "workflow-runtime"
  },
  "bugs": {
    "url": "https://github.com/specforge/specforge/issues"
  },
  "homepage": "https://github.com/specforge/specforge#readme",
  "exports": {
    ".": {
      "types": "./dist/src/index.d.ts",
      "import": "./dist/src/index.js",
      "require": "./dist/src/index.js"
    }
  },
  "files": [
    "dist/src"
  ]
}
