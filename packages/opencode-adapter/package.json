{
  "name": "@specforge/opencode-adapter",
  "version": "1.0.31",
  "description": "OpenCode Adapter module for SpecForge - Implements LLMKernelAdapter interface for OpenCode",
  "type": "commonjs",
  "main": "dist/index.js",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "README.md"
  ],
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/specforge/specforge.git",
    "directory": "packages/opencode-adapter"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc --watch",
    "clean": "bun ../../scripts/clean-workspace.ts --package opencode-adapter",
    "lint": "node ../../scripts/lint-package.mjs opencode-adapter",
    "lint:fix": "node ../../scripts/lint-package.mjs opencode-adapter --fix",
    "format": "prettier --write src tests",
    "format:check": "prettier --check src tests",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "prepack": "npm run build"
  },
  "keywords": [
    "specforge",
    "opencode",
    "adapter"
  ],
  "author": "SpecForge Team",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.13.14",
    "@typescript-eslint/eslint-plugin": "8.59.3",
    "@typescript-eslint/parser": "8.59.3",
    "@vitest/coverage-v8": "^3.0.7",
    "eslint": "9.39.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-prettier": "5.5.5",
    "fast-check": "^4.8.0",
    "prettier": "3.8.3",
    "typescript": "^5.8.2",
    "vitest": "^3.0.7"
  },
  "dependencies": {
    "@specforge/types": "workspace:*",
    "zod": "^4.4.3"
  },
  "schema_version": "1.0"
}
