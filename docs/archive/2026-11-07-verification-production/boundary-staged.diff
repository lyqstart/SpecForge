 AUTHORITY=SPS-1.0 §9.2.1 / Registry D20
-IMPLEMENTATION_STATUS=D20_NOT_ACCEPTED_D22_SYNTHETIC_ACCEPTED_D23_PRODUCT_INTEGRATION_REQUIRED
