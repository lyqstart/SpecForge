-```typescript
-const engine = new WorkflowEngine();
-
-// Register event handler
-engine.onEvent((event) => {
-  console.log(`[${event.timestamp.toISOString()}] ${event.type}`);
-  
-  switch (event.type) {
-    case 'workflow.created':
