-  if (abortSignal?.aborted) {
-    return false;
-  }
-  
-  const elapsed = Date.now() - startTime;
-  return elapsed < maxTotalTimeoutMs;
-};
-
-// 使用 shouldContinue() 替代 while (true)
-while (shouldContinue()) {
-  // ... 重试逻辑
-}
-
-// 超时退出
