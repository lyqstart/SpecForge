// Product adapter: only the Runtime-private frozen plan shape, fixed paths and D23 limits.
using System;using System.IO;using System.Text;using System.Linq;using System.Collections;using System.Collections.Generic;using System.Security.Cryptography;using System.Web.Script.Serialization;
internal sealed class LpacProductionPlan {
    internal string PlanId,AttemptId,OwnerRoot,AttemptRoot,NodePath,DaemonPath,DaemonHash,Kind,Entry,InlineSource,ConfigPath,ConfigHash;
    internal string[] Argv;internal Dictionary<string,object>[] Files;internal int WallMs;
    internal string JobName {get{return "Local\\SpecForge.Verification.Job."+AttemptId;}}
    internal string MutexName {get{return "Local\\SpecForge.Verification.Owner."+AttemptId;}}
    internal string CancelPath {get{return Path.Combine(OwnerRoot,"cancellations",AttemptId+".json");}}
    internal bool CancellationRequested(){if(!File.Exists(CancelPath))return false;LpacInputIdentity.ValidateFile(CancelPath);Require(new FileInfo(CancelPath).Length<=1024,"CANCEL_SIZE");var value=new JavaScriptSerializer().Deserialize<Dictionary<string,string>>(File.ReadAllText(CancelPath));Require(value.Count==2&&value["plan_id"]==PlanId&&value["attempt_id"]==AttemptId,"CANCEL_IDENTITY");return true;}
    internal string ScriptName {get{return Kind=="node-inline"?"__sf_verification_inline.cjs":Entry;}}
    static string Hash(string path){using(var sha=SHA256.Create())using(var stream=File.OpenRead(path))return BitConverter.ToString(sha.ComputeHash(stream)).Replace("-","").ToLowerInvariant();}
    static bool Same(string a,string b){return String.Equals(Path.GetFullPath(a),Path.GetFullPath(b),StringComparison.OrdinalIgnoreCase);}
    static void Require(bool value,string code){if(!value)throw new InvalidOperationException("PRODUCT_PLAN_"+code);}
    static string Text(Dictionary<string,object> d,string key){object value;Require(d.TryGetValue(key,out value)&&value is string,"FIELD_"+key);return (string)value;}
    static long Integer(Dictionary<string,object> d,string key){object value;Require(d.TryGetValue(key,out value)&&(value is int||value is long),"INTEGER_"+key);return Convert.ToInt64(value);}
    static string ConfigRoot(){string value=Environment.GetEnvironmentVariable("OPENCODE_CONFIG_DIR");if(!String.IsNullOrWhiteSpace(value))return Path.GetFullPath(value);value=Environment.GetEnvironmentVariable("XDG_CONFIG_HOME");return !String.IsNullOrWhiteSpace(value)?Path.Combine(Path.GetFullPath(value),"opencode"):Path.Combine(Environment.GetFolderPath(Environment.SpecialFolder.UserProfile),".config","opencode");}
    static void Relative(string name){Require(!String.IsNullOrEmpty(name)&&!Path.IsPathRooted(name)&&!name.Contains('\\')&&!name.Contains(':'),"RELATIVE_PATH");foreach(string part in name.Split('/'))Require(part.Length!=0&&part!="."&&part!=".."&&!part.EndsWith(".")&&!part.EndsWith(" ")&&part.IndexOfAny(Path.GetInvalidFileNameChars())<0&&!System.Text.RegularExpressions.Regex.IsMatch(part,@"^(con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\.|$)",System.Text.RegularExpressions.RegexOptions.IgnoreCase),"RELATIVE_COMPONENT");Require(!name.Split('/').Any(p=>String.Equals(p,".git",StringComparison.OrdinalIgnoreCase)||String.Equals(p,".specforge",StringComparison.OrdinalIgnoreCase)||String.Equals(p,"node_modules",StringComparison.OrdinalIgnoreCase)),"PROTECTED_INPUT");}
    internal static LpacProductionPlan Read(string file,string expectedHash){
        Require(System.Text.RegularExpressions.Regex.IsMatch(expectedHash??"", "^[a-f0-9]{64}$"),"CONFIG_HASH");
        string owner=Path.Combine(ConfigRoot(),"sf-user","runtime","verification-owner"),full=Path.GetFullPath(file);Guid nonce;
        Require(Same(Path.GetDirectoryName(full),Path.Combine(owner,"native-plans"))&&Path.GetExtension(full)==".json"&&Guid.TryParseExact(Path.GetFileNameWithoutExtension(full),"N",out nonce),"CONFIG_LOCATION");
        LpacInputIdentity.ValidateFile(full);Require(new FileInfo(full).Length<=4*1024*1024&&Hash(full)==expectedHash,"CONFIG_IDENTITY");
        var json=new JavaScriptSerializer{MaxJsonLength=4*1024*1024};var d=json.Deserialize<Dictionary<string,object>>(File.ReadAllText(full,new UTF8Encoding(false,true)));
        string[] keys={"contract","plan_id","attempt_id","owner_root","attempt_root","node_path","node_sha256","daemon_path","daemon_sha256","kind","entry","inline_source","argv","files","profile","wall_ms","memory_bytes","process_limit","output_bytes"};Require(d!=null&&d.Count==keys.Length&&keys.All(k=>d.ContainsKey(k)),"SCHEMA");
        var p=new LpacProductionPlan();p.ConfigPath=full;p.ConfigHash=expectedHash;p.OwnerRoot=owner;p.AttemptId=Text(d,"attempt_id");p.PlanId=Text(d,"plan_id");p.AttemptRoot=Text(d,"attempt_root");p.NodePath=Text(d,"node_path");p.DaemonPath=Text(d,"daemon_path");p.DaemonHash=Text(d,"daemon_sha256");p.Kind=Text(d,"kind");
        Require(Text(d,"contract")=="verification-native-plan/v1"&&Text(d,"profile")=="windows-lpac-node-single-process-readonly/v1"&&Text(d,"owner_root")==owner&&p.AttemptId==Path.GetFileNameWithoutExtension(full)&&System.Text.RegularExpressions.Regex.IsMatch(p.PlanId,"^[a-f0-9]{64}$"),"IDENTITY");
        Require(Same(p.AttemptRoot,Path.Combine(owner,"runs",p.AttemptId))&&Same(p.NodePath,Path.Combine(ConfigRoot(),"sf-user","bin","verification","node.exe"))&&Same(p.DaemonPath,Path.Combine(ConfigRoot(),"sf-user","bin","specforged.exe"))&&System.Text.RegularExpressions.Regex.IsMatch(p.DaemonHash,"^[a-f0-9]{64}$"),"FIXED_ASSET_PATHS");
        Require(Text(d,"node_sha256")=="3602f2bb1a10f2cbab4c36886218a33c1ab3db87290e73b033c46c77147d0237"&&Integer(d,"memory_bytes")==1073741824L&&Integer(d,"process_limit")==1&&Integer(d,"output_bytes")==1048576,"BUDGET");p.WallMs=checked((int)Integer(d,"wall_ms"));Require(p.WallMs>=1&&p.WallMs<=120000,"WALL");
        p.Argv=((IEnumerable)d["argv"]).Cast<object>().Select(v=>{Require(v is string,"ARGV_STRING");return (string)v;}).ToArray();p.Files=((IEnumerable)d["files"]).Cast<Dictionary<string,object>>().ToArray();Require(p.Files.Length<=2048,"FILE_COUNT");
        string[] common={"--no-addons","--preserve-symlinks","--preserve-symlinks-main"};Require(p.Argv.Length>=3&&p.Argv.Take(3).SequenceEqual(common),"NODE_FLAGS");
        if(p.Kind=="node-test-file"){p.Entry=Text(d,"entry");Relative(p.Entry);Require(d["inline_source"]==null&&p.Argv.SequenceEqual(common.Concat(new[]{"--test-reporter=tap","--test","--test-isolation=none",p.Entry})),"FILE_ARGV");}
        else{Require(p.Kind=="node-inline"&&d["entry"]==null,"KIND");p.InlineSource=Text(d,"inline_source");Require(p.InlineSource.Length<=32768&&p.InlineSource.IndexOf('\0')<0&&p.Argv.SequenceEqual(common.Concat(new[]{"-e",p.InlineSource})),"INLINE_ARGV");}
        var names=new HashSet<string>(StringComparer.OrdinalIgnoreCase);long total=0;foreach(var row in p.Files){Require(row.Count==3&&row.ContainsKey("path")&&row.ContainsKey("sha256")&&row.ContainsKey("bytes"),"FILE_SCHEMA");string name=Text(row,"path");Relative(name);Require(names.Add(name)&&System.Text.RegularExpressions.Regex.IsMatch(Text(row,"sha256"),"^[a-f0-9]{64}$"),"FILE_IDENTITY");long size=Integer(row,"bytes");Require(size>=0,"FILE_SIZE");total+=size;Require(total<=16*1024*1024,"INPUT_BUDGET");}
        Require(p.Kind=="node-inline"?!names.Contains(p.ScriptName):names.Contains(p.Entry),"ENTRY");p.CommandLine();return p;
    }
    internal void CopyInputs(string input){
        string source=Path.Combine(OwnerRoot,"input",PlanId);var actual=LpacInputIdentity.ValidateTree(source);Require(actual.Length==Files.Length,"COMPLETE_INPUT_SET");
        foreach(var row in Files){string relative=Text(row,"path"),from=Path.Combine(source,relative),to=Path.Combine(input,relative);var identity=LpacInputIdentity.ValidateFile(from);Require(identity.ContentSha256==Text(row,"sha256")&&new FileInfo(from).Length==Convert.ToInt64(row["bytes"]),"INPUT_DRIFT");Directory.CreateDirectory(Path.GetDirectoryName(to));File.Copy(from,to,false);Require(Hash(to)==Text(row,"sha256"),"COPY_DRIFT");}
        if(Kind=="node-inline")using(var stream=new FileStream(Path.Combine(input,ScriptName),FileMode.CreateNew,FileAccess.Write)){byte[] raw=new UTF8Encoding(false,true).GetBytes(InlineSource);stream.Write(raw,0,raw.Length);}
        Require(Hash(ConfigPath)==ConfigHash,"CONFIG_DRIFT");
    }
    internal string CommandLine(){string result=String.Join(" ",new[]{NodePath}.Concat(Argv).Select(Quote));Require(result.Length<=32766,"COMMAND_LINE_LIMIT");return result;}
    static string Quote(string value){Require(value.IndexOf('\0')<0,"ARGUMENT_NUL");var output=new StringBuilder("\"");int slashes=0;foreach(char c in value){if(c=='\\'){slashes++;continue;}if(c=='"'){output.Append('\\',slashes*2+1);output.Append(c);}else{output.Append('\\',slashes);output.Append(c);}slashes=0;}output.Append('\\',slashes*2);output.Append('"');return output.ToString();}
}

internal static class LpacVerificationMain {
    internal static int Main(string[] args){if(args.Length!=3||!new[]{"--verification-plan","--verification-inspect","--verification-recover"}.Contains(args[0]))return 64;try{var plan=LpacProductionPlan.Read(args[1],args[2]);using(var mutex=new System.Threading.Mutex(false,plan.MutexName)){bool acquired=false;try{try{acquired=mutex.WaitOne(0);}catch(System.Threading.AbandonedMutexException){acquired=true;}if(!acquired)throw new InvalidOperationException("PRODUCT_ATTEMPT_ACTIVE");if(args[0]=="--verification-plan"){if(plan.CancellationRequested())return 130;return LpacStartupPoc.Main(args);}return LpacProductionRecovery.Run(plan,args[0]=="--verification-recover");}finally{if(acquired)mutex.ReleaseMutex();}}}catch(Exception error){Console.Error.WriteLine("VERIFICATION_LAUNCHER_REJECTED:"+error.GetType().Name+":"+error.Message);return 65;}}
}
