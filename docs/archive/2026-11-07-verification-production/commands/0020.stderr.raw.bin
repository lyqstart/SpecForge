function edit(file,expected,changes){const raw=fs.readFileSync(file);if(sha(raw)!==expected)throw Error('SOURCE_DRIFT:'+file);let text=raw.toString();for(const[from,to,count]of changes){if(text.split(from).length-1!==count)throw Error('REPLACEMENT_COUNT:'+from);text=text.split(from).join(to);}const snapshot=path.join(__dirname,'native-adapter-before');fs.mkdirSync(snapshot,{recursive:true});fs.writeFileSync(path.join(snapshot,path.basename(file)),raw,{flag:'wx'});fs.writeFileSync(file,text.replace(/\r\n/g,'\n'));return{file,before:sha(raw),after:sha(fs.readFileSync(file)),changes:changes.map(([from,to,count])=>({from,to,count}))};}
