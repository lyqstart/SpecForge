·)⏎···`","line":197,"column":7,"nodeType":null,"messageId":"replace","endLine":197,"endColumn":200,"fix":{"range":[16575,16768],"text":"\n    !names ||\n    !/^(?:(?:我|I)\\s*)?(采用|同意|批准|确认|accept\\b|approve\\b|confirm\\b|use\\b)/i.test(quote) ||\n    /(不采用|不同意|不批准|不确认|不要|暂不|拒绝|reject|do not|don't|not\\s+(?:accept|approve|confirm|use))/i.test(\n      quote\n    )\n  )\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·planFile·=·path.join(p.owner,·'plans',·input.planSha256·+·'.json');` with `⏎······planFile·=·path.join(p.owner,·'plans',·input.planSha256·+·'.json');⏎···`","line":199,"column":60,"nodeType":null,"messageId":"replace","endLine":199,"endColumn":128,"fix":{"range":[16949,17017],"text":"\n      planFile = path.join(p.owner, 'plans', input.planSha256 + '.json');\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":200,"column":45,"nodeType":null,"messageId":"insert","endLine":200,"endColumn":45,"fix":{"range":[17087,17087],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":201,"column":56,"nodeType":null,"messageId":"insert","endLine":201,"endColumn":56,"fix":{"range":[17199,17199],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `plan.project_root·!==·identity(root)·||·plan.work_item_id·!==·input.workItemId·||·plan.base_branch·!==·input.baseBranch·||·plan.branch_name·!==·input.branchName)` with `⏎······plan.project_root·!==·identity(root)·||⏎······plan.work_item_id·!==·input.workItemId·||⏎······plan.base_branch·!==·input.baseBranch·||⏎······plan.branch_name·!==·input.branchName⏎····)⏎·····`","line":203,"column":9,"nodeType":null,"messageId":"replace","endLine":203,"endColumn":170,"fix":{"range":[17286,17447],"text":"\n      plan.project_root !== identity(root) ||\n      plan.work_item_id !== input.workItemId ||\n      plan.base_branch !== input.baseBranch ||\n      plan.branch_name !== input.branchName\n    )\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `hash(await·fs.readFile(path.join(p.wi,·'work_item.json')))·!==·plan.work_item_metadata_sha256)` with `⏎······hash(await·fs.readFile(path.join(p.wi,·'work_item.json')))·!==·plan.work_item_metadata_sha256⏎····)⏎·····`","line":204,"column":9,"nodeType":null,"messageId":"replace","endLine":204,"endColumn":103,"fix":{"range":[17488,17582],"text":"\n      hash(await fs.readFile(path.join(p.wi, 'work_item.json'))) !== plan.work_item_metadata_sha256\n    )\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·await·noLinks(attempt);` with `⏎····await·noLinks(attempt);⏎···`","line":205,"column":58,"nodeType":null,"messageId":"replace","endLine":205,"endColumn":82,"fix":{"range":[17674,17698],"text":"\n    await noLinks(attempt);\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":206,"column":56,"nodeType":null,"messageId":"insert","endLine":206,"endColumn":56,"fix":{"range":[17800,17800],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace ``refs/heads/${plan.base_branch}·${plan.expected_head}`,·`refs/heads/${plan.branch_name}·${plan.expected_head}`` with `⏎······`refs/heads/${plan.base_branch}·${plan.expected_head}`,⏎······`refs/heads/${plan.branch_name}·${plan.expected_head}`,⏎····`","line":207,"column":19,"nodeType":null,"messageId":"replace","endLine":207,"endColumn":129,"fix":{"range":[17841,17951],"text":"\n      `refs/heads/${plan.base_branch} ${plan.expected_head}`,\n      `refs/heads/${plan.branch_name} ${plan.expected_head}`,\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(plan.source.refs.trim().split('\\n').filter(Boolean).concat(refs)).sort()` with `plan.source.refs⏎······.trim()⏎······.split('\\n')⏎······.filter(Boolean)⏎······.concat(refs)⏎······.sort()⏎······`","line":208,"column":23,"nodeType":null,"messageId":"replace","endLine":208,"endColumn":96,"fix":{"range":[17976,18049],"text":"plan.source.refs\n      .trim()\n      .split('\\n')\n      .filter(Boolean)\n      .concat(refs)\n      .sort()\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·schema_version:·'1.0',·work_item_id:·input.workItemId,·git_enabled:·true,` with `⏎······schema_version:·'1.0',⏎······work_item_id:·input.workItemId,⏎······git_enabled:·true,⏎·····`","line":209,"column":22,"nodeType":null,"messageId":"replace","endLine":209,"endColumn":96,"fix":{"range":[18083,18157],"text":"\n      schema_version: '1.0',\n      work_item_id: input.workItemId,\n      git_enabled: true,\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·base_commit:·plan.expected_head,·branch_relationship:·'primary',` with `⏎······base_commit:·plan.expected_head,⏎······branch_relationship:·'primary',⏎·····`","line":210,"column":37,"nodeType":null,"messageId":"replace","endLine":210,"endColumn":102,"fix":{"range":[18225,18290],"text":"\n      base_commit: plan.expected_head,\n      branch_relationship: 'primary',\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·merge_policy:·'requires_user_confirmation',·created_at:·plan.created_utc` with `⏎······merge_policy:·'requires_user_confirmation',⏎······created_at:·plan.created_utc,⏎···`","line":211,"column":37,"nodeType":null,"messageId":"replace","endLine":211,"endColumn":110,"fix":{"range":[18346,18419],"text":"\n      merge_policy: 'requires_user_confirmation',\n      created_at: plan.created_utc,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `source.index_sha256·!==·plan.source.index_sha256·||·source.config_sha256·!==·plan.source.config_sha256·||·document(source.tracked)·!==·document(plan.source.tracked))` with `⏎········source.index_sha256·!==·plan.source.index_sha256·||⏎········source.config_sha256·!==·plan.source.config_sha256·||⏎········document(source.tracked)·!==·document(plan.source.tracked)⏎······)⏎·······`","line":214,"column":11,"nodeType":null,"messageId":"replace","endLine":214,"endColumn":176,"fix":{"range":[18542,18707],"text":"\n        source.index_sha256 !== plan.source.index_sha256 ||\n        source.config_sha256 !== plan.source.config_sha256 ||\n        document(source.tracked) !== document(plan.source.tracked)\n      )\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·······`","line":220,"column":20,"nodeType":null,"messageId":"insert","endLine":220,"endColumn":20,"fix":{"range":[19177,19177],"text":"\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `bound·&&·actualRefs·!==·finalRefs` with `(bound·&&·actualRefs·!==·finalRefs)`","line":221,"column":36,"nodeType":null,"messageId":"replace","endLine":221,"endColumn":69,"fix":{"range":[19297,19330],"text":"(bound && actualRefs !== finalRefs)"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `source.head_sha256·!==·(bound·?·hash(`ref:·refs/heads/${plan.branch_name}\\n`)·:·plan.source.head_sha256))` with `⏎········source.head_sha256·!==⏎········(bound·?·hash(`ref:·refs/heads/${plan.branch_name}\\n`)·:·plan.source.head_sha256)⏎······)⏎·······`","line":222,"column":11,"nodeType":null,"messageId":"replace","endLine":222,"endColumn":116,"fix":{"range":[19370,19475],"text":"\n        source.head_sha256 !==\n        (bound ? hash(`ref: refs/heads/${plan.branch_name}\\n`) : plan.source.head_sha256)\n      )\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `await·exists(p.context)·&&·(await·fs.readFile(p.context,·'utf8')·!==·document(context)·||·!bound·||·actualRefs·!==·finalRefs))` with `⏎········(await·exists(p.context))·&&⏎········((await·fs.readFile(p.context,·'utf8'))·!==·document(context)·||⏎··········!bound·||⏎··········actualRefs·!==·finalRefs)⏎······)⏎·······`","line":223,"column":11,"nodeType":null,"messageId":"replace","endLine":223,"endColumn":137,"fix":{"range":[19514,19640],"text":"\n        (await exists(p.context)) &&\n        ((await fs.readFile(p.context, 'utf8')) !== document(context) ||\n          !bound ||\n          actualRefs !== finalRefs)\n      )\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `await·exists(intent)·&&·(current.refsDone·||·current.bound·||·await·exists(p.context)))` with `(await·exists(intent))·&&·(current.refsDone·||·current.bound·||·(await·exists(p.context))))⏎·····`","line":228,"column":10,"nodeType":null,"messageId":"replace","endLine":228,"endColumn":97,"fix":{"range":[19826,19913],"text":"(await exists(intent)) && (current.refsDone || current.bound || (await exists(p.context))))\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `await·exists(intent))·await·durable(intent,·document({·schema_version:·'1.0',·plan_sha256:·input.planSha256,·user_response_quote:·quote,·head_lease_nonce:·randomUUID(),·created_utc:·new·Date().toISOString()·})` with `(await·exists(intent)))⏎······await·durable(⏎········intent,⏎········document({⏎··········schema_version:·'1.0',⏎··········plan_sha256:·input.planSha256,⏎··········user_response_quote:·quote,⏎··········head_lease_nonce:·randomUUID(),⏎··········created_utc:·new·Date().toISOString(),⏎········})⏎······`","line":229,"column":10,"nodeType":null,"messageId":"replace","endLine":229,"endColumn":219,"fix":{"range":[19959,20168],"text":"(await exists(intent)))\n      await durable(\n        intent,\n        document({\n          schema_version: '1.0',\n          plan_sha256: input.planSha256,\n          user_response_quote: quote,\n          head_lease_nonce: randomUUID(),\n          created_utc: new Date().toISOString(),\n        })\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·await·noLinks(intent);·const·prior·=·JSON.parse(await·fs.readFile(intent,·'utf8'));·if·(prior.schema_version·!==·'1.0'·||·prior.plan_sha256·!==·input.planSha256·||·prior.user_response_quote·!==·quote)·fail('INTENT_DRIFT');` with `⏎······await·noLinks(intent);⏎······const·prior·=·JSON.parse(await·fs.readFile(intent,·'utf8'));⏎······if·(⏎········prior.schema_version·!==·'1.0'·||⏎········prior.plan_sha256·!==·input.planSha256·||⏎········prior.user_response_quote·!==·quote⏎······)⏎········fail('INTENT_DRIFT');⏎···`","line":230,"column":11,"nodeType":null,"messageId":"replace","endLine":230,"endColumn":234,"fix":{"range":[20181,20404],"text":"\n      await noLinks(intent);\n      const prior = JSON.parse(await fs.readFile(intent, 'utf8'));\n      if (\n        prior.schema_version !== '1.0' ||\n        prior.plan_sha256 !== input.planSha256 ||\n        prior.user_response_quote !== quote\n      )\n        fail('INTENT_DRIFT');\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":237,"column":56,"nodeType":null,"messageId":"insert","endLine":237,"endColumn":56,"fix":{"range":[20927,20927],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·schema_version:·'1.0',·owner:·'specforge_git_bootstrap',·pid:·process.pid,·nonce:·leaseNonce,·plan_sha256:·input.planSha256` with `⏎······schema_version:·'1.0',⏎······owner:·'specforge_git_bootstrap',⏎······pid:·process.pid,⏎······nonce:·leaseNonce,⏎······plan_sha256:·input.planSha256,⏎···`","line":238,"column":31,"nodeType":null,"messageId":"replace","endLine":238,"endColumn":155,"fix":{"range":[20983,21107],"text":"\n      schema_version: '1.0',\n      owner: 'specforge_git_bootstrap',\n      pid: process.pid,\n      nonce: leaseNonce,\n      plan_sha256: input.planSha256,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·await·durable(headLock,·headToken);·}` with `⏎······await·durable(headLock,·headToken);`","line":239,"column":10,"nodeType":null,"messageId":"replace","endLine":239,"endColumn":48,"fix":{"range":[21121,21159],"text":"\n      await durable(headLock, headToken);"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `·}`","line":240,"column":4,"nodeType":null,"messageId":"insert","endLine":240,"endColumn":4,"fix":{"range":[21163,21163],"text":" }"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":242,"column":55,"nodeType":null,"messageId":"insert","endLine":242,"endColumn":55,"fix":{"range":[21287,21287],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·held·=·JSON.parse(headToken);·}·catch·{·fail('HEAD_LEASE_UNKNOWN');` with `⏎········held·=·JSON.parse(headToken);⏎······}·catch·{⏎········fail('HEAD_LEASE_UNKNOWN');⏎·····`","line":243,"column":12,"nodeType":null,"messageId":"replace","endLine":243,"endColumn":80,"fix":{"range":[21314,21382],"text":"\n        held = JSON.parse(headToken);\n      } catch {\n        fail('HEAD_LEASE_UNKNOWN');\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `held.schema_version·!==·'1.0'·||·held.owner·!==·'specforge_git_bootstrap'·||·held.nonce·!==·leaseNonce·||·held.plan_sha256·!==·input.planSha256·||·!Number.isSafeInteger(held.pid)·||·held.pid·<·1)` with `⏎········held.schema_version·!==·'1.0'·||⏎········held.owner·!==·'specforge_git_bootstrap'·||⏎········held.nonce·!==·leaseNonce·||⏎········held.plan_sha256·!==·input.planSha256·||⏎········!Number.isSafeInteger(held.pid)·||⏎········held.pid·<·1⏎······)⏎·······`","line":244,"column":11,"nodeType":null,"messageId":"replace","endLine":244,"endColumn":206,"fix":{"range":[21395,21590],"text":"\n        held.schema_version !== '1.0' ||\n        held.owner !== 'specforge_git_bootstrap' ||\n        held.nonce !== leaseNonce ||\n        held.plan_sha256 !== input.planSha256 ||\n        !Number.isSafeInteger(held.pid) ||\n        held.pid < 1\n      )\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·try·{·process.kill(held.pid,·0);·}·catch·(error:·any)·{·if·(error.code·===·'ESRCH')·dead·=·true;` with `⏎······try·{⏎········process.kill(held.pid,·0);⏎······}·catch·(error:·any)·{⏎········if·(error.code·===·'ESRCH')·dead·=·true;⏎·····`","line":245,"column":24,"nodeType":null,"messageId":"replace","endLine":245,"endColumn":121,"fix":{"range":[21642,21739],"text":"\n      try {\n        process.kill(held.pid, 0);\n      } catch (error: any) {\n        if (error.code === 'ESRCH') dead = true;\n     "}},{"ruleId":"@typescript-eslint/no-unsafe-argument","severity":2,"message":"Unsafe argument of type `any` assigned to a parameter of type `number`.","line":245,"column":44,"nodeType":"MemberExpression","messageId":"unsafeArgument","endLine":245,"endColumn":52},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `audit,·JSON.stringify({·event:·'owned_head_lease_reclaimed',·utc:·new·Date().toISOString(),·previous:·held,·raw_sha256:·hash(headToken)·})·+·'\\n'` with `⏎········audit,⏎········JSON.stringify({⏎··········event:·'owned_head_lease_reclaimed',⏎··········utc:·new·Date().toISOString(),⏎··········previous:·held,⏎··········raw_sha256:·hash(headToken),⏎········})·+·'\\n'⏎······`","line":247,"column":27,"nodeType":null,"messageId":"replace","endLine":247,"endColumn":172,"fix":{"range":[21810,21955],"text":"\n        audit,\n        JSON.stringify({\n          event: 'owned_head_lease_reclaimed',\n          utc: new Date().toISOString(),\n          previous: held,\n          raw_sha256: hash(headToken),\n        }) + '\\n'\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·await·options?.onCheckpoint?.('head_lease_acquired');` with `⏎······await·options?.onCheckpoint?.('head_lease_acquired');⏎·····`","line":250,"column":31,"nodeType":null,"messageId":"replace","endLine":250,"endColumn":85,"fix":{"range":[22004,22058],"text":"\n      await options?.onCheckpoint?.('head_lease_acquired');\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `root,·['update-ref',·'--stdin'],·receipts,·audit,·`start\\ncreate·refs/heads/${plan.base_branch}·${plan.expected_head}\\ncreate·refs/heads/${plan.branch_name}·${plan.expected_head}\\nprepare\\ncommit\\n`` with `⏎··········root,⏎··········['update-ref',·'--stdin'],⏎··········receipts,⏎··········audit,⏎··········`start\\ncreate·refs/heads/${plan.base_branch}·${plan.expected_head}\\ncreate·refs/heads/${plan.branch_name}·${plan.expected_head}\\nprepare\\ncommit\\n`⏎········`","line":252,"column":26,"nodeType":null,"messageId":"replace","endLine":252,"endColumn":224,"fix":{"range":[22140,22338],"text":"\n          root,\n          ['update-ref', '--stdin'],\n          receipts,\n          audit,\n          `start\\ncreate refs/heads/${plan.base_branch} ${plan.expected_head}\\ncreate refs/heads/${plan.branch_name} ${plan.expected_head}\\nprepare\\ncommit\\n`\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·······`","line":253,"column":55,"nodeType":null,"messageId":"insert","endLine":253,"endColumn":55,"fix":{"range":[22395,22395],"text":"\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·········`","line":256,"column":60,"nodeType":null,"messageId":"insert","endLine":256,"endColumn":60,"fix":{"range":[22516,22516],"text":"\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·await·noLinks(readyHead);·if·(await·fs.readFile(readyHead,·'utf8')·!==·newHead)·fail('HEAD_STAGE_DRIFT');·}⏎·······` with `⏎··········await·noLinks(readyHead);⏎··········if·((await·fs.readFile(readyHead,·'utf8'))·!==·newHead)·fail('HEAD_STAGE_DRIFT');⏎········}`","line":257,"column":39,"nodeType":null,"messageId":"replace","endLine":258,"endColumn":8,"fix":{"range":[22606,22722],"text":"\n          await noLinks(readyHead);\n          if ((await fs.readFile(readyHead, 'utf8')) !== newHead) fail('HEAD_STAGE_DRIFT');\n        }"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `audit,·JSON.stringify({·event:·'head_published',·utc:·new·Date().toISOString(),·expected_old_sha256:·plan.source.head_sha256,·new_sha256:·hash(newHead),·method:·'atomic·rename·while·owning·Git·HEAD.lock'·})·+·'\\n'` with `⏎··········audit,⏎··········JSON.stringify({⏎············event:·'head_published',⏎············utc:·new·Date().toISOString(),⏎············expected_old_sha256:·plan.source.head_sha256,⏎············new_sha256:·hash(newHead),⏎············method:·'atomic·rename·while·owning·Git·HEAD.lock',⏎··········})·+·'\\n'⏎········`","line":261,"column":29,"nodeType":null,"messageId":"replace","endLine":261,"endColumn":242,"fix":{"range":[22880,23093],"text":"\n          audit,\n          JSON.stringify({\n            event: 'head_published',\n            utc: new Date().toISOString(),\n            expected_old_sha256: plan.source.head_sha256,\n            new_sha256: hash(newHead),\n            method: 'atomic rename while owning Git HEAD.lock',\n          }) + '\\n'\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `await·fs.readFile(headLock,·'utf8')·!==·headToken)·fail('HEAD_LEASE_DRIFT');` with `(await·fs.readFile(headLock,·'utf8'))·!==·headToken)·fail('HEAD_LEASE_DRIFT');⏎·····`","line":266,"column":11,"nodeType":null,"messageId":"replace","endLine":266,"endColumn":87,"fix":{"range":[23213,23289],"text":"(await fs.readFile(headLock, 'utf8')) !== headToken) fail('HEAD_LEASE_DRIFT');\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `await·exists(p.context))` with `(await·exists(p.context)))`","line":268,"column":10,"nodeType":null,"messageId":"replace","endLine":268,"endColumn":34,"fix":{"range":[23332,23356],"text":"(await exists(p.context)))"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·const·stage·=·path.join(attempt,·'git-context.ready.json');` with `⏎······const·stage·=·path.join(attempt,·'git-context.ready.json');⏎·····`","line":269,"column":21,"nodeType":null,"messageId":"replace","endLine":269,"endColumn":81,"fix":{"range":[23379,23439],"text":"\n      const stage = path.join(attempt, 'git-context.ready.json');\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":271,"column":41,"nodeType":null,"messageId":"insert","endLine":271,"endColumn":41,"fix":{"range":[23568,23568],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·schema_version:·'1.0',·success:·true,·work_item_id:·input.workItemId,·bootstrap_mode:·'verified_detached_commit',` with `⏎······schema_version:·'1.0',⏎······success:·true,⏎······work_item_id:·input.workItemId,⏎······bootstrap_mode:·'verified_detached_commit',⏎·····`","line":274,"column":21,"nodeType":null,"messageId":"replace","endLine":274,"endColumn":135,"fix":{"range":[23662,23776],"text":"\n      schema_version: '1.0',\n      success: true,\n      work_item_id: input.workItemId,\n      bootstrap_mode: 'verified_detached_commit',\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·base_branch:·plan.base_branch,·base_commit:·plan.expected_head,` with `⏎······base_branch:·plan.base_branch,⏎······base_commit:·plan.expected_head,⏎·····`","line":275,"column":37,"nodeType":null,"messageId":"replace","endLine":275,"endColumn":101,"fix":{"range":[23854,23918],"text":"\n      base_branch: plan.base_branch,\n      base_commit: plan.expected_head,\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·tracked_bytes_unchanged:·true,·new_commit_created:·false,·old_branch_restoration_claimed:·false` with `⏎······tracked_bytes_unchanged:·true,⏎······new_commit_created:·false,⏎······old_branch_restoration_claimed:·false,⏎···`","line":276,"column":29,"nodeType":null,"messageId":"replace","endLine":276,"endColumn":125,"fix":{"range":[24019,24115],"text":"\n      tracked_bytes_unchanged: true,\n      new_commit_created: false,\n      old_branch_restoration_claimed: false,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":277,"column":64,"nodeType":null,"messageId":"insert","endLine":277,"endColumn":64,"fix":{"range":[24182,24182],"text":"\n   "}}],"suppressedMessages":[],"errorCount":151,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":139,"fixableWarningCount":0,"source":"import { SPEC_DIR_NAME } from \"@specforge/types/directory-layout\";\nimport * as fs from 'node:fs/promises';\nimport * as path from 'node:path';\nimport { spawn } from 'node:child_process';\nimport { createHash, randomUUID } from 'node:crypto';\nimport { validateWorkItemId } from './work-item-id-validator';\nimport { readWorkItemMetadata } from './work-item-metadata';\n\ntype CommandReceipt = { args: string[]; cwd: string; started_utc: string; finished_utc: string; inner_exit_code: number; stdout: string; stderr: string; stdin?: string };\ntype TrackedFile = { path: string; mode: string; object_id: string; sha256: string; size: number };\ntype Source = { head: string; head_sha256: string; refs: string; index_sha256: string; config_sha256: string; tracked: TrackedFile[] };\ninterface Plan {\n  schema_version: '1.0'; project_root: string; work_item_id: string; base_branch: string; branch_name: string;\n  expected_head: string; created_utc: string; source: Source; probe_commands: CommandReceipt[];\n  work_item_metadata_sha256: string;\n}\nexport interface DetachedBranchPlanInput { projectRoot: string; workItemId: string; baseBranch: string; branchName: string; expectedHead: string }\nexport interface DetachedBranchCreateInput { projectRoot: string; workItemId: string; baseBranch: string; branchName: string; planSha256: string; confirmationQuote: string }\nconst hash = (value: string | Buffer, algorithm = 'sha256') => createHash(algorithm).update(value).digest('hex');\nconst document = (value: unknown) => JSON.stringify(value, null, 2) + '\\n';\nconst nullDevice = process.platform === 'win32' ? 'NUL' : '/dev/null';\nfunction fail(code: string): never { throw new Error(`DETACHED_GIT_BOOTSTRAP_${code}`); }\nconst exists = (file: string) => fs.lstat(file).then(() => true, error => { if (error.code === 'ENOENT') return false; throw error; });\nconst identity = (root: string) => process.platform === 'win32' ? path.resolve(root).toLowerCase() : path.resolve(root);\nasync function noLinks(file: string) {\n  const absolute = path.resolve(file); let cursor = path.parse(absolute).root;\n  for (const part of absolute.slice(cursor.length).split(path.sep).filter(Boolean)) {\n    cursor = path.join(cursor, part); if (!await exists(cursor)) continue;\n    const stat = await fs.lstat(cursor);\n    if (stat.isSymbolicLink() || (!stat.isDirectory() && (!stat.isFile() || stat.nlink !== 1))) fail('LINK_OR_SPECIAL_FILE');\n  }\n}\nfunction safePath(relative: string) {\n  if (!relative || relative.includes('\\\\') || path.isAbsolute(relative) || relative.split('/').some(part =>\n    !part || part === '.' || part === '..' || /[<>:\"|?*\\x00-\\x1f]/.test(part) || /[. ]$/.test(part) || /^(con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$)/i.test(part))) fail('UNSAFE_PATH');\n}\nfunction checkId(value: string) { if (validateWorkItemId(value)) fail('WORK_ITEM_ID_INVALID'); }\nfunction validPlan(value: any): value is Plan {\n  if (!value || typeof value !== 'object' || Array.isArray(value) || value.schema_version !== '1.0') return false;\n  const keys = ['schema_version', 'project_root', 'work_item_id', 'base_branch', 'branch_name', 'expected_head', 'created_utc', 'source', 'probe_commands', 'work_item_metadata_sha256'];\n  if (Object.keys(value).some(key => !keys.includes(key)) || keys.some(key => !(key in value))) return false;\n  if (['project_root', 'work_item_id', 'base_branch', 'branch_name', 'created_utc'].some(key => typeof value[key] !== 'string' || !value[key])) return false;\n  const source = value.source;\n  if (!/^[a-f0-9]{40}$/.test(value.expected_head) || !/^[a-f0-9]{64}$/.test(value.work_item_metadata_sha256) ||\n    !source || source.head !== value.expected_head || typeof source.refs !== 'string' || source.refs.split('\\n').some((ref: string) => ref.startsWith('refs/heads/')) ||\n    ['head_sha256', 'index_sha256', 'config_sha256'].some(key => !/^[a-f0-9]{64}$/.test(source[key])) || !Array.isArray(source.tracked) ||\n    source.tracked.some((file: any) => !file || typeof file.path !== 'string' || !['100644', '100755'].includes(file.mode) || !/^[a-f0-9]{40}$/.test(file.object_id) || !/^[a-f0-9]{64}$/.test(file.sha256) || !Number.isSafeInteger(file.size) || file.size < 0)) return false;\n  return Array.isArray(value.probe_commands) && value.probe_commands.every((receipt: any) => receipt && Array.isArray(receipt.args) &&\n    receipt.args.every((arg: unknown) => typeof arg === 'string') && typeof receipt.cwd === 'string' && Number.isInteger(receipt.inner_exit_code) &&\n    typeof receipt.stdout === 'string' && typeof receipt.stderr === 'string' && Number.isFinite(Date.parse(receipt.started_utc)) && Number.isFinite(Date.parse(receipt.finished_utc)));\n}\nasync function durable(file: string, bytes: string) {\n  await noLinks(file); const handle = await fs.open(file, 'wx');\n  try { await handle.writeFile(bytes); await handle.sync(); } finally { await handle.close(); }\n}\nasync function marker(file: string, value: unknown) {\n  const raw = document(value); await noLinks(file);\n  if (await exists(file)) { if (await fs.readFile(file, 'utf8') !== raw) fail('MARKER_DRIFT'); return; }\n  await durable(file, raw);\n}\nfunction paths(root: string, id: string) {\n  checkId(id);\n  const wi = path.join(root, (`${SPEC_DIR_NAME}/work-items` as const), id);\n  return { wi, owner: path.join(wi, 'git_bootstrap'), context: path.join(wi, 'git_context.json'), runtime: path.join(root, (`${SPEC_DIR_NAME}/runtime` as const)) };\n}\nexport async function withGitBranchMutationLease<T>(root: string, id: string, action: () => Promise<T>): Promise<T> {\n  checkId(id);\n  // Linked worktrees retain legacy behavior and are ineligible for bootstrap.\n  if (!await exists(path.join(root, '.git')) || !(await fs.lstat(path.join(root, '.git'))).isDirectory()) return action();\n  const directory = path.join(root, '.git/specforge-branch-leases');\n  await noLinks(directory); await fs.mkdir(directory, { recursive: true });\n  const nonce = randomUUID(), file = path.join(directory, nonce + '.json');\n  const token = document({ schema_version: '1.0', pid: process.pid, nonce, created_utc: new Date().toISOString() }); await durable(file, token);\n  try {\n    // Per-attempt leases avoid a stale-lock rename race. Dead leases are kept\n    // byte-for-byte; a live/unknown foreign lease always blocks execution.\n    for (const name of await fs.readdir(directory)) {\n      if (name === nonce + '.json') continue;\n      const other = path.join(directory, name); await noLinks(other);\n      let holder: { schema_version: string; pid: number; nonce: string };\n      try { holder = JSON.parse(await fs.readFile(other, 'utf8')); } catch (error: any) { if (error.code === 'ENOENT') continue; fail('LOCK_UNKNOWN'); }\n      if (holder.schema_version !== '1.0' || !Number.isSafeInteger(holder.pid) || holder.pid < 1 || !holder.nonce) fail('LOCK_UNKNOWN');\n      let dead = false; try { process.kill(holder.pid, 0); } catch (error: any) { if (error.code === 'ESRCH') dead = true; }\n      if (!dead) fail('BUSY');\n    }\n    return await action();\n  } finally { if (await fs.readFile(file, 'utf8') !== token) fail('LOCK_DRIFT'); await fs.unlink(file); }\n}\n\nasync function git(root: string, args: string[], receipts: CommandReceipt[], audit?: string, stdin?: string) {\n  const started = new Date().toISOString();\n  const environment = Object.fromEntries(Object.entries(process.env).filter(([key]) => !/^GIT_/i.test(key)));\n  Object.assign(environment, { GIT_CONFIG_NOSYSTEM: '1', GIT_CONFIG_GLOBAL: nullDevice, GIT_OPTIONAL_LOCKS: '0', GIT_TERMINAL_PROMPT: '0', GIT_NO_LAZY_FETCH: '1' });\n  const argv = ['--no-pager', '-c', 'protocol.allow=never', '-c', `core.hooksPath=${nullDevice}`, '-c', 'user.name=SpecForge Git Owner', '-c', 'user.email=specforge@localhost.invalid', '-c', 'core.fsmonitor=false', '-c', 'gc.auto=0', ...args];\n  if (audit) await fs.appendFile(audit, JSON.stringify({ event: 'command_started', args: argv, cwd: root, started_utc: started, stdin,\n    expected_writes: args[0] === 'update-ref' || args[0] === 'symbolic-ref' && args.length > 2 ? 'Git refs/HEAD only' : 'Read-only; optional index refresh disabled' }) + '\\n');\n  const result = await new Promise<{ code: number; stdout: string; stderr: string }>(resolve => {\n    const child = spawn('git', argv, { cwd: root, env: environment, windowsHide: true, stdio: ['pipe', 'pipe', 'pipe'] });\n    let stdout = '', stderr = '', settled = false;\n    const finish = (code: number) => { if (!settled) { settled = true; clearTimeout(timer); resolve({ code, stdout, stderr }); } };\n    const timer = setTimeout(() => { stderr += '\\nGIT_TIMEOUT'; child.kill(); }, 30000);\n    child.stdout.on('data', chunk => { stdout += chunk; if (stdout.length > 16 * 1024 * 1024) { stderr += '\\nOUTPUT_LIMIT'; child.kill(); } });\n    child.stderr.on('data', chunk => { stderr += chunk; });\n    child.on('error', error => { stderr += String(error); finish(1); });\n    child.on('close', code => finish(Number.isInteger(code) ? code! : 1));\n    child.stdin.on('error', () => { /* Exit receipt carries process failure. */ }); child.stdin.end(stdin);\n  });\n  const receipt = { args: argv, cwd: root, started_utc: started, finished_utc: new Date().toISOString(), inner_exit_code: result.code, stdout: result.stdout, stderr: result.stderr, ...(stdin === undefined ? {} : { stdin }) };\n  receipts.push(receipt); if (audit) await fs.appendFile(audit, JSON.stringify({ event: 'command_finished', ...receipt }) + '\\n');\n  return result;\n}\nasync function requireGit(root: string, args: string[], receipts: CommandReceipt[], audit?: string, stdin?: string) {\n  const result = await git(root, args, receipts, audit, stdin);\n  if (result.code !== 0) fail(`GIT_FAILED:${args[0]}:${result.stderr.trim()}`);\n  return result.stdout;\n}\nasync function branches(root: string, base: string, branch: string, receipts: CommandReceipt[]) {\n  if (!base || !branch || base.toLowerCase() === branch.toLowerCase() || base.toLowerCase().startsWith(branch.toLowerCase() + '/') || branch.toLowerCase().startsWith(base.toLowerCase() + '/') || [base, branch].some(name =>\n    name === 'HEAD' || name.startsWith('-') || /[\\x00-\\x20\\x7f\"\\\\]/.test(name))) fail('BRANCH_NAME_INVALID');\n  for (const name of [base, branch]) await requireGit(root, ['check-ref-format', '--branch', name], receipts);\n}\nasync function snapshot(root: string, expected: string, receipts: CommandReceipt[], audit?: string): Promise<Source> {\n  await noLinks(root); await noLinks(path.join(root, '.git/index')); await noLinks(path.join(root, '.git/config'));\n  if (!(await fs.lstat(path.join(root, '.git'))).isDirectory()) fail('EXTERNAL_GIT_DIRECTORY');\n  const inspectGit = async (directory: string): Promise<void> => {\n    for (const name of await fs.readdir(directory)) {\n      const full = path.join(directory, name); await noLinks(full);\n      if ((await fs.lstat(full)).isDirectory()) await inspectGit(full);\n    }\n  };\n  await inspectGit(path.join(root, '.git'));\n  if (await exists(path.join(root, '.git/objects/info/alternates'))) fail('EXTERNAL_GIT_DIRECTORY');\n  const top = (await requireGit(root, ['rev-parse', '--show-toplevel'], receipts, audit)).trim();\n  const common = (await requireGit(root, ['rev-parse', '--git-common-dir'], receipts, audit)).trim();\n  if (identity(top) !== identity(root) || identity(path.resolve(root, common)) !== identity(path.join(root, '.git'))) fail('EXTERNAL_GIT_DIRECTORY');\n  const head = (await requireGit(root, ['rev-parse', 'HEAD'], receipts, audit)).trim(); if (head !== expected) fail('HEAD_DRIFT');\n  await requireGit(root, ['fsck', '--full', '--no-reflogs'], receipts, audit);\n  // status/diff may run clean/textconv programs from repository config. Use\n  // plumbing only, include ignored files, and compare raw tracked blobs below.\n  const untracked = await requireGit(root, ['ls-files', '--others', '-z'], receipts, audit);\n  for (const entry of untracked.split('\\0').filter(Boolean)) {\n    if (!entry.startsWith((`${SPEC_DIR_NAME}/` as const))) fail('BUSINESS_OR_STAGED_DRIFT');\n    safePath(entry); await noLinks(path.join(root, entry));\n  }\n  const tree = await requireGit(root, ['ls-tree', '-rz', '--full-tree', expected], receipts, audit);\n  const index = await requireGit(root, ['ls-files', '--stage', '-z'], receipts, audit);\n  const tracked: TrackedFile[] = [], expectedIndex: string[] = [];\n  const identities = new Set<string>();\n  for (const entry of tree.split('\\0').filter(Boolean)) {\n    const match = entry.match(/^(100644|100755) blob ([a-f0-9]{40})\\t(.+)$/s); if (!match) fail('TRACKED_KIND_UNSUPPORTED');\n    const [, mode, oid, relative] = match; safePath(relative); const full = path.join(root, relative); await noLinks(full);\n    if (identities.has(identity(full))) fail('TRACKED_PATH_ALIAS'); identities.add(identity(full));\n    const raw = await fs.readFile(full); if (hash(Buffer.concat([Buffer.from(`blob ${raw.length}\\0`), raw]), 'sha1') !== oid) fail('TRACKED_CONTENT_DRIFT');\n    tracked.push({ path: relative, mode, object_id: oid, sha256: hash(raw), size: raw.length }); expectedIndex.push(`${mode} ${oid} 0\\t${relative}`);\n  }\n  if (index.split('\\0').filter(Boolean).sort().join('\\0') !== expectedIndex.sort().join('\\0')) fail('INDEX_DRIFT');\n  return { head, head_sha256: hash(await fs.readFile(path.join(root, '.git/HEAD'))), refs: await requireGit(root, ['for-each-ref', '--format=%(refname) %(objectname)'], receipts, audit),\n    index_sha256: hash(await fs.readFile(path.join(root, '.git/index'))), config_sha256: hash(await fs.readFile(path.join(root, '.git/config'))), tracked };\n}\nasync function assertMetadata(root: string, id: string) {\n  const p = paths(root, id); await noLinks(p.context); await noLinks(p.owner);\n  await noLinks(path.join(p.wi, 'work_item.json'));\n  const metadata = await readWorkItemMetadata(p.wi, id);\n  if (metadata.work_item_id !== id || metadata.code_change_allowed === true || await exists(path.join(p.wi, 'governance_scope.json'))) fail('IMPLEMENTATION_ALREADY_STARTED');\n  return p;\n}\nexport async function planDetachedGitBootstrap(input: DetachedBranchPlanInput) {\n  checkId(input.workItemId); const root = path.resolve(input.projectRoot), receipts: CommandReceipt[] = [];\n  if (!/^[a-f0-9]{40}$/.test(input.expectedHead)) fail('FULL_COMMIT_REQUIRED');\n  await branches(root, input.baseBranch, input.branchName, receipts);\n  return withGitBranchMutationLease(root, input.workItemId, async () => {\n    const p = await assertMetadata(root, input.workItemId); if (await exists(p.context)) fail('CONTEXT_ALREADY_EXISTS');\n    const source = await snapshot(root, input.expectedHead, receipts);\n    const symbolic = await git(root, ['symbolic-ref', '-q', 'HEAD'], receipts);\n    if (symbolic.code !== 1 || symbolic.stdout || source.refs.split('\\n').some(ref => ref.startsWith('refs/heads/'))) fail('BRANCHLESS_DETACHED_REQUIRED');\n    // Abort a transaction probe; older Git implementations must reject before\n    // a plan can authorize any mutations.\n    await requireGit(root, ['update-ref', '--stdin'], receipts, undefined, 'start\\nabort\\n');\n    const plan: Plan = { schema_version: '1.0', project_root: identity(root), work_item_id: input.workItemId,\n      base_branch: input.baseBranch, branch_name: input.branchName, expected_head: input.expectedHead, created_utc: new Date().toISOString(), source, probe_commands: receipts,\n      work_item_metadata_sha256: hash(await fs.readFile(path.join(p.wi, 'work_item.json'))) };\n    const raw = document(plan), planHash = hash(raw); await fs.mkdir(path.join(p.owner, 'plans'), { recursive: true });\n    await marker(path.join(p.owner, 'plans', planHash + '.json'), plan);\n    return { success: true, work_item_id: input.workItemId, bootstrap_plan_sha256: planHash, plan, confirmation_required: true,\n      effect: 'Create two new refs at the verified commit, bind HEAD and standard WI Git context; preserve index/business bytes; no old branch restoration' };\n  });\n}\nexport async function executeDetachedGitBootstrap(input: DetachedBranchCreateInput, options?: { onCheckpoint?: (stage: string) => Promise<void> }) {\n  checkId(input.workItemId); if (!/^[a-f0-9]{64}$/.test(input.planSha256)) fail('PLAN_HASH_INVALID');\n  const root = path.resolve(input.projectRoot), receipts: CommandReceipt[] = [];\n  await branches(root, input.baseBranch, input.branchName, receipts);\n  const quote = input.confirmationQuote.trim();\n  const names = [input.baseBranch, input.branchName].every(name => {\n    const escaped = name.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n    return new RegExp(`(^|[\\\\s+，,;；:：()（）和与、])${escaped}(?=$|[\\\\s+，,;；:：()（）和与、])`).test(quote);\n  });\n  if (!names || !/^(?:(?:我|I)\\s*)?(采用|同意|批准|确认|accept\\b|approve\\b|confirm\\b|use\\b)/i.test(quote) || /(不采用|不同意|不批准|不确认|不要|暂不|拒绝|reject|do not|don't|not\\s+(?:accept|approve|confirm|use))/i.test(quote)) fail('EXPLICIT_BRANCH_CONFIRMATION_REQUIRED');\n  return withGitBranchMutationLease(root, input.workItemId, async () => {\n    const p = await assertMetadata(root, input.workItemId), planFile = path.join(p.owner, 'plans', input.planSha256 + '.json'); await noLinks(planFile);\n    const raw = await fs.readFile(planFile); if (hash(raw) !== input.planSha256) fail('PLAN_DRIFT');\n    const parsed: unknown = JSON.parse(raw.toString()); if (!validPlan(parsed)) fail('PLAN_SCHEMA_INVALID');\n    const plan = parsed;\n    if (plan.project_root !== identity(root) || plan.work_item_id !== input.workItemId || plan.base_branch !== input.baseBranch || plan.branch_name !== input.branchName) fail('PLAN_IDENTITY_MISMATCH');\n    if (hash(await fs.readFile(path.join(p.wi, 'work_item.json'))) !== plan.work_item_metadata_sha256) fail('WORK_ITEM_METADATA_DRIFT');\n    const attempt = path.join(p.owner, input.planSha256); await noLinks(attempt); await fs.mkdir(attempt, { recursive: true });\n    const audit = path.join(attempt, 'commands.jsonl'); await noLinks(audit);\n    const refs = [`refs/heads/${plan.base_branch} ${plan.expected_head}`, `refs/heads/${plan.branch_name} ${plan.expected_head}`];\n    const finalRefs = (plan.source.refs.trim().split('\\n').filter(Boolean).concat(refs)).sort().join('\\n');\n    const context = { schema_version: '1.0', work_item_id: input.workItemId, git_enabled: true, branch_name: plan.branch_name,\n      base_branch: plan.base_branch, base_commit: plan.expected_head, branch_relationship: 'primary', remote_name: null,\n      push_policy: 'not_configured', merge_policy: 'requires_user_confirmation', created_at: plan.created_utc };\n    async function scene() {\n      const source = await snapshot(root, plan.expected_head, receipts, audit);\n      if (source.index_sha256 !== plan.source.index_sha256 || source.config_sha256 !== plan.source.config_sha256 || document(source.tracked) !== document(plan.source.tracked)) fail('SOURCE_DRIFT');\n      const actualRefs = source.refs.trim().split('\\n').filter(Boolean).sort().join('\\n');\n      const originalRefs = plan.source.refs.trim().split('\\n').filter(Boolean).sort().join('\\n');\n      if (actualRefs !== originalRefs && actualRefs !== finalRefs) fail('REF_DRIFT');\n      const symbolic = await git(root, ['symbolic-ref', '-q', 'HEAD'], receipts, audit);\n      const detached = symbolic.code === 1 && !symbolic.stdout;\n      const bound = symbolic.code === 0 && symbolic.stdout.trim() === `refs/heads/${plan.branch_name}`;\n      if ((!detached && !bound) || bound && actualRefs !== finalRefs) fail('HEAD_BINDING_DRIFT');\n      if (source.head_sha256 !== (bound ? hash(`ref: refs/heads/${plan.branch_name}\\n`) : plan.source.head_sha256)) fail('HEAD_BINDING_DRIFT');\n      if (await exists(p.context) && (await fs.readFile(p.context, 'utf8') !== document(context) || !bound || actualRefs !== finalRefs)) fail('CONTEXT_DRIFT');\n      return { refsDone: actualRefs === finalRefs, bound };\n    }\n    let current = await scene();\n    const intent = path.join(attempt, 'intent.json');\n    if (!await exists(intent) && (current.refsDone || current.bound || await exists(p.context))) fail('UNOWNED_INTERMEDIATE_STATE');\n    if (!await exists(intent)) await durable(intent, document({ schema_version: '1.0', plan_sha256: input.planSha256, user_response_quote: quote, head_lease_nonce: randomUUID(), created_utc: new Date().toISOString() }));\n    else { await noLinks(intent); const prior = JSON.parse(await fs.readFile(intent, 'utf8')); if (prior.schema_version !== '1.0' || prior.plan_sha256 !== input.planSha256 || prior.user_response_quote !== quote) fail('INTENT_DRIFT'); }\n    const leaseNonce = JSON.parse(await fs.readFile(intent, 'utf8')).head_lease_nonce;\n    if (typeof leaseNonce !== 'string' || !leaseNonce) fail('INTENT_DRIFT');\n    await options?.onCheckpoint?.('before_refs_transaction');\n    // Git's old-OID compare does not distinguish detached HEAD from a different\n    // symbolic branch at the same commit. Hold the real Git HEAD.lock, compare\n    // raw HEAD while locked, and publish HEAD atomically without a checkout.\n    const headLock = path.join(root, '.git/HEAD.lock'); await noLinks(headLock);\n    let headToken = document({ schema_version: '1.0', owner: 'specforge_git_bootstrap', pid: process.pid, nonce: leaseNonce, plan_sha256: input.planSha256 });\n    try { await durable(headLock, headToken); }\n    catch (error: any) {\n      if (error.code !== 'EEXIST') throw error;\n      headToken = await fs.readFile(headLock, 'utf8'); let held: any;\n      try { held = JSON.parse(headToken); } catch { fail('HEAD_LEASE_UNKNOWN'); }\n      if (held.schema_version !== '1.0' || held.owner !== 'specforge_git_bootstrap' || held.nonce !== leaseNonce || held.plan_sha256 !== input.planSha256 || !Number.isSafeInteger(held.pid) || held.pid < 1) fail('HEAD_LEASE_UNKNOWN');\n      let dead = false; try { process.kill(held.pid, 0); } catch (error: any) { if (error.code === 'ESRCH') dead = true; }\n      if (!dead) fail('HEAD_LEASE_BUSY');\n      await fs.appendFile(audit, JSON.stringify({ event: 'owned_head_lease_reclaimed', utc: new Date().toISOString(), previous: held, raw_sha256: hash(headToken) }) + '\\n');\n    }\n    try {\n      current = await scene(); await options?.onCheckpoint?.('head_lease_acquired'); current = await scene();\n      if (!current.refsDone) {\n        await requireGit(root, ['update-ref', '--stdin'], receipts, audit, `start\\ncreate refs/heads/${plan.base_branch} ${plan.expected_head}\\ncreate refs/heads/${plan.branch_name} ${plan.expected_head}\\nprepare\\ncommit\\n`);\n        await options?.onCheckpoint?.('refs_created'); current = await scene();\n      }\n      if (!current.bound) {\n        const readyHead = path.join(attempt, 'HEAD.ready'), newHead = `ref: refs/heads/${plan.branch_name}\\n`;\n        if (await exists(readyHead)) { await noLinks(readyHead); if (await fs.readFile(readyHead, 'utf8') !== newHead) fail('HEAD_STAGE_DRIFT'); }\n        else await durable(readyHead, newHead);\n        await scene();\n        await fs.rename(readyHead, path.join(root, '.git/HEAD'));\n        await fs.appendFile(audit, JSON.stringify({ event: 'head_published', utc: new Date().toISOString(), expected_old_sha256: plan.source.head_sha256, new_sha256: hash(newHead), method: 'atomic rename while owning Git HEAD.lock' }) + '\\n');\n        await options?.onCheckpoint?.('refs_and_head_bound');\n      }\n      await scene();\n    } finally {\n      if (await fs.readFile(headLock, 'utf8') !== headToken) fail('HEAD_LEASE_DRIFT'); await fs.unlink(headLock);\n    }\n    if (!await exists(p.context)) {\n      await scene(); const stage = path.join(attempt, 'git-context.ready.json'); await marker(stage, context);\n      if (await exists(p.context)) fail('CONTEXT_DRIFT');\n      await fs.rename(stage, p.context); await options?.onCheckpoint?.('context_bound');\n    }\n    await scene();\n    const result = { schema_version: '1.0', success: true, work_item_id: input.workItemId, bootstrap_mode: 'verified_detached_commit', bootstrap_plan_sha256: input.planSha256,\n      branch_name: plan.branch_name, base_branch: plan.base_branch, base_commit: plan.expected_head, git_context_path: path.relative(root, p.context).replaceAll('\\\\', '/'),\n      index_unchanged: true, tracked_bytes_unchanged: true, new_commit_created: false, old_branch_restoration_claimed: false };\n    await marker(path.join(attempt, 'completed.json'), result); return result;\n  });\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\git-governance-core.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'existsSync' is defined but never used. Allowed unused vars must match /^_/u.","line":4,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":4,"endColumn":20,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"existsSync"},"fix":{"range":[126,164],"text":""},"desc":"Remove unused import declaration."}]},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·'added'·|·'modified'·|·'deleted'·|·'renamed'·|·'copied'·|·'untracked'` with `⏎··|·'added'⏎··|·'modified'⏎··|·'deleted'⏎··|·'renamed'⏎··|·'copied'⏎··|·'untracked'⏎·`","line":12,"column":28,"nodeType":null,"messageId":"replace","endLine":12,"endColumn":98,"fix":{"range":[481,551],"text":"\n  | 'added'\n  | 'modified'\n  | 'deleted'\n  | 'renamed'\n  | 'copied'\n  | 'untracked'\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `.replace(/\\\\/g,·'/')` with `⏎····.replace(/\\\\/g,·'/')⏎····`","line":94,"column":29,"nodeType":null,"messageId":"replace","endLine":94,"endColumn":49,"fix":{"range":[2532,2552],"text":"\n    .replace(/\\\\/g, '/')\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·valid:·boolean;·reason?:·string;·path?:·string·` with `⏎··valid:·boolean;⏎··reason?:·string;⏎··path?:·string;⏎`","line":106,"column":62,"nodeType":null,"mess