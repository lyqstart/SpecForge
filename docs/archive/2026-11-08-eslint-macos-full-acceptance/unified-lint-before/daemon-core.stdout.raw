,"endLine":54,"endColumn":34,"fix":{"range":[2285,2312],"text":"start >= 0 !== end >= 0"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":114,"column":88,"nodeType":null,"messageId":"insert","endLine":114,"endColumn":88,"fix":{"range":[4573,4573],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·projectRoot:·string;·defaultBranch?:·string;·confirmed?:·boolean;·writeReport?:·boolean·` with `⏎··projectRoot:·string;⏎··defaultBranch?:·string;⏎··confirmed?:·boolean;⏎··writeReport?:·boolean;⏎`","line":119,"column":47,"nodeType":null,"messageId":"replace","endLine":119,"endColumn":136,"fix":{"range":[4751,4840],"text":"\n  projectRoot: string;\n  defaultBranch?: string;\n  confirmed?: boolean;\n  writeReport?: boolean;\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'git·add·.',·'git·add·-A',·'git·clean·-fd',·'git·restore·.',·'git·push·--mirror'` with `⏎······'git·add·.',⏎······'git·add·-A',⏎······'git·clean·-fd',⏎······'git·restore·.',⏎······'git·push·--mirror',⏎····`","line":139,"column":26,"nodeType":null,"messageId":"replace","endLine":139,"endColumn":106,"fix":{"range":[5881,5961],"text":"\n      'git add .',\n      'git add -A',\n      'git clean -fd',\n      'git restore .',\n      'git push --mirror',\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·schema_version:·'git_ignore_decisions.v1',·decisions:·[]` with `⏎····schema_version:·'git_ignore_decisions.v1',⏎····decisions:·[],⏎·`","line":146,"column":73,"nodeType":null,"messageId":"replace","endLine":146,"endColumn":130,"fix":{"range":[6256,6313],"text":"\n    schema_version: 'git_ignore_decisions.v1',\n    decisions: [],\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·schema_version:·'git_ignore_decisions.v1',·updated_at:·new·Date().toISOString(),·decisions:·existingDecisions.decisions·??·[]` with `⏎····schema_version:·'git_ignore_decisions.v1',⏎····updated_at:·new·Date().toISOString(),⏎··