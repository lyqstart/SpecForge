ndColumn":54,"fix":{"range":[7804,7804],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":107,"column":21,"nodeType":null,"messageId":"insert","endLine":107,"endColumn":21,"fix":{"range":[7876,7876],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·input.consumePurpose·??·(state.current_state·===·'implementation_running'·?·'implementation'·as·const·:·'formal'·as·const` with `⏎······input.consumePurpose·??⏎······(state.current_state·===·'implementation_running'⏎········?·('implementation'·as·const)⏎········:·('formal'·as·const)`","line":108,"column":13,"nodeType":null,"messageId":"replace","endLine":108,"endColumn":135,"fix":{"range":[7959,8081],"text":"\n      input.consumePurpose ??\n      (state.current_state === 'implementation_running'\n        ? ('implementation' as const)\n        : ('formal' as const)"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·psv,·files,` with `⏎····psv,⏎····files,⏎···`","line":109,"column":34,"nodeType":null,"messageId":"replace","endLine":109,"endColumn":46,"fix":{"range":[8117,8129],"text":"\n    psv,\n    files,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·verificationType:·input.verificationType,·commandIndex:·input.commandIndex,` with `⏎····verificationType:·input.verificationType,⏎····commandIndex:·input.commandIndex,⏎···`","line":110,"column":26,"nodeType":null,"messageId":"replace","endLine":110,"endColumn":102,"fix":{"range":[8216,8292],"text":"\n    verificationType: input.verificationType,\n    commandIndex: input.commandIndex,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·metadataBasisSha256` with `⏎····metadataBasisSha256,⏎·`","line":111,"column":23,"nodeType":null,"messageId":"replace","endLine":111,"endColumn":43,"fix":{"range":[8324,8344],"text":"\n    metadataBasisSha256,\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·...snapshot,·basisIdentity:·verificationId(canonicalVerificationJson(basis)),·identity:·verificationId(canonicalVerificationJson(snapshot))` with `⏎····...snapshot,⏎····basisIdentity:·verificationId(canonicalVerificationJson(basis)),⏎····identity:·verificationId(canonicalVerificationJson(snapshot)),⏎·`","line":113,"column":11,"nodeType":null,"messageId":"replace","endLine":113,"endColumn":151,"fix":{"range":[8431,8571],"text":"\n    ...snapshot,\n    basisIdentity: verificationId(canonicalVerificationJson(basis)),\n    identity: verificationId(canonicalVerificationJson(snapshot)),\n "}}],"suppressedMessages":[],"errorCount":51,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":51,"fixableWarningCount":0,"source":"import * as fs from 'node:fs/promises';\nimport path from 'node:path';\nimport { projectSpecManifest, workItemRoot, workItemCandidateTasks } from '@specforge/types/directory-layout';\nimport { evaluateMergeReport, validateCurrentUserDecisionValue } from '@specforge/types';\nimport { readAuthoritativeState } from '../tools/lib/state-coordinator-v11';\nimport { guardHardStop } from '../tools/lib/hard-stop-latch';\nimport { readWorkItemMetadata } from '../tools/lib/work-item-metadata';\nimport { validateWorkItemId } from '../tools/lib/work-item-id-validator';\nimport { candidateManifestContentBlockCode } from '../tools/lib/candidate-manifest-owner';\nimport { validateApprovedUserDecisionForClose, computeCandidateHash } from '../tools/lib/governance-invariants-v11';\nimport { parseTaskSections, parseTaskVerification, validateTaskArtifactContract } from '../tools/lib/sf_markdown_verification_parser';\nimport { VALID_VERIFICATION_TYPES } from '../tools/lib/sf_verification_types';\nimport { assertVerificationPath, canonicalVerificationJson, readVerificationFile, verificationId } from './owner-store';\nimport type { VerificationAuthoritySnapshot } from './verification-plan';\n\nexport interface VerificationTaskSelector {\n  workItemId: string;\n  taskId: string;\n  verificationType: string;\n  commandIndex: number;\n}\n\nexport async function captureVerificationAuthority(input: VerificationTaskSelector & {\n  deps: unknown;\n  projectRoot: string;\n  consumePurpose?: 'implementation' | 'formal';\n}): Promise<VerificationAuthoritySnapshot> {\n  if (validateWorkItemId(input.workItemId) || !new RegExp(`^TASK-${input.workItemId}-[0-9]{3}$`).test(input.taskId) ||\n      !VALID_VERIFICATION_TYPES.includes(input.verificationType as typeof VALID_VERIFICATION_TYPES[number]) ||\n      !Number.isSafeInteger(input.commandIndex) || input.commandIndex < 0 || input.commandIndex > 63) throw new Error('VERIFICATION_TASK_SELECTOR_INVALID');\n  const root = path.resolve(input.projectRoot), wiRoot = workItemRoot(root, input.workItemId);\n  await assertVerificationPath(wiRoot);\n  const hardStop = guardHardStop(root, input.workItemId, 'sf_verification_run');\n  if (!hardStop.allowed) throw new Error(hardStop.error);\n  const state = await readAuthoritativeState({ deps: input.deps, projectRoot: root, workItemId: input.workItemId });\n  const states = input.consumePurpose === 'formal' ? ['verification_running', 'verification_done', 'closed'] :\n    input.consumePurpose === 'implementation' ? ['implementation_running', 'implementation_done', 'verification_running'] :\n    ['implementation_running', 'verification_running'];\n  if (state.source !== 'StateManager' || !states.includes(String(state.current_state))) {\n    throw new Error('VERIFICATION_AUTHORITATIVE_STATE_REQUIRED');\n  }\n  const metadata = await readWorkItemMetadata(wiRoot, input.workItemId);\n  const files: Record<string, string> = {};\n  let total = 0;\n  async function read(file: string): Promise<Buffer> {\n    const relative = path.relative(root, file).replace(/\\\\/g, '/');\n    if (relative.startsWith('../') || path.isAbsolute(relative)) throw new Error('VERIFICATION_AUTHORITY_OUTSIDE_PROJECT');\n    const raw = await readVerificationFile(file);\n    total += raw.length;\n    if (total > 16 * 1024 * 1024 || Object.keys(files).length > 2048) throw new Error('VERIFICATION_AUTHORITY_BUDGET');\n    files[relative] = verificationId(raw);\n    return raw;\n  }\n  const metadataRawSha256 = verificationId(await readVerificationFile(path.join(wiRoot, 'work_item.json')));\n  // Normal state/Close owners refresh these observation timestamps. All other metadata stays bound.\n  const { updated_at: _updated, code_permission_revoked_at: _revokedAt, ...metadataBasis } = metadata;\n  const metadataBasisSha256 = verificationId(canonicalVerificationJson(metadataBasis));\n  const manifestPath = path.join(wiRoot, 'candidate_manifest.json'), decisionPath = path.join(wiRoot, 'user_decision.json');\n  const manifestRaw = await read(manifestPath);\n  if (candidateManifestContentBlockCode(manifestRaw.toString('utf8'), input.workItemId)) throw new Error('VERIFICATION_CANDIDATE_MANIFEST_INVALID');\n  const decision = JSON.parse((await read(decisionPath)).toString('utf8')) as Record<string, unknown>;\n  if (!validateCurrentUserDecisionValue(decision,input.workItemId).valid) throw new Error('VERIFICATION_APPROVAL_SCHEMA_INVALID');\n  const approved = await validateApprovedUserDecisionForClose({ projectRoot: root, workItemDir: wiRoot,\n    workItemId: input.workItemId, candidateManifestPath: manifestPath, userDecisionPath: decisionPath });\n  if (!approved.valid) throw new Error('VERIFICATION_APPROVAL_INVALID:' + approved.errors.join(';'));\n  const merge = evaluateMergeReport((await read(path.join(wiRoot, 'merge_report.md'))).toString('utf8'),input.workItemId);\n  const frozenManifest=JSON.parse(manifestRaw.toString('utf8')) as {merge_required:boolean;entries:unknown[]};\n  const codeOnlyNoMerge=metadata['workflow_path']==='code_only_fast_path'&&!frozenManifest.merge_required&&frozenManifest.entries.length===0&&merge.status==='not_applicable';\n  if (!merge.valid || merge.status !== 'success'&&!codeOnlyNoMerge) throw new Error('VERIFICATION_SUCCESSFUL_SPEC_MERGE_REQUIRED');\n  await read(path.join(wiRoot, 'governance_scope.json'));\n  const projectManifest = JSON.parse((await read(projectSpecManifest(root))).toString('utf8')) as Record<string, unknown>;\n  const psv = projectManifest['project_spec_version'];\n  if (typeof psv !== 'string' || !/^PSV-[0-9]{4,}$/.test(psv) || metadata['project_spec_version_at_permission'] !== psv) {\n    throw new Error('VERIFICATION_CURRENT_PSV_BINDING_REQUIRED');\n  }\n  const manifest = JSON.parse(manifestRaw.toString('utf8')) as { entries: Array<{ candidate_path: string }> };\n  for (const entry of manifest.entries) {\n    const candidate = path.resolve(wiRoot, entry.candidate_path);\n    if (!candidate.startsWith(wiRoot + path.sep)) throw new Error('VERIFICATION_CANDIDATE_PATH_INVALID');\n    await read(candidate);\n  }\n  async function projectTree(directory: string): Promise<void> {\n    await assertVerificationPath(directory);\n    for (const entry of await fs.readdir(directory, { withFileTypes: true })) {\n      const full = path.join(directory, entry.name);\n      if (entry.isSymbolicLink()) throw new Error('VERIFICATION_AUTHORITY_LINK');\n      if (entry.isDirectory()) await projectTree(full); else await read(full);\n    }\n  }\n  await projectTree(path.dirname(projectSpecManifest(root)));\n  await projectTree(path.join(wiRoot,'candidates'));\n  // Candidate file bytes remain approved after merge; only pre-merge manifest/summary identities may normalize.\n  if (typeof decision['candidate_hash'] !== 'string' || decision['candidate_hash'] !== await computeCandidateHash(wiRoot)) {\n    throw new Error('VERIFICATION_APPROVED_CANDIDATE_CONTENT_CHANGED');\n  }\n  // Tasks are WI-owned; the merge manifest contains Project Spec destinations, not every approved Candidate file.\n  // The canonical Tasks bytes were included above in the full approved candidates/ content hash.\n  const taskPath = workItemCandidateTasks(root,input.workItemId);\n  const tasksRaw = await read(taskPath), text = tasksRaw.toString('utf8');\n  if (!validateTaskArtifactContract(text).valid) throw new Error('VERIFICATION_TASK_DOCUMENT_INVALID');\n  const sections = parseTaskSections(text).filter(s => s.taskId === input.taskId);\n  if (sections.length !== 1) throw new Error('VERIFICATION_TASK_NOT_FOUND');\n  const parsed = parseTaskVerification(sections[0]!.content), declared = parsed.typedCommands?.[input.verificationType as keyof NonNullable<typeof parsed.typedCommands>];\n  const commands = typeof declared === 'string' ? [declared] : declared;\n  const command = commands?.[input.commandIndex];\n  if (typeof command !== 'string' || !command.trim()) throw new Error('VERIFICATION_COMMAND_NOT_FOUND');\n  const snapshot = { state: state.current_state as VerificationAuthoritySnapshot['state'],\n    purpose: input.consumePurpose ?? (state.current_state === 'implementation_running' ? 'implementation' as const : 'formal' as const),\n    workItemId: input.workItemId, psv, files, taskPath: path.relative(root, taskPath).replace(/\\\\/g, '/'),\n    taskId: input.taskId, verificationType: input.verificationType, commandIndex: input.commandIndex, command,\n    metadataRawSha256, metadataBasisSha256 };\n  const { state: _state, metadataRawSha256: _raw, ...basis } = snapshot;\n  return { ...snapshot, basisIdentity: verificationId(canonicalVerificationJson(basis)), identity: verificationId(canonicalVerificationJson(snapshot)) };\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\verification\\execution-evidence-consumer.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `string;projectRoot:string;workItemId:string;taskId:string;verificationType:` with `·string;⏎··projectRoot:·string;⏎··workItemId:·string;⏎··taskId:·string;⏎··verificationType:·`","line":4,"column":13,"nodeType":null,"messageId":"replace","endLine":4,"endColumn":88,"fix":{"range":[211,286],"text":" string;\n  projectRoot: string;\n  workItemId: string;\n  taskId: string;\n  verificationType: "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `number;command:string;purpose:'implementation'|` with `·number;⏎··command:·string;⏎··purpose:·'implementation'·|·`","line":5,"column":16,"nodeType":null,"messageId":"replace","endLine":5,"endColumn":63,"fix":{"range":[309,356],"text":" number;\n  command: string;\n  purpose: 'implementation' | "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·consume(input:ExecutionEvidenceSubject):Promise<VerificationExecutionReceipt>;·` with `⏎··consume(input:·ExecutionEvidenceSubject):·Promise<VerificationExecutionReceipt>;⏎`","line":7,"column":45,"nodeType":null,"messageId":"replace","endLine":7,"endColumn":125,"fix":{"range":[412,492],"text":"\n  consume(input: ExecutionEvidenceSubject): Promise<VerificationExecutionReceipt>;\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `unknown):value·is·Record<string,unknown>·=>·!!value·&&·typeof·value===` with `·unknown):·value·is·Record<string,·unknown>·=>⏎··!!value·&&·typeof·value·===·`","line":8,"column":23,"nodeType":null,"messageId":"replace","endLine":8,"endColumn":93,"fix":{"range":[516,586],"text":" unknown): value is Record<string, unknown> =>\n  !!value && typeof value === "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `unknown):value·is·string·=>·typeof·value===` with `·unknown):·value·is·string·=>⏎··typeof·value·===·`","line":9,"column":23,"nodeType":null,"messageId":"replace","endLine":9,"endColumn":66,"fix":{"range":[643,686],"text":" unknown): value is string =>\n  typeof value === "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `·`","line":11,"column":54,"nodeType":null,"messageId":"insert","endLine":11,"endColumn":54,"fix":{"range":[782,782],"text":" "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `string;workItemId:string;report?:unknown;manifest?:unknown;consumer?:` with `·string;⏎··workItemId:·string;⏎··report?:·unknown;⏎··manifest?:·unknown;⏎··consumer?:·`","line":12,"column":15,"nodeType":null,"messageId":"replace","endLine":12,"endColumn":84,"fix":{"range":[798,867],"text":" string;\n  workItemId: string;\n  report?: unknown;\n  manifest?: unknown;\n  consumer?: "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'implementation'|'formal';historicalClosed?:` with `·'implementation'·|·'formal';⏎··historicalClosed?:·`","line":13,"column":12,"nodeType":null,"messageId":"replace","endLine":13,"endColumn":56,"fix":{"range":[905,949],"text":" 'implementation' | 'formal';\n  historicalClosed?: "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `·`","line":14,"column":4,"nodeType":null,"messageId":"insert","endLine":14,"endColumn":4,"fix":{"range":[961,961],"text":" "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `string[]·=·[],·report·=·object(input.report)?input.report:null,·manifest=object(input.manifest)?input.manifest:` with `·string[]·=·[],⏎····report·=·object(input.report)·?·input.report·:·null,⏎····manifest·=·object(input.manifest)·?·input.manifest·:·`","line":15,"column":17,"nodeType":null,"messageId":"replace","endLine":15,"endColumn":128,"fix":{"range":[997,1108],"text":" string[] = [],\n    report = object(input.report) ? input.report : null,\n    manifest = object(input.manifest) ? input.manifest : "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·report·&&·Array.isArray(report.verification_commands)?report.verification_commands:` with `⏎····report·&&·Array.isArray(report.verification_commands)·?·report.verification_commands·:·`","line":16,"column":19,"nodeType":null,"messageId":"replace","endLine":16,"endColumn":103,"fix":{"range":[1132,1216],"text":"\n    report && Array.isArray(report.verification_commands) ? report.verification_commands : "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `?manifest.entries:` with `·?·manifest.entries·:·`","line":17,"column":62,"nodeType":null,"messageId":"replace","endLine":17,"endColumn":