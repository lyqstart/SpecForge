e,\n      reason:\n        'NATIVE_TOOL_REQUIRES_CONTROLLED_EXECUTION: sf_safe_bash supports internal reads only; verification requires the approved sf_verification_plan / sf_verification_run path and platform/profile. Scripts, builds and tests were not executed; do not retry through a shell or helper.',\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·if·((await·fs.lstat(cursor)).isSymbolicLink())·return·{·allowed:·false,·reason:·'WRITE_SYMLINK_FORBIDDEN'·};·}` with `⏎······if·((await·fs.lstat(cursor)).isSymbolicLink())⏎········return·{·allowed:·false,·reason:·'WRITE_SYMLINK_FORBIDDEN'·};`","line":37,"column":10,"nodeType":null,"messageId":"replace","endLine":37,"endColumn":121,"fix":{"range":[2408,2519],"text":"\n      if ((await fs.lstat(cursor)).isSymbolicLink())\n        return { allowed: false, reason: 'WRITE_SYMLINK_FORBIDDEN' };"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·catch·(error)·{·if·((error·as·NodeJS.ErrnoException).code·!==·'ENOENT')·throw·error;` with `·}·catch·(error)·{⏎······if·((error·as·NodeJS.ErrnoException).code·!==·'ENOENT')·throw·error;⏎···`","line":38,"column":4,"nodeType":null,"messageId":"replace","endLine":38,"endColumn":89,"fix":{"range":[2523,2608],"text":" } catch (error) {\n      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎····.filter(item·=>·!['closed',·'rejected',·'superseded'].includes(item.current_state)` with `.filter(⏎····item·=>·!['closed',·'rejected',·'superseded'].includes(item.current_state)⏎··`","line":40,"column":71,"nodeType":null,"messageId":"replace","endLine":41,"endColumn":87,"fix":{"range":[2685,2772],"text":".filter(\n    item => !['closed', 'rejected', 'superseded'].includes(item.current_state)\n  "}},{"ruleId":"@typescript-eslint/no-unsafe-argument","severity":2,"message":"Unsafe argument of type `any` assigned to a parameter of type `string`.","line":41,"column":68,"nodeType":"MemberExpression","messageId":"unsafeArgument","endLine":41,"endColumn":86},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":42,"column":27,"nodeType":null,"messageId":"insert","endLine":42,"endColumn":27,"fix":{"range":[2801,2801],"text":"\n   "}},{"ruleId":"@typescript-eslint/no-unsafe-argument","severity":2,"message":"Unsafe argument of type `any` assigned to a parameter of type `string`.","line":44,"column":69,"nodeType":"MemberExpression","messageId":"unsafeArgument","endLine":44,"endColumn":87},{"ruleId":"@typescript-eslint/no-unsafe-argument","severity":2,"message":"Unsafe argument of type `any` assigned to a parameter of type `string`.","line":45,"column":34,"nodeType":"MemberExpression","messageId":"unsafeArgument","endLine":45,"endColumn":52},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":45,"column":62,"nodeType":null,"messageId":"insert","endLine":45,"endColumn":62,"fix":{"range":[3055,3055],"text":"\n   "}},{"ruleId":"@typescript-eslint/no-unsafe-argument","severity":2,"message":"Unsafe argument of type `any` assigned to a parameter of type `string`.","line":46,"column":48,"nodeType":"MemberExpression","messageId":"unsafeArgument","endLine":46,"endColumn":66},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":54,"column":17,"nodeType":null,"messageId":"insert","endLine":54,"endColumn":17,"fix":{"range":[3535,3535],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":55,"column":5,"nodeType":null,"messageId":"insert","endLine":55,"endColumn":5,"fix":{"range":[3587,3587],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `:·checkWrite(` with `··:·checkWrite(⏎··········`","line":56,"column":5,"nodeType":null,"messageId":"replace","endLine":56,"endColumn":18,"fix":{"range":[3654,3667],"text":"  : checkWrite(\n          "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····hasActiveWI:·true,·callerRole:·'agent',` with `············hasActiveWI:·true,⏎············callerRole:·'agent',⏎···········`","line":57,"column":1,"nodeType":null,"messageId":"replace","endLine":57,"endColumn":44,"fix":{"range":[3669,3712],"text":"            hasActiveWI: true,\n            callerRole: 'agent',\n           "}},{"ruleId":"@typescript-eslint/no-unsafe-argument","severity":2,"message":"Unsafe argument of type `any` assigned to a parameter of type `string | null | undefined`.","line":57,"column":78,"nodeType":"MemberExpression","messageId":"unsafeArgument","endLine":57,"endColumn":97},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `workItem:·{·work_item_id:·state.work_item_id,` with `········workItem:·{⏎··············work_item_id:·state.work_item_id,⏎·············`","line":58,"column":5,"nodeType":null,"messageId":"replace","endLine":58,"endColumn":50,"fix":{"range":[3772,3817],"text":"        workItem: {\n              work_item_id: state.work_item_id,\n             "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `······code_change_allowed:·wi.code_change_allowed·===·true,` with `··············code_change_allowed:·wi.code_change_allowed·===·true,⏎·············`","line":59,"column":1,"nodeType":null,"messageId":"replace","endLine":59,"endColumn":60,"fix":{"range":[3847,3906],"text":"              code_change_allowed: wi.code_change_allowed === true,\n             "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `allowed_write_files:·Array.isArray(wi.allowed_write_files)·?·wi.allowed_write_files·as·any` with `········allowed_write_files:·Array.isArray(wi.allowed_write_files)⏎················?·(wi.allowed_write_files·as·any)⏎···············`","line":60,"column":7,"nodeType":null,"messageId":"replace","endLine":60,"endColumn":97,"fix":{"range":[3975,4065],"text":"        allowed_write_files: Array.isArray(wi.allowed_write_files)\n                ? (wi.allowed_write_files as any)\n               "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `······workflow_path:·typeof·wi.workflow_path·===·'string'·?·wi.workflow_path·:·null` with `··············workflow_path:·typeof·wi.workflow_path·===·'string'·?·wi.workflow_path·:·null,⏎···········`","line":61,"column":1,"nodeType":null,"messageId":"replace","endLine":61,"endColumn":84,"fix":{"range":[4072,4155],"text":"              workflow_path: typeof wi.workflow_path === 'string' ? wi.workflow_path : null,\n           "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `},·relative,·operation` with `········},⏎··········relative,⏎··········operation⏎········`","line":62,"column":3,"nodeType":null,"messageId":"replace","endLine":62,"endColumn":25,"fix":{"range":[4161,4183],"text":"        },\n          relative,\n          operation\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·timestamp:·new·Date().toISOString(),·path:·relative,` with `⏎····timestamp:·new·Date().toISOString(),⏎····path:·relative,⏎···`","line":63,"column":31,"nodeType":null,"messageId":"replace","endLine":63,"endColumn":84,"fix":{"range":[4216,4269],"text":"\n    timestamp: new Date().toISOString(),\n    path: relative,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·allowed:·result.allowed,·violations:·result.violations,·tool` with `⏎····allowed:·result.allowed,⏎····violations:·result.violations,⏎····tool,⏎·`","line":64,"column":20,"nodeType":null,"messageId":"replace","endLine":64,"endColumn":81,"fix":{"range":[4300,4361],"text":"\n    allowed: result.allowed,\n    violations: result.violations,\n    tool,\n "}}],"suppressedMessages":[],"errorCount":26,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":21,"fixableWarningCount":0,"source":"import { SPEC_DIR_NAME } from \"@specforge/types/directory-layout\";\nimport * as fs from 'node:fs/promises';\nimport * as path from 'node:path';\nimport { getHandler } from '../ToolDispatcher';\nimport { readAuthoritativeWorkItems } from './authoritative-work-items';\nimport { readWorkItemMetadata } from './work-item-metadata';\nimport { checkWrite } from './write-guard-v11';\nimport { isCandidateFrozenState } from './candidate-freeze-v11';\nimport { checkHardStop } from './hard-stop-latch';\nimport { appendWriteGuardLog } from './write-guard-log';\nimport { isControlledHttpTool } from './controlled-http-tools';\n\nconst NON_WRITING_TOOLS = new Set(['read', 'glob', 'grep', 'list', 'webfetch', 'websearch', 'codesearch', 'todowrite', 'todoread', 'question', 'task', 'skill', 'lsp']);\n\n/** Native transport boundary. All file permission decisions stay with Permission Engine. */\nexport async function checkNativeTool(deps: any, projectRoot: string, tool: string, args: Record<string, unknown>) {\n  if (NON_WRITING_TOOLS.has(tool) || isControlledHttpTool(tool) || (tool.startsWith('sf_') && getHandler(tool))) return { allowed: true };\n  // An arbitrary program can write anywhere; a declared file list is not proof.\n  // Route shells/patches/unknown tools through controlled execution, never guess.\n  if (!['edit', 'write'].includes(tool)) {\n    return { allowed: false, reason: 'NATIVE_TOOL_REQUIRES_CONTROLLED_EXECUTION: sf_safe_bash supports internal reads only; verification requires the approved sf_verification_plan / sf_verification_run path and platform/profile. Scripts, builds and tests were not executed; do not retry through a shell or helper.' };\n  }\n  if (!path.isAbsolute(projectRoot) || typeof args.filePath !== 'string' || !args.filePath) {\n    return { allowed: false, reason: 'WRITE_TARGET_REQUIRED' };\n  }\n  const root = await fs.realpath(projectRoot);\n  await deps.projectManager?.getProjectConfiguration?.(projectRoot);\n  const absolute = path.resolve(root, args.filePath);\n  const relative = path.relative(root, absolute).replace(/\\\\/g, '/');\n  if (!relative || relative === '..' || relative.startsWith('../') || path.isAbsolute(relative)) {\n    return { allowed: false, reason: 'WRITE_OUTSIDE_PROJECT' };\n  }\n  // Reject symlink/junction ancestors, including the target itself.\n  let cursor = root;\n  for (const part of relative.split('/')) {\n    cursor = path.join(cursor, part);\n    try { if ((await fs.lstat(cursor)).isSymbolicLink()) return { allowed: false, reason: 'WRITE_SYMLINK_FORBIDDEN' }; }\n    catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error; }\n  }\n  const active = (await readAuthoritativeWorkItems(deps, projectRoot))\n    .filter(item => !['closed', 'rejected', 'superseded'].includes(item.current_state));\n  if (active.length !== 1) return { allowed: false, reason: 'UNAMBIGUOUS_ACTIVE_WORK_ITEM_REQUIRED' };\n  const state = active[0];\n  const wiDir = path.join(projectRoot, SPEC_DIR_NAME, 'work-items', state.work_item_id);\n  if (checkHardStop(projectRoot, state.work_item_id).blocked) return { allowed: false, reason: 'HARD_STOP_ACTIVE' };\n  const wi = await readWorkItemMetadata(wiDir, state.work_item_id);\n  const targetStat = await fs.lstat(absolute).catch(error => {\n    if (error.code === 'ENOENT') return null;\n    throw error;\n  });\n  const operation = targetStat ? 'modify' : 'create';\n  // A permitted pathname does not authorize other names for the same inode.\n  // Do not inspect or edit those aliases: reject before the host can write.\n  const result = targetStat?.isFile() && targetStat.nlink !== 1\n    ? { allowed: false, violations: ['WRITE_HARDLINK_FORBIDDEN'] }\n    : checkWrite({\n    hasActiveWI: true, callerRole: 'agent', isFrozen: isCandidateFrozenState(state.current_state),\n    workItem: { work_item_id: state.work_item_id, status: state.current_state,\n      code_change_allowed: wi.code_change_allowed === true, code_permission_revoked: wi.code_permission_revoked === true,\n      allowed_write_files: Array.isArray(wi.allowed_write_files) ? wi.allowed_write_files as any : [],\n      workflow_path: typeof wi.workflow_path === 'string' ? wi.workflow_path : null },\n  }, relative, operation);\n  appendWriteGuardLog(wiDir, { timestamp: new Date().toISOString(), path: relative, operation,\n    actor: 'agent', allowed: result.allowed, violations: result.violations, tool });\n  return { ...result, reason: result.violations.join('; ') };\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\new-project-governance-bootstrap.test.ts","messages":[{"ruleId":"@typescript-eslint/require-await","severity":2,"message":"Async arrow function has no 'await' expression.","line":7,"column":35,"nodeType":"ArrowFunctionExpression","messageId":"missingAwait","endLine":7,"endColumn":37,"suggestions":[{"messageId":"removeAsync","fix":{"range":[240,246],"text":""},"desc":"Remove 'async'."}]},{"ruleId":"@typescript-eslint/require-await","severity":2,"message":"Async arrow function has no 'await' expression.","line":8,"column":35,"nodeType":"ArrowFunctionExpression","messageId":"missingAwait","endLine":8,"endColumn":37,"suggestions":[{"messageId":"removeAsync","fix":{"range":[284,290],"text":""},"desc":"Remove 'async'."}]},{"ruleId":"@typescript-eslint/require-await","severity":2,"message":"Async arrow function has no 'await' expression.","line":29,"column":43,"nodeType":"ArrowFunctionExpression","messageId":"missingAwait","endLine":29,"endColumn":45,"suggestions":[{"messageId":"removeAsync","fix":{"range":[958,964],"text":""},"desc":"Remove 'async'."}]},{"ruleId":"@typescript-eslint/require-await","severity":2,"message":"Async arrow function has no 'await' expression.","line":30,"column":30,"nodeType":"ArrowFunctionExpression","messageId":"missingAwait","endLine":30,"endColumn":32,"suggestions":[{"messageId":"removeAsync","fix":{"range":[1014,1020],"text":""},"desc":"Remove 'async'."}]},{"ruleId":"@typescript-eslint/require-await","severity":2,"message":"Async arrow function has no 'await' expression.","line":34,"column":46,"nodeType":"ArrowFunctionExpression","messageId":"missingAwait","endLine":34,"endColumn":48,"suggestions":[{"messageId":"removeAsync","fix":{"range":[1124,1130],"text":""},"desc":"Remove 'async'."}]},{"ruleId":"@typescript-eslint/no-unsafe-argument","severity":2,"message":"Unsafe argument of type `any` assigned to a parameter of type `ToolDeps`.","line":96,"column":9,"nodeType":"Identifier","messageId":"unsafeArgument","endLine":96,"endColumn":13},{"ruleId":"@typescript-eslint/no-unsafe-argument","severity":2,"message":"Unsafe argument of type `any` assigned to a parameter of type `ToolDeps`.","line":172,"column":7,"nodeType":"Identifier","messageId":"unsafeArgument","endLine":172,"endColumn":11},{"ruleId":"@typescript-eslint/no-unsafe-argument","severity":2,"message":"Unsafe argument of type `any` assigned to a parameter of type `Iterable<unknown> | null | undefined`.","line":180,"column":7,"nodeType":"CallExpression","messageId":"unsafeArgument","endLine":180,"endColumn":85}],"suppressedMessages":[],"errorCount":8,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { afterEach, describe, expect, test, vi } from 'vitest';\nimport * as fs from 'node:fs/promises';\nimport * as os from 'node:os';\nimport * as path from 'node:path';\n\nvi.mock('@specforge/host-profile', () => ({\n  scanHostProfile: vi.fn(async () => ({})),\n  loadHostProfile: vi.fn(async () => null),\n  getHostProfilePath: () => path.join(os.tmpdir(), 'sf-bootstrap-host-profile-does-not-exist.json'),\n  PROFILE_TTL_MS: 3_600_000,\n  SCANNER_VERSION: 'test',\n}));\n\nimport { getHandler } from '../ToolDispatcher';\nimport '../handlers/sf-artifact-write';\nimport { checkContractIntegrity } from './contract-integrity';\nimport {\n  checkProjectGovernanceConsistency,\n  checkProjectGovernanceContracts,\n  checkProjectGovernanceTrace,\n} from './project-governance-v2';\nimport { ensureProjectInit } from './sf_project_init_core';\n\nconst roots: string[] = [];\nconst WI = 'WI-0001';\n\nfunction runtimeDeps() {\n  const stateManager = {\n    rebuildFromEventsFile: vi.fn(async () => ({ replayed: false })),\n    getState: vi.fn(async () => 'candidate_preparing'),\n  };\n  return {\n    projectManager: {\n      getProjectStateManager: vi.fn(async () => stateManager),\n    },\n  } as any;\n}\n\nasync function writeJson(filePath: string, value: unknown): Promise<void> {\n  await fs.mkdir(path.dirname(filePath), { recursive: true });\n  await fs.writeFile(filePath, JSON.stringify(value, null, 2) + '\\n', 'utf-8');\n}\n\nafterEach(async () => {\n  await Promise.all(roots.splice(0).map(root => fs.rm(root, { recursive: true, force: true })));\n});\n\ndescribe('new project governance bootstrap', () => {\n  test('controlled first-project Candidates can establish active Architecture/Data/Module/Contract/Trace governance', async () => {\n    const projectRoot = await fs.mkdtemp(path.join(os.tmpdir(), 'sf-new-project-bootstrap-'));\n    roots.push(projectRoot);\n\n    const init = await ensureProjectInit(projectRoot, 'bootstrap-project');\n    expect(init.success).toBe(true);\n\n    const workItemDir = path.join(projectRoot, '.specforge', 'work-items', WI);\n    await fs.mkdir(workItemDir, { recursive: true });\n    await writeJson(path.join(workItemDir, 'work_item.json'), {\n      schema_version: '1.1',\n      work_item_id: WI,\n      workflow_type: 'feature',\n      canonical_workflow_path: 'requirement_change_path',\n    });\n    await writeJson(path.join(workItemDir, 'trigger_result.json'), {\n      schema_version: '1.1',\n      work_item_id: WI,\n      workflow_type: 'feature',\n      workflow_path: 'requirement_change_path',\n      status: 'triggered',\n    });\n    await writeJson(path.join(workItemDir, 'candidate_manifest.json'), {\n      schema_version: '1.0',\n      work_item_id: WI,\n      workflow_type: 'feature',\n      workflow_path: 'requirement_change_path',\n      base_spec_version: 'PSV-0001',\n      merge_required: true,\n      entries: [],\n    });\n\n    const writer = getHandler('sf_artifact_write');\n    expect(writer).toBeDefined();\n    const deps = runtimeDeps();\n\n    async function writeCandidate(fileType: string, content: string, agent = 'sf-design') {\n      const result = (await writer!(\n        {\n          work_item_id: WI,\n          file_type: fileType,\n          content,\n        },\n        {\n          directory: projectRoot,\n          agent,\n        },\n        deps\n      )) as any;\n      expect(result?.success, JSON.stringify(result)).toBe(true);\n      return result;\n    }\n\n    await writeCandidate(\n      'candidate_architecture',\n      '# Project Architecture\\n\\nARCH-CORE-001 defines the initial project boundary.\\n'\n    );\n    await writeCandidate(\n      'candidate_data_model',\n      '# Project Data Model\\n\\nDATA_MODEL_NOT_APPLICABLE\\n'\n    );\n    await writeCandidate(\n      'candidate_module_definition',\n      JSON.stringify(\n        {\n          schema_version: '1.0',\n          module_code: 'CORE',\n          status: 'active',\n          code_paths: ['src/**'],\n        },\n        null,\n        2\n      )\n    );\n    await writeCandidate(\n      'candidate_module_contract',\n      JSON.stringify(\n        {\n          schema_version: '1.0',\n          owner_module: 'CORE',\n          contracts: {\n            shared_enums: [\n              {\n                id: 'MCON-CORE-001',\n                owner_module: 'CORE',\n                values: ['ready', 'blocked'],\n                source_refs: ['DD-CORE-001'],\n                enforcement: 'unit_test',\n              },\n            ],\n            invariants: [],\n            public_interfaces: [],\n            extension_points: [],\n          },\n        },\n        null,\n        2\n      )\n    );\n\n    const manifestWrite = (await writer!(\n      {\n        work_item_id: WI,\n        file_type: 'candidate_manifest',\n        content: JSON.stringify(\n          {\n            schema_version: '1.0',\n            work_item_id: WI,\n            workflow_type: 'feature',\n            workflow_path: 'requirement_change_path',\n            base_spec_version: 'PSV-0001',\n            merge_applicable: true,\n            merge_required: true,\n            entries: [],\n          },\n          null,\n          2\n        ),\n      },\n      {\n        directory: projectRoot,\n        agent: 'sf-orchestrator',\n      },\n      deps\n    )) as any;\n    expect(manifestWrite?.success, JSON.stringify(manifestWrite)).toBe(true);\n\n    const candidateManifest = JSON.parse(\n      await fs.readFile(path.join(workItemDir, 'candidate_manifest.json'), 'utf-8')\n    );\n    const targets = new Set(\n      candidateManifest.entries.map((entry: any) => String(entry.target_path ?? ''))\n    );\n    expect(targets).toContain('.specforge/project/architecture.md');\n    expect(targets).toContain('.specforge/project/data_model.md');\n    expect(targets).toContain('.specforge/project/modules/CORE/module.json');\n    expect(targets).toContain('.specforge/project/modules/CORE/contracts.json');\n\n    const contractPreMerge = await checkContractIntegrity({ projectRoot, workItemDir });\n    expect(contractPreMerge.checks.every(check => check.passed)).toBe(true);\n\n    const projectDir = path.join(projectRoot, '.specforge', 'project');\n    const candidateRoot = path.join(workItemDir, 'candidates', 'project');\n    await fs.copyFile(\n      path.join(candidateRoot, 'architecture.candidate.md'),\n      path.join(projectDir, 'architecture.md')\n    );\n    await fs.copyFile(\n      path.join(candidateRoot, 'data_model.candidate.md'),\n      path.join(projectDir, 'data_model.md')\n    );\n    await fs.copyFile(\n      path.join(candidateRoot, 'modules', 'CORE', 'module.candidate.json'),\n      path.join(projectDir, 'modules', 'CORE', 'module.json')\n    );\n    await fs.copyFile(\n      path.join(candidateRoot, 'modules', 'CORE', 'contracts.candidate.json'),\n      path.join(projectDir, 'modules', 'CORE', 'contracts.json')\n    );\n\n    await fs.writeFile(\n      path.join(projectDir, 'modules', 'CORE', 'design.md'),\n      '# Module Design\\n\\nDD-CORE-001 implements the initial CORE boundary.\\n',\n      'utf-8'\n    );\n    await fs.writeFile(\n      path.join(projectDir, 'modules', 'CORE', 'trace.md'),\n      [\n        '| From | Relation | To |',\n        '| --- | --- | --- |',\n        '| DD-CORE-001 | constrained_by | ARCH-CORE-001 |',\n        '| MCON-CORE-001 | enforces | DD-CORE-001 |',\n        '',\n      ].join('\\n'),\n      'utf-8'\n    );\n    await fs.writeFile(\n      path.join(projectDir, 'trace_matrix.md'),\n      [\n        '| From | Relation | To |',\n        '| --- | --- | --- |',\n        '| DD-CORE-001 | constrained_by | ARCH-CORE-001 |',\n        '| MCON-CORE-001 | enforces | DD-CORE-001 |',\n        '',\n      ].join('\\n'),\n      'utf-8'\n    );\n\n    const specManifestPath = path.join(projectDir, 'spec_manifest.json');\n    const specManifest = JSON.parse(await fs.readFile(specManifestPath, 'utf-8'));\n    specManifest.project = {\n      ...(specManifest.project ?? {}),\n      data_model: '.specforge/project/data_model.md',\n    };\n    specManifest.modules = specManifest.modules.map((entry: any) =>\n      entry.module_code === 'CORE'\n        ? {\n            ...entry,\n            contracts: '.specforge/project/modules/CORE/contracts.json',\n            code_paths: ['src/**'],\n          }\n        : entry\n    );\n    await writeJson(specManifestPath, specManifest);\n\n    await writeJson(path.join(workItemDir, 'trigger_result.json'), {\n      schema_version: '1.1',\n      work_item_id: WI,\n      workflow_type: 'feature',\n      workflow_path: 'requirement_change_path',\n      status: 'triggered',\n      classification: {\n        requirement_changed: true,\n        acceptance_criteria_changed: false,\n        business_rule_changed: false,\n        user_visible_behavior_changed: true,\n        data_semantics_changed: false,\n        design_changed: false,\n        module_boundary_changed: false,\n        api_contract_changed: false,\n        architecture_changed: true,\n        data_model_changed: true,\n        module_contract_changed: true,\n        unknowns: [],\n      },\n      impact_scope: {\n        affected_modules: ['CORE'],\n        architecture_refs: ['ARCH-CORE-001'],\n        data_model_refs: [],\n        design_refs: ['DD-CORE-001'],\n        project_contract_refs: [],\n        module_contract_refs: ['MCON-CORE-001'],\n        planned_code_paths: ['src/index.ts'],\n      },\n    });\n\n    const input = { projectRoot, workItemDir, workItemId: WI };\n    const consistency = await checkProjectGovernanceConsistency(input);\n    const contracts = await checkProjectGovernanceContracts(input);\n    const trace = await checkProjectGovernanceTrace(input);\n\n    expect(consistency.active).toBe(true);\n    expect(consistency.passed, JSON.stringify(consistency.checks, null, 2)).toBe(true);\n    expect(contracts.active).toBe(true);\n    expect(contracts.passed, JSON.stringify(contracts.checks, null, 2)).toBe(true);\n    expect(trace.active).toBe(true);\n    expect(trace.passed, JSON.stringify(trace.checks, null, 2)).toBe(true);\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\path-identity.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":13,"column":47,"nodeType":null,"messageId":"delete","endLine":13,"endColumn":48,"fix":{"range":[513,514],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":22,"column":47,"nodeType":null,"messageId":"delete","endLine":22,"endColumn":48,"fix":{"range":[837,838],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":39,"column":47,"nodeType":null,"messageId":"delete","endLine":39,"endColumn":48,"fix":{"range":[1281,1282],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":47,"column":47,"nodeType":null,"messageId":"delete","endLine":47,"endColumn":48,"fix":{"range":[1517,1518],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `parentIdentity.endsWith(path.sep)·?·parentIdentity·:·parentIdentity·+·path.sep` with `⏎······parentIdentity.endsWith(path.sep)·?·parentIdentity·:·parentIdentity·+·path.sep⏎····`","line":53,"column":30,"nodeType":null,"messageId":"replace","endLine":53,"endColumn":108,"fix":{"range":[1740,1818],"text":"\n      parentIdentity.endsWith(path.sep) ? parentIdentity : parentIdentity + path.sep\n    "}}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":5,"fixableWarningCount":0,"source":"import * as path from 'node:path';\n\n/**\n * Return the identity used when two resolved paths are compared on the target\n * platform. Windows path lookup is case-insensitive for the supported runtime,\n * while POSIX targets must retain case as part of the file identity.\n *\n * The optional platform argument is a deterministic test seam. Production\n * callers must rely on the default current target platform.\n */\nexport function resolvedPathIdentity(\n  value: string,\n  platform: NodeJS.Platform = process.platform,\n): string {\n  const resolved = path.resolve(value);\n  return platform === 'win32' ? resolved.toLowerCase() : resolved;\n}\n\n/** Preserve the first resolved spelling while removing target-platform aliases. */\nexport function deduplicateResolvedPaths(\n  values: Iterable<string>,\n  platform: NodeJS.Platform = process.platform,\n): string[] {\n  const seen = new Set<string>();\n  const unique: string[] = [];\n  for (const value of values) {\n    const resolved = path.resolve(value);\n    const identity = resolvedPathIdentity(resolved, platform);\n    if (seen.has(identity)) continue;\n    seen.add(identity);\n    unique.push(resolved);\n  }\n  return unique;\n}\n\nexport function sameResolvedPath(\n  left: string,\n  right: string,\n  platform: NodeJS.Platform = process.platform,\n): boolean {\n  return resolvedPathIdentity(left, platform) === resolvedPathIdentity(right, platform);\n}\n\nexport function isSameOrDescendantResolvedPath(\n  child: string,\n  parent: string,\n  platform: NodeJS.Platform = process.platform,\n): boolean {\n  const childIdentity = resolvedPathIdentity(child, platform);\n  const parentIdentity = resolvedPathIdentity(parent, platform);\n  return (\n    childIdentity === parentIdentity ||\n    childIdentity.startsWith(parentIdentity.endsWith(path.sep) ? parentIdentity : parentIdentity + path.sep)\n  );\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\path-policy.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"@specforge/types/directory-layout\"` with `'@specforge/types/directory-layout'`","line":1,"column":31,"nodeType":null,"messageId":"replace","endLine":1,"endColumn":66,"fix":{"range":[30,65],"text":"'@specforge/types/directory-layout'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·valid:·boolean;·violations:·string[];·` with `⏎··valid:·boolean;⏎··violations:·string[];⏎`","line":9,"column":36,"nodeType":null,"messageId":"replace","endLine":9,"endColumn":75,"fix":{"range":[422,461],"text":"\n  valid: boolean;\n  violations: string[];\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·'requirements',·'requirements_file',·'design',` with `⏎··'requirements',⏎··'requirements_file',⏎··'design',⏎·`","line":11,"column":17,"nodeType":null,"messageId":"replace","endLine":11,"endColumn":64,"fix":{"range":[521,568],"text":"\n  'requirements',\n  'requirements_file',\n  'design',\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·'contracts_file',·'trace',·'trace_file',·'tasks',` with `⏎··'contracts_file',⏎··'trace',⏎··'trace_file',⏎··'tasks',⏎·`","line":12,"column":15,"nodeType":null,"messageId":"replace","endLine":12,"endColumn":65,"fix":{"range":[598,648],"text":"\n  'contracts_file',\n  'trace',\n  'trace_file',\n  'tasks',\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(`${SPEC_DIR_NAME}/project/`·as·const)` with ``${SPEC_DIR_NAME}/project/`·as·const`","line":17,"column":29,"nodeType":null,"messageId":"replace","endLine":17,"endColumn":67,"fix":{"range":[888,926],"text":"`${SPEC_DIR_NAME}/project/` as const"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `target` with `⏎····target⏎··`","line":23,"column":142,"nodeType":null,"messageId":"replace","endLine":23,"endColumn":148,"fix":{"range":[1341,1347],"text":"\n    target\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `projectRoot:·string` with `⏎··projectRoot:·string⏎`","line":25,"column":58,"nodeType":null,"messageId":"replace","endLine":25,"endColumn":77,"fix":{"range":[1409,1428],"text":"\n  projectRoot: string\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `await·fs.readFile(projectSpecManifest(projectRoot),·'utf-8')` with `⏎······await·fs.readFile(projectSpecManifest(projectRoot),·'utf-8')⏎····`","line":27,"column":40,"nodeType":null,"messageId":"replace","endLine":27,"endColumn":100,"fix":{"range":[1501,1561],"text":"\n      await fs.readFile(projectSpecManifest(projectRoot), 'utf-8')\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(`${SPEC_DIR_NAME}/project/data_model.md`·as·const)` with ``${SPEC_DIR_NAME}/project/data_model.md`·as·const`","line":30,"column":39,"nodeType":null,"messageId":"replace","endLine":30,"endColumn":90,"fix":{"range":[1748,1799],"text":"`${SPEC_DIR_NAME}/project/data_model.md` as const"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·?·manifest['modules']·as·unknown[]` with `⏎······?·(manifest['modules']·as·unknown[])⏎·····`","line":38,"column":66,"nodeType":null,"messageId":"replace","endLine":38,"endColumn":101,"fix":{"range":[2222,2257],"text":"\n      ? (manifest['modules'] as unknown[])\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(`${SPEC_DIR_NAME}/project/data_model.md`·as·const)` with ``${SPEC_DIR_NAME}/project/data_model.md`·as·const`","line":53,"column":21,"nodeType":null,"messageId":"replace","endLine":53,"endColumn":72,"fix":{"range":[2955,3006],"text":"`${SPEC_DIR_NAME}/project/data_model.md` as const"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `projectRoot:·string,·targetPath:·unknown` with `⏎··projectRoot:·string,⏎··targetPath:·unknown⏎`","line":56,"column":55,"nodeType":null,"messageId":"replace","endLine":56,"endColumn":95,"fix":{"range":[3070,3110],"text":"\n  projectRoot: string,\n  targetPath: unknown\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(`${SPEC_DIR_NAME}/`·as·const)))` with ``${SPEC_DIR_NAME}/`·as·const))⏎···`","line":69,"column":26,"nodeType":null,"messageId":"replace","endLine":69,"endColumn":58,"fix":{"range":[3838,3870],"text":"`${SPEC_DIR_NAME}/` as const))\n   "}}],"suppressedMessages":[],"errorCount":13,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":13,"fixableWarningCount":0,"source":"import { SPEC_DIR_NAME } from \"@specforge/types/directory-layout\";\n/** Path policy enforcement for SpecForge. */\nimport * as fs from 'node:fs/promises';\nimport { isAbsolute } from 'node:path';\nimport { resolveSpecModuleIdentity } from '@specforge/types';\nimport { projectSpecManifest } from '@specforge/types/directory-layout';\nimport { MVP_FORBIDDEN_DIRS } from './project-layout.js';\n\nexport interface PathPolicyResult { valid: boolean; violations: string[]; }\nconst MODULE_SPEC_TARGET_KEYS = new Set([\n  'module_file', 'requirements', 'requirements_file', 'design', 'design_file',\n  'contracts', 'contracts_file', 'trace', 'trace_file', 'tasks', 'tasks_file',\n]);\nexport function normalizeProjectSpecTargetPath(value: unknown): string {\n  if (typeof value !== 'string') return '';\n  const normalized = value.trim().replace(/\\\\/g, '/').replace(/^\\.\\//, '');\n  if (normalized.startsWith((`${SPEC_DIR_NAME}/project/` as const))) return normalized;\n  if (normalized.startsWith('project/')) return `${SPEC_DIR_NAME}/${normalized}`;\n  return normalized;\n}\nfunction isCanonicalGovernanceTarget(target: string): boolean {\n  if (target === (`${SPEC_DIR_NAME}/project/data_model.md` as const)) return true;\n  return /^\\.specforge\\/project\\/modules\\/[A-Z][A-Z0-9]{1,11}\\/(?:module\\.json|requirements\\.md|design\\.md|contracts\\.json|trace\\.md)$/.test(target);\n}\nexport async function readDeclaredProjectSpecTargetPaths(projectRoot: string): Promise<Set<string>> {\n  try {\n    const parsed: unknown = JSON.parse(await fs.readFile(projectSpecManifest(projectRoot), 'utf-8'));\n    if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) return new Set();\n    const manifest = parsed as Record<string, unknown>;\n    const declared = new Set<string>([(`${SPEC_DIR_NAME}/project/data_model.md` as const)]);\n    const projectValue = manifest['project'];\n    if (projectValue && typeof projectValue === 'object' && !Array.isArray(projectValue)) {\n      for (const target of Object.values(projectValue as Record<string, unknown>)) {\n        const normalized = normalizeProjectSpecTargetPath(target);\n        if (normalized) declared.add(normalized);\n      }\n    }\n    const modules: unknown[] = Array.isArray(manifest['modules']) ? manifest['modules'] as unknown[] : [];\n    for (const moduleEntry of modules) {\n      if (!moduleEntry || typeof moduleEntry !== 'object' || Array.isArray(moduleEntry)) continue;\n      const identity = resolveSpecModuleIdentity(moduleEntry);\n      if (identity.valid && identity.moduleCode) {\n        declared.add(`${SPEC_DIR_NAME}/project/modules/${identity.moduleCode}/contracts.json`);\n      }\n      for (const [key, target] of Object.entries(moduleEntry as Record<string, unknown>)) {\n        if (!MODULE_SPEC_TARGET_KEYS.has(key)) continue;\n        const normalized = normalizeProjectSpecTargetPath(target);\n        if (normalized) declared.add(normalized);\n      }\n    }\n    return declared;\n  } catch {\n    return new Set([(`${SPEC_DIR_NAME}/project/data_model.md` as const)]);\n  }\n}\nexport async function isDeclaredProjectSpecTargetPath(projectRoot: string, targetPath: unknown): Promise<boolean> {\n  const normalized = normalizeProjectSpecTargetPath(targetPath);\n  if (!normalized) return false;\n  if (isCanonicalGovernanceTarget(normalized)) return true;\n  const declared = await readDeclaredProjectSpecTargetPaths(projectRoot);\n  return declared.has(normalized);\n}\nexport function enforcePathPolicy(filePath: string): PathPolicyResult {\n  const violations: string[] = [];\n  if (filePath.includes('\\\\')) violations.push('backslash not allowed');\n  if (isAbsolute(filePath)) violations.push('absolute paths not allowed');\n  if (filePath.includes('..')) violations.push('parent traversal not allowed');\n  if (filePath.includes('~')) violations.push('home expansion not allowed');\n  if (!filePath.includes((`${SPEC_DIR_NAME}/` as const))) violations.push('must have .specforge/ prefix');\n  for (const dir of MVP_FORBIDDEN_DIRS) {\n    if (filePath.includes(dir)) violations.push(`forbidden dir: ${dir}`);\n  }\n  return { valid: violations.length === 0, violations };\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\project-governance-fresh04-module-consumer.test.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·malformedCandidate?:·boolean;·wrongModuleId?:·boolean·` with `⏎··malformedCandidate?:·boolean;⏎··wrongModuleId?:·boolean;⏎`","line":20,"column":46,"nodeType":null,"messageId":"replace","endLine":20,"endColumn":101,"fix":{"range":[708,763],"text":"\n  malformedCandidate?: boolean;\n  wrongModuleId?: boolean;\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":32,"column":28,"nodeType":null,"messageId":"delete"