LOST',⏎······`","line":284,"column":1,"nodeType":null,"messageId":"replace","endLine":284,"endColumn":184,"fix":{"range":[25450,25633],"text":"        stdoutSha256: hash(''),\n        stderrSha256: hash(''),\n        nativeReceiptSha256: null,\n        nativeEventsSha256: null,\n        inspectionSha256: null,\n        outcome: 'not_executed',\n        failure: 'RUNTIME_INVOCATION_LEASE_LOST',\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····await·this.assertFresh(attempt.planId,plan);requireFact(!this.stopping,` with `······await·this.assertFresh(attempt.planId,·plan);⏎······requireFact(!this.stopping,·`","line":285,"column":1,"nodeType":null,"messageId":"replace","endLine":285,"endColumn":76,"fix":{"range":[25636,25711],"text":"      await this.assertFresh(attempt.planId, plan);\n      requireFact(!this.stopping, "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····const·lease=new·VerificationInvocationLease({planId:attempt.planId,attemptId:attempt.attemptId,reservationId,owner:proof,startedAt,` with `······const·lease·=·new·VerificationInvocationLease({⏎········planId:·attempt.planId,⏎········attemptId:·attempt.attemptId,⏎········reservationId,⏎········owner:·proof,⏎········startedAt,⏎········`","line":286,"column":1,"nodeType":null,"messageId":"replace","endLine":286,"endColumn":136,"fix":{"range":[25731,25866],"text":"      const lease = new VerificationInvocationLease({\n        planId: attempt.planId,\n        attemptId: attempt.attemptId,\n        reservationId,\n        owner: proof,\n        startedAt,\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `verify:()=>this.owner('sf_verification_run',{action:'run',work_item_id:plan.workItemId,attempt_record_id:reservationId` with `··verify:·()·=>⏎··········this.owner(⏎············'sf_verification_run',⏎············{·action:·'run',·work_item_id:·plan.workItemId,·attempt_record_id:·reservationId·`","line":287,"column":7,"nodeType":null,"messageId":"replace","endLine":287,"endColumn":125,"fix":{"range":[25880,25998],"text":"  verify: () =>\n          this.owner(\n            'sf_verification_run',\n            { action: 'run', work_item_id: plan.workItemId, attempt_record_id: reservationId "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `········{directory:root,sessionID:proof.sessionId,messageID:proof.messageId})` with `············{·directory:·root,·sessionID:·proof.sessionId,·messageID:·proof.messageId·}⏎··········),⏎······`","line":288,"column":1,"nodeType":null,"messageId":"replace","endLine":288,"endColumn":78,"fix":{"range":[26001,26078],"text":"            { directory: root, sessionID: proof.sessionId, messageID: proof.messageId }\n          ),\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `let·leaseId:string|` with `··let·leaseId:·string·|·`","line":289,"column":5,"nodeType":null,"messageId":"replace","endLine":289,"endColumn":24,"fix":{"range":[26086,26105],"text":"  let leaseId: string | "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `try` with `··try·`","line":290,"column":5,"nodeType":null,"messageId":"replace","endLine":290,"endColumn":8,"fix":{"range":[26120,26123],"text":"  try "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `······if(await·lease.start())facts=await·this.native.execute(plan,attempt,` with `········if·(await·lease.start())·facts·=·await·this.native.execute(plan,·attempt,·`","line":291,"column":1,"nodeType":null,"messageId":"replace","endLine":291,"endColumn":75,"fix":{"range":[26125,26199],"text":"        if (await lease.start()) facts = await this.native.execute(plan, attempt, "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":292,"column":1,"nodeType":null,"messageId":"insert","endLine":292,"endColumn":1,"fix":{"range":[26214,26214],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `········try·{·await·this.assertFresh(attempt.planId,plan);·}⏎········catch·(error)·{·facts.outcome·=·'failed';·facts.failure·=·errorCode(error);` with `··········try·{⏎············await·this.assertFresh(attempt.planId,·plan);⏎··········}·catch·(error)·{⏎············facts.outcome·=·'failed';⏎············facts.failure·=·errorCode(error);⏎·········`","line":293,"column":1,"nodeType":null,"messageId":"replace","endLine":294,"endColumn":84,"fix":{"range":[26254,26398],"text":"          try {\n            await this.assertFresh(attempt.planId, plan);\n          } catch (error) {\n            facts.outcome = 'failed';\n            facts.failure = errorCode(error);\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `······` with `········`","line":295,"column":1,"nodeType":null,"messageId":"replace","endLine":295,"endColumn":7,"fix":{"range":[26401,26407],"text":"        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····}finally` with `······}·finally·`","line":296,"column":1,"nodeType":null,"messageId":"replace","endLine":296,"endColumn":13,"fix":{"range":[26409,26421],"text":"      } finally "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `const·observation=await·lease.finish();` with `··const·observation·=·await·lease.finish();⏎········`","line":297,"column":7,"nodeType":null,"messageId":"replace","endLine":297,"endColumn":46,"fix":{"range":[26429,26468],"text":"  const observation = await lease.finish();\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `if(observation.terminal!=='completed'&&facts.outcome==='passed'){facts.outcome='cancelled';facts.failure='RUNTIME_INVOCATION_LEASE_LOST';` with `··if·(observation.terminal·!==·'completed'·&&·facts.outcome·===·'passed')·{⏎··········facts.outcome·=·'cancelled';⏎··········facts.failure·=·'RUNTIME_INVOCATION_LEASE_LOST';⏎········`","line":298,"column":7,"nodeType":null,"messageId":"replace","endLine":298,"endColumn":144,"fix":{"range":[26524,26661],"text":"  if (observation.terminal !== 'completed' && facts.outcome === 'passed') {\n          facts.outcome = 'cancelled';\n          facts.failure = 'RUNTIME_INVOCATION_LEASE_LOST';\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `······leaseId=await·this.store.put('lease',` with `········leaseId·=·await·this.store.put('lease',·`","line":299,"column":1,"nodeType":null,"messageId":"replace","endLine":299,"endColumn":44,"fix":{"range":[26663,26706],"text":"        leaseId = await this.store.put('lease', "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····` with `······`","line":300,"column":1,"nodeType":null,"messageId":"replace","endLine":300,"endColumn":5,"fix":{"range":[26720,26724],"text":"      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····requireFact(typeof·leaseId==='string',` with `······requireFact(typeof·leaseId·===·'string',·`","line":301,"column":1,"nodeType":null,"messageId":"replace","endLine":301,"endColumn":43,"fix":{"range":[26726,26768],"text":"      requireFact(typeof leaseId === 'string', "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····const·receipt:·VerificationExecutionReceipt·=·{contract:VERIFICATION_RECEIPT_CONTRACT,planId:attempt.planId,attemptId:attempt.attemptId,projectRoot:root,workItemId:plan.workItemId,purpose:` with `······const·receipt:·VerificationExecutionReceipt·=·{⏎········contract:·VERIFICATION_RECEIPT_CONTRACT,⏎········planId:·attempt.planId,⏎········attemptId:·attempt.attemptId,⏎········projectRoot:·root,⏎········workItemId:·plan.workItemId,⏎········purpose:·`","line":302,"column":1,"nodeType":null,"messageId":"replace","endLine":302,"endColumn":193,"fix":{"range":[26798,26990],"text":"      const receipt: VerificationExecutionReceipt = {\n        contract: VERIFICATION_RECEIPT_CONTRACT,\n        planId: attempt.planId,\n        attemptId: attempt.attemptId,\n        projectRoot: root,\n        workItemId: plan.workItemId,\n        purpose: "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `startedAt,finishedAt:new·Date().toISOString(),owner:proof,sourceIdentity:plan.source.identity,authorityIdentity:plan.authority.identity,assets:plan.assets,profile:plan.profile,budget:plan.budget,reservationId,leaseId,...facts` with `··startedAt,⏎········finishedAt:·new·Date().toISOString(),⏎········owner:·proof,⏎········sourceIdentity:·plan.source.identity,⏎········authorityIdentity:·plan.authority.identity,⏎········assets:·plan.assets,⏎········profile:·plan.profile,⏎········budget:·plan.budget,⏎········reservationId,⏎········leaseId,⏎········...facts,⏎······`","line":303,"column":7,"nodeType":null,"messageId":"replace","endLine":303,"endColumn":232,"fix":{"range":[27020,27245],"text":"  startedAt,\n        finishedAt: new Date().toISOString(),\n        owner: proof,\n        sourceIdentity: plan.source.identity,\n        authorityIdentity: plan.authority.identity,\n        assets: plan.assets,\n        profile: plan.profile,\n        budget: plan.budget,\n        reservationId,\n        leaseId,\n        ...facts,\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····validateVerificationReceipt(receipt);·const·id·=·await·this.store.put('receipt',` with `······validateVerificationReceipt(receipt);⏎······const·id·=·await·this.store.put('receipt',·`","line":304,"column":1,"nodeType":null,"messageId":"replace","endLine":304,"endColumn":85,"fix":{"range":[27248,27332],"text":"      validateVerificationReceipt(receipt);\n      const id = await this.store.put('receipt', "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····let·stdout·=·'',` with `······let·stdout·=·'',⏎·······`","line":305,"column":1,"nodeType":null,"messageId":"replace","endLine":305,"endColumn":21,"fix":{"range":[27342,27362],"text":"      let stdout = '',\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":306,"column":1,"nodeType":null,"messageId":"insert","endLine":306,"endColumn":1,"fix":{"range":[27376,27376],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `stdout·=·(await·readVerificationFile(path.join(nativeRunRoot(this.store.root,attempt),'stdout.bin'),1048576)` with `··stdout·=·(⏎··········await·readVerificationFile(⏎············path.join(nativeRunRoot(this.store.root,·attempt),·'stdout.bin'),⏎············1048576⏎··········)⏎········`","line":307,"column":7,"nodeType":null,"messageId":"replace","endLine":307,"endColumn":115,"fix":{"range":[27430,27538],"text":"  stdout = (\n          await readVerificationFile(\n            path.join(nativeRunRoot(this.store.root, attempt), 'stdout.bin'),\n            1048576\n          )\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `······stderr·=·(await·readVerificationFile(path.join(nativeRunRoot(this.store.root,attempt),'stderr.bin'),1048576)` with `········stderr·=·(⏎··········await·readVerificationFile(⏎············path.join(nativeRunRoot(this.store.root,·attempt),·'stderr.bin'),⏎············1048576⏎··········)⏎········`","line":308,"column":1,"nodeType":null,"messageId":"replace","endLine":308,"endColumn":115,"fix":{"range":[27558,27672],"text":"        stderr = (\n          await readVerificationFile(\n            path.join(nativeRunRoot(this.store.root, attempt), 'stderr.bin'),\n            1048576\n          )\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":309,"column":5,"nodeType":null,"messageId":"insert","endLine":309,"endColumn":5,"fix":{"range":[27696,27696],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····return·{success:receipt.outcome==='passed',receipt_id:id,attempt_record_id:reservationId,attempt_id:attempt.attemptId,plan_id:attempt.planId,outcome:receipt.outcome,exit_code:` with `······return·{⏎········success:·receipt.outcome·===·'passed',⏎········receipt_id:·id,⏎········attempt_record_id:·reservationId,⏎········attempt_id:·attempt.attemptId,⏎········plan_id:·attempt.planId,⏎········outcome:·receipt.outcome,⏎········exit_code:·`","line":310,"column":1,"nodeType":null,"messageId":"replace","endLine":310,"endColumn":180,"fix":{"range":[27698,27877],"text":"      return {\n        success: receipt.outcome === 'passed',\n        receipt_id: id,\n        attempt_record_id: reservationId,\n        attempt_id: attempt.attemptId,\n        plan_id: attempt.planId,\n        outcome: receipt.outcome,\n        exit_code: "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `······cleanup_proved:receipt.cleanupProved,failure:receipt.failure,stdout:stdout.slice(0,20000),stderr:stderr.slice(0,20000),output_preview_truncated:stdout.length>20000||stderr.length>20000,output_complete:receipt.outputComplete` with `········cleanup_proved:·receipt.cleanupProved,⏎········failure:·receipt.failure,⏎········stdout:·stdout.slice(0,·20000),⏎········stderr:·stderr.slice(0,·20000),⏎········output_preview_truncated:·stdout.length·>·20000·||·stderr.length·>·20000,⏎········output_complete:·receipt.outputComplete,⏎······`","line":311,"column":1,"nodeType":null,"messageId":"replace","endLine":311,"endColumn":230,"fix":{"range":[27895,28124],"text":"        cleanup_proved: receipt.cleanupProved,\n        failure: receipt.failure,\n        stdout: stdout.slice(0, 20000),\n        stderr: stderr.slice(0, 20000),\n        output_preview_truncated: stdout.length > 20000 || stderr.length > 20000,\n        output_complete: receipt.outputComplete,\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·this.activeAttempts.delete(attempt.attemptId);` with `⏎······this.activeAttempts.delete(attempt.attemptId);⏎···`","line":312,"column":16,"nodeType":null,"messageId":"replace","endLine":312,"endColumn":63,"fix":{"range":[28142,28189],"text":"\n      this.activeAttempts.delete(attempt.attemptId);\n   "}}],"suppressedMessages":[],"errorCount":220,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":220,"fixableWarningCount":0,"source":"/** D23 Runtime owner. No workflow transitions and no business/code writes. */\nimport * as fs from 'node:fs/promises';\nimport path from 'node:path';\nimport { randomUUID } from 'node:crypto';\nimport type { ToolInvocationVerifier, TrustedToolInvocationProof } from '@specforge/types/trusted-tool-invocation';\nimport type { ToolDeps, ToolInvokeRequest } from '../tools/ToolDispatcher';\nimport { captureVerificationAuthority, type VerificationTaskSelector } from './authority-snapshot';\nimport { collectNodeCommandInputs, compileNodeCommand } from './node-command-contract';\nimport { VerificationOwnerStore, assertVerificationPath, canonicalVerificationJson as json, readVerificationFile, verificationId as hash } from './owner-store';\nimport { captureVerificationSource, readFrozenVerificationInputs } from './source-snapshot';\nimport { loadVerificationAssets } from './verification-assets';\nimport { VerificationNativeExecutor, nativeConfigPath, nativeRunRoot, requestVerificationCancellation, writeVerificationPrivate, type NativeExecutionFacts } from './native-executor';\nimport { VerificationInvocationLease } from './invocation-lease';\nimport { verificationRejectionDiagnostic } from './rejection-diagnostic';\nimport { validateVerificationPlan, validateVerificationAttempt, validateVerificationReceipt, validateVerificationInvocationLease, validateTrustedInvocationProof, verificationRecord as record,\n  verificationRequire as requireFact, verificationHash, sameVerificationPath } from './verification-schema';\nimport { VERIFICATION_PLAN_CONTRACT, VERIFICATION_RECEIPT_CONTRACT, VERIFICATION_PROFILE, VERIFICATION_BUDGET,\n  type VerificationPlan, type VerificationAttempt, type VerificationExecutionReceipt, type VerificationAssets } from './verification-plan';\n\ntype Context = ToolInvokeRequest['context'];\ntype Dependencies = Pick<ToolDeps, 'projectManager'|'stateManager'>;\nconst ownId = (proof: TrustedToolInvocationProof) => hash(json([proof.sessionId, proof.messageId, proof.callId]));\nconst errorCode = (error: unknown) => error instanceof Error && /^VERIFICATION_[A-Z_]+$/.test(error.message) ? error.message : 'VERIFICATION_OPERATION_FAILED';\n\nexport class VerificationRuntime {\n  readonly native: VerificationNativeExecutor;\n  private readonly activeAttempts = new Map<string, VerificationAttempt>();\n  private readonly activeOperations = new Set<Promise<unknown>>();\n  private stopping = false;\n  constructor(readonly deps: Dependencies, readonly runtime: ToolInvocationVerifier,\n    readonly store = new VerificationOwnerStore(), readonly readAssets: () => Promise<VerificationAssets> = loadVerificationAssets) {\n    this.native = new VerificationNativeExecutor(store.root);\n  }\n  async shutdown():Promise<void> {\n    this.stopping=true;\n    await Promise.all([...this.activeAttempts.values()].map(attempt=>requestVerificationCancellation(this.store.root,attempt)));\n    let timer:ReturnType<typeof setTimeout>|undefined;\n    try {\n      await Promise.race([Promise.allSettled([...this.activeOperations]),new Promise<never>((_resolve,reject)=>{timer=setTimeout(()=>reject(Error('VERIFICATION_SHUTDOWN_UNPROVED')),30000);})]);\n    } finally { if(timer)clearTimeout(timer); }\n  }\n\n  private project(context: Context): string {\n    const root = context?.directory;\n    requireFact(typeof root === 'string' && path.isAbsolute(root), 'PROJECT_CONTEXT_REQUIRED');\n    return path.resolve(root);\n  }\n  private async owner(tool: 'sf_verification_plan'|'sf_verification_run', args: Record<string,unknown>, context: Context): Promise<TrustedToolInvocationProof> {\n    const directory = this.project(context);\n    requireFact(typeof context?.sessionID === 'string' && typeof context?.messageID === 'string', 'ACTUAL_INVOCATION_REQUIRED');\n    const proof = await this.runtime.verifyToolInvocation({ tool, args, directory, sessionId: context.sessionID, messageId: context.messageID });\n    validateTrustedInvocationProof(proof,tool === 'sf_verification_plan' ? 'sf-orchestrator' : 'sf-verifier');\n    requireFact(proof.tool === tool && proof.sessionId === context.sessionID && proof.messageId === context.messageID && sameVerificationPath(proof.directory,directory) && proof.inputSha256 === hash(json(args)) && Date.now()-proof.startedAt <= 300000 && Date.now() >= proof.startedAt, 'ACTUAL_INVOCATION_MISMATCH');\n    return proof;\n  }\n  private async claim(proof: TrustedToolInvocationProof, operation: string, detail: Record<string,unknown> = {}): Promise<string> {\n    const id = ownId(proof);\n    requireFact(!await this.store.has('invocation', id), 'INVOCATION_ALREADY_USED');\n    await this.store.put('invocation', { contract:'verification-invocation/v1',proof,operation,...detail }, id);\n    return id;\n  }\n  private async assets(): Promise<VerificationAssets> {\n    const value = await this.readAssets();\n    requireFact(sameVerificationPath(process.execPath, value.daemonPath), 'RUNNING_DAEMON_ASSET_MISMATCH');\n    return value;\n  }\n  private selector(plan: VerificationPlan): VerificationTaskSelector {\n    return { workItemId:plan.workItemId,taskId:plan.authority.taskId,verificationType:plan.authority.verificationType,commandIndex:plan.authority.commandIndex };\n  }\n  async getPlan(id: string): Promise<VerificationPlan> {\n    verificationHash(id); const value = await this.store.get('plan', id); validateVerificationPlan(value); return value;\n  }\n  async getAttempt(id: string): Promise<VerificationAttempt> {\n    verificationHash(id); const value = await this.store.get('attempt', id); validateVerificationAttempt(value); return value;\n  }\n  async consume(input: {receiptId:string;projectRoot:string;workItemId:string;taskId:string;verificationType:string;commandIndex:number;command:string;purpose:'implementation'|'formal'}): Promise<VerificationExecutionReceipt> {\n    verificationHash(input.receiptId);\n    const value = await this.store.get('receipt',input.receiptId); validateVerificationReceipt(value); const receipt = value;\n    const plan = await this.getPlan(receipt.planId), attempt = await this.getAttempt(receipt.reservationId);\n    const lease=await this.store.get('lease',receipt.leaseId);validateVerificationInvocationLease(lease);\n    requireFact(lease.terminal==='completed'&&lease.planId===receipt.planId&&lease.attemptId===receipt.attemptId&&lease.reservationId===receipt.reservationId&&\n      json(lease.owner)===json(receipt.owner)&&lease.startedAt===receipt.startedAt&&Date.parse(lease.finishedAt)<=Date.parse(receipt.finishedAt),'INVOCATION_LEASE_NOT_ACCEPTABLE');\n    this.sameSubject(plan,input.projectRoot,input.workItemId);\n    requireFact(receipt.projectRoot === plan.projectRoot && receipt.workItemId === plan.workItemId && receipt.purpose === input.purpose && plan.authority.purpose === input.purpose &&\n      plan.authority.taskId === input.taskId && plan.authority.verificationType === input.verificationType && plan.authority.commandIndex === input.commandIndex && plan.command.original === input.command,\n      'RECEIPT_SUBJECT_MISMATCH');\n    requireFact(receipt.outcome === 'passed' && receipt.failure === null && receipt.sourceIdentity === plan.source.identity && receipt.authorityIdentity === plan.authority.identity &&\n      json(receipt.assets) === json(plan.assets) && json(receipt.budget) === json(plan.budget) && receipt.profile === plan.profile &&\n      attempt.planId === receipt.planId && attempt.attemptId === receipt.attemptId && attempt.projectRoot === plan.projectRoot && attempt.workItemId === plan.workItemId, 'RECEIPT_NOT_ACCEPTABLE');\n    requireFact(Date.parse(plan.createdAt) <= Date.parse(attempt.createdAt) && Date.parse(attempt.createdAt) <= Date.parse(receipt.startedAt) &&\n      Date.parse(receipt.finishedAt) < Date.parse(plan.expiresAt) && Date.parse(receipt.finishedAt) <= Date.now() &&\n      Date.parse(plan.owner.observedAt) <= Date.parse(plan.createdAt) && Date.parse(receipt.owner.observedAt) <= Date.parse(receipt.startedAt), 'RECEIPT_LIFETIME_INVALID');\n    const preparation = record(await this.store.get('invocation',ownId(plan.owner)),['contract','proof','operation','plan','planId']);\n    requireFact(preparation.contract === 'verification-invocation/v1' && preparation.operation === 'prepare-plan' && preparation.planId === receipt.planId && json(preparation.plan) === json(plan) && json(preparation.proof) === json(plan.owner), 'PLAN_INVOCATION_INVALID');\n    const reservation = record(await this.store.get('invocation',ownId(attempt.owner)),['contract','proof','operation','attempt']);\n    requireFact(reservation.contract === 'verification-invocation/v1' && reservation.operation === 'prepare-attempt' && json(reservation.attempt) === json(attempt) && json(reservation.proof) === json(attempt.owner), 'ATTEMPT_INVOCATION_INVALID');\n    const invocation = record(await this.store.get('invocation',ownId(receipt.owner)),['contract','proof','operation','reservationId']);\n    requireFact(invocation.contract === 'verification-invocation/v1' && invocation.operation === 'run-attempt' && invocation.reservationId === receipt.reservationId && json(invocation.proof) === json(receipt.owner), 'EXECUTION_INVOCATION_INVALID');\n    const start = record(await this.store.get('start',hash(attempt.attemptId)),['contract','reservationId','attemptId','planId','owner','startedAt']);\n    requireFact(start.contract === 'verification-start/v1' && start.reservationId === receipt.reservationId && start.attemptId === receipt.attemptId && start.planId === receipt.planId && start.startedAt === receipt.startedAt && json(start.owner) === json(receipt.owner), 'EXECUTION_START_INVALID');\n    requireFact(hash(await readVerificationFile(nativeConfigPath(this.store.root,attempt),4194304)) === attempt.nativeConfigSha256, 'NATIVE_CONFIG_DRIFT');\n    const root = nativeRunRoot(this.store.root,attempt);\n    for (const [file, expected, limit] of [ ['stdout.bin',receipt.stdoutSha256,1048576],['stderr.bin',receipt.stderrSha256,1048576],\n      ['receipt.json',receipt.nativeReceiptSha256,65536],['events.jsonl',receipt.nativeEventsSha256,16777216] ] as const) {\n      requireFact(hash(await readVerificationFile(path.join(root,file),limit)) === expected,'EXECUTION_RAW_EVIDENCE_CHANGED');\n    }\n    const inspectionRaw = await readVerificationFile(path.join(this.store.root,'inspections',receipt.inspectionSha256+'.json'),1048576);\n    requireFact(hash(inspectionRaw) === receipt.inspectionSha256,'INSPECTION_EVIDENCE_CHANGED');\n    const inspection = record(JSON.parse(inspectionRaw.toString('utf8')),['contract','utc','plan_id','attempt_id','config_sha256','events_sha256','root_created','profile_present','storage_present','job_absent','processes','processes_ended','cleanup_proved','recovery_requested','application_passed']);\n    requireFact(inspection.contract === 'verification-native-inspection/v1' && inspection.plan_id === receipt.planId && inspection.attempt_id === receipt.attemptId && inspection.config_sha256 === attempt.nativeConfigSha256 &&\n      inspection.events_sha256 === receipt.nativeEventsSha256 && inspection.cleanup_proved === true && inspection.processes_ended === true && inspection.profile_present === false && inspection.storage_present === false && inspection.application_passed === false &&\n      typeof inspection.utc === 'string' && Date.parse(inspection.utc) >= Date.parse(receipt.startedAt) && Date.parse(inspection.utc) <= Date.parse(receipt.finishedAt),'INSPECTION_BINDING_INVALID');\n    await this.assertFresh(receipt.planId,plan,true);\n    return receipt;\n  }\n  private sameSubject(plan: VerificationPlan, root: string, workItemId: unknown): void {\n    requireFact(sameVerificationPath(plan.projectRoot, root) && plan.workItemId === workItemId, 'SUBJECT_MISMATCH');\n  }\n\n  /** Every consumer calls this; post-stage validation preserves immutable authority and checks current state separately. */\n  async assertFresh(planId: string, plan: VerificationPlan, consume = false): Promise<void> {\n    validateVerificationPlan(plan); requireFact(hash(json(plan)) === planId, 'PLAN_CONTENT_ID_INVALID');\n    requireFact(!await this.store.has('revocation', planId), 'VERIFICATION_PERMISSION_REVOKED');\n    if (!consume) requireFact(Date.now() >= Date.parse(plan.createdAt) && Date.now() < Date.parse(plan.expiresAt), 'PLAN_EXPIRED');\n    const authority = await captureVerificationAuthority({ ...this.selector(plan), projectRoot:plan.projectRoot,deps:this.deps,\n      ...(consume ? { consumePurpose:plan.authority.purpose } : {}) });\n    requireFact(consume ? authority.basisIdentity === plan.authority.basisIdentity : authority.identity === plan.authority.identity, 'AUTHORITY_CHANGED');\n    const source = await captureVerificationSource(plan.projectRoot, plan.source.files.map(f => f.path));\n    requireFact(source.identity === plan.source.identity, 'SOURCE_CHANGED');\n    requireFact(json(await this.assets()) === json(plan.assets), 'ASSETS_CHANGED');\n    const inputs = await readFrozenVerificationInputs(plan.source);\n    const selected = await collectNodeCommandInputs(plan.projectRoot, plan.command.original, source.trackedPaths);\n    requireFact(json(selected.inputPaths) === json(plan.source.files.map(f => f.path).sort()), 'INPUT_GRAPH_CHANGED');\n    requireFact(json(compileNodeCommand(plan.command.original, selected.sources)) === json(plan.command), 'COMMAND_PROOF_CHANGED');\n    // Read the frozen input bytes too; authenticated plan data cannot excuse a changed private copy.\n    await this.checkFrozen(planId, inputs);\n  }\n\n  private async listFrozen(directory: string): Promise<string[]> {\n    await assertVerificationPath(directory); const names: string[] = [];\n    const walk = async (current: string): Promise<void> => {\n      for (const entry of await fs.readdir(current, { withFileTypes:true })) {\n        const full = path.join(current, entry.name); await assertVerificationPath(full);\n        if (entry.isDirectory()) await walk(full);\n        else { requireFact(entry.isFile(), 'FROZEN_INPUT_KIND_INVALID'); names.push(path.relative(directory, full).replace(/\\\\/g,'/')); }\n        requireFact(names.length <= 2048, 'FROZEN_INPUT_COUNT');\n      }\n    };\n    await walk(directory); return names.sort();\n  }\n  private async checkFrozen(id: string, inputs: Map<string,Buffer>): Promise<void> {\n    const root = path.join(this.store.root,'input',id);\n    requireFact(json(await this.listFrozen(root)) === json([...inputs.keys()].sort()), 'FROZEN_INPUT_SET_CHANGED');\n    for (const [name, bytes] of inputs) requireFact((await readVerificationFile(path.join(root,name))).equals(bytes), 'FROZEN_INPUT_CHANGED');\n  }\n  private async freeze(id: string, inputs: Map<string,Buffer>, recover: boolean): Promise<void> {\n    const root = path.join(this.store.root,'input',id);\n    await assertVerificationPath(root, true); await fs.mkdir(path.dirname(root), { recursive:true,mode:0o700 });\n    try { await fs.mkdir(root, { mode:0o700 }); }\n    catch (error) { if (!recover || (error as NodeJS.ErrnoException).code !== 'EEXIST') throw error; }\n    if (recover) for (const name of await this.listFrozen(root)) requireFact(inputs.has(name), 'PREPARATION_EXTRA_INPUT');\n    for (const [name, bytes] of inputs) {\n      const file = path.join(root,name);\n      try { await writeVerificationPrivate(file,bytes); }\n      catch (error) { if (!recover || (error as NodeJS.ErrnoException).code !== 'EEXIST' || !(await readVerificationFile(file)).equals(bytes)) throw error; }\n    }\n    await this.checkFrozen(id,inputs);\n  }\n\n  async plan(args: Record<string,unknown>, context: Context): Promise<Record<string,unknown>> {\n    let diagnosticStage='project_context';\n    try {\n    const action = args.action, root = this.project(context);\n    diagnosticStage='invocation_owner';\n    const proof = await this.owner('sf_verification_plan', args, context);\n    if (action === 'create') {\n      requireFact(!this.stopping,'DAEMON_STOPPING');\n      record(args,['action','work_item_id','task_id','verification_type','command_index']);\n      diagnosticStage='authority';\n      const authority = await captureVerificationAuthority({ projectRoot:root,deps:this.deps,workItemId:args.work_item_id as string,\n        taskId:args.task_id as string,verificationType:args.verification_type as string,commandIndex:args.command_index as number });\n      diagnosticStage='source_inventory';\n      const inventory = await captureVerificationSource(root,[]);\n      diagnosticStage='input_graph';\n      const selected = await collectNodeCommandInputs(root,authority.command,inventory.trackedPaths);\n      diagnosticStage='command_proof';\n      const command = compileNodeCommand(authority.command,selected.sources);\n      diagnosticStage='source_inputs';\n      const source = await captureVerificationSource(root,selected.inputPaths);\n      const createdAt = new Date().toISOString();\n      diagnosticStage='fixed_assets';\n      const plan: VerificationPlan = { contract:VERIFICATION_PLAN_CONTRACT,createdAt,expiresAt:new Date(Date.parse(createdAt)+600000).toISOString(),projectRoot:root,workItemId:authority.workItemId,\n        authority,source,command,assets:await this.assets(),profile:VERIFICATION_PROFILE,budget:VERIFICATION_BUDGET,\n        permission:{kind:'independent-readonly-verification/v1',grantee:'sf-verifier',codeWriteGranted:false},owner:proof };\n      diagnosticStage='validate_and_read_inputs';\n      validateVerificationPlan(plan); const id = hash(json(plan)), inputs = await readFrozenVerificationInputs(source);\n      for (const [name, identity] of Object.entries(command.semanticProof.inputHashes)) requireFact(hash(inputs.get(name)!) === identity, 'INPUT_CHANGED_DURING_PLANNING');\n      diagnosticStage='claim_invocation';\n      const preparation = await this.claim(proof,'prepare-plan',{plan,planId:id});\n      try {\n        await this.freeze(id,inputs,false); await this.assertFresh(id,plan);\n        requireFact(await this.store.put('plan',plan) === id, 'PLAN_PUBLISH_IDENTITY');\n      } catch (error) { return {success:false,error:errorCode(error),preparation_id:preparation,plan_id:id,application_started:false}; }\n      return {success:true,plan_id:id,preparation_id:preparation,expires_at:plan.expiresAt,purpose:authority.purpose,original_command:command.original,actual_argv:command.argv,profile:plan.profile,code_write_granted:false};\n    }\n    if (action === 'recover') {\n      requireFact(!this.stopping,'DAEMON_STOPPING');\n      record(args,['action','work_item_id','preparation_id']); verificationHash(args.preparation_id);\n      const prior = record(await this.store.get('invocation',args.preparation_id),['contract','proof','operation','plan','planId']);\n      requireFact(prior.contract === 'verification-invocation/v1' && prior.operation === 'prepare-plan', 'PREPARATION_INVALID');\n      validateVerificationPlan(prior.plan); verificationHash(prior.planId); const plan = prior.plan;\n      this.sameSubject(plan,root,args.work_item_id); requireFact(hash(json(plan)) === prior.planId, 'PREPARATION_PLAN_INVALID');\n      await this.claim(proof,'recover-plan',{preparationId:args.preparation_id,planId:prior.planId});\n      const inputs = await readFrozenVerificationInputs(plan.source); await this.freeze(prior.planId,inputs,true); await this.assertFresh(prior.planId,plan);\n      if (await this.store.has('plan',prior.planId)) requireFact(json(await this.getPlan(prior.planId)) === json(plan), 'PUBLISHED_PLAN_DRIFT');\n      else await this.store.put('plan',plan);\n      return {success:true,plan_id:prior.planId,application_started:false};\n    }\n    if (action === 'revoke') {\n      record(args,['action','work_item_id','plan_id']); verificationHash(args.plan_id); const plan = await this.getPlan(args.plan_id); this.sameSubject(plan,root,args.work_item_id);\n      await this.claim(proof,'revoke-plan',{planId:args.plan_id});\n      if (!await this.store.has('revocation',args.plan_id)) await this.store.put('revocation',{contract:'verification-revocation/v1',planId:args.plan_id,owner:proof,revokedAt:new Date().toISOString()},args.plan_id);\n      for (const attempt of this.activeAttempts.values()) if (attempt.planId === args.plan_id) await requestVerificationCancellation(this.store.root,attempt);\n      return {success:true,plan_id:args.plan_id,verification_permission_revoked:true,code_write_granted:false};\n    }\n    throw new Error('VERIFICATION_PLAN_ACTION_INVALID');\n    } catch(error) {\n      const message=error instanceof Error?error.message:'';\n      if(!/^(?:VERIFICATION|TOOL_INVOCATION|NODE_COMMAND)_[A-Z_]+$/.test(message))console.error(JSON.stringify({...verificationRejectionDiagnostic(error),stage:diagnosticStage}));\n      throw error;\n    }\n  }\n\n  async run(args: Record<string,unknown>, context: Context, signal?: AbortSignal): Promise<Record<string,unknown>> {\n    const root = this.project(context), proof = await this.owner('sf_verification_run',args,context);\n    if (args.action === 'prepare') {\n      requireFact(!this.stopping,'DAEMON_STOPPING');\n      record(args,['action','work_item_id','plan_id']); verificationHash(args.plan_id);\n      const plan = await this.getPlan(args.plan_id); this.sameSubject(plan,root,args.work_item_id); await this.assertFresh(args.plan_id,plan);\n      const attemptId = randomUUID().replace(/-/g,''), createdAt = new Date().toISOString();\n      const nativeConfig = { contract:'verification-native-plan/v1',plan_id:args.plan_id,attempt_id:attemptId,owner_root:this.store.root,\n        attempt_root:path.join(this.store.root,'runs',attemptId),node_path:plan.assets.nodePath,node_sha256:plan.assets.nodeSha256,daemon_path:plan.assets.daemonPath,daemon_sha256:plan.assets.daemonSha256,\n        kind:plan.command.kind,entry:plan.command.entry,inline_source:plan.command.inlineSource,argv:plan.command.argv,\n        files:plan.source.files.map(f=>({path:f.path,sha256:f.sha256,bytes:f.bytes})),profile:plan.profile,wall_ms:plan.budget.wallMs,memory_bytes:plan.budget.memoryBytes,process_limit:plan.budget.processes,output_bytes:plan.budget.stdoutBytes };\n      const raw = json(nativeConfig)+'\\n';\n      const attempt: VerificationAttempt = {contract:'verification-attempt/v1',planId:args.plan_id,attemptId,createdAt,projectRoot:root,workItemId:plan.workItemId,owner:proof,nativeConfigSha256:hash(raw),initialAttemptAbsent:true};\n      validateVerificationAttempt(attempt);\n      await this.claim(proof,'prepare-attempt',{attempt}); await writeVerificationPrivate(nativeConfigPath(this.store.root,attempt),raw);\n      const id = await this.store.put('attempt',attempt);\n      return {success:true,attempt_record_id:id,attempt_id:attemptId,plan_id:attempt.planId,application_started:false};\n    }\n    requireFact(['run','cancel','recover'].includes(String(args.action)), 'RUN_ACTION_INVALID');\n    record(args,['action','work_item_id','attempt_record_id']); verificationHash(args.attempt_record_id);\n    const reservationId = args.attempt_record_id, attempt = await this.getAttempt(reservationId), plan = await this.getPlan(attempt.planId);\n    this.sameSubject(plan,root,args.work_item_id); requireFact(attempt.projectRoot === plan.projectRoot && attempt.workItemId === plan.workItemId, 'ATTEMPT_PLAN_MISMATCH');\n    if (args.action === 'cancel') {\n      await this.claim(proof,'cancel-attempt',{reservationId}); await requestVerificationCancellation(this.store.root,attempt);\n      return {success:true,attempt_record_id:reservationId,cancellation_requested:true,application_passed:false};\n    }\n    if (args.action === 'recover') {\n      requireFact(json(await this.assets()) === json(plan.assets), 'RECOVERY_ASSETS_CHANGED');\n      await this.claim(proof,'recover-attempt',{reservationId});\n      // Close the pre-mutex startup race too: a delayed old launcher must observe cancellation before Main.\n      await requestVerificationCancellation(this.store.root,attempt);\n      requireFact(!this.activeAttempts.has(attempt.attemptId),'ATTEMPT_STILL_ACTIVE');\n      const inspection = await this.native.inspect(plan,attempt,true);\n      const recoveryId = await this.store.put('recovery',{contract:'verification-recovery/v1',reservationId,planId:attempt.planId,attemptId:attempt.attemptId,owner:proof,utc:new Date().toISOString(),inspection,applicationPassed:false});\n      return {success:true,recovery_id:recoveryId,attempt_record_id:reservationId,cleanup_proved:inspection.cleanupProved,application_passed:false};\n    }\n    const operation=this.executePrepared(plan,attempt,reservationId,proof,root,signal);\n    this.activeOperations.add(operation);\n    try{return await operation;}finally{this.activeOperations.delete(operation);}\n  }\n\n  private async executePrepared(plan:VerificationPlan,attempt:VerificationAttempt,reservationId:string,proof:TrustedToolInvocationProof,root:string,signal?:AbortSignal):Promise<Record<string,unknown>> {\n    requireFact(!this.stopping,'DAEMON_STOPPING');\n    this.activeAttempts.set(attempt.attemptId,attempt);\n    try {\n    await this.assertFresh(attempt.planId,plan); requireFact(!signal?.aborted,'REQUEST_ALREADY_CANCELLED');requireFact(!this.stopping,'DAEMON_STOPPING');\n    await this.claim(proof,'run-attempt',{reservationId});\n    const startedAt = new Date().toISOString();\n    await this.store.put('start',{contract:'verification-start/v1',reservationId,attemptId:attempt.attemptId,planId:attempt.planId,owner:proof,startedAt},hash(attempt.attemptId));\n    let facts:NativeExecutionFacts={processStarted:false,processResumed:false,exitCode:null,launcherExitCode:null,jobEnded:false,cleanupProved:false,outputComplete:false,\n      stdoutSha256:hash(''),stderrSha256:hash(''),nativeReceiptSha256:null,nativeEventsSha256:null,inspectionSha256:null,outcome:'not_executed',failure:'RUNTIME_INVOCATION_LEASE_LOST'};\n    await this.assertFresh(attempt.planId,plan);requireFact(!this.stopping,'DAEMON_STOPPING');\n    const lease=new VerificationInvocationLease({planId:attempt.planId,attemptId:attempt.attemptId,reservationId,owner:proof,startedAt,signal,\n      verify:()=>this.owner('sf_verification_run',{action:'run',work_item_id:plan.workItemId,attempt_record_id:reservationId},\n        {directory:root,sessionID:proof.sessionId,messageID:proof.messageId})});\n    let leaseId:string|undefined;\n    try{\n      if(await lease.start())facts=await this.native.execute(plan,attempt,lease.signal);\n      if (facts.outcome === 'passed') {\n        try { await this.assertFresh(attempt.planId,plan); }\n        catch (error) { facts.outcome = 'failed'; facts.failure = errorCode(error); }\n      }\n    }finally{\n      const observation=await lease.finish();validateVerificationInvocationLease(observation);\n      if(observation.terminal!=='completed'&&facts.outcome==='passed'){facts.outcome='cancelled';facts.failure='RUNTIME_INVOCATION_LEASE_LOST';}\n      leaseId=await this.store.put('lease',observation);\n    }\n    requireFact(typeof leaseId==='string','INVOCATION_LEASE_REQUIRED');\n    const receipt: VerificationExecutionReceipt = {contract:VERIFICATION_RECEIPT_CONTRACT,planId:attempt.planId,attemptId:attempt.attemptId,projectRoot:root,workItemId:plan.workItemId,purpose:plan.authority.purpose,\n      startedAt,finishedAt:new Date().toISOString(),owner:proof,sourceIdentity:plan.source.identity,authorityIdentity:plan.authority.identity,assets:plan.assets,profile:plan.profile,budget:plan.budget,reservationId,leaseId,...facts};\n    validateVerificationReceipt(receipt); const id = await this.store.put('receipt',receipt);\n    let stdout = '', stderr = '';\n    if (receipt.nativeReceiptSha256 !== null) {\n      stdout = (await readVerificationFile(path.join(nativeRunRoot(this.store.root,attempt),'stdout.bin'),1048576)).toString('utf8');\n      stderr = (await readVerificationFile(path.join(nativeRunRoot(this.store.root,attempt),'stderr.bin'),1048576)).toString('utf8');\n    }\n    return {success:receipt.outcome==='passed',receipt_id:id,attempt_record_id:reservationId,attempt_id:attempt.attemptId,plan_id:attempt.planId,outcome:receipt.outcome,exit_code:receipt.exitCode,\n      cleanup_proved:receipt.cleanupProved,failure:receipt.failure,stdout:stdout.slice(0,20000),stderr:stderr.slice(0,20000),output_preview_truncated:stdout.length>20000||stderr.length>20000,output_complete:receipt.outputComplete};\n    } finally { this.activeAttempts.delete(attempt.attemptId); }\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\verification\\authority-snapshot.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·projectSpecManifest,·workItemRoot,·workItemCandidateTasks·` with `⏎··projectSpecManifest,⏎··workItemRoot,⏎··workItemCandidateTasks,⏎`","line":3,"column":9,"nodeType":null,"messageId":"replace","endLine":3,"endColumn":68,"fix":{"range":[78,137],"text":"\n  projectSpecManifest,\n  workItemRoot,\n  workItemCandidateTasks,\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·validateApprovedUserDecisionForClose,·computeCandidateHash·` with `⏎··validateApprovedUserDecisionForClose,⏎··computeCandidateHash,⏎`","line":10,"column":9,"nodeType":null,"messageId":"replace","endLine":10,"endColumn":69,"fix":{"range":[655,715],"text":"\n  validateApprovedUserDecisionForClose,\n  computeCandidateHash,\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·parseTaskSections,·parseTaskVerification,·validateTaskArtifactContract·` with `⏎··parseTaskSections,⏎··parseTaskVerification,⏎··validateTaskArtifactContract,⏎`","line":11,"column":9,"nodeType":null,"messageId":"replace","endLine":11,"endColumn":81,"fix":{"range":[772,844],"text":"\n  parseTaskSections,\n  parseTaskVerification,\n  validateTaskArtifactContract,\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·assertVerificationPath,·canonicalVerificationJson,·readVe