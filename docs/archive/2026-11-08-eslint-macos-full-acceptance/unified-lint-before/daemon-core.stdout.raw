ATION_MISMATCH'⏎····`","line":53,"column":17,"nodeType":null,"messageId":"replace","endLine":53,"endColumn":314,"fix":{"range":[4015,4312],"text":"\n      proof.tool === tool &&\n        proof.sessionId === context.sessionID &&\n        proof.messageId === context.messageID &&\n        sameVerificationPath(proof.directory, directory) &&\n        proof.inputSha256 === hash(json(args)) &&\n        Date.now() - proof.startedAt <= 300000 &&\n        Date.now() >= proof.startedAt,\n      'ACTUAL_INVOCATION_MISMATCH'\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `proof:·TrustedToolInvocationProof,·operation:·string,·detail:·Record<string,unknown>·=·{}` with `⏎····proof:·TrustedToolInvocationProof,⏎····operation:·string,⏎····detail:·Record<string,·unknown>·=·{}⏎··`","line":56,"column":23,"nodeType":null,"messageId":"replace","endLine":56,"endColumn":112,"fix":{"range":[4359,4448],"text":"\n    proof: TrustedToolInvocationProof,\n    operation: string,\n    detail: Record<string, unknown> = {}\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `await·this.store.has('invocation',·id)` with `(await·this.store.has('invocation',·id))`","line":58,"column":18,"nodeType":null,"messageId":"replace","endLine":58,"endColumn":56,"fix":{"range":[4515,4553],"text":"(await this.store.has('invocation', id))"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'invocation',·{·contract:'verification-invocation/v1',proof,operation,...detail·},·id` with `⏎······'invocation',⏎······{·contract:·'verification-invocation/v1',·proof,·operation,·...detail·},⏎······id⏎····`","line":59,"column":26,"nodeType":null,"messageId":"replace","endLine":59,"endColumn":111,"fix":{"range":[4608,4693],"text":"\n      'invocation',\n      { contract: 'verification-invocation/v1', proof, operation, ...detail },\n      id\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `sameVerificationPath(process.execPath,·value.daemonPath),·'RUNNING_D