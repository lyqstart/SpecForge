umn":31,"nodeType":null,"messageId":"replace","endLine":116,"endColumn":126,"fix":{"range":[6291,6386],"text":"\n        'config/project.json',\n        'runtime/configuration-activation.json',\n        'runtime/configuration-history',\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·if·((await·fs.lstat(cursor)).isSymbolicLink())·throw·new·Error('CONFIGURATION_SYMLINK_FORBIDDEN');·}⏎··········catch·(error)·{·if·((error·as·NodeJS.ErrnoException).code·!==·'ENOENT')·throw·error;` with `⏎············if·((await·fs.lstat(cursor)).isSymbolicLink())⏎··············throw·new·Error('CONFIGURATION_SYMLINK_FORBIDDEN');⏎··········}·catch·(error)·{⏎············if·((error·as·NodeJS.ErrnoException).code·!==·'ENOENT')·throw·error;⏎·········`","line":120,"column":16,"nodeType":null,"messageId":"replace","endLine":121,"endColumn":95,"fix":{"range":[6560,6756],"text":"\n            if ((await fs.lstat(cursor)).isSymbolicLink())\n              throw new Error('CONFIGURATION_SYMLINK_FORBIDDEN');\n          } catch (error) {\n            if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·······`","line":125,"column":79,"nodeType":null,"messageId":"insert","endLine":125,"endColumn":79,"fix":{"range":[6889,6889],"text":"\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·······`","line":128,"column":47,"nodeType":null,"messageId":"insert","endLine":128,"endColumn":47,"fix":{"range":[7116,7116],"text":"\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·loadAcceptedConfigSync({·projectPath·});·}·catch·{·valid·=·false;` with `⏎··········loadAcceptedConfigSync({·projectPath·});⏎········}·catch·{⏎··········valid·=·false;⏎·······`","line":133,"column":14,"nodeType":null,"messageId":"replace","endLine":133,"endColumn":80,"fix":{"range":[7392,7458],"text":"\n          loadAcceptedConfigSync({ projectPath });\n        } catch {\n          valid = false;\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `this.pathResolver.resolveProjectRuntimeDir(projectPath),·'configuration-history'` with `⏎········this.pathResolver.resolveProjectRuntimeDir(projectPath),⏎········'configuration-history'⏎······`","line":136,"column":33,"nodeType":null,"messageId":"replace","endLine":136,"endColumn":113,"fix":{"range":[7572,7652],"text":"\n        this.pathResolver.resolveProjectRuntimeDir(projectPath),\n        'configuration-history'\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·········`","line":139,"column":100,"nodeType":null,"messageId":"insert","endLine":139,"endColumn":100,"fix":{"range":[7815,7815],"text":"\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·········`","line":141,"column":61,"nodeType":null,"messageId":"insert","endLine":141,"endColumn":61,"fix":{"range":[8009,8009],"text":"\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·········`","line":145,"column":89,"nodeType":null,"messageId":"insert","endLine":145,"endColumn":89,"fix":{"range":[8325,8325],"text":"\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·projectPath,·projectData:·parseConfigurationObject(content)` with `⏎········projectPath,⏎········projectData:·parseConfigurationObject(content),⏎·····`","line":148,"column":49,"nodeType":null,"messageId":"replace","endLine":148,"endColumn":109,"fix":{"range":[8464,8524],"text":"\n        projectPath,\n        projectData: parseConfigurationObject(content),\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·return·{·success:·true,·valid:·true,·document_sha256:·hash(content),·effective_sha256:·effectiveHash` with `⏎········return·{⏎··········success:·true,⏎··········valid:·true,⏎··········document_sha256:·hash(content),⏎··········effective_sha256:·effectiveHash,⏎·······`","line":150,"column":33,"nodeType":null,"messageId":"replace","endLine":150,"endColumn":134,"fix":{"range":[8629,8730],"text":"\n        return {\n          success: true,\n          valid: true,\n          document_sha256: hash(content),\n          effective_sha256: effectiveHash,\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `this.pathResolver.resolveProjectRuntimeDir(projectPath),·'configuration-activation.json'` with `⏎········this.pathResolver.resolveProjectRuntimeDir(projectPath),⏎········'configuration-activation.json'⏎······`","line":152,"column":40,"nodeType":null,"messageId":"replace","endLine":152,"endColumn":128,"fix":{"range":[8872,8960],"text":"\n        this.pathResolver.resolveProjectRuntimeDir(projectPath),\n        'configuration-activation.json'\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·activation·=·JSON.parse(await·fs.readFile(activationFile,·'utf8'));·}` with `⏎········activation·=·JSON.parse(await·fs.readFile(activationFile,·'utf8'));`","line":154,"column":12,"nodeType":null,"messageId":"replace","endLine":154,"endColumn":82,"fix":{"range":[9052,9122],"text":"\n        activation = JSON.parse(await fs.readFile(activationFile, 'utf8'));"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·catch·(error)·{·if·((error·as·NodeJS.ErrnoException).code·!==·'ENOENT')·throw·new·Error('CONFIGURATION_ACTIVATION_CORRUPT');` with `·}·catch·(error)·{⏎········if·((error·as·NodeJS.ErrnoException).code·!==·'ENOENT')⏎··········throw·new·Error('CONFIGURATION_ACTIVATION_CORRUPT');⏎·····`","line":155,"column":6,"nodeType":null,"messageId":"replace","endLine":155,"endColumn":131,"fix":{"range":[9128,9253],"text":" } catch (error) {\n        if ((error as NodeJS.ErrnoException).code !== 'ENOENT')\n          throw new Error('CONFIGURATION_ACTIVATION_CORRUPT');\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `activation·!==·undefined·&&·(!activation·||·activation.schema_version·!==·'1.0'·||·!/^[a-f0-9]{64}$/.test(activation.sha256)))` with `⏎········activation·!==·undefined·&&⏎········(!activation·||⏎··········activation.schema_version·!==·'1.0'·||⏎··········!/^[a-f0-9]{64}$/.test(activation.sha256))⏎······)⏎·······`","line":156,"column":11,"nodeType":null,"messageId":"replace","endLine":156,"endColumn":137,"fix":{"range":[9266,9392],"text":"\n        activation !== undefined &&\n        (!activation ||\n          activation.schema_version !== '1.0' ||\n          !/^[a-f0-9]{64}$/.test(activation.sha256))\n      )\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `.listWorkItems()` with `⏎········.listWorkItems()⏎········`","line":159,"column":27,"nodeType":null,"messageId":"replace","endLine":159,"endColumn":43,"fix":{"range":[9574,9590],"text":"\n        .listWorkItems()\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·······`","line":160,"column":58,"nodeType":null,"messageId":"insert","endLine":160,"endColumn":58,"fix":{"range":[9730,9730],"text":"\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·await·fs.writeFile(archive,·current,·{·flag:·'wx'·});·}` with `⏎········await·fs.writeFile(archive,·current,·{·flag:·'wx'·});`","line":163,"column":12,"nodeType":null,"messageId":"replace","endLine":163,"endColumn":68,"fix":{"range":[9920,9976],"text":"\n        await fs.writeFile(archive, current, { flag: 'wx' });"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `·}`","line":164,"column":6,"nodeType":null,"messageId":"insert","endLine":164,"endColumn":6,"fix":{"range":[9982,9982],"text":" }"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·········`","line":166,"column":62,"nodeType":null,"messageId":"insert","endLine":166,"endColumn":62,"fix":{"range":[10137,10137],"text":"\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·······`","line":169,"column":57,"nodeType":null,"messageId":"insert","endLine":169,"endColumn":57,"fix":{"range":[10352,10352],"text":"\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·await·fs.rename(temporary,·file);·}` with `⏎········await·fs.rename(temporary,·file);`","line":172,"column":12,"nodeType":null,"messageId":"replace","endLine":172,"endColumn":48,"fix":{"range":[10539,10575],"text":"\n        await fs.rename(temporary, file);"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·finally·{·await·fs.rm(temporary,·{·force:·true·});` with `·}·finally·{⏎········await·fs.rm(temporary,·{·force:·true·});⏎·····`","line":173,"column":6,"nodeType":null,"messageId":"replace","endLine":173,"endColumn":57,"fix":{"range":[10581,10632],"text":" } finally {\n        await fs.rm(temporary, { force: true });\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·success:·true,·document_sha256:·hash(content),·previous_sha256:·currentHash,·effective_sha256:·effectiveHash,·activation:·'validated_pending_acceptance'` with `⏎········success:·true,⏎········document_sha256:·hash(content),⏎········previous_sha256:·currentHash,⏎········effective_sha256:·effectiveHash,⏎········activation:·'validated_pending_acceptance',⏎·····`","line":176,"column":15,"nodeType":null,"messageId":"replace","endLine":176,"endColumn":168,"fix":{"range":[10852,11005],"text":"\n        success: true,\n        document_sha256: hash(content),\n        previous_sha256: currentHash,\n        effective_sha256: effectiveHash,\n        activation: 'validated_pending_acceptance',\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":192,"column":86,"nodeType":null,"messageId":"delete","endLine":192,"endColumn":87,"fix":{"range":[11634,11635],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":222,"column":71,"nodeType":null,"messageId":"insert","endLine":222,"endColumn":71,"fix":{"range":[12691,12691],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎······`","line":246,"column":47,"nodeType":null,"messageId":"insert","endLine":246,"endColumn":47,"fix":{"range":[13780,13780],"text":"\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎······`","line":253,"column":43,"nodeType":null,"messageId":"insert","endLine":253,"endColumn":43,"fix":{"range":[14003,14003],"text":"\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(check)` with `check`","line":266,"column":17,"nodeType":null,"messageId":"replace","endLine":266,"endColumn":24,"fix":{"range":[14541,14548],"text":"check"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `((check)` with `(check`","line":267,"column":13,"nodeType":null,"messageId":"replace","endLine":267,"endColumn":21,"fix":{"range":[14592,14600],"text":"(check"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(err)` with `err`","line":280,"column":45,"nodeType":null,"messageId":"replace","endLine":280,"endColumn":50,"fix":{"range":[15209,15214],"text":"err"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎········`[ProjectManager]·Failed·to·ensure·.gitignore·for·${projectPath}:`,⏎········err,⏎······` with ``[ProjectManager]·Failed·to·ensure·.gitignore·for·${projectPath}:`,·err`","line":281,"column":21,"nodeType":null,"messageId":"replace","endLine":284,"endColumn":7,"fix":{"range":[15240,15336],"text":"`[ProjectManager] Failed to ensure .gitignore for ${projectPath}:`, err"}},{"ruleId":"@typescript-eslint/require-await","severity":2,"message":"Async method 'unregisterProject' has no 'await' expression.","line":303,"column":3,"nodeType":"FunctionExpression","messageId":"missingAwait","endLine":303,"endColumn":26,"suggestions":[{"messageId":"removeAsync","fix":{"range":[15784,15843],"text":"unregisterProject(projectPath: string): void"},"desc":"Remove 'async'."}]},{"ruleId":"@typescript-eslint/require-await","severity":2,"message":"Async method 'acquireLock' has no 'await' expression.","line":316,"column":3,"nodeType":"FunctionExpression","messageId":"missingAwait","endLine":316,"endColumn":20,"suggestions":[{"messageId":"removeAsync","fix":{"range":[16116,16169],"text":"acquireLock(projectPath: string): Lock"},"desc":"Remove 'async'."}]},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":317,"column":71,"nodeType":null,"messageId":"insert","endLine":317,"endColumn":71,"fix":{"range":[16242,16242],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":350,"column":71,"nodeType":null,"messageId":"insert","endLine":350,"endColumn":71,"fix":{"range":[17191,17191],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(event)` with `event`","line":376,"column":68,"nodeType":null,"messageId":"replace","endLine":376,"endColumn":75,"fix":{"range":[17904,17911],"text":"event"}}],"suppressedMessages":[],"errorCount":61,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":59,"fixableWarningCount":0,"source":"import * as crypto from 'crypto';\nimport * as fs from 'fs/promises';\nimport * as os from 'os';\nimport * as path from 'path';\nimport { Event, Lock, Subscription } from '../types';\nimport { EventBus } from '../event-bus/EventBus';\nimport { WAL } from '../wal/WAL';\nimport { StateManager } from '../state/StateManager';\nimport { IPathResolver } from '../daemon/path-resolver';\nimport { SPEC_DIR_NAME } from '@specforge/types/directory-layout';\nimport type { SchemaDescriptorPrecheckResult } from '@specforge/types/schema-contract';\nimport { precheckProjectRegistrationSchemas } from './project-schema-descriptors';\nimport { loadAcceptedConfigSync, parseConfigurationObject, type MergedConfig } from '@specforge/configuration';\nimport { projectPathIdentity } from '../recovery/ProjectArchiveRestore';\n\nexport interface ProjectContext {\n  projectId: string;\n  projectPath: string;\n  dataDir: string;\n  schemaVersion: string;\n  activeSessions: string[];\n  workItems: { id: string; title: string }[];\n  lastEventId: string;\n  lastEventTs: number;\n  /** @deprecated No longer populated — use ProjectManager.getDaemonStateManager() */\n  wal?: WAL;\n  /** @deprecated No longer populated — use ProjectManager.getDaemonStateManager() */\n  stateManager?: StateManager;\n  /** Replaces wal as the idempotency flag for fully registered projects */\n  isFullyRegistered?: boolean;\n}\n\ninterface DaemonManifest {\n  version: string;\n  projects: Record<string, { projectId: string; registeredAt: number }>;\n}\n\nexport type ProjectSchemaPrecheck = (\n  projectPath: string,\n) => Promise<SchemaDescriptorPrecheckResult>;\n\nexport class ProjectManager {\n  private recoveringProjects = new Set<string>();\n  private projectOperations = new Map<string, number>();\n\n  async withProjectOperation<T>(projectPath: string, action: () => Promise<T>): Promise<T> {\n    const key = projectPathIdentity(projectPath);\n    if (this.recoveringProjects.has(key)) throw new Error('ARCHIVE_RECOVERY_IN_PROGRESS');\n    this.projectOperations.set(key, (this.projectOperations.get(key) ?? 0) + 1);\n    try { return await action(); }\n    finally {\n      const count = this.projectOperations.get(key)! - 1;\n      if (count) this.projectOperations.set(key, count); else this.projectOperations.delete(key);\n    }\n  }\n\n  async withProjectArchiveRecovery<T>(projectPath: string, action: () => Promise<T>): Promise<T> {\n    const key = projectPathIdentity(projectPath);\n    const loaded = [...this.projects.keys(), ...this.projectStateManagers.keys(), ...this.projectLocks.keys()];\n    if (this.recoveringProjects.has(key) || this.projectOperations.has(key) || this.configurationActivations.has(key) ||\n        loaded.some(value => projectPathIdentity(value) === key)) throw new Error('ARCHIVE_RECOVERY_PROJECT_IN_USE');\n    this.recoveringProjects.add(key);\n    try { return await action(); } finally { this.recoveringProjects.delete(key); }\n  }\n\n  private configurationActivations = new Map<string, Promise<unknown>>();\n\n  private async serializeConfiguration<T>(projectPath: string, action: () => Promise<T>): Promise<T> {\n    if (this.recoveringProjects.has(projectPathIdentity(projectPath))) throw new Error('ARCHIVE_RECOVERY_IN_PROGRESS');\n    const key = process.platform === 'win32' ? path.resolve(projectPath).toLowerCase() : path.resolve(projectPath);\n    const prior = this.configurationActivations.get(key);\n    const next = (prior ? prior.catch(() => undefined) : Promise.resolve()).then(action);\n    this.configurationActivations.set(key, next);\n    try { return await next; }\n    finally { if (this.configurationActivations.get(key) === next) this.configurationActivations.delete(key); }\n  }\n\n  /** Serialize acceptance per project; a changed config cannot affect active work. */\n  async getProjectConfiguration(projectPath: string): Promise<MergedConfig> {\n    return this.serializeConfiguration(projectPath, async () => {\n      const config = loadAcceptedConfigSync({ projectPath });\n      const sha256 = crypto.createHash('sha256').update(JSON.stringify(config.merged)).digest('hex');\n      const file = path.join(this.pathResolver.resolveProjectRuntimeDir(projectPath), 'configuration-activation.json');\n      let previous: { schema_version: string; sha256: string } | undefined;\n      try {\n        previous = JSON.parse(await fs.readFile(file, 'utf8'));\n        if (!previous || typeof previous !== 'object' || Array.isArray(previous)) throw new Error('CONFIGURATION_ACTIVATION_CORRUPT');\n      }\n      catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw new Error('CONFIGURATION_ACTIVATION_CORRUPT'); }\n      if (previous && (previous.schema_version !== '1.0' || !/^[a-f0-9]{64}$/.test(previous.sha256))) throw new Error('CONFIGURATION_ACTIVATION_CORRUPT');\n      // Missing acceptance evidence is not proof of first use. Rebuild from\n      // events before creating a new identity, including after process restart.\n      if (!previous || previous.sha256 !== sha256) {\n        const sm = await this.getProjectStateManager(projectPath);\n        await sm.rebuildState();\n        if (sm.listWorkItems().some(item => !['closed', 'rejected', 'superseded'].includes(item.current_state))) {\n          throw new Error('CONFIGURATION_CHANGE_BLOCKED_ACTIVE_WORK: restore the accepted configuration before continuing');\n        }\n      }\n      if (!previous || previous.sha256 !== sha256) {\n        await fs.mkdir(path.dirname(file), { recursive: true });\n        const temporary = `${file}.${crypto.randomUUID()}.tmp`;\n        await fs.writeFile(temporary, JSON.stringify({ schema_version: '1.0', sha256 }) + '\\n', { flag: 'wx' });\n        try { await fs.rename(temporary, file); }\n        finally { await fs.rm(temporary, { force: true }); }\n      }\n      return structuredClone(config);\n    });\n  }\n\n  /** Sole producer for runtime project JSON. Never writes user credentials or WI artifacts. */\n  async manageProjectConfiguration(projectPath: string, args: Record<string, unknown>): Promise<Record<string, unknown>> {\n    return this.serializeConfiguration(projectPath, async () => {\n      if (!path.isAbsolute(projectPath)) throw new Error('CONFIGURATION_PROJECT_REQUIRED');\n      // Controlled ownership does not authorize following a project junction outside its boundary.\n      for (const relative of ['config/project.json', 'runtime/configuration-activation.json', 'runtime/configuration-history']) {\n        let cursor = projectPath;\n        for (const segment of [SPEC_DIR_NAME, ...relative.split('/')]) {\n          cursor = path.join(cursor, segment);\n          try { if ((await fs.lstat(cursor)).isSymbolicLink()) throw new Error('CONFIGURATION_SYMLINK_FORBIDDEN'); }\n          catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error; }\n        }\n      }\n      const action = args.action;\n      if (!['read', 'validate', 'update', 'restore'].includes(String(action))) throw new Error('CONFIGURATION_ACTION_INVALID');\n      const file = path.join(projectPath, SPEC_DIR_NAME, 'config', 'project.json');\n      const current = await fs.readFile(file);\n      const hash = (bytes: string | Buffer) => crypto.createHash('sha256').update(bytes).digest('hex');\n      const currentHash = hash(current);\n      if (action === 'read') {\n        // Even corrupt documents can be identified for compare-and-swap recovery. Never return raw input.\n        let valid = true;\n        try { loadAcceptedConfigSync({ projectPath }); } catch { valid = false; }\n        return { success: true, document_sha256: currentHash, valid };\n      }\n      const history = path.join(this.pathResolver.resolveProjectRuntimeDir(projectPath), 'configuration-history');\n      let content: string;\n      if (action === 'restore') {\n        if (typeof args.restore_sha256 !== 'string' || !/^[a-f0-9]{64}$/.test(args.restore_sha256)) throw new Error('CONFIGURATION_RESTORE_ID_INVALID');\n        const restoredFile = path.join(history, `${args.restore_sha256}.json`);\n        if ((await fs.lstat(restoredFile)).isSymbolicLink()) throw new Error('CONFIGURATION_SYMLINK_FORBIDDEN');\n        content = await fs.readFile(restoredFile, 'utf8');\n        if (hash(content) !== args.restore_sha256) throw new Error('CONFIGURATION_HISTORY_CORRUPT');\n      } else {\n        if (typeof args.content !== 'string' || Buffer.byteLength(args.content) > 65536) throw new Error('CONFIGURATION_CONTENT_INVALID');\n        content = args.content;\n      }\n      const candidate = loadAcceptedConfigSync({ projectPath, projectData: parseConfigurationObject(content) });\n      const effectiveHash = hash(JSON.stringify(candidate.merged));\n      if (action === 'validate') return { success: true, valid: true, document_sha256: hash(content), effective_sha256: effectiveHash };\n      if (args.expected_sha256 !== currentHash) throw new Error('CONFIGURATION_BASELINE_CHANGED');\n      const activationFile = path.join(this.pathResolver.resolveProjectRuntimeDir(projectPath), 'configuration-activation.json');\n      let activation: { schema_version: string; sha256: string } | undefined;\n      try { activation = JSON.parse(await fs.readFile(activationFile, 'utf8')); }\n      catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw new Error('CONFIGURATION_ACTIVATION_CORRUPT'); }\n      if (activation !== undefined && (!activation || activation.schema_version !== '1.0' || !/^[a-f0-9]{64}$/.test(activation.sha256))) throw new Error('CONFIGURATION_ACTIVATION_CORRUPT');\n      const state = await this.getProjectStateManager(projectPath);\n      await state.rebuildState();\n      const active = state.listWorkItems().some(item => !['closed', 'rejected', 'superseded'].includes(item.current_state));\n      if (active && activation?.sha256 !== effectiveHash) throw new Error('CONFIGURATION_CHANGE_BLOCKED_ACTIVE_WORK');\n      await fs.mkdir(history, { recursive: true });\n      const archive = path.join(history, `${currentHash}.json`);\n      try { await fs.writeFile(archive, current, { flag: 'wx' }); }\n      catch (error) {\n        if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error;\n        if (hash(await fs.readFile(archive)) !== currentHash) throw new Error('CONFIGURATION_HISTORY_CORRUPT');\n      }\n      // Recheck immediately before rename: stale callers cannot silently overwrite another update.\n      if (hash(await fs.readFile(file)) !== currentHash) throw new Error('CONFIGURATION_BASELINE_CHANGED');\n      const temporary = `${file}.${crypto.randomUUID()}.tmp`;\n      await fs.writeFile(temporary, content, { flag: 'wx' });\n      try { await fs.rename(temporary, file); }\n      finally { await fs.rm(temporary, { force: true }); }\n      // Acceptance remains owned by getProjectConfiguration. No active WI can accept a new hash.\n      // If the process stops here, its next acceptance either records the new boundary or fails closed.\n      return { success: true, document_sha256: hash(content), previous_sha256: currentHash, effective_sha256: effectiveHash, activation: 'validated_pending_acceptance' };\n    });\n  }\n  private eventBus: EventBus;\n  private pathResolver: IPathResolver;\n  private daemonStateManager: StateManager;\n  private projects: Map<string, ProjectContext> = new Map();\n  private projectStateManagers: Map<string, StateManager> = new Map();\n  private projectLocks: Map<string, Lock> = new Map();\n  private subscription: Subscription | null = null;\n  private readonly projectSchemaPrecheck: ProjectSchemaPrecheck;\n\n  constructor(\n    eventBus: EventBus,\n    pathResolver: IPathResolver,\n    daemonStateManager: StateManager,\n    projectSchemaPrecheck: ProjectSchemaPrecheck = precheckProjectRegistrationSchemas,\n  ) {\n    this.eventBus = eventBus;\n    this.pathResolver = pathResolver;\n    this.daemonStateManager = daemonStateManager;\n    this.projectSchemaPrecheck = projectSchemaPrecheck;\n  }\n\n  getDaemonStateManager(): StateManager {\n    return this.daemonStateManager;\n  }\n\n  /**\n   * 获取项目级 StateManager，不存在则自动创建。\n   * 写入路径为 <projectPath>/.specforge/runtime/events.jsonl\n   */\n  async getProjectStateManager(projectPath: string): Promise<StateManager> {\n    return this.withProjectOperation(projectPath, () => this.loadProjectStateManager(projectPath));\n  }\n\n  private async loadProjectStateManager(projectPath: string): Promise<StateManager> {\n    if (!this.projectStateManagers.has(projectPath)) {\n      const sm = new StateManager(this.pathResolver, projectPath, false);\n      await sm.initialize();\n      this.projectStateManagers.set(projectPath, sm);\n    }\n    return this.projectStateManagers.get(projectPath)!;\n  }\n\n  async getProject(projectPath: string): Promise<ProjectContext> {\n    if (this.recoveringProjects.has(projectPathIdentity(projectPath))) throw new Error('ARCHIVE_RECOVERY_IN_PROGRESS');\n    const existing = this.projects.get(projectPath);\n    if (existing?.isFullyRegistered) {\n      return existing;\n    }\n    return this.registerProject(projectPath);\n  }\n\n  async registerProject(projectPath: string): Promise<ProjectContext> {\n    return this.withProjectOperation(projectPath, () => this.registerAvailableProject(projectPath));\n  }\n\n  private async registerAvailableProject(projectPath: string): Promise<ProjectContext> {\n    const existing = this.projects.get(projectPath);\n    if (existing?.isFullyRegistered) {\n      return existing;\n    }\n\n    // Current releases register only the authoritative V6 Project Spec layout.\n    // A root manifest belongs to the retired auto-detection path and must not\n    // be used to infer, repair, or register a project.\n    const specDir = path.join(projectPath, SPEC_DIR_NAME);\n    const currentManifestPath = path.join(specDir, 'project', 'spec_manifest.json');\n    const retiredRootManifestPath = path.join(specDir, 'manifest.json');\n    const retiredRootManifestExists = await fs.access(retiredRootManifestPath)\n      .then(() => true)\n      .catch(() => false);\n    if (retiredRootManifestExists) {\n      throw new Error('UNSUPPORTED_PROJECT_LAYOUT');\n    }\n\n    const currentManifestExists = await fs.access(currentManifestPath)\n      .then(() => true)\n      .catch(() => false);\n    if (!currentManifestExists) {\n      throw new Error('PROJECT_NOT_INITIALIZED');\n    }\n\n    // Schema precheck is deliberately before the first project write. Each\n    // persistent-file owner supplies its exact schema contract; no global\n    // version or directory discovery is used here.\n    const schemaPrecheck = await this.projectSchemaPrecheck(projectPath);\n    if (!schemaPrecheck.ok) {\n      const details = schemaPrecheck.checks\n        .filter((check) => check.status === 'blocked')\n        .map((check) => `${check.descriptorId}:${check.errorCode ?? check.status}`)\n        .join(',');\n      throw new Error(`PROJECT_SCHEMA_PRECHECK_BLOCKED:${details}`);\n    }\n\n    // Authoritative current manifest exists → normal registration.\n    await this.getProjectConfiguration(projectPath);\n    const projectId = existing?.projectId ?? this.generateProjectId(projectPath);\n    const dataDir = this.pathResolver.resolveProjectRuntimeDir(projectPath);\n\n    await fs.mkdir(dataDir, { recursive: true });\n\n    // Ensure .gitignore in personal mode — fire-and-forget, don't block\n    this.ensureGitignore(projectPath).catch((err) => {\n      console.error(\n        `[ProjectManager] Failed to ensure .gitignore for ${projectPath}:`,\n        err,\n      );\n    });\n\n    const ctx: ProjectContext = {\n      projectId,\n      projectPath,\n      dataDir,\n      schemaVersion: existing?.schemaVersion ?? '1.0',\n      activeSessions: existing?.activeSessions ?? [],\n      workItems: existing?.workItems ?? [],\n      lastEventId: existing?.lastEventId ?? '',\n      lastEventTs: existing?.lastEventTs ?? 0,\n      isFullyRegistered: true,\n    };\n\n    this.projects.set(projectPath, ctx);\n    return ctx;\n  }\n\n  async unregisterProject(projectPath: string): Promise<void> {\n    const ctx = this.projects.get(projectPath);\n    if (!ctx) {\n      return;\n    }\n\n    if (this.projectLocks.has(projectPath)) {\n      throw new Error(`Cannot unregister project ${projectPath}: project is locked`);\n    }\n\n    this.projects.delete(projectPath);\n  }\n\n  async acquireLock(projectPath: string): Promise<Lock> {\n    if (this.recoveringProjects.has(projectPathIdentity(projectPath))) throw new Error('ARCHIVE_RECOVERY_IN_PROGRESS');\n    const current = this.projectLocks.get(projectPath);\n    if (current && current.expiresAt > Date.now()) {\n      throw new Error(`Project ${projectPath} is already locked`);\n    }\n    if (current) {\n      this.projectLocks.delete(projectPath);\n    }\n\n    const now = Date.now();\n    const lock: Lock = {\n      id: this.generateId(),\n      projectPath,\n      acquiredAt: now,\n      expiresAt: now + 30_000,\n    };\n\n    this.projectLocks.set(projectPath, lock);\n    return lock;\n  }\n\n  releaseLock(lock: Lock): void {\n    const current = this.projectLocks.get(lock.projectPath);\n    if (current && current.id === lock.id) {\n      this.projectLocks.delete(lock.projectPath);\n    }\n  }\n\n  listActiveProjects(): string[] {\n    return Array.from(this.projects.keys());\n  }\n\n  getProjectContext(projectPath: string): ProjectContext {\n    if (this.recoveringProjects.has(projectPathIdentity(projectPath))) throw new Error('ARCHIVE_RECOVERY_IN_PROGRESS');\n    const existing = this.projects.get(projectPath);\n    if (existing) {\n      return existing;\n    }\n\n    // Lightweight creation — no file I/O, no WAL/StateManager\n    const projectId = this.generateProjectId(projectPath);\n    const dataDir = this.pathResolver.resolveProjectRuntimeDir(projectPath);\n\n    const ctx: ProjectContext = {\n      projectId,\n      projectPath,\n      dataDir,\n      schemaVersion: '1.0',\n      activeSessions: [],\n      workItems: [],\n      lastEventId: '',\n      lastEventTs: 0,\n    };\n\n    this.projects.set(projectPath, ctx);\n    return ctx;\n  }\n\n  start(): void {\n    this.subscription = this.eventBus.subscribe('project.updated', (event) => {\n      this.handleProjectEvent(event);\n    });\n  }\n\n  stop(): void {\n    if (this.subscription) {\n      this.eventBus.unsubscribe(this.subscription);\n      this.subscription = null;\n    }\n    this.projects.clear();\n    this.projectLocks.clear();\n  }\n\n  // ---------------------------------------------------------------------------\n  // Manifest I/O\n  // ---------------------------------------------------------------------------\n\n  async loadProjectManifest(): Promise<DaemonManifest> {\n    const newPath = this.pathResolver.resolveDaemonJsonPath();\n    const oldPath = path.join(os.homedir(), SPEC_DIR_NAME, 'daemon.json');\n\n    // Try new path first\n    try {\n      const content = await fs.readFile(newPath, 'utf-8');\n      return JSON.parse(content) as DaemonManifest;\n    } catch {\n      // New path doesn't exist — try old path and migrate\n      try {\n        const content = await fs.readFile(oldPath, 'utf-8');\n        const manifest = JSON.parse(content) as DaemonManifest;\n        await this.saveProjectManifest(manifest);\n        return manifest;\n      } catch {\n        // Neither exists\n        return { version: '1.0', projects: {} };\n      }\n    }\n  }\n\n  async saveProjectManifest(manifest: DaemonManifest): Promise<void> {\n    const manifestPath = this.pathResolver.resolveDaemonJsonPath();\n    await fs.mkdir(path.dirname(manifestPath), { recursive: true });\n    await fs.writeFile(manifestPath, JSON.stringify(manifest, null, 2), 'utf-8');\n  }\n\n  // ---------------------------------------------------------------------------\n  // Private helpers\n  // ---------------------------------------------------------------------------\n\n  private async ensureGitignore(projectPath: string): Promise<void> {\n    if (!this.isPersonalMode(projectPath)) {\n      return;\n    }\n\n    const gitignorePath = path.join(projectPath, SPEC_DIR_NAME, '.gitignore');\n    const BEGIN = '# SpecForge managed (BEGIN)';\n    const END = '# SpecForge managed (END)';\n    const entry = 'runtime/';\n\n    let content = '';\n    try {\n      content = await fs.readFile(gitignorePath, 'utf-8');\n    } catch {\n      // File doesn't exist yet — will create it\n    }\n\n    if (content.includes(BEGIN) && content.includes(END)) {\n      return; // Already managed\n    }\n\n    const newBlock = `${BEGIN}\\n${entry}\\n${END}\\n`;\n    const updated = content ? content.trimEnd() + '\\n\\n' + newBlock : newBlock;\n\n    await fs.mkdir(path.dirname(gitignorePath), { recursive: true });\n    await fs.writeFile(gitignorePath, updated, 'utf-8');\n  }\n\n  private isPersonalMode(projectPath: string): boolean {\n    try {\n      const runtimeDir = this.pathResolver.resolveProjectRuntimeDir(projectPath);\n      const normalized = path.resolve(runtimeDir);\n      const projectAbs = path.resolve(projectPath);\n      return normalized.startsWith(projectAbs + path.sep);\n    } catch {\n      return false;\n    }\n  }\n\n  private handleProjectEvent(event: Event): void {\n    const payload = event.payload as { projectPath?: string };\n    if (event.action === 'project.updated' && payload.projectPath) {\n      // Project state is maintained independently via per-project StateManager\n    }\n  }\n\n  private generateProjectId(projectPath: string): string {\n    return crypto.createHash('sha256').update(projectPath).digest('hex').substring(0, 16);\n  }\n\n  private generateId(): string {\n    return Math.random().toString(36).substring(2, 15);\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\project\\project-schema-descriptors.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"@specforge/types/directory-layout\"` with `'@specforge/types/directory-layout'`","line":1,"column":31,"nodeType":null,"messageId":"replace","endLine":1,"endColumn":66,"fix":{"range":[30,65],"text":"'@specforge/types/directory-layout'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":2,"column":87,"nodeType":null,"messageId":"insert","endLine":2,"endColumn":87,"fix":{"range":[153,153],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·precheckSchemaDescriptors,·type·SchemaDescriptorPrecheckResult·}·from·'@specforge/types/schema-contract'` with `⏎··precheckSchemaDescriptors,⏎··type·SchemaDescriptorPrecheckResult,⏎}·from·'@specforge/types/schema-contract';`","line":3,"column":9,"nodeType":null,"messageId":"replace","endLine":3,"endColumn":114,"fix":{"range":[162,267],"text":"\n  precheckSchemaDescriptors,\n  type SchemaDescriptorPrecheckResult,\n} from '@specforge/types/schema-contract';"}},{"ruleId":"prettier/prettier","severity":2,"message":"