dLine":32,"endColumn":57,"fix":{"range":[1404,1404],"text":"\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·projectRoot,·workItemId,·baseBranch,` with `⏎········projectRoot,⏎········workItemId,⏎········baseBranch,⏎·······`","line":33,"column":49,"nodeType":null,"messageId":"replace","endLine":33,"endColumn":86,"fix":{"range":[1521,1558],"text":"\n        projectRoot,\n        workItemId,\n        baseBranch,\n       "}},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['bootstrap_plan_sha256']' may use Object's default stringification format ('[object Object]') when stringified.","line":34,"column":28,"nodeType":"MemberExpression","messageId":"baseToString","endLine":34,"endColumn":57},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·confirmationQuote:·String(args['bootstrap_confirmation_quote']·||·'')` with `⏎········confirmationQuote:·String(args['bootstrap_confirmation_quote']·||·''),⏎·····`","line":34,"column":59,"nodeType":null,"messageId":"replace","endLine":34,"endColumn":129,"fix":{"range":[1629,1699],"text":"\n        confirmationQuote: String(args['bootstrap_confirmation_quote'] || ''),\n     "}},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['bootstrap_confirmation_quote'] || ''' will use Object's default stringification format ('[object Object]') when stringified.","line":34,"column":86,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":34,"endColumn":128},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":36,"column":60,"nodeType":null,"messageId":"insert","endLine":36,"endColumn":60,"fix":{"range":[1769,1769],"text":"\n     "}}],"suppressedMessages":[],"errorCount":12,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":7,"fixableWarningCount":0,"source":"import { registerHandler } from '../ToolDispatcher';\nimport { createBranch } from '../lib/git-governance-core';\nimport { executeDetachedGitBootstrap } from '../lib/git-detached-bootstrap';\nimport { readAuthoritativeState } from '../lib/state-coordinator-v11';\n\nregisterHandler('sf_git_branch_create', async (args, context, deps) => {\n  const projectRoot =\n    (context?.directory as string) ||\n    (context?.worktree as string) ||\n    process.cwd();\n  const workItemId = String(args['work_item_id'] || '').trim();\n  const branchName = String(args['branch_name'] || '').trim();\n  const confirmed = args['confirmed'] === true;\n  const baseBranch = String(args['base_branch'] || 'main');\n\n  if (!workItemId) return { success: false, error: 'work_item_id required' };\n  if (!branchName) return { success: false, error: 'branch_name required' };\n  if (!confirmed) {\n    return {\n      success: false,\n      error: 'BRANCH_NAME_CONFIRMATION_REQUIRED',\n      message:\n        'branch_create requires confirmed=true after user confirms the semantic branch name',\n      branch_name: branchName,\n    };\n  }\n\n  try {\n    if (args['bootstrap_plan_sha256'] !== undefined) {\n      if (context?.agent !== 'sf-orchestrator') throw Error('DETACHED_GIT_BOOTSTRAP_OWNER_REQUIRED');\n      const state = await readAuthoritativeState({ deps, projectRoot, workItemId });\n      if (state.current_state !== 'post_merge_verified') throw Error('DETACHED_GIT_BOOTSTRAP_POST_MERGE_VERIFIED_REQUIRED');\n      return await executeDetachedGitBootstrap({ projectRoot, workItemId, baseBranch, branchName,\n        planSha256: String(args['bootstrap_plan_sha256']), confirmationQuote: String(args['bootstrap_confirmation_quote'] || '') });\n    }\n    if (args['bootstrap_confirmation_quote'] !== undefined) throw Error('DETACHED_GIT_BOOTSTRAP_PLAN_REQUIRED');\n    return await createBranch({\n      projectRoot,\n      workItemId,\n      branchName,\n      baseBranch,\n      requireClean: args['require_clean'] !== false,\n    });\n  } catch (err) {\n    return {\n      success: false,\n      error: err instanceof Error ? err.message : String(err),\n    };\n  }\n});\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\handlers\\sf-git-branch-plan.ts","messages":[{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['work_item_id'] || ''' will use Object's default stringification format ('[object Object]') when stringified.","line":7,"column":29,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":7,"endColumn":55},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['title'] || ''' will use Object's default stringification format ('[object Object]') when stringified.","line":8,"column":24,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":8,"endColumn":43},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['work_item_type'] || 'feature'' will use Object's default stringification format ('[object Object]') when stringified.","line":9,"column":31,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":9,"endColumn":66},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":13,"column":46,"nodeType":null,"messageId":"insert","endLine":13,"endColumn":46,"fix":{"range":[757,757],"text":"\n     "}},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'context?.directory || context?.worktree || process.cwd()' will use Object's default stringification format ('[object Object]') when stringified.","line":14,"column":32,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":14,"endColumn":88},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·······`","line":17,"column":57,"nodeType":null,"messageId":"insert","endLine":17,"endColumn":57,"fix":{"range":[1074,1074],"text":"\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·projectRoot,·workItemId,` with `⏎········projectRoot,⏎········workItemId,⏎·······`","line":18,"column":46,"nodeType":null,"messageId":"replace","endLine":18,"endColumn":71,"fix":{"range":[1188,1213],"text":"\n        projectRoot,\n        workItemId,\n       "}},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['base_branch'] || ''' will use Object's default stringification format ('[object Object]') when stringified.","line":18,"column":91,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":18,"endColumn":116},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['branch_name'] || ''' will use Object's default stringification format ('[object Object]') when stringified.","line":19,"column":28,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":19,"endColumn":53},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·expectedHead:·String(args['expected_head']·||·'')` with `⏎········expectedHead:·String(args['expected_head']·||·''),⏎·····`","line":19,"column":55,"nodeType":null,"messageId":"replace","endLine":19,"endColumn":105,"fix":{"range":[1315,1365],"text":"\n        expectedHead: String(args['expected_head'] || ''),\n     "}},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['expected_head'] || ''' will use Object's default stringification format ('[object Object]') when stringified.","line":19,"column":77,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":19,"endColumn":104},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·return·{·success:·false,·error:·String((error·as·Error).message)·};` with `⏎······return·{·success:·false,·error:·String((error·as·Error).message)·};⏎···`","line":20,"column":22,"nodeType":null,"messageId":"replace","endLine":20,"endColumn":90,"fix":{"range":[1391,1459],"text":"\n      return { success: false, error: String((error as Error).message) };\n   "}}],"suppressedMessages":[],"errorCount":12,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":5,"fixableWarningCount":0,"source":"import { registerHandler } from '../ToolDispatcher';\nimport { branchPlan } from '../lib/git-governance-core';\nimport { planDetachedGitBootstrap } from '../lib/git-detached-bootstrap';\nimport { readAuthoritativeState } from '../lib/state-coordinator-v11';\n\nregisterHandler('sf_git_branch_plan', async (args, context, deps) => {\n  const workItemId = String(args['work_item_id'] || '').trim();\n  const title = String(args['title'] || '').trim();\n  const workItemType = String(args['work_item_type'] || 'feature').trim();\n  if (!workItemId) return { success: false, error: 'work_item_id required' };\n  if (!title) return { success: false, error: 'title required' };\n  if (args['bootstrap_from_detached'] === true) {\n    if (context?.agent !== 'sf-orchestrator') return { success: false, error: 'DETACHED_GIT_BOOTSTRAP_OWNER_REQUIRED' };\n    const projectRoot = String(context?.directory || context?.worktree || process.cwd());\n    try {\n      const state = await readAuthoritativeState({ deps, projectRoot, workItemId });\n      if (state.current_state !== 'post_merge_verified') throw Error('DETACHED_GIT_BOOTSTRAP_POST_MERGE_VERIFIED_REQUIRED');\n      return await planDetachedGitBootstrap({ projectRoot, workItemId, baseBranch: String(args['base_branch'] || ''),\n        branchName: String(args['branch_name'] || ''), expectedHead: String(args['expected_head'] || '') });\n    } catch (error) { return { success: false, error: String((error as Error).message) }; }\n  }\n  return branchPlan({ workItemId, title, workItemType });\n});\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\handlers\\sf-git-changed-files-audit.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":5,"column":22,"nodeType":null,"messageId":"insert","endLine":5,"endColumn":22,"fix":{"range":[217,217],"text":"\n   "}},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['work_item_id'] || ''' will use Object's default stringification format ('[object Object]') when stringified.","line":6,"column":29,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":6,"endColumn":55}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":1,"fixableWarningCount":0,"source":"import { registerHandler } from '../ToolDispatcher';\nimport { gitChangedFilesAudit } from '../lib/git-governance-stage2';\n\nregisterHandler('sf_git_changed_files_audit', async (args, context) => {\n  const projectRoot = (context?.directory as string) || (context?.worktree as string) || process.cwd();\n  const workItemId = String(args['work_item_id'] || '').trim();\n  if (!workItemId) return { success: false, error: 'work_item_id required' };\n  try {\n    return await gitChangedFilesAudit({\n      projectRoot,\n      workItemId,\n      allowAskFiles: args['allow_ask_files'] === true,\n      writeReport: args['write_report'] !== false,\n    });\n  } catch (err) {\n    return { success: false, error: err instanceof Error ? err.message : String(err) };\n  }\n});\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\handlers\\sf-git-checkpoint-commit.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":5,"column":22,"nodeType":null,"messageId":"insert","endLine":5,"endColumn":22,"fix":{"range":[209,209],"text":"\n   "}},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['message'] || ''' will use Object's default stringification format ('[object Object]') when stringified.","line":7,"column":26,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":7,"endColumn":47},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['default_branch'] || 'main'' will use Object's default stringification format ('[object Object]') when stringified.","line":14,"column":29,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":14,"endColumn":61}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":1,"fixableWarningCount":0,"source":"import { registerHandler } from '../ToolDispatcher';\nimport { checkpointCommit } from '../lib/git-governance-core';\n\nregisterHandler('sf_git_checkpoint_commit', async (args, context) => {\n  const projectRoot = (context?.directory as string) || (context?.worktree as string) || process.cwd();\n  const files = Array.isArray(args['files']) ? (args['files'] as unknown[]).map(String) : undefined;\n  const message = String(args['message'] || '').trim();\n  try {\n    return await checkpointCommit({\n      projectRoot,\n      workItemId: typeof args['work_item_id'] === 'string' ? args['work_item_id'] : undefined,\n      files,\n      message,\n      defaultBranch: String(args['default_branch'] || 'main'),\n      dryRun: args['dry_run'] === true,\n      allowAskFiles: args['allow_ask_files'] === true,\n    });\n  } catch (err) {\n    return { success: false, error: err instanceof Error ? err.message : String(err) };\n  }\n});\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\handlers\\sf-git-code-permission-guard.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":11,"column":22,"nodeType":null,"messageId":"insert","endLine":11,"endColumn":22,"fix":{"range":[449,449],"text":"\n   "}},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['action'] || 'check'' will use Object's default stringification format ('[object Object]') when stringified.","line":12,"column":25,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":12,"endColumn":50},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['default_branch'] || 'main'' will use Object's default stringification format ('[object Object]') when stringified.","line":13,"column":32,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":13,"endColumn":64},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·········`","line":22,"column":17,"nodeType":null,"messageId":"insert","endLine":22,"endColumn":17,"fix":{"range":[917,917],"text":"\n         "}}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":2,"fixableWarningCount":0,"source":"import { registerHandler, getHandler } from '../ToolDispatcher';\nimport { getCurrentBranch } from '../lib/git-governance-core';\n\nconst codePermissionHandler = getHandler('sf_v11_code_permission');\n\nfunction isReleaseLikeAction(action: string): boolean {\n  return action === 'release' || action === 'enable' || action === 'extend' || action === 'append';\n}\n\nregisterHandler('sf_code_permission', async (args, context, deps) => {\n  const projectRoot = (context?.directory as string) || (context?.worktree as string) || process.cwd();\n  const action = String(args['action'] || 'check');\n  const defaultBranch = String(args['default_branch'] || 'main');\n\n  if (isReleaseLikeAction(action)) {\n    const currentBranch = await getCurrentBranch(projectRoot);\n    if (currentBranch === defaultBranch) {\n      return {\n        success: false,\n        hard_stop: true,\n        error: 'MAIN_WRITE_GUARD_BLOCKED',\n        message: 'code_permission cannot be enabled on the default branch. Create a semantic Work Item branch first.',\n        current_branch: currentBranch,\n        default_branch: defaultBranch,\n      };\n    }\n  }\n\n  if (!codePermissionHandler) {\n    return { success: false, error: 'code permission implementation not registered' };\n  }\n  return codePermissionHandler(args, context, deps);\n});\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\handlers\\sf-git-ignore-analyze.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎