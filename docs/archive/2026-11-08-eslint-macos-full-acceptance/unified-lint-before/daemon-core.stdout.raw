SPEC_DIR_NAME,·'project',·'extension_registry.json'),⏎······path.join(SPEC_DIR_NAME,·'work-items',·workItemId,·'work_item.json'),⏎······path.join(SPEC_DIR_NAME,·'work-items',·workItemId,·'candidate_manifest.json'),⏎······path.join(⏎········SPEC_DIR_NAME,⏎········'work-items',⏎········workItemId,⏎········'candidates',⏎········'project',⏎········'extension_registry.json'⏎······),⏎····])·`","line":51,"column":8,"nodeType":null,"messageId":"replace","endLine":51,"endColumn":329,"fix":{"range":[2548,2869],"text":" (const relative of [\n      path.join(SPEC_DIR_NAME, 'project', 'extension_registry.json'),\n      path.join(SPEC_DIR_NAME, 'work-items', workItemId, 'work_item.json'),\n      path.join(SPEC_DIR_NAME, 'work-items', workItemId, 'candidate_manifest.json'),\n      path.join(\n        SPEC_DIR_NAME,\n        'work-items',\n        workItemId,\n        'candidates',\n        'project',\n        'extension_registry.json'\n      ),\n    ]) "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=` with `·=·`","line":52,"column":18,"nodeType":null,"messageId":"replace","endLine":52,"endColumn":19,"fix":{"range":[2888,2889],"text":" = "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(const·part·of·['.',...relative.split(path.sep)]){current=path.join(current,part);try{const·stat=await·fs.lstat(current);if(stat.isSymbolicLink()||(stat.isFile()&&stat.nlink!==1))return·{success:false,error:'CONTRACT_REGISTER_LINK_REFUSED'};}catch(error){if((error·as·NodeJS.ErrnoException).code!=='ENOENT')throw·error;}` with `·(const·part·of·['.',·...relative.split(path.sep)])·{⏎········current·=·path.join(current,·part);⏎········try·{⏎··········const·stat·=·await·fs.lstat(current);⏎··········if·(stat.isSymbolicLink()·||·(stat.isFile()·&&·stat.nlink·!==·1))⏎············return·{·success:·false,·error:·'CONTRACT_REGISTER_LINK_REFUSED'·};⏎········}·catch·(error)·{⏎··········if·((error·as·NodeJS.ErrnoException).code·!==·'ENOENT')·throw·error;⏎········}⏎······`","line":53,"column":10,"nodeType":null,"messageId":"replace","endLine":53,"endColumn":330,"fix":{"range":[2911,3231],"text":" (const part of ['.', ...relative.split(path.sep)]) {\n        current = path.join(current, part);\n        try {\n          const stat = await fs.lstat(current);\n          if (stat.isSymbolicLink() || (stat.isFile() && stat.nlink !== 1))\n            return { success: false, error: 'CONTRACT_REGISTER_LINK_REFUSED' };\n        } catch (error) {\n          if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;\n        }\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=await·readWorkItemMetadata(wiDir,` with `·=·await·readWorkItemMetadata(wiDir,·`","line":55,"column":19,"nodeType":null,"messageId":"replace","endLine":55,"endColumn":53,"fix":{"range":[3257,3291],"text":" = await readWorkItemMetadata(wiDir, "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(metadata.workflow_type!=='feature_spec')return·{success:false,error:'UNSUPPORTED_CURRENT_RELEASE_WORKFLOW'` with `·(metadata.workflow_type·!==·'feature_spec')⏎······return·{·success:·false,·error:·'UNSUPPORTED_CURRENT_RELEASE_WORKFLOW'·`","line":56,"column":7,"nodeType":null,"messageId":"replace","endLine":56,"endColumn":114,"fix":{"range":[3310,3417],"text":" (metadata.workflow_type !== 'feature_spec')\n      return { success: false, error: 'UNSUPPORTED_CURRENT_RELEASE_WORKFLOW' "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=` with `·=·`","line":57,"column":22,"nodeType":null,"messageId":"replace","endLine":57,"endColumn":23,"fix":{"range":[3441,3442],"text":" = "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(typeof·currentPath!=='string'||!(WORKFLOW_PATHS·as·readonly·string[]).includes(currentPath)||currentPath==='spec_migration_path'||(workflowPath!==undefined&&workflowPath!==currentPath))return·{success:false,error:'CONTRACT_REGISTER_WORKFLOW_PATH_MISMATCH'` with `·(⏎······typeof·currentPath·!==·'string'·||⏎······!(WORKFLOW_PATHS·as·readonly·string[]).includes(currentPath)·||⏎······currentPath·===·'spec_migration_path'·||⏎······(workflowPath·!==·undefined·&&·workflowPath·!==·currentPath)⏎····)⏎······return·{·success:·false,·error:·'CONTRACT_REGISTER_WORKFLOW_PATH_MISMATCH'·`","line":58,"column":7,"nodeType":null,"messageId":"replace","endLine":58,"endColumn":263,"fix":{"range":[3472,3728],"text":" (\n      typeof currentPath !== 'string' ||\n      !(WORKFLOW_PATHS as readonly string[]).includes(currentPath) ||\n      currentPath === 'spec_migration_path' ||\n      (workflowPath !== undefined && workflowPath !== currentPath)\n    )\n      return { success: false, error: 'CONTRACT_REGISTER_WORKFLOW_PATH_MISMATCH' "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=guardHardStop(projectRoot,workItemId,'sf_contract_register');if(!hardStop.allowed)return·{success:false,error:hardStop.error,hard_stop:true` with `·=·guardHardStop(projectRoot,·workItemId,·'sf_contract_register');⏎····if·(!hardStop.allowed)·return·{·success:·false,·error:·hardStop.error,·hard_stop:·true·`","line":59,"column":19,"nodeType":null,"messageId":"replace","endLine":59,"endColumn":159,"fix":{"range":[3749,3889],"text":" = guardHardStop(projectRoot, workItemId, 'sf_contract_register');\n    if (!hardStop.allowed) return { success: false, error: hardStop.error, hard_stop: true "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=await·readAuthoritativeState({deps,projectRoot,workItemId` with `·=·await·readAuthoritativeState({·deps,·projectRoot,·workItemId·`","line":60,"column":16,"nodeType":null,"messageId":"replace","endLine":60,"endColumn":74,"fix":{"range":[3907,3965],"text":" = await readAuthoritativeState({ deps, projectRoot, workItemId "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(!state.current_state)return·{success:false,error:'CANDIDATE_FREEZE_STATE_UNAVAILABLE'` with `·(!state.current_state)⏎······return·{·success:·false,·error:·'CANDIDATE_FREEZE_STATE_UNAVAILABLE'·`","line":61,"column":7,"nodeType":null,"messageId":"replace","endLine":61,"endColumn":93,"fix":{"range":[3975,4061],"text":" (!state.current_state)\n      return { success: false, error: 'CANDIDATE_FREEZE_STATE_UNAVAILABLE' "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(isCandidateFrozenState(state.current_state))return·{success:false,error:'CANDIDATE_FROZEN',current_state:state.current_state` with `·(isCandidateFrozenState(state.current_state))⏎······return·{·success:·false,·error:·'CANDIDATE_FROZEN',·current_state:·state.current_state·`","line":62,"column":7,"nodeType":null,"messageId":"replace","endLine":62,"endColumn":132,"fix":{"range":[4070,4195],"text":" (isCandidateFrozenState(state.current_state))\n      return { success: false, error: 'CANDIDATE_FROZEN', current_state: state.current_state "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=PROJECT_REGISTRATION_SCHEMA_DESCRIPTORS.find(item=>item.id==='project-extension-registry'` with `·=·PROJECT_REGISTRATION_SCHEMA_DESCRIPTORS.find(⏎······item·=>·item.id·===·'project-extension-registry'⏎····`","line":63,"column":21,"nodeType":null,"messageId":"replace","endLine":63,"endColumn":111,"fix":{"range":[4218,4308],"text":" = PROJECT_REGISTRATION_SCHEMA_DESCRIPTORS.find(\n      item => item.id === 'project-extension-registry'\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=await·precheckSchemaDescriptors(projectRoot,` with `·=·await·precheckSchemaDescriptors(projectRoot,·`","line":64,"column":15,"nodeType":null,"messageId":"replace","endLine":64,"endColumn":60,"fix":{"range":[4326,4371],"text":" = await precheckSchemaDescriptors(projectRoot, "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=await·precheckSchemaDescriptors(wiDir,[{...descriptor,relativePath:'candidates/project/extension_registry.json',required:false}` with `·=·await·precheckSchemaDescriptors(wiDir,·[⏎······{⏎········...descriptor,⏎········relativePath:·'candidates/project/extension_registry.json',⏎········required:·false,⏎······},⏎····`","line":65,"column":20,"nodeType":null,"messageId":"replace","endLine":65,"endColumn":148,"fix":{"range":[4405,4533],"text":" = await precheckSchemaDescriptors(wiDir, [\n      {\n        ...descriptor,\n        relativePath: 'candidates/project/extension_registry.json',\n        required: false,\n      },\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(!live.ok||!candidate.ok)return·{success:false,error:'CONTRACT_REGISTER_REGISTRY_SCHEMA_BLOCKED'` with `·(!live.ok·||·!candidate.ok)⏎······return·{·success:·false,·error:·'CONTRACT_REGISTER_REGISTRY_SCHEMA_BLOCKED'·`","line":66,"column":7,"nodeType":null,"messageId":"replace","endLine":66,"endColumn":103,"fix":{"range":[4543,4639],"text":" (!live.ok || !candidate.ok)\n      return { success: false, error: 'CONTRACT_REGISTER_REGISTRY_SCHEMA_BLOCKED' "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(action!=='reset'&&(!kind||!VALID_KINDS.includes(kind)||!entry||typeof·entry!=='object'||Array.isArray(entry)))return·{success:false,error:'CONTRACT_REGISTER_KIND_AND_ENTRY_REQUIRED'` with `·(⏎······action·!==·'reset'·&&⏎······(!kind·||⏎········!VALID_KINDS.includes(kind)·||⏎········!entry·||⏎········typeof·entry·!==·'object'·||⏎········Array.isArray(entry))⏎····)⏎······return·{·success:·false,·error:·'CONTRACT_REGISTER_KIND_AND_ENTRY_REQUIRED'·`","line":67,"column":7,"nodeType":null,"messageId":"replace","endLine":67,"endColumn":189,"fix":{"range":[4648,4830],"text":" (\n      action !== 'reset' &&\n      (!kind ||\n        !VALID_KINDS.includes(kind) ||\n        !entry ||\n        typeof entry !== 'object' ||\n        Array.isArray(entry))\n    )\n      return { success: false, error: 'CONTRACT_REGISTER_KIND_AND_ENTRY_REQUIRED' "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `projectRoot,workItemId,action,kind,entry,workflowPath:currentPath,currentSubject:{workflow_type:'feature_spec',workflow_path:currentPath}` with `⏎······projectRoot,⏎······workItemId,⏎······action,⏎······kind,⏎······entry,⏎······workflowPath:·currentPath,⏎······currentSubject:·{·workflow_type:·'feature_spec',·workflow_path:·currentPath·},⏎····`","line":68,"column":37,"nodeType":null,"messageId":"replace","endLine":68,"endColumn":174,"fix":{"range":[4869,5006],"text":"\n      projectRoot,\n      workItemId,\n      action,\n      kind,\n      entry,\n      workflowPath: currentPath,\n      currentSubject: { workflow_type: 'feature_spec', workflow_path: currentPath },\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(error){return·{success:false,error:error·instanceof·Error?error.message:String(error)};}⏎⏎` with `·(error)·{⏎····return·{·success:·false,·error:·error·instanceof·Error·?·error.message·:·String(error)·};⏎··}`","line":69,"column":10,"nodeType":null,"messageId":"replace","endLine":71,"endColumn":1,"fix":{"range":[5019,5110],"text":" (error) {\n    return { success: false, error: error instanceof Error ? error.message : String(error) };\n  }"}}],"suppressedMessages":[],"errorCount":31,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":31,"fixableWarningCount":0,"source":"/**\n * sf-contract-register — author a governed Project Contract Candidate.\n *\n * Public name: sf_contract_register.\n *\n * Current add/update/reset only mutate the current Work Item Candidate. The live\n * Project/Module Contract truth sources remain unchanged until governed merge.\n */\nimport { registerHandler } from '../ToolDispatcher';\nimport * as fs from 'node:fs/promises';\nimport * as path from 'node:path';\nimport {SPEC_DIR_NAME} from '@specforge/types/directory-layout';\nimport {WORKFLOW_PATHS} from '@specforge/types';\nimport {precheckSchemaDescriptors} from '@specforge/types/schema-contract';\nimport {PROJECT_REGISTRATION_SCHEMA_DESCRIPTORS} from '../../project/project-schema-descriptors';\nimport {readAuthoritativeState} from '../lib/state-coordinator-v11';\nimport {readWorkItemMetadata} from '../lib/work-item-metadata';\nimport {isCandidateFrozenState} from '../lib/candidate-freeze-v11';\nimport {guardHardStop} from '../lib/hard-stop-latch';\nimport {\n  authorContractCandidate,\n  type ContractCandidateAction,\n  type RegistrationKind,\n} from '../lib/contract-authoring';\n\nconst VALID_KINDS: RegistrationKind[] = [\n  'shared_enum',\n  'invariant',\n  'public_interface',\n  'extension_point',\n  'namespace_type',\n];\n\nregisterHandler('sf_contract_register', async (args, context, deps) => {\n  const projectRoot =\n    (context?.directory as string) || (context?.worktree as string) || process.cwd();\n  const workItemId = args['work_item_id'] as string;\n  const action = (args['action'] as ContractCandidateAction | undefined) ?? 'add';\n  const kind = args['kind'] as RegistrationKind | undefined;\n  const entry = args['entry'] as Record<string, unknown> | undefined;\n  const workflowPath = args['workflow_path'] as string | undefined;\n\n  // Public current-release owner. Retained historical authoring algorithms below\n  // are not authority to activate their unshipped workflows or bypass freeze.\n  if(context?.agent!=='sf-orchestrator')return {success:false,error:'CONTRACT_REGISTER_ORCHESTRATOR_ONLY'};\n  if(!path.isAbsolute(projectRoot)||!/^WI-\\d{4}$/.test(workItemId??''))return {success:false,error:'CONTRACT_REGISTER_CURRENT_SUBJECT_REQUIRED'};\n  if(!['add','update','reset'].includes(action))return {success:false,error:'UNSUPPORTED_CURRENT_RELEASE_CONTRACT_ACTION'};\n  if(Object.keys(args).some(key=>!['work_item_id','action','kind','entry','workflow_path'].includes(key)))return {success:false,error:'CONTRACT_REGISTER_UNKNOWN_ARGUMENT'};\n  const wiDir=path.join(projectRoot,SPEC_DIR_NAME,'work-items',workItemId);\n  try {\n    for(const relative of [path.join(SPEC_DIR_NAME,'project','extension_registry.json'),path.join(SPEC_DIR_NAME,'work-items',workItemId,'work_item.json'),path.join(SPEC_DIR_NAME,'work-items',workItemId,'candidate_manifest.json'),path.join(SPEC_DIR_NAME,'work-items',workItemId,'candidates','project','extension_registry.json')]){\n      let current=projectRoot;\n      for(const part of ['.',...relative.split(path.sep)]){current=path.join(current,part);try{const stat=await fs.lstat(current);if(stat.isSymbolicLink()||(stat.isFile()&&stat.nlink!==1))return {success:false,error:'CONTRACT_REGISTER_LINK_REFUSED'};}catch(error){if((error as NodeJS.ErrnoException).code!=='ENOENT')throw error;}}\n    }\n    const metadata=await readWorkItemMetadata(wiDir,workItemId);\n    if(metadata.workflow_type!=='feature_spec')return {success:false,error:'UNSUPPORTED_CURRENT_RELEASE_WORKFLOW'};\n    const currentPath=metadata.workflow_path;\n    if(typeof currentPath!=='string'||!(WORKFLOW_PATHS as readonly string[]).includes(currentPath)||currentPath==='spec_migration_path'||(workflowPath!==undefined&&workflowPath!==currentPath))return {success:false,error:'CONTRACT_REGISTER_WORKFLOW_PATH_MISMATCH'};\n    const hardStop=guardHardStop(projectRoot,workItemId,'sf_contract_register');if(!hardStop.allowed)return {success:false,error:hardStop.error,hard_stop:true};\n    const state=await readAuthoritativeState({deps,projectRoot,workItemId});\n    if(!state.current_state)return {success:false,error:'CANDIDATE_FREEZE_STATE_UNAVAILABLE'};\n    if(isCandidateFrozenState(state.current_state))return {success:false,error:'CANDIDATE_FROZEN',current_state:state.current_state};\n    const descriptor=PROJECT_REGISTRATION_SCHEMA_DESCRIPTORS.find(item=>item.id==='project-extension-registry')!;\n    const live=await precheckSchemaDescriptors(projectRoot,[descriptor]);\n    const candidate=await precheckSchemaDescriptors(wiDir,[{...descriptor,relativePath:'candidates/project/extension_registry.json',required:false}]);\n    if(!live.ok||!candidate.ok)return {success:false,error:'CONTRACT_REGISTER_REGISTRY_SCHEMA_BLOCKED'};\n    if(action!=='reset'&&(!kind||!VALID_KINDS.includes(kind)||!entry||typeof entry!=='object'||Array.isArray(entry)))return {success:false,error:'CONTRACT_REGISTER_KIND_AND_ENTRY_REQUIRED'};\n    return authorContractCandidate({projectRoot,workItemId,action,kind,entry,workflowPath:currentPath,currentSubject:{workflow_type:'feature_spec',workflow_path:currentPath}});\n  } catch(error){return {success:false,error:error instanceof Error?error.message:String(error)};}\n\n\n});\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\handlers\\sf-design-gate.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······workItemId,⏎······baseDir,⏎······workflowType⏎····` with `workItemId,·baseDir,·workflowType`","line":20,"column":42,"nodeType":null,"messageId":"replace","endLine":24,"endColumn":5,"fix":{"range":[868,925],"text":"workItemId, baseDir, workflowType"}}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":1,"fixableWarningCount":0,"source":"import { registerHandler } from '../ToolDispatcher';\nimport { checkDesignGate } from '../lib/sf_design_gate_core';\n\nregisterHandler('sf_design_gate', async (args, context, _deps) => {\n  const workItemId = args['work_item_id'] as string;\n  if (!workItemId) {\n    return { success: false, error: 'work_item_id required' };\n  }\n  if (args['mode'] !== undefined || args['gate_mode'] !== undefined) {\n    return { success: false, error: 'DESIGN_GATE_MODE_NOT_CURRENT' };\n  }\n  if (args['workflow_type'] !== undefined && args['workflow_type'] !== 'feature_spec') {\n    return { success: false, error: 'UNSUPPORTED_CURRENT_RELEASE_WORKFLOW' };\n  }\n\n  const baseDir = (context?.directory as string) || (context?.worktree as string) || process.cwd();\n  const workflowType = (args['workflow_type'] as string) || 'feature_spec';\n\n  try {\n    const result = await checkDesignGate(\n      workItemId,\n      baseDir,\n      workflowType\n    );\n    return { success: true, ...result };\n  } catch (err) {\n    return { success: false, error: (err as Error).message };\n  }\n});\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\handlers\\sf-doc-lint.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'design','tasks'].includes(docType))·return·{success:false,error:'UNSUPPORTED_CURRENT_DOCUMENT_TYPE'` with `·'design',·'tasks'].includes(docType))⏎····return·{·success:·false,·error:·'UNSUPPORTED_CURRENT_DOCUMENT_TYPE'·`","line":8,"column":35,"nodeType":null,"messageId":"replace","endLine":8,"endColumn":135,"fix":{"range":[364,464],"text":" 'design', 'tasks'].includes(docType))\n    return { success: false, error: 'UNSUPPORTED_CURRENT_DOCUMENT_TYPE' "}}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":1,"fixableWarningCount":0,"source":"import { registerHandler } from '../ToolDispatcher';\nimport { lintDocument } from '../lib/sf_doc_lint_core';\nimport type { DocType } from '../lib/sf_doc_lint_core';\n\nregisterHandler('sf_doc_lint', async (args, context, _deps) => {\n  const workItemId = args['work_item_id'] as string;\n  const docType = args['doc_type'] as string;\n  if (docType && !['requirements','design','tasks'].includes(docType)) return {success:false,error:'UNSUPPORTED_CURRENT_DOCUMENT_TYPE'};\n\n  if (!workItemId || !docType) {\n    return { success: false, error: 'work_item_id and doc_type required' };\n  }\n\n  const baseDir = (context?.directory as string) || (context?.worktree as string) || process.cwd();\n\n  try {\n    const result = await lintDocument(workItemId, docType as DocType, baseDir);\n    return { success: true, ...result };\n  } catch (err) {\n    return { success: false, error: (err as Error).message };\n  }\n});\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\handlers\\sf-doctor.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\handlers\\sf-git-agent-lock-acquire.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":5,"column":22,"nodeType":null,"messageId":"insert","endLine":5,"endColumn":22,"fix":{"range":[215,215],"text":"\n   "}},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['lock_name'] || ''' will use Object's default stringification format ('[object Object]') when stringified.","line":9,"column":24,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":9,"endColumn":47},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['owner'] || ''' will use Object's default stringification format ('[object Object]') when stringified.","line":10,"column":21,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":10,"endColumn":40},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['work_item_id']' will use Object's default stringification format ('[object Object]') when stringified.","line":11,"column":49,"nodeType":"MemberExpression","messageId":"baseToString","endLine":11,"endColumn":69}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":1,"fixableWarningCount":0,"source":"import { registerHandler } from '../ToolDispatcher';\nimport { gitAgentLockAcquire } from '../lib/git-governance-stage4';\n\nregisterHandler('sf_git_agent_lock_acquire', async (args, context) => {\n  const projectRoot = (context?.directory as string) || (context?.worktree as string) || process.cwd();\n  try {\n    return await gitAgentLockAcquire({\n      projectRoot,\n      lockName: String(args['lock_name'] || ''),\n      owner: String(args['owner'] || ''),\n      workItemId: args['work_item_id'] ? String(args['work_item_id']) : undefined,\n      paths: Array.isArray(args['paths']) ? args['paths'].map(String) : [],\n      ttlMinutes: args['ttl_minutes'] ? Number(args['ttl_minutes']) : undefined,\n      confirmed: args['confirmed'] === true,\n    });\n  } catch (err) {\n    return { success: false, error: err instanceof Error ? err.message : String(err) };\n  }\n});\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\handlers\\sf-git-agent-lock-release.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":5,"column":22,"nodeType":null,"messageId":"insert","endLine":5,"endColumn":22,"fix":{"range":[215,215],"text":"\n   "}},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['lock_name'] || ''' will use Object's default stringification format ('[object Object]') when stringified.","line":9,"column":24,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":9,"endColumn":47},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['owner']' will use Object's default stringification format ('[object Object]') when stringified.","line":10,"column":37,"nodeType":"MemberExpression","messageId":"baseToString","endLine":10,"endColumn":50}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":1,"fixableWarningCount":0,"source":"import { registerHandler } from '../ToolDispatcher';\nimport { gitAgentLockRelease } from '../lib/git-governance-stage4';\n\nregisterHandler('sf_git_agent_lock_release', async (args, context) => {\n  const projectRoot = (context?.directory as string) || (context?.worktree as string) || process.cwd();\n  try {\n    return await gitAgentLockRelease({\n      projectRoot,\n      lockName: String(args['lock_name'] || ''),\n      owner: args['owner'] ? String(args['owner']) : undefined,\n      force: args['force'] === true,\n      confirmed: args