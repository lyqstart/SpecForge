stEventId !== state.lastEventId ||\n         "}},{"ruleId":"@typescript-eslint/no-unsafe-argument","severity":2,"message":"Unsafe argument of type `any` assigned to a parameter of type `string`.","line":288,"column":33,"nodeType":"MemberExpression","messageId":"unsafeArgument","endLine":288,"endColumn":50},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `··!equal(value.workItems,·state.workItems))` with `!equal(value.workItems,·state.workItems)⏎········)⏎·········`","line":289,"column":11,"nodeType":null,"messageId":"replace","endLine":289,"endColumn":54,"fix":{"range":[16873,16916],"text":"!equal(value.workItems, state.workItems)\n        )\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `plan.stage,·['update-ref',·'--no-deref',·'HEAD',·input.original_commit],·emptyTemplate` with `⏎········plan.stage,⏎········['update-ref',·'--no-deref',·'HEAD',·input.original_commit],⏎········emptyTemplate⏎······`","line":294,"column":17,"nodeType":null,"messageId":"replace","endLine":294,"endColumn":103,"fix":{"range":[17259,17345],"text":"\n        plan.stage,\n        ['update-ref', '--no-deref', 'HEAD', input.original_commit],\n        emptyTemplate\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `await·git(plan.stage,·['rev-parse',·'HEAD'],·emptyTemplate)` with `⏎········(await·git(plan.stage,·['rev-parse',·'HEAD'],·emptyTemplate))`","line":296,"column":11,"nodeType":null,"messageId":"replace","endLine":296,"endColumn":70,"fix":{"range":[17440,17499],"text":"\n        (await git(plan.stage, ['rev-parse', 'HEAD'], emptyTemplate))"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `··········(await·fs.readFile(path.join(plan.stage,·'.git/HEAD'),·'utf8')).trim()·!==·input.original_commit)` with `········(await·fs.readFile(path.join(plan.stage,·'.git/HEAD'),·'utf8')).trim()·!==⏎··········input.original_commit⏎······)⏎·······`","line":297,"column":1,"nodeType":null,"messageId":"replace","endLine":297,"endColumn":108,"fix":{"range":[17529,17636],"text":"        (await fs.readFile(path.join(plan.stage, '.git/HEAD'), 'utf8')).trim() !==\n          input.original_commit\n      )\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·if·(digest(await·fs.readFile(path.join(plan.stage,·entry.path)))·!==·entry.sha256)` with `⏎········if·(digest(await·fs.readFile(path.join(plan.stage,·entry.path)))·!==·entry.sha256)⏎·········`","line":298,"column":35,"nodeType":null,"messageId":"replace","endLine":298,"endColumn":118,"fix":{"range":[17694,17777],"text":"\n        if (digest(await fs.readFile(path.join(plan.stage, entry.path))) !== entry.sha256)\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·event:·'stage_verified',·file_count:·entries.length,·lastEventId:·state.lastEventId,·lastEventTs:·state.lastEventTs` with `⏎········event:·'stage_verified',⏎········file_count:·entries.length,⏎········lastEventId:·state.lastEventId,⏎········lastEventTs:·state.lastEventTs,⏎·····`","line":300,"column":32,"nodeType":null,"messageId":"replace","endLine":300,"endColumn":148,"fix":{"range":[17912,18028],"text":"\n        event: 'stage_verified',\n        file_count: entries.length,\n        lastEventId: state.lastEventId,\n        lastEventTs: state.lastEventTs,\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·stageExists·=·await·exists(plan.stage),` with `⏎······stageExists·=·await·exists(plan.stage),⏎·····`","line":304,"column":47,"nodeType":null,"messageId":"replace","endLine":304,"endColumn":87,"fix":{"range":[18183,18223],"text":"\n      stageExists = await exists(plan.stage),\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `await·exists(doneFile)·||·!equal(await·inventory(plan.stage),·ready.inventory))` with `(await·exists(doneFile))·||·!equal(await·inventory(plan.stage),·ready.inventory))⏎·······`","line":306,"column":11,"nodeType":null,"messageId":"replace","endLine":306,"endColumn":90,"fix":{"range":[18301,18380],"text":"(await exists(doneFile)) || !equal(await inventory(plan.stage), ready.inventory))\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·if·(digest(await·fs.readFile(path.join(plan.stage,·entry.path)))·!==·entry.sha256)` with `⏎········if·(digest(await·fs.readFile(path.join(plan.stage,·entry.path)))·!==·entry.sha256)⏎·········`","line":307,"column":35,"nodeType":null,"messageId":"replace","endLine":307,"endColumn":118,"fix":{"range":[18436,18519],"text":"\n        if (digest(await fs.readFile(path.join(plan.stage, entry.path))) !== entry.sha256)\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·archive_sha256:·input.archive_sha256` with `⏎··········archive_sha256:·input.archive_sha256,⏎·······`","line":310,"column":64,"nodeType":null,"messageId":"replace","endLine":310,"endColumn":101,"fix":{"range":[18727,18764],"text":"\n          archive_sha256: input.archive_sha256,\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `!equal(await·inventory(target),·ready.inventory)·||·!equal(await·inventory(plan.residue),·plan.before))` with `⏎······!equal(await·inventory(target),·ready.inventory)·||⏎······!equal(await·inventory(plan.residue),·plan.before)⏎····)⏎·····`","line":318,"column":9,"nodeType":null,"messageId":"replace","endLine":318,"endColumn":112,"fix":{"range":[19228,19331],"text":"\n      !equal(await inventory(target), ready.inventory) ||\n      !equal(await inventory(plan.residue), plan.before)\n    )\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·if·(digest(await·fs.readFile(path.join(target,·entry.path)))·!==·entry.sha256)` with `⏎······if·(digest(await·fs.readFile(path.join(target,·entry.path)))·!==·entry.sha256)⏎·······`","line":319,"column":33,"nodeType":null,"messageId":"replace","endLine":319,"endColumn":112,"fix":{"range":[19389,19468],"text":"\n      if (digest(await fs.readFile(path.join(target, entry.path))) !== entry.sha256)\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·archive_sha256:·input.archive_sha256,·original_commit:·input.original_commit,·file_count:·entries.length` with `⏎······archive_sha256:·input.archive_sha256,⏎······original_commit:·input.original_commit,⏎······file_count:·entries.length,⏎···`","line":320,"column":29,"nodeType":null,"messageId":"replace","endLine":320,"endColumn":134,"fix":{"range":[19522,19627],"text":"\n      archive_sha256: input.archive_sha256,\n      original_commit: input.original_commit,\n      file_count: entries.length,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·event:·'completed',·file_count:·entries.length,·archive_sha256:·input.archive_sha256` with `⏎······event:·'completed',⏎······file_count:·entries.length,⏎······archive_sha256:·input.archive_sha256,⏎···`","line":321,"column":30,"nodeType":null,"messageId":"replace","endLine":321,"endColumn":115,"fix":{"range":[19661,19746],"text":"\n      event: 'completed',\n      file_count: entries.length,\n      archive_sha256: input.archive_sha256,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·success:·true,·project_path:·target,·archive_sha256:·input.archive_sha256,` with `⏎······success:·true,⏎······project_path:·target,⏎······archive_sha256:·input.archive_sha256,⏎·····`","line":322,"column":13,"nodeType":null,"messageId":"replace","endLine":322,"endColumn":88,"fix":{"range":[19763,19838],"text":"\n      success: true,\n      project_path: target,\n      archive_sha256: input.archive_sha256,\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·restored_files:·entries.length,·audit_path:·audit,` with `⏎······restored_files:·entries.length,⏎······audit_path:·audit,⏎·····`","line":323,"column":27,"nodeType":null,"messageId":"replace","endLine":323,"endColumn":78,"fix":{"range":[19905,19956],"text":"\n      restored_files: entries.length,\n      audit_path: audit,\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·old_git_metadata_restored:·false` with `⏎······old_git_metadata_restored:·false,⏎···`","line":324,"column":54,"nodeType":null,"messageId":"replace","endLine":324,"endColumn":87,"fix":{"range":[20038,20071],"text":"\n      old_git_metadata_restored: false,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·await·fs.unlink(lock);` with `⏎····await·fs.unlink(lock);⏎·`","line":325,"column":14,"nodeType":null,"messageId":"replace","endLine":325,"endColumn":37,"fix":{"range":[20088,20111],"text":"\n    await fs.unlink(lock);\n "}}],"suppressedMessages":[],"errorCount":85,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":81,"fixableWarningCount":0,"source":"import { SPEC_DIR_NAME } from \"@specforge/types/directory-layout\";\nimport * as fs from 'node:fs/promises';\nimport * as path from 'node:path';\nimport * as os from 'node:os';\nimport { createHash, randomUUID } from 'node:crypto';\nimport { inflateSync } from 'node:zlib';\nimport { execFile } from 'node:child_process';\nimport { promisify } from 'node:util';\nimport { IPathResolver } from '../daemon/path-resolver';\nimport { StateManager } from '../state/StateManager';\n\nexport interface ProjectArchiveRestoreInput {\n  project_path: string;\n  archive_path: string;\n  archive_sha256: string;\n  original_commit: string;\n  confirmation_quote: string;\n}\ntype Entry = { path: string; size: number; sha256: string; bytes_base64: string };\ntype Inventory = { path: string; kind: 'file' | 'directory'; sha256?: string }[];\ntype Plan = { schema_version: '1.0'; input: ProjectArchiveRestoreInput; created_utc: string;\n  before: Inventory; objects: Entry[]; stage: string; residue: string };\nconst exec = promisify(execFile);\nconst digest = (bytes: Buffer | string, algorithm = 'sha256') => createHash(algorithm).update(bytes).digest('hex');\nexport const projectPathIdentity = (value: string) => process.platform === 'win32' ? path.resolve(value).toLowerCase() : path.resolve(value);\nfunction fail(reason: string): never { throw new Error(`ARCHIVE_RECOVERY_${reason}`); }\nconst exists = async (file: string) => fs.lstat(file).then(() => true, error => {\n  if (error.code === 'ENOENT') return false;\n  throw error;\n});\n\n/** Fail closed on platform aliases, alternate streams and file/directory collisions. */\nfunction safeRelative(value: unknown): asserts value is string {\n  if (typeof value !== 'string' || !value || value.length > 1024 || value.includes('\\\\') ||\n      value.split('/').some(part => !part || part === '.' || part === '..' || /[<>:\"|?*\\x00-\\x1f]/.test(part) ||\n        /[. ]$/.test(part) || /^(con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$)/i.test(part))) fail('UNSAFE_PATH');\n}\n\nasync function noLinks(absolute: string): Promise<void> {\n  const resolved = path.resolve(absolute);\n  let cursor = path.parse(resolved).root;\n  for (const part of resolved.slice(cursor.length).split(path.sep).filter(Boolean)) {\n    cursor = path.join(cursor, part);\n    if (!await exists(cursor)) continue;\n    const stat = await fs.lstat(cursor);\n    if (stat.isSymbolicLink() || (!stat.isDirectory() && (!stat.isFile() || stat.nlink !== 1))) fail('LINK_OR_SPECIAL_FILE');\n  }\n}\n\nasync function inventory(root: string): Promise<Inventory> {\n  await noLinks(root);\n  const result: Inventory = [];\n  const walk = async (dir: string, prefix: string) => {\n    for (const name of (await fs.readdir(dir)).sort()) {\n      const relative = prefix + name;\n      safeRelative(relative);\n      const file = path.join(dir, name);\n      const stat = await fs.lstat(file);\n      if (stat.isSymbolicLink()) fail('LINK_OR_SPECIAL_FILE');\n      if (stat.isDirectory()) {\n        result.push({ path: relative, kind: 'directory' });\n        await walk(file, relative + '/');\n      } else if (stat.isFile() && stat.nlink === 1) {\n        result.push({ path: relative, kind: 'file', sha256: digest(await fs.readFile(file)) });\n      } else fail('LINK_OR_SPECIAL_FILE');\n      if (result.length > 50000) fail('INVENTORY_LIMIT');\n    }\n  };\n  await walk(root, '');\n  return result;\n}\nconst equal = (a: unknown, b: unknown) => JSON.stringify(a) === JSON.stringify(b);\n\nasync function durable(file: string, data: string | Buffer): Promise<void> {\n  const handle = await fs.open(file, 'wx');\n  try { await handle.writeFile(data); await handle.sync(); } finally { await handle.close(); }\n}\nasync function atomicDocument(file: string, data: string): Promise<void> {\n  const temporary = `${file}.${randomUUID()}.partial`;\n  await durable(temporary, data);\n  // The owner lock serializes publication; partial temporary files are retained after a crash.\n  if (await exists(file)) fail('DOCUMENT_COLLISION');\n  await fs.rename(temporary, file);\n}\nasync function marker(file: string, data: unknown): Promise<void> {\n  await noLinks(file);\n  if (await exists(file)) {\n    if (!equal(JSON.parse(await fs.readFile(file, 'utf8')), data)) fail('JOURNAL_DRIFT');\n  } else await atomicDocument(file, JSON.stringify(data, null, 2) + '\\n');\n}\n\nasync function auditEvent(audit: string, event: Record<string, unknown>): Promise<void> {\n  const file = path.join(audit, 'operations.jsonl');\n  await noLinks(file);\n  const handle = await fs.open(file, 'a');\n  try { await handle.writeFile(JSON.stringify({ utc: new Date().toISOString(), ...event }) + '\\n'); await handle.sync(); }\n  finally { await handle.close(); }\n}\n\nfunction decodeEntry(entry: Entry): Buffer {\n  safeRelative(entry.path);\n  if (!Number.isSafeInteger(entry.size) || entry.size < 0 || entry.size > 32 * 1024 * 1024 ||\n      typeof entry.bytes_base64 !== 'string' || !/^[a-f0-9]{64}$/.test(entry.sha256)) fail('INVALID_ENTRY');\n  const bytes = Buffer.from(entry.bytes_base64, 'base64');\n  if (bytes.toString('base64') !== entry.bytes_base64 || bytes.length !== entry.size || digest(bytes) !== entry.sha256) fail('ENTRY_HASH_MISMATCH');\n  return bytes;\n}\n\nasync function readArchive(input: ProjectArchiveRestoreInput): Promise<Entry[]> {\n  await noLinks(input.archive_path);\n  if ((await fs.stat(input.archive_path)).size > 128 * 1024 * 1024) fail('ARCHIVE_LIMIT');\n  const raw = await fs.readFile(input.archive_path);\n  if (digest(raw) !== input.archive_sha256) fail('ARCHIVE_HASH_MISMATCH');\n  const archive = JSON.parse(raw.toString('utf8'));\n  if (typeof archive.project !== 'string' || projectPathIdentity(archive.project) !== projectPathIdentity(input.project_path)) fail('PROJECT_IDENTITY_MISMATCH');\n  if (!Array.isArray(archive.entries) || !archive.entries.length || archive.entries.length > 20000) fail('INVALID_ENTRIES');\n  const names = new Set<string>();\n  const components = new Map<string, string>();\n  let total = 0;\n  for (const entry of archive.entries as Entry[]) {\n    const bytes = decodeEntry(entry);\n    total += bytes.length;\n    if (total > 96 * 1024 * 1024) fail('ARCHIVE_LIMIT');\n    const key = entry.path.toLowerCase();\n    if (key.split('/').some(part => part === '.git') || names.has(key)) fail('PATH_COLLISION');\n    names.add(key);\n    const parts = entry.path.split('/');\n    for (let count = 1; count <= parts.length; count++) {\n      const original = parts.slice(0, count).join('/'), folded = original.toLowerCase();\n      if (components.has(folded) && components.get(folded) !== original) fail('PATH_COLLISION');\n      components.set(folded, original);\n    }\n  }\n  for (const name of names) {\n    const parts = name.split('/');\n    while (parts.length > 1) { parts.pop(); if (names.has(parts.join('/'))) fail('PATH_COLLISION'); }\n  }\n  return archive.entries;\n}\n\nfunction verifyObjects(objects: Entry[], commit: string, entries: Entry[]): void {\n  const graph = new Map<string, { type: string; body: Buffer }>();\n  for (const object of objects) {\n    const id = object.path.replace('.git/objects/', '').replace('/', '');\n    if (!/^[a-f0-9]{40}$/.test(id)) fail('GIT_RESIDUE_UNSUPPORTED');\n    const raw = inflateSync(decodeEntry(object), { maxOutputLength: 64 * 1024 * 1024 });\n    if (digest(raw, 'sha1') !== id) fail('GIT_OBJECT_HASH_MISMATCH');\n    const separator = raw.indexOf(0);\n    const header = raw.subarray(0, separator).toString('ascii');\n    const match = /^(blob|tree|commit|tag) ([0-9]+)$/.exec(header);\n    const body = raw.subarray(separator + 1);\n    if (!match || Number(match[2]) !== body.length) fail('GIT_OBJECT_INVALID');\n    graph.set(id, { type: match[1]!, body });\n  }\n  const current = graph.get(commit);\n  if (current?.type !== 'commit') fail('ORIGINAL_COMMIT_MISSING');\n  const root = /^tree ([a-f0-9]{40})\\n/.exec(current.body.toString('utf8'))?.[1];\n  if (!root) fail('GIT_COMMIT_INVALID');\n  const files = new Map(entries.map(entry => [entry.path, entry]));\n  const visit = (id: string, prefix: string, ancestors: Set<string>) => {\n    const tree = graph.get(id);\n    if (tree?.type !== 'tree' || ancestors.has(id) || ancestors.size > 128) fail('GIT_TREE_INVALID');\n    const next = new Set(ancestors).add(id);\n    let offset = 0;\n    while (offset < tree.body.length) {\n      const space = tree.body.indexOf(32, offset), nul = tree.body.indexOf(0, space + 1);\n      if (space < offset || nul < space || nul + 21 > tree.body.length) fail('GIT_TREE_INVALID');\n      const mode = tree.body.subarray(offset, space).toString('ascii');\n      const name = tree.body.subarray(space + 1, nul).toString('utf8');\n      safeRelative(name);\n      if (name.includes('/')) fail('GIT_TREE_INVALID');\n      const key = prefix + name, child = tree.body.subarray(nul + 1, nul + 21).toString('hex');\n      if (mode === '40000') visit(child, key + '/', next);\n      else {\n        if (!['100644', '100755'].includes(mode)) fail('GIT_FILE_MODE_UNSUPPORTED');\n        const blob = graph.get(child), file = files.get(key);\n        if (blob?.type !== 'blob' || !file || !decodeEntry(file).equals(blob.body)) fail('GIT_ARCHIVE_LINKAGE_MISMATCH');\n      }\n      offset = nul + 21;\n    }\n  };\n  visit(root, '', new Set());\n}\n\nasync function git(root: string, args: string[], emptyTemplate: string): Promise<string> {\n  // Do not inherit arbitrary Git configuration, worktree redirects, templates or hooks.\n  const env = Object.fromEntries(Object.entries(process.env).filter(([key]) => !key.toUpperCase().startsWith('GIT_')));\n  Object.assign(env, { GIT_CONFIG_NOSYSTEM: '1', GIT_CONFIG_GLOBAL: process.platform === 'win32' ? 'NUL' : '/dev/null', GIT_TERMINAL_PROMPT: '0' });\n  const audit = path.dirname(emptyTemplate);\n  await auditEvent(audit, { event: 'git_started', cwd: root, args });\n  try {\n    const result = await exec('git', ['-c', `core.hooksPath=${emptyTemplate}`, '-c', 'core.autocrlf=false', ...args],\n      { cwd: root, env, windowsHide: true, maxBuffer: 4 * 1024 * 1024 });\n    await auditEvent(audit, { event: 'git_finished', args, inner_exit_code: 0, stdout: result.stdout, stderr: result.stderr });\n    return result.stdout.trim();\n  } catch (error) {\n    const failed = error as { code?: number; stdout?: string; stderr?: string };\n    await auditEvent(audit, { event: 'git_finished', args, inner_exit_code: typeof failed.code === 'number' ? failed.code : 1, stdout: failed.stdout, stderr: failed.stderr });\n    throw error;\n  }\n}\n\n/** Recovery owner only: never called by Project Init or an Agent artifact writer. */\nexport async function restoreProjectArchive(resolver: IPathResolver, input: ProjectArchiveRestoreInput) {\n  if (!input || typeof input.project_path !== 'string' || !path.isAbsolute(input.project_path) ||\n      typeof input.archive_path !== 'string' || !path.isAbsolute(input.archive_path) ||\n      !/^[a-f0-9]{64}$/.test(input.archive_sha256) || !/^[a-f0-9]{40}$/.test(input.original_commit) ||\n      typeof input.confirmation_quote !== 'string' || !input.confirmation_quote.trim() || input.confirmation_quote.length > 4000) fail('INPUT_REQUIRED');\n  const target = path.resolve(input.project_path), parent = path.dirname(target);\n  if ([path.parse(target).root, os.homedir(), os.tmpdir(), process.cwd()].some(value => projectPathIdentity(value) === projectPathIdentity(target)) ||\n      path.relative(target, input.archive_path) === '' || !path.relative(target, input.archive_path).startsWith('..' + path.sep) && !path.isAbsolute(path.relative(target, input.archive_path))) fail('UNSAFE_TARGET');\n  if (projectPathIdentity(resolver.resolveProjectRuntimeDir(target)) !== projectPathIdentity(path.join(target, (`${SPEC_DIR_NAME}/runtime` as const)))) fail('EXTERNAL_RUNTIME_UNSUPPORTED');\n  await noLinks(target);\n  const entries = await readArchive(input);\n  const key = digest(projectPathIdentity(target)).slice(0, 24);\n  const audit = path.join(resolver.resolveDaemonRuntimeDir(), 'project-archive-recovery', key);\n  if (path.relative(target, audit) === '' || !path.relative(target, audit).startsWith('..' + path.sep) && !path.isAbsolute(path.relative(target, audit))) fail('UNSAFE_AUDIT_ROOT');\n  await noLinks(audit);\n  await fs.mkdir(audit, { recursive: true });\n  const lock = path.join(audit, 'lock.json');\n  if (await exists(lock)) {\n    await noLinks(lock);\n    const prior = JSON.parse(await fs.readFile(lock, 'utf8'));\n    if (prior.archive_sha256 !== input.archive_sha256 || !Number.isSafeInteger(prior.pid) || prior.pid <= 0) fail('LOCK_INVALID');\n    try { process.kill(prior.pid, 0); fail('LOCKED'); }\n    catch (error) { if ((error as NodeJS.ErrnoException).code !== 'ESRCH') throw error; }\n    await fs.rename(lock, path.join(audit, `dead-lock-${randomUUID()}.json`));\n  }\n  await durable(lock, JSON.stringify({ pid: process.pid, archive_sha256: input.archive_sha256 }));\n  try {\n    const planFile = path.join(audit, 'plan.json');\n    let plan: Plan;\n    if (await exists(planFile)) {\n      await noLinks(planFile);\n      plan = JSON.parse(await fs.readFile(planFile, 'utf8'));\n      if (plan.schema_version !== '1.0' || !equal(plan.input, input)) fail('PLAN_IDENTITY_MISMATCH');\n    } else {\n      if (!await exists(target) || !(await fs.stat(target)).isDirectory()) fail('TARGET_MISSING');\n      const before = await inventory(target);\n      const byPath = new Map(entries.map(entry => [entry.path, entry]));\n      const objects: Entry[] = [];\n      for (const item of before) {\n        // Empty directory structure carries no file content or Git identity.\n        // Retain it in the original residue; only verified archive/object files may be published.\n        if (item.kind === 'directory') continue;\n        if (item.path.startsWith('.git/')) {\n          if (!/^\\.git\\/objects\\/[a-f0-9]{2}\\/[a-f0-9]{38}$/.test(item.path)) fail('GIT_RESIDUE_UNSUPPORTED');\n          const bytes = await fs.readFile(path.join(target, item.path));\n          objects.push({ path: item.path, size: bytes.length, sha256: digest(bytes), bytes_base64: bytes.toString('base64') });\n        } else if (byPath.get(item.path)?.sha256 !== item.sha256) fail('TARGET_CONFLICT');\n      }\n      verifyObjects(objects, input.original_commit, entries);\n      plan = { schema_version: '1.0', input, created_utc: new Date().toISOString(), before, objects,\n        stage: path.join(parent, `.sf-archive-stage-${key}`), residue: path.join(parent, `.sf-archive-residue-${key}`) };\n      if (await exists(plan.stage) || await exists(plan.residue)) fail('STAGING_COLLISION');\n      await atomicDocument(planFile, JSON.stringify(plan, null, 2) + '\\n');\n      await auditEvent(audit, { event: 'plan_created', archive_sha256: input.archive_sha256 });\n    }\n    // Revalidate plan-owned paths and object bytes on every retry before any rename.\n    if (plan.stage !== path.join(parent, `.sf-archive-stage-${key}`) || plan.residue !== path.join(parent, `.sf-archive-residue-${key}`)) fail('PLAN_PATH_DRIFT');\n    verifyObjects(plan.objects, input.original_commit, entries);\n    for (const value of [plan.stage, plan.residue, audit]) await noLinks(value);\n    const readyFile = path.join(audit, 'stage-ready.json'), doneFile = path.join(audit, 'completed.json');\n    if (!await exists(readyFile)) {\n      if (!await exists(target) || !equal(await inventory(target), plan.before) || await exists(plan.residue)) fail('TARGET_DRIFT');\n      if (await exists(plan.stage)) {\n        // An uncommitted stage is never published; preserve it and build afresh.\n        await inventory(plan.stage);\n        await fs.rename(plan.stage, `${plan.stage}.incomplete-${randomUUID()}`);\n      }\n      await fs.mkdir(plan.stage);\n      const emptyTemplate = path.join(audit, 'empty-template');\n      await fs.mkdir(emptyTemplate, { recursive: true });\n      if ((await fs.readdir(emptyTemplate)).length) fail('TEMPLATE_DRIFT');\n      for (const entry of [...entries, ...plan.objects]) {\n        const file = path.join(plan.stage, entry.path);\n        await fs.mkdir(path.dirname(file), { recursive: true });\n        await durable(file, decodeEntry(entry));\n        await auditEvent(audit, { event: 'staged_file', path: entry.path, sha256: entry.sha256 });\n      }\n      // Verify the original event history with the real StateManager without persisting a projection.\n      if (!entries.some(entry => entry.path === (`${SPEC_DIR_NAME}/runtime/events.jsonl` as const))) fail('EVENT_HISTORY_REQUIRED');\n      const state = await new StateManager(resolver, plan.stage).rebuildState();\n      if (!state.lastEventId) fail('EMPTY_EVENT_HISTORY');\n      const projection = entries.find(entry => entry.path === (`${SPEC_DIR_NAME}/runtime/state.json` as const));\n      if (projection) {\n        const value = JSON.parse(decodeEntry(projection).toString('utf8'));\n        if (projectPathIdentity(value.projectPath) !== projectPathIdentity(target) || value.lastEventId !== state.lastEventId || value.lastEventTs !== state.lastEventTs ||\n            !equal(value.workItems, state.workItems)) fail('PROJECTION_WITNESS_MISMATCH');\n      }\n      await git(plan.stage, ['init', '--quiet', `--template=${emptyTemplate}`], emptyTemplate);\n      await git(plan.stage, ['config', '--local', 'core.autocrlf', 'false'], emptyTemplate);\n      await git(plan.stage, ['fsck', '--full', '--strict', '--no-reflogs'], emptyTemplate);\n      await git(plan.stage, ['update-ref', '--no-deref', 'HEAD', input.original_commit], emptyTemplate);\n      await git(plan.stage, ['read-tree', input.original_commit], emptyTemplate);\n      if (await git(plan.stage, ['rev-parse', 'HEAD'], emptyTemplate) !== input.original_commit ||\n          (await fs.readFile(path.join(plan.stage, '.git/HEAD'), 'utf8')).trim() !== input.original_commit) fail('HEAD_MISMATCH');\n      for (const entry of entries) if (digest(await fs.readFile(path.join(plan.stage, entry.path))) !== entry.sha256) fail('STAGE_DRIFT');\n      await marker(readyFile, { inventory: await inventory(plan.stage), state });\n      await auditEvent(audit, { event: 'stage_verified', file_count: entries.length, lastEventId: state.lastEventId, lastEventTs: state.lastEventTs });\n    }\n    await noLinks(readyFile);\n    const ready = JSON.parse(await fs.readFile(readyFile, 'utf8'));\n    const targetExists = await exists(target), stageExists = await exists(plan.stage), residueExists = await exists(plan.residue);\n    if (stageExists) {\n      if (await exists(doneFile) || !equal(await inventory(plan.stage), ready.inventory)) fail('STAGE_DRIFT');\n      for (const entry of entries) if (digest(await fs.readFile(path.join(plan.stage, entry.path))) !== entry.sha256) fail('STAGE_DRIFT');\n      if (targetExists) {\n        if (residueExists || !equal(await inventory(target), plan.before)) fail('TARGET_DRIFT');\n        await marker(path.join(audit, 'publish-intent.json'), { archive_sha256: input.archive_sha256 });\n        await auditEvent(audit, { event: 'residue_rename_started' });\n        await fs.rename(target, plan.residue);\n      } else if (!residueExists) fail('RESIDUE_MISSING');\n      if (!equal(await inventory(plan.residue), plan.before)) fail('RESIDUE_DRIFT');\n      await auditEvent(audit, { event: 'publish_rename_started' });\n      await fs.rename(plan.stage, target);\n    } else if (!targetExists || !residueExists) fail('PUBLICATION_INCOMPLETE');\n    if (!equal(await inventory(target), ready.inventory) || !equal(await inventory(plan.residue), plan.before)) fail('PUBLISHED_DRIFT');\n    for (const entry of entries) if (digest(await fs.readFile(path.join(target, entry.path))) !== entry.sha256) fail('PUBLISHED_DRIFT');\n    await marker(doneFile, { archive_sha256: input.archive_sha256, original_commit: input.original_commit, file_count: entries.length });\n    await auditEvent(audit, { event: 'completed', file_count: entries.length, archive_sha256: input.archive_sha256 });\n    return { success: true, project_path: target, archive_sha256: input.archive_sha256, original_commit: input.original_commit,\n      detached_head: true, restored_files: entries.length, audit_path: audit, residue_path: plan.residue,\n      state: { ...ready.state, projectPath: target }, old_git_metadata_restored: false };\n  } finally { await fs.unlink(lock); }\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\recovery\\RecoverySubsystem.test.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'projectPath' is defined but never used. Allowed unused args must match /^_/u.","line":21,"column":28,"nodeType":"Identifier","messageId":"unusedVar","endLine":21,"endColumn":39},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `os.tmpdir(),·`specforge-test-recovery-${Date.now()}-${Math.random().toString(36).slice(2)}`` with `⏎······os.tmpdir(),⏎······`specforge-test-recovery-${Date.now()}-${Math.random().toString(36).slice(2)}`⏎····`","line":67,"column":24,"nodeType":null,"messageId":"replace","endLine":67,"endColumn":115,"fix":{"range":[2036,2127],"text":"\n      os.tmpdir(),\n      `specforge-test-recovery-${Date.now()}-${Math.random().toString(36).slice(2)}`\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":89,"column":1,"nodeType":null,"messageId":"delete","endLine":89,"endColumn":5,"fix":{"range":[2768,2772],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":98,"column":1,"nodeType":null,"messageId":"delete","endLine":98,"endColumn":5,"fix":{"range":[3074,3078],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":105,"column":1,"nodeType":null,"messageId":"delete","endLine":105,"endColumn":5,"fix":{"range":[3321,3325],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":131,"column":1,"nodeType":null,"messageId":"delete","endLine":131,"endColumn":5,"fix":{"range":[4012,4016],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······path.dirname(statePath),⏎······'checkpoints',⏎······`${sessionId}.json`⏎····` with `path.dirname(statePath),·'checkpoints',·`${sessionId}.json``","line":148,"column":38,"nodeType":null,"messageId":"replace","endLine":152,"endColumn":5,"fix":{"range":[4612,4695],"text":"path.dirname(statePath), 'checkpoints', `${sessionId}.json`"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":173,"column":26,"nodeType":null,"messageId":"delete","endLine":173,"endColumn":27,"fix":{"range":[5545,5546],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":183,"column":86,"nodeType":null,"messageId":"delete","endLine":183,"endColumn":87,"fix":{"range":[5993,5994],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······path.join(expectedDaemonRt,·'events.jsonl')⏎····` with `path.join(expectedDaemonRt,·'events.jsonl')`","line":236,"column":50,"nodeType":null,"messageId":"replace","endLine":238,"endColumn":5,"fix":{"range":[8167,8222],"text":"path.join(expectedDaemonRt, 'events.jsonl')"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······path.join(expectedDaemonRt,·'state.json')⏎····` with `path.join(expectedDaemonRt,·'state.json')`","line":239,"column":49,"nodeType":null,"messageId":"replace","endLine":241,"endColumn":5,"fix":{"range":[8273,8326],"text":"path.join(expectedDaemonRt, 'state.json')"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······path.join(expectedProjectRt,·'events.jsonl')⏎····` with `path.join(expectedProjectRt,·'events.jsonl')`","line":247,"column":44,"nodeType":null,"messageId":"replace","endLine":249,"endColumn":5,"fix":{"range":[8626,8682],"text":"path.join(expectedProjectRt, 'events.jsonl')"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······path.join(expectedProjectRt,·'state.json')⏎····` with `path.join(expectedProjectRt,·'state.json')`","line":250,"column":43,"nodeType":null,"messageId":"replace","endLine":252,"endColumn":5,"fix":{"range":[8727,8781],"text":"path.join(expectedProjectRt, 'state.json')"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":295,"column":23,"nodeType":null,"messageId":"delete","endLine":295,"endColumn":24,"fix":{"range":[10245,10246],"text":""}},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'state' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":298,"column":11,"nodeType":"Identifier","messageId":"unusedVar","endLine":298,"endColumn":16},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `{·type:·'state_mismatch',·description:·'test',·affectedEventId:·'ev-1',·affectedProjectPath:·testProjectPath·}` with `⏎········{⏎··········type:·'state_mismatch',⏎··········description:·'test',⏎··········affectedEventId:·'ev-1',⏎··········affectedProjectPath:·testProjectPath,⏎········},⏎······`","line":312,"column":16,"nodeType":null,"messageId":"replace","endLine":312,"endColumn":126,"fix":{"range":[10692,10802],"text":"\n        {\n          type: 'state_mismatch',\n          description: 'test',\n          affectedEventId: 'ev-1',\n          affectedProjectPath: testProjectPath,\n        },\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `{·type:·'state_mismatch',·description:·'test',·affectedEventId:·'ev-1',·affectedProjectPath:·testProjectPath·}` with `⏎········{⏎··········type:·'state_mismatch',⏎··········description:·'test',⏎··········affectedEventId:·'ev-1',⏎··········affectedProjectPath:·testProjectPath,⏎········},⏎······`","line":328,"column":16,"nodeType":null,"messageId":"replace","endLine":328,"endColumn":126,"fix":{"range":[11537,11647],"text":"\n        {\n          type: 'state_mismatch',\n          description: 'test',\n          affectedEventId: 'ev-1',\n          affectedProjectPath: testProjectPath,\n        },\n      "}}],"suppressedMessages":[],"errorCount":17,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":15,"fixableWarningCount":0,"source":"/**\n * Recovery Subsystem unit tests\n */\n\nimport { describe, it, expect, beforeEach, afterEach, vi } from 'vitest';\nimport { RecoverySubsystem } from './RecoverySubsystem';\nimport { IPathResolver } from '../daemon/path-resolver';\nimport { WAL } from '../wal';\nimport { StateManager } from '../state/StateManager';\nimport * as fs from 'fs/promises';\nimport * as path from 'path';\nimport * as os from 'os';\n\n/**\n * In-memory mock IPathResolver that uses a temporary directory so tests\n * don't pollute ~/.specforge.\n */\nclass MockPathResolver implements IPathResolver {\n  constructor(private tmpDir: string) {}\n\n  resolveProjectRuntimeDir(projectPath: string): string {\n    return path.join(this.tmpDir, 'projects', 'mock-project', '.specforge', 'runtime');\n  }\n\n  resolveStatePath(projectPath: string): string {\n    return path.join(this.resolveProjectRuntimeDir(projectPath), 'state.json');\n  }\n\n  resolveEventsPath(projectPath: string): string {\n    return path.join(this.resolveProjectRuntimeDir(projectPath), 'events.jsonl');\n  }\n\n  resolveSessionsDir(projectPath: string): string {\n    return path.join(this.resolveProjectRuntimeDir(projectPath), 'sessions');\n  }\n\n  resolveDaemonRuntimeDir(): string {\n    return path.join(os.homedir(), '.specforge', 'runtime');\n  }\n\n  resolveHandshakePath(): string {\n    return path.join(this.resolveDaemonRuntimeDir(), 'handshake.json');\n  }\n\n  resolveDaemonJsonPath(): string {\n    return path.join(os.homedir(), '.config', 'opencode', 'daemon.json');\n  }\n\n  resolveDaemonStatePath(): string {\n    return path.join(this.resolveDaemonRuntimeDir(), 'state.json');\n  }\n\n  resolveDaemonEventsPath(): string {\n    return path.join(this.resolveDaemonRuntimeDir(), 'events.jsonl');\n  }\n}\n\ndescribe('RecoverySubsystem', () => {\n  let subsystem: RecoverySubsystem;\n  let testProjectPath: string;\n  let mockResolver: MockPathResolver;\n  let tmpDir: string;\n\n  beforeEach(() => {\n    testProjectPath = 'test-project-path-recovery';\n    // Use os.tmpdir() for cross-platform safety\n    tmpDir = path.join(os.tmpdir(), `specforge-test-recovery-${Date.now()}-${Math.random().toString(36).slice(2)}`);\n    mockResolver = new MockPathResolver(tmpDir);\n    subsystem = new RecoverySubsystem(mockResolver, testProjectPath);\n  });\n\n  afterEach(async () => {\n    // Cleanup: remove the entire temp directory\n    try {\n      await fs.rm(tmpDir, { recursive: true, force: true });\n    } catch {\n      // best-effort cleanup\n    }\n  });\n\n  it('should initialize', async () => {\n    await subsystem.initialize();\n    expect(subsystem.getEventsPath()).toContain('events.jsonl');\n    expect(subsystem.getStatePath()).toContain('state.json');\n  });\n\n  it('should check consistency', async () => {\n    const result = await subsystem.checkConsistency();\n    \n    expect(result).toBeDefined();\n    expect(result.isValid).toBeDefined();\n    expect(result.issues).toBeDefined();\n  });\n\n  it('should repair inconsistencies', async () => {\n    const result = await subsystem.checkConsistency();\n    const repairResult = await subsystem.repairInconsistency(result);\n    \n    expect(repairResult.success).toBe(true);\n    expect(repairResult.repairEvents).toBeDefined();\n  });\n\n  it('should attempt session reconnection', async () => {\n    const result = await subsystem.attemptSessionReconnect('test-session-id');\n    \n    // Currently returns false (placeholder implementation)\n    expect(result).toBe(false);\n  });\n\n  it('should rebuild state from events', async () => {\n    const events = [\n      {\n        eventId: 'event-1',\n        ts: 1000,\n        projectId: testProjectPath,\n        action: 'test.event',\n        payload: {},\n        metadata: { schemaVersion: '1.0', source: 'daemon' as const },\n      },\n      {\n        eventId: 'event-2',\n        ts: 2000,\n        projectId: testProjectPath,\n        action: 'test.event',\n        payload: {},\n        metadata: { schemaVersion: '1.0', source: 'daemon' as const },\n      },\n    ];\n\n    const state = await subsystem.rebuildFromEvents(events);\n    \n    expect(state.projectPath).toBe(testProjectPath);\n    expect(state.lastEventId).toBe('event-2');\n    expect(state.lastEventTs).toBe(2000);\n  });\n\n  it('should save checkpoint successfully and verify file content', async () => {\n    const sessionId = 'test-session-001';\n    const snapshotData = {\n      context: { lastEventId: 'event-2' },\n      sessions: ['active-1'],\n    };\n\n    await subsystem.saveCheckpoint(sessionId, snapshotData);\n\n    // Verify the checkpoint file was created with correct content\n    const statePath = subsystem.getStatePath();\n    const checkpointPath = path.join(\n      path.dirname(statePath),\n      'checkpoints',\n      `${sessionId}.json`\n    );\n\n    const raw = await fs.readFile(checkpointPath, 'utf-8');\n    const parsed = JSON.parse(raw);\n\n    expect(parsed).toEqual(snapshotData);\n  });\n\n  it('should bind an unbound daemon checkpoint to the explicit project path', async () => {\n    const coordinator = new RecoverySubsystem(mockResolver);\n    const resolveProjectRuntimeDir = vi.spyOn(mockResolver, 'resolveProjectRuntimeDir');\n    const sessionId = 'project-bound-session';\n    const projectPath = path.join(tmpDir, 'actual-project');\n    const snapshotData = { checkpoint: 'project-bound' };\n\n    await coordinator.saveCheckpoint(sessionId, snapshotData, projectPath);\n\n    expect(resolveProjectRuntimeDir).toHaveBeenCalledWith(projectPath);\n    const checkpointPath = path.join(\n      mockResolver.resolveProjectRuntimeDir(projectPath),\n      'checkpoints',\n      `${sessionId}.json`,\n    );\n    expect(JSON.parse(await fs.readFile(checkpointPath, 'utf-8'))).toEqual(snapshotData);\n  });\n\n  it('should refuse an unbound daemon checkpoint without a project path', async () => {\n    const coordinator = new RecoverySubsystem(mockResolver);\n    const resolveProjectRuntimeDir = vi.spyOn(mockResolver, 'resolveProjectRuntimeDir');\n\n    await expect(\n      coordinator.saveCheckpoint('unbound-session', { checkpoint: 'must-not-write' }),\n    ).resolves.toBeUndefined();\n\n    expect(resolveProjectRuntimeDir).not.toHaveBeenCalled();\n  });\n\n  it('should keep daemon coordinator state storage unbound', () => {\n    const coordinator = new RecoverySubsystem(mockResolver);\n\n    expect(() => coordinator.getEventsPath()).toThrow('not bound');\n    expect(() => coordinator.getStatePath()).toThrow('not bound');\n  });\n\n  it('should not throw on saveCheckpoint write failure', async () => {\n    // Create an invalid statePath that cannot be written (use a path with\n    // a file where a directory should be — but simpler: use null byte trick).\n    // Actually, the simplest way: fill snapshotData with a circular reference\n    // so JSON.stringify throws. But wait, we want to test that *write*\n    // failure doesn't throw — better to construct a scenario where the path\n    // is unwritable. The easiest cross-platform approach: make the dir\n    // read-only or point to a path inside a non-existent root.\n    //\n    // Since the mock controls the path, we can create a file where the\n    // checkpoint directory should be, causing mkdir to fail.\n    const statePath = subsystem.getStatePath();\n    const checkpointDir = path.join(path.dirname(statePath), 'checkpoints');\n\n    // Create a *file* at the checkpointDir path so mkdir fails\n    await fs.mkdir(path.dirname(checkpointDir), { recursive: true });\n    await fs.writeFile(checkpointDir, 'blocking-file');\n\n    // Should not throw — error should be caught and logged\n    await expect(\n      subsystem.saveCheckpoint('blocked-session', { data: 'test' })\n    ).resolves.toBeUndefined();\n\n    // Cleanup the blocking file\n    await fs.unlink(checkpointDir);\n  });\n\n  // ── daemon-global path mode ──────────────────────────────────────\n\n  it('should use daemon-global paths when wal and stateManager are injected', () => {\n    const fakeWal = {} as WAL;\n    const fakeStateManager = {} as StateManager;\n    const daemonSubsystem = new RecoverySubsystem(\n      mockResolver,\n      testProjectPath,\n      fakeWal,\n      fakeStateManager\n    );\n\n    const expectedDaemonRt = mockResolver.resolveDaemonRuntimeDir();\n    expect(daemonSubsystem.getEventsPath()).toBe(\n      path.join(expectedDaemonRt, 'events.jsonl')\n    );\n    expect(daemonSubsystem.getStatePath()).toBe(\n      path.join(expectedDaemonRt, 'state.json')\n    );\n  });\n\n  it('should use project-level paths when wal/stateManager are not injected (legacy)', () => {\n    // subsystem from beforeEach has no injected wal/stateManager\n    const expectedProjectRt = mockResolver.resolveProjectRuntimeDir(testProjectPath);\n    expect(subsystem.getEventsPath()).toBe(\n      path.join(expectedProjectRt, 'events.jsonl')\n    );\n    expect(subsystem.getStatePath()).toBe(\n      path.join(expectedProjectRt, 'state.json')\n    );\n  });\n\n  // ── writeState delegation ────────────────────────────────────────\n\n  it('should delegate writeState to StateManager.persistStateFromExternal when stateManager exists', async () => {\n    const mockPersist = vi.fn().mockResolvedValue(undefined);\n    const mockRebuildState = vi.fn().mockResolvedValue({\n      stateVersion: 0,\n      projectPath: testProjectPath,\n      schemaVersion: '1.0',\n      activeSessions: [],\n      workItems: [],\n      lastEventId: '',\n      lastEventTs: 0,\n    });\n    const mockStateManager = {\n      rebuildState: mockRebuildState,\n      persistStateFromExternal: mockPersist,\n    } as unknown as StateManager;\n    const mockAppendEvent = vi.fn().mockResolvedValue(undefined);\n    const repairEvent = {\n      schema_version: '1.0' as const,\n      eventId: 'repair-event-1',\n      ts: 1234,\n      monotonicSeq: 1,\n      projectId: testProjectPath,\n      actor: 'recovery-subsystem',\n      category: 'system',\n      action: 'recovery.repaired',\n      payload: { issueType: 'state_mismatch', description: 'test' },\n      metadata: { schemaVersion: '1.0', source: 'daemon' as const },\n    };\n    const fakeWal = {\n      readAllEvents: vi.fn().mockResolvedValue({ events: [] }),\n      createEvent: vi.fn().mockReturnValue(repairEvent),\n      appendEvent: mockAppendEvent,\n    } as unknown as WAL;\n\n    const daemonSubsystem = new RecoverySubsystem(\n      mockResolver,\n      testProjectPath,\n      fakeWal,\n      mockStateManager,\n    );\n\n    const state = {\n      stateVersion: 0,\n      projectPath: testProjectPath,\n      schemaVersion: '1.0',\n      activeSessions: [],\n      workItems: [],\n      lastEventId: '',\n      lastEventTs: 0,\n    };\n\n    // Call repairInconsistency — this internally calls writeState with the repaired state\n    // We need a result with issues to trigger repair\n    await daemonSubsystem.repairInconsistency({\n      isValid: false,\n      issues: [{ type: 'state_mismatch', description: 'test', affectedEventId: 'ev-1', affectedProjectPath: testProjectPath }],\n    });\n\n    expect(mockAppendEvent).toHaveBeenCalledOnce();\n    expect(mockAppendEvent).toHaveBeenCalledWith(repairEvent);\n    // persistStateFromExternal should have been called exactly once with a state containing our projectPath\n    expect(mockPersist).toHaveBeenCalledTimes(1);\n    const calledState = mockPersist.mock.calls[0][0];\n    expect(calledState.projectPath).toBe(testProjectPath);\n  });\n\n  it('should use direct fs.writeFile when stateManager is absent (legacy fallback)', async () => {\n    // subsystem from beforeEach (no stateManager) — call repairInconsistency\n    // which internally calls writeState -> the legacy fs.writeFile path\n    await subsystem.repairInconsistency({\n      isValid: false,\n      issues: [{ type: 'state_mismatch', description: 'test', affectedEventId: 'ev-1', affectedProjectPath: testProjectPath }],\n    });\n\n    // Verify the state.json file was actually written (legacy path)\n    const statePath = subsystem.getStatePath();\n    const raw = await fs.readFile(statePath, 'utf-8');\n    const parsed = JSON.parse(raw);\n    expect(parsed.projectPath).toBe(testProjectPath);\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\recovery\\RecoverySubsystem.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":3,"column":3,"nodeType":null,"messageId":"delete","endLine":3,"endColumn":4,"fix":{"range":[43,44],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":6,"column":3,"nodeType":null,"messageId":"delete","endLine":6,"endColumn":4,"fix":{"range":[166,167],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":12,"column":3,"nodeType":null,"messageId":"delete","endLine":12,"endColumn":4,"fix":{"range":[522,523],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·Event,·ProjectState,·ConsistencyCheckResult,·ConsistencyIssue,·RepairResult·` with `⏎··Event,⏎··ProjectState,⏎··ConsistencyCheckResult,⏎··ConsistencyIssue,⏎··RepairResult,⏎`","line":21,"column":9,"nodeType":null,"messageId":"replace","endLine":21,"endColumn":86,"fix":{"range":[899,976],"text":"\n  Event,\n  ProjectState,\n  ConsistencyCheckResult,\n  ConsistencyIssue,\n  RepairResult,\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·restoreProjectArchive,·projectPathIdentity,·type·ProjectArchiveRestoreInput·` with `⏎··restoreProjectArchive,⏎··projectPathIdentity,⏎··type·ProjectArchiveRestoreInput,⏎`","line":26,"column":9,"nodeType":null,"messageId":"replace","endLine":26,"endColumn":86,"fix":{"range":[1206,1283],"text":"\n  restoreProjectArchive,\n  projectPathIdentity,\n  type ProjectArchiveRestoreInput,\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎······`","line":42,"column":9,"nodeType":null,"messageId":"insert","endLine":42,"endColumn":9,"fix":{"range":[1753,1753],"text":"\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `······` with `········`","line":43,"column":1,"nodeType":null,"messageId":"replace","endLine":43,"endColumn":7,"fix":{"range":[1808,1814],"text":"        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":44,"column":1,"nodeType":null,"messageId":"insert","endLine":44,"endColumn":1,"fix":{"range":[1885,1885],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `}))` with `··})⏎····)⏎·····`","line":45,"column":5,"nodeType":null,"messageId":"replace","endLine":45,"endColumn":8,"fix":{"range":[1983,1986],"text":"  })\n    )\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":53,"column":1,"nodeType":null,"messageId":"delete","endLine":53,"endColumn":3,"fix":{"range":[2273,2275],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `pathResolver:·IPathResolver,·projectPath?:·string,·wal?:·WAL,·stateManager?:·StateManager,·sessionRegistry?:·SessionRegistry` with `⏎····pathResolver:·IPathResolver,⏎····projectPath?:·string,⏎····wal?:·WAL,⏎····stateManager?:·StateManager,⏎····sessionRegistry?:·SessionRegistry⏎··`","line":64,"column":15,"nodeType":null,"messageId":"replace","endLine":64,"endColumn":139,"fix":{"range":[2635,2759],"text":"\n    pathResolver: IPathResolver,\n    projectPath?: string,\n    wal?: WAL,\n    stateManager?: StateManager,\n    sessionRegistry?: SessionRegistry\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":111,"column":5,"nodeType":null,"messageId":"delete","endLine":111,"endColumn":6,"fix":{"range":[4259,4260],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `e·=>`","line":130,"column":43,"nodeType":null,"messageId":"delete","endLine":130,"endColumn":47,"fix":{"range":[4901,4905],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `.category·===·'session'·||⏎·······` with `·=>·e.category·===·'session'·||`","line":131,"column":10,"nodeType":null,"messageId":"replace","endLine":132,"endColumn":8,"fix":{"range":[4915,4949],"text":" => e.category === 'session' ||"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace ``[RecoverySubsystem]·Session·replay:·${summary.replayedCount}·events·replayed,·${summary.restoredBindings}·bindings·restored,·${summary.restoredAliases}·aliases·restored`` with `⏎··········`[RecoverySubsystem]·Session·replay:·${summary.replayedCount}·events·replayed,·${summary.restoredBindings}·bindings·restored,·${summary.restoredAliases}·aliases·restored`⏎········`","line":136,"column":21,"nodeType":null,"messageId":"replace","endLine":136,"endColumn":191,"fix":{"range":[5148,5318],"text":"\n          `[RecoverySubsystem] Session replay: ${summary.replayedCount} events replayed, ${summary.restoredBindings} bindings restored, ${summary.restoredAliases} aliases restored`\n        "}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":143,"column":25,"nodeType":"TSNonNullExpression","messageId":"unnecessaryAssertion","endLine":143,"endColumn":51,"fix":{"range":[5458,5459],"text":""}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":154,"column":27,"nodeType":"TSNonNullExpression","messageId":"unnecessaryAssertion","endLine":154,"endColumn":41,"fix":{"range":[5903,5904],"text":""}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":155,"column":27,"nodeType":"TSNonNullExpression","messageId":"unnecessaryAssertion","endLine":155,"endColumn":37,"fix":{"range":[5941,5942],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":191,"column":5,"nodeType":null,"messageId":"delete","endLine":191,"endColumn":6,"fix":{"range":[6968,6969],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":199,"column":1,"nodeType":null,"messageId":"delete","endLine":199,"endColumn":5,"fix":{"range":[7313,7317],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `······`","line":203,"column":1,"nodeType":null,"messageId":"delete","endLine":203,"endColumn":7,"fix":{"range":[7395,7401],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `······`","line":206,"column":1,"nodeType":null,"messageId":"delete","endLine":206,"endColumn":7,"fix":{"range":[7466,7472],"text":""}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":209,"column":27,"nodeType":"TSNonNullExpression","messageId":"unnecessaryAssertion","endLine":209,"endColumn":53,"fix":{"range":[7637,7638],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `········`","line":218,"column":1,"nodeType":null,"messageId":"delete","endLine":218,"endColumn":9,"fix":{"range":[7996,8004],"text":""}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":221,"column":29,"nodeType":"TSNonNullExpression","messageId":"unnecessaryAssertion","endLine":221,"endColumn":43,"fix":{"range":[8154,8155],"text":""}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":222,"column":29,"nodeType":"TSNonNullExpression","messageId":"unnecessaryAssertion","endLine":222,"endColumn":39,"fix":{"range":[8194,8195],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `······`","line":233,"column":1,"nodeType":null,"messageId":"delete","endLine":233,"endColumn":7,"fix":{"range":[8539,8545],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··⏎····`","line":244,"column":5,"nodeType":null,"messageId":"delete","endLine":245,"endColumn":5,"fix":{"range":[9019,9026],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":259,"column":5,"nodeType":null,"messageId":"delete","endLine":259,"endColumn":6,"fix":{"range":[9411,9412],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":264,"column":5,"nodeType":null,"messageId":"delete","endLine":264,"endColumn":6,"fix":{"range":[9599,9600],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":271,"column":1,"nodeType":null,"messageId":"delete","endLine":271,"endColumn":5,"fix":{"range":[9944,9948],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `wal,·'state_mismatch',·`Rebuilt·state·from·${events.length}·events`);` with `⏎··········wal,⏎··········'state_mismatch',⏎··········`Rebuilt·state·from·${events.length}·events``","line":310,"column":39,"nodeType":null,"messageId":"replace","endLine":310,"endColumn":108,"fix":{"range":[11191,11260],"text":"\n          wal,\n          'state_mismatch',\n          `Rebuilt state from ${events.length} events`"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `);⏎`","line":311,"column":9,"nodeType":null,"messageId":"insert","endLine":311,"endColumn":9,"fix":{"range":[11269,11269],"text":");\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `wal,·'missing_event',·`Removed·stale·reference·to·${issue.affectedEventId}`);` with `⏎··········wal,⏎··········'missing_event',⏎··········`Removed·stale·reference·to·${issue.affectedEventId}``","line":314,"column":39,"nodeType":null,"messageId":"replace","endLine":314,"endColumn":116,"fix":{"range":[11408,11485],"text":"\n          wal,\n          'missing_event',\n          `Removed stale reference to ${issue.affectedEventId}`"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `);⏎`","line":315,"column":9,"nodeType":null,"messageId":"insert","endLine":315,"endColumn":9,"fix":{"range":[11494,11494],"text":");\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `········`","line":319,"column":1,"nodeType":null,"messageId":"delete","endLine":319,"endColumn":9,"fix":{"range":[11663,11671],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":337,"column":27,"nodeType":null,"messageId":"delete","endLine":337,"endColumn":28,"fix":{"range":[12023,12024],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":373,"column":5,"nodeType":null,"messageId":"delete","endLine":373,"endColumn":6,"fix":{"range":[13023,13024],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":376,"column":5,"nodeType":null,"messageId":"delete","endLine":376,"endColumn":6,"fix":{"range":[13245,13246],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":386,"column":1,"nodeType":null,"messageId":"delete","endLine":386,"endColumn":5,"fix":{"range":[13655,13659],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":387,"column":74,"nodeType":null,"messageId":"delete","endLine":387,"endColumn":75,"fix":{"range":[13733,13734],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":400,"column":1,"nodeType":null,"messageId":"delete","endLine":400,"endColumn":5,"fix":{"range":[14227,14231],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·e.action·===·'session.activated'·&&·e.payload·&&·⏎···········` with `⏎········e.action·===·'session.activated'·&&·e.payload·&&·`","line":403,"column":11,"nodeType":null,"messageId":"replace","endLine":404,"endColumn":12,"fix":{"range":[14324,14386],"text":"\n        e.action === 'session.activated' && e.payload && "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":406,"column":1,"nodeType":null,"messageId":"delete","endLine":406,"endColumn":5,"fix":{"range":[14436,14440],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":415,"column":1,"nodeType":null,"messageId":"delete","endLine":415,"endColumn":5,"fix":{"range":[14627,14631],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······statePath,⏎······JSON.stringify(serializeRuntimeCheckpoint(state),·null,·2),⏎····` with `statePath,·JSON.stringify(serializeRuntimeCheckpoint(state),·null,·2)`","line":514,"column":24,"nodeType":null,"messageId":"replace","endLine":517,"endColumn":5,"fix":{"range":[17245,17333],"text":"statePath, JSON.stringify(serializeRuntimeCheckpoint(state), null, 2)"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":518,"column":1,"nodeType":null,"messageId":"delete","endLine":518,"endColumn":5,"fix":{"range":[17336,17340],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":541,"column":25,"nodeType":null,"messageId":"delete","endLine":541,"endColumn":26,"fix":{"range":[17993,17994],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":547,"column":97,"nodeType":null,"messageId":"delete","endLine":547,"endColumn":98,"fix":{"range":[18250,18251],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":554,"column":22,"nodeType":null,"messageId":"delete","endLine":554,"endColumn":23,"fix":{"range":[18423,18424],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace ``[RecoverySubsystem]·Failed·to·save·checkpoint·for·session·${sessionId}:`,·error` with `⏎········`[RecoverySubsystem]·Failed·to·save·checkpoint·for·session·${sessionId}:`,⏎········error⏎······`","line":569,"column":21,"nodeType":null,"messageId":"replace","endLine":569,"endColumn":101,"fix":{"range":[18883,18963],"text":"\n        `[RecoverySubsystem] Failed to save checkpoint for session ${sessionId}:`,\n        error\n      "}}],"suppressedMessages":[],"errorCount":51,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":51,"fixableWarningCount":0,"source":"/**\n * Recovery Subsystem implementation\n * \n * Detects and repairs state inconsistencies, implements predefined\n * repair rules, and handles session reconnection.\n * \n * Property 20: Recovery Consistency Repair\n * For all inconsistent (events.jsonl, state.json) combinations detected at startup,\n * the Recovery subsystem must roll back to a consistent snapshot s' according to\n * predefined repair rules, and write a recovery.repaired event recording the repair\n * path; after repair, rebuild(events) == s' must hold.\n * \n * Property 21: Session WAL Replay Scope\n * For all Daemon runtime event streams, WAL-replay-based session state reconstruction\n * may only occur within the Daemon startup process; after startup completes, the\n * Daemon must not automatically initiate session state reconstruction via WAL replay.\n */\n\nimport * as fs from 'fs/promises';\nimport * as path from 'path';\nimport { Event, ProjectState, ConsistencyCheckResult, ConsistencyIssue, RepairResult } from '../types';\nimport { WAL } from '../wal';\nimport { StateManager } from '../state/StateManager';\nimport { IPathResolver } from '../daemon/path-resolver';\nimport { SessionRegistry } from '../session/SessionRegistry';\nimport { restoreProjectArchive, projectPathIdentity, type ProjectArchiveRestoreInput } from './ProjectArchiveRestore';\nimport {\n  deserializeRuntimeCheckpoint,\n  serializeRuntimeCheckpoint,\n} from '../state/runtime-schema-descriptors';\n\nexport interface SessionReconnectResult {\n  success: boolean;\n  sessionId: string;\n  reconnected: boolean;\n  reason?: string;\n}\n\nexport class RecoverySubsystem {\n  /** Operator-only project import; does not create or transition Work Items. */\n  async restoreProjectArchive(input: ProjectArchiveRestoreInput) {\n    if (this.sessionRegistry?.listSessions().some(session => {\n      const bound = this.sessionRegistry!.getProjectPath(session.sessionId);\n      return bound && projectPathIdentity(bound) === projectPathIdentity(input.project_path);\n    })) throw new Error('ARCHIVE_RECOVERY_ACTIVE_SESSION');\n    return restoreProjectArchive(this.pathResolver, input);\n  }\n  private pathResolver: IPathResolver;\n  private projectPath: string;\n  private eventsPath: string;\n  private statePath: string;\n  private schemaVersion: string = '1.0';\n  \n  private _isReady: boolean = false;\n\n  // Property 21: Track startup phase to limit WAL replay session reconstruction\n  private isInStartupPhase: boolean = false;\n  private hasStartupCompleted: boolean = false;\n\n  private wal: WAL | null = null;\n  private stateManager: StateManager | null = null;\n  private sessionRegistry?: SessionRegistry;\n\n  constructor(pathResolver: IPathResolver, projectPath?: string, wal?: WAL, stateManager?: StateManager, sessionRegistry?: SessionRegistry) {\n    this.pathResolver = pathResolver;\n    this.projectPath = projectPath ?? '';\n    this.wal = wal ?? null;\n    this.stateManager = stateManager ?? null;\n    this.sessionRegistry = sessionRegistry;\n\n    // Recovery state has two supported scopes:\n    // 1. Injected WAL + StateManager: daemon-global recovery state.\n    // 2. Explicit projectPath: project-scoped recovery state.\n    // A shared daemon may also use this subsystem only as a startup/checkpoint\n    // coordinator. In that mode no fake project path is assigned.\n    if (this.wal && this.stateManager) {\n      this.eventsPath = this.pathResolver.resolveDaemonEventsPath();\n      this.statePath = this.pathResolver.resolveDaemonStatePath();\n    } else if (projectPath) {\n      this.eventsPath = this.pathResolver.resolveEventsPath(projectPath);\n      this.statePath = this.pathResolver.resolveStatePath(projectPath);\n    } else {\n      this.eventsPath = '';\n      this.statePath = '';\n    }\n  }\n\n  /**\n   * Get events path\n   */\n  getEventsPath(): string {\n    if (!this.eventsPath) {\n      throw new Error('RecoverySubsystem is not bound to recovery event storage');\n    }\n    return this.eventsPath;\n  }\n\n  /**\n   * Get state path\n   */\n  getStatePath(): string {\n    if (!this.statePath) {\n      throw new Error('RecoverySubsystem is not bound to recovery state storage');\n    }\n    return this.statePath;\n  }\n\n  /**\n   * Check consistency and repair if needed\n   * Property 20: Validates that repair produces consistent state\n   * \n   * Uses WAL to read events, StateManager.rebuildState() to rebuild,\n   * then verifies consistency between events and the rebuilt state.\n   */\n  async checkAndRepair(): Promise<ConsistencyCheckResult> {\n    const { events } = this.wal\n      ? await this.wal.readAllEvents()\n      : { events: await this.loadEvents() };\n\n    let rebuiltState: ProjectState;\n\n    if (this.stateManager) {\n      rebuiltState = await this.stateManager.rebuildState();\n    } else {\n      rebuiltState = await this.rebuildFromEvents(events);\n    }\n\n    // Session replay from WAL events\n    if (this.sessionRegistry) {\n      const sessionEvents = events.filter(e =>\n        e.category === 'session' ||\n        (!e.category && e.action?.startsWith('session.'))\n      );\n      if (sessionEvents.length > 0) {\n        const summary = await this.sessionRegistry.startupReplay(sessionEvents);\n        console.log(`[RecoverySubsystem] Session replay: ${summary.replayedCount} events replayed, ${summary.restoredBindings} bindings restored, ${summary.restoredAliases} aliases restored`);\n      }\n    }\n\n    const issues: ConsistencyIssue[] = [];\n\n    if (events.length > 0) {\n      const lastEvent = events[events.length - 1]!;\n      if (rebuiltState.lastEventId !== lastEvent.eventId) {\n        issues.push({\n          type: 'state_mismatch',\n          description: `State lastEventId (${rebuiltState.lastEventId}) does not match last event (${lastEvent.eventId})`,\n          affectedEventId: lastEvent.eventId,\n          affectedProjectPath: this.projectPath,\n        });\n      }\n\n      for (let i = 1; i < events.length; i++) {\n        const prevEvent = events[i - 1]!;\n        const currEvent = events[i]!;\n        if (currEvent.ts < prevEvent.ts) {\n          issues.push({\n            type: 'out_of_order',\n            description: `Event at index ${i} has timestamp before previous event`,\n            affectedEventId: currEvent.eventId,\n            affectedProjectPath: this.projectPath,\n          });\n        }\n      }\n\n      const eventIds = new Set(events.map(e => e.eventId));\n      if (rebuiltState.lastEventId && !eventIds.has(rebuiltState.lastEventId)) {\n        issues.push({\n          type: 'missing_event',\n          description: `State references event ${rebuiltState.lastEventId} that doesn't exist in events`,\n          affectedEventId: rebuiltState.lastEventId,\n          affectedProjectPath: this.projectPath,\n        });\n      }\n    }\n\n    const result: ConsistencyCheckResult = {\n      isValid: issues.length === 0,\n      issues,\n    };\n\n    if (!result.isValid) {\n      await this.repairInconsistency(result);\n    }\n\n    return result;\n  }\n\n  /**\n   * Check consistency between events.jsonl and state.json\n   * \n   * Consistency rules:\n   * 1. state.json lastEventId must match the last event in events.jsonl\n   * 2. Every event in events.jsonl must have a corresponding state entry\n   * 3. Events must be in chronological order (monotonic ts)\n   */\n  async checkConsistency(): Promise<ConsistencyCheckResult> {\n    const issues: ConsistencyIssue[] = [];\n    \n    try {\n      // Load events\n      const events = await this.loadEvents();\n      \n      // Load state\n      const state = await this.loadState();\n      \n      // Check 1: State mismatch - state.json lastEventId should match last event\n      if (events.length > 0) {\n        const lastEvent = events[events.length - 1]!;\n        if (state.lastEventId !== lastEvent.eventId) {\n          issues.push({\n            type: 'state_mismatch',\n            description: `State lastEventId (${state.lastEventId}) does not match last event (${lastEvent.eventId})`,\n            affectedEventId: lastEvent.eventId,\n            affectedProjectPath: this.projectPath,\n          });\n        }\n        \n        // Check 3: Event ordering - ts must be monotonic\n        for (let i = 1; i < events.length; i++) {\n          const prevEvent = events[i - 1]!;\n          const currEvent = events[i]!;\n          if (currEvent.ts < prevEvent.ts) {\n            issues.push({\n              type: 'out_of_order',\n              description: `Event at index ${i} has timestamp before previous event`,\n              affectedEventId: currEvent.eventId,\n              affectedProjectPath: this.projectPath,\n            });\n          }\n        }\n      }\n      \n      // Check 2: Events without state - check for orphaned events\n      const eventIds = new Set(events.map(e => e.eventId));\n      if (state.lastEventId && !eventIds.has(state.lastEventId)) {\n        issues.push({\n          type: 'missing_event',\n          description: `State references event ${state.lastEventId} that doesn't exist in events.jsonl`,\n          affectedEventId: state.lastEventId,\n          affectedProjectPath: this.projectPath,\n        });\n      }\n      \n    } catch (error) {\n      // A missing checkpoint can be rebuilt. Missing/corrupt history must never\n      // be reported as a successful consistency check.\n      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;\n    }\n\n    return {\n      isValid: issues.length === 0,\n      issues,\n    };\n  }\n\n  /**\n   * Repair inconsistency according to predefined repair rules\n   * \n   * Repair rules:\n   * 1. state_mismatch: Rebuild state from events.jsonl\n   * 2. missing_event: Remove stale state reference\n   * 3. out_of_order: Reorder events and rebuild state\n   * \n   * Repair events are appended and fsynced through the Runtime WAL owner before\n   * the checkpoint is rebuilt. Therefore the repaired checkpoint includes the\n   * audit event and preserves rebuild(events) == s'.\n   */\n  async repairInconsistency(result: ConsistencyCheckResult): Promise<RepairResult> {\n    const repairEvents: Event[] = [];\n    \n    const runtimeWal = this.wal ?? new WAL(this.getEventsPath());\n    if (!this.wal) await runtimeWal.initialize();\n    const { events: originalEvents } = await runtimeWal.readAllEvents();\n    await this.rebuildFromEvents(originalEvents);\n\n    let repairedState: ProjectState;\n\n    for (const issue of result.issues) {\n      const repairEvent = this.applyRepairRule(issue, originalEvents, runtimeWal);\n      if (repairEvent) {\n        await runtimeWal.appendEvent(repairEvent);\n        repairEvents.push(repairEvent);\n      }\n    }\n\n    if (this.stateManager) {\n      repairedState = await this.stateManager.rebuildState();\n    } else {\n      const { events: repairedEvents } = await runtimeWal.readAllEvents();\n      repairedState = await this.rebuildFromEvents(repairedEvents);\n    }\n\n    await this.writeState(repairedState);\n\n    return {\n      success: true,\n      repairedState,\n      repairEvents,\n    };\n  }\n\n  /**\n   * Apply a specific repair rule based on issue type\n   */\n  private applyRepairRule(issue: ConsistencyIssue, events: Event[], wal: WAL): Event | null {\n    switch (issue.type) {\n      case 'state_mismatch':\n        // Rebuild state from events - this is the authoritative repair\n        return this.createRepairEvent(wal, 'state_mismatch', `Rebuilt state from ${events.length} events`);\n        \n      case 'missing_event':\n        // Remove stale state reference by rebuilding from valid events\n        return this.createRepairEvent(wal, 'missing_event', `Removed stale reference to ${issue.affectedEventId}`);\n        \n      case 'out_of_order':\n        // Events will be reordered during rebuild\n        return this.createRepairEvent(wal, 'out_of_order', 'Fixed event ordering issue');\n        \n      default:\n        return null;\n    }\n  }\n\n  /**\n   * Create a repair event\n   */\n  private createRepairEvent(wal: WAL, issueType: string, description: string): Event {\n    return wal.createEvent(\n      this.projectPath,\n      'system',\n      'recovery.repaired',\n      {\n        issueType,\n        description,\n      },\n      'recovery-subsystem',\n    );\n  }\n\n  /**\n   * Rebuild state from events (authoritative source of truth)\n   * This is the core of Property 20 - after repair, rebuild(events) == s'\n   */\n  async rebuildFromEvents(events: Event[]): Promise<ProjectState> {\n    if (!events || events.length === 0) {\n      return this.createEmptyState();\n    }\n\n    // Durable insertion order is authoritative. Reuse the task projection;\n    // recovery must not replace real work items with an empty array.\n    const owner = this.stateManager ?? new StateManager(this.pathResolver, this.projectPath);\n    return owner.rebuildFromEvents(events);\n  }\n\n  /**\n   * Create empty state\n   */\n  private createEmptyState(): ProjectState {\n    return {\n      stateVersion: 0,\n      projectPath: this.projectPath,\n      schemaVersion: this.schemaVersion,\n      activeSessions: [],\n      workItems: [],\n      lastEventId: '',\n      lastEventTs: 0,\n    };\n  }\n\n  /**\n   * Attempt session WAL replay reconstruction (only during startup - Property 21)\n   * \n   * Property 21: WAL replay session reconstruction may only occur within Daemon startup process.\n   * After startup completes, the Daemon must not automatically initiate session state reconstruction via WAL replay.\n   * \n   * @param sessionId Session ID to reconnect\n   * @returns true if reconnection was attempted and succeeded\n   */\n  async attemptSessionReconnect(sessionId: string): Promise<boolean> {\n    // Property 21: Only attempt WAL replay during startup phase\n    if (!this.isInStartupPhase || this.hasStartupCompleted) {\n      // Post-startup session detection doesn't trigger reconnection\n      return false;\n    }\n    \n    // Attempt to reconnect - in real implementation, this would check if \n    // the OpenCode process is still alive via some mechanism\n    const result = await this.performSessionReconnect(sessionId);\n    return result.reconnected;\n  }\n\n  /**\n   * Perform the actual session reconnection logic\n   * In a real implementation, this would communicate with the OpenCode process\n   */\n  private async performSessionReconnect(sessionId: string): Promise<SessionReconnectResult> {\n    // Load events to find session information\n    const events = await this.loadEvents();\n    \n    // Find the session activation event\n    const activationEvent = events.find(\n      e => e.action === 'session.activated' && e.payload && \n           (e.payload as any).sessionId === sessionId\n    );\n    \n    if (!activationEvent) {\n      return {\n        success: false,\n        sessionId,\n        reconnected: false,\n        reason: 'No activation event found for session',\n      };\n    }\n    \n    // In real implementation, we'd check if the OpenCode process is still alive\n    // For now, simulate successful reconnection during startup\n    return {\n      success: true,\n      sessionId,\n      reconnected: true,\n      reason: 'Session reconnected during startup',\n    };\n  }\n\n  /**\n   * Start the startup phase for session reconnection\n   * Called by Daemon at the beginning of startup\n   */\n  beginStartupPhase(): void {\n    this._isReady = false;\n    this.isInStartupPhase = true;\n    this.hasStartupCompleted = false;\n  }\n\n  /**\n   * End the startup phase - no more reconnection attempts allowed\n   * Called by Daemon after startup is complete\n   */\n  completeStartup(): void {\n    this.hasStartupCompleted = true;\n    this.isInStartupPhase = false;\n    this._isReady = true;\n  }\n\n  isReady(): boolean {\n    return this._isReady;\n  }\n\n  /**\n   * Check if we're currently in the startup phase\n   * Used for testing and verification\n   */\n  isStartupPhase(): boolean {\n    return this.isInStartupPhase;\n  }\n\n  /**\n   * Check if startup has completed\n   * Used for testing and verification\n   */\n  hasCompletedStartup(): boolean {\n    return this.hasStartupCompleted;\n  }\n\n  /**\n   * Get reconnection scope status\n   * Used for testing and verification of Property 21\n   */\n  getReconnectionScopeStatus(): {\n    isInStartupPhase: boolean;\n    hasStartupCompleted: boolean;\n    reconnectionAllowed: boolean;\n  } {\n    return {\n      isInStartupPhase: this.isInStartupPhase,\n      hasStartupCompleted: this.hasStartupCompleted,\n      reconnectionAllowed: this.isInStartupPhase && !this.hasStartupCompleted,\n    };\n  }\n\n  /**\n   * Load events from events.jsonl\n   */\n  async loadEvents(): Promise<Event[]> {\n    const { events } = await (this.wal ?? new WAL(this.getEventsPath())).readAllEvents();\n    await this.rebuildFromEvents(events);\n    return events;\n  }\n\n  /**\n   * Load state from state.json\n   */\n  async loadState(): Promise<ProjectState> {\n    try {\n      const content = await fs.readFile(this.getStatePath(), 'utf-8');\n      return deserializeRuntimeCheckpoint(JSON.parse(content) as unknown);\n    } catch (error) {\n      if ((error as NodeJS.ErrnoException).code === 'ENOENT') return this.createEmptyState();\n      throw error;\n    }\n  }\n\n  /**\n   * Write state to state.json\n   */\n  private async writeState(state: ProjectState): Promise<void> {\n    if (this.stateManager) {\n      await this.stateManager.persistStateFromExternal(state);\n      return;\n    }\n    const statePath = this.getStatePath();\n    await fs.mkdir(path.dirname(statePath), { recursive: true });\n    await fs.writeFile(\n      statePath,\n      JSON.stringify(serializeRuntimeCheckpoint(state), null, 2),\n    );\n    \n    // fsync to ensure durability\n    const handle = await fs.open(statePath, 'a');\n    try {\n      await handle.sync();\n    } finally {\n      await handle.close();\n    }\n  }\n\n  /**\n   * Save a session checkpoint snapshot.\n   *\n   * Checkpoints are always project-scoped. A shared daemon must provide the\n   * actual project path resolved from the session binding; daemon runtime is\n   * never accepted as a substitute project path.\n   *\n   * Write failures are logged at ERROR level but never thrown — they must not\n   * block session compaction.\n   */\n  async saveCheckpoint(\n    sessionId: string,\n    snapshotData: unknown,\n    projectPath?: string,\n  ): Promise<void> {\n    try {\n      const checkpointProjectPath = projectPath ?? this.projectPath;\n      if (!checkpointProjectPath) {\n        console.error(\n          `[RecoverySubsystem] Refusing checkpoint for session ${sessionId}: no project binding`,\n        );\n        return;\n      }\n\n      const checkpointDir = path.join(\n        this.pathResolver.resolveProjectRuntimeDir(checkpointProjectPath),\n        'checkpoints',\n      );\n      const checkpointPath = path.join(checkpointDir, `${sessionId}.json`);\n\n      await fs.mkdir(checkpointDir, { recursive: true });\n      await fs.writeFile(checkpointPath, JSON.stringify(snapshotData, null, 2));\n\n      // fsync to ensure durability\n      const handle = await fs.open(checkpointPath, 'a');\n      try {\n        await handle.sync();\n      } finally {\n        await handle.close();\n      }\n    } catch (error) {\n      console.error(`[RecoverySubsystem] Failed to save checkpoint for session ${sessionId}:`, error);\n    }\n  }\n\n  /**\n   * Initialize the recovery subsystem\n   */\n  async initialize(): Promise<void> {\n    await fs.mkdir(path.dirname(this.getEventsPath()), { recursive: true });\n    await fs.mkdir(path.dirname(this.getStatePath()), { recursive: true });\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\retry\\RetryCounter.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\retry\\index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\retry\\types.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\session\\AgentIdentity.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":3,"column":3,"nodeType":null,"messageId":"delete","endLine":3,"endColumn":4,"fix":{"range":[38,39],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":12,"column":3,"nodeType":null,"messageId":"delete","endLine":12,"endColumn":4,"fix":{"range":[270,271],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":21,"column":1,"nodeType":null,"messageId":"delete","endLine":21,"endColumn":3,"fix":{"range":[511,513],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":26,"column":1,"nodeType":null,"messageId":"delete","endLine":26,"endColumn":3,"fix":{"range":[608,610],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":31,"column":1,"nodeType":null,"messageId":"delete","endLine":31,"endColumn":3,"fix":{"range":[704,706],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":37,"column":1,"nodeType":null,"messageId":"delete","endLine":37,"endColumn":3,"fix":{"range":[829,831],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":42,"column":1,"nodeType":null,"messageId":"delete","endLine":42,"endColumn":3,"fix":{"range":[911,913],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":48,"column":1,"nodeType":null,"messageId":"delete","endLine":48,"endColumn":3,"fix":{"range":[1042,1044],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":54,"column":1,"nodeType":null,"messageId":"delete","endLine":54,"endColumn":3,"fix":{"range":[1171,1173],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":59,"column":1,"nodeType":null,"messageId":"delete","endLine":59,"endColumn":3,"fix":{"range":[1251,1253],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":64,"column":1,"nodeType":null,"messageId":"delete","endLine":64,"endColumn":3,"fix":{"range":[1337,1339],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":86,"column":1,"nodeType":null,"messageId":"delete","endLine":86,"endColumn":3,"fix":{"range":[1877,1879],"text":""}}],"suppressedMessages":[],"errorCount":12,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":12,"fixableWarningCount":0,"source":"/**\n * AgentIdentity data structure\n * \n * Represents an agent session's identity in the Session Registry.\n * Used for tracking sessions throughout their lifecycle (pending → active → history).\n */\n\nimport { v7 as uuidv7 } from 'uuid';\n\n/**\n * AgentIdentity interface\n * \n * Core identity structure for agent sessions.\n */\nexport interface AgentIdentity {\n  /**\n   * Unique session identifier (UUIDv7)\n   * This is the sole identity key - never change it throughout session lifecycle\n   */\n  sessionId: string;\n  \n  /**\n   * Agent role (e.g., \"sf-orchestrator\", \"sf-requirements\")\n   */\n  agentRole: string;\n  \n  /**\n   * Workflow role (e.g., \"requirements-phase-executor\")\n   */\n  workflowRole: string;\n  \n  /**\n   * Parent session ID for session tree support\n   * null for root sessions\n   */\n  parentSessionId: string | null;\n  \n  /**\n   * Work item ID this session is working on\n   */\n  workItemId: string;\n  \n  /**\n   * Project ID this session is associated with\n   * null if not yet bound to a project\n   */\n  projectId: string | null;\n  \n  /**\n   * Spawn intent ID from client\n   * Used for binding pending sessions to real sessions\n   */\n  spawnIntentId: string;\n  \n  /**\n   * Creation timestamp (Unix milliseconds)\n   */\n  createdAt: number;\n  \n  /**\n   * Last active timestamp (Unix milliseconds)\n   */\n  lastActiveAt: number;\n  \n  /**\n   * Session status\n   * - pending: Registered but not yet activated\n   * - active: Currently active session\n   * - history: Terminated session (moved here on termination)\n   */\n  status: 'pending' | 'active' | 'history';\n}\n\n/**\n * Create a new AgentIdentity in pending state\n */\nexport function createPendingIdentity(\n  agentRole: string,\n  workflowRole: string,\n  workItemId: string,\n  spawnIntentId: string,\n  parentSessionId: string | null = null,\n  projectId: string | null = null\n): AgentIdentity {\n  const now = Date.now();\n  \n  return {\n    sessionId: uuidv7(),\n    agentRole,\n    workflowRole,\n    parentSessionId,\n    workItemId,\n    projectId,\n    spawnIntentId,\n    createdAt: now,\n    lastActiveAt: now,\n    status: 'pending',\n  };\n}\n\n/**\n * Activate a pending session\n */\nexport function activateIdentity(identity: AgentIdentity): AgentIdentity {\n  return {\n    ...identity,\n    status: 'active' as const,\n    lastActiveAt: Date.now(),\n  };\n}\n\n/**\n * Terminate an active session and move to history\n */\nexport function terminateIdentity(identity: AgentIdentity): AgentIdentity {\n  return {\n    ...identity,\n    status: 'history' as const,\n    lastActiveAt: Date.now(),\n  };\n}\n\n/**\n * Update last active timestamp\n */\nexport function updateLastActive(identity: AgentIdentity): AgentIdentity {\n  return {\n    ...identity,\n    lastActiveAt: Date.now(),\n  };\n}\n\n/**\n * Check if two identities represent the same session\n * (by sessionId only, ignoring other fields)\n */\nexport function isSameSession(a: AgentIdentity, b: AgentIdentity): boolean {\n  return a.sessionId === b.sessionId;\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\session\\SessionRegistry.test.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":24,"column":1,"nodeType":null,"messageId":"delete","endLine":24,"endColumn":5,"fix":{"range":[607,611],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":44,"column":1,"nodeType":null,"messageId":"delete","endLine":44,"endColumn":5,"fix":{"range":[1291,1295],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":56,"column":1,"nodeType":null,"messageId":"delete","endLine":56,"endColumn":5,"fix":{"range":[1610,1614],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":58,"column":1,"nodeType":null,"messageId":"delete","endLine":58,"endColumn":5,"fix":{"range":[1697,1701],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":73,"column":1,"nodeType":null,"messageId":"delete","endLine":73,"endColumn":5,"fix":{"range":[2191,2195],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":75,"column":1,"nodeType":null,"messageId":"delete","endLine":75,"endColumn":5,"fix":{"range":[2275,2279],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":92,"column":1,"nodeType":null,"messageId":"delete","endLine":92,"endColumn":5,"fix":{"range":[2835,2839],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":94,"column":1,"nodeType":null,"messageId":"delete","endLine":94,"endColumn":5,"fix":{"range":[2906,2910],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":114,"column":1,"nodeType":null,"messageId":"delete","endLine":114,"endColumn":5,"fix":{"range":[3543,3547],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":116,"column":1,"nodeType":null,"messageId":"delete","endLine":116,"endColumn":5,"fix":{"range":[3619,3623],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":138,"column":1,"nodeType":null,"messageId":"delete","endLine":138,"endColumn":5,"fix":{"range":[4438,4442],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":141,"column":1,"nodeType":null,"messageId":"delete","endLine":141,"endColumn":5,"fix":{"range":[4551,4555],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":143,"column":1,"nodeType":null,"messageId":"delete","endLine":143,"endColumn":5,"fix":{"range":[4620,4624],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":151,"column":1,"nodeType":null,"messageId":"delete","endLine":151,"endColumn":5,"fix":{"range":[4859,4863],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":164,"column":1,"nodeType":null,"messageId":"delete","endLine":164,"endColumn":5,"fix":{"range":[5152,5156],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":166,"column":1,"nodeType":null,"messageId":"delete","endLine":166,"endColumn":5,"fix":{"range":[5198,5202],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":175,"column":1,"nodeType":null,"messageId":"delete","endLine":175,"endColumn":5,"fix":{"range":[5457,5461],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":189,"column":1,"nodeType":null,"messageId":"delete","endLine":189,"endColumn":5,"fix":{"range":[5785,5789],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":192,"column":1,"nodeType":null,"messageId":"delete","endLine":192,"endColumn":5,"fix":{"range":[5915,5919],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'Active·sessions:',·activeSessions.map(s·=>·({·` with `⏎······'Active·sessions:',⏎······activeSessions.map(s·=>·({`","line":195,"column":17,"nodeType":null,"messageId":"replace","endLine":195,"endColumn":64,"fix":{"range":[6031,6078],"text":"\n      'Active sessions:',\n      activeSessions.map(s => ({"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `······sessionId:·s.sessionId,·⏎` with `········sessionId:·s.sessionId,⏎··`","line":196,"column":1,"nodeType":null,"messageId":"replace","endLine":197,"endColumn":1,"fix":{"range":[6079,6110],"text":"        sessionId: s.sessionId,\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `parentSessionId:·s.parentSessionId·` with `··parentSessionId:·s.parentSessionId,`","line":198,"column":7,"nodeType":null,"messageId":"replace","endLine":198,"endColumn":42,"fix":{"range":[6148,6183],"text":"  parentSessionId: s.parentSessionId,"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····})));` with `······}))`","line":199,"column":1,"nodeType":null,"messageId":"replace","endLine":199,"endColumn":10,"fix":{"range":[6184,6193],"text":"      }))"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `);⏎`","line":200,"column":5,"nodeType":null,"messageId":"insert","endLine":200,"endColumn":5,"fix":{"range":[6198,6198],"text":");\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":202,"column":1,"nodeType":null,"messageId":"delete","endLine":202,"endColumn":5,"fix":{"range":[6253,6257],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":218,"column":1,"nodeType":null,"messageId":"delete","endLine":218,"endColumn":5,"fix":{"range":[6777,6781],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":231,"column":1,"nodeType":null,"messageId":"delete","endLine":231,"endColumn":5,"fix":{"range":[7195,7199],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":235,"column":1,"nodeType":null,"messageId":"delete","endLine":235,"endColumn":5,"fix":{"range":[7358,7362],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":239,"column":1,"nodeType":null,"messageId":"delete","endLine":239,"endColumn":5,"fix":{"range":[7504,7508],"text":""}}],"suppressedMessages":[],"errorCount":29,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":29,"fixableWarningCount":0,"source":"/**\n * Session Registry unit tests\n */\n\nimport { describe, it, expect, beforeEach } from 'vitest';\nimport { SessionRegistry } from './SessionRegistry';\nimport { EventBus } from '../event-bus/EventBus';\n\ndescribe('SessionRegistry', () => {\n  let registry: SessionRegistry;\n\n  beforeEach(() => {\n    registry = new SessionRegistry(new EventBus());\n  });\n\n  it('should register pending sessions', async () => {\n    const spawnIntentId = 'spawn-123';\n    const identity = await registry.registerPending(\n      'sf-orchestrator',\n      'requirements-phase-executor',\n      'work-123',\n      spawnIntentId\n    );\n    \n    expect(identity.sessionId).toBeDefined();\n    expect(identity.spawnIntentId).toBe(spawnIntentId);\n    expect(identity.status).toBe('pending');\n    expect(identity.agentRole).toBe('sf-orchestrator');\n    expect(identity.workflowRole).toBe('requirements-phase-executor');\n    expect(identity.workItemId).toBe('work-123');\n    expect(identity.parentSessionId).toBeNull();\n  });\n\n  it('should register pending sessions with parent', async () => {\n    const parentId = 'parent-123';\n    const spawnIntentId = 'spawn-456';\n    const identity = await registry.registerPending(\n      'sf-orchestrator',\n      'sub-agent',\n      'work-456',\n      spawnIntentId,\n      parentId\n    );\n    \n    expect(identity.parentSessionId).toBe(parentId);\n  });\n\n  it('should activate pending sessions', async () => {\n    const spawnIntentId = 'spawn-123';\n    const identity = await registry.registerPending(\n      'sf-orchestrator',\n      'requirements-phase-executor',\n      'work-123',\n      spawnIntentId\n    );\n    \n    const activated = await registry.activate(identity.sessionId, spawnIntentId);\n    \n    expect(activated).toBeDefined();\n    expect(activated?.status).toBe('active');\n    expect(activated?.sessionId).toBe(identity.sessionId);\n    expect(registry.lookupBySessionId(identity.sessionId)).toBeDefined();\n  });\n\n  it('should not activate with wrong spawnIntentId', async () => {\n    const spawnIntentId = 'spawn-123';\n    const identity = await registry.registerPending(\n      'sf-orchestrator',\n      'requirements-phase-executor',\n      'work-123',\n      spawnIntentId\n    );\n    \n    const activated = await registry.activate(identity.sessionId, 'wrong-id');\n    \n    expect(activated).toBeNull();\n    // Session should still be in pending state\n    const lookup = registry.lookupBySessionId(identity.sessionId);\n    expect(lookup).toBeDefined();\n    expect(lookup?.status).toBe('pending');\n  });\n\n  it('should lookup sessions by sessionId', async () => {\n    const spawnIntentId = 'spawn-123';\n    const identity = await registry.registerPending(\n      'sf-orchestrator',\n      'requirements-phase-executor',\n      'work-123',\n      spawnIntentId\n    );\n    await registry.activate(identity.sessionId, spawnIntentId);\n    \n    const found = registry.lookupBySessionId(identity.sessionId);\n    \n    expect(found).toBeDefined();\n    expect(found?.sessionId).toBe(identity.sessionId);\n    expect(found?.status).toBe('active');\n  });\n\n  it('should return null for non-existent session', () => {\n    const found = registry.lookupBySessionId('non-existent');\n    expect(found).toBeNull();\n  });\n\n  it('should terminate active sessions', async () => {\n    const spawnIntentId = 'spawn-123';\n    const identity = await registry.registerPending(\n      'sf-orchestrator',\n      'requirements-phase-executor',\n      'work-123',\n      spawnIntentId\n    );\n    const activated = await registry.activate(identity.sessionId, spawnIntentId);\n    \n    const terminated = await registry.terminate(activated!.sessionId);\n    \n    expect(terminated).toBeDefined();\n    expect(terminated?.status).toBe('history');\n    expect(registry.lookupBySessionId(activated!.sessionId)).toBeDefined();\n    expect(registry.lookupBySessionId(activated!.sessionId)?.status).toBe('history');\n  });\n\n  it('should not terminate non-existent session', async () => {\n    const terminated = await registry.terminate('non-existent');\n    expect(terminated).toBeNull();\n  });\n\n  it('should update last active timestamp', async () => {\n    const spawnIntentId = 'spawn-123';\n    const identity = await registry.registerPending(\n      'sf-orchestrator',\n      'requirements-phase-executor',\n      'work-123',\n      spawnIntentId\n    );\n    const activated = await registry.activate(identity.sessionId, spawnIntentId);\n    const firstActive = activated!.lastActiveAt;\n    \n    // Wait a bit to ensure timestamp difference\n    await new Promise(resolve => setTimeout(resolve, 10));\n    \n    const touched = await registry.touch(activated!.sessionId);\n    \n    expect(touched).toBeDefined();\n    expect(touched!.lastActiveAt).toBeGreaterThan(firstActive);\n  });\n\n  it('should get session counts', async () => {\n    const spawnIntentId1 = 'spawn-123';\n    const spawnIntentId2 = 'spawn-456';\n    \n    await registry.registerPending(\n      'sf-orchestrator',\n      'requirements-phase-executor',\n      'work-123',\n      spawnIntentId1\n    );\n    await registry.registerPending(\n      'sf-orchestrator',\n      'requirements-phase-executor',\n      'work-456',\n      spawnIntentId2\n    );\n    \n    const counts = registry.getCounts();\n    \n    expect(counts.pending).toBe(2);\n    expect(counts.active).toBe(0);\n    expect(counts.history).toBe(0);\n  });\n\n  it('should get session tree for work item', async () => {\n    const spawnIntentId1 = 'spawn-123';\n    const spawnIntentId2 = 'spawn-456';\n    \n    const parent = await registry.registerPending(\n      'sf-orchestrator',\n      'requirements-phase-executor',\n      'work-123',\n      spawnIntentId1\n    );\n    const child = await registry.registerPending(\n      'sf-orchestrator',\n      'sub-agent',\n      'work-123',\n      spawnIntentId2,\n      parent.sessionId\n    );\n    \n    await registry.activate(parent.sessionId, spawnIntentId1);\n    await registry.activate(child.sessionId, spawnIntentId2);\n    \n    // Debug: log all active sessions\n    const activeSessions = registry.getActiveSessions();\n    console.log('Active sessions:', activeSessions.map(s => ({ \n      sessionId: s.sessionId, \n      workItemId: s.workItemId,\n      parentSessionId: s.parentSessionId \n    })));\n    \n    const tree = registry.getSessionTree('work-123');\n    \n    // Should have 2 sessions: parent + child\n    expect(tree.length).toBeGreaterThan(0);\n    expect(tree[0]?.sessionId).toBe(parent.sessionId);\n    expect(tree[1]?.sessionId).toBe(child.sessionId);\n    expect(tree[1]?.parentSessionId).toBe(parent.sessionId);\n  });\n\n  it('should check if session exists', async () => {\n    const spawnIntentId = 'spawn-123';\n    const identity = await registry.registerPending(\n      'sf-orchestrator',\n      'requirements-phase-executor',\n      'work-123',\n      spawnIntentId\n    );\n    \n    expect(registry.hasSession(identity.sessionId)).toBe(true);\n    expect(registry.hasSession('non-existent')).toBe(false);\n  });\n\n  it('should move session from pending to history via termination', async () => {\n    const spawnIntentId = 'spawn-123';\n    const identity = await registry.registerPending(\n      'sf-orchestrator',\n      'requirements-phase-executor',\n      'work-123',\n      spawnIntentId\n    );\n    \n    // Try to terminate pending session (should fail)\n    const terminated = await registry.terminate(identity.sessionId);\n    expect(terminated).toBeNull();\n    \n    // Activate first\n    const activated = await registry.activate(identity.sessionId, spawnIntentId);\n    expect(activated).toBeDefined();\n    \n    // Now terminate\n    const history = await registry.terminate(activated!.sessionId);\n    expect(history).toBeDefined();\n    expect(history?.status).toBe('history');\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\session\\SessionRegistry.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":3,"column":3,"nodeType":null,"messageId":"delete","endLine":3,"endColumn":4,"fix":{"range":[41,42],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":6,"column":3,"nodeType":null,"messageId":"delete","endLine":6,"endColumn":4,"fix":{"range":[144,145],"text":""}},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'updateLastActive' is defined but never used. Allowed unused vars must match /^_/u.","line":21,"column":3,"nodeType":"Identifier","messageId":"unusedVar","endLine":21,"endColumn":19,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"updateLastActive"},"fix":{"range":[577,597],"text":""},"desc":"Remove unused variable \"updateLastActive\"."}]},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":39,"column":1,"nodeType":null,"messageId":"delete","endLine":39,"endColumn":3,"fix":{"range":[1005,1007],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":63,"column":3,"nodeType":null,"messageId":"delete","endLine":63,"endColumn":4,"fix":{"range":[1692,1693],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":71,"column":3,"nodeType":null,"messageId":"delete","endLine":71,"endColumn":4,"fix":{"range":[1993,1994],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `eventBus:·EventBus,·sessionTimeoutMs:·number·=·30·*·60·*·1000,·wal?:·WAL,·touchThrottleMs?:·number` with `⏎····eventBus:·EventBus,⏎····sessionTimeoutMs:·number·=·30·*·60·*·1000,⏎····wal?:·WAL,⏎····touchThrottleMs?:·number⏎··`","line":95,"column":15,"nodeType":null,"messageId":"replace","endLine":95,"endColumn":113,"fix":{"range":[3065,3163],"text":"\n    eventBus: EventBus,\n    sessionTimeoutMs: number = 30 * 60 * 1000,\n    wal?: WAL,\n    touchThrottleMs?: number\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(event)` with `event`","line":110,"column":62,"nodeType":null,"messageId":"rep