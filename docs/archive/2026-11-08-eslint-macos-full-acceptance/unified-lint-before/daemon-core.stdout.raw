lt.code` with `⏎······branch_name:·plan.branch_name,⏎······base_ref:·plan.base_ref,⏎······worktree_path:·plan.worktree_path,⏎······created_at:·new·Date().toISOString(),⏎······result_code:·result.code,⏎···`","line":172,"column":6,"nodeType":null,"messageId":"replace","endLine":172,"endColumn":160,"fix":{"range":[6852,7006],"text":"\n      branch_name: plan.branch_name,\n      base_ref: plan.base_ref,\n      worktree_path: plan.worktree_path,\n      created_at: new Date().toISOString(),\n      result_code: result.code,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·schema_version:·'git_worktrees.v1',·updated_at:·new·Date().toISOString(),·worktrees:·nextWorktrees` with `⏎····schema_version:·'git_worktrees.v1',⏎····updated_at:·new·Date().toISOString(),⏎····worktrees:·nextWorktrees,⏎·`","line":174,"column":34,"nodeType":null,"messageId":"replace","endLine":174,"endColumn":133,"fix":{"range":[7048,7147],"text":"\n    schema_version: 'git_worktrees.v1',\n    updated_at: new Date().toISOString(),\n    worktrees: nextWorktrees,\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":208,"column":13,"nodeType":null,"messageId":"insert","endLine":208,"endColumn":13,"fix":{"range":[8249,8249],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·...plan,·plan_path:·normalizeRelativePath(path.relative(input.projectRoot,·planPath))` with `⏎······...plan,⏎······plan_path:·normalizeRelativePath(path.relative(input.projectRoot,·planPath)),⏎···`","line":214,"column":13,"nodeType":null,"messageId":"replace","endLine":214,"endColumn":99,"fix":{"range":[8561,8647],"text":"\n      ...plan,\n      plan_path: normalizeRelativePath(path.relative(input.projectRoot, planPath)),\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `await·runGit(input.projectRoot,·['rev-parse',·targetRef],·true)` with `⏎····await·runGit(input.projectRoot,·['rev-parse',·targetRef],·true)⏎··`","line":231,"column":27,"nodeType":null,"messageId":"replace","endLine":231,"endColumn":90,"fix":{"range":[9089,9152],"text":"\n    await runGit(input.projectRoot, ['rev-parse', targetRef], true)\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `input.projectRoot,·`git_release_tag_plan_${tagName.replace(/[^A-Za-z0-9._-]/g,·'-')}.json`` with `⏎······input.projectRoot,⏎······`git_release_tag_plan_${tagName.replace(/[^A-Za-z0-9._-]/g,·'-')}.json`⏎····`","line":247,"column":34,"nodeType":null,"messageId":"replace","endLine":247,"endColumn":124,"fix":{"range":[9733,9823],"text":"\n      input.projectRoot,\n      `git_release_tag_plan_${tagName.replace(/[^A-Za-z0-9._-]/g, '-')}.json`\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·...plan,·plan_path:·normalizeRelativePath(path.relative(input.projectRoot,·planPath))` with `⏎······...plan,⏎······plan_path:·normalizeRelativePath(path.relative(input.projectRoot,·planPath)),⏎···`","line":249,"column":13,"nodeType":null,"messageId":"replace","endLine":249,"endColumn":99,"fix":{"range":[9875,9961],"text":"\n      ...plan,\n      plan_path: normalizeRelativePath(path.relative(input.projectRoot, planPath)),\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `input.projectRoot,·['tag',·'-a',·plan.tag_name,·plan.target_ref,·'-m',·plan.message],·true` with `⏎····input.projectRoot,⏎····['tag',·'-a',·plan.tag_name,·plan.target_ref,·'-m',·plan.message],⏎····true⏎··`","line":264,"column":31,"nodeType":null,"messageId":"replace","endLine":264,"endColumn":121,"fix":{"range":[10412,10502],"text":"\n    input.projectRoot,\n    ['tag', '-a', plan.tag_name, plan.target_ref, '-m', plan.message],\n    true\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·...plan,·mode:·'executed',·success:·result.code·===·0,·code:·result.code,·stdout:·result.stdout,·stderr:·result.stderr` with `⏎····...plan,⏎····mode:·'executed',⏎····success:·result.code·===·0,⏎····code:·result.code,⏎····stdout:·result.stdout,⏎····stderr:·result.stderr,⏎·`","line":265,"column":11,"nodeType":null,"messageId":"replace","endLine":265,"endColumn":130,"fix":{"range":[10515,10634],"text":"\n    ...plan,\n    mode: 'executed',\n    success: result.code === 0,\n    code: result.code,\n    stdout: result.stdout,\n    stderr: result.stderr,\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·schema_version:·'git_agent_locks.v1',·locks:·[]` with `⏎····schema_version:·'git_agent_locks.v1',⏎····locks:·[],⏎·`","line":297,"column":60,"nodeType":null,"messageId":"replace","endLine":297,"endColumn":108,"fix":{"range":[11639,11687],"text":"\n    schema_version: 'git_agent_locks.v1',\n    locks: [],\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(lock:·AgentLock)·=>·lock.lock_name·===·lockName·&&·lock.owner·!==·owner` with `⏎····(lock:·AgentLock)·=>·lock.lock_name·===·lockName·&&·lock.owner·!==·owner⏎··`","line":299,"column":32,"nodeType":null,"messageId":"replace","endLine":299,"endColumn":104,"fix":{"range":[11815,11887],"text":"\n    (lock: AgentLock) => lock.lock_name === lockName && lock.owner !== owner\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·return·{·success:·false,·error:·'AGENT_LOCK_CONFLICT',·conflict,·locks_path:·normalizeRelativePath(path.relative(input.projectRoot,·locksPath))` with `⏎····return·{⏎······success:·false,⏎······error:·'AGENT_LOCK_CONFLICT',⏎······conflict,⏎······locks_path:·normalizeRelativePath(path.relative(input.projectRoot,·locksPath)),⏎···`","line":300,"column":16,"nodeType":null,"messageId":"replace","endLine":300,"endColumn":160,"fix":{"range":[11905,12049],"text":"\n    return {\n      success: false,\n      error: 'AGENT_LOCK_CONFLICT',\n      conflict,\n      locks_path: normalizeRelativePath(path.relative(input.projectRoot, locksPath)),\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `...active.filter((lock:·AgentLock)·=>·lock.lock_name·!==·lockName·||·lock.owner·!==·owner),·nextLock` with `⏎····...active.filter((lock:·AgentLock)·=>·lock.lock_name·!==·lockName·||·lock.owner·!==·owner),⏎····nextLock,⏎··`","line":309,"column":18,"nodeType":null,"messageId":"replace","endLine":309,"endColumn":118,"fix":{"range":[12345,12445],"text":"\n    ...active.filter((lock: AgentLock) => lock.lock_name !== lockName || lock.owner !== owner),\n    nextLock,\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·schema_version:·'git_agent_locks.v1',·updated_at:·new·Date().toISOString(),·locks` with `⏎····schema_version:·'git_agent_locks.v1',⏎····updated_at:·new·Date().toISOString(),⏎····locks,⏎·`","line":310,"column":31,"nodeType":null,"messageId":"replace","endLine":310,"endColumn":113,"fix":{"range":[12478,12560],"text":"\n    schema_version: 'git_agent_locks.v1',\n    updated_at: new Date().toISOString(),\n    locks,\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·success:·true,·lock:·nextLock,·locks_path:·normalizeRelativePath(path.relative(input.projectRoot,·locksPath))` with `⏎····success:·true,⏎····lock:·nextLock,⏎····locks_path:·normalizeRelativePath(path.relative(input.projectRoot,·locksPath)),⏎·`","line":311,"column":11,"nodeType":null,"messageId":"replace","endLine":311,"endColumn":121,"fix":{"range":[12575,12685],"text":"\n    success: true,\n    lock: nextLock,\n    locks_path: normalizeRelativePath(path.relative(input.projectRoot, locksPath)),\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·schema_version:·'git_agent_locks.v1',·locks:·[]` with `⏎····schema_version:·'git_agent_locks.v1',⏎····locks:·[],⏎·`","line":325,"column":60,"nodeType":null,"messageId":"replace","endLine":325,"endColumn":108,"fix":{"range":[13196,13244],"text":"\n    schema_version: 'git_agent_locks.v1',\n    locks: [],\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·schema_version:·'git_agent_locks.v1',·updated_at:·new·Date().toISOString(),·locks:·after` with `⏎····schema_version:·'git_agent_locks.v1',⏎····updated_at:·new·Date().toISOString(),⏎····locks:·after,⏎·`","line":332,"column":31,"nodeType":null,"messageId":"replace","endLine":332,"endColumn":120,"fix":{"range":[13531,13620],"text":"\n    schema_version: 'git_agent_locks.v1',\n    updated_at: new Date().toISOString(),\n    locks: after,\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·success:·true,·released_count:·before.length·-·after.length,·locks_path:·normalizeRelativePath(path.relative(input.projectRoot,·locksPath))` with `⏎····success:·true,⏎····released_count:·before.length·-·after.length,⏎····locks_path:·normalizeRelativePath(path.relative(input.projectRoot,·locksPath)),⏎·`","line":333,"column":11,"nodeType":null,"messageId":"replace","endLine":333,"endColumn":151,"fix":{"range":[13635,13775],"text":"\n    success: true,\n    released_count: before.length - after.length,\n    locks_path: normalizeRelativePath(path.relative(input.projectRoot, locksPath)),\n "}}],"suppressedMessages":[],"errorCount":29,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":27,"fixableWarningCount":0,"source":"import { execFile } from 'node:child_process';\nimport { promisify } from 'node:util';\nimport * as fs from 'node:fs/promises';\nimport { existsSync } from 'node:fs';\nimport * as path from 'node:path';\nimport { SPEC_DIR_NAME } from '@specforge/types/directory-layout';\nimport { getCurrentBranch, getHeadCommit, normalizeRelativePath } from './git-governance-core';\n\nconst execFileAsync = promisify(execFile);\n\nasync function runGit(projectRoot: string, args: string[], allowFailure = false): Promise<{ stdout: string; stderr: string; code: number }> {\n  try {\n    const { stdout, stderr } = await execFileAsync('git', args, { cwd: projectRoot, maxBuffer: 10 * 1024 * 1024 });\n    return { stdout: String(stdout ?? ''), stderr: String(stderr ?? ''), code: 0 };\n  } catch (err: any) {\n    if (allowFailure) {\n      return { stdout: String(err?.stdout ?? ''), stderr: String(err?.stderr ?? err?.message ?? ''), code: Number(err?.code ?? 1) };\n    }\n    throw new Error(`git ${args.join(' ')} failed: ${String(err?.stderr ?? err?.message ?? 'git command failed')}`);\n  }\n}\n\nasync function writeJson(filePath: string, value: unknown): Promise<void> {\n  await fs.mkdir(path.dirname(filePath), { recursive: true });\n  await fs.writeFile(filePath, JSON.stringify(value, null, 2) + '\\n', 'utf-8');\n}\n\nasync function readJsonIfExists<T>(filePath: string, fallback: T): Promise<T> {\n  if (!existsSync(filePath)) return fallback;\n  try {\n    return JSON.parse(await fs.readFile(filePath, 'utf-8')) as T;\n  } catch {\n    return fallback;\n  }\n}\n\nfunction runtimePath(projectRoot: string, ...parts: string[]): string {\n  return path.join(projectRoot, SPEC_DIR_NAME, 'runtime', ...parts);\n}\n\nfunction reportsPath(projectRoot: string, ...parts: string[]): string {\n  return path.join(projectRoot, SPEC_DIR_NAME, 'reports', ...parts);\n}\n\nfunction safeBranchName(value: string): string {\n  return String(value || '')\n    .trim()\n    .replace(/\\\\/g, '/')\n    .replace(/^\\/+|\\/+$/g, '')\n    .replace(/\\s+/g, '-')\n    .replace(/[^A-Za-z0-9._\\/-]/g, '-')\n    .replace(/\\/+/g, '/');\n}\n\nfunction inferProvider(url: string | undefined, hint?: string): string {\n  if (hint) return hint;\n  const text = String(url ?? '').toLowerCase();\n  if (text.includes('github.com')) return 'github';\n  if (text.includes('gitlab.com')) return 'gitlab';\n  if (text.includes('gitee.com')) return 'gitee';\n  if (text.includes('bitbucket.org')) return 'bitbucket';\n  if (text.includes('http') || text.includes('@')) return 'generic_git';\n  return 'unknown';\n}\n\nfunction parseRemotes(stdout: string): Record<string, { fetch_url?: string; push_url?: string }> {\n  const remotes: Record<string, { fetch_url?: string; push_url?: string }> = {};\n  for (const line of stdout.split(/\\r?\\n/).filter(Boolean)) {\n    const match = line.match(/^(\\S+)\\s+(\\S+)\\s+\\((fetch|push)\\)$/);\n    if (!match) continue;\n    const [, name, url, kind] = match;\n    remotes[name] ||= {};\n    if (kind === 'fetch') remotes[name].fetch_url = url;\n    if (kind === 'push') remotes[name].push_url = url;\n  }\n  return remotes;\n}\n\nexport async function gitPrPlan(input: {\n  projectRoot: string;\n  sourceBranch?: string;\n  targetBranch?: string;\n  remoteName?: string;\n  provider?: string;\n  title?: string;\n  body?: string;\n  writePlan?: boolean;\n}) {\n  const currentBranch = input.sourceBranch ?? (await getCurrentBranch(input.projectRoot)) ?? '';\n  const sourceBranch = safeBranchName(currentBranch);\n  if (!sourceBranch) throw new Error('SOURCE_BRANCH_REQUIRED');\n  const targetBranch = safeBranchName(input.targetBranch || 'main');\n  const remoteName = input.remoteName || 'origin';\n  const headCommit = await getHeadCommit(input.projectRoot);\n  const remotes = parseRemotes((await runGit(input.projectRoot, ['remote', '-v'], true)).stdout);\n  const remote = remotes[remoteName] ?? {};\n  const provider = inferProvider(remote.fetch_url || remote.push_url, input.provider);\n  const plan = {\n    schema_version: 'git_pr_plan.v1',\n    success: true,\n    provider_type: provider,\n    remote_name: remoteName,\n    source_branch: sourceBranch,\n    target_branch: targetBranch,\n    head_commit: headCommit,\n    title: input.title || `Merge ${sourceBranch} into ${targetBranch}`,\n    body: input.body || 'Generated by SpecForge Git Governance stage 4.',\n    mode: 'plan_only',\n    requires_user_review: true,\n    remote,\n    updated_at: new Date().toISOString(),\n  };\n  if (input.writePlan !== false) {\n    const planPath = runtimePath(input.projectRoot, 'git_pr_plan.json');\n    await writeJson(planPath, plan);\n    return { ...plan, plan_path: normalizeRelativePath(path.relative(input.projectRoot, planPath)) };\n  }\n  return plan;\n}\n\nexport async function gitWorktreePlan(input: {\n  projectRoot: string;\n  branchName: string;\n  baseRef?: string;\n  worktreePath?: string;\n  createBranch?: boolean;\n  writePlan?: boolean;\n}) {\n  const branchName = safeBranchName(input.branchName);\n  if (!branchName) throw new Error('BRANCH_NAME_REQUIRED');\n  const baseRef = input.baseRef || 'main';\n  const defaultPath = path.resolve(input.projectRoot, '..', `${path.basename(input.projectRoot)}--${branchName.replace(/[\\/]/g, '-')}`);\n  const worktreePathAbs = path.resolve(input.worktreePath || defaultPath);\n  const headCommit = await getHeadCommit(input.projectRoot).catch(() => '');\n  const plan = {\n    schema_version: 'git_worktree_plan.v1',\n    success: true,\n    branch_name: branchName,\n    base_ref: baseRef,\n    worktree_path: worktreePathAbs,\n    create_branch: input.createBranch !== false,\n    head_commit: headCommit,\n    mode: 'plan_only',\n    updated_at: new Date().toISOString(),\n  };\n  if (input.writePlan !== false) {\n    const planPath = runtimePath(input.projectRoot, 'git_worktree_plan.json');\n    await writeJson(planPath, plan);\n    return { ...plan, plan_path: normalizeRelativePath(path.relative(input.projectRoot, planPath)) };\n  }\n  return plan;\n}\n\nexport async function gitWorktreeCreate(input: {\n  projectRoot: string;\n  branchName: string;\n  baseRef?: string;\n  worktreePath?: string;\n  createBranch?: boolean;\n  confirmed?: boolean;\n}) {\n  if (input.confirmed !== true) throw new Error('WORKTREE_CREATE_REQUIRES_USER_CONFIRMATION');\n  const plan = await gitWorktreePlan({ ...input, writePlan: false });\n  const args = plan.create_branch\n    ? ['worktree', 'add', '-b', plan.branch_name, plan.worktree_path, plan.base_ref]\n    : ['worktree', 'add', plan.worktree_path, plan.branch_name];\n  const result = await runGit(input.projectRoot, args, true);\n  const registryPath = runtimePath(input.projectRoot, 'git_worktrees.json');\n  const existing = await readJsonIfExists<any>(registryPath, { schema_version: 'git_worktrees.v1', worktrees: [] });\n  const nextWorktrees = [\n    ...(existing.worktrees ?? []).filter((item: any) => item.branch_name !== plan.branch_name && item.worktree_path !== plan.worktree_path),\n    { branch_name: plan.branch_name, base_ref: plan.base_ref, worktree_path: plan.worktree_path, created_at: new Date().toISOString(), result_code: result.code },\n  ];\n  await writeJson(registryPath, { schema_version: 'git_worktrees.v1', updated_at: new Date().toISOString(), worktrees: nextWorktrees });\n  return {\n    ...plan,\n    success: result.code === 0,\n    mode: 'executed',\n    code: result.code,\n    stdout: result.stdout,\n    stderr: result.stderr,\n    registry_path: normalizeRelativePath(path.relative(input.projectRoot, registryPath)),\n  };\n}\n\nexport async function gitStackedBranchPlan(input: {\n  projectRoot: string;\n  parentBranch: string;\n  childBranch: string;\n  workItemId?: string;\n  childWorkItemId?: string;\n  writePlan?: boolean;\n}) {\n  const parentBranch = safeBranchName(input.parentBranch);\n  const childBranch = safeBranchName(input.childBranch);\n  if (!parentBranch || !childBranch) throw new Error('PARENT_AND_CHILD_BRANCH_REQUIRED');\n  const headCommit = await getHeadCommit(input.projectRoot).catch(() => '');\n  const plan = {\n    schema_version: 'git_stacked_branch_plan.v1',\n    success: true,\n    parent_branch: parentBranch,\n    child_branch: childBranch,\n    work_item_id: input.workItemId ?? null,\n    child_work_item_id: input.childWorkItemId ?? null,\n    current_head: headCommit,\n    mode: 'plan_only',\n    merge_order: [childBranch, parentBranch],\n    warning: 'Merge stacked branches from child to parent, then parent to target branch after gates pass.',\n    updated_at: new Date().toISOString(),\n  };\n  if (input.writePlan !== false) {\n    const planPath = runtimePath(input.projectRoot, 'git_stacked_branch_plan.json');\n    await writeJson(planPath, plan);\n    return { ...plan, plan_path: normalizeRelativePath(path.relative(input.projectRoot, planPath)) };\n  }\n  return plan;\n}\n\nexport async function gitReleaseTagPlan(input: {\n  projectRoot: string;\n  tagName: string;\n  targetRef?: string;\n  message?: string;\n  remoteName?: string;\n  writePlan?: boolean;\n}) {\n  const tagName = String(input.tagName || '').trim();\n  if (!tagName) throw new Error('TAG_NAME_REQUIRED');\n  const targetRef = input.targetRef || 'HEAD';\n  const remoteName = input.remoteName || 'origin';\n  const resolvedTarget = (await runGit(input.projectRoot, ['rev-parse', targetRef], true)).stdout.trim();\n  const existing = await runGit(input.projectRoot, ['tag', '--list', tagName], true);\n  const plan = {\n    schema_version: 'git_release_tag_plan.v1',\n    success: true,\n    tag_name: tagName,\n    target_ref: targetRef,\n    target_commit: resolvedTarget,\n    remote_name: remoteName,\n    message: input.message || `release: ${tagName}`,\n    tag_exists: existing.stdout.trim() === tagName,\n    mode: 'plan_only',\n    requires_user_confirmation: true,\n    updated_at: new Date().toISOString(),\n  };\n  if (input.writePlan !== false) {\n    const planPath = reportsPath(input.projectRoot, `git_release_tag_plan_${tagName.replace(/[^A-Za-z0-9._-]/g, '-')}.json`);\n    await writeJson(planPath, plan);\n    return { ...plan, plan_path: normalizeRelativePath(path.relative(input.projectRoot, planPath)) };\n  }\n  return plan;\n}\n\nexport async function gitReleaseTagCreate(input: {\n  projectRoot: string;\n  tagName: string;\n  targetRef?: string;\n  message?: string;\n  confirmed?: boolean;\n}) {\n  if (input.confirmed !== true) throw new Error('RELEASE_TAG_CREATE_REQUIRES_USER_CONFIRMATION');\n  const plan = await gitReleaseTagPlan({ ...input, writePlan: false });\n  if (plan.tag_exists) throw new Error('TAG_ALREADY_EXISTS');\n  const result = await runGit(input.projectRoot, ['tag', '-a', plan.tag_name, plan.target_ref, '-m', plan.message], true);\n  return { ...plan, mode: 'executed', success: result.code === 0, code: result.code, stdout: result.stdout, stderr: result.stderr };\n}\n\ntype AgentLock = {\n  lock_name: string;\n  owner: string;\n  work_item_id?: string | null;\n  paths: string[];\n  acquired_at: string;\n  expires_at: string;\n};\n\nfunction isExpired(lock: AgentLock, now = Date.now()): boolean {\n  return new Date(lock.expires_at).getTime() <= now;\n}\n\nexport async function gitAgentLockAcquire(input: {\n  projectRoot: string;\n  lockName: string;\n  owner: string;\n  workItemId?: string;\n  paths?: string[];\n  ttlMinutes?: number;\n  confirmed?: boolean;\n}) {\n  if (input.confirmed !== true) throw new Error('AGENT_LOCK_ACQUIRE_REQUIRES_USER_CONFIRMATION');\n  const lockName = String(input.lockName || '').trim();\n  const owner = String(input.owner || '').trim();\n  if (!lockName || !owner) throw new Error('LOCK_NAME_AND_OWNER_REQUIRED');\n  const ttlMs = Math.max(1, Number(input.ttlMinutes || 120)) * 60 * 1000;\n  const now = Date.now();\n  const locksPath = runtimePath(input.projectRoot, 'git_agent_locks.json');\n  const existing = await readJsonIfExists<any>(locksPath, { schema_version: 'git_agent_locks.v1', locks: [] });\n  const active = (existing.locks ?? []).filter((lock: AgentLock) => !isExpired(lock, now));\n  const conflict = active.find((lock: AgentLock) => lock.lock_name === lockName && lock.owner !== owner);\n  if (conflict) return { success: false, error: 'AGENT_LOCK_CONFLICT', conflict, locks_path: normalizeRelativePath(path.relative(input.projectRoot, locksPath)) };\n  const nextLock: AgentLock = {\n    lock_name: lockName,\n    owner,\n    work_item_id: input.workItemId ?? null,\n    paths: (input.paths ?? []).map(normalizeRelativePath),\n    acquired_at: new Date(now).toISOString(),\n    expires_at: new Date(now + ttlMs).toISOString(),\n  };\n  const locks = [...active.filter((lock: AgentLock) => lock.lock_name !== lockName || lock.owner !== owner), nextLock];\n  await writeJson(locksPath, { schema_version: 'git_agent_locks.v1', updated_at: new Date().toISOString(), locks });\n  return { success: true, lock: nextLock, locks_path: normalizeRelativePath(path.relative(input.projectRoot, locksPath)) };\n}\n\nexport async function gitAgentLockRelease(input: {\n  projectRoot: string;\n  lockName: string;\n  owner?: string;\n  force?: boolean;\n  confirmed?: boolean;\n}) {\n  if (input.confirmed !== true) throw new Error('AGENT_LOCK_RELEASE_REQUIRES_USER_CONFIRMATION');\n  const lockName = String(input.lockName || '').trim();\n  if (!lockName) throw new Error('LOCK_NAME_REQUIRED');\n  const locksPath = runtimePath(input.projectRoot, 'git_agent_locks.json');\n  const existing = await readJsonIfExists<any>(locksPath, { schema_version: 'git_agent_locks.v1', locks: [] });\n  const before = existing.locks ?? [];\n  const after = before.filter((lock: AgentLock) => {\n    if (lock.lock_name !== lockName) return true;\n    if (input.force === true) return false;\n    return input.owner ? lock.owner !== input.owner : true;\n  });\n  await writeJson(locksPath, { schema_version: 'git_agent_locks.v1', updated_at: new Date().toISOString(), locks: after });\n  return { success: true, released_count: before.length - after.length, locks_path: normalizeRelativePath(path.relative(input.projectRoot, locksPath)) };\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\git-governance-write-provenance.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(`${SPEC_DIR_NAME}/project/git_policy.json`·as·const)` with ``${SPEC_DIR_NAME}/project/git_policy.json`·as·const`","line":17,"column":3,"nodeType":null,"messageId":"replace","endLine":17,"endColumn":56,"fix":{"range":[572,625],"text":"`${SPEC_DIR_NAME}/project/git_policy.json` as const"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(`${SPEC_DIR_NAME}/project/git_ignore_decisions.json`·as·const)` with ``${SPEC_DIR_NAME}/project/git_ignore_decisions.json`·as·const`","line":18,"column":3,"nodeType":null,"messageId":"replace","endLine":18,"endColumn":66,"fix":{"range":[629,692],"text":"`${SPEC_DIR_NAME}/project/git_ignore_decisions.json` as const"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(`${SPEC_DIR_NAME}/project/git_adoption_report.md`·as·const)` with ``${SPEC_DIR_NAME}/project/git_adoption_report.md`·as·const`","line":19,"column":3,"nodeType":null,"messageId":"replace","endLine":19,"endColumn":63,"fix":{"range":[696,756],"text":"`${SPEC_DIR_NAME}/project/git_adoption_report.md` as const"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎····projectRoot,⏎····SPEC_DIR_NAME,⏎····'runtime',⏎····'git_governance_controlled_writes.json',⏎··` with `projectRoot,·SPEC_DIR_NAME,·'runtime',·'git_governance_controlled_writes.json'`","line":32,"column":20,"nodeType":null,"messageId":"replace","endLine":37,"endColumn":3,"fix":{"range":[1061,1160],"text":"projectRoot, SPEC_DIR_NAME, 'runtime', 'git_governance_controlled_writes.json'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":69,"column":101,"nodeType":null,"messageId":"delete","endLine":69,"endColumn":102,"fix":{"range":[2328,2329],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":92,"column":26,"nodeType":null,"messageId":"delete","endLine":92,"endColumn":27,"fix":{"range":[3289,3290],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":96,"column":82,"nodeType":null,"messageId":"delete","endLine":96,"endColumn":83,"fix":{"range":[3479,3480],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······left.path.localeCompare(right.path),⏎····` with `·left.path.localeCompare(right.path)`","line":118,"column":62,"nodeType":null,"messageId":"replace","endLine":120,"endColumn":5,"fix":{"range":[4283,4331],"text":" left.path.localeCompare(right.path)"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":132,"column":22,"nodeType":null,"messageId":"delete","endLine":132,"endColumn":23,"fix":{"range":[4738,4739],"text":""}}],"suppressedMessages":[],"errorCount":9,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":9,"fixableWarningCount":0,"source":"import * as fs from 'node:fs';\nimport * as path from 'node:path';\nimport { createHash } from 'node:crypto';\nimport {\n  GIT_GOVERNANCE_WRITE_PROVENANCE_SCHEMA_VERSION,\n  SPEC_DIR_NAME,\n  type GitGovernanceTrustedWrite,\n  type GitGovernanceWriteProvenance,\n} from '@specforge/types';\nimport { createGitGovernanceWriteProvenanceSchemaDescriptor } from '@specforge/types/schema-contract';\n\nexport const GIT_GOVERNANCE_WRITE_PROVENANCE_SCHEMA =\n  GIT_GOVERNANCE_WRITE_PROVENANCE_SCHEMA_VERSION;\n\nexport const GIT_GOVERNANCE_PROJECT_METADATA_PATHS = new Set([\n  '.gitignore',\n  (`${SPEC_DIR_NAME}/project/git_policy.json` as const),\n  (`${SPEC_DIR_NAME}/project/git_ignore_decisions.json` as const),\n  (`${SPEC_DIR_NAME}/project/git_adoption_report.md` as const),\n]);\n\nexport type TrustedGitGovernanceWrite = GitGovernanceTrustedWrite;\n\nfunction normalizeRelative(value: string): string {\n  return String(value ?? '')\n    .replace(/\\\\/g, '/')\n    .replace(/^\\.?\\//, '')\n    .toLowerCase();\n}\n\nfunction provenancePath(projectRoot: string): string {\n  return path.join(\n    projectRoot,\n    SPEC_DIR_NAME,\n    'runtime',\n    'git_governance_controlled_writes.json',\n  );\n}\n\nfunction sha256File(filePath: string): string {\n  return createHash('sha256').update(fs.readFileSync(filePath)).digest('hex');\n}\n\nfunction writeAtomically(filePath: string, content: string): void {\n  fs.mkdirSync(path.dirname(filePath), { recursive: true });\n  const temp = `${filePath}.tmp-${process.pid}-${Date.now()}`;\n  fs.writeFileSync(temp, content, 'utf-8');\n  fs.renameSync(temp, filePath);\n}\n\nfunction readProvenance(projectRoot: string): GitGovernanceWriteProvenance {\n  const filePath = provenancePath(projectRoot);\n  if (!fs.existsSync(filePath)) {\n    return {\n      schema_version: GIT_GOVERNANCE_WRITE_PROVENANCE_SCHEMA,\n      updated_at: new Date(0).toISOString(),\n      writes: [],\n    };\n  }\n  try {\n    const parsed = JSON.parse(fs.readFileSync(filePath, 'utf-8')) as unknown;\n    const descriptor = createGitGovernanceWriteProvenanceSchemaDescriptor();\n    if (!descriptor.validateCurrent(parsed)) {\n      throw new Error('VALIDATION_FAILED');\n    }\n    return parsed as GitGovernanceWriteProvenance;\n  } catch (error) {\n    throw new Error(\n      `GIT_GOVERNANCE_PROVENANCE_INVALID: ${error instanceof Error ? error.message : String(error)}`,\n    );\n  }\n}\n\nexport function assertGitGovernanceWriteProvenanceCurrent(projectRoot: string): void {\n  const provenance = readProvenance(projectRoot);\n  for (const entry of provenance.writes) {\n    const relative = normalizeRelative(entry.path);\n    // Root .gitignore is a user-editable projection. A stale projection must\n    // lose trusted-write status, but it must not deadlock the controlled tool\n    // that can re-apply confirmed decisions and refresh that provenance.\n    if (relative === '.gitignore') continue;\n    const absolute = path.join(projectRoot, ...relative.split('/'));\n    if (!fs.existsSync(absolute) || sha256File(absolute) !== entry.sha256.toLowerCase()) {\n      throw new Error(`GIT_GOVERNANCE_PROVENANCE_INVALID: CURRENT_HASH_MISMATCH: ${relative}`);\n    }\n  }\n}\n\nexport function recordGitGovernanceProjectWrites(\n  projectRoot: string,\n  producer: 'sf_git_project_adopt' | 'sf_git_ignore_decision_record',\n  relativePaths: string[],\n): TrustedGitGovernanceWrite[] {\n  const previous = readProvenance(projectRoot);\n  const byPath = new Map(\n    previous.writes.map(entry => [normalizeRelative(entry.path), entry] as const),\n  );\n\n  for (const candidate of relativePaths) {\n    const relative = normalizeRelative(candidate);\n    if (!GIT_GOVERNANCE_PROJECT_METADATA_PATHS.has(relative)) {\n      throw new Error(`GIT_GOVERNANCE_PROVENANCE_PATH_FORBIDDEN: ${relative}`);\n    }\n    const absolute = path.join(projectRoot, ...relative.split('/'));\n    if (!fs.existsSync(absolute)) {\n      throw new Error(`GIT_GOVERNANCE_PROVENANCE_TARGET_MISSING: ${relative}`);\n    }\n    byPath.set(relative, {\n      path: relative as GitGovernanceTrustedWrite['path'],\n      producer,\n      sha256: sha256File(absolute),\n    });\n  }\n\n  const next: GitGovernanceWriteProvenance = {\n    schema_version: GIT_GOVERNANCE_WRITE_PROVENANCE_SCHEMA,\n    updated_at: new Date().toISOString(),\n    writes: Array.from(byPath.values()).sort((left, right) =>\n      left.path.localeCompare(right.path),\n    ),\n  };\n  const output = provenancePath(projectRoot);\n  const descriptor = createGitGovernanceWriteProvenanceSchemaDescriptor();\n  if (!descriptor.validateCurrent(next)) {\n    throw new Error('GIT_GOVERNANCE_PROVENANCE_RECORD_INVALID');\n  }\n  writeAtomically(output, JSON.stringify(next, null, 2) + '\\n');\n  return next.writes;\n}\n\nexport function readTrustedGitGovernanceProjectWrites(\n  projectRoot: string,\n): TrustedGitGovernanceWrite[] {\n  const provenance = readProvenance(projectRoot);\n  return provenance.writes.filter(entry => {\n    const relative = normalizeRelative(entry?.path);\n    if (!GIT_GOVERNANCE_PROJECT_METADATA_PATHS.has(relative)) return false;\n    if (\n      entry?.producer !== 'sf_git_project_adopt' &&\n      entry?.producer !== 'sf_git_ignore_decision_record'\n    ) {\n      return false;\n    }\n    if (!/^[a-f0-9]{64}$/i.test(String(entry?.sha256 ?? ''))) return false;\n    const absolute = path.join(projectRoot, ...relative.split('/'));\n    if (!fs.existsSync(absolute)) return false;\n    return sha256File(absolute) === String(entry.sha256).toLowerCase();\n  });\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\governance-invariants-v11.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎··isSameOrDescendantResolvedPath,⏎··resolvedPathIdentity,⏎` with `·isSameOrDescendantResolvedPath,·resolvedPathIdentity·`","line":28,"column":9,"nodeType":null,"messageId":"replace","endLine":31,"endColumn":1,"fix":{"range":[902,961],"text":" isSameOrDescendantResolvedPath, resolvedPathIdentity "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `.map(value·=>·String(value·??·'').trim().toLowerCase())` with `⏎······.map(value·=>⏎········String(value·??·'')⏎··········.trim()⏎··········.toLowerCase()⏎······)⏎······`","line":129,"column":24,"nodeType":null,"messageId":"replace","endLine":129,"endColumn":79,"fix":{"range":[3549,3604],"text":"\n      .map(value =>\n        String(value ?? '')\n          .trim()\n          .toLowerCase()\n      )\n      "}},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'candidatePath ?? ''' will use Object's default stringification format ('[object Object]') when stringified.","line":181,"column":44,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":181,"endColumn":63},{"ruleId":"no-useless-escape","severity":2,"message":"Unnecessary escape character: \\/.","line":348,"column":47,"nodeType":"Literal","messageId":"unnecessaryEscape","endLine":348,"endColumn":48,"suggestions":[{"messageId":"removeEscape","fix":{"range":[10801,10802],"text":""},"desc":"Remove the `\\`. This maintains the current functionality."},{"messageId":"escapeBackslash","fix":{"range":[10801,10801],"text":"\\"},"desc":"Replace the `\\` with `\\\\` to include the actual backslash character."}]},{"ruleId":"no-useless-escape","severity":2,"message":"Unnecessary escape character: \\/.","line":353,"column":47,"nodeType":"Literal","messageId":"unnecessaryEscape","endLine":353,"endColumn":48,"suggestions":[{"messageId":"removeEscape","fix":{"range":[11062,11063],"text":""},"desc":"Remove the `\\`. This maintains the current functionality."},{"messageId":"escapeBackslash","fix":{"range":[11062,11062],"tex