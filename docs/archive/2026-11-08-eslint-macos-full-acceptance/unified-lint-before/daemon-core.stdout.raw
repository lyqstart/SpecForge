e":[2435,2435],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"typed\"·|·\"legacy\"·|·\"empty\"` with `'typed'·|·'legacy'·|·'empty';`","line":94,"column":11,"nodeType":null,"messageId":"replace","endLine":94,"endColumn":39,"fix":{"range":[2460,2488],"text":"'typed' | 'legacy' | 'empty';"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":96,"column":30,"nodeType":null,"messageId":"insert","endLine":96,"endColumn":30,"fix":{"range":[2577,2577],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"passed\"·|·\"failed\"·|·\"skipped\"` with `'passed'·|·'failed'·|·'skipped';`","line":103,"column":29,"nodeType":null,"messageId":"replace","endLine":103,"endColumn":60,"fix":{"range":[2794,2825],"text":"'passed' | 'failed' | 'skipped';"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"completed\"·|·\"incomplete\"` with `'completed'·|·'incomplete';`","line":104,"column":28,"nodeType":null,"messageId":"replace","endLine":104,"endColumn":54,"fix":{"range":[2853,2879],"text":"'completed' | 'incomplete';"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"passed\"·|·\"missing\"·|·\"failed\"·|·\"skipped\"` with `'passed'·|·'missing'·|·'failed'·|·'skipped';`","line":105,"column":32,"nodeType":null,"messageId":"replace","endLine":105,"endColumn":75,"fix":{"range":[2911,2954],"text":"'passed' | 'missing' | 'failed' | 'skipped';"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":109,"column":26,"nodeType":null,"messageId":"insert","endLine":109,"endColumn":26,"fix":{"range":[3074,3074],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":111,"column":18,"nodeType":null,"messageId":"insert","endLine":111,"endColumn":18,"fix":{"range":[3110,3110],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":113,"column":24,"nodeType":null,"messageId":"insert","endLine":113,"endColumn":24,"fix":{"