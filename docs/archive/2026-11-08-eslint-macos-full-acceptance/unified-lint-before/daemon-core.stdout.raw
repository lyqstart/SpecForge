"nodeType":null,"messageId":"replace","endLine":103,"endColumn":1,"fix":{"range":[2543,2611],"text":"root: string, subdir: 'payloads' | 'errors', value: unknown"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"by-sha256\"` with `'by-sha256'`","line":105,"column":39,"nodeType":null,"messageId":"replace","endLine":105,"endColumn":50,"fix":{"range":[2691,2702],"text":"'by-sha256'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"utf-8\"` with `'utf-8'`","line":109,"column":47,"nodeType":null,"messageId":"replace","endLine":109,"endColumn":54,"fix":{"range":[2864,2871],"text":"'utf-8'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎··input:·DaemonObservationInput,⏎` with `input:·DaemonObservationInput`","line":114,"column":41,"nodeType":null,"messageId":"replace","endLine":116,"endColumn":1,"fix":{"range":[2936,2970],"text":"input: DaemonObservationInput"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":117,"column":47,"nodeType":null,"messageId":"insert","endLine":117,"endColumn":47,"fix":{"range":[3040,3040],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····...input,` with `······...input,⏎·····`","line":118,"column":1,"nodeType":null,"messageId":"replace","endLine":118,"endColumn":14,"fix":{"range":[3051,3064],"text":"      ...input,\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····error:·input.error·===·undefined·?·undefined·:·{·configuration_error_omitted:·true·},` with `······error:·input.error·===·undefined·?·undefined·:·{·configuration_error_omitted:·true·},⏎·····`","line":119,"column":1,"nodeType":null,"messageId":"replace","endLine":119,"endColumn":90,"fix":{"range":[3115,3204],"text":"      error: input.error === undefined ? undefined : { configuration_error_omitted: true },\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":120,"column":1,"nodeType":null,"messageId":"insert","endLine":120,"endColumn":1,"fix":{"range":[3226,3226],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `⏎·····`","line":122,"column":24,"nodeType":null,"messageId":"delete","endLine":123,"endColumn":6,"fix":{"range":[3262,3268],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `⏎·····`","line":125,"column":73,"nodeType":null,"messageId":"delete","endLine":126,"endColumn":6,"fix":{"range":[3467,3473],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······projectRoot,⏎······SPEC_DIR_NAME,⏎······\"logs\",⏎······\"observability\",⏎······\"daemon\",⏎····` with `projectRoot,·SPEC_DIR_NAME,·'logs',·'observability',·'daemon'`","line":129,"column":28,"nodeType":null,"messageId":"replace","endLine":135,"endColumn":5,"fix":{"range":[3583,3681],"text":"projectRoot, SPEC_DIR_NAME, 'logs', 'observability', 'daemon'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······?·redactSecrets(input.payload)⏎·····` with `·?·redactSecrets(input.payload)`","line":137,"column":42,"nodeType":null,"messageId":"replace","endLine":139,"endColumn":6,"fix":{"range":[3726,3769],"text":" ? redactSecrets(input.payload)"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······?·redactSecrets(input.error)⏎·····` with `·?·redactSecrets(input.error)`","line":140,"column":40,"nodeType":null,"messageId":"replace","endLine":142,"endColumn":6,"fix":{"range":[3826,3867],"text":" ? redactSecrets(input.error)"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······config.capture_payload·&&⏎······config.payload_storage·===·\"file\"·&&⏎······payload·!==·undefined⏎····` with `config.capture_payload·&&·config.payload_storage·===·'file'·&&·payload·!==·undefined`","line":150,"column":9,"nodeType":null,"messageId":"replace","endLine":154,"endColumn":5,"fix":{"range":[4128,4236],"text":"config.capture_payload && config.payload_storage === 'file' && payload !== undefined"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"payloads\"` with `'payloads'`","line":155,"column":41,"nodeType":null,"messageId":"replace","endLine":155,"endColumn":51,"fix":{"range":[4280,4290],"text":"'payloads'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······config.capture_payload·&&⏎······config.payload_storage·===·\"file\"·&&⏎······error·!==·undefined⏎····` with `config.capture_payload·&&·config.payload_storage·===·'file'·&&·error·!==·undefined`","line":158,"column":9,"nodeType":null,"messageId":"replace","endLine":162,"endColumn":5,"fix":{"range":[4317,4423],"text":"config.capture_payload && config.payload_storage === 'file' && error !== undefined"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"errors\"` with `'errors'`","line":163,"column":39,"nodeType":null,"messageId":"replace","endLine":163,"endColumn":47,"fix":{"range":[4465,4473],"text":"'errors'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎········?·error⏎·······` with `·?·error`","line":171,"column":75,"nodeType":null,"messageId":"replace","endLine":173,"endColumn":8,"fix":{"range":[4732,4756],"text":" ? error"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"1.4\"` with `'1.4'`","line":176,"column":23,"nodeType":null,"messageId":"replace","endLine":176,"endColumn":28,"fix":{"range":[4814,4819],"text":"'1.4'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"daemon\"` with `'daemon'`","line":177,"column":15,"nodeType":null,"messageId":"replace","endLine":177,"endColumn":23,"fix":{"range":[4835,4843],"text":"'daemon'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎········?·path.relative(projectRoot,·payloadFile)⏎·······` with `·?·path.relative(projectRoot,·payloadFile)`","line":189,"column":32,"nodeType":null,"messageId":"replace","endLine":191,"endColumn":8,"fix":{"range":[5283,5341],"text":" ? path.relative(projectRoot, payloadFile)"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"index.jsonl\"` with `'index.jsonl'`","line":201,"column":33,"nodeType":null,"messageId":"replace","endLine":201,"endColumn":46,"fix":{"range":[5796,5809],"text":"'index.jsonl'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"daemon\"` with `'daemon'`","line":202,"column":15,"nodeType":null,"messageId":"replace","endLine":202,"endColumn":23,"fix":{"range":[5828,5836],"text":"'daemon'"}}],"suppressedMessages":[],"errorCount":62,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":62,"fixableWarningCount":0,"source":"import { SPEC_DIR_NAME } from \"@specforge/types/directory-layout\";\n/**\n * SpecForge OBS-FULL Layer 1 — daemon observability recorder.\n *\n * R4 simple mode:\n * - payload/error files remain content-addressed by sha256.\n * - daemon observations obey category/phase filters in observability.json.\n * - blocked OpenCode event phases such as opencode.message.part.updated are not recorded.\n */\nimport * as fs from \"node:fs\";\nimport * as path from \"node:path\";\nimport {\n  loadSfObservabilityConfig,\n  resolveProjectRootFromContext,\n  shouldRecordObservationByConfig,\n} from \"./observability-config\";\nimport { redactSecrets, sha256, stableJson } from \"./redaction\";\nimport { createSfTraceId } from \"./trace\";\n\nexport interface DaemonObservationInput {\n  projectRoot?: string;\n  context?: Record<string, unknown>;\n  category:\n    | \"daemon-ingress\"\n    | \"dispatcher\"\n    | \"handler\"\n    | \"state\"\n    | \"artifact\"\n    | \"gate\"\n    | \"close-gate\"\n    | \"hardstop\"\n    | \"error\";\n  phase: string;\n  trace_id?: string;\n  tool_name?: string;\n  handler_name?: string;\n  work_item_id?: string;\n  status?: string;\n  duration_ms?: number;\n  payload?: unknown;\n  error?: unknown;\n  metadata?: Record<string, unknown>;\n  force?: boolean;\n}\n\nfunction ensureDir(dir: string): void {\n  fs.mkdirSync(dir, { recursive: true });\n}\n\nfunction appendJsonl(file: string, record: unknown): void {\n  ensureDir(path.dirname(file));\n  fs.appendFileSync(file, stableJson(record) + \"\\n\", \"utf-8\");\n}\n\nfunction byteLength(value: unknown): number {\n  return Buffer.byteLength(\n    typeof value === \"string\" ? value : stableJson(value),\n    \"utf-8\",\n  );\n}\n\nfunction categoryFileName(\n  category: DaemonObservationInput[\"category\"],\n): string {\n  switch (category) {\n    case \"daemon-ingress\":\n      return \"daemon-ingress.jsonl\";\n    case \"dispatcher\":\n      return \"dispatcher.jsonl\";\n    case \"handler\":\n      return \"handlers.jsonl\";\n    case \"state\":\n      return \"state.jsonl\";\n    case \"artifact\":\n      return \"artifacts.jsonl\";\n    case \"gate\":\n      return \"gates.jsonl\";\n    case \"close-gate\":\n      return \"close-gate.jsonl\";\n    case \"hardstop\":\n      return \"hardstop.jsonl\";\n    case \"error\":\n      return \"errors.jsonl\";\n    default:\n      return \"index.jsonl\";\n  }\n}\n\nfunction shouldRecord(\n  config: ReturnType<typeof loadSfObservabilityConfig>,\n  category: DaemonObservationInput[\"category\"],\n  phase: string,\n  force?: boolean,\n): boolean {\n  if (force) return true;\n  return shouldRecordObservationByConfig(config, category, phase);\n}\n\nfunction writeBySha256(\n  root: string,\n  subdir: \"payloads\" | \"errors\",\n  value: unknown,\n): string {\n  const hash = sha256(value);\n  const dir = path.join(root, subdir, \"by-sha256\", hash.slice(0, 2));\n  const file = path.join(dir, `${hash}.json`);\n  ensureDir(dir);\n  if (!fs.existsSync(file)) {\n    fs.writeFileSync(file, stableJson(value), \"utf-8\");\n  }\n  return file;\n}\n\nexport function recordDaemonObservation(\n  input: DaemonObservationInput,\n): string | undefined {\n  if (input.tool_name === 'sf_project_config') input = {\n    ...input, payload: { configuration_payload_omitted: true },\n    error: input.error === undefined ? undefined : { configuration_error_omitted: true }, metadata: undefined,\n  };\n  try {\n    const projectRoot =\n      input.projectRoot ?? resolveProjectRootFromContext(input.context);\n    const config = loadSfObservabilityConfig(projectRoot);\n    if (!shouldRecord(config, input.category, input.phase, input.force))\n      return input.trace_id;\n\n    const trace_id = input.trace_id ?? createSfTraceId();\n    const root = path.join(\n      projectRoot,\n      SPEC_DIR_NAME,\n      \"logs\",\n      \"observability\",\n      \"daemon\",\n    );\n\n    const payload = config.redact_secrets\n      ? redactSecrets(input.payload)\n      : input.payload;\n    const error = config.redact_secrets\n      ? redactSecrets(input.error)\n      : input.error;\n\n    const payloadBytes = input.payload === undefined ? 0 : byteLength(payload);\n    const errorBytes = input.error === undefined ? 0 : byteLength(error);\n\n    let payloadFile: string | undefined;\n    let errorFile: string | undefined;\n\n    if (\n      config.capture_payload &&\n      config.payload_storage === \"file\" &&\n      payload !== undefined\n    ) {\n      payloadFile = writeBySha256(root, \"payloads\", payload);\n    }\n\n    if (\n      config.capture_payload &&\n      config.payload_storage === \"file\" &&\n      error !== undefined\n    ) {\n      errorFile = writeBySha256(root, \"errors\", error);\n    }\n\n    const inlinePayload =\n      payload !== undefined && payloadBytes <= config.max_inline_payload_bytes\n        ? payload\n        : undefined;\n    const inlineError =\n      error !== undefined && errorBytes <= config.max_inline_payload_bytes\n        ? error\n        : undefined;\n\n    const record = {\n      schema_version: \"1.4\",\n      source: \"daemon\",\n      timestamp: new Date().toISOString(),\n      trace_id,\n      category: input.category,\n      phase: input.phase,\n      tool_name: input.tool_name,\n      handler_name: input.handler_name,\n      work_item_id: input.work_item_id,\n      status: input.status,\n      duration_ms: input.duration_ms,\n      payload_bytes: payloadBytes,\n      payload_sha256: payload === undefined ? undefined : sha256(payload),\n      payload_file: payloadFile\n        ? path.relative(projectRoot, payloadFile)\n        : undefined,\n      error_bytes: errorBytes,\n      error_sha256: error === undefined ? undefined : sha256(error),\n      error_file: errorFile ? path.relative(projectRoot, errorFile) : undefined,\n      payload: inlinePayload,\n      error: inlineError,\n      metadata: config.redact_secrets ? redactSecrets(input.metadata) : input.metadata,\n    };\n\n    appendJsonl(path.join(root, categoryFileName(input.category)), record);\n    appendJsonl(path.join(root, \"index.jsonl\"), {\n      source: \"daemon\",\n      timestamp: record.timestamp,\n      trace_id,\n      category: input.category,\n      phase: input.phase,\n      status: input.status,\n      tool_name: input.tool_name,\n      handler_name: input.handler_name,\n      work_item_id: input.work_item_id,\n      payload_bytes: payloadBytes,\n      error_bytes: errorBytes,\n    });\n\n    return trace_id;\n  } catch {\n    return input.trace_id;\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\observability\\redaction.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"node:crypto\"` with `'node:crypto'`","line":4,"column":28,"nodeType":null,"messageId":"replace","endLine":4,"endColumn":41,"fix":{"range":[93,106],"text":"'node:crypto'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·`","line":6,"column":27,"nodeType":null,"messageId":"insert","endLine":6,"endColumn":27,"fix":{"range":[135,135],"text":"\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"sha256\"` with `'sha256'`","line":18,"column":21,"nodeType":null,"messageId":"replace","endLine":18,"endColumn":29,"fix":{"range":[585,593],"text":"'sha256'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"string\"` with `'string'`","line":19,"column":30,"nodeType":null,"messageId":"replace","endLine":19,"endColumn":38,"fix":{"range":[624,632],"text":"'string'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"hex\"` with `'hex'`","line":20,"column":13,"nodeType":null,"messageId":"replace","endLine":20,"endColumn":18,"fix":{"range":[674,679],"text":"'hex'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"string\"` with `'string'`","line":25,"column":26,"nodeType":null,"messageId":"replace","endLine":25,"endColumn":34,"fix":{"range":[809,817],"text":"'string'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"[REDACTED]\"` with `'[REDACTED]'`","line":28,"column":12,"nodeType":null,"messageId":"replace","endLine":28,"endColumn":24,"fix":{"range":[922,934],"text":"'[REDACTED]'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"string\"` with `'string'`","line":31,"column":24,"nodeType":null,"messageId":"replace","endLine":31,"endColumn":32,"fix":{"range":[964,972],"text":"'string'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":33,"column":37,"nodeType":null,"messageId":"insert","endLine":33,"endColumn":37,"fix":{"range":[1107,1107],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `value·&&·typeof·value·===·'object'·&&·((value·as·any).tool·===·'sf_project_config'·||·(value·as·any).tool_name·===·'sf_project_config')` with `⏎····value·&&⏎····typeof·value·===·'object'·&&⏎····((value·as·any).tool·===·'sf_project_config'·||⏎······(value·as·any).tool_name·===·'sf_project_config')⏎··`","line":40,"column":7,"nodeType":null,"messageId":"replace","endLine":40,"endColumn":142,"fix":{"range":[1260,1395],"text":"\n    value &&\n    typeof value === 'object' &&\n    ((value as any).tool === 'sf_project_config' ||\n      (value as any).tool_name === 'sf_project_config')\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(item)` with `item`","line":43,"column":46,"nodeType":null,"messageId":"replace","endLine":43,"endColumn":52,"fix":{"range":[1527,1533],"text":"item"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"object\"` with `'object'`","line":45,"column":33,"nodeType":null,"messageId":"replace","endLine":45,"endColumn":41,"fix":{"range":[1592,1600],"text":"'object'"}}],"suppressedMessages":[],"errorCount":12,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":12,"fixableWarningCount":0,"source":"/**\n * SpecForge OBS-FULL Layer 1 — daemon redaction helpers.\n */\nimport { createHash } from \"node:crypto\";\n\nconst SECRET_KEY_PATTERN = /(api[_-]?key|authorization|cookie|password|secret|private[_-]?key|access[_-]?token|refresh[_-]?token|token)/i;\nconst JWT_PATTERN = /^[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+\\.[A-Za-z0-9_-]+$/;\n\nexport function stableJson(value: unknown): string {\n  try {\n    return JSON.stringify(value ?? null);\n  } catch {\n    return JSON.stringify({ unserializable: true, type: typeof value });\n  }\n}\n\nexport function sha256(value: unknown): string {\n  return createHash(\"sha256\")\n    .update(typeof value === \"string\" ? value : stableJson(value))\n    .digest(\"hex\");\n}\n\nfunction redactValue(key: string, value: unknown): unknown {\n  if (SECRET_KEY_PATTERN.test(key)) {\n    if (typeof value === \"string\" && value.length > 0) {\n      return `[REDACTED sha256=${sha256(value).slice(0, 12)}]`;\n    }\n    return \"[REDACTED]\";\n  }\n\n  if (typeof value === \"string\") {\n    if (JWT_PATTERN.test(value)) return `[REDACTED_JWT sha256=${sha256(value).slice(0, 12)}]`;\n    if (/^Bearer\\s+.+/i.test(value)) return `[REDACTED_BEARER sha256=${sha256(value).slice(0, 12)}]`;\n  }\n\n  return value;\n}\n\nexport function redactSecrets(value: unknown): unknown {\n  if (value && typeof value === 'object' && ((value as any).tool === 'sf_project_config' || (value as any).tool_name === 'sf_project_config')) {\n    return { tool: 'sf_project_config', configuration_payload_omitted: true };\n  }\n  if (Array.isArray(value)) return value.map((item) => redactSecrets(item));\n\n  if (value && typeof value === \"object\") {\n    const out: Record<string, unknown> = {};\n    for (const [key, raw] of Object.entries(value as Record<string, unknown>)) {\n      const redacted = redactValue(key, raw);\n      out[key] = redacted === raw ? redactSecrets(raw) : redacted;\n    }\n    return out;\n  }\n\n  return value;\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\observability\\trace.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"node:crypto\"` with `'node:crypto'`","line":4,"column":29,"nodeType":null,"messageId":"replace","endLine":4,"endColumn":42,"fix":{"range":[83,96],"text":"'node:crypto'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"sftr\"` with `'sftr'`","line":6,"column":42,"nodeType":null,"messageId":"replace","endLine":6,"endColumn":48,"fix":{"range":[140,146],"text":"'sftr'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"\"` with `''`","line":7,"column":60,"nodeType":null,"messageId":"replace","endLine":7,"endColumn":62,"fix":{"range":[217,219],"text":"''"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"hex\"` with `'hex'`","line":8,"column":54,"nodeType":null,"messageId":"replace","endLine":8,"endColumn":59,"fix":{"range":[275,280],"text":"'hex'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"string\"` with `'string'`","line":21,"column":30,"nodeType":null,"messageId":"replace","endLine":21,"endColumn":38,"fix":{"range":[597,605],"text":"'string'"}}],"suppressedMessages":[],"errorCount":5,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":5,"fixableWarningCount":0,"source":"/**\n * SpecForge OBS-FULL Layer 1 — trace helpers.\n */\nimport { randomBytes } from \"node:crypto\";\n\nexport function createSfTraceId(prefix = \"sftr\"): string {\n  const now = new Date().toISOString().replace(/[-:.TZ]/g, \"\");\n  return `${prefix}_${now}_${randomBytes(6).toString(\"hex\")}`;\n}\n\nexport function getTraceIdFromContext(context?: Record<string, unknown>): string | undefined {\n  const candidates = [\n    context?.trace_id,\n    context?.traceId,\n    context?.traceID,\n    context?.request_id,\n    context?.requestId,\n  ];\n\n  for (const candidate of candidates) {\n    if (typeof candidate === \"string\" && candidate.trim().length > 0) {\n      return candidate;\n    }\n  }\n\n  return undefined;\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\payload-handler.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":3,"column":3,"nodeType":null,"messageId":"delete","endLine":3,"endColumn":4,"fix":{"range":[25,26],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":48,"column":3,"nodeType":null,"messageId":"delete","endLine":48,"endColumn":4,"fix":{"range":[1031,1032],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······'Payload·must·be·a·Buffer',⏎······'INVALID_PAYLOAD_TYPE',` with `'Payload·must·be·a·Buffer',·'INVALID_PAYLOAD_TYPE',·{`","line":60,"column":35,"nodeType":null,"messageId":"replace","endLine":62,"endColumn":30,"fix":{"range":[1447,1511],"text":"'Payload must be a Buffer', 'INVALID_PAYLOAD_TYPE', {"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·{·receivedType:·typeof·data·}` with `·receivedType:·typeof·data,`","line":63,"column":6,"nodeType":null,"messageId":"replace","endLine":63,"endColumn":36,"fix":{"range":[1517,1547],"text":" receivedType: typeof data,"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `}`","line":64,"column":5,"nodeType":null,"messageId":"insert","endLine":64,"endColumn":5,"fix":{"range":[1552,1552],"text":"}"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······'Payload·cannot·be·empty',⏎······'EMPTY_PAYLOAD',⏎······{·size:·0·}⏎····` with `'Payload·cannot·be·empty',·'EMPTY_PAYLOAD',·{·size:·0·}`","line":69,"column":35,"nodeType":null,"messageId":"replace","endLine":73,"endColumn":5,"fix":{"range":[1650,1729],"text":"'Payload cannot be empty', 'EMPTY_PAYLOAD', { size: 0 }"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":103,"column":3,"nodeType":null,"messageId":"delete","endLine":103,"endColumn":4,"fix":{"range":[2379,2380],"text":""}},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'casBlob' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":113,"column":9,"nodeType":"Identifier","messageId":"unusedVar","endLine":113,"endColumn":16},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":124,"column":3,"nodeType":null,"messageId":"delete","endLine":124,"endColumn":4,"fix":{"range":[2843,2844],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":136,"column":3,"nodeType":null,"messageId":"delete","endLine":136,"endColumn":4,"fix":{"range":[3100,3101],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":167,"column":3,"nodeType":null,"messageId":"delete","endLine":167,"endColumn":4,"fix":{"range":[3836,3837],"text":""}}],"suppressedMessages":[],"errorCount":11,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":10,"fixableWarningCount":0,"source":"/**\n * Payload Handler\n * \n * Handles payload size detection and CAS blob reference generation.\n * Payloads <= 64 KiB are returned as inline references.\n * Payloads > 64 KiB are stored in CAS and returned as blob references.\n */\n\nimport * as crypto from 'crypto';\nimport { ContentAddressableStorage } from './cas';\n\n/**\n * Payload reference type\n * - inline: payload is small enough to be included directly\n * - cas: payload is stored in Content-Addressable Storage\n */\nexport interface PayloadRef {\n  type: 'inline' | 'cas';\n  value: string | BlobRef;\n}\n\n/**\n * CAS blob reference\n * Format: blob://<sha256>\n */\nexport interface BlobRef {\n  reference: string;\n  hash: string;\n  size: number;\n}\n\n/**\n * Payload handler error\n */\nexport class PayloadHandlerError extends Error {\n  constructor(\n    message: string,\n    public readonly code: string,\n    public readonly details?: Record<string, unknown>\n  ) {\n    super(message);\n    this.name = 'PayloadHandlerError';\n  }\n}\n\n/**\n * Handle payload and return appropriate reference\n * \n * @param data The payload data as Buffer\n * @param maxSize Maximum size for inline payloads (default: 64 KiB)\n * @returns PayloadRef with inline or CAS reference\n * @throws PayloadHandlerError if payload is invalid\n */\nexport async function handlePayload(\n  data: Buffer,\n  maxSize: number = 64 * 1024\n): Promise<PayloadRef> {\n  // Validate input\n  if (!Buffer.isBuffer(data)) {\n    throw new PayloadHandlerError(\n      'Payload must be a Buffer',\n      'INVALID_PAYLOAD_TYPE',\n      { receivedType: typeof data }\n    );\n  }\n\n  // Check for empty payload\n  if (data.length === 0) {\n    throw new PayloadHandlerError(\n      'Payload cannot be empty',\n      'EMPTY_PAYLOAD',\n      { size: 0 }\n    );\n  }\n\n  // Check payload size\n  if (data.length <= maxSize) {\n    // Small payload - return inline reference\n    return {\n      type: 'inline',\n      value: data.toString('base64'),\n    };\n  }\n\n  // Large payload - generate CAS reference\n  try {\n    const blobRef = await generateCASReference(data);\n    return {\n      type: 'cas',\n      value: blobRef,\n    };\n  } catch (error) {\n    throw new PayloadHandlerError(\n      `Failed to generate CAS reference: ${error instanceof Error ? error.message : String(error)}`,\n      'CAS_GENERATION_FAILED',\n      { size: data.length, maxSize }\n    );\n  }\n}\n\n/**\n * Generate CAS blob reference for payload\n * \n * @param data The payload data\n * @returns BlobRef with CAS reference\n */\nasync function generateCASReference(data: Buffer): Promise<BlobRef> {\n  // Calculate SHA-256 hash\n  const hash = calculateSHA256(data);\n\n  // Store in CAS\n  const cas = new ContentAddressableStorage();\n  const casBlob = await cas.store(data);\n\n  return {\n    reference: `blob://${hash}`,\n    hash: `sha256-${hash}`,\n    size: data.length,\n  };\n}\n\n/**\n * Calculate SHA-256 hash of data\n * \n * @param data The data to hash\n * @returns Hex-encoded SHA-256 hash\n */\nfunction calculateSHA256(data: Buffer): string {\n  const hash = crypto.createHash('sha256');\n  hash.update(data);\n  return hash.digest('hex');\n}\n\n/**\n * Validate payload reference\n * \n * @param ref The payload reference to validate\n * @returns true if reference is valid\n */\nexport function validatePayloadRef(ref: PayloadRef): boolean {\n  if (!ref || typeof ref !== 'object') {\n    return false;\n  }\n\n  if (ref.type === 'inline') {\n    return typeof ref.value === 'string';\n  }\n\n  if (ref.type === 'cas') {\n    const blobRef = ref.value as BlobRef;\n    return (\n      typeof blobRef === 'object' &&\n      typeof blobRef.reference === 'string' &&\n      blobRef.reference.startsWith('blob://') &&\n      typeof blobRef.hash === 'string' &&\n      blobRef.hash.startsWith('sha256-') &&\n      typeof blobRef.size === 'number' &&\n      blobRef.size > 0\n    );\n  }\n\n  return false;\n}\n\n/**\n * Extract payload from reference\n * \n * @param ref The payload reference\n * @returns The original payload data or null if CAS reference\n */\nexport function extractPayload(ref: PayloadRef): Buffer | null {\n  if (ref.type === 'inline' && typeof ref.value === 'string') {\n    return Buffer.from(ref.value, 'base64');\n  }\n\n  // CAS references cannot be extracted without CAS access\n  return null;\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\payload-handler\\index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\project\\ProjectManager.test.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎········`","line":65,"column":30,"nodeType":null,"messageId":"insert","endLine":65,"endColumn":30,"fix":{"range":[2765,2765],"text":"\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":66,"column":1,"nodeType":null,"messageId":"insert","endLine":66,"endColumn":1,"fix":{"range":[2782,2782],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `········` with `··········`","line":67,"column":1,"nodeType":null,"messageId":"replace","endLine":67,"endColumn":9,"fix":{"range":[2813,2821],"text":"          "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":68,"column":1,"nodeType":null,"messageId":"insert","endLine":68,"endColumn":1,"fix":{"range":[2855,2855],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":69,"column":9,"nodeType":null,"messageId":"insert","endLine":69,"endColumn":9,"fix":{"range":[2901,2901],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":70,"column":1,"nodeType":null,"messageId":"insert","endLine":70,"endColumn":1,"fix":{"range":[2925,2925],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":71,"column":9,"nodeType":null,"messageId":"insert","endLine":71,"endColumn":9,"fix":{"range":[2954,2954],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `······})` with `········})⏎······`","line":72,"column":1,"nodeType":null,"messageId":"replace","endLine":72,"endColumn":9,"fix":{"range":[2967,2975],"text":"        })\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":112,"column":28,"nodeType":null,"messageId":"delete","endLine":112,"endColumn":29,"fix":{"range":[4026,4027],"text":""}},{"ruleId":"@typescript-eslint/no-unsafe-argument","severity":2,"message":"Unsafe argument of type `any` assigned to a parameter of type `MergedConfig`.","line":115,"column":68,"nodeType":"TSAsExpression","messageId":"unsafeArgument","endLine":115,"endColumn":77},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":204,"column":34,"nodeType":null,"messageId":"delete","endLine":204,"endColumn":35,"fix":{"range":[7615,7616],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":213,"column":37,"nodeType":null,"messageId":"delete","endLine":213,"endColumn":38,"fix":{"range":[7927,7928],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎········`","line":231,"column":38,"nodeType":null,"messageId":"insert","endLine":231,"endColumn":38,"fix":{"range":[8643,8643],"text":"\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":232,"column":1,"nodeType":null,"messageId":"insert","endLine":232,"endColumn":1,"fix":{"range":[8660,8660],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `········` with `··········`","line":233,"column":1,"nodeType":null,"messageId":"replace","endLine":233,"endColumn":9,"fix":{"range":[8691,8699],"text":"          "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `······})` with `········})⏎······`","line":234,"column":1,"nodeType":null,"messageId":"replace","endLine":234,"endColumn":9,"fix":{"range":[8733,8741],"text":"        })\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎··········`","line":237,"column":18,"nodeType":null,"messageId":"insert","endLine":237,"endColumn":18,"fix":{"range":[8828,8828],"text":"\n          "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":238,"column":1,"nodeType":null,"messageId":"insert","endLine":238,"endColumn":1,"fix":{"range":[8830,8830],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":239,"column":11,"nodeType":null,"messageId":"insert","endLine":239,"endColumn":11,"fix":{"range":[8889,8889],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `··········` with `············`","line":240,"column":1,"nodeType":null,"messageId":"replace","endLine":240,"endColumn":11,"fix":{"range":[8935,8945],"text":"            "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":241,"column":11,"nodeType":null,"messageId":"insert","endLine":241,"endColumn":11,"fix":{"range":[9010,9010],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `··········` with `············`","line":242,"column":1,"nodeType":null,"messageId":"replace","endLine":242,"endColumn":11,"fix":{"range":[9029,9039],"text":"            "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":243,"column":11,"nodeType":null,"messageId":"insert","endLine":243,"endColumn":11,"fix":{"range":[9074,9074],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `··········` with `············`","line":244,"column":1,"nodeType":null,"messageId":"replace","endLine":244,"endColumn":11,"fix":{"range":[9098,9108],"text":"            "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":245,"column":1,"nodeType":null,"messageId":"insert","endLine":245,"endColumn":1,"fix":{"range":[9146,9146],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `}` with `··},⏎········`","line":246,"column":9,"nodeType":null,"messageId":"replace","endLine":246,"endColumn":10,"fix":{"range":[9223,9224],"text":"  },\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":250,"column":42,"nodeType":null,"messageId":"delete","endLine":250,"endColumn":43,"fix":{"range":[9359,9360],"text":""}}],"suppressedMessages":[],"errorCount":27,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":26,"fixableWarningCount":0,"source":"import { describe, it, expect, beforeEach, vi } from 'vitest';\nimport * as fs from 'fs/promises';\nimport { ProjectManager, type ProjectSchemaPrecheck } from './ProjectManager';\nimport { EventBus } from '../event-bus/EventBus';\nimport type { IPathResolver } from '../daemon/path-resolver';\nimport type { StateManager } from '../state/StateManager';\n\n// Mock fs/promises so that tests don't touch the real filesystem\nvi.mock('fs/promises', () => ({\n  access: vi.fn(),\n  mkdir: vi.fn().mockResolvedValue(undefined),\n  writeFile: vi.fn().mockResolvedValue(undefined),\n  readFile: vi.fn().mockRejectedValue(new Error('ENOENT')),\n}));\n\n// Grab the mocked functions (cast through unknown for typing)\nconst mockAccess = fs.access as unknown as ReturnType<typeof vi.fn>;\nconst mockMkdir = fs.mkdir as unknown as ReturnType<typeof vi.fn>;\nconst mockWriteFile = fs.writeFile as unknown as ReturnType<typeof vi.fn>;\nconst mockReadFile = fs.readFile as unknown as ReturnType<typeof vi.fn>;\n\nfunction createMockPathResolver(): IPathResolver {\n  const base = '/mock';\n  return {\n    resolveProjectRuntimeDir: (p: string) => `${base}/${p}/.specforge/runtime`,\n    resolveStatePath: (p: string) => `${base}/${p}/.specforge/runtime/state.json`,\n    resolveEventsPath: (p: string) => `${base}/${p}/.specforge/runtime/events.jsonl`,\n    resolveSessionsDir: (p: string) => `${base}/${p}/.specforge/runtime/sessions`,\n    resolveDaemonRuntimeDir: () => `${base}/.specforge/runtime`,\n    resolveHandshakePath: () => `${base}/.specforge/runtime/handshake.json`,\n    resolveDaemonJsonPath: () => `${base}/.config/opencode/daemon.json`,\n    resolveDaemonStatePath: () => `${base}/.specforge/runtime/state.json`,\n    resolveDaemonEventsPath: () => `${base}/.specforge/runtime/events.jsonl`,\n  };\n}\n\n/** Minimal mock StateManager for unit tests */\nfunction createMockStateManager(): StateManager {\n  return {} as StateManager;\n}\n\n/** Normalize slashes to forward slashes for cross-platform path comparison */\nfunction normalizePath(p: string): string {\n  return p.replace(/\\\\/g, '/');\n}\n\n/**\n * Set of project paths whose authoritative Project Spec manifest exists.\n */\nfunction mockCurrentManifestExistsForPaths(projectPaths: string[]) {\n  const normalizedAllowed = projectPaths.map(normalizePath);\n\n  mockAccess.mockImplementation((p: string) => {\n    const np = normalizePath(p);\n    if (np.endsWith('.specforge/project/spec_manifest.json')) {\n      for (const ap of normalizedAllowed) {\n        if (np.startsWith(ap)) return Promise.resolve();\n      }\n    }\n    return Promise.reject(new Error('ENOENT'));\n  });\n  mockReadFile.mockImplementation((p: string) => {\n    const np = normalizePath(p);\n    if (np.endsWith('.specforge/project/spec_manifest.json')) {\n      return Promise.resolve(JSON.stringify({\n        schema_version: '1.0',\n        project_spec_version: 'PSV-0001',\n        project_name: 'Test project',\n        default_module: 'main',\n        modules: [],\n        project: {},\n      }));\n    }\n    return Promise.reject(new Error('ENOENT'));\n  });\n}\n\n/**\n * Helper: configure fs.access to simulate no supported current manifest.\n */\nfunction mockNoCurrentManifest() {\n  mockAccess.mockRejectedValue(new Error('ENOENT'));\n}\n\n/**\n * Helper: configure fs.access to simulate the retired root manifest only.\n */\nfunction mockRetiredRootManifestExists() {\n  mockAccess.mockImplementation((p: string) => {\n    const np = normalizePath(p);\n    if (np.endsWith('.specforge/manifest.json')) {\n      return Promise.resolve();\n    }\n    return Promise.reject(new Error('ENOENT'));\n  });\n}\n\ndescribe('ProjectManager', () => {\n  let manager: ProjectManager;\n  let projectSchemaPrecheck: ReturnType<typeof vi.fn<ProjectSchemaPrecheck>>;\n\n  beforeEach(() => {\n    vi.clearAllMocks();\n    projectSchemaPrecheck = vi.fn<ProjectSchemaPrecheck>().mockResolvedValue({\n      ok: true,\n      checks: [],\n    });\n    manager = new ProjectManager(\n      new EventBus(),\n      createMockPathResolver(),\n      createMockStateManager(),\n      projectSchemaPrecheck,\n    );\n    // Registration unit isolation; acceptance has independent real-filesystem tests.\n    vi.spyOn(manager, 'getProjectConfiguration').mockResolvedValue({} as any);\n  });\n\n  // -----------------------------------------------------------------------\n  // Existing behavior under the current Project Spec layout.\n  // -----------------------------------------------------------------------\n  describe('existing functionality', () => {\n    beforeEach(() => {\n      mockCurrentManifestExistsForPaths(['/path/to/project', '/project/a', '/project/b']);\n    });\n\n    it('should register and get project context', async () => {\n      const projectPath = '/path/to/project';\n      const context = await manager.getProject(projectPath);\n\n      expect(context.projectPath).toBe(projectPath);\n      expect(context.projectId).toBeDefined();\n      expect(context.isFullyRegistered).toBe(true);\n      expect(context.dataDir).toContain('.specforge');\n    });\n\n    it('should return same instance for same project path', async () => {\n      const projectPath = '/path/to/project';\n      const ctx1 = await manager.getProject(projectPath);\n      const ctx2 = await manager.getProject(projectPath);\n\n      expect(ctx1).toBe(ctx2);\n    });\n\n    it('should isolate state between projects', async () => {\n      const ctx1 = await manager.getProject('/project/a');\n      const ctx2 = await manager.getProject('/project/b');\n\n      expect(ctx1.projectId).not.toBe(ctx2.projectId);\n      // All projects share the daemon global StateManager\n      expect(manager.getDaemonStateManager()).toBe(manager.getDaemonStateManager());\n    });\n\n    it('should acquire and release locks', async () => {\n      const projectPath = '/path/to/project';\n      const lock = await manager.acquireLock(projectPath);\n\n      expect(lock.id).toBeDefined();\n      expect(lock.projectPath).toBe(projectPath);\n      expect(lock.acquiredAt).toBeDefined();\n      expect(lock.expiresAt).toBeDefined();\n    });\n\n    it('should throw error for duplicate lock', async () => {\n      const projectPath = '/path/to/project';\n      await manager.acquireLock(projectPath);\n\n      await expect(manager.acquireLock(projectPath)).rejects.toThrow();\n    });\n\n    it('should list active projects', async () => {\n      const projectPath = '/path/to/project';\n      await manager.getProject(projectPath);\n\n      const projects = manager.listActiveProjects();\n      expect(projects).toContain(projectPath);\n    });\n\n    it('should unregister project', async () => {\n      const projectPath = '/path/to/project';\n      await manager.getProject(projectPath);\n      expect(manager.listActiveProjects()).toContain(projectPath);\n\n      await manager.unregisterProject(projectPath);\n      expect(manager.listActiveProjects()).not.toContain(projectPath);\n    });\n\n    it('should refuse to unregister locked project', async () => {\n      const projectPath = '/path/to/project';\n      await manager.getProject(projectPath);\n      await manager.acquireLock(projectPath);\n\n      await expect(manager.unregisterProject(projectPath)).rejects.toThrow();\n    });\n  });\n\n  // -----------------------------------------------------------------------\n  // Current initialization boundary.\n  // -----------------------------------------------------------------------\n  describe('manifest initialization checks', () => {\n    it('should throw PROJECT_NOT_INITIALIZED when the current manifest is absent', async () => {\n      mockNoCurrentManifest();\n\n      await expect(manager.registerProject('/uninitialized/project')).rejects.toThrow(\n        'PROJECT_NOT_INITIALIZED',\n      );\n    });\n\n    it('should reject the retired root manifest without auto-creating current state', async () => {\n      mockRetiredRootManifestExists();\n\n      const projectPath = '/old/project';\n      await expect(manager.registerProject(projectPath)).rejects.toThrow(\n        'UNSUPPORTED_PROJECT_LAYOUT',\n      );\n      expect(mockWriteFile).not.toHaveBeenCalled();\n    });\n\n    it('should register normally when project/spec_manifest.json exists', async () => {\n      mockCurrentManifestExistsForPaths(['/initialized/project']);\n\n      const projectPath = '/initialized/project';\n      const context = await manager.registerProject(projectPath);\n\n      expect(context.projectPath).toBe(projectPath);\n      expect(context.projectId).toBeDefined();\n      expect(context.isFullyRegistered).toBe(true);\n    });\n\n    it('should fail before runtime directory creation when the manifest schema is unregistered', async () => {\n      mockCurrentManifestExistsForPaths(['/future/project']);\n      mockReadFile.mockResolvedValue(JSON.stringify({\n        schema_version: '2.0',\n        project_spec_version: 'PSV-0001',\n      }));\n      projectSchemaPrecheck.mockResolvedValue({\n        ok: false,\n        checks: [{\n          descriptorId: 'project-spec-manifest',\n          owner: '@specforge/daemon-core/project-spec',\n          relativePath: '.specforge/project/spec_manifest.json',\n          status: 'blocked',\n          observedSchemaId: '2.0',\n          currentSchemaId: '1.0',\n          errorCode: 'SCHEMA_VERSION_MISMATCH',\n          error: 'unsupported schema_version \"2.0\"; expected \"1.0\"',\n        }],\n      });\n\n      await expect(manager.registerProject('/future/project')).rejects.toThrow(\n        'PROJECT_SCHEMA_PRECHECK_BLOCKED',\n      );\n      expect(mockMkdir).not.toHaveBeenCalled();\n      expect(projectSchemaPrecheck).toHaveBeenCalledWith('/future/project');\n    });\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\project\\ProjectManager.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·loadAcceptedConfigSync,·parseConfigurationObject,·type·MergedConfig·` with `⏎··loadAcceptedConfigSync,⏎··parseConfigurationObject,⏎··type·MergedConfig,⏎`","line":13,"column":9,"nodeType":null,"messageId":"replace","endLine":13,"endColumn":78,"fix":{"range":[620,689],"text":"\n  loadAcceptedConfigSync,\n  parseConfigurationObject,\n  type MergedConfig,\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":39,"column":22,"nodeType":null,"messageId":"delete","endLine":39,"endColumn":23,"fix":{"range":[1547,1548],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·return·await·action();·}` with `⏎······return·await·action();`","line":50,"column":10,"nodeType":null,"messageId":"replace","endLine":50,"endColumn":35,"fix":{"range":[2058,2083],"text":"\n      return await action();"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `·}`","line":51,"column":4,"nodeType":null,"messageId":"insert","endLine":51,"endColumn":4,"fix":{"range":[2087,2087],"text":" }"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":53,"column":57,"nodeType":null,"messageId":"insert","endLine":53,"endColumn":57,"fix":{"range":[2212,2212],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `...this.projects.keys(),·...this.projectStateManagers.keys(),·...this.projectLocks.keys()` with `⏎······...this.projects.keys(),⏎······...this.projectStateManagers.keys(),⏎······...this.projectLocks.keys(),⏎····`","line":59,"column":21,"nodeType":null,"messageId":"replace","endLine":59,"endColumn":110,"fix":{"range":[2434,2523],"text":"\n      ...this.projects.keys(),\n      ...this.projectStateManagers.keys(),\n      ...this.projectLocks.keys(),\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `this.recoveringProjects.has(key)·||·this.projectOperations.has(key)·||` with `⏎······this.recoveringProjects.has(key)·||⏎······this.projectOperations.has(key)·||⏎·····`","line":60,"column":9,"nodeType":null,"messageId":"replace","endLine":60,"endColumn":79,"fix":{"range":[2534,2604],"text":"\n      this.recoveringProjects.has(key) ||\n      this.projectOperations.has(key) ||\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `········loaded.some(value·=>·projectPathIdentity(value)·===·key))` with `······loaded.some(value·=>·projectPathIdentity(value)·===·key)⏎····)⏎·····`","line":61,"column":1,"nodeType":null,"messageId":"replace","endLine":61,"endColumn":66,"fix":{"range":[2647,2712],"text":"      loaded.some(value => projectPathIdentity(value) === key)\n    )\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·return·await·action();·}·finally·{·this.recoveringProjects.delete(key);` with `⏎······return·await·action();⏎····}·finally·{⏎······this.recoveringProjects.delete(key);⏎···`","line":63,"column":10,"nodeType":null,"messageId":"replace","endLine":63,"endColumn":82,"fix":{"range":[2812,2884],"text":"\n      return await action();\n    } finally {\n      this.recoveringProjects.delete(key);\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `projectPath:·string,·action:·()·=>·Promise<T>` with `⏎····projectPath:·string,⏎····action:·()·=>·Promise<T>⏎··`","line":68,"column":43,"nodeType":null,"messageId":"replace","endLine":68,"endColumn":88,"fix":{"range":[3009,3054],"text":"\n    projectPath: string,\n    action: () => Promise<T>\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":69,"column":71,"nodeType":null,"messageId":"insert","endLine":69,"endColumn":71,"fix":{"range":[3140,3140],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·process.platform·===·'win32'·?·path.resolve(projectPath).toLowerCase()` with `⏎······process.platform·===·'win32'⏎········?·path.resolve(projectPath).toLowerCase()⏎·······`","line":70,"column":16,"nodeType":null,"messageId":"replace","endLine":70,"endColumn":87,"fix":{"range":[3205,3276],"text":"\n      process.platform === 'win32'\n        ? path.resolve(projectPath).toLowerCase()\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·return·await·next;·}⏎····finally·{·if·(this.configurationActivations.get(key)·===·next)·this.configurationActivations.delete(key);` with `⏎······return·await·next;⏎····}·finally·{⏎······if·(this.configurationActivations.get(key)·===·next)⏎········this.configurationActivations.delete(key);⏎···`","line":74,"column":10,"nodeType":null,"messageId":"replace","endLine":75,"endColumn":110,"fix":{"range":[3513,3644],"text":"\n      return await next;\n    } finally {\n      if (this.configurationActivations.get(key) === next)\n        this.configurationActivations.delete(key);\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `.createHash('sha256').update(JSON.stringify(config.merged))` with `⏎········.createHash('sha256')⏎········.update(JSON.stringify(config.merged))⏎········`","line":82,"column":28,"nodeType":null,"messageId":"replace","endLine":82,"endColumn":87,"fix":{"range":[3972,4031],"text":"\n        .createHash('sha256')\n        .update(JSON.stringify(config.merged))\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `this.pathResolver.resolveProjectRuntimeDir(projectPath),·'configuration-activation.json'` with `⏎········this.pathResolver.resolveProjectRuntimeDir(projectPath),⏎········'configuration-activation.json'⏎······`","line":83,"column":30,"nodeType":null,"messageId":"replace","endLine":83,"endColumn":118,"fix":{"range":[4076,4164],"text":"\n        this.pathResolver.resolveProjectRuntimeDir(projectPath),\n        'configuration-activation.json'\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·········`","line":87,"column":82,"nodeType":null,"messageId":"insert","endLine":87,"endColumn":82,"fix":{"range":[4400,4400],"text":"\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······catch·(error)·{·if·((error·as·NodeJS.ErrnoException).code·!==·'ENOENT')·throw·new·Error('CONFIGURATION_ACTIVATION_CORRUPT');` with `·catch·(error)·{⏎········if·((error·as·NodeJS.ErrnoException).code·!==·'ENOENT')⏎··········throw·new·Error('CONFIGURATION_ACTIVATION_CORRUPT');⏎·····`","line":88,"column":8,"nodeType":null,"messageId":"replace","endLine":89,"endColumn":131,"fix":{"range":[4461,4592],"text":" catch (error) {\n        if ((error as NodeJS.ErrnoException).code !== 'ENOENT')\n          throw new Error('CONFIGURATION_ACTIVATION_CORRUPT');\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `previous·&&·(previous.schema_version·!==·'1.0'·||·!/^[a-f0-9]{64}$/.test(previous.sha256)))` with `⏎········previous·&&⏎········(previous.schema_version·!==·'1.0'·||·!/^[a-f0-9]{64}$/.test(previous.sha256))⏎······)⏎·······`","line":90,"column":11,"nodeType":null,"messageId":"replace","endLine":90,"endColumn":102,"fix":{"range":[4605,4696],"text":"\n        previous &&\n        (previous.schema_version !== '1.0' || !/^[a-f0-9]{64}$/.test(previous.sha256))\n      )\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `sm.listWorkItems().some(item·=>·!['closed',·'rejected',·'superseded'].includes(item.current_state))` with `⏎··········sm⏎············.listWorkItems()⏎············.some(item·=>·!['closed',·'rejected',·'superseded'].includes(item.current_state))⏎········`","line":96,"column":13,"nodeType":null,"messageId":"replace","endLine":96,"endColumn":112,"fix":{"range":[5073,5172],"text":"\n          sm\n            .listWorkItems()\n            .some(item => !['closed', 'rejected', 'superseded'].includes(item.current_state))\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'CONFIGURATION_CHANGE_BLOCKED_ACTIVE_WORK:·restore·the·accepted·configuration·before·continuing'` with `⏎············'CONFIGURATION_CHANGE_BLOCKED_ACTIVE_WORK:·restore·