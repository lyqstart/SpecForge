taxKind.ImportKeyword·||⏎··········(ts.isIdentifier(node.expression)·&&·node.expression.text·===·'require'))⏎······)`","line":197,"column":11,"nodeType":null,"messageId":"replace","endLine":197,"endColumn":169,"fix":{"range":[13636,13794],"text":"\n        ts.isCallExpression(node) &&\n        (node.expression.kind === ts.SyntaxKind.ImportKeyword ||\n          (ts.isIdentifier(node.expression) && node.expression.text === 'require'))\n      )"}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":198,"column":64,"nodeType":"TSNonNullExpression","messageId":"unnecessaryAssertion","endLine":198,"endColumn":82,"fix":{"range":[13877,13878],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·········`","line":198,"column":84,"nodeType":null,"messageId":"insert","endLine":198,"endColumn":84,"fix":{"range":[13880,13880],"text":"\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `path.posix.normalize(path.posix.join(path.posix.dirname(name),·specifier))` with `⏎········path.posix.normalize(path.posix.join(path.posix.dirname(name),·specifier))⏎······`","line":207,"column":35,"nodeType":null,"messageId":"replace","endLine":207,"endColumn":109,"fix":{"range":[14257,14331],"text":"\n        path.posix.normalize(path.posix.join(path.posix.dirname(name), specifier))\n      "}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":212,"column":54,"nodeType":"TSNonNullExpression","messageId":"unnecessaryAssertion","endLine":212,"endColumn":62,"fix":{"range":[14529,14530],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·`","line":212,"column":65,"nodeType":null,"messageId":"insert","endLine":212,"endColumn":65,"fix":{"range":[14533,14533],"text":"\n "}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":212,"column":104,"nodeType":"TSNonNullExpression","messageId":"unnecessaryAssertion","endLine":212,"endColumn":112,"fix":{"range":[14579,14580],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·sources:·[...found.values()],·inputPaths:·[...new·Set([...found.keys(),·...metadata])].sort()` with `⏎····sources:·[...found.values()],⏎····inputPaths:·[...new·Set([...found.keys(),·...metadata])].sort(),⏎·`","line":213,"column":11,"nodeType":null,"messageId":"replace","endLine":213,"endColumn":105,"fix":{"range":[14593,14687],"text":"\n    sources: [...found.values()],\n    inputPaths: [...new Set([...found.keys(), ...metadata])].sort(),\n "}}],"suppressedMessages":[],"errorCount":97,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":96,"fixableWarningCount":0,"source":"import { SPEC_DIR_NAME } from \"@specforge/types/directory-layout\";\n/** Finite Task command grammar and conservative proof for single-file isolation normalization. */\nimport path from 'node:path';\nimport { createHash } from 'node:crypto';\nimport ts from 'typescript';\nimport { readVerificationFile } from './owner-store';\nimport { isStaticTaskDeclaration, compileStaticTaskCommand, collectStaticTaskInputs } from './static-task-command';\n\nexport const NODE_COMMAND_CONTRACT = 'readonly-node-command/v1' as const;\nexport interface FrozenNodeSource { path: string; content: string; sha256: string; }\nexport interface NodeCommandPlan {\n  contract: typeof NODE_COMMAND_CONTRACT;\n  original: string;\n  kind: 'node-test-file' | 'node-inline';\n  argv: string[];\n  entry: string | null;\n  inlineSource: string | null;\n  semanticProof: { rule: 'single-file-no-host-observation/v1'|'finite-posix-readonly-predicate/v1'; inputHashes: Record<string, string> };\n}\n\nconst fail = (reason: string): never => { throw new Error(`NODE_COMMAND_UNSUPPORTED:${reason}`); };\nconst hash = (text: string): string => createHash('sha256').update(text).digest('hex');\nconst commonFlags = ['--no-addons', '--preserve-symlinks', '--preserve-symlinks-main'];\nconst forbiddenNames = new Set(['globalThis', 'global', 'Date', 'performance', 'crypto', 'Buffer', 'eval', 'Function',\n  '__dirname', '__filename', 'WeakRef', 'FinalizationRegistry', 'Atomics', 'SharedArrayBuffer', 'Intl', 'navigator',\n  'setTimeout', 'setInterval', 'setImmediate', 'queueMicrotask', 'fetch', 'WebAssembly', 'Proxy', 'Reflect', 'Object']);\nconst forbiddenProperties = new Set(['constructor', '__proto__', 'prototype', 'getPrototypeOf', 'setPrototypeOf',\n  'getOwnPropertyDescriptor', 'getOwnPropertyDescriptors', 'getOwnPropertyNames', 'getOwnPropertySymbols',\n  '__defineGetter__', '__defineSetter__', '__lookupGetter__', '__lookupSetter__', 'caller', 'callee', 'arguments', 'stack', 'random',\n  'execArgv', 'argv', 'env', 'pid', 'ppid', 'main', 'parent', 'children', 'filename', 'resolve', 'cache',\n  'timeout', 'concurrency', 'skip', 'only', 'todo', 'run', 'mock', 'before', 'after', 'beforeEach', 'afterEach']);\nconst pureGlobals = new Set(['undefined', 'NaN', 'Infinity', 'String', 'Number', 'Boolean', 'BigInt', 'Math',\n  'JSON', 'Array', 'RegExp']);\nconst builtins = new Set(['node:test', 'node:assert/strict']);\nconst inlineVirtualPath = '__sf_verification_inline.cjs';\n\n/** Quoting groups exact literals. No shell expansion, escaping or command operators are evaluated. */\nexport function tokenizeNodeDeclaration(command: string): string[] {\n  if (!command || command.length > 32768 || /[\\x00-\\x1f\\x7f$`]/.test(command)) fail('DECLARATION');\n  const tokens: string[] = [];\n  let token = '', quote = '', started = false, closedQuote = false;\n  for (const char of command) {\n    if (quote) { if (char === quote) { quote = ''; closedQuote = true; } else token += char; started = true; continue; }\n    if (closedQuote && !/\\s/.test(char)) fail('CONCATENATED_QUOTING');\n    if (char === '\"' || char === \"'\") { if (started) fail('CONCATENATED_QUOTING'); quote = char; started = true; }\n    else if (/\\s/.test(char)) { if (started) { tokens.push(token); token = ''; started = false; closedQuote = false; } }\n    else { if (/[;&|<>`$%\\\\]/.test(char)) fail('SHELL_SYNTAX'); token += char; started = true; }\n  }\n  if (quote) fail('UNTERMINATED_QUOTE');\n  if (started) tokens.push(token);\n  return tokens;\n}\n\nfunction sourcePath(value: string): string {\n  if (!value || value.includes('\\\\') || value.includes(':') || path.posix.isAbsolute(value) ||\n      value.split('/').some(p => !p || p === '..' || p === '.') || !/\\.(?:[cm]?js|ts)$/.test(value)) fail('SOURCE_PATH');\n  return value;\n}\n\nexport function compileNodeCommand(original: string, sources: readonly FrozenNodeSource[]): NodeCommandPlan {\n  if(isStaticTaskDeclaration(original))return compileStaticTaskCommand(original,sources);\n  const argv = tokenizeNodeDeclaration(original);\n  if (argv[0] !== 'node' || argv.length !== 3 || !['--test', '-e'].includes(argv[1]!)) fail('FIXED_NODE_GRAMMAR');\n  const kind = argv[1] === '--test' ? 'node-test-file' : 'node-inline';\n  const entry = kind === 'node-test-file' ? sourcePath(argv[2]!) : null;\n  const inlineSource = kind === 'node-inline' ? argv[2]! : null;\n  const byPath = new Map<string, FrozenNodeSource>();\n  for (const source of sources) {\n    const key = sourcePath(source.path);\n    if (byPath.has(key) || hash(source.content) !== source.sha256) fail('SOURCE_IDENTITY');\n    byPath.set(key, source);\n  }\n  const visited = new Set<string>(), inputHashes: Record<string, string> = {};\n  function dependency(specifier: string, owner: string): void {\n    if (builtins.has(specifier)) return;\n    if (!specifier.startsWith('./') && !specifier.startsWith('../')) fail('DEPENDENCY');\n    const resolved = path.posix.normalize(path.posix.join(path.posix.dirname(owner), specifier));\n    sourcePath(resolved);\n    if (inlineSource !== null && resolved === inlineVirtualPath) fail('INLINE_INPUT_COLLISION');\n    inspect(resolved);\n  }\n  function inspect(name: string, inline?: string): void {\n    if (visited.has(name)) return;\n    visited.add(name);\n    const source = inline === undefined ? byPath.get(name) : undefined;\n    if (inline === undefined && !source) fail('SOURCE_MISSING:' + name);\n    const content = inline ?? source!.content;\n    if (source) inputHashes[name] = source.sha256;\n    const virtualName = '/__specforge_frozen__/' + name;\n    const file = ts.createSourceFile(virtualName, content, ts.ScriptTarget.Latest, true,\n      name.endsWith('.ts') ? ts.ScriptKind.TS : ts.ScriptKind.JS);\n    if ((file as ts.SourceFile & { parseDiagnostics: readonly ts.Diagnostic[] }).parseDiagnostics.length) fail('SOURCE_SYNTAX');\n    const options: ts.CompilerOptions = { noLib:true,noResolve:true,allowJs:true,target:ts.ScriptTarget.Latest };\n    const host: ts.CompilerHost = {\n      getSourceFile:fileName=>fileName===virtualName?file:undefined,writeFile:()=>{},\n      getDefaultLibFileName:()=>'/__no_lib__.d.ts',getCurrentDirectory:()=>'/__specforge_frozen__',\n      getDirectories:()=>[],directoryExists:()=>false,fileExists:fileName=>fileName===virtualName,\n      readFile:fileName=>fileName===virtualName?content:undefined,getCanonicalFileName:name=>name,\n      useCaseSensitiveFileNames:()=>true,getNewLine:()=> '\\n',realpath:name=>name,\n    };\n    const checker = ts.createProgram([virtualName],options,host).getTypeChecker();\n    const locallyBound = (node:ts.Identifier):boolean => ((ts.isShorthandPropertyAssignment(node.parent)?\n      checker.getShorthandAssignmentValueSymbol(node.parent):checker.getSymbolAtLocation(node))?.declarations??[]).some(d=>\n      d.getSourceFile()===file && (ts.isVariableDeclaration(d)||ts.isBindingElement(d)||ts.isParameter(d)||\n        ts.isFunctionDeclaration(d)||ts.isFunctionExpression(d)||ts.isImportClause(d)||ts.isImportSpecifier(d)||ts.isNamespaceImport(d)));\n    function visit(node: ts.Node): void {\n      if ([ts.SyntaxKind.MetaProperty, ts.SyntaxKind.ElementAccessExpression, ts.SyntaxKind.NewExpression,\n        ts.SyntaxKind.ThisKeyword, ts.SyntaxKind.SuperKeyword, ts.SyntaxKind.WithStatement,\n        ts.SyntaxKind.AwaitExpression, ts.SyntaxKind.YieldExpression, ts.SyntaxKind.ClassDeclaration, ts.SyntaxKind.ClassExpression,\n        ts.SyntaxKind.EnumDeclaration, ts.SyntaxKind.ModuleDeclaration, ts.SyntaxKind.AsyncKeyword,\n        ts.SyntaxKind.ImportEqualsDeclaration, ts.SyntaxKind.ComputedPropertyName, ts.SyntaxKind.DeclareKeyword].includes(node.kind)) fail('HOST_OBSERVATION_OR_UNSUPPORTED_SYNTAX');\n      if (ts.isImportClause(node)&&node.isTypeOnly||ts.isImportSpecifier(node)&&node.isTypeOnly) fail('TYPE_ONLY_RUNTIME_BINDING');\n      if (ts.isImportDeclaration(node) || ts.isExportDeclaration(node)) {\n        const specifier = node.moduleSpecifier;\n        if (specifier) {\n          if (!ts.isStringLiteral(specifier)) fail('DYNAMIC_MODULE');\n          dependency((specifier as ts.StringLiteral).text, name);\n        }\n        if (ts.isImportDeclaration(node) && ts.isStringLiteral(node.moduleSpecifier) && node.moduleSpecifier.text === 'node:test') {\n          const bindings = node.importClause?.namedBindings;\n          if (bindings && (!ts.isNamedImports(bindings) || bindings.elements.some(e => (e.propertyName ?? e.name).text !== 'test'))) fail('TEST_HOOK_OR_CONTEXT');\n        }\n      }\n      if (ts.isCallExpression(node) && (node.expression.kind === ts.SyntaxKind.ImportKeyword ||\n          ts.isIdentifier(node.expression) && node.expression.text === 'require')) {\n        if (node.arguments.length !== 1 || !ts.isStringLiteral(node.arguments[0]!)) fail('DYNAMIC_MODULE');\n        dependency((node.arguments[0] as ts.StringLiteral).text, name);\n      }\n      if (ts.isPropertyAccessExpression(node)) {\n        if (forbiddenProperties.has(node.name.text)) fail('OBSERVABLE_PROPERTY:' + node.name.text);\n        if (ts.isIdentifier(node.expression) && node.expression.text === 'process' &&\n            (inline === undefined || node.name.text !== 'exit')) fail('PROCESS_OBSERVATION');\n        if (ts.isIdentifier(node.expression) && node.expression.text === 'console' &&\n            (inline === undefined || node.name.text !== 'log')) fail('CONSOLE_OBSERVATION');\n      }\n      if (ts.isPropertyAssignment(node) && ts.isStringLiteral(node.name) && forbiddenProperties.has(node.name.text)) fail('OBSERVABLE_OPTION');\n      if (ts.isIdentifier(node)) {\n        if (forbiddenNames.has(node.text) || forbiddenProperties.has(node.text)) fail('HOST_GLOBAL_OR_PROPERTY:' + node.text);\n        const parent = node.parent;\n        const property = ts.isPropertyAccessExpression(parent) && parent.name === node ||\n          (ts.isPropertyAssignment(parent) || ts.isMethodDeclaration(parent)) && parent.name === node ||\n          ts.isImportSpecifier(parent) || ts.isExportSpecifier(parent);\n        const calledMember = ts.isPropertyAccessExpression(parent) && parent.expression === node &&\n          ts.isCallExpression(parent.parent) && parent.parent.expression === parent;\n        const special = node.text === 'require' && ts.isCallExpression(parent) && parent.expression === node ||\n          /\\.cjs$/.test(name) && ts.isPropertyAccessExpression(parent) && parent.expression === node &&\n            (node.text === 'module' && parent.name.text === 'exports' || node.text === 'exports') ||\n          inline !== undefined && calledMember &&\n            (node.text === 'process' && parent.name.text === 'exit' || node.text === 'console' && parent.name.text === 'log');\n        if (!property && !special && ['process','console','require','module','exports'].includes(node.text)) fail('HOST_IDENTIFIER_ALIAS:' + node.text);\n        if (!property && !special && !locallyBound(node) && !pureGlobals.has(node.text)) fail('UNBOUND_OR_HOST_IDENTIFIER:' + node.text);\n      }\n      if (ts.isBindingElement(node) && node.propertyName && ts.isStringLiteral(node.propertyName) &&\n          forbiddenProperties.has(node.propertyName.text)) fail('DESTRUCTURED_HOST_PROPERTY');\n      ts.forEachChild(node, visit);\n    }\n    visit(file);\n  }\n  if (entry) inspect(entry); else inspect(inlineVirtualPath, inlineSource!);\n  return { contract: NODE_COMMAND_CONTRACT, original, kind, entry, inlineSource,\n    argv: kind === 'node-test-file' ? [...commonFlags, '--test-reporter=tap', '--test', '--test-isolation=none', entry!] :\n      [...commonFlags, '-e', inlineSource!], semanticProof: { rule: 'single-file-no-host-observation/v1', inputHashes } };\n}\n\n/** Discover only literal local code imports and required package metadata, never all project contents. */\nexport async function collectNodeCommandInputs(projectRoot: string, original: string, trackedPaths: readonly string[]): Promise<{\n  sources: FrozenNodeSource[]; inputPaths: string[];\n}> {\n  if(isStaticTaskDeclaration(original))return collectStaticTaskInputs(projectRoot,original,trackedPaths);\n  const args = tokenizeNodeDeclaration(original), tracked = new Set(trackedPaths), found = new Map<string, FrozenNodeSource>();\n  const metadata = new Set<string>();\n  if (args.length !== 3 || args[0] !== 'node' || !['--test', '-e'].includes(args[1]!)) fail('FIXED_NODE_GRAMMAR');\n  async function inspect(name: string, inline?: string): Promise<void> {\n    if (found.has(name)) return;\n    let text = inline;\n    if (inline === undefined) {\n      sourcePath(name);\n      if (name.split('/').some(p => ['.git', SPEC_DIR_NAME, 'node_modules'].includes(p.toLowerCase())) || !tracked.has(name)) fail('INPUT_NOT_TRACKED_CODE');\n      const raw = await readVerificationFile(path.join(projectRoot, name));\n      text = raw.toString('utf8');\n      if (!Buffer.from(text).equals(raw)) fail('SOURCE_ENCODING');\n      found.set(name, { path: name, content: text, sha256: hash(text) });\n      if (found.size > 2048) fail('INPUT_COUNT');\n    }\n    for (let directory = path.posix.dirname(name);; directory = path.posix.dirname(directory)) {\n      const pkg = path.posix.join(directory, 'package.json');\n      if (tracked.has(pkg)) metadata.add(pkg);\n      if (directory === '.') break;\n    }\n    const file = ts.createSourceFile(name, text!, ts.ScriptTarget.Latest, true, name.endsWith('.ts') ? ts.ScriptKind.TS : ts.ScriptKind.JS);\n    const dependencies: string[] = [];\n    function scan(node: ts.Node): void {\n      if ((ts.isImportDeclaration(node) || ts.isExportDeclaration(node)) && node.moduleSpecifier) {\n        if (!ts.isStringLiteral(node.moduleSpecifier)) fail('DYNAMIC_MODULE');\n        dependencies.push((node.moduleSpecifier as ts.StringLiteral).text);\n      }\n      if (ts.isCallExpression(node) && (node.expression.kind === ts.SyntaxKind.ImportKeyword || ts.isIdentifier(node.expression) && node.expression.text === 'require')) {\n        if (node.arguments.length !== 1 || !ts.isStringLiteral(node.arguments[0]!)) fail('DYNAMIC_MODULE');\n        dependencies.push((node.arguments[0] as ts.StringLiteral).text);\n      }\n      ts.forEachChild(node, scan);\n    }\n    scan(file);\n    for (const specifier of dependencies) {\n      if (builtins.has(specifier)) continue;\n      if (!specifier.startsWith('./') && !specifier.startsWith('../')) fail('DEPENDENCY');\n      const resolved = sourcePath(path.posix.normalize(path.posix.join(path.posix.dirname(name), specifier)));\n      if (args[1] === '-e' && resolved === inlineVirtualPath) fail('INLINE_INPUT_COLLISION');\n      await inspect(resolved);\n    }\n  }\n  if (args[1] === '--test') await inspect(sourcePath(args[2]!)); else await inspect(inlineVirtualPath, args[2]!);\n  return { sources: [...found.values()], inputPaths: [...new Set([...found.keys(), ...metadata])].sort() };\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\verification\\owner-store.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·'plan'·|·'receipt'·|·'revocation'·|·'invocation'·|·'attempt'·|·'start'·|·'recovery'` with `⏎··|·'plan'⏎··|·'receipt'⏎··|·'revocation'⏎··|·'invocation'⏎··|·'attempt'⏎··|·'start'⏎··|·'recovery'⏎·`","line":7,"column":37,"nodeType":null,"messageId":"replace","endLine":7,"endColumn":121,"fix":{"range":[372,456],"text":"\n  | 'plan'\n  | 'receipt'\n  | 'revocation'\n  | 'invocation'\n  | 'attempt'\n  | 'start'\n  | 'recovery'\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'plan',·'receipt',·'revocation',·'invocation',·'attempt',·'start',·'recovery',·'lease'` with `⏎··'plan',⏎··'receipt',⏎··'revocation',⏎··'invocation',⏎··'attempt',⏎··'start',⏎··'recovery',⏎··'lease',⏎`","line":9,"column":48,"nodeType":null,"messageId":"replace","endLine":9,"endColumn":134,"fix":{"range":[592,678],"text":"\n  'plan',\n  'receipt',\n  'revocation',\n  'invocation',\n  'attempt',\n  'start',\n  'recovery',\n  'lease',\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":14,"column":81,"nodeType":null,"messageId":"insert","endLine":14,"endColumn":81,"fix":{"range":[966,966],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `typeof·value·===·'object'·&&·value·!==·null·&&·Object.getPrototypeOf(value)·===·Object.prototype` with `⏎····typeof·value·===·'object'·&&⏎····value·!==·null·&&⏎····Object.getPrototypeOf(value)·===·Object.prototype⏎··`","line":17,"column":7,"nodeType":null,"messageId":"replace","endLine":17,"endColumn":103,"fix":{"range":[1187,1283],"text":"\n    typeof value === 'object' &&\n    value !== null &&\n    Object.getPrototypeOf(value) === Object.prototype\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'{'·+·Object.keys(obj).sort().map(k·=>·JSON.stringify(k)·+·':'·+·canonicalVerificationJson(obj[k])).join(',')·+·'}'` with `(⏎······'{'·+⏎······Object.keys(obj)⏎········.sort()⏎········.map(k·=>·JSON.stringify(k)·+·':'·+·canonicalVerificationJson(obj[k]))⏎········.join(',')·+⏎······'}'⏎····)`","line":19,"column":12,"nodeType":null,"messageId":"replace","endLine":19,"endColumn":127,"fix":{"range":[1348,1463],"text":"(\n      '{' +\n      Object.keys(obj)\n        .sort()\n        .map(k => JSON.stringify(k) + ':' + canonicalVerificationJson(obj[k]))\n        .join(',') +\n      '}'\n    )"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":26,"column":39,"nodeType":null,"messageId":"insert","endLine":26,"endColumn":39,"fix":{"range":[1746,1746],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `·`","line":27,"column":31,"nodeType":null,"messageId":"insert","endLine":27,"endColumn":31,"fix":{"range":[1803,1803],"text":" "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·······`","line":37,"column":49,"nodeType":null,"messageId":"insert","endLine":37,"endColumn":49,"fix":{"range":[2198,2198],"text":"\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·······`","line":38,"column":56,"nodeType":null,"messageId":"insert","endLine":38,"endColumn":56,"fix":{"range":[2310,2310],"text":"\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `file:·string,·limit·=·16·*·1024·*·1024` with `⏎··file:·string,⏎··limit·=·16·*·1024·*·1024⏎`","line":47,"column":44,"nodeType":null,"messageId":"replace","endLine":47,"endColumn":82,"fix":{"range":[2660,2698],"text":"\n  file: string,\n  limit = 16 * 1024 * 1024\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":52,"column":80,"nodeType":null,"messageId":"insert","endLine":52,"endColumn":80,"fix":{"range":[2943,2943],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·after·=·await·handle.stat({·bigint:·true·}),` with `⏎······after·=·await·handle.stat({·bigint:·true·}),⏎·····`","line":53,"column":43,"nodeType":null,"messageId":"replace",