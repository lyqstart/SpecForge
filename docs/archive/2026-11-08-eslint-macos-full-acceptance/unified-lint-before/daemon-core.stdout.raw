":2,"message":"Delete `·`","line":341,"column":5,"nodeType":null,"messageId":"delete","endLine":341,"endColumn":6,"fix":{"range":[10399,10400],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":343,"column":5,"nodeType":null,"messageId":"delete","endLine":343,"endColumn":6,"fix":{"range":[10456,10457],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·sessionId` with `⏎··········sessionId,⏎·······`","line":357,"column":89,"nodeType":null,"messageId":"replace","endLine":357,"endColumn":99,"fix":{"range":[10923,10933],"text":"\n          sessionId,\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":362,"column":62,"nodeType":null,"messageId":"delete","endLine":362,"endColumn":63,"fix":{"range":[11164,11165],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":377,"column":5,"nodeType":null,"messageId":"delete","endLine":377,"endColumn":6,"fix":{"range":[11402,11403],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":379,"column":5,"nodeType":null,"messageId":"delete","endLine":379,"endColumn":6,"fix":{"range":[11468,11469],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":382,"column":5,"nodeType":null,"messageId":"delete","endLine":382,"endColumn":6,"fix":{"range":[11606,11607],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":401,"column":5,"nodeType":null,"messageId":"delete","endLine":401,"endColumn":6,"fix":{"range":[12178,12179],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":404,"column":5,"nodeType":null,"messageId":"delete","endLine":404,"endColumn":6,"fix":{"range":[12310,12311],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······.filter(s·=>·s.workItemId·===·workItemId);` with `.filter(⏎······s·=>·s.workItemId·===·workItemId`","line":410,"column":70,"nodeType":null,"