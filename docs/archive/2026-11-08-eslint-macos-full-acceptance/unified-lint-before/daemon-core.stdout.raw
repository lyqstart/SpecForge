er)·>·63·||⏎······typeof·value.command·!==·'string'⏎····`","line":24,"column":16,"nodeType":null,"messageId":"replace","endLine":24,"endColumn":258,"fix":{"range":[1977,2219],"text":" 'property', 'integration', 'e2e', 'regression'].includes(\n        String(value.verification_type)\n      ) ||\n      !Number.isSafeInteger(value.command_index) ||\n      (value.command_index as number) < 0 ||\n      (value.command_index as number) > 63 ||\n      typeof value.command !== 'string'\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `+label);` with `·+·label);⏎·····`","line":25,"column":50,"nodeType":null,"messageId":"replace","endLine":25,"endColumn":58,"fix":{"range":[2272,2280],"text":" + label);\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `ExecutionEvidenceSubject={receiptId:value.execution_receipt_id,projectRoot:input.projectRoot,workItemId:input.workItemId,taskId:` with `·ExecutionEvidenceSubject·=·{⏎······receiptId:·value.execution_receipt_id,⏎······projectRoot:·input.projectRoot,⏎······workItemId:·input.workItemId,⏎······taskId:·`","line":27,"column":19,"nodeType":null,"messageId":"replace","endLine":27,"endColumn":147,"fix":{"range":[2318,2446],"text":" ExecutionEvidenceSubject = {\n      receiptId: value.execution_receipt_id,\n      projectRoot: input.projectRoot,\n      workItemId: input.workItemId,\n      taskId: "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `value.verification_type·as·string,commandIndex:value.command_index·as·number,command:value.command,purpose:input.purpose??'formal'` with `·value.verification_type·as·string,⏎······commandIndex:·value.command_index·as·number,⏎······command:·value.command,⏎······purpose:·input.purpose·??·'formal',⏎····`","line":28,"column":24,"nodeType":null,"messageId":"replace","endLine":28,"endColumn":154,"fix":{"range":[2484,2614],"text":" value.verification_type as string,\n      commandIndex: value.command_index as number,\n      command: value.command,\n      purpose: input.purpose ?? 'formal',\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·reasons.push('execution_owner_unavailable:'+label);·return·null;` with `⏎······reasons.push('execution_owner_unavailable:'·+·label);⏎······return·null;⏎···`","line":29,"column":27,"nodeType":null,"messageId":"replace","endLine":29,"endColumn":92,"fix":{"range":[2643,2708],"text":"\n      reasons.push('execution_owner_unavailable:' + label);\n      return null;\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=` with `·=·`","line":30,"column":16,"nodeType":null,"messageId":"replace","endLine":30,"endColumn":17,"fix":{"range":[2726,2727],"text":" = "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `!==JSON.stringify(subject))·{·reasons.push('execution_receipt_reused_for_another_subject:'+label);·return·null;` with `·!==·JSON.stringify(subject))·{⏎······reasons.push('execution_receipt_reused_for_another_subject:'·+·label);⏎······return·null;⏎···`","line":31,"column":39,"nodeType":null,"messageId":"replace","endLine":31,"endColumn":150,"fix":{"range":[2798,2909],"text":" !== JSON.stringify(subject)) {\n      reasons.push('execution_receipt_reused_for_another_subject:' + label);\n      return null;\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·if(!prior)·await·input.consumer.consume(subject);·accepted.set(subject.receiptId,subject);·return·subject.receiptId;·}` with `⏎······if·(!prior)·await·input.consumer.consume(subject);⏎······accepted.set(subject.receiptId,·subject);⏎······return·subject.receiptId;`","line":32,"column":10,"nodeType":null,"messageId":"replace","endLine":32,"endColumn":129,"fix":{"range":[2921,3040],"text":"\n      if (!prior) await input.consumer.consume(subject);\n      accepted.set(subject.receiptId, subject);\n      return subject.receiptId;"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·catch·{·reasons.push('execution_receipt_rejected:'+label);·return·null;` with `·}·catch·{⏎······reasons.push('execution_receipt_rejected:'·+·label);⏎······return·null;⏎···`","line":33,"column":4,"nodeType":null,"messageId":"replace","endLine":33,"endColumn":76,"fix":{"range":[3044,3116],"text":" } catch {\n      reasons.push('execution_receipt_rejected:' + label);\n      return null;\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(const·[index,value]` with `·(const·[index,·value]·`","line":35,"column":6,"nodeType":null,"messageId":"replace","endLine":35,"endColumn":26,"fix":{"range":[3128,3148],"text":" (const [index, value] "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(!object(value)||value.status!=='pass')` with `·(!object(value)·||·value.status·!==·'pass')·`","line":36,"column":7,"nodeType":null,"messageId":"replace","endLine":36,"endColumn":46,"fix":{"range":[3179,3218],"text":" (!object(value) || value.status !== 'pass') "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(value.execution_kind===` with `·(value.execution_kind·===·`","line":37,"column":7,"nodeType":null,"messageId":"replace","endLine":37,"endColumn":31,"fix":{"range":[3234,3258],"text":" (value.execution_kind === "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=Array.isArray(value.evidence_refs)?value.evidence_refs:` with `·=·Array.isArray(value.evidence_refs)·?·value.evidence_refs·:·`","line":38,"column":17,"nodeType":null,"messageId":"replace","endLine":38,"endColumn":73,"fix":{"range":[3301,3357],"text":" = Array.isArray(value.evidence_refs) ? value.evidence_refs : "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=['execution_receipt_id','task_id','verification_type','command_index'].some(key=>Object.prototype.hasOwnProperty.call(value,` with `·=·[⏎········'execution_receipt_id',⏎········'task_id',⏎········'verification_type',⏎········'command_index',⏎······].some(key·=>·Object.prototype.hasOwnProperty.call(value,·`","line":39,"column":28,"nodeType":null,"messageId":"replace","endLine":39,"endColumn":153,"fix":{"range":[3388,3513],"text":" = [\n        'execution_receipt_id',\n        'task_id',\n        'verification_type',\n        'command_index',\n      ].some(key => Object.prototype.hasOwnProperty.call(value, "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(claimsExecution||typeof·value.command!=='string'||!value.command.startsWith('manual:')||refs.length===0||!manifest||refs.some(id=>!entries.some(e=>object(e)&&(e.evidence_id??e.id)===id&&e.status==='passed'&&e.evidence_type==='manual_acceptance')))reasons.push('manual_observation_reference_invalid:'+` with `·(⏎········claimsExecution·||⏎········typeof·value.command·!==·'string'·||⏎········!value.command.startsWith('manual:')·||⏎········refs.length·===·0·||⏎········!manifest·||⏎········refs.some(⏎··········id·=>⏎············!entries.some(⏎··············e·=>⏎················object(e)·&&⏎················(e.evidence_id·??·e.id)·===·id·&&⏎················e.status·===·'passed'·&&⏎················e.evidence_type·===·'manual_acceptance'⏎············)⏎········)⏎······)⏎········reasons.push('manual_observation_reference_invalid:'·+·`","line":40,"column":9,"nodeType":null,"messageId":"replace","endLine":40,"endColumn":310,"fix":{"range":[3528,3829],"text":" (\n        claimsExecution ||\n        typeof value.command !== 'string' ||\n        !value.command.startsWith('manual:') ||\n        refs.length === 0 ||\n        !manifest ||\n        refs.some(\n          id =>\n            !entries.some(\n              e =>\n                object(e) &&\n                (e.evidence_id ?? e.id) === id &&\n                e.status === 'passed' &&\n                e.evidence_type === 'manual_acceptance'\n            )\n        )\n      )\n        reasons.push('manual_observation_reference_invalid:' + "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=await·inspect(value,'command-'+index);if(id){if(commandIds.has(id))reasons.push('execution_receipt_duplicate_command:'+index);commandIds.add(id);` with `·=·await·inspect(value,·'command-'·+·index);⏎····if·(id)·{⏎······if·(commandIds.has(id))·reasons.push('execution_receipt_duplicate_command:'·+·index);⏎······commandIds.add(id);⏎····`","line":43,"column":13,"nodeType":null,"messageId":"replace","endLine":43,"endColumn":159,"fix":{"range":[3871,4017],"text":" = await inspect(value, 'command-' + index);\n    if (id) {\n      if (commandIds.has(id)) reasons.push('execution_receipt_duplicate_command:' + index);\n      commandIds.add(id);\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(const·[index,value]` with `·(const·[index,·value]·`","line":45,"column":6,"nodeType":null,"messageId":"replace","endLine":45,"endColumn":26,"fix":{"range":[4028,4048],"text":" (const [index, value] "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(!object(value)||value.execution_receipt_id===undefined)` with `·(!object(value)·||·value.execution_receipt_id·===·undefined)·`","line":46,"column":7,"nodeType":null,"messageId":"replace","endLine":46,"endColumn":63,"fix":{"range":[4078,4134],"text":" (!object(value) || value.execution_receipt_id === undefined) "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=await·inspect(value,'evidence-'+` with `·=·await·inspect(value,·'evidence-'·+·`","line":47,"column":13,"nodeType":null,"messageId":"replace","endLine":47,"endColumn":46,"fix":{"range":[4156,4189],"text":" = await inspect(value, 'evidence-' + "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(id){evidenceIds.add(id);if(value.path!=='verification-owner:receipt:'+id||value.hash!=='sha256:'+id||value.hash_domain!=='canonical-json:verification-execution/v1'||value.status!=='passed')reasons.push('execution_evidence_identity_invalid:'+index);` with `·(id)·{⏎······evidenceIds.add(id);⏎······if·(⏎········value.path·!==·'verification-owner:receipt:'·+·id·||⏎········value.hash·!==·'sha256:'·+·id·||⏎········value.hash_domain·!==·'canonical-json:verification-execution/v1'·||⏎········value.status·!==·'passed'⏎······)⏎········reasons.push('execution_evidence_identity_invalid:'·+·index);⏎····`","line":48,"column":7,"nodeType":null,"messageId":"replace","endLine":48,"endColumn":256,"fix":{"range":[4203,4452],"text":" (id) {\n      evidenceIds.add(id);\n      if (\n        value.path !== 'verification-owner:receipt:' + id ||\n        value.hash !== 'sha256:' + id ||\n        value.hash_domain !== 'canonical-json:verification-execution/v1' ||\n        value.status !== 'passed'\n      )\n        reasons.push('execution_evidence_identity_invalid:' + index);\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(report&&manifest)for(const·id·of·commandIds)if(!evidenceIds.has(id))reasons.push('execution_receipt_missing_from_manifest:'+` with `·(report·&&·manifest)⏎····for·(const·id·of·commandIds)⏎······if·(!evidenceIds.has(id))·reasons.push('execution_receipt_missing_from_manifest:'·+·`","line":50,"column":5,"nodeType":null,"messageId":"replace","endLine":50,"endColumn":130,"fix":{"range":[4462,4587],"text":" (report && manifest)\n    for (const id of commandIds)\n      if (!evidenceIds.has(id)) reasons.push('execution_receipt_missing_from_manifest:' + "}}],"suppressedMessages":[],"errorCount":36,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":36,"fixableWarningCount":0,"source":"/** One contract for Report, Evidence, Verification, Formal Version and Close. */\nimport type { VerificationExecutionReceipt } from './verification-plan';\nexport interface ExecutionEvidenceSubject {\n  receiptId:string;projectRoot:string;workItemId:string;taskId:string;verificationType:string;\n  commandIndex:number;command:string;purpose:'implementation'|'formal';\n}\nexport interface ExecutionEvidenceConsumer { consume(input:ExecutionEvidenceSubject):Promise<VerificationExecutionReceipt>; }\nconst object = (value:unknown):value is Record<string,unknown> => !!value && typeof value==='object' && !Array.isArray(value);\nconst digest = (value:unknown):value is string => typeof value==='string' && /^[a-f0-9]{64}$/.test(value);\n\nexport async function inspectExecutionEvidence(input:{\n  projectRoot:string;workItemId:string;report?:unknown;manifest?:unknown;consumer?:ExecutionEvidenceConsumer;\n  purpose?:'implementation'|'formal';historicalClosed?:boolean;\n}):Promise<string[]> {\n  const reasons:string[] = [], report = object(input.report)?input.report:null, manifest=object(input.manifest)?input.manifest:null;\n  const commands = report && Array.isArray(report.verification_commands)?report.verification_commands:[];\n  const entries = manifest && Array.isArray(manifest.entries)?manifest.entries:[];\n  // This is a live acceptance check. Post-close drift alone cannot prove a defect existed at the original Close.\n  // Retrospective recovery needs its closure-time immutable evidence; the existing historical owner retains that duty.\n  if (input.historicalClosed) return reasons;\n  const accepted = new Map<string,ExecutionEvidenceSubject>(), commandIds = new Set<string>(), evidenceIds = new Set<string>();\n  async function inspect(value:unknown,label:string):Promise<string|null> {\n    if (!object(value) || !digest(value.execution_receipt_id) || typeof value.task_id!=='string' || !new RegExp('^TASK-'+input.workItemId+'-[0-9]{3}$').test(value.task_id) ||\n      !['unit','property','integration','e2e','regression'].includes(String(value.verification_type)) || !Number.isSafeInteger(value.command_index) || (value.command_index as number)<0 || (value.command_index as number)>63 || typeof value.command!=='string') {\n      reasons.push('execution_reference_invalid:'+label); return null;\n    }\n    const subject:ExecutionEvidenceSubject={receiptId:value.execution_receipt_id,projectRoot:input.projectRoot,workItemId:input.workItemId,taskId:value.task_id,\n      verificationType:value.verification_type as string,commandIndex:value.command_index as number,command:value.command,purpose:input.purpose??'formal'};\n    if (!input.consumer) { reasons.push('execution_owner_unavailable:'+label); return null; }\n    const prior=accepted.get(subject.receiptId);\n    if (prior && JSON.stringify(prior)!==JSON.stringify(subject)) { reasons.push('execution_receipt_reused_for_another_subject:'+label); return null; }\n    try { if(!prior) await input.consumer.consume(subject); accepted.set(subject.receiptId,subject); return subject.receiptId; }\n    catch { reasons.push('execution_receipt_rejected:'+label); return null; }\n  }\n  for(const [index,value]of commands.entries()) {\n    if(!object(value)||value.status!=='pass')continue;\n    if(value.execution_kind==='manual-observation/v1') {\n      const refs=Array.isArray(value.evidence_refs)?value.evidence_refs:[];\n      const claimsExecution=['execution_receipt_id','task_id','verification_type','command_index'].some(key=>Object.prototype.hasOwnProperty.call(value,key));\n      if(claimsExecution||typeof value.command!=='string'||!value.command.startsWith('manual:')||refs.length===0||!manifest||refs.some(id=>!entries.some(e=>object(e)&&(e.evidence_id??e.id)===id&&e.status==='passed'&&e.evidence_type==='manual_acceptance')))reasons.push('manual_observation_reference_invalid:'+index);\n      continue;\n    }\n    const id=await inspect(value,'command-'+index);if(id){if(commandIds.has(id))reasons.push('execution_receipt_duplicate_command:'+index);commandIds.add(id);}\n  }\n  for(const [index,value]of entries.entries()) {\n    if(!object(value)||value.execution_receipt_id===undefined)continue;\n    const id=await inspect(value,'evidence-'+index);\n    if(id){evidenceIds.add(id);if(value.path!=='verification-owner:receipt:'+id||value.hash!=='sha256:'+id||value.hash_domain!=='canonical-json:verification-execution/v1'||value.status!=='passed')reasons.push('execution_evidence_identity_invalid:'+index);}\n  }\n  if(report&&manifest)for(const id of commandIds)if(!evidenceIds.has(id))reasons.push('execution_receipt_missing_from_manifest:'+id);\n  return reasons;\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\verification\\invocation-lease.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `TrustedToolInvocationProof` with `·TrustedToolInvocationProof·`","line":2,"column":14,"nodeType":null,"messageId":"replace","endLine":2,"endColumn":40,"fix":{"range":[110,136],"text":" TrustedToolInvocationProof "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `VerificationInvocationLeaseRecord` with `·VerificationInvocationLeaseRecord·`","line":3,"column":14,"nodeType":null,"messageId":"replace","endLine":3,"endColumn":47,"fix":{"range":[200,233],"text":" VerificationInvocationLeaseRecord "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `validateTrustedInvocationProof,verificationRequire·as·requireFact` with `⏎··validateTrustedInvocationProof,⏎··verificationRequire·as·requireFact,⏎`","line":4,"column":9,"nodeType":null,"messageId":"replace","endLine":4,"endColumn":74,"fix":{"range":[271,336],"text":"\n  validateTrustedInvocationProof,\n  verificationRequire as requireFact,\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=` with `·=·`","line":7,"column":22,"nodeType":null,"messageId":"replace","endLine":7,"endColumn":23,"fix":{"range":[433,434],"text":" = "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=` with `·=·`","line":8,"column":17,"nodeType":null,"messageId":"replace","endLine":8,"endColumn":18,"fix":{"range":[473,474],"text":" = "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `string|null=` with `·string·|·null·=·`","line":9,"column":22,"nodeType":null,"messageId":"replace","endLine":9,"endColumn":34,"fix":{"range":[502,514],"text":" string | null = "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=` with `·=·`","line":10,"column":28,"nodeType":null,"messageId":"replace","endL