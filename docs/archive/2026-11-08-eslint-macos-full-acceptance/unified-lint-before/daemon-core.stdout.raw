,"endLine":198,"endColumn":5,"fix":{"range":[6366,6370],"text":"        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····` with `········`","line":199,"column":1,"nodeType":null,"messageId":"replace","endLine":199,"endColumn":5,"fix":{"range":[6399,6403],"text":"        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····` with `········`","line":200,"column":1,"nodeType":null,"messageId":"replace","endLine":200,"endColumn":5,"fix":{"range":[6423,6427],"text":"        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `····`","line":201,"column":1,"nodeType":null,"messageId":"insert","endLine":201,"endColumn":1,"fix":{"range":[6446,6446],"text":"    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `},·null,·2)·+·'\\n'` with `····},⏎······null,⏎······2⏎····)·+·'\\n'⏎··`","line":202,"column":3,"nodeType":null,"messageId":"replace","endLine":202,"endColumn":21,"fix":{"range":[6470,6488],"text":"    },\n      null,\n      2\n    ) + '\\n'\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `path.join(workItemDir,·'candidate_manifest.json'),·JSON.stringify(` with `⏎····path.join(workItemDir,·'candidate_manifest.json'),⏎····JSON.stringify(⏎······`","line":205,"column":20,"nodeType":null,"messageId":"replace","endLine":205,"endColumn":86,"fix":{"range":[6540,6606],"text":"\n    path.join(workItemDir, 'candidate_manifest.json'),\n    JSON.stringify(\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `····`","line":206,"column":5,"nodeType":null,"messageId":"insert","endLine":206,"endColumn":5,"fix":{"range":[6612,6612],"text":"    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····` with `········`","line":207,"column":1,"nodeType":null,"messageId":"replace","endLine":207,"endColumn":5,"fix":{"range":[6635,6639],"text":"        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····` with `········`","line":208,"column":1,"nodeType":null,"messageId":"replace","endLine":208,"endColumn":5,"fix":{"range":[6665,6669],"text":"        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `····`","line":209,"column":5,"nodeType":null,"messageId":"insert","endLine":209,"endColumn":5,"fix":{"range":[6715,6715],"text":"    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `····`","line":210,"column":1,"nodeType":null,"messageId":"insert","endLine":210,"endColumn":1,"fix":{"range":[6751,6751],"text":"    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `····`","line":211,"column":5,"nodeType":null,"messageId":"insert","endLine":211,"endColumn":5,"fix":{"range":[6788,6788],"text":"    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `},·null,·2)·+·'\\n'` with `····},⏎······null,⏎······2⏎····)·+·'\\n'⏎··`","line":212,"column":3,"nodeType":null,"messageId":"replace","endLine":212,"endColumn":21,"fix":{"range":[6803,6821],"text":"    },\n      null,\n      2\n    ) + '\\n'\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `path.join(workItemDir,·'gate_summary.md'),` with `⏎····path.join(workItemDir,·'gate_summary.md'),⏎···`","line":215,"column":20,"nodeType":null,"messageId":"replace","endLine":215,"endColumn":62,"fix":{"range":[6865,6907],"text":"\n    path.join(workItemDir, 'gate_summary.md'),\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····'#·Gate·Summary',` with `······'#·Gate·Summary',⏎·····`","line":216,"column":1,"nodeType":null,"messageId":"replace","endLine":216,"endColumn":22,"fix":{"range":[6910,6931],"text":"      '# Gate Summary',\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":217,"column":5,"nodeType":null,"messageId":"insert","endLine":217,"endColumn":5,"fix":{"range":[6940,6940],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'Overall·Status:·pending',` with `··'Overall·Status:·pending',⏎·····`","line":218,"column":5,"nodeType":null,"messageId":"replace","endLine":218,"endColumn":31,"fix":{"range":[6972,6998],"text":"  'Overall Status: pending',\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····'>·TODO:·由·Gate·Runner·生成',` with `······'>·TODO:·由·Gate·Runner·生成',⏎·····`","line":219,"column":1,"nodeType":null,"messageId":"replace","endLine":219,"endColumn":32,"fix":{"range":[7003,7034],"text":"      '> TODO: 由 Gate Runner 生成',\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `··].join('\\n'));⏎` with `····].join('\\n')⏎··);`","line":220,"column":1,"nodeType":null,"messageId":"replace","endLine":221,"endColumn":1,"fix":{"range":[7039,7056],"text":"    ].join('\\n')\n  );"}}],"suppressedMessages":[],"errorCount":42,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":41,"fixableWarningCount":0,"source":"import { SPEC_DIR_NAME } from \"@specforge/types/directory-layout\";\n/**\n * work-item-lifecycle-v11.ts — v1.1 标准 Work Item 生命周期管理\n *\n * 产品边界：SPS-1.0。当前可执行合同由本模块导出、Runtime 消费者与回归测试固定；归档 v1.1 标准仅作历史证据。\n *\n * 负责：\n * - §4.2 WI 目录创建\n * - §4.4 work_item.json 初始化\n * - §4.5 intake.md 生成\n * - 非 Candidate 闭环文件初始化\n */\n\nimport * as fs from 'node:fs/promises';\nimport * as path from 'node:path';\nimport { WORK_ITEM_METADATA_SCHEMA_VERSION } from './artifact-schema-validation';\nimport { formatWorkItemId, parseWorkItemSequence } from './work-item-id-validator';\nimport { writeWorkItemMetadata, type WorkItemMetadata } from './work-item-metadata';\n\n// ---------------------------------------------------------------------------\n// Work Item 创建\n// ---------------------------------------------------------------------------\n\nexport interface CreateWorkItemInput {\n  projectRoot: string;\n  workItemId: string;\n  userRequest: string;\n  createdBy?: string;\n  workflowType?: string;\n  workflowPath?: string | null;\n}\n\n/** Allocate the next current Work Item identity inside the single Daemon owner. */\nexport async function allocateNextWorkItemId(projectRoot: string): Promise<string> {\n  const workItemsRoot = path.join(projectRoot, SPEC_DIR_NAME, 'work-items');\n  await fs.mkdir(workItemsRoot, { recursive: true });\n\n  let maxSequence = 0;\n  for (const entry of await fs.readdir(workItemsRoot, { withFileTypes: true })) {\n    if (!entry.isDirectory()) continue;\n    const sequence = parseWorkItemSequence(entry.name);\n    if (sequence !== null && sequence > maxSequence) maxSequence = sequence;\n  }\n  return formatWorkItemId(maxSequence + 1);\n}\n\n/**\n * 创建一个新的 Work Item 目录和初始文件（§4.2, §4.4, §4.5）。\n */\nexport async function createWorkItem(input: CreateWorkItemInput): Promise<string> {\n  const wiDir = path.join(input.projectRoot, SPEC_DIR_NAME, 'work-items', input.workItemId);\n\n  // The Work Item root is allocated exactly once. Reusing recursive mkdir here\n  // would let a duplicate create overwrite governed metadata and intake history.\n  await fs.mkdir(path.dirname(wiDir), { recursive: true });\n  try {\n    await fs.mkdir(wiDir);\n  } catch (error) {\n    if ((error as NodeJS.ErrnoException).code === 'EEXIST') {\n      throw new Error(`WORK_ITEM_ALREADY_EXISTS: ${input.workItemId}`);\n    }\n    throw error;\n  }\n  await fs.mkdir(path.join(wiDir, 'candidates'), { recursive: true });\n  await fs.mkdir(path.join(wiDir, 'gates'), { recursive: true });\n  await fs.mkdir(path.join(wiDir, 'evidence'), { recursive: true });\n\n  const now = new Date().toISOString();\n\n  // §4.4 work_item.json\n  const workItemJson: WorkItemMetadata = {\n    schema_version: WORK_ITEM_METADATA_SCHEMA_VERSION,\n    work_item_id: input.workItemId,\n    workflow_type: input.workflowType ?? 'feature_spec',\n    workflow_path: input.workflowPath ?? null,\n    code_change_allowed: false,\n    allowed_write_files: [],\n    created_at: now,\n    updated_at: now,\n    created_by: input.createdBy ?? 'sf-orchestrator',\n  };\n  await writeWorkItemMetadata(wiDir, input.workItemId, workItemJson);\n\n  // §4.5 intake.md（必须原样保存用户原始请求）\n  const intakeContent = [\n    '# Intake',\n    '',\n    `Work Item: ${input.workItemId}`,\n    `Created: ${now}`,\n    '',\n    '## Original User Request',\n    '',\n    input.userRequest,\n    '',\n    '## Normalized Summary',\n    '',\n    '> TODO: 由 Agent 填充',\n    '',\n  ].join('\\n');\n  await fs.writeFile(path.join(wiDir, 'intake.md'), intakeContent, 'utf-8');\n\n  return wiDir;\n}\n\nconst PROJECT_SPEC_VERSION_PATTERN = /^PSV-[0-9]{4,}$/;\n\n/**\n * Read the authoritative Project Spec version for Work Item creation.\n *\n * candidate_manifest.base_spec_version is a merge precondition, so production\n * creation must never guess or silently fall back to PSV-0001 for an existing\n * project. The sole authority is project/spec_manifest.json.\n */\nexport async function readAuthoritativeProjectSpecVersion(\n  projectRoot: string,\n): Promise<string> {\n  const manifestPath = path.join(\n    projectRoot,\n    SPEC_DIR_NAME,\n    'project',\n    'spec_manifest.json',\n  );\n\n  let parsed: unknown;\n  try {\n    parsed = JSON.parse(await fs.readFile(manifestPath, 'utf-8'));\n  } catch (error) {\n    const detail = error instanceof Error ? error.message : String(error);\n    throw new Error(\n      `PROJECT_SPEC_VERSION_UNAVAILABLE: cannot read ${manifestPath}: ${detail}`,\n    );\n  }\n\n  const version =\n    parsed && typeof parsed === 'object' && !Array.isArray(parsed)\n      ? (parsed as Record<string, unknown>).project_spec_version\n      : undefined;\n\n  if (\n    typeof version !== 'string' ||\n    !PROJECT_SPEC_VERSION_PATTERN.test(version)\n  ) {\n    throw new Error(\n      `PROJECT_SPEC_VERSION_UNAVAILABLE: ${manifestPath} must contain a valid project_spec_version`,\n    );\n  }\n\n  return version;\n}\n\n/**\n * 初始化 WI 的非 Candidate 闭环文件骨架（§4.3）。\n *\n * tasks.md 与 trace_delta.md 的新写入权威路径位于 candidates/。不得在\n * Work Item 顶层预建同名占位。verification_report.md 与\n * evidence/evidence_manifest.json 也不得预建空壳；它们只能由 Verifier\n * 在真实验证阶段写入。旧顶层 tasks/trace 仍由 Path Service 只读兼容。\n */\nexport async function initializeClosureFiles(\n  workItemDir: string,\n  workItemId: string,\n  workflowPath: string | null,\n  baseSpecVersion: string,\n): Promise<void> {\n  if (!PROJECT_SPEC_VERSION_PATTERN.test(baseSpecVersion)) {\n    throw new Error(\n      `PROJECT_SPEC_VERSION_INVALID: ${baseSpecVersion}`,\n    );\n  }\n  const now = new Date().toISOString();\n  const isCodeOnly = workflowPath === 'code_only_fast_path';\n  const isTaskChange = workflowPath === 'task_change_path';\n  await Promise.all([\n    fs.mkdir(path.join(workItemDir, 'candidates'), { recursive: true }),\n    fs.mkdir(path.join(workItemDir, 'gates'), { recursive: true }),\n    fs.mkdir(path.join(workItemDir, 'evidence'), { recursive: true }),\n  ]);\n\n  // change_classification.md\n  await ensureFile(path.join(workItemDir, 'change_classification.md'), [\n    '# Change Classification', '',\n    `Work Item: ${workItemId}`, '',\n    '> TODO: 由 Agent 填充', '',\n  ].join('\\n'));\n\n  // impact_analysis.md\n  await ensureFile(path.join(workItemDir, 'impact_analysis.md'), [\n    '# Impact Analysis', '',\n    `Work Item: ${workItemId}`, '',\n    '## Existing Spec Match', '',\n    '> TODO: 由 Agent 填充', '',\n  ].join('\\n'));\n\n  // trigger_result.json\n  await ensureFile(path.join(workItemDir, 'trigger_result.json'), JSON.stringify({\n    schema_version: '1.0',\n    work_item_id: workItemId,\n    workflow_path: workflowPath,\n    classification: {},\n    match_results: [],\n    selected_at: now,\n  }, null, 2) + '\\n');\n\n  // candidate_manifest.json\n  await ensureFile(path.join(workItemDir, 'candidate_manifest.json'), JSON.stringify({\n    schema_version: '1.0',\n    work_item_id: workItemId,\n    workflow_path: workflowPath ?? 'unknown',\n    base_spec_version: baseSpecVersion,\n    merge_required: !isCodeOnly,\n    entries: [],\n  }, null, 2) + '\\n');\n\n  // gate_summary.md\n  await ensureFile(path.join(workItemDir, 'gate_summary.md'), [\n    '# Gate Summary', '',\n    `Work Item: ${workItemId}`,\n    'Overall Status: pending', '',\n    '> TODO: 由 Gate Runner 生成', '',\n  ].join('\\n'));\n\n}\n\n// ---------------------------------------------------------------------------\n// 辅助\n// ---------------------------------------------------------------------------\n\nasync function ensureFile(filePath: string, content: string): Promise<void> {\n  try {\n    await fs.access(filePath);\n  } catch {\n    await fs.mkdir(path.dirname(filePath), { recursive: true });\n    await fs.writeFile(filePath, content, 'utf-8');\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\work-item-metadata.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":22,"column":21,"nodeType":null,"messageId":"delete","endLine":22,"endColumn":22,"fix":{"range":[650,651],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":35,"column":21,"nodeType":null,"messageId":"delete","endLine":35,"endColumn":22,"fix":{"range":[1070,1071],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":44,"column":141,"nodeType":null,"messageId":"delete","endLine":44,"endColumn":142,"fix":{"range":[1549,1550],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":56,"column":113,"nodeType":null,"messageId":"delete","endLine":56,"endColumn":114,"fix":{"range":[1995,1996],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":67,"column":21,"nodeType":null,"messageId":"delete","endLine":67,"endColumn":22,"fix":{"range":[2290,2291],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":78,"column":113,"nodeType":null,"messageId":"delete","endLine":78,"endColumn":114,"fix":{"range":[2742,2743],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":90,"column":29,"nodeType":null,"messageId":"delete","endLine":90,"endColumn":30,"fix":{"range":[3070,3071],"text":""}}],"suppressedMessages":[],"errorCount":7,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":7,"fixableWarningCount":0,"source":"import * as fs from 'node:fs/promises';\nimport { readFileSync } from 'node:fs';\nimport * as path from 'node:path';\n\nimport {\n  createWorkItemMetadataSchemaDescriptor,\n  precheckSchemaDescriptors,\n  type SchemaDescriptorPrecheckResult,\n} from '@specforge/types/schema-contract';\n\nimport { validateWorkItemJson } from './artifact-schema-validation';\n\nexport type WorkItemMetadata = Record<string, unknown> & {\n  schema_version: '1.1';\n  work_item_id: string;\n};\n\nexport { createWorkItemMetadataSchemaDescriptor } from '@specforge/types/schema-contract';\n\nexport async function precheckWorkItemMetadataSchema(\n  workItemDir: string,\n  workItemId: string,\n): Promise<SchemaDescriptorPrecheckResult> {\n  return precheckSchemaDescriptors(workItemDir, [\n    createWorkItemMetadataSchemaDescriptor(workItemId),\n  ]);\n}\n\nfunction validationError(workItemId: string, errors: readonly string[]): Error {\n  return new Error(`WORK_ITEM_METADATA_INVALID: ${workItemId}: ${errors.join('; ')}`);\n}\n\nexport async function readWorkItemMetadata(\n  workItemDir: string,\n  workItemId: string,\n): Promise<WorkItemMetadata> {\n  const schemaPrecheck = await precheckWorkItemMetadataSchema(workItemDir, workItemId);\n  const schemaCheck = schemaPrecheck.checks[0];\n  if (!schemaPrecheck.ok) {\n    if (schemaCheck?.errorCode === 'FILE_REQUIRED') {\n      throw new Error(`WORK_ITEM_NOT_FOUND: ${workItemId}`);\n    }\n    throw new Error(\n      `WORK_ITEM_METADATA_INVALID: ${workItemId}: WORK_ITEM_METADATA_SCHEMA_BLOCKED: ${schemaCheck?.errorCode ?? 'SCHEMA_VERSION_MISMATCH'}`,\n    );\n  }\n  const metadataPath = path.join(workItemDir, 'work_item.json');\n  let content: string;\n  try {\n    content = await fs.readFile(metadataPath, 'utf8');\n  } catch (error) {\n    if ((error as NodeJS.ErrnoException).code === 'ENOENT') {\n      throw new Error(`WORK_ITEM_NOT_FOUND: ${workItemId}`);\n    }\n    throw new Error(\n      `WORK_ITEM_METADATA_READ_FAILED: ${workItemId}: ${error instanceof Error ? error.message : String(error)}`,\n    );\n  }\n\n  const validation = validateWorkItemJson(content, workItemId);\n  if (!validation.valid) throw validationError(workItemId, validation.errors);\n  return JSON.parse(content) as WorkItemMetadata;\n}\n\nexport function readWorkItemMetadataSync(\n  workItemDir: string,\n  workItemId: string,\n): WorkItemMetadata {\n  const metadataPath = path.join(workItemDir, 'work_item.json');\n  let content: string;\n  try {\n    content = readFileSync(metadataPath, 'utf8');\n  } catch (error) {\n    if ((error as NodeJS.ErrnoException).code === 'ENOENT') {\n      throw new Error(`WORK_ITEM_NOT_FOUND: ${workItemId}`);\n    }\n    throw new Error(\n      `WORK_ITEM_METADATA_READ_FAILED: ${workItemId}: ${error instanceof Error ? error.message : String(error)}`,\n    );\n  }\n\n  const validation = validateWorkItemJson(content, workItemId);\n  if (!validation.valid) throw validationError(workItemId, validation.errors);\n  return JSON.parse(content) as WorkItemMetadata;\n}\n\nexport async function writeWorkItemMetadata(\n  workItemDir: string,\n  workItemId: string,\n  metadata: WorkItemMetadata,\n): Promise<void> {\n  const content = JSON.stringify(metadata, null, 2) + '\\n';\n  const validation = validateWorkItemJson(content, workItemId);\n  if (!validation.valid) throw validationError(workItemId, validation.errors);\n  if (!createWorkItemMetadataSchemaDescriptor(workItemId).validateCurrent(metadata)) {\n    throw new Error(`WORK_ITEM_METADATA_SCHEMA_BLOCKED: ${workItemId}: VALIDATION_FAILED`);\n  }\n  await fs.writeFile(path.join(workItemDir, 'work_item.json'), content, 'utf8');\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\workflow-path-selector-v11.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":20,"column":43,"nodeType":null,"messageId":"insert","endLine":20,"endColumn":43,"fix":{"range":[625,625],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":21,"column":37,"nodeType":null,"messageId":"insert","endLine":21,"endColumn":37,"fix":{"range":[662,662],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":22,"column":36,"nodeType":null,"messageId":"insert","endLine":22,"endColumn":36,"fix":{"range":[698,698],"text":";"}}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":3,"fixableWarningCount":0,"source":"/**\n * workflow-path-selector-v11.ts — v1.1 标准 Workflow Path Selection（§6）\n *\n * 产品边界：SPS-1.0。当前可执行合同由本模块导出、Runtime 消费者与回归测试固定；归档 v1.1 标准仅作历史证据。\n *\n * 负责：\n * - §6.2 Classification 与 Impact Analysis\n * - §6.3 匹配结果类型\n * - §6.4 workflow_path 枚举\n * - §6.5 路径优先级\n * - §6.6 unknown 升级规则\n * - §6.7 code-only 不是免流程\n *\n * 具体实现已拆分至三个模块（单向依赖）：\n * - change-classification.ts  — ChangeClassification interface + canUseCodeOnlyFastPath\n * - impact-analysis.ts        — selectWorkflowPath + generateTriggerResult + TriggerResult + WorkflowPath\n * - trigger-result.ts         — MatchResultType\n */\n\nexport * from './change-classification.js'\nexport * from './impact-analysis.js'\nexport * from './trigger-result.js'\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\write-guard-audit-binding.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·readWriteGuardAuthorizations,·writeGuardAuthorizationLogPath·` with `⏎··readWriteGuardAuthorizations,⏎··writeGuardAuthorizationLogPath,⏎`","line":5,"column":9,"nodeType":null,"messageId":"replace","endLine":5,"endColumn":71,"fix":{"range":[188,250],"text":"\n  readWriteGuardAuthorizations,\n  writeGuardAuthorizationLogPath,\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎····`","line":11,"column":18,"nodeType":null,"messageId":"insert","endLine":11,"endColumn":18,"fix":{"range":[536,536],"text":"\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·writeGuardAuthorizationLogPath(projectRoot)` with `⏎····writeGuardAuthorizationLogPath(projectRoot),⏎··`","line":12,"column":58,"nodeType":null,"messageId":"replace","endLine":12,"endColumn":102,"fix":{"range":[642,686],"text":"\n    writeGuardAuthorizationLogPath(projectRoot),\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·······`","line":15,"column":79,"nodeType":null,"messageId":"insert","endLine":15,"endColumn":79,"fix":{"range":[814,814],"text":"\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `.split(/\\r?\\n/).filter(line·=>·line.trim())` with `⏎····.split(/\\r?\\n/)⏎····.filter(line·=>·line.trim())⏎····`","line":22,"column":54,"nodeType":null,"messageId":"replace","endLine":22,"endColumn":97,"fix":{"range":[1114,1157],"text":"\n    .split(/\\r?\\n/)\n    .filter(line => line.trim())\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····` with `······`","line":23,"column":1,"nodeType":null,"messageId":"replace","endLine":23,"endColumn":5,"fix":{"range":[1172,1176],"text":"      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `try·{·entry·=·JSON.parse(line);·}·catch·{·throw·new·Error('WRITE_GUARD_AUDIT_LOG_INVALID');` with `··try·{⏎········entry·=·JSON.parse(line);⏎······}·catch·{⏎········throw·new·Error('WRITE_GUARD_AUDIT_LOG_INVALID');⏎·····`","line":24,"column":5,"nodeType":null,"messageId":"replace","endLine":24,"endColumn":96,"fix":{"range":[1196,1287],"text":"  try {\n        entry = JSON.parse(line);\n      } catch {\n        throw new Error('WRITE_GUARD_AUDIT_LOG_INVALID');\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····if·(!entry·||·typeof·entry.path·!==·'string'·||·typeof·entry.allowed·!==·'boolean')` with `······if·(!entry·||·typeof·entry.path·!==·'string'·||·typeof·entry.allowed·!==·'boolean')⏎·······`","line":25,"column":1,"nodeType":null,"messageId":"replace","endLine":25,"endColumn":88,"fix":{"range":[1290,1377],"text":"      if (!entry || typeof entry.path !== 'string' || typeof entry.allowed !== 'boolean')\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":26,"column":5,"nodeType":null,"messageId":"insert","endLine":26,"endColumn":5,"fix":{"range":[1432,1432],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `··` with `····`","line":27,"column":1,"nodeType":null,"messageId":"replace","endLine":27,"endColumn":3,"fix":{"range":[1446,1448],"text":"    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `.update(JSON.stringify(inputs.map(bytes·=>·bytes·===·null⏎····?·null·:·createHash('sha256').update(bytes).digest('hex'))))` with `⏎····.update(⏎······JSON.stringify(⏎········inputs.map(bytes·=>⏎··········bytes·===·null·?·null·:·createHash('sha256').update(bytes).digest('hex')⏎········)⏎······)⏎····)⏎····`","line":31,"column":38,"nodeType":null,"messageId":"replace","endLine":32,"endColumn":65,"fix":{"range":[1672,1794],"text":"\n    .update(\n      JSON.stringify(\n        inputs.map(bytes =>\n          bytes === null ? null : createHash('sha256').update(bytes).digest('hex')\n        )\n      )\n    )\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·sha256,·hasEvidence:·inputs.some(bytes·=>·bytes·!==·null),·blocked:·entries.filter(entry·=>·!entry.allowed).length` with `⏎····sha256,⏎····hasEvidence:·inputs.some(bytes·=>·bytes·!==·null),⏎····blocked:·entries.filter(entry·=>·!entry.allowed).length,⏎·`","line":33,"column":11,"nodeType":null,"messageId":"replace","endLine":33,"endColumn":126,"fix":{"range":[1820,1935],"text":"\n    sha256,\n    hasEvidence: inputs.some(bytes => bytes !== null),\n    blocked: entries.filter(entry => !entry.allowed).length,\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `text:·string,·projectRoot:·string,·workItemDir:·string,·expectedHash?:·string` with `⏎··text:·string,⏎··projectRoot:·string,⏎··workItemDir:·string,⏎··expectedHash?:·string⏎`","line":36,"column":37,"nodeType":null,"messageId":"replace","endLine":36,"endColumn":114,"fix":{"range":[1978,2055],"text":"\n  text: string,\n  projectRoot: string,\n  workItemDir: string,\n  expectedHash?: string\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":38,"column":55,"nodeType":null,"messageId":"insert","endLine":38,"endColumn":55,"fix":{"range":[2193,2193],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `projectRoot:·string,·workItemDir:·string,·text:·string·|·null` with `⏎··projectRoot:·string,⏎··workItemDir:·string,⏎··text:·string·|·null⏎`","line":42,"column":47,"nodeType":null,"messageId":"replace","endLine":42,"endColumn":108,"fix":{"range":[2347,2408],"text":"\n  projectRoot: string,\n  workItemDir: string,\n  text: string | null\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·matches.length·===·1·?·matches[0][1]·===·current.sha256` with `⏎······matches.length·===·1⏎········?·matches[0][1]·===·current.sha256⏎·······`","line":47,"column":18,"nodeType":null,"messageId":"replace","endLine":47,"endColumn":74,"fix":{"range":[2695,2751],"text":"\n      matches.length === 1\n        ? matches[0][1] === current.sha256\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·bound·&&·(current.blocked·===·0·||` with `⏎······bound·&&⏎······(current.blocked·===·0·||⏎·······`","line":49,"column":19,"nodeType":null,"messageId":"replace","endLine":49,"endColumn":54,"fix":{"range":[2903,2938],"text":"\n      bound &&\n      (current.blocked === 0 ||\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·passed,·reason:·passed·?·undefined·:·'WRITE_GUARD_AUDIT_STALE:·rerun·sf_changed_files_audit·and·verification;·preserve·and·resolve·blocked·attempts',·...current` with `⏎······passed,⏎······reason:·passed⏎········?·undefined⏎········:·'WRITE_GUARD_AUDIT_STALE:·rerun·sf_changed_files_audit·and·verification;·preserve·and·resolve·blocked·attempts',⏎······...current,⏎···`","line":50,"column":13,"nodeType":null,"messageId":"replace","endLine":50,"endColumn":174,"fix":{"range":[3029,3190],"text":"\n      passed,\n      reason: passed\n        ? undefined\n        : 'WRITE_GUARD_AUDIT_STALE: rerun sf_changed_files_audit and verification; preserve and resolve blocked attempts',\n      ...current,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `.toString('utf8').split(/\\r?\\n/).filter(line·=>·line.trim())` with `⏎······.toString('utf8')⏎······.split(/\\r?\\n/)⏎······.filter(line·=>·line.trim())⏎······`","line":62,"column":24,"nodeType":null,"messageId":"replace","endLine":62,"endColumn":84,"fix":{"range":[3815,3875],"text":"\n      .toString('utf8')\n      .split(/\\r?\\n/)\n      .filter(line => line.trim())\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `entry·=>` with `⏎······entry·=>⏎·······`","line":63,"column":43,"nodeType":null,"messageId":"replace","endLine":63,"endColumn":51,"fix":{"range":[3949,3957],"text":"\n      entry =>\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `······typeof·entry.timestamp·===·'string'·&&·Date.parse(entry.timestamp)·<=·Date.parse(closeEventAt)` with `········typeof·entry.timestamp·===·'string'·&&⏎········Date.parse(entry.timestamp)·<=·Date.parse(closeEventAt)⏎····`","line":64,"column":1,"nodeType":null,"messageId":"replace","endLine":64,"endColumn":101,"fix":{"range":[3985,4085],"text":"        typeof entry.timestamp === 'string' &&\n        Date.parse(entry.timestamp) <= Date.parse(closeEventAt)\n    "}},{"ruleId":"@typescript-eslint/no-unsafe-argument","severity":2,"message":"Unsafe argument of type `any` assigned to a parameter of type `string`.","line":64,"column":57,"nodeType":"MemberExpression","messageId":"unsafeArgument","endLine":64,"endColumn":72},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":67,"column":13,"nodeType":null,"messageId":"insert","endLine":67,"endColumn":13,"fix":{"range":[4261,4261],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·close_event_at:·closeEventAt` with `⏎······close_event_at:·closeEventAt,⏎···`","line":69,"column":66,"nodeType":null,"messageId":"replace","endLine":69,"endColumn":95,"fix":{"range":[4501,4530],"text":"\n      close_event_at: closeEventAt,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·return·null;` with `⏎····return·null;⏎·`","line":70,"column":12,"nodeType":null,"messageId":"replace","endLine":70,"endColumn":25,"fix":{"range":[4545,4558],"text":"\n    return null;\n "}}],"suppressedMessages":[],"errorCount":25,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":24,"fixableWarningCount":0,"source":"import * as fs from 'node:fs';\nimport * as path from 'node:path';\nimport { createHash } from 'node:crypto';\nimport { readHardStopResolutionLog } from './hard-stop-resolution-log';\nimport { readWriteGuardAuthorizations, writeGuardAuthorizationLogPath } from './write-guard-authorization-log';\n\nconst LABEL = 'Write Guard Evidence SHA256';\n\n/** Raw-byte binding: no timestamp, report text, or caller-provided counters are trusted. */\nexport function readWriteGuardAuditBinding(projectRoot: string, workItemDir: string) {\n  const files = [path.join(workItemDir, 'write_guard_log.jsonl'),\n    path.join(workItemDir, 'hard_stop_resolution.jsonl'), writeGuardAuthorizationLogPath(projectRoot)];\n  const inputs = files.map(file => {\n    try {\n      if (!fs.lstatSync(file).isFile() || fs.lstatSync(file).isSymbolicLink()) throw new Error('not a regular file');\n      return fs.readFileSync(file);\n    } catch (error) {\n      if ((error as NodeJS.ErrnoException).code === 'ENOENT') return null;\n      throw new Error('WRITE_GUARD_AUDIT_SOURCE_UNREADABLE');\n    }\n  });\n  const entries = (inputs[0]?.toString('utf8') ?? '').split(/\\r?\\n/).filter(line => line.trim()).map(line => {\n    let entry: any;\n    try { entry = JSON.parse(line); } catch { throw new Error('WRITE_GUARD_AUDIT_LOG_INVALID'); }\n    if (!entry || typeof entry.path !== 'string' || typeof entry.allowed !== 'boolean') throw new Error('WRITE_GUARD_AUDIT_LOG_INVALID');\n    return entry;\n  });\n  // These owners validate their current schemas; corrupt policy evidence must not look absent.\n  readHardStopResolutionLog(workItemDir);\n  readWriteGuardAuthorizations(projectRoot);\n  const sha256 = createHash('sha256').update(JSON.stringify(inputs.map(bytes => bytes === null\n    ? null : createHash('sha256').update(bytes).digest('hex')))).digest('hex');\n  return { sha256, hasEvidence: inputs.some(bytes => bytes !== null), blocked: entries.filter(entry => !entry.allowed).length };\n}\n\nexport function bindWriteGuardAudit(text: string, projectRoot: string, workItemDir: string, expectedHash?: string): string {\n  const current = readWriteGuardAuditBinding(projectRoot, workItemDir);\n  if (expectedHash && expectedHash !== current.sha256) throw new Error('WRITE_GUARD_AUDIT_SOURCE_CHANGED');\n  return `${text}\\n${LABEL}: ${current.sha256}\\n`;\n}\n\nexport function inspectWriteGuardAuditBinding(projectRoot: string, workItemDir: string, text: string | null) {\n  try {\n    const current = readWriteGuardAuditBinding(projectRoot, workItemDir);\n    const matches = [...(text ?? '').matchAll(/^Write Guard Evidence SHA256: ([a-f0-9]{64})$/gm)];\n    // Legacy reports with no underlying guard/policy evidence are still meaningful.\n    const bound = matches.length === 1 ? matches[0][1] === current.sha256 : matches.length === 0 && !current.hasEvidence;\n    const reportedBlocked = /-\\s*Blocked write attempts:\\s*(\\d+)/i.exec(text ?? '');\n    const passed = bound && (current.blocked === 0 || (reportedBlocked !== null && Number(reportedBlocked[1]) >= current.blocked));\n    return { passed, reason: passed ? undefined : 'WRITE_GUARD_AUDIT_STALE: rerun sf_changed_files_audit and verification; preserve and resolve blocked attempts', ...current };\n  } catch (error) {\n    return { passed: false, reason: error instanceof Error ? error.message : String(error) };\n  }\n}\n\n/** A new binding requirement alone does not invalidate a historical closure. Prove an omission at its actual event time. */\nexport function inspectClosedWriteGuardAudit(workItemDir: string, closeEventAt: string | null) {\n  if (!closeEventAt || !Number.isFinite(Date.parse(closeEventAt))) return null;\n  try {\n    const audit = fs.readFileSync(path.join(workItemDir, 'changed_files_audit.md'));\n    const log = fs.readFileSync(path.join(workItemDir, 'write_guard_log.jsonl'));\n    const entries = log.toString('utf8').split(/\\r?\\n/).filter(line => line.trim()).map(line => JSON.parse(line));\n    const blockedAtClose = entries.filter(entry => entry.allowed === false &&\n      typeof entry.timestamp === 'string' && Date.parse(entry.timestamp) <= Date.parse(closeEventAt)).length;\n    const count = /-\\s*Blocked write attempts:\\s*(\\d+)/i.exec(audit.toString('utf8'));\n    if (!count || Number(count[1]) >= blockedAtClose) return null;\n    return { reason: `WRITE_GUARD_AUDIT_OMITTED_PRE_CLOSE_DENIALS: reported=${count[1]}, factual=${blockedAtClose}`,\n      audit_sha256: createHash('sha256').update(audit).digest('hex'),\n      log_sha256: createHash('sha256').update(log).digest('hex'), close_event_at: closeEventAt };\n  } catch { return null; } // Missing/unreadable evidence is not proof of invalidity.\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\write-guard-authorization-log.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(line)` with `line`","line":36,"column":12,"nodeType":null,"messageId":"replace","endLine":36,"endColumn":18,"fix":{"range":[1280,1286],"text":"line"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `((line)` with `(line`","line":37,"column":14,"nodeType":null,"messageId":"replace","endLine":37,"endColumn":21,"fix":{"range":[1316,1323],"text":"(line"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(line)` with `line`","line":38,"column":12,"nodeType":null,"messageId":"replace","endLine":38,"endColumn":18,"fix":{"range":[1355,1361],"text":"line"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·······`","line":42,"column":23,"nodeType":null,"messageId":"insert","endLine":42,"endColumn":23,"fix":{"range":[1616,1616],"text":"\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":43,"column":9,"nodeType":null,"messageId":"insert","endLine":43,"endColumn":9,"fix":{"range":[1694,1694],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":44,"column":1,"nodeType":null,"messageId":"insert","endLine":44,"endColumn":1,"fix":{"range":[1746,1746],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'SCHEMA_VERSION_MISMATCH:·unsupported·write_guard_authorization·schema_version'` with `⏎··········'SCHEMA_VERSION_MISMATCH:·unsupported·write_guard_authorization·schema_version'⏎········`","line":46,"column":25,"nodeType":null,"messageId":"replace","endLine":46,"endColumn":104,"fix":{"range":[1858,1937],"text":"\n          'SCHEMA_VERSION_MISMATCH: unsupported write_guard_authorization schema_version'\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":57,"column":9,"nodeType":null,"messageId":"delete","endLine":57,"endColumn":10,"fix":{"range":[2313,2314],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":64,"column":33,"nodeType":null,"messageId":"delete","endLine":64,"endColumn":34,"fix":{"range":[2431,2432],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `writeGuardAuthorizationLogPath(projectRoot),·JSON.stringify(completed)·+·'\\n',·'utf-8'` with `⏎····writeGuardAuthorizationLogPath(projectRoot),⏎····JSON.stringify(completed)·+·'\\n',⏎····'utf-8'⏎··`","line":84,"column":21,"nodeType":null,"messageId":"replace","endLine":84,"endColumn":107,"fix":{"range":[3158,3244],"text":"\n    writeGuardAuthorizationLogPath(projectRoot),\n    JSON.stringify(completed) + '\\n',\n    'utf-8'\n  "}},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'value ?? ''' will use Object's default stringification format ('[object Object]') when stringified.","line":89,"column":17,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":89,"endColumn":28},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `.replace(/\\\\/g,·'/').replace(/\\/+/g,·'/')` with `⏎····.replace(/\\\\/g,·'/')⏎····.replace(/\\/+/g,·'/')⏎····`","line":89,"column":29,"nodeType":null,"messageId":"replace","endLine":89,"endColumn":70,"fix":{"range":[3375,3416],"text":"\n    .replace(/\\\\/g, '/')\n    .replace(/\\/+/g, '/')\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(target)` with `target`","line":124,"column":23,"nodeType":null,"messageId":"replace","endLine":124,"endColumn":31,"fix":{"range":[4677,4685],"text":"target"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `cmd.includes(`:${t}`)·||·cmd.includes(`target=${t}`)·||·cmd.includes(`dst=${t}`)·||·cmd.includes(`destination=${t}`)` with `(⏎······cmd.includes(`:${t}`)·||⏎······cmd.includes(`target=${t}`)·||⏎······cmd.includes(`dst=${t}`)·||⏎······cmd.includes(`destination=${t}`)⏎····)`","line":127,"column":12,"nodeType":null,"messageId":"replace","endLine":127,"endColumn":128,"fix":{"range":[4781,4897],"text":"(\n      cmd.includes(`:${t}`) ||\n      cmd.includes(`target=${t}`) ||\n      cmd.includes(`dst=${t}`) ||\n      cmd.includes(`destination=${t}`)\n    )"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":155,"column":29,"nodeType":null,"messageId":"delete","endLine":155,"endColumn":30,"fix":{"range":[5910,5911],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":173,"column":29,"nodeType":null,"messageId":"delete","endLine":173,"endColumn":30,"fix":{"range":[6522,6523],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(value)` with `value`","line":199,"column":13,"nodeType":null,"messageId":"replace","endLine":199,"endColumn":20,"fix":{"range":[7289,7296],"text":"value"}}],"suppressedMessages":[],"errorCount":17,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":16,"fixableWarningCount":0,"source":"/**\n * write-guard-authorization-log.ts\n *\n * Project-level scoped authorizations for Write Guard.\n *\n * A hard_stop resolution explains why the current latch can be cleared.\n * A write_guard_authorization explains which future operations may be allowed\n * without repeatedly stopping the same Work Item.\n */\nimport * as fs from 'node:fs';\nimport * as path from 'node:path';\nimport {\n  SPEC_DIR_NAME,\n  WRITE_GUARD_AUTHORIZATION_SCHEMA_VERSION,\n  type WriteGuardAuthorizationRecord,\n} from '@specforge/types';\nimport { createWriteGuardAuthorizationLogSchemaDescriptor } from '@specforge/types/schema-contract';\n\nexport type WriteGuardAuthorizationEntry = WriteGuardAuthorizationRecord;\n\nfunction policyDir(projectRoot: string): string {\n  return path.join(projectRoot, SPEC_DIR_NAME, 'project', 'policies');\n}\n\nexport function writeGuardAuthorizationLogPath(projectRoot: string): string {\n  return path.join(policyDir(projectRoot), 'write_guard_authorizations.jsonl');\n}\n\nexport function readWriteGuardAuthorizations(projectRoot: string): WriteGuardAuthorizationEntry[] {\n  const logPath = writeGuardAuthorizationLogPath(projectRoot);\n  if (!fs.existsSync(logPath)) return [];\n  try {\n    const entries = fs\n      .readFileSync(logPath, 'utf-8')\n      .split(/\\r?\\n/g)\n      .map((line) => line.trim())\n      .filter((line) => line.length > 0)\n      .map((line) => JSON.parse(line) as unknown);\n    if (entries.length === 0) throw new Error('FILE_PARSE_FAILED: JSONL file is empty');\n    const descriptor = createWriteGuardAuthorizationLogSchemaDescriptor();\n    for (const entry of entries) {\n      const observed = typeof entry === 'object' && entry !== null && !Array.isArray(entry)\n        ? (entry as Record<string, unknown>).schema_version\n        : undefined;\n      if (observed !== WRITE_GUARD_AUTHORIZATION_SCHEMA_VERSION) {\n        throw new Error('SCHEMA_VERSION_MISMATCH: unsupported write_guard_authorization schema_version');\n      }\n      if (!descriptor.validateCurrent(entry)) {\n        throw new Error('VALIDATION_FAILED: invalid write_guard_authorization record');\n      }\n    }\n    return entries as WriteGuardAuthorizationEntry[];\n  } catch (error) {\n    throw new Error(\n      `WRITE_GUARD_AUTHORIZATION_LOG_INVALID: ${\n        error instanceof Error ? error.message : String(error)\n      }`,\n    );\n  }\n}\n\nexport function appendWriteGuardAuthorization(\n  projectRoot: string,\n  entry: Record<string, unknown>,\n): WriteGuardAuthorizationEntry {\n  readWriteGuardAuthorizations(projectRoot);\n  const now = new Date().toISOString();\n  const completed = {\n    schema_version: WRITE_GUARD_AUTHORIZATION_SCHEMA_VERSION,\n    authorization_id: entry.authorization_id ?? `AUTH-${Date.now()}`,\n    created_at: now,\n    scope: entry.scope ?? 'work_item',\n    tool: entry.tool ?? 'sf_safe_bash',\n    expires_when: entry.expires_when ?? 'work_item_closed',\n    ...entry,\n  };\n\n  const descriptor = createWriteGuardAuthorizationLogSchemaDescriptor();\n  if (!descriptor.validateCurrent(completed)) {\n    throw new Error('WRITE_GUARD_AUTHORIZATION_RECORD_INVALID');\n  }\n\n  fs.mkdirSync(policyDir(projectRoot), { recursive: true });\n  fs.appendFileSync(writeGuardAuthorizationLogPath(projectRoot), JSON.stringify(completed) + '\\n', 'utf-8');\n  return completed as WriteGuardAuthorizationEntry;\n}\n\nfunction normalize(value: unknown): string {\n  return String(value ?? '').replace(/\\\\/g, '/').replace(/\\/+/g, '/').toLowerCase();\n}\n\nfunction unquote(value: string): string {\n  return value.replace(/^['\"]|['\"]$/g, '');\n}\n\nfunction commandLooksLikeDockerRun(command: string): boolean {\n  return /(^|[;&|]\\s*)docker\\s+run\\b/i.test(command);\n}\n\nfunction commandLooksLikeSsh(command: string): boolean {\n  return /(^|[;&|]\\s*)ssh\\s+\\S+\\s+/i.test(command);\n}\n\nfunction commandFamilyMatches(command: string, family: string): boolean {\n  const f = family.toLowerCase();\n  if (!f || f === 'any' || f === 'any_shell_command') return true;\n  if (f === 'docker_run') return commandLooksLikeDockerRun(command);\n  if (f === 'ssh_remote') return commandLooksLikeSsh(command);\n  return normalize(command).includes(normalize(f));\n}\n\nfunction hostPathMatches(command: string, hostPathPrefix?: string): boolean {\n  const prefix = unquote(String(hostPathPrefix ?? '').trim());\n  if (!prefix) return true;\n  const cmd = normalize(command);\n  const p = normalize(prefix).replace(/\\/+$/, '');\n  if (!p) return true;\n  return cmd.includes(p) || cmd.includes(p.replace(/^.*\\/([^/]+)$/, '$1'));\n}\n\nfunction containerTargetsMatch(command: string, targets?: string[]): boolean {\n  if (!Array.isArray(targets) || targets.length === 0) return true;\n  const cmd = normalize(command);\n  return targets.some((target) => {\n    const t = normalize(target).replace(/\\/+$/, '');\n    if (!t) return false;\n    return cmd.includes(`:${t}`) || cmd.includes(`target=${t}`) || cmd.includes(`dst=${t}`) || cmd.includes(`destination=${t}`);\n  });\n}\n\nfunction imageMatches(command: string, image?: string): boolean {\n  const img = String(image ?? '').trim();\n  if (!img) return true;\n  return normalize(command).includes(normalize(img));\n}\n\nfunction scopeMatches(entry: WriteGuardAuthorizationEntry, workItemId?: string | null): boolean {\n  const scope = String(entry.scope ?? 'work_item').toLowerCase();\n  if (scope === 'project') return true;\n  if (scope === 'work_item' || scope === 'task' || scope === 'command') {\n    return !!workItemId && entry.work_item_id === workItemId;\n  }\n  return !!workItemId && (!entry.work_item_id || entry.work_item_id === workItemId);\n}\n\nfunction isClosedOrExpired(entry: WriteGuardAuthorizationEntry): boolean {\n  const expiresWhen = String(entry.expires_when ?? '').toLowerCase();\n  if (expiresWhen === 'revoked' || expiresWhen === 'expired') return true;\n  return false;\n}\n\nexport function commandMatchesWriteGuardAuthorization(\n  command: string,\n  entry: WriteGuardAuthorizationEntry,\n  workItemId?: string | null,\n): boolean {\n  if (!scopeMatches(entry, workItemId)) return false;\n  if (isClosedOrExpired(entry)) return false;\n  if (entry.tool && entry.tool !== 'sf_safe_bash') return false;\n\n  const family = String(entry.command_family ?? entry.intent ?? 'any_shell_command');\n  return (\n    commandFamilyMatches(command, family) &&\n    hostPathMatches(command, entry.host_path_prefix) &&\n    containerTargetsMatch(command, entry.container_targets) &&\n    imageMatches(command, entry.image)\n  );\n}\n\nexport function findMatchingWriteGuardAuthorization(\n  projectRoot: string,\n  command: string,\n  workItemId?: string | null,\n): WriteGuardAuthorizationEntry | null {\n  const authorizations = readWriteGuardAuthorizations(projectRoot);\n  for (let index = authorizations.length - 1; index >= 0; index -= 1) {\n    const entry = authorizations[index];\n    if (commandMatchesWriteGuardAuthorization(command, entry, workItemId)) return entry;\n  }\n  return null;\n}\n\nexport function authorizationText(entry: WriteGuardAuthorizationEntry): string {\n  return [\n    entry.authorization_id,\n    entry.authorization_type,\n    entry.source_hard_stop_id,\n    entry.work_item_id,\n    entry.scope,\n    entry.tool,\n    entry.intent,\n    entry.command_family,\n    entry.host_path_prefix,\n    ...(entry.container_targets ?? []),\n    entry.image,\n    entry.user_response_quote,\n    entry.reason,\n  ]\n    .filter((value) => typeof value === 'string' && value.length > 0)\n    .join('\\n');\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\write-guard-log.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\write-guard-runtime-v12.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'fs' is defined but never used. Allowed unused vars must match /^_/u.","line":2,"column":13,"nodeType":"Identifier","messageId":"unusedVar","endLine":2,"endColumn":15,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"fs"},"fix":{"range":[64,95],"text":""},"desc":"Remove unused import declaration."}]},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `.replace(/\\\\/g,·'/')` with `⏎····.replace(/\\\\/g,·'/')⏎····`","line":31,"column":29,"nodeType":null,"messageId":"replace","endLine":31,"endColumn":49,"fix":{"range":[1168,1188],"text":"\n    .replace(/\\\\/g, '/')\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `.trim()` with `⏎····.trim()⏎····`","line":35,"column":29,"nodeType":null,"messageId":"replace","endLine":35,"endColumn":36,"fix":{"range":[1288,1295],"text":"\n    .trim()\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `.replace(/\\\\\"/g,·'\"')` with `⏎····.replace(/\\\\\"/g,·'\"')⏎····`","line":65,"column":31,"nodeType":null,"messageId":"replace","endLine":65,"endColumn":52,"fix":{"range":[2322,2343],"text":"\n    .replace(/\\\\\"/g, '\"')\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"\\\\b\"·+·escapedVerb·+·\"\\\\b[\\\\s\\\\S]{0,600}?-(?:\"·+·namePattern·+·\")\\\\s+[\\\"']([^\\\"']+)[\\\"']\"` with `'\\\\b'·+·escapedVerb·+·'\\\\b[\\\\s\\\\S]{0,600}?-(?:'·+·namePattern·+·')\\\\s+[\"\\']([^\"\\']+)[\"\\']'`","line":74,"column":5,"nodeType":null,"messageId":"replace","endLine":74,"endColumn":95,"fix":{"range":[2689,2779],"text":"'\\\\b' + escapedVerb + '\\\\b[\\\\s\\\\S]{0,600}?-(?:' + namePattern + ')\\\\s+[\"\\']([^\"\\']+)[\"\\']'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":75,"column":9,"nodeType":null,"messageId":"delete","endLine":75,"endColumn":10,"fix":{"range":[2789,2790],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":79,"column":9,"nodeType":null,"messageId":"delete","endLine":79,"endColumn":10,"fix":{"range":[2923,2924],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(value)` with `value`","line":84,"column":25,"nodeType":null,"messageId":"replace","endLine":84,"endColumn":32,"fix":{"range":[3173,3180],"text":"value"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":100,"column":21,"nodeType":null,"messageId":"delete","endLine":100,"endColumn":22,"fix":{"range":[3764,3765],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":113,"column":17,"nodeType":null,"messageId":"insert","endLine":113,"endColumn":17,"fix":{"range":[4357,4357],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":114,"column":7,"nodeType":null,"messageId":"insert","endLine":114,"endColumn":7,"fix":{"range":[4443,4443],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":115,"column":1,"nodeType":null,"messageId":"insert","endLine":115,"endColumn":1,"fix":{"range":[4457,4457],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'Path',·'LiteralPath',·'Name'` with `⏎······'Path',⏎······'LiteralPath',⏎······'Name',⏎····`","line":116,"column":78,"nodeType":null,"messageId":"replace","endLine":116,"endColumn":107,"fix":{"range":[4553,4582],"text":"\n      'Path',\n      'LiteralPath',\n      'Name',\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":128,"column":91,"nodeType":null,"messageId":"insert","endLine":128,"endColumn":91,"fix":{"range":[5075,5075],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":129,"column":91,"nodeType":null,"messageId":"insert","endLine":129,"endColumn":91,"fix":{"range":[5205,5205],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":130,"column":92,"nodeType":null,"messageId":"insert","endLine":130,"endColumn":92,"fix":{"range":[5336,5336],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":132,"column":91,"nodeType":null,"messageId":"insert","endLine":132,"endColumn":91,"fix":{"range":[5524,5524],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":133,"column":81,"nodeType":null,"messageId":"insert","endLine":133,"endColumn":81,"fix":{"range":[5644,5644],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":134,"column":81,"nodeType":null,"messageId":"insert","endLine":134,"endColumn":81,"fix":{"range":[5764,5764],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":138,"column":52,"nodeType":null,"messageId":"insert","endLine":138,"endColumn":52,"fix":{"range":[5973,5973],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":151,"column":50,"nodeType":null,"messageId":"insert","endLine":151,"endColumn":50,"fix":{"range":[6649,6649],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(target)` with `target`","line":154,"column":39,"nodeType":null,"messageId":"replace","endLine":154,"endColumn":47,"fix":{"range":[6746,6754],"text":"target"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `projectRoot:·string,·cwd:·string·|·undefined,·targetPath:·string` with `⏎··projectRoot:·string,⏎··cwd:·string·|·undefined,⏎··targetPath:·string⏎`","line":157,"column":28,"nodeType":null,"messageId":"replace","endLine":157,"endColumn":92,"fix":{"range":[6814,6878],"text":"\n  projectRoot: string,\n  cwd: string | undefined,\n  targetPath: string\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":164,"column":52,"nodeType":null,"messageId":"insert","endLine":164,"endColumn":52,"fix":{"range":[7340,7340],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·checked:·true,·allowed:·readOnly,·targets:·[],·violations:·readOnly·?·[]·:·['SHELL_EXECUTION_UNAVAILABLE:·unrecognized·effects;·no·isolated·executor']` with `⏎······checked:·true,⏎······allowed:·readOnly,⏎······targets:·[],⏎······violations:·readOnly⏎········?·[]⏎········:·['SHELL_EXECUTION_UNAVAILABLE:·unrecognized·effects;·no·isolated·executor'],⏎···`","line":188,"column":13,"nodeType":null,"messageId":"replace","endLine":188,"endColumn":164,"fix":{"range":[8189,8340],"text":"\n      checked: true,\n      allowed: readOnly,\n      targets: [],\n      violations: readOnly\n        ? []\n        : ['SHELL_EXECUTION_UNAVAILABLE: unrecognized effects; no isolated executor'],\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·checked:·true,·allowed:·false,·targets,·violations:·['no·active·work_item_id·for·shell·write·command'],·hard_stop:·false` with `⏎······checked:·true,⏎······allowed:·false,⏎······targets,⏎······violations:·['no·active·work_item_id·for·shell·write·command'],⏎······hard_stop:·false,⏎···`","line":192,"column":13,"nodeType":null,"messageId":"replace","endLine":192,"endColumn":134,"fix":{"range":[8388,8509],"text":"\n      checked: true,\n      allowed: false,\n      targets,\n      violations: ['no active work_item_id for shell write command'],\n      hard_stop: false,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `workItemDir(input.projectRoot,·input.workItemId),·input.workItemId` with `⏎······workItemDir(input.projectRoot,·input.workItemId),⏎······input.workItemId⏎····`","line":197,"column":35,"nodeType":null,"messageId":"replace","endLine":197,"endColumn":101,"fix":{"range":[8575,8641],"text":"\n      workItemDir(input.projectRoot, input.workItemId),\n      input.workItemId\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·checked:·true,·allowed:·false,·targets,·violations:·['AUTHORITATIVE_STATE_UNAVAILABLE'],·hard_stop:·false` with `⏎······checked:·true,⏎······allowed:·false,⏎······targets,⏎······violations:·['AUTHORITATIVE_STATE_UNAVAILABLE'],⏎······hard_stop:·false,⏎···`","line":211,"column":13,"nodeType":null,"messageId":"replace","endLine":211,"endColumn":119,"fix":{"range":[9022,9128],"text":"\n      checked: true,\n      allowed: false,\n      targets,\n      violations: ['AUTHORITATIVE_STATE_UNAVAILABLE'],\n      hard_stop: false,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·?·wi.allowed_write_files` with `⏎··············?·wi.allowed_write_files⏎·············`","line":238,"column":71,"nodeType":null,"messageId":"replace","endLine":238,"endColumn":96,"fix":{"range":[10156,10181],"text":"\n              ? wi.allowed_write_files\n             "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":246,"column":40,"nodeType":null,"messageId":"delete","endLine":246,"endColumn":41,"fix":{"range":[10457,10458],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":271,"column":35,"nodeType":null,"messageId":"delete","endLine":271,"endColumn":36,"fix":{"range":[11215,11216],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·checked:·true,·allowed:·false,·targets:·normalizedTargets,·violations:·uniqueViolations,·hard_stop:·true` with `⏎······checked:·true,⏎······allowed:·false,⏎······targets:·normalizedTargets,⏎······violations:·uniqueViolations,⏎······hard_stop:·true,⏎···`","line":273,"column":13,"nodeType":null,"messageId":"replace","endLine":273,"endColumn":118,"fix":{"range":[11236,11341],"text":"\n      checked: true,\n      allowed: false,\n      targets: normalizedTargets,\n      violations: uniqueViolations,\n      hard_stop: true,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":281,"column":30,"nodeType":null,"messageId":"delete","endLine":281,"endColumn":31,"fix":{"range":[11534,11535],"text":""}}],"suppressedMessages":[],"errorCount":33,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":32,"fixableWarningCount":0,"source":"import { parseReadOnlyCommand } from './sf_safe_bash_executor';\nimport * as fs from 'node:fs';\nimport * as path from 'node:path';\nimport { ACTOR_ROLES, type ActorRole } from '@specforge/types/actor-roles';\nimport { SPEC_DIR_NAME } from '@specforge/types/directory-layout';\nimport { checkWrite } from './write-guard-v11';\nimport { appendWriteGuardLog } from './write-guard-log';\nimport { setHardStop } from './hard-stop-latch';\nimport { parseChangedFilesAuditVerdictPass } from './changed-files-audit-verdict';\nimport { stripRemoteExecutionSegmentsForLocalWriteGuard } from './shell-command-write-intent';\nimport { isCandidateFrozenState } from './candidate-freeze-v11';\nimport { readWorkItemMetadataSync } from './work-item-metadata.js';\n\nexport type RuntimeWriteOperation = 'create' | 'modify' | 'delete';\n\nexport interface RuntimeWriteTarget {\n  path: string;\n  operation: RuntimeWriteOperation;\n  kind?: 'directory';\n}\n\nexport interface RuntimeWriteGuardResult {\n  checked: boolean;\n  allowed: boolean;\n  targets: RuntimeWriteTarget[];\n  violations: string[];\n  hard_stop?: boolean;\n}\n\nfunction normalizeSlashes(value: string): string {\n  return String(value ?? '').replace(/\\\\/g, '/').replace(/\\/+/g, '/');\n}\n\nfunction stripQuotes(value: string): string {\n  return String(value ?? '').trim().replace(/^[\"']|[\"']$/g, '');\n}\n\nfunction uniqueTargets(targets: RuntimeWriteTarget[]): RuntimeWriteTarget[] {\n  const seen = new Set<string>();\n  const result: RuntimeWriteTarget[] = [];\n  for (const target of targets) {\n    const key = target.operation + ':' + normalizeSlashes(target.path).toLowerCase();\n    if (seen.has(key)) continue;\n    seen.add(key);\n    result.push({\n      path: normalizeSlashes(target.path),\n      operation: target.operation,\n      ...(target.kind ? { kind: target.kind } : {}),\n    });\n  }\n  return result;\n}\n\nfunction escapeRegExp(value: string): string {\n  return String(value).replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n}\n\nfunction normalizeEscapedShellQuotes(command: string): string {\n  /*\n   * Tests and OpenCode logs may contain escaped quotes, for example:\n   * Out-File -FilePath \\\"src/todos/b.md\\\"\n   * Normalize only shell quote escapes so path extraction can treat them like\n   * normal quoted arguments. This does not modify Windows path separators.\n   */\n  return String(command ?? '').replace(/\\\\\"/g, '\"').replace(/\\\\'/g, \"'\");\n}\n\nfunction extractPowerShellArgument(command: string, verb: string, namedArgs: string[]): string[] {\n  const text = normalizeEscapedShellQuotes(command);\n  const results: string[] = [];\n  const namePattern = namedArgs.map(escapeRegExp).join('|');\n  const escapedVerb = escapeRegExp(verb);\n  const quoted = new RegExp(\n    \"\\\\b\" + escapedVerb + \"\\\\b[\\\\s\\\\S]{0,600}?-(?:\" + namePattern + \")\\\\s+[\\\"']([^\\\"']+)[\\\"']\",\n    'ig',\n  );\n  const unquoted = new RegExp(\n    '\\\\b' + escapedVerb + '\\\\b[\\\\s\\\\S]{0,600}?-(?:' + namePattern + ')\\\\s+([^\\\\s;|]+)',\n    'ig',\n  );\n  let match: RegExpExecArray | null;\n  while ((match = quoted.exec(text)) !== null) results.push(stripQuotes(match[1] ?? ''));\n  while ((match = unquoted.exec(text)) !== null) results.push(stripQuotes(match[1] ?? ''));\n  return results.filter((value) => value.length > 0);\n}\n\nfunction isShellRedirectionSink(rawTarget: string): boolean {\n  const cleaned = stripQuotes(rawTarget).trim();\n  const normalized = cleaned.replace(/\\\\/g, '/').toLowerCase();\n  if (/^&\\d+$/.test(cleaned) || cleaned === '&-') return true;\n  if (normalized === '/dev/null' || normalized === 'dev/null') return true;\n  if (normalized === 'nul' || normalized === 'nul:' || normalized === 'null') return true;\n  return false;\n}\n\nfunction pushShellTarget(\n  targets: RuntimeWriteTarget[],\n  rawPath: string,\n  operation: RuntimeWriteOperation,\n  kind?: 'directory',\n): void {\n  const cleaned = stripQuotes(rawPath);\n  if (!cleaned || isShellRedirectionSink(cleaned)) return;\n  targets.push({ path: cleaned, operation, ...(kind ? { kind } : {}) });\n}\n\nfunction extractPowerShellNewItemTargets(command: string): RuntimeWriteTarget[] {\n  const results: RuntimeWriteTarget[] = [];\n  const segments = command.match(/\\bNew-Item\\b[^;|\\r\\n]*/gi) ?? [];\n  for (const segment of segments) {\n    const tokens = segment.replace(/[\"']/g, ' ').trim().split(/\\s+/);\n    const itemTypeIndex = tokens.findIndex(token => token.toLowerCase() === '-itemtype');\n    const kind = itemTypeIndex >= 0 && tokens[itemTypeIndex + 1]?.toLowerCase() === 'directory'\n      ? 'directory'\n      : undefined;\n    for (const targetPath of extractPowerShellArgument(segment, 'New-Item', ['Path', 'LiteralPath', 'Name'])) {\n      pushShellTarget(results, targetPath, 'create', kind);\n    }\n  }\n  return results;\n}\n\nexport function extractShellWriteTargets(command: string): RuntimeWriteTarget[] {\n  const remoteAware = stripRemoteExecutionSegmentsForLocalWriteGuard(String(command ?? ''));\n  const text = normalizeEscapedShellQuotes(remoteAware.command_for_local_write_scan);\n  const targets: RuntimeWriteTarget[] = [];\n\n  for (const p of extractPowerShellArgument(text, 'Set-Content', ['Path', 'LiteralPath'])) pushShellTarget(targets, p, 'create');\n  for (const p of extractPowerShellArgument(text, 'Add-Content', ['Path', 'LiteralPath'])) pushShellTarget(targets, p, 'modify');\n  for (const p of extractPowerShellArgument(text, 'Out-File', ['FilePath', 'LiteralPath'])) pushShellTarget(targets, p, 'create');\n  targets.push(...extractPowerShellNewItemTargets(text));\n  for (const p of extractPowerShellArgument(text, 'Remove-Item', ['Path', 'LiteralPath'])) pushShellTarget(targets, p, 'delete');\n  for (const p of extractPowerShellArgument(text, 'Copy-Item', ['Destination'])) pushShellTarget(targets, p, 'create');\n  for (const p of extractPowerShellArgument(text, 'Move-Item', ['Destination'])) pushShellTarget(targets, p, 'create');\n\n  const redirection = /(?:^|[\\s;|])(?:\\d*>>?|\\d*>&)\\s*[\"']?([^\"'\\s;|]+)[\"']?/g;\n  let match: RegExpExecArray | null;\n  while ((match = redirection.exec(text)) !== null) pushShellTarget(targets, match[1] ?? '', 'modify');\n\n  const tee = /\\btee(?:-object)?\\s+(?:-FilePath\\s+)?[\"']?([^\"'\\s;|]+)[\"']?/gi;\n  while ((match = tee.exec(text)) !== null) pushShellTarget(targets, match[1] ?? '', 'modify');\n\n  const shellCommands: Array<[RegExp, RuntimeWriteOperation]> = [\n    [/\\btouch\\s+[\"']?([^\"'\\s;|]+)[\"']?/gi, 'create'],\n    [/\\brm\\s+(?:-[a-zA-Z]+\\s+)*[\"']?([^\"'\\s;|]+)[\"']?/gi, 'delete'],\n    [/\\bcp\\s+[\"']?[^\"'\\s;|]+[\"']?\\s+[\"']?([^\"'\\s;|]+)[\"']?/gi, 'create'],\n    [/\\bmv\\s+[\"']?[^\"'\\s;|]+[\"']?\\s+[\"']?([^\"'\\s;|]+)[\"']?/gi, 'create'],\n  ];\n\n  for (const [pattern, operation] of shellCommands) {\n    while ((match = pattern.exec(text)) !== null) pushShellTarget(targets, match[1] ?? '', operation);\n  }\n\n  return uniqueTargets(targets.filter((target) => target.path.length > 0));\n}\n\nfunction toProjectRelative(projectRoot: string, cwd: string | undefined, targetPath: string): { relative?: string; violation?: string } {\n  const cleaned = stripQuotes(targetPath);\n  if (!cleaned) return { violation: 'empty target path' };\n  const base = cwd && path.isAbsolute(cwd) ? cwd : projectRoot;\n  const absolute = path.isAbsolute(cleaned) ? path.resolve(cleaned) : path.resolve(base, cleaned);\n  const projectAbs = path.resolve(projectRoot);\n  const rel = path.relative(projectAbs, absolute);\n  if (rel.startsWith('..') || path.isAbsolute(rel)) return { violation: 'write target is outside project root: ' + cleaned };\n  return { relative: normalizeSlashes(rel) };\n}\n\nfunction workItemDir(projectRoot: string, workItemId: string): string {\n  return path.join(projectRoot, SPEC_DIR_NAME, 'work-items', workItemId);\n}\n\nfunction isKnownActorRole(value: string | undefined): value is ActorRole {\n  return !!value && Object.values(ACTOR_ROLES).includes(value as ActorRole);\n}\n\nexport function enforceRuntimeWriteGuardForShell(input: {\n  projectRoot: string;\n  workItemId: string | null;\n  command: string;\n  cwd?: string;\n  callerRole?: string;\n  tool?: string;\n  authoritativeState?: string | null;\n}): RuntimeWriteGuardResult {\n  const targets = extractShellWriteTargets(input.command);\n  if (targets.length === 0) {\n    const readOnly = parseReadOnlyCommand(input.command) !== null;\n    return { checked: true, allowed: readOnly, targets: [], violations: readOnly ? [] : ['SHELL_EXECUTION_UNAVAILABLE: unrecognized effects; no isolated executor'] };\n  }\n\n  if (!input.workItemId) {\n    return { checked: true, allowed: false, targets, violations: ['no active work_item_id for shell write command'], hard_stop: false };\n  }\n\n  let wi: any;\n  try {\n    wi = readWorkItemMetadataSync(workItemDir(input.projectRoot, input.workItemId), input.workItemId);\n  } catch (error) {\n    return {\n      checked: true,\n      allowed: false,\n      targets,\n      violations: [error instanceof Error ? error.message : String(error)],\n      hard_stop: false,\n    };\n  }\n\n  const actor = isKnownActorRole(input.callerRole) ? input.callerRole : ACTOR_ROLES.agent;\n  const currentState = input.authoritativeState;\n  if (!currentState) {\n    return { checked: true, allowed: false, targets, violations: ['AUTHORITATIVE_STATE_UNAVAILABLE'], hard_stop: false };\n  }\n  const allViolations: string[] = [];\n  const normalizedTargets: RuntimeWriteTarget[] = [];\n\n  for (const target of targets) {\n    const targetViolations: string[] = [];\n    const resolved = toProjectRelative(input.projectRoot, input.cwd, target.path);\n    const relative = resolved.relative ?? target.path;\n    const normalizedTarget = {\n      path: relative,\n      operation: target.operation,\n      ...(target.kind ? { kind: target.kind } : {}),\n    };\n    normalizedTargets.push(normalizedTarget);\n\n    if (resolved.violation) targetViolations.push(resolved.violation);\n\n    if (!resolved.violation) {\n      const check = checkWrite(\n        {\n          hasActiveWI: true,\n          workItem: {\n            work_item_id: String(wi.work_item_id ?? input.workItemId),\n            status: currentState ?? '',\n            code_change_allowed: wi.code_change_allowed === true,\n            code_permission_revoked: wi.code_permission_revoked === true,\n            allowed_write_files: Array.isArray(wi.allowed_write_files) ? wi.allowed_write_files : [],\n            workflow_path: wi.workflow_path ?? null,\n          },\n          callerRole: actor,\n          isFrozen: currentState ? isCandidateFrozenState(currentState) : true,\n        },\n        relative,\n        target.operation,\n        { kind: target.kind ?? 'file' },\n      );\n      if (!check.allowed) targetViolations.push(...check.violations);\n    }\n\n    appendWriteGuardLog(workItemDir(input.projectRoot, input.workItemId), {\n      timestamp: new Date().toISOString(),\n      path: relative,\n      operation: target.operation,\n      actor,\n      allowed: targetViolations.length === 0,\n      violations: targetViolations,\n      tool: input.tool ?? 'sf_safe_bash',\n      command: input.command,\n    });\n\n    allViolations.push(...targetViolations);\n  }\n\n  if (allViolations.length > 0) {\n    const uniqueViolations = Array.from(new Set(allViolations));\n    setHardStop(\n      input.projectRoot,\n      input.workItemId,\n      'WRITE_GUARD_RUNTIME_BLOCKED: ' + uniqueViolations.join('; '),\n      input.tool ?? 'sf_safe_bash',\n    );\n    return { checked: true, allowed: false, targets: normalizedTargets, violations: uniqueViolations, hard_stop: true };\n  }\n\n  return { checked: true, allowed: true, targets: normalizedTargets, violations: [] };\n}\n\nexport function parseChangedFilesAuditPass(\n  auditText: string,\n  expectedWorkItemId?: string,\n): { passed: boolean; reason?: string } {\n  return parseChangedFilesAuditVerdictPass(auditText, { expectedWorkItemId });\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\write-guard-v11.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"@specforge/types/directory-layout\"` with `'@specforge/types/directory-layout'`","line":1,"column":31,"nodeType":null,"messageId":"replace","endLine":1,"endColumn":66,"fix":{"range":[30,65],"text":"'@specforge/types/directory-layout'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":29,"column":59,"nodeType":null,"messageId":"insert","endLine":29,"endColumn":59,"fix":{"range":[1026,1026],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":35,"column":38,"nodeType":null,"messageId":"insert","endLine":35,"endColumn":38,"fix":{"range":[1182,1182],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":71,"column":41,"nodeType":null,"messageId":"delete","endLine":71,"endColumn":42,"fix":{"range":[2443,2444],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":105,"column":17,"nodeType":null,"messageId":"delete","endLine":105,"endColumn":18,"fix":{"range":[3389,3390],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":110,"column":83,"nodeType":null,"messageId":"delete","endLine":110,"endColumn":84,"fix":{"range":[3598,3599],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(`${SPEC_DIR_NAME}/project/`·as·const)` with ``${SPEC_DIR_NAME}/project/`·as·const`","line":120,"column":45,"nodeType":null,"messageId":"replace","endLine":120,"endColumn":83,"fix":{"range":[4052,4090],"text":"`${SPEC_DIR_NAME}/project/` as const"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace ``spec_write_by_non_merge_runner:·${normalized}·(actor:·${actor·??·'unknown'})`` with `⏎··········`spec_write_by_non_merge_runner:·${normalized}·(actor:·${actor·??·'unknown'})`⏎········`","line":128,"column":25,"nodeType":null,"messageId":"replace","endLine":128,"endColumn":103,"fix":{"range":[4342,4420],"text":"\n          `spec_write_by_non_merge_runner: ${normalized} (actor: ${actor ?? 'unknown'})`\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":161,"column":32,"nodeType":null,"messageId":"insert","endLine":161,"endColumn":32,"fix":{"range":[5347,5347],"text":";"}}],"suppressedMessages":[],"errorCount":9,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":9,"fixableWarningCount":0,"source":"import { SPEC_DIR_NAME } from \"@specforge/types/directory-layout\";\n/**\n * write-guard-v11.ts — v1.1 标准 Write Guard（§12.5-§12.6）\n *\n * 产品边界：SPS-1.0。当前可执行合同由本模块导出、Runtime 消费者与回归测试固定；归档 v1.1 标准仅作历史证据。\n *\n * **CANONICAL WRITE GUARD — all write decisions MUST go through this module.**\n *\n * Write Guard 是程序级写入拦截器，必须覆盖所有写入入口。\n * 所有写入必须声明 expected_write_files，无声明则默认只读或阻断。\n *\n * 拦截规则（§12.6）：\n * 1. 无 active WI 写代码\n * 2. code_change_allowed=false 写代码\n * 3. 写入不在 allowed_write_files 内的代码文件\n * 4. 普通 Agent 写 .specforge/project/**\n * 5. 普通 Agent 写 user_decision.json\n * 6. 普通 Agent 写 gates/**\n * 7. 普通 Agent 写 gate_summary.md\n * 8. 普通 Agent 写 merge_report.md\n * 9. 冻结后修改 Candidate / Manifest / Gate Summary\n * 10. closed WI 继续写入\n *\n * Default is DENY; allow only for controlled subjects with specific path patterns.\n * ACTOR_ROLES: 'merge_runner', 'gate_runner', 'user_decision_recorder',\n *              'sf-orchestrator', 'code_permission_service', 'close_gate', 'agent'\n */\n\nimport { ACTOR_ROLES } from '@specforge/types/actor-roles'\nimport {\n  decideWritePermission,\n  type WriteDecisionContext,\n  type WriteDecisionResult,\n  type WriteTargetDetails,\n} from '@specforge/permission-engine'\n\n// ---------------------------------------------------------------------------\n// Core types — canonical definitions\n// ---------------------------------------------------------------------------\n\n/**\n * Context for the canonical write guard check.\n * All write-policy consumers MUST use this type.\n */\nexport type WriteGuardContext = WriteDecisionContext;\n\n/**\n * Result of a write-permission check.\n */\nexport type WriteCheckResult = WriteDecisionResult;\n\n// ---------------------------------------------------------------------------\n// checkWrite — CANONICAL single judgment entry point (§12.5-§12.6)\n// ---------------------------------------------------------------------------\n\n/**\n * Check whether a write operation is allowed.\n *\n * This is the **single canonical entry point** for ALL write-permission\n * decisions in the system. Every module that needs to gate writes MUST\n * call this function (or a thin wrapper that delegates here).\n *\n * @param ctx Write Guard context\n * @param targetPath Target path to write (relative to project root)\n * @param operation Write operation type\n */\nexport function checkWrite(\n  ctx: WriteGuardContext,\n  targetPath: string,\n  operation: 'create' | 'modify' | 'delete',\n  targetDetails: WriteTargetDetails = {},\n): WriteCheckResult {\n  return decideWritePermission(ctx, targetPath, operation, targetDetails);\n}\n\n// ---------------------------------------------------------------------------\n// changed_files_audit（§12.7）\n// ---------------------------------------------------------------------------\n\nexport interface AuditEntry {\n  path: string;\n  operation: 'create' | 'modify' | 'delete';\n  in_allowed_write_files: boolean;\n  is_spec_write: boolean;\n  is_side_effect: boolean;\n}\n\nexport interface AuditResult {\n  passed: boolean;\n  total_files: number;\n  in_scope: number;\n  out_of_scope: number;\n  spec_writes: number;\n  side_effects: number;\n  violations: string[];\n  entries: AuditEntry[];\n}\n\n/**\n * Execute a changed-files audit (§12.7).\n */\nexport function performChangedFilesAudit(\n  changedFiles: Array<{ path: string; operation: 'create' | 'modify' | 'delete' }>,\n  allowedWriteFiles: Array<{ path: string; operation: string }>,\n  actor?: string,\n): AuditResult {\n  const entries: AuditEntry[] = [];\n  const violations: string[] = [];\n  const normalizedAllowed = new Map(\n    allowedWriteFiles.map(f => [f.path.replace(/\\\\/g, '/'), f.operation] as const),\n  );\n\n  for (const file of changedFiles) {\n    const normalized = file.path.replace(/\\\\/g, '/');\n    const inScope = Array.from(normalizedAllowed.entries()).some(([allowedPath, allowedOp]) => {\n      const pathMatch = normalized === allowedPath || normalized.startsWith(allowedPath + '/');\n      const opMatch = allowedOp === file.operation || allowedOp === 'any';\n      return pathMatch && opMatch;\n    });\n    let isSpecWrite = normalized.startsWith((`${SPEC_DIR_NAME}/project/` as const));\n    const isSideEffect = !inScope && !isSpecWrite;\n\n    if (isSpecWrite) {\n      if (actor === ACTOR_ROLES.mergeRunner) {\n        // Legitimate merge_runner write — not a violation\n        isSpecWrite = false;\n      } else {\n        violations.push(`spec_write_by_non_merge_runner: ${normalized} (actor: ${actor ?? 'unknown'})`);\n      }\n    }\n\n    entries.push({\n      path: normalized,\n      operation: file.operation,\n      in_allowed_write_files: inScope,\n      is_spec_write: isSpecWrite,\n      is_side_effect: isSideEffect,\n    });\n\n    if (!inScope && !isSpecWrite) {\n      violations.push(`out_of_scope: ${normalized}`);\n    }\n  }\n\n  return {\n    passed: violations.length === 0,\n    total_files: changedFiles.length,\n    in_scope: entries.filter(e => e.in_allowed_write_files).length,\n    out_of_scope: entries.filter(e => !e.in_allowed_write_files && !e.is_spec_write).length,\n    spec_writes: entries.filter(e => e.is_spec_write).length,\n    side_effects: entries.filter(e => e.is_side_effect).length,\n    violations,\n    entries,\n  };\n}\n\n// ---------------------------------------------------------------------------\n// Re-exports\n// ---------------------------------------------------------------------------\n\nexport * from './bash-guard.js'\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\types.test.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":21,"column":1,"nodeType":null,"messageId":"delete","endLine":21,"endColumn":5,"fix":{"range":[597,601],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":38,"column":1,"nodeType":null,"messageId":"delete","endLine":38,"endColumn":5,"fix":{"range":[1020,1024],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":53,"column":1,"nodeType":null,"messageId":"delete","endLine":53,"endColumn":5,"fix":{"range":[1437,1441],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":72,"column":1,"nodeType":null,"messageId":"delete","endLine":72,"endColumn":5,"fix":{"range":[1939,1943],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":85,"column":1,"nodeType":null,"messageId":"delete","endLine":85,"endColumn":5,"fix":{"range":[2286,2290],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":96,"column":1,"nodeType":null,"messageId":"delete","endLine":96,"endColumn":5,"fix":{"range":[2555,2559],"text":""}}],"suppressedMessages":[],"errorCount":6,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":6,"fixableWarningCount":0,"source":"/**\n * Type definitions tests\n */\n\nimport { describe, it, expect } from 'vitest';\nimport { AgentIdentity, Event, ProjectState, HandshakeFile, Lock, Subscription } from './types';\n\ndescribe('Types', () => {\n  it('should create AgentIdentity', () => {\n    const identity: AgentIdentity = {\n      sessionId: 'session-123',\n      agentRole: 'sf-orchestrator',\n      workflowRole: 'requirements-phase-executor',\n      parentSessionId: null,\n      workItemId: 'work-item-123',\n      spawnIntentId: 'spawn-123',\n      createdAt: Date.now(),\n      lastActiveAt: Date.now(),\n      status: 'active',\n    };\n    \n    expect(identity.sessionId).toBe('session-123');\n    expect(identity.status).toBe('active');\n  });\n\n  it('should create Event', () => {\n    const event: Event = {\n      eventId: 'event-123',\n      ts: Date.now(),\n      projectId: 'project-123',\n      action: 'session.activated',\n      payload: { sessionId: 'session-123' },\n      metadata: {\n        schemaVersion: '1.0',\n        source: 'client',\n      },\n    };\n    \n    expect(event.eventId).toBe('event-123');\n    expect(event.action).toBe('session.activated');\n  });\n\n  it('should create ProjectState', () => {\n    const state: ProjectState = {\n      stateVersion: 0,\n      projectPath: '/path/to/project',\n      schemaVersion: '1.0',\n      activeSessions: ['session-1', 'session-2'],\n      workItems: [],\n      lastEventId: 'event-123',\n      lastEventTs: Date.now(),\n    };\n    \n    expect(state.projectPath).toBe('/path/to/project');\n    expect(state.activeSessions).toHaveLength(2);\n  });\n\n  it('should create HandshakeFile', () => {\n    const handshake: HandshakeFile = {\n      pid: 12345,\n      port: 8080,\n      token: 'random-token-123',\n      bound_to: '127.0.0.1',\n      startedAt: Date.now(),\n      schema_version: '1.0',\n      version: '1.0.0',\n      serviceMode: false,\n      artifact_contract_versions: {\n        task_document: 'task-document/v1',\n      },\n    };\n    \n    expect(handshake.pid).toBe(12345);\n    expect(handshake.bound_to).toBe('127.0.0.1');\n    expect(handshake.schema_version).toBe('1.0');\n  });\n\n  it('should create Lock', () => {\n    const lock: Lock = {\n      id: 'lock-123',\n      projectPath: '/path/to/project',\n      acquiredAt: Date.now(),\n      expiresAt: Date.now() + 30_000,\n    };\n    \n    expect(lock.id).toBe('lock-123');\n    expect(lock.projectPath).toBe('/path/to/project');\n  });\n\n  it('should create Subscription', () => {\n    const subscription: Subscription = {\n      id: 'sub-123',\n      topic: 'test.event',\n      handler: () => {},\n    };\n    \n    expect(subscription.id).toBe('sub-123');\n    expect(subscription.topic).toBe('test.event');\n  });\n});\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\types.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\verification\\VerificationRuntime.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·ToolInvocationVerifier,·TrustedToolInvocationProof·` with `⏎··ToolInvocationVerifier,⏎··TrustedToolInvocationProof,⏎`","line":5,"column":14,"nodeType":null,"messageId":"replace","endLine":5,"endColumn":66,"fix":{"range":[204,256],"text":"\n  ToolInvocationVerifier,\n  TrustedToolInvocationProof,\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·VerificationOwnerStore,·assertVerificationPath,·canonicalVerificationJson·as·json,·readVerificationFile,·verificationId·as·hash·` with `⏎··VerificationOwnerStore,⏎··assertVerificationPath,⏎··canonicalVerificationJson·as·json,⏎··readVerificationFile,⏎··verificationId·as·hash,⏎`","line":9,"column":9,"nodeType":null,"messageId":"replace","endLine":9,"endColumn":138,"fix":{"range":[579,708],"text":"\n  VerificationOwnerStore,\n  assertVerificationPath,\n  canonicalVerificationJson as json,\n  readVerificationFile,\n  verificationId as hash,\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·VerificationNativeExecutor,·nativeConfigPath,·nativeRunRoot,·requestVerificationCancellation,·writeVerificationPrivate,·type·NativeExecutionFacts·` with `⏎··VerificationNativeExecutor,⏎··nativeConfigPath,⏎··nativeRunRoot,⏎··requestVerificationCancellation,⏎··writeVerificationPrivate,⏎··type·NativeExecutionFacts,⏎`","line":12,"column":9,"nodeType":null,"messageId":"replace","endLine":12,"endColumn":156,"fix":{"range":[897,1044],"text":"\n  VerificationNativeExecutor,\n  nativeConfigPath,\n  nativeRunRoot,\n  requestVerificationCancellation,\n  writeVerificationPrivate,\n  type NativeExecutionFacts,\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·validateVerificationPlan,·validateVerificationAttempt,·validateVerificationReceipt,·validateVerificationInvocationLease,·validateTrustedInvocationProof,` with `⏎··validateVerificationPlan,⏎··validateVerificationAttempt,⏎··validateVerificationReceipt,⏎··validateVerificationInvocationLease,⏎··validateTrustedInvocationProof,⏎·`","line":15,"column":9,"nodeType":null,"messageId":"replace","endLine":15,"endColumn":162,"fix":{"range":[1220,1373],"text":"\n  validateVerificationPlan,\n  validateVerificationAttempt,\n  validateVerificationReceipt,\n  validateVerificationInvocationLease,\n  validateTrustedInvocationProof,\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·verificationHash,·sameVerificationPath·` with `⏎··verificationHash,⏎··sam