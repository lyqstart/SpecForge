6,"column":14,"nodeType":null,"messageId":"replace","endLine":16,"endColumn":25,"fix":{"range":[1311,1322],"text":" HostProfile "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `args:·SafeBashArgs,·baseDir:·string` with `⏎··args:·SafeBashArgs,⏎··baseDir:·string⏎`","line":18,"column":39,"nodeType":null,"messageId":"replace","endLine":18,"endColumn":74,"fix":{"range":[1364,1399],"text":"\n  args: SafeBashArgs,\n  baseDir: string\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `command:·args.command,·cwd:·path.resolve(baseDir,·args.cwd·??·'.'),` with `⏎····command:·args.command,⏎····cwd:·path.resolve(baseDir,·args.cwd·??·'.'),⏎···`","line":19,"column":40,"nodeType":null,"messageId":"replace","endLine":19,"endColumn":107,"fix":{"range":[1467,1534],"text":"\n    command: args.command,\n    cwd: path.resolve(baseDir, args.cwd ?? '.'),\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·outputLimit:·args.outputLimit·??·4096,·env:·args.env,·stdin:·args.stdin` with `⏎····outputLimit:·args.outputLimit·??·4096,⏎····env:·args.env,⏎····stdin:·args.stdin,⏎··`","line":20,"column":40,"nodeType":null,"messageId":"replace","endLine":20,"endColumn":112,"fix":{"range":[1596,1668],"text":"\n    outputLimit: args.outputLimit ?? 4096,\n    env: args.env,\n    stdin: args.stdin,\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `schema_version:'1.0',ts:new·Date().toISOString(),·command:args.command,·cwd:result.cwd,·shell:null,·exitCode:result.exitCode,·durationMs:result.durationMs,·rejected:result.rejected,·rule:result.rule??null,·timeout:result.timeout,success:result.success,stdout_size:result.stdout.length,stderr_size:result.stderr.length,callerRole:args.callerRole??null` with `⏎····schema_version:·'1.0',⏎····ts:·new·Date().toISOString(),⏎····command:·args.command,⏎····cwd:·result.cwd,⏎····shell:·null,⏎····exitCode:·result.exitCode,⏎····durationMs:·result.durationMs,⏎····rejected:·result.rejected,⏎····rule:·result.rule·??·null,⏎····timeout:·result.timeout,⏎····success:·result.success,⏎····stdout_size:·result.stdout.length,⏎····stderr_size:·result.stderr.length,⏎····callerRole:·args.callerRole·??·null,⏎··`","line":21,"column":30,"nodeType":null,"messageId":"replace","endLine":21,"endColumn":380,"fix":{"range":[1701,2051],"text":"\n    schema_version: '1.0',\n    ts: new Date().toISOString(),\n    command: args.command,\n    cwd: result.cwd,\n    shell: null,\n    exitCode: result.exitCode,\n    durationMs: result.durationMs,\n    rejected: result.rejected,\n    rule: result.rule ?? null,\n    timeout: result.timeout,\n    success: result.success,\n    stdout_size: result.stdout.length,\n    stderr_size: result.stderr.length,\n    callerRole: args.callerRole ?? null,\n  "}}],"suppressedMessages":[],"errorCount":17,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":17,"fixableWarningCount":0,"source":"/** SPS §9.2 / D18: internal read operations and a fixed audit sink; no shell, subprocess or HostProfile synthesis. */\nimport * as path from \"node:path\";\nimport type {SafeBashArgs, SafeBashResult} from \"./sf_safe_bash_types\";\nimport {executeCommand, appendShellAudit} from \"./sf_safe_bash_executor\";\ninterface HostProfile {\n  schema_version: string\n  hostname: string\n  os: { platform: string; release: string; version: string; arch: string; totalmem_gb: number; cpu_count: number }\n  locale: { system_lang: string; console_codepage: number | null; encoding: string; timezone: string; tz_offset_minutes: number; datetime_now: string }\n  shells: Array<{ name: string; path: string | null; version: string | null; default_encoding: string; needs_encoding_fix: boolean; available: boolean; preferred: boolean; note?: string }>\n  tools: Record<string, { available: boolean; version: string | null; path: string | null; note?: string }>\n  shell_rules: { preferred_shell: string | null; max_command_length: number; encoding_setup_command: string; path_separator: string; path_quote_required_for_spaces: boolean; supports_glob_in_shell: boolean; ci_mode: boolean }\n  user: { username: string; home_dir: string; shell_history_file: string | null }\n  specforge: { install_root: string; logs_dir: string }\n}\nexport type {HostProfile};\n\nexport async function safeBashExecute(args: SafeBashArgs, baseDir: string): Promise<SafeBashResult> {\n  const result = await executeCommand({command: args.command, cwd: path.resolve(baseDir, args.cwd ?? '.'), projectRoot: baseDir,\n    timeoutMs: args.timeoutMs ?? 60000, outputLimit: args.outputLimit ?? 4096, env: args.env, stdin: args.stdin});\n  appendShellAudit(baseDir, {schema_version:'1.0',ts:new Date().toISOString(), command:args.command, cwd:result.cwd, shell:null, exitCode:result.exitCode, durationMs:result.durationMs, rejected:result.rejected, rule:result.rule??null, timeout:result.timeout,success:result.success,stdout_size:result.stdout.length,stderr_size:result.stderr.length,callerRole:args.callerRole??null});\n  return result;\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\sf_safe_bash_executor.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"@specforge/types/directory-layout\"` with `'@specforge/types/directory-layout'`","line":1,"column":31,"nodeType":null,"messageId":"replace","endLine":1,"endColumn":66,"fix":{"range":[30,65],"text":"'@specforge/types/directory-layout'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·`","line":10,"column":34,"nodeType":null,"messageId":"insert","endLine":10,"endColumn":34,"fix":{"range":[479,479],"text":"\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·kind:·'pwd'·|·'echo'·|·'read'·|·'list'·|·'exists'·|·'hash'·|·'wait';·value:·string·` with `⏎··kind:·'pwd'·|·'echo'·|·'read'·|·'list'·|·'exists'·|·'hash'·|·'wait';⏎··value:·string;⏎`","line":11,"column":19,"nodeType":null,"messageId":"replace","endLine":11,"endColumn":10