eration:·WriteOperation·}>` with `⏎··workItemDir:·string,⏎··entries:·Array<{·path:·string;·operation:·WriteOperation·}>⏎`","line":73,"column":41,"nodeType":null,"messageId":"replace","endLine":73,"endColumn":121,"fix":{"range":[3496,3576],"text":"\n  workItemDir: string,\n  entries: Array<{ path: string; operation: WriteOperation }>\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·seen.add(key);·result.push({·path:·p,·operation·});` with `⏎··········seen.add(key);⏎··········result.push({·path:·p,·operation·});⏎·······`","line":85,"column":30,"nodeType":null,"messageId":"replace","endLine":85,"endColumn":82,"fix":{"range":[4303,4355],"text":"\n          seen.add(key);\n          result.push({ path: p, operation });\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":94,"column":51,"nodeType":null,"messageId":"delete","endLine":94,"endColumn":52,"fix":{"range":[4609,4610],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":104,"column":44,"nodeType":null,"messageId":"insert","endLine":104,"endColumn":44,"fix":{"range":[5021,5021],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `······` with `········`","line":105,"column":1,"nodeType":null,"messageId":"replace","endLine":105,"endColumn":7,"fix":{"range":[5048,5054],"text":"        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":106,"column":1,"nodeType":null,"messageId":"insert","endLine":106,"endColumn":1,"fix":{"range":[5071,5071],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":107,"column":11,"nodeType":null,"messageId":"insert","endLine":107,"endColumn":11,"fix":{"range":[5139,5139],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":108,"column":1,"nodeType":null,"messageId":"insert","endLine":108,"endColumn":1,"fix":{"range":[5157,5157],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":109,"column":9,"nodeType":null,"messageId":"insert","endLine":109,"endColumn":9,"fix":{"range":[5223,5223],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":121,"column":32,"nodeType":null,"messageId":"delete","endLine":121,"endColumn":33,"fix":{"range":[5625,5626],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":127,"column":26,"nodeType":null,"messageId":"insert","endLine":127,"endColumn":26,"fix":{"range":[6019,6019],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `?·normalizePermissionEntries(initial.allowed_write_files)` with `··?·normalizePermissionEntries(initial.allowed_write_files)⏎·····`","line":128,"column":5,"nodeType":null,"messageId":"replace","endLine":128,"endColumn":62,"fix":{"range":[6105,6162],"text":"  ? normalizePermissionEntries(initial.allowed_write_files)\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace ``${frozen.error·??·'SCOPE_EXPANSION_REQUIRED'}:·${frozen.checks.filter(check·=>·!check.passed).map(check·=>·check.description).join(';·')}`` with `⏎······`${frozen.error·??·'SCOPE_EXPANSION_REQUIRED'}:·${frozen.checks⏎········.filter(check·=>·!check.passed)⏎········.map(check·=>·check.description)⏎········.join(';·')}`⏎····`","line":142,"column":21,"nodeType":null,"messageId":"replace","endLine":142,"endColumn":160,"fix":{"range":[6762,6901],"text":"\n      `${frozen.error ?? 'SCOPE_EXPANSION_REQUIRED'}: ${frozen.checks\n        .filter(check => !check.passed)\n        .map(check => check.description)\n        .join('; ')}`\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":157,"column":38,"nodeType":null,"messageId":"delete","endLine":157,"endColumn":39,"fix":{"range":[7166,7167],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":181,"column":9,"nodeType":null,"messageId":"insert","endLine":181,"endColumn":9,"fix":{"range":[8038,8038],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `··········typeof·entry·===·'object'·&&·entry·!==·null·&&·!Array.isArray(entry),` with `············typeof·entry·===·'object'·&&·entry·!==·null·&&·!Array.isArray(entry)`","line":182,"column":1,"nodeType":null,"messageId":"replace","endLine":182,"endColumn":80,"fix":{"range":[8083,8162],"text":"            typeof entry === 'object' && entry !== null && !Array.isArray(entry)"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":183,"column":1,"nodeType":null,"messageId":"insert","endLine":183,"endColumn":1,"fix":{"range":[8163,8163],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·mode:·releaseMode,` with `⏎······mode:·releaseMode,⏎·····`","line":186,"column":22,"nodeType":null,"messageId":"replace","endLine":186,"endColumn":41,"fix":{"range":[8223,8242],"text":"\n      mode: releaseMode,\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":187,"column":46,"nodeType":null,"messageId":"insert","endLine":187,"endColumn":46,"fix":{"range":[8328,8328],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":199,"column":83,"nodeType":null,"messageId":"delete","endLine":199,"endColumn":84,"fix":{"range":[9077,9078],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `input:·ReleasePermissionInput` with `⏎··input:·ReleasePermissionInput⏎`","line":228,"column":45,"nodeType":null,"messageId":"replace","endLine":228,"endColumn":74,"fix":{"range":[10094,10123],"text":"\n  input: ReleasePermissionInput\n"}}],"suppressedMessages":[],"errorCount":30,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":30,"fixableWarningCount":0,"source":"/** Code Permission service with frozen governance scope. */\nimport * as path from 'node:path';\nimport {\n  freezeGovernanceScopeForCodePermission,\n  persistGovernanceScope,\n} from './project-governance-v2.js';\nimport { readWorkItemMetadata, writeWorkItemMetadata } from './work-item-metadata.js';\nexport type WriteOperation = 'create' | 'modify' | 'delete';\nexport interface PermissionState {\n  code_change_allowed: boolean;\n  allowed_write_files: Array<{ path: string; operation: WriteOperation }>;\n  scope_revision?: Record<string, unknown>;\n}\nexport interface ReleasePermissionInput {\n  workItemDir: string;\n  workItemId: string;\n  allowedWriteFiles: Array<{ path: string; operation: WriteOperation }>;\n  revisionReason?: string;\n}\nexport interface PreparedPermissionRelease {\n  input: ReleasePermissionInput;\n  requestedAllowed: Array<{ path: string; operation: WriteOperation }>;\n  incomingAllowed: Array<{ path: string; operation: WriteOperation }>;\n  existingAllowed: Array<{ path: string; operation: WriteOperation }>;\n  mergedAllowed: Array<{ path: string; operation: WriteOperation }>;\n  releaseMode: 'release' | 'extend';\n  revisionReason: string;\n  frozen: Awaited<ReturnType<typeof freezeGovernanceScopeForCodePermission>>;\n}\nexport interface ApplyRevokedPermissionFactsOptions {\n  now?: string;\n  recordRevocationEvent?: boolean;\n}\nexport const DEFAULT_PERMISSION: PermissionState = { code_change_allowed: false, allowed_write_files: [] };\nfunction projectRootFromWorkItemDir(workItemDir: string): string { return path.resolve(workItemDir, '..', '..', '..'); }\nfunction normalizeSlash(value: string): string { return String(value ?? '').replace(/\\\\/g, '/').replace(/\\/+/g, '/'); }\nfunction canonicalPath(projectRoot: string, value: string): { relative: string; absolute: string } {\n  const raw = String(value ?? '').trim();\n  const abs = path.isAbsolute(raw) ? path.resolve(raw) : path.resolve(projectRoot, raw);\n  let rel = path.relative(projectRoot, abs);\n  if (!rel || rel === '') rel = path.basename(abs);\n  return { relative: normalizeSlash(rel), absolute: normalizeSlash(abs) };\n}\nfunction normalizeOperation(value: unknown): WriteOperation {\n  return value === 'create' || value === 'modify' || value === 'delete' ? value : 'modify';\n}\nfunction normalizePermissionEntries(entries: unknown): Array<{ path: string; operation: WriteOperation }> {\n  if (!Array.isArray(entries)) return [];\n  const result: Array<{ path: string; operation: WriteOperation }> = [];\n  for (const entry of entries) {\n    if (typeof entry === 'string') {\n      const p = entry.trim();\n      if (p) result.push({ path: normalizeSlash(p), operation: 'modify' });\n      continue;\n    }\n    const p = String((entry as any)?.path ?? '').trim();\n    if (p) result.push({ path: normalizeSlash(p), operation: normalizeOperation((entry as any)?.operation) });\n  }\n  return result;\n}\nfunction dedupePermissionEntries(entries: Array<{ path: string; operation: WriteOperation }>): Array<{ path: string; operation: WriteOperation }> {\n  const seen = new Set<string>();\n  const result: Array<{ path: string; operation: WriteOperation }> = [];\n  for (const entry of entries) {\n    const p = normalizeSlash(String(entry.path ?? '').trim());\n    if (!p) continue;\n    const operation = normalizeOperation(entry.operation);\n    const key = `${p.toLowerCase()}\\0${operation}`;\n    if (!seen.has(key)) { seen.add(key); result.push({ path: p, operation }); }\n  }\n  return result;\n}\nexport function expandAllowedWriteFiles(workItemDir: string, entries: Array<{ path: string; operation: WriteOperation }>): Array<{ path: string; operation: WriteOperation }> {\n  const projectRoot = projectRootFromWorkItemDir(workItemDir);\n  const seen = new Set<string>();\n  const result: Array<{ path: string; operation: WriteOperation }> = [];\n  for (const entry of entries) {\n    if (!entry || typeof entry.path !== 'string' || entry.path.trim() === '') continue;\n    const op = normalizeOperation(entry.operation);\n    const { relative, absolute } = canonicalPath(projectRoot, entry.path);\n    const operations: WriteOperation[] = op === 'delete' ? ['delete'] : ['create', 'modify'];\n    for (const p of [relative, absolute]) {\n      for (const operation of operations) {\n        const key = `${p}\\0${operation}`;\n        if (!seen.has(key)) { seen.add(key); result.push({ path: p, operation }); }\n      }\n    }\n  }\n  return result;\n}\nexport function applyRevokedPermissionFacts(\n  workItem: Record<string, any>,\n  fallbackAllowedWriteFilesSnapshot: Array<{ path: string; operation: string }> = [],\n  options: ApplyRevokedPermissionFactsOptions = {},\n): Record<string, any> {\n  const now = options.now ?? new Date().toISOString();\n  const existingSnapshot = Array.isArray(workItem.allowed_write_files_snapshot)\n    ? workItem.allowed_write_files_snapshot\n    : [];\n  const currentAllowed = Array.isArray(workItem.allowed_write_files)\n    ? workItem.allowed_write_files\n    : [];\n  if (existingSnapshot.length === 0) {\n    workItem.allowed_write_files_snapshot = currentAllowed.length > 0\n      ? currentAllowed\n      : fallbackAllowedWriteFilesSnapshot.map(entry => ({\n          path: entry.path,\n          operation: normalizeOperation(entry.operation),\n        }));\n  }\n  workItem.code_change_allowed = false;\n  workItem.allowed_write_files = [];\n  workItem.code_permission_revoked = true;\n  if (options.recordRevocationEvent !== false || !workItem.code_permission_revoked_at) {\n    workItem.code_permission_revoked_at = now;\n  }\n  workItem.updated_at = now;\n  return workItem;\n}\nexport async function prepareCodePermissionRelease(\n  input: ReleasePermissionInput,\n): Promise<PreparedPermissionRelease> {\n  const projectRoot = projectRootFromWorkItemDir(input.workItemDir);\n  const requestedAllowed = normalizePermissionEntries(input.allowedWriteFiles);\n  const incomingAllowed = expandAllowedWriteFiles(input.workItemDir, input.allowedWriteFiles);\n  const initial = await readWorkItemMetadata(input.workItemDir, input.workItemId);\n  const existingAllowed = initial.code_change_allowed === true && initial.code_permission_revoked !== true\n    ? normalizePermissionEntries(initial.allowed_write_files) : [];\n  const releaseMode = existingAllowed.length > 0 ? 'extend' : 'release';\n  const revisionReason = String(input.revisionReason ?? '').trim();\n  if (releaseMode === 'extend' && revisionReason.length < 8) {\n    throw new Error('SCOPE_REVISION_REASON_REQUIRED');\n  }\n  const mergedAllowed = dedupePermissionEntries([...existingAllowed, ...incomingAllowed]);\n  const frozen = await freezeGovernanceScopeForCodePermission({\n    projectRoot,\n    workItemDir: input.workItemDir,\n    workItemId: input.workItemId,\n    allowedWriteFiles: mergedAllowed,\n  });\n  if (!frozen.passed) {\n    throw new Error(`${frozen.error ?? 'SCOPE_EXPANSION_REQUIRED'}: ${frozen.checks.filter(check => !check.passed).map(check => check.description).join('; ')}`);\n  }\n  return {\n    input,\n    requestedAllowed,\n    incomingAllowed,\n    existingAllowed,\n    mergedAllowed,\n    releaseMode,\n    revisionReason,\n    frozen,\n  };\n}\n\nexport async function commitPreparedCodePermissionRelease(\n  prepared: PreparedPermissionRelease,\n): Promise<PermissionState> {\n  const {\n    input,\n    requestedAllowed,\n    incomingAllowed,\n    existingAllowed,\n    mergedAllowed,\n    releaseMode,\n    revisionReason,\n    frozen,\n  } = prepared;\n  try {\n    await persistGovernanceScope(input.workItemDir, frozen.snapshot);\n    const wi = await readWorkItemMetadata(input.workItemDir, input.workItemId);\n    const now = new Date().toISOString();\n    wi.code_change_allowed = true;\n    wi.code_permission_revoked = false;\n    wi.allowed_write_files = mergedAllowed;\n    wi.allowed_write_files_snapshot = mergedAllowed;\n    wi.code_permission_last_release_mode = releaseMode;\n    wi.code_permission_release_count = Number(wi.code_permission_release_count ?? 0) + 1;\n    const history: Array<Record<string, unknown>> = Array.isArray(wi.allowed_write_files_history)\n      ? wi.allowed_write_files_history.filter(\n        (entry): entry is Record<string, unknown> =>\n          typeof entry === 'object' && entry !== null && !Array.isArray(entry),\n      )\n      : [];\n    history.push({\n      timestamp: now, mode: releaseMode, incoming_count: incomingAllowed.length,\n      previous_count: existingAllowed.length, total_count: mergedAllowed.length,\n      incoming_allowed_write_files: incomingAllowed,\n      requested_allowed_write_files: requestedAllowed,\n      effective_allowed_write_files: mergedAllowed,\n      ...(releaseMode === 'extend' ? { revision_reason: revisionReason } : {}),\n    });\n    wi.allowed_write_files_history = history.length > 20 ? history.slice(-20) : history;\n    let scopeRevision: Record<string, unknown> | undefined;\n    if (releaseMode === 'extend') {\n      const revisions: Array<Record<string, unknown>> = Array.isArray(wi.scope_revision_history)\n        ? wi.scope_revision_history.filter(\n            (entry): entry is Record<string, unknown> =>\n              typeof entry === 'object' && entry !== null && !Array.isArray(entry),\n          )\n        : [];\n      scopeRevision = {\n        schema_version: 'planned-scope-revision/v1',\n        revision_id: `SR-${input.workItemId}-${String(revisions.length + 1).padStart(4, '0')}`,\n        revised_at: now,\n        reason: revisionReason,\n        producer: 'sf_code_permission',\n        previous_allowed_write_files: existingAllowed,\n        added_allowed_write_files: requestedAllowed,\n        effective_allowed_write_files: mergedAllowed,\n        governance_scope: 'governance_scope.json',\n      };\n      revisions.push(scopeRevision);\n      wi.scope_revision_history = revisions;\n    }\n    wi.updated_at = now;\n    await writeWorkItemMetadata(input.workItemDir, input.workItemId, wi);\n    return {\n      code_change_allowed: true,\n      allowed_write_files: mergedAllowed,\n      ...(scopeRevision ? { scope_revision: scopeRevision } : {}),\n    };\n  } catch (err: any) {\n    throw new Error(`Failed to release code permission: ${err.message}`);\n  }\n}\n\nexport async function releaseCodePermission(input: ReleasePermissionInput): Promise<PermissionState> {\n  try {\n    return await commitPreparedCodePermissionRelease(await prepareCodePermissionRelease(input));\n  } catch (err: any) {\n    if (String(err?.message ?? '').startsWith('Failed to release code permission:')) throw err;\n    throw new Error(`Failed to release code permission: ${err.message}`);\n  }\n}\nexport async function revokeCodePermission(workItemDir: string): Promise<void> {\n  const workItemId = path.basename(workItemDir);\n  try {\n    const wi = await readWorkItemMetadata(workItemDir, workItemId);\n    applyRevokedPermissionFacts(wi, [], { recordRevocationEvent: true });\n    await writeWorkItemMetadata(workItemDir, workItemId, wi);\n  } catch (err: any) {\n    throw new Error(`Failed to revoke code permission: ${err.message}`);\n  }\n}\nexport async function checkCodePermission(workItemDir: string): Promise<PermissionState> {\n  try {\n    const wi = await readWorkItemMetadata(workItemDir, path.basename(workItemDir));\n    return {\n      code_change_allowed: wi.code_change_allowed === true,\n      allowed_write_files: normalizePermissionEntries(wi.allowed_write_files),\n    };\n  } catch (error) {\n    if (error instanceof Error && error.message.startsWith('WORK_ITEM_NOT_FOUND:')) {\n      return DEFAULT_PERMISSION;\n    }\n    throw error;\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\contract-authoring.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·'add'·|·'update'·|·'promote'·|·'repair_relocate_to_module'` with `⏎··|·'add'⏎··|·'update'⏎··|·'promote'⏎··|·'repair_relocate_to_module'⏎·`","line":39,"column":38,"nodeType":null,"messageId":"replace","endLine":39,"endColumn":97,"fix":{"range":[1985,2044],"text":"\n  | 'add'\n  | 'update'\n  | 'promote'\n  | 'repair_relocate_to_module'\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·workflow_type:·'feature_spec';·workflow_path:·string;·` with `⏎··workflow_type:·'feature_spec';⏎··workflow_path:·string;⏎`","line":40,"column":42,"nodeType":null,"messageId":"replace","endLine":40,"endColumn":97,"fix":{"range":[2097,2152],"text":"\n  workflow_type: 'feature_spec';\n  workflow_path: string;\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(`${SPEC_DIR_NAME}/project/extension_registry.json`·as·const)` with ``${SPEC_DIR_NAME}/project/extension_registry.json`·as·const`","line":66,"column":20,"nodeType":null,"messageId":"replace","endLine":66,"endColumn":81,"fix":{"range":[2811,2872],"text":"`${SPEC_DIR_NAME}/project/extension_registry.json` as const"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `action·!==·'add'·&&·action·!==·'update'·&&·action·!==·'promote'·&&·action·!==·'repair_relocate_to_module'·&&·action·!==·'reset'` with `⏎····action·!==·'add'·&&⏎····action·!==·'update'·&&⏎····action·!==·'promote'·&&⏎····action·!==·'repair_relocate_to_module'·&&⏎····action·!==·'reset'⏎··`","line":113,"column":7,"nodeType":null,"messageId":"replace","endLine":113,"endColumn":134,"fix":{"range":[4041,4168],"text":"\n    action !== 'add' &&\n    action !== 'update' &&\n    action !== 'promote' &&\n    action !== 'repair_relocate_to_module' &&\n    action !== 'reset'\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·success:·false,·error:·'kind·is·required·when·action=add,·action=update,·action=promote,·or·action=repair_relocate_to_module'` with `⏎······success:·false,⏎······error:⏎········'kind·is·required·when·action=add,·action=update,·action=promote,·or·action=repair_relocate_to_module',⏎···`","line":155,"column":13,"nodeType":null,"messageId":"replace","endLine":155,"endColumn":139,"fix":{"range":[5498,5624],"text":"\n      success: false,\n      error:\n        'kind is required when action=add, action=updat