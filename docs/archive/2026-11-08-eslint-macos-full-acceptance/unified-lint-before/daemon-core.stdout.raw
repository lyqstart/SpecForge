:64,"column":21,"nodeType":null,"messageId":"replace","endLine":64,"endColumn":269,"fix":{"range":[4734,4982],"text":" Record<string, string> = {};\n  for (const name of paths) {\n    const source = byPath.get(name)!;\n    if (\n      source.sha256 !== sha(source.content) ||\n      Buffer.byteLength(source.content) > 32768 ||\n      source.content.includes('\\0')\n    )\n      fail('SOURCE_IDENTITY');\n    inputHashes[name] = source.sha256;\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `·`","line":65,"column":20,"nodeType":null,"messageId":"insert","endLine":65,"endColumn":20,"fix":{"range":[5003,5003],"text":" "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(declaration.kind==='files')` with `·(declaration.kind·===·'files')·`","line":66,"column":5,"nodeType":null,"messageId":"replace","endLine":66,"endColumn":33,"fix":{"range":[5015,5043],"text":" (declaration.kind === 'files') "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=` with `·=·`","line":68,"column":17,"nodeType":null,"messageId":"replace","endLine":68,"endColumn":18,"fix":{"range":[5156,5157],"text":" = "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `else` with `·else·`","line":69,"column":4,"nodeType":null,"messageId":"replace","endLine":69,"endColumn":8,"fix":{"range":[5180,5184],"text":" else "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=byPath.get(declaration.paths[0])!,pattern=finiteRegex(declaration.pattern,` with `·=·byPath.get(declaration.paths[0])!,⏎······pattern·=·finiteRegex(declaration.pattern,·`","line":70,"column":17,"nodeType":null,"messageId":"replace","endLine":70,"endColumn":92,"fix":{"range":[5202,5277],"text":" = byPath.get(declaration.paths[0])!,\n      pattern = finiteRegex(declaration.pattern, "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=Buffer.from(source.content,` with `·=·Buffer.from(source.content,·`","line":71,"column":16,"nodeType":null,"messageId":"replace","endLine":71,"endColumn":44,"fix":{"range":[5315,5343],"text":" = Buffer.from(source.content, "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(countLines(bytes,pattern,false)!==countLines(source.content,pattern,true))` with `·(countLines(bytes,·pattern,·false)·!==·countLines(source.content,·pattern,·true))⏎······`","line":73,"column":7,"nodeType":null,"messageId":"replace","endLine":73,"endColumn":82,"fix":{"range":[5490,5565],"text":" (countLines(bytes, pattern, false) !== countLines(source.content, pattern, true))\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=`const·text=${JSON.stringify(bytes)};const·lines=text===\"\"?[]:text.split(\"\\\\n\");if(lines.length&&lines[lines.length-1]===\"\")lines.pop();const·regex=RegExp(${JSON.stringify(pattern)});let·count=0;for(const·line·of·lines){if(regex.test(line))count++;}`` with `·=⏎······`const·text=${JSON.stringify(bytes)};const·lines=text===\"\"?[]:text.split(\"\\\\n\");if(lines.length&&lines[lines.length-1]===\"\")lines.pop();const·regex=RegExp(${JSON.stringify(pattern)});let·count=0;for(const·line·of·lines){if(regex.test(line))count++;}`·`","line":74,"column":17,"nodeType":null,"messageId":"replace","endLine":74,"endColumn":268,"fix":{"range":[5607,5858],"text":" =\n      `const text=${JSON.stringify(bytes)};const lines=text===\"\"?[]:text.split(\"\\\\n\");if(lines.length&&lines[lines.length-1]===\"\")lines.pop();const regex=RegExp(${JSON.stringify(pattern)});let count=0;for(const line of lines){if(regex.test(line))count++;}` "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `?'':'console.log(String(count));')+`process.exit(${declaration.negate?'count===0?0:1':` with `·?·''·:·'console.log(String(count));')·+⏎······`process.exit(${declaration.negate·?·'count===0?0:1'·:·`","line":75,"column":25,"nodeType":null,"messageId":"replace","endLine":75,"endColumn":111,"fix":{"range":[5884,5970],"text":" ? '' : 'console.log(String(count));') +\n      `process.exit(${declaration.negate ? 'count===0?0:1' : "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(inlineSource.length>32768||Buffer.byteLength(inlineSource)>32768)` with `·(inlineSource.length·>·32768·||·Buffer.byteLength(inlineSource)·>·32768)·`","line":77,"column":5,"nodeType":null,"messageId":"replace","endLine":77,"endColumn":71,"fix":{"range":[5997,6063],"text":" (inlineSource.length > 32768 || Buffer.byteLength(inlineSource) > 32768) "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `contract:'readonly-node-command/v1',original,kind:'node-inline',argv:[...flags,'-e',inlineSource],entry:null,inlineSource,semanticProof:{rule:STATIC_TASK_RULE,inputHashes}` with `⏎····contract:·'readonly-node-command/v1',⏎····original,⏎····kind:·'node-inline',⏎····argv:·[...flags,·'-e',·inlineSource],⏎····entry:·null,⏎····inlineSource,⏎····semanticProof:·{·rule:·STATIC_TASK_RULE,·inputHashes·},⏎··`","line":78,"column":11,"nodeType":null,"messageId":"replace","endLine":78,"endColumn":182,"fix":{"range":[6096,6267],"text":"\n    contract: 'readonly-node-command/v1',\n    original,\n    kind: 'node-inline',\n    argv: [...flags, '-e', inlineSource],\n    entry: null,\n    inlineSource,\n    semanticProof: { rule: STATIC_TASK_RULE, inputHashes },\n  "}}],"suppressedMessages":[],"errorCount":65,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":64,"fixableWarningCount":0,"source":"import { SPEC_DIR_NAME } from \"@specforge/types/directory-layout\";\n/** Finite readonly predicates, normalized to the existing isolated Node inline backend. */\nimport path from 'node:path';\nimport { createHash } from 'node:crypto';\nimport { assertVerificationRelativePath } from './source-snapshot';\nimport { readVerificationFile } from './owner-store';\nimport type { FrozenNodeSource, NodeCommandPlan } from './node-command-contract';\n\nexport const STATIC_TASK_RULE = 'finite-posix-readonly-predicate/v1' as const;\ntype Declaration = {kind:'files';paths:string[]} | {kind:'grep';paths:[string];pattern:string;quiet:boolean;negate:boolean;extended:boolean};\nfunction fail(code:string):never {throw Error('NODE_COMMAND_UNSUPPORTED:STATIC_'+code);}\nconst sha=(text:string)=>createHash('sha256').update(text).digest('hex');\nconst flags=['--no-addons','--preserve-symlinks','--preserve-symlinks-main'];\nexport const isStaticTaskDeclaration=(value:string)=>/^(?:test|grep|!)\\s/.test(value);\nfunction relative(value:string):string {\n  assertVerificationRelativePath(value);\n  if(!/^[A-Za-z0-9_.\\-/]+$/.test(value)||value.split('/').some(p=>['.git',SPEC_DIR_NAME,'node_modules'].includes(p.toLowerCase()))||!/(?:\\.md|\\.json|\\.[cm]?js|\\.ts)$/.test(value))fail('PATH');\n  return value;\n}\nexport function parseStaticTaskDeclaration(command:string):Declaration {\n  if(!command||command.length>32768||/[\\x00-\\x1f\\x7f`]/.test(command))fail('DECLARATION');\n  if(command.startsWith('test ')){\n    const pieces=command.split(' && ');if(pieces.length>64)fail('FILE_COUNT');\n    const paths=pieces.map(piece=>{const m=/^test -f ([A-Za-z0-9_.\\-/]+)$/.exec(piece);if(!m)fail('FILE_GRAMMAR');return relative(m[1]!);});\n    return {kind:'files',paths};\n  }\n  const match=/^(! )?grep -(cE|qE|c|q) (['\"])(.*?)\\3 ([A-Za-z0-9_.\\-/]+)$/.exec(command);\n  if(!match||match[1]&&!match[2]!.startsWith('q'))fail('GREP_GRAMMAR');\n  const pattern=match[4]!;if(!pattern||pattern.length>1024||/[^\\x20-\\x7e]/.test(pattern)||pattern.includes(match[3]!))fail('PATTERN');\n  // Double quoted shell variables/substitution cannot be reproduced as fixed literals.\n  if(match[3]==='\"'&&(/\\$(?!$)|\\\\[^(){}|.*^$\\\\]/.test(pattern)||pattern.includes('\\\\\\\\')||pattern.includes('\\\\$')))fail('QUOTED_EXPANSION');\n  return {kind:'grep',paths:[relative(match[5]!)],pattern,quiet:match[2]!.startsWith('q'),negate:!!match[1],extended:match[2]!.endsWith('E')};\n}\nfunction finiteRegex(pattern:string,extended:boolean):string {\n  let output='',alternative=false;\n  const literal=(char:string)=>char.replace(/[.*+?^${}()|[\\]\\\\]/g,'\\\\$&');\n  for(let i=0;i<pattern.length;i++){\n    const c=pattern[i]!;\n    if(c==='\\\\'){\n      const next=pattern[++i];if(!next||!extended||!'(){}|.*^$\\\\[]'.includes(next))fail('ESCAPE');\n      output+=literal(next);alternative=true;\n    }else if(c==='|'&&extended){if(!alternative)fail('EMPTY_ALTERNATIVE');output+='|';alternative=false;}\n    else if(c==='^'){if(alternative)fail('ANCHOR');output+='^';}\n    else if(c==='$'){if(i!==pattern.length-1&&!(extended&&pattern[i+1]==='|'))fail('ANCHOR');output+='(?![\\\\s\\\\S])';}\n    else if(c==='*'){fail('REPETITION');}\n    else if(c==='.') {output+='[\\\\s\\\\S]';alternative=true;}\n    else {if('[]'.includes(c)||extended&&'()+?{}'.includes(c))fail('REGEX_SYNTAX');output+=literal(c);alternative=true;}\n  }\n  if(!alternative)fail('EMPTY_ALTERNATIVE');\n  return output;\n}\nfunction countLines(text:string,pattern:string,unicode:boolean):number {\n  if(text==='')return 0;const lines=text.split('\\n');if(lines[lines.length-1]==='')lines.pop();\n  const regex=new RegExp(pattern,unicode?'u':'');return lines.reduce((count,line)=>count+(regex.test(line)?1:0),0);\n}\nexport async function collectStaticTaskInputs(root:string,command:string,trackedPaths:readonly string[]):Promise<{sources:FrozenNodeSource[];inputPaths:string[]}> {\n  const declaration=parseStaticTaskDeclaration(command),inputPaths=[...new Set(declaration.paths)].sort(),tracked=new Set(trackedPaths),sources:FrozenNodeSource[]=[];\n  for(const name of inputPaths){if(!tracked.has(name))fail('INPUT_NOT_TRACKED');const raw=await readVerificationFile(path.join(root,name),32768),content=raw.toString('utf8');if(!Buffer.from(content).equals(raw)||raw.includes(0))fail('ENCODING');sources.push({path:name,content,sha256:sha(content)});}\n  return {sources,inputPaths};\n}\nexport function compileStaticTaskCommand(original:string,sources:readonly FrozenNodeSource[]):NodeCommandPlan {\n  const declaration=parseStaticTaskDeclaration(original),paths=[...new Set(declaration.paths)].sort(),byPath=new Map(sources.map(s=>[s.path,s]));\n  if(byPath.size!==sources.length||JSON.stringify([...byPath.keys()].sort())!==JSON.stringify(paths))fail('INPUT_SET');\n  const inputHashes:Record<string,string>={};for(const name of paths){const source=byPath.get(name)!;if(source.sha256!==sha(source.content)||Buffer.byteLength(source.content)>32768||source.content.includes('\\0'))fail('SOURCE_IDENTITY');inputHashes[name]=source.sha256;}\n  let inlineSource:string;\n  if(declaration.kind==='files'){\n    // The complete native input-copy precondition proves every selected ordinary file exists.\n    inlineSource='process.exit(0);';\n  }else{\n    const source=byPath.get(declaration.paths[0])!,pattern=finiteRegex(declaration.pattern,declaration.extended);\n    const bytes=Buffer.from(source.content,'utf8').toString('latin1');\n    // Byte-oriented C matching and Unicode scalar matching must give identical evidence on these actual inputs.\n    if(countLines(bytes,pattern,false)!==countLines(source.content,pattern,true))fail('LOCALE_AMBIGUITY');\n    inlineSource=`const text=${JSON.stringify(bytes)};const lines=text===\"\"?[]:text.split(\"\\\\n\");if(lines.length&&lines[lines.length-1]===\"\")lines.pop();const regex=RegExp(${JSON.stringify(pattern)});let count=0;for(const line of lines){if(regex.test(line))count++;}`+\n      (declaration.quiet?'':'console.log(String(count));')+`process.exit(${declaration.negate?'count===0?0:1':'count>0?0:1'});`;\n  }\n  if(inlineSource.length>32768||Buffer.byteLength(inlineSource)>32768)fail('INLINE_BUDGET');\n  return {contract:'readonly-node-command/v1',original,kind:'node-inline',argv:[...flags,'-e',inlineSource],entry:null,inlineSource,semanticProof:{rule:STATIC_TASK_RULE,inputHashes}};\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\verification\\verification-assets.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·PINNED_NODE_SHA256,·VERIFICATION_PROFILE,·type·VerificationAssets·` with `⏎··PINNED_NODE_SHA256,⏎··VERIFICATION_PROFILE,⏎··type·VerificationAssets,⏎`","line":4,"column":9,"nodeType":null,"messageId":"replace","endLine":4,"endColumn":76,"fix":{"range":[186,253],"text":"\n  PINNED_NODE_SHA256,\n  VERIFICATION_PROFILE,\n  type VerificationAssets,\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·file:·string;·sha256:·string;·` with `⏎··file:·string;⏎··sha256:·string;⏎`","line":6,"column":23,"nodeType":null,"messageId":"replace","endLine":6,"endColumn":54,"fix":{"range":[306,337],"text":"\n  file: string;\n  sha256: string;\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `binRoot·=·resolveSpecForgeUserPath('bin')` with `⏎··binRoot·=·resolveSpecForgeUserPath('bin')⏎`","line":15,"column":46,"nodeType":null,"messageId":"replace","endLine":15,"endColumn":87,"fix":{"range":[557,598],"text":"\n  binRoot = resolveSpecForgeUserPath('bin')\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":16,"column":62,"nodeType":null,"messageId":"insert","endLine":16,"endColumn":62,"fix":{"range":[692,692],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":17,"column":38,"nodeType":null,"messageId":"insert","endLine":17,"endColumn":38,"fix":{"range":[784,784],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `!manifest·||` with `⏎····!manifest·||⏎···`","line":20,"column":7,"nodeType":null,"messageId":"replace","endLine":20,"endColumn":19,"fix":{"range":[986,998],"text":"\n    !manifest ||\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `··manifest.contract·!==·'verification-assets/v1'·||·manifest.profile·!==·VERIFICATION_PROFILE)` with `manifest.contract·!==·'verification-assets/v1'·||⏎····manifest.profile·!==·VERIFICATION_PROFILE⏎··)⏎···`","line":21,"column":5,"nodeType":null,"messageId":"replace","endLine":21,"endColumn":99,"fix":{"range":[1089,1183],"text":"manifest.contract !== 'verification-assets/v1' ||\n    manifest.profile !== VERIFICATION_PROFILE\n  )\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `['node',·'node.exe',·base],·['launcher',·'specforge-verify.exe',·base],·['daemon',·'specforged.exe',·root]` with `⏎····['node',·'node.exe',·base],⏎····['launcher',·'specforge-verify.exe',·base],⏎····['daemon',·'specforged.exe',·root],⏎··`","line":22,"column":18,"nodeType":null,"messageId":"replace","endLine":22,"endColumn":124,"fix":{"range":[1257,1363],"text":"\n    ['node', 'node.exe', base],\n    ['launcher', 'specforge-verify.exe', base],\n    ['daemon', 'specforged.exe', root],\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `!entry·||·Object.keys(entry).sort().join(',')·!==·'file,sha256'·||` with `⏎······!entry·||⏎······Object.keys(entry).sort().join(',')·!==·'file,sha256'·||⏎·····`","line":26,"column":9,"nodeType":null,"messageId":"replace","endLine":26,"endColumn":75,"fix":{"range":[1509,1575],"text":"\n      !entry ||\n      Object.keys(entry).sort().join(',') !== 'file,sha256' ||\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `········!/^[a-f0-9]{64}$/.test(entry.sha256))` with `······!/^[a-f0-9]{64}$/.test(entry.sha256)⏎····)⏎·····`","line":27,"column":1,"nodeType":null,"messageId":"replace","endLine":27,"endColumn":46,"fix":{"range":[1599,1644],"text":"      !/^[a-f0-9]{64}$/.test(entry.sha256)\n    )\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `kind·===·'node'·&&·actual·!==·PINNED_NODE_SHA256)` with `(kind·===·'node'·&&·actual·!==·PINNED_NODE_SHA256))⏎·····`","line":30,"column":36,"nodeType":null,"messageId":"replace","endLine":30,"endColumn":85,"fix":{"range":[1874,1923],"text":"(kind === 'node' && actual !== PINNED_NODE_SHA256))\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·contract:·manifest.contract,·profile:·manifest.profile,` with `⏎····contract:·manifest.contract,⏎····profile:·manifest.profile,⏎···`","line":33,"column":11,"nodeType":null,"messageId":"replace","endLine":33,"endColumn":67,"fix":{"range":[2030,2086],"text":"\n    contract: manifest.contract,\n    profile: manifest.profile,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·nodeSha256:·PINNED_NODE_SHA256,` with `⏎····nodeSha256:·PINNED_NODE_SHA256,⏎···`","line":34,"column":34,"nodeType":null,"messageId":"replace","endLine":34,"endColumn":66,"fix":{"range":[2159,2191],"text":"\n    nodeSha256: PINNED_NODE_SHA256,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·daemonPath:·paths.get('daemon')!,·daemonSha256:·manifest.daemon.sha256` with `⏎····daemonPath:·paths.get('daemon')!,⏎····daemonSha256:·manifest.daemon.sha256,⏎·`","line":35,"column":46,"nodeType":null,"messageId":"replace","endLine":35,"endColumn":117,"fix":{"range":[2275,2346],"text":"\n    daemonPath: paths.get('daemon')!,\n    daemonSha256: manifest.daemon.sha256,\n "}}],"suppressedMessages":[],"errorCount":14,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":14,"fixableWarningCount":0,"source":"import path from 'node:path';\nimport { resolveSpecForgeUserPath } from '@specforge/types/user-level-paths';\nimport { readVerificationFile, verificationId } from './owner-store';\nimport { PINNED_NODE_SHA256, VERIFICATION_PROFILE, type VerificationAssets } from './verification-plan';\n\ninterface AssetEntry { file: string; sha256: string; }\ninterface AssetManifest {\n  contract: 'verification-assets/v1';\n  profile: typeof VERIFICATION_PROFILE;\n  node: AssetEntry;\n  launcher: AssetEntry;\n  daemon: AssetEntry;\n}\n\nexport async function loadVerificationAssets(binRoot = resolveSpecForgeUserPath('bin')): Promise<VerificationAssets> {\n  if (process.platform !== 'win32' || process.arch !== 'x64') throw new Error('VERIFICATION_PLATFORM_UNSUPPORTED');\n  const root = path.resolve(binRoot), base = path.join(root, 'verification');\n  const bytes = await readVerificationFile(path.join(base, 'assets.json'), 65536);\n  const manifest = JSON.parse(bytes.toString('utf8')) as AssetManifest;\n  if (!manifest || Object.keys(manifest).sort().join(',') !== 'contract,daemon,launcher,node,profile' ||\n      manifest.contract !== 'verification-assets/v1' || manifest.profile !== VERIFICATION_PROFILE) throw new Error('VERIFICATION_ASSET_MANIFEST_INVALID');\n  const fixed = [['node', 'node.exe', base], ['launcher', 'specforge-verify.exe', base], ['daemon', 'specforged.exe', root]] as const;\n  const paths = new Map<string, string>();\n  for (const [kind, file, directory] of fixed) {\n    const entry = manifest[kind];\n    if (!entry || Object.keys(entry).sort().join(',') !== 'file,sha256' || entry.file !== file ||\n        !/^[a-f0-9]{64}$/.test(entry.sha256)) throw new Error('VERIFICATION_ASSET_ENTRY_INVALID:' + kind);\n    const full = path.join(directory, file);\n    const actual = verificationId(await readVerificationFile(full, 256 * 1024 * 1024));\n    if (actual !== entry.sha256 || kind === 'node' && actual !== PINNED_NODE_SHA256) throw new Error('VERIFICATION_ASSET_IDENTITY_MISMATCH:' + kind);\n    paths.set(kind, full);\n  }\n  return { contract: manifest.contract, profile: manifest.profile, manifestSha256: verificationId(bytes),\n    nodePath: paths.get('node')!, nodeSha256: PINNED_NODE_SHA256, launcherPath: paths.get('launcher')!,\n    launcherSha256: manifest.launcher.sha256, daemonPath: paths.get('daemon')!, daemonSha256: manifest.daemon.sha256 };\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\verification\\verification-plan.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·`","line":9,"column":34,"nodeType":null,"messageId":"insert","endLine":9,"endColumn":34,"fix":{"range":[597,597],"text":"\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·processes:·1,` with `⏎··processes:·1,⏎·`","line":10,"column":51,"nodeType":null,"messageId":"replace","endLine":10,"endColumn":65,"fix":{"range":[716,730],"text":"\n  processes: 1,\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·stderrBytes:·1048576,·wallMs:·120000·` with `⏎··stderrBytes:·1048576,⏎··wallMs:·120000,⏎`","line":11,"column":24,"nodeType":null,"messageId":"replace","endLine":11,"endColumn":62,"fix":{"range":[779,817],"text":"\n  stderrBytes: 1048576,\n  wallMs: 120000,\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·'implementation_running'·|·'implementation_done'·|·'verification_running'·|·'verification_done'` with `⏎····|·'implementation_running'⏎····|·'implementation_done'⏎····|·'verification_running'⏎····|·'verification_done'⏎···`","line":14,"column":9,"nodeType":null,"messageId":"replace","endLine":14,"endColumn":105,"fix":{"range":[879,975],"text":"\n    | 'implementation_running'\n    | 'implementation_done'\n    | 'verification_running'\n    | 'verification_done'\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·kind:·'independent-readonly-verification/v1';·grantee:·'sf-verifier';·codeWriteGranted:·false` with `⏎····kind:·'independent-readonly-verification/v1';⏎····grantee:·'sf-verifier';⏎····codeWriteGranted:·false;⏎·`","line":54,"column":16,"nodeType":null,"messageId":"replace","endLine":54,"endColumn":110,"fix":{"range":[2020,2114],"text":"\n    kind: 'independent-readonly-verification/v1';\n    grantee: 'sf-verifier';\n    codeWriteGranted: false;\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `·`","line":92,"column":12,"nodeType":null,"messageId":"insert","endLine":92,"endColumn":12,"fix":{"range":[3200,3200],"text":" "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `·`","line":93,"column":10,"nodeType":null,"messageId":"insert","endLine":93,"endColumn":10,"fix":{"range":[3245,3245],"text":" "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `·`","line":94,"column":13,"nodeType":null,"messageId":"insert","endLine":94,"endColumn":13,"fix":{"range":[3265,3265],"text":" "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `·`","line":95,"column":17,"nodeType":null,"messageId":"insert","endLine":95,"endColumn":17,"fix":{"range":[3289,3289],"text":" "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `·`","line":96,"column":9,"nodeType":null,"messageId":"insert","endLine":96,"endColumn":9,"fix":{"range":[3305,3305],"text":" "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `·`","line":97,"column":13,"nodeType":null,"messageId":"insert","endLine":97,"endColumn":13,"fix":{"range":[3345,3345],"text":" "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `·`","line":98,"column":14,"nodeType":null,"messageId":"insert","endLine":98,"endColumn":14,"fix":{"range":[3366,3366],"text":" "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'completed'|'cancelled'|` with `·'completed'·|·'cancelled'·|·`","line":99,"column":12,"nodeType":null,"messageId":"replace","endLine":99,"endColumn":36,"fix":{"range":[3385,3409],"text":" 'completed' | 'cancelled' | "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `Array<{observedAt:string;active:boolean;projectionSha256:string|null;reason:string|null` with `·Array<{⏎····observedAt:·string;⏎····active:·boolean;⏎····projectionSha256:·string·|·null;⏎····reason:·string·|·null;⏎··`","line":100,"column":10,"nodeType":null,"messageId":"replace","endLine":100,"endColumn":97,"fix":{"range":[3426,3513],"text":" Array<{\n    observedAt: string;\n    active: boolean;\n    projectionSha256: string | null;\n    reason: string | null;\n  "}}],"suppressedMessages":[],"errorCount":14,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":14,"fixableWarningCount":0,"source":"/** Pure versioned objects shared by producer and all execution-evidence consumers. */\nimport type { TrustedToolInvocationProof } from '@specforge/types/trusted-tool-invocation';\nimport type { NodeCommandPlan } from './node-command-contract';\nimport type { VerificationSourceSnapshot } from './source-snapshot';\n\nexport const VERIFICATION_PLAN_CONTRACT = 'verification-plan/v1' as const;\nexport const VERIFICATION_RECEIPT_CONTRACT = 'verification-execution/v1' as const;\nexport const VERIFICATION_PROFILE = 'windows-lpac-node-single-process-readonly/v1' as const;\nexport const PINNED_NODE_SHA256 = '3602f2bb1a10f2cbab4c36886218a33c1ab3db87290e73b033c46c77147d0237';\nexport const VERIFICATION_BUDGET = Object.freeze({ processes: 1, memoryBytes: 1073741824,\n  stdoutBytes: 1048576, stderrBytes: 1048576, wallMs: 120000 });\n\nexport interface VerificationAuthoritySnapshot {\n  state: 'implementation_running' | 'implementation_done' | 'verification_running' | 'verification_done' | 'closed';\n  purpose: 'implementation' | 'formal';\n  workItemId: string;\n  psv: string;\n  files: Record<string, string>;\n  taskPath: string;\n  taskId: string;\n  verificationType: string;\n  commandIndex: number;\n  command: string;\n  metadataRawSha256: string;\n  metadataBasisSha256: string;\n  basisIdentity: string;\n  identity: string;\n}\n\nexport interface VerificationAssets {\n  contract: 'verification-assets/v1';\n  profile: typeof VERIFICATION_PROFILE;\n  nodePath: string;\n  nodeSha256: typeof PINNED_NODE_SHA256;\n  launcherPath: string;\n  launcherSha256: string;\n  daemonPath: string;\n  daemonSha256: string;\n  manifestSha256: string;\n}\n\nexport interface VerificationPlan {\n  contract: typeof VERIFICATION_PLAN_CONTRACT;\n  createdAt: string;\n  expiresAt: string;\n  projectRoot: string;\n  workItemId: string;\n  authority: VerificationAuthoritySnapshot;\n  source: VerificationSourceSnapshot;\n  command: NodeCommandPlan;\n  assets: VerificationAssets;\n  profile: typeof VERIFICATION_PROFILE;\n  budget: typeof VERIFICATION_BUDGET;\n  permission: { kind: 'independent-readonly-verification/v1'; grantee: 'sf-verifier'; codeWriteGranted: false };\n  owner: TrustedToolInvocationProof;\n}\n\nexport interface VerificationExecutionReceipt {\n  contract: typeof VERIFICATION_RECEIPT_CONTRACT;\n  planId: string;\n  attemptId: string;\n  projectRoot: string;\n  workItemId: string;\n  purpose: VerificationAuthoritySnapshot['purpose'];\n  startedAt: string;\n  finishedAt: string;\n  owner: TrustedToolInvocationProof;\n  sourceIdentity: string;\n  authorityIdentity: string;\n  assets: VerificationAssets;\n  profile: typeof VERIFICATION_PROFILE;\n  budget: typeof VERIFICATION_BUDGET;\n  processStarted: boolean;\n  processResumed: boolean;\n  exitCode: number | null;\n  launcherExitCode: number | null;\n  jobEnded: boolean;\n  cleanupProved: boolean;\n  outputComplete: boolean;\n  stdoutSha256: string;\n  stderrSha256: string;\n  nativeReceiptSha256: string | null;\n  nativeEventsSha256: string | null;\n  inspectionSha256: string | null;\n  reservationId: string;\n  leaseId: string;\n  outcome: 'passed' | 'failed' | 'not_executed' | 'cancelled' | 'interrupted';\n  failure: string | null;\n}\n\nexport interface VerificationInvocationLeaseRecord {\n  contract:'verification-invocation-lease/v1';\n  planId:string;\n  attemptId:string;\n  reservationId:string;\n  owner:TrustedToolInvocationProof;\n  startedAt:string;\n  finishedAt:string;\n  terminal:'completed'|'cancelled'|'lost';\n  checks:Array<{observedAt:string;active:boolean;projectionSha256:string|null;reason:string|null}>;\n}\n\nexport interface VerificationAttempt {\n  contract: 'verification-attempt/v1';\n  planId: string;\n  attemptId: string;\n  createdAt: string;\n  projectRoot: string;\n  workItemId: string;\n  owner: TrustedToolInvocationProof;\n  nativeConfigSha256: string;\n  initialAttemptAbsent: true;\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\verification\\verification-schema.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"@specforge/types/directory-layout\"` with `'@specforge/types/directory-layout'`","line":1,"column":31,"nodeType":null,"messageId":"replace","endLine":1,"endColumn":66,"fix":{"range":[30,65],"text":"'@specforge/types/directory-layout'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·VERIFICATION_BUDGET,·VERIFICATION_PROFILE,` with `⏎··VERIFICATION_BUDGET,⏎··VERIFICATION_PROFILE,⏎·`","line":7,"column":9,"nodeType":null,"messageId":"replace","endLine":7,"endColumn":52,"fix":{"range":[448,491],"text":"\n  VERIFICATION_BUDGET,\n  VERIFICATION_PROFILE,\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·type·VerificationAttempt,·type·VerificationExecutionReceipt,·type·VerificationInvocationLeaseRecord·` with `⏎··type·VerificationAttempt,⏎··type·VerificationExecutionReceipt,⏎··type·VerificationInvocationLeaseRecord,⏎`","line":8,"column":25,"nodeType":null,"messageId":"replace","endLine":8,"endColumn":126,"fix":{"range":[536,637],"text":"\n  type VerificationAttempt,\n  type VerificationExecutionReceipt,\n  type VerificationInvocationLeaseRecord,\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `value·!==·null·&&·typeof·value·===·'object'·&&·!Array.isArray(value)·&&·Object.getPrototypeOf(value)·===·Object.prototype,·'OBJECT_INVALID'` with `⏎····value·!==·null·&&⏎······typeof·value·===·'object'·&&⏎······!Array.isArray(value)·&&⏎······Object.getPrototypeOf(value)·===·Object.prototype,⏎····'OBJECT_INVALID'⏎··`","line":14,"column":23,"nodeType":null,"messageId":"replace","endLine":14,"endColumn":162,"fix":{"range":[925,1064],"text":"\n    value !== null &&\n      typeof value === 'object' &&\n      !Array.isArray(value) &&\n      Object.getPrototypeOf(value) === Object.prototype,\n    'OBJECT_INVALID'\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·verificationRequire(Object.keys(record).sort().join(',')·===·[...keys].sort().join(','),·'SCHEMA_FIELDS_INVALID'` with `⏎····verificationRequire(⏎······Object.keys(record).sort().join(',')·===·[...keys].sort().join(','),⏎······'SCHEMA_FIELDS_INVALID'⏎····`","line":16,"column":12,"nodeType":null,"messageId":"replace","endLine":16,"endColumn":125,"fix":{"range":[1129,1242],"text":"\n    verificationRequire(\n      Object.keys(record).sort().join(',') === [...keys].sort().join(','),\n      'SCHEMA_FIELDS_INVALID'\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·verificationRequire(typeof·value·===·'string'·&&·/^[a-f0-9]{64}$/.test(value),·'HASH_INVALID');·` with `⏎··verificationRequire(typeof·value·===·'string'·&&·/^[a-f0-9]{64}$/.test(value),·'HASH_INVALID');⏎`","line":19,"column":76,"nodeType":null,"messageId":"replace","endLine":19,"endColumn":173,"fix":{"range":[1339,1436],"text":"\n  verificationRequire(typeof value === 'string' && /^[a-f0-9]{64}$/.test(value), 'HASH_INVALID');\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `typeof·value·===·'string'·&&·Number.isFinite(Date.parse(value))·&&·new·Date(value).toISOString()·===·value,·'UTC_INVALID'` with `⏎····typeof·value·===·'string'·&&⏎······Number.isFinite(Date.parse(value))·&&⏎······new·Date(value).toISOString()·===·value,⏎····'UTC_INVALID'⏎··`","line":21,"column":23,"nodeType":null,"messageId":"replace","endLine":21,"endColumn":144,"fix":{"range":[1539,1660],"text":"\n    typeof value === 'string' &&\n      Number.isFinite(Date.parse(value)) &&\n      new Date(value).toISOString() === value,\n    'UTC_INVALID'\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·?·path.resolve(a).toLowerCase()·===·path.resolve(b).toLowerCase()` with `⏎····?·path.resolve(a).toLowerCase()·===·path.resolve(b).toLowerCase()⏎···`","line":24,"column":38,"nodeType":null,"messageId":"replace","endLine":24,"endColumn":104,"fix":{"range":[1772,1838],"text":"\n    ? path.resolve(a).toLowerCase() === path.resolve(b).toLowerCase()\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `value:·unknown,·role:·'sf-orchestrator