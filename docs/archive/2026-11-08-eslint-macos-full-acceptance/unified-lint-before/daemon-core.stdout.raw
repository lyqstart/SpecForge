ix":{"range":[1304,1315],"text":" (this.lost) "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `·`","line":23,"column":8,"nodeType":null,"messageId":"insert","endLine":23,"endColumn":8,"fix":{"range":[1330,1330],"text":" "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `<360,` with `·<·360,·`","line":24,"column":37,"nodeType":null,"messageId":"replace","endLine":24,"endColumn":42,"fix":{"range":[1368,1373],"text":" < 360, "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=await·this.input.verify();validateTrustedInvocationProof(proof,` with `·=·await·this.input.verify();⏎······validateTrustedInvocationProof(proof,·`","line":25,"column":18,"nodeType":null,"messageId":"replace","endLine":25,"endColumn":82,"fix":{"range":[1418,1482],"text":" = await this.input.verify();\n      validateTrustedInvocationProof(proof, "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `proof.runtimeProjectionSha256===this.input.owner.runtimeProjectionSha256&&Date.parse(proof.observedAt)>=Date.parse(this.input.startedAt),'INVOCATION_LEASE_SUBJECT_CHANGED'` with `⏎········proof.runtimeProjectionSha256·===·this.input.owner.runtimeProjectionSha256·&&⏎··········Date.parse(proof.observedAt)·>=·Date.parse(this.input.startedAt),⏎········'INVOCATION_LEASE_SUBJECT_CHANGED'⏎······`","line":26,"column":19,"nodeType":null,"messageId":"replace","endLine":26,"endColumn":190,"fix":{"range":[1516,1687],"text":"\n        proof.runtimeProjectionSha256 === this.input.owner.runtimeProjectionSha256 &&\n          Date.parse(proof.observedAt) >= Date.parse(this.input.startedAt),\n        'INVOCATION_LEASE_SUBJECT_CHANGED'\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `observedAt:proof.observedAt,active:true,projectionSha256:proof.runtimeProjectionSha256,reason:null` with `⏎········observedAt:·proof.observedAt,⏎········active:·true,⏎········projectionSha256:·proof.runtimeProjectionSha256,⏎········reason:·null,⏎······`","line":27,"column":25,"nodeType":null,"messageId":"replace","endLine":27,"endColumn":123,"fix":{"range":[1714,1812],"text":"\n        observedAt: proof.observedAt,\n        active: true,\n        projectionSha256: proof.runtimeProjectionSha256,\n        reason: null,\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `catch(error)` with `·catch·(error)·`","line":28,"column":6,"nodeType":null,"messageId":"replace","endLine":28,"endColumn":18,"fix":{"range":[1821,1833],"text":" catch (error) "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=error·instanceof·Error?error.message:` with `·=·error·instanceof·Error·?·error.message·:·`","line":29,"column":20,"nodeType":null,"messageId":"replace","endLine":29,"endColumn":58,"fix":{"range":[1854,1892],"text":" = error instanceof Error ? error.message : "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=/^[A-Z][A-Z_]{1,127}$/.test(message)?message:` with `·=·/^[A-Z][A-Z_]{1,127}$/.test(message)⏎········?·message⏎········:·`","line":30,"column":22,"nodeType":null,"messageId":"replace","endLine":30,"endColumn":68,"fix":{"range":[1917,1963],"text":" = /^[A-Z][A-Z_]{1,127}$/.test(message)\n        ? message\n        : "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `observedAt:new·Date().toISOString(),active:false,projectionSha256:null,reason:this.lostReason` with `⏎········observedAt:·new·Date().toISOString(),⏎········active:·false,⏎········projectionSha256:·null,⏎········reason:·this.lostReason,⏎······`","line":31,"column":25,"nodeType":null,"messageId":"replace","endLine":31,"endColumn":118,"fix":{"range":[2021,2114],"text":"\n        observedAt: new Date().toISOString(),\n        active: false,\n        projectionSha256: null,\n        reason: this.lostReason,\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎······`","line":32,"column":31,"nodeType":null,"messageId":"insert","endLine":32,"endColumn":31,"fix":{"range":[2148,2148],"text":"\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `Promise<boolean>` with `·Promise<boolean>·`","line":35,"column":17,"nodeType":null,"messageId":"replace","endLine":35,"endColumn":33,"fix":{"range":[2187,2203],"text":" Promise<boolean> "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(!this.signal.aborted)this.watcher=` with `·(!this.signal.aborted)·this.watcher·=·`","line":37,"column":7,"nodeType":null,"messageId":"replace","endLine":37,"endColumn":42,"fix":{"range":[2235,2270],"text":" (!this.signal.aborted) this.watcher = "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `Promise<void>` with `·Promise<void>·`","line":40,"column":25,"nodeType":null,"messageId":"replace","endLine":40,"endColumn":38,"fix":{"range":[2345,2358],"text":" Promise<void> "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(!this.closed&&!this.signal.aborted)` with `·(!this.closed·&&·!this.signal.aborted)·`","line":41,"column":10,"nodeType":null,"messageId":"replace","endLine":41,"endColumn":46,"fix":{"range":[2369,2405],"text":" (!this.closed && !this.signal.aborted) "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=>{const·timer=setTimeout(resolve,500);this.wake=()=>{clearTimeout(timer);resolve();};` with `·=>·{⏎········const·timer·=·setTimeout(resolve,·500);⏎········this.wake·=·()·=>·{⏎··········clearTimeout(timer);⏎··········resolve();⏎········};⏎······`","line":42,"column":38,"nodeType":null,"messageId":"replace","endLine":42,"endColumn":124,"fix":{"range":[2444,2530],"text":" => {\n        const timer = setTimeout(resolve, 500);\n        this.wake = () => {\n          clearTimeout(timer);\n          resolve();\n        };\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(!this.closed&&!this.signal.aborted)` with `·(!this.closed·&&·!this.signal.aborted)·`","line":43,"column":9,"nodeType":null,"messageId":"replace","endLine":43,"endColumn":45,"fix":{"range":[2542,2578],"text":" (!this.closed && !this.signal.aborted) "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `Promise<VerificationInvocationLeaseRecord>` with `·Promise<VerificationInvocationLeaseRecord>·`","line":46,"column":18,"nodeType":null,"messageId":"replace","endLine":46,"endColumn":60,"fix":{"range":[2625,2667],"text":" Promise<VerificationInvocationLeaseRecord> "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=true;` with `·=·true;⏎····`","line":47,"column":16,"nodeType":null,"messageId":"replace","endLine":47,"endColumn":22,"fix":{"range":[2684,2690],"text":" = true;\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `·`","line":48,"column":8,"nodeType":null,"messageId":"insert","endLine":48,"endColumn":8,"fix":{"range":[2710,2710],"text":" "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `contract:'verification-invocation-lease/v1',planId:this.input.planId,attemptId:this.input.attemptId,reservationId:` with `⏎········contract:·'verification-invocation-lease/v1',⏎········planId:·this.input.planId,⏎········attemptId:·this.input.attemptId,⏎········reservationId:·`","line":52,"column":15,"nodeType":null,"messageId":"replace","endLine":52,"endColumn":129,"fix":{"range":[2871,2985],"text":"\n        contract: 'verification-invocation-lease/v1',\n        planId: this.input.planId,\n        attemptId: this.input.attemptId,\n        reservationId: "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `this.input.owner,startedAt:this.input.startedAt,finishedAt:` with `·this.input.owner,⏎········startedAt:·this.input.startedAt,⏎········finishedAt:·`","line":53,"column":15,"nodeType":null,"messageId":"replace","endLine":53,"endColumn":74,"fix":{"range":[3025,3084],"text":" this.input.owner,\n        startedAt: this.input.startedAt,\n        finishedAt: "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `this.lost?'lost':this.externalCancelled?'cancelled':'completed',checks:this.checks` with `·this.lost·?·'lost'·:·this.externalCancelled·?·'cancelled'·:·'completed',⏎········checks:·this.checks,⏎······`","line":54,"column":18,"nodeType":null,"messageId":"replace","endLine":54,"endColumn":100,"fix":{"range":[3127,3209],"text":" this.lost ? 'lost' : this.externalCancelled ? 'cancelled' : 'completed',\n        checks: this.checks,\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `finally{this.input.signal?.removeEventListener('abort',this.onExternalAbort);` with `·finally·{⏎······this.input.signal?.removeEventListener('abort',·this.onExternalAbort);⏎····`","line":55,"column":6,"nodeType":null,"messageId":"replace","endLine":55,"endColumn":83,"fix":{"range":[3217,3294],"text":" finally {\n      this.input.signal?.removeEventListener('abort', this.onExternalAbort);\n    "}}],"suppressedMessages":[],"errorCount":41,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":41,"fixableWarningCount":0,"source":"/** A running call is the execution owner even when a host HTTP shim loses disconnect events. */\nimport type {TrustedToolInvocationProof} from '@specforge/types/trusted-tool-invocation';\nimport type {VerificationInvocationLeaseRecord} from './verification-plan';\nimport {validateTrustedInvocationProof,verificationRequire as requireFact} from './verification-schema';\n\nexport class VerificationInvocationLease {\n  readonly controller=new AbortController();\n  private closed=false;\n  private lostReason:string|null=null;\n  private externalCancelled=false;\n  private checks:VerificationInvocationLeaseRecord['checks']=[];\n  private watcher:Promise<void>|undefined;\n  private wake:()=>void=()=>{};\n  private readonly onExternalAbort=()=>{this.externalCancelled=true;this.controller.abort();this.wake();};\n  constructor(private readonly input:{planId:string;attemptId:string;reservationId:string;owner:TrustedToolInvocationProof;startedAt:string;verify:()=>Promise<TrustedToolInvocationProof>;signal?:AbortSignal}){\n    input.signal?.addEventListener('abort',this.onExternalAbort,{once:true});\n    if(input.signal?.aborted)this.onExternalAbort();\n  }\n  get signal():AbortSignal{return this.controller.signal;}\n  get lost():boolean{return this.lostReason!==null;}\n  private async check():Promise<void>{\n    if(this.lost)return;\n    try{\n      requireFact(this.checks.length<360,'INVOCATION_LEASE_BUDGET');\n      const proof=await this.input.verify();validateTrustedInvocationProof(proof,'sf-verifier');\n      requireFact(proof.runtimeProjectionSha256===this.input.owner.runtimeProjectionSha256&&Date.parse(proof.observedAt)>=Date.parse(this.input.startedAt),'INVOCATION_LEASE_SUBJECT_CHANGED');\n      this.checks.push({observedAt:proof.observedAt,active:true,projectionSha256:proof.runtimeProjectionSha256,reason:null});\n    }catch(error){\n      const message=error instanceof Error?error.message:'';\n      this.lostReason=/^[A-Z][A-Z_]{1,127}$/.test(message)?message:'RUNTIME_INVOCATION_UNAVAILABLE';\n      this.checks.push({observedAt:new Date().toISOString(),active:false,projectionSha256:null,reason:this.lostReason});\n      this.controller.abort();this.wake();\n    }\n  }\n  async start():Promise<boolean>{\n    await this.check();\n    if(!this.signal.aborted)this.watcher=this.watch();\n    return !this.signal.aborted;\n  }\n  private async watch():Promise<void>{\n    while(!this.closed&&!this.signal.aborted){\n      await new Promise<void>(resolve=>{const timer=setTimeout(resolve,500);this.wake=()=>{clearTimeout(timer);resolve();};});\n      if(!this.closed&&!this.signal.aborted)await this.check();\n    }\n  }\n  async finish():Promise<VerificationInvocationLeaseRecord>{\n    this.closed=true;this.wake();\n    try{\n      await this.watcher;\n      // Verify again immediately before the owner discharges the lease and signs a receipt.\n      await this.check();\n      return {contract:'verification-invocation-lease/v1',planId:this.input.planId,attemptId:this.input.attemptId,reservationId:this.input.reservationId,\n        owner:this.input.owner,startedAt:this.input.startedAt,finishedAt:new Date().toISOString(),\n        terminal:this.lost?'lost':this.externalCancelled?'cancelled':'completed',checks:this.checks};\n    }finally{this.input.signal?.removeEventListener('abort',this.onExternalAbort);}\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\verification\\native-executor.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·assertVerificationPath,·canonicalVerificationJson·as·json,·readVerificationFile,·verificationId·as·hash·` with `⏎··assertVerificationPath,⏎··canonicalVerificationJson·as·json,⏎··readVerificationFile,⏎··verificationId·as·hash,⏎`","line":6,"column":9,"nodeType":null,"messageId":"replace","endLine":6,"endColumn":114,"fix":{"range":[246,351],"text":"\n  assertVerificationPath,\n  canonicalVerificationJson as json,\n  readVerificationFile,\n  verificationId as hash,\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·verificationRecord·as·record,·verificationRequire·as·requireFact·` with `⏎··verificationRecord·as·record,⏎··verificationRequire·as·requireFact,⏎`","line":7,"column":9,"nodeType":null,"messageId":"replace","endLine":7,"endColumn":75,"fix":{"range":[383,449],"text":"\n  verificationRecord as record,\n  verificationRequire as requireFact,\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `file:·string,·bytes:·string·|·Buffer` with `⏎··file:·string,⏎··bytes:·string·|·Buffer⏎`","line":10,"column":48,"nodeType":null,"messageId":"replace","endLine":10,"endColumn":84,"fix":{"range":[611,647],"text":"\n  file: string,\n  bytes: string | Buffer\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·return·path.join(owner,·'runs',·attempt.attemptId);·` with `⏎··return·path.join(owner,·'runs',·attempt.attemptId);⏎`","line":19,"column":85,"nodeType":null,"messageId":"replace","endLine":19,"endColumn":138,"fix":{"range":[1146,1199],"text":"\n  return path.join(owner, 'runs', attempt.attemptId);\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `owner:·string,·attempt:·VerificationAttempt` with `⏎··owner:·string,⏎··attempt:·VerificationAttempt⏎`","line":20,"column":55,"nodeType":null,"messageId":"replace","endLine":20,"endColumn":98,"fix":{"range":[1255,1298],"text":"\n  owner: string,\n  attempt: VerificationAttempt\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·await·writeVerificationPrivate(file,·value);·}⏎··catch·(error)·{·if·((error·as·NodeJS.ErrnoException).code·!==·'EEXIST'·||·!(await·readVerificationFile(file,·1024)).equals(Buffer.from(value)))·throw·error;` with `⏎····await·writeVerificationPrivate(file,·value);⏎··}·catch·(error)·{⏎····if·(⏎······(error·as·NodeJS.ErrnoException).code·!==·'EEXIST'·||⏎······!(await·readVerificationFile(file,·1024)).equals(Buffer.from(value))⏎····)⏎······throw·error;⏎·`","line":23,"column":8,"nodeType":null,"messageId":"replace","endLine":24,"endColumn":159,"fix":{"range":[1492,1698],"text":"\n    await writeVerificationPrivate(file, value);\n  } catch (error) {\n    if (\n      (error as NodeJS.ErrnoException).code !== 'EEXIST' ||\n      !(await readVerificationFile(file, 1024)).equals(Buffer.from(value))\n    )\n      throw error;\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·finishedAt:·string;·exitCode:·number·|·null;` with `⏎··finishedAt:·string;⏎··exitCode:·number·|·null;⏎·`","line":28,"column":21,"nodeType":null,"messageId":"replace","endLine":28,"endColumn":66,"fix":{"range":[1752,1797],"text":"\n  finishedAt: string;\n  exitCode: number | null;\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·stderr:·Buffer;·outputComplete:·boolean;` with `⏎··stderr:·Buffer;⏎··outputComplete:·boolean;⏎·`","line":29,"column":18,"nodeType":null,"messageId":"replace","endLine":29,"endColumn":59,"fix":{"range":[1838,1879],"text":"\n  stderr: Buffer;\n  outputComplete: boolean;\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·cleanupProved:·boolean;` with `⏎··cleanupProved:·boolean;⏎·`","line":32,"column":18,"nodeType":null,"messageId":"replace","endLine":32,"endColumn":42,"fix":{"range":[1959,1983],"text":"\n  cleanupProved: boolean;\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·processResumed:·boolean;` with `⏎··processResumed:·boolean;⏎·`","line":36,"column":27,"nodeType":null,"messageId":"replace","endLine":36,"endColumn":52,"fix":{"range":[2108,2133],"text":"\n  processResumed: boolean;\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·jobEnded:·boolean;` with `⏎··jobEnded:·boolean;⏎·`","line":37,"column":35,"nodeType":null,"messageId":"replace","endLine":37,"endColumn":54,"fix":{"range":[2193,2212],"text":"\n  jobEnded: boolean;\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·stdoutSha256:·string;` with `⏎··stdoutSha256:·string;⏎·`","line":38,"column":27,"nodeType":null,"messageId":"replace","endLine":38,"endColumn":49,"fix":{"range":[2263,2285],"text":"\n  stdoutSha256: string;\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·`","line":39,"column":38,"nodeType":null,"messageId":"insert","endLine":39,"endColumn":38,"fix":{"range":[2345,2345],"text":"\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·outcome:·'passed'|'failed'|'not_executed'|'cancelled'|'interrupted';` with `⏎··outcome:·'passed'·|·'failed'·|·'not_executed'·|·'cancelled'·|·'interrupted';⏎·`","line":40,"column":35,"nodeType":null,"messageId":"replace","endLine":40,"endColumn":104,"fix":{"range":[2415,2484],"text":"\n  outcome: 'passed' | 'failed' | 'not_executed' | 'cancelled' | 'interrupted';\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `plan:·VerificationPlan,·attempt:·VerificationAttempt,·mode:·'--verification-plan'|'--verification-inspect'|'--verification-recover',·signal?:·AbortSignal` with `⏎····plan:·VerificationPlan,⏎····attempt:·VerificationAttempt,⏎····mode:·'--verification-plan'·|·'--verification-inspect'·|·'--verification-recover',⏎····signal?:·AbortSignal⏎··`","line":46,"column":24,"nodeType":null,"messageId":"replace","endLine":46,"endColumn":177,"fix":{"range":[2623,2776],"text":"\n    plan: VerificationPlan,\n    attempt: VerificationAttempt,\n    mode: '--verification-plan' | '--verification-inspect' | '--verification-recover',\n    signal?: AbortSignal\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":47,"column":48,"nodeType":null,"messageId":"insert","endLine":47,"endColumn":48,"fix":{"range":[2853,2853],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `hash(await·readVerificationFile(config,·4194304))·===·attempt.nativeConfigSha256,·'NATIVE_CONFIG_DRIFT'` with `⏎······hash(await·readVerificationFile(config,·4194304))·===·attempt.nativeConfigSha256,⏎······'NATIVE_CONFIG_DRIFT'⏎····`","line":48,"column":17,"nodeType":null,"messageId":"replace","endLine":48,"endColumn":120,"fix":{"range":[2922,3025],"text":"\n      hash(await readVerificationFile(config, 4194304)) === attempt.nativeConfigSha256,\n      'NATIVE_CONFIG_DRIFT'\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `hash(await·readVerificationFile(plan.assets.launcherPath,·268435456))·===·plan.assets.launcherSha256,·'LAUNCHER_DRIFT'` with `⏎······hash(await·readVerificationFile(plan.assets.launcherPath,·268435456))·===⏎········plan.assets.launcherSha256,⏎······'LAUNCHER_DRIFT'⏎····`","line":49,"column":17,"nodeType":null,"messageId":"replace","endLine":49,"endColumn":135,"fix":{"range":[3044,3162],"text":"\n      hash(await readVerificationFile(plan.assets.launcherPath, 268435456)) ===\n        plan.assets.launcherSha256,\n      'LAUNCHER_DRIFT'\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·OPENCODE_CONFIG_DIR:·path.resolve(this.ownerRoot,·'../../..')` with `⏎···