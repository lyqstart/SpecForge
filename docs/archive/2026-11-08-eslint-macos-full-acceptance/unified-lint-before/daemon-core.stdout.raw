····extended.statusCode·>=·100·&&⏎······extended.statusCode·<=·599⏎········?·extended.statusCode⏎········:·`","line":10,"column":17,"nodeType":null,"messageId":"replace","endLine":10,"endColumn":167,"fix":{"range":[772,922],"text":"\n      typeof extended?.statusCode === 'number' &&\n      Number.isInteger(extended.statusCode) &&\n      extended.statusCode >= 100 &&\n      extended.statusCode <= 599\n        ? extended.statusCode\n        : "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `message.match(/^([A-Z][A-Z0-9_]{2,95})(?=:|$)/)?.[1]??` with `·message.match(/^([A-Z][A-Z0-9_]{2,95})(?=:|$)/)?.[1]·??·`","line":11,"column":20,"nodeType":null,"messageId":"replace","endLine":11,"endColumn":74,"fix":{"range":[947,1001],"text":" message.match(/^([A-Z][A-Z0-9_]{2,95})(?=:|$)/)?.[1] ?? "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `/timed·out·after·\\d+ms/.test(message)?'timeout':/returned·invalid·JSON/.test(message)?'invalid_json':/failed·with·HTTP·\\d+/.test(message)?'http_error':/request·failed/.test(message)?'request_failed':` with `·/timed·out·after·\\d+ms/.test(message)⏎······?·'timeout'⏎······:·/returned·invalid·JSON/.test(message)⏎········?·'invalid_json'⏎········:·/failed·with·HTTP·\\d+/.test(message)⏎··········?·'http_error'⏎··········:·/request·failed/.test(message)⏎············?·'request_failed'⏎············:·`","line":12,"column":24,"nodeType":null,"messageId":"replace","endLine":12,"endColumn":223,"fix":{"range":[1030,1229],"text":" /timed out after \\d+ms/.test(message)\n      ? 'timeout'\n      : /returned invalid JSON/.test(message)\n        ? 'invalid_json'\n        : /failed with HTTP \\d+/.test(message)\n          ? 'http_error'\n          : /request failed/.test(message)\n            ? 'request_failed'\n            : "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `createHash('sha256').update(message).digest('hex')` with `·createHash('sha256').update(message).digest('hex'),⏎··`","line":13,"column":20,"nodeType":null,"messageId":"replace","endLine":13,"endColumn":70,"fix":{"range":[1254,1304],"text":" createHash('sha256').update(message).digest('hex'),\n  "}}],"suppressedMessages":[],"errorCount":13,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":13,"fixableWarningCount":0,"source":"/** Bounded private diagnostics. Never logs arbitrary exception text, paths or response bodies. */\nimport {createHash} from 'node:crypto';\nexport function verificationRejectionDiagnostic(error:unknown):Record<string,unknown>{\n  const value=error instanceof Error?error:null,extended=value as (Error&{code?:unknown;syscall?:unknown;statusCode?:unknown})|null;\n  const token=(input:unknown,pattern:RegExp)=>typeof input==='string'&&pattern.test(input)?input:null;\n  const message=value?.message??'';\n  return {event:'verification.request.rejected',utc:new Date().toISOString(),\n    error_name:token(value?.name,/^[A-Za-z][A-Za-z0-9_]{0,63}$/),\n    system_code:token(extended?.code,/^[A-Z][A-Z0-9_]{0,63}$/),syscall:token(extended?.syscall,/^[a-z_]{1,40}$/),\n    http_status:typeof extended?.statusCode==='number'&&Number.isInteger(extended.statusCode)&&extended.statusCode>=100&&extended.statusCode<=599?extended.statusCode:null,\n    message_family:message.match(/^([A-Z][A-Z0-9_]{2,95})(?=:|$)/)?.[1]??null,\n    transport_category:/timed out after \\d+ms/.test(message)?'timeout':/returned invalid JSON/.test(message)?'invalid_json':/failed with HTTP \\d+/.test(message)?'http_error':/request failed/.test(message)?'request_failed':null,\n    message_sha256:createHash('sha256').update(message).digest('hex')};\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\verification\\request-context.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `tool:·string,·args:·Record<string,unknown>` with `⏎··tool:·string,⏎··args:·Record<string,·unknown>⏎`","line":9,"column":47,"nodeType":null,"messageId":"replace","endLine":9,"endColumn":89,"fix":{"range":[649,691],"text":"\n  tool: string,\n  args: Record<string, unknown>\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `tool·===·'sf_verification_plan'·&&·args.action·===·'revoke'` with `(⏎····(tool·===·'sf_verification_plan'·&&·args.action·===·'revoke')`","line":10,"column":10,"nodeType":null,"messageId":"replace","endLine":10,"endColumn":69,"fix":{"range":[713,772],"text":"(\n    (tool === 'sf_verification_plan' && args.action === 'revoke')"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `tool·===·'sf_verification_run'·&&·(args.action·===·'cancel'·||·args.action·===·'recover'` with `(tool·===·'sf_verification_run'·&&·(args.action·===·'cancel'·||·args.action·===·'recover'))⏎··`","line":11,"column":5,"nodeType":null,"messageId":"replace","endLine":11,"endColumn":93,"fix":{"range":[780,868],"text":"(tool === 'sf_verification_run' && (args.action === 'cancel' || args.action === 'recover'))\n  "}}],"suppressedMessages":[],"errorCount":3,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":3,"fixableWarningCount":0,"source":"/** Process-local HTTP lifetime marker; JSON callers cannot manufacture this key. */\nexport const VERIFICATION_REQUEST_ABORT = Symbol('SpecForge trusted verification request lifetime');\nexport function verificationRequestAbort(context: unknown): AbortSignal | undefined {\n  if (!context || typeof context !== 'object') return undefined;\n  const value = (context as { [VERIFICATION_REQUEST_ABORT]?: unknown })[VERIFICATION_REQUEST_ABORT];\n  return value instanceof AbortSignal ? value : undefined;\n}\n/** Only resource cancellation/reclamation and permission revocation remain reachable under a latch. */\nexport function isVerificationRecoveryRequest(tool: string, args: Record<string,unknown>): boolean {\n  return tool === 'sf_verification_plan' && args.action === 'revoke' ||\n    tool === 'sf_verification_run' && (args.action === 'cancel' || args.action === 'recover');\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\verification\\source-snapshot.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"@specforge/types/directory-layout\"` with `'@specforge/types/directory-layout'`","line":1,"column":31,"nodeType":null,"messageId":"replace","endLine":1,"endColumn":66,"fix":{"range":[30,65],"text":"'@specforge/types/directory-layout'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·assertVerificationPath,·canonicalVerificationJson,·readVerificationFile,·verificationId·` with `⏎··assertVerificationPath,⏎··canonicalVerificationJson,⏎··readVerificationFile,⏎··verificationId,⏎`","line":6,"column":9,"nodeType":null,"messageId":"replace","endLine":6,"endColumn":98,"fix":{"range":[295,384],"text":"\n  assertVerificationPath,\n  canonicalVerificationJson,\n  readVerificationFile,\n  verificationId,\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·path:·string;·bytes:·number;·sha256:·string;·device:·string;·inode:·string;·` with `⏎··path:·string;⏎··bytes:·number;⏎··sha256:·string;⏎··device:·string;⏎··inode:·string;⏎`","line":9,"column":41,"nodeType":null,"messageId":"replace","endLine":9,"endColumn":118,"fix":{"range":[523,600],"text":"\n  path: string;\n  bytes: number;\n  sha256: string;\n  device: string;\n  inode: string;\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `!relative·||·relative.includes('\\\\')·||·path.isAbsolute(relative)·||·relative.split('/').some(` with `⏎····!relative·||⏎····relative.includes('\\\\')·||⏎····path.isAbsolute(relative)·||⏎····relative⏎······.split('/')⏎······.some(⏎········`","line":22,"column":7,"nodeType":null,"messageId":"replace","endLine":22,"endColumn":101,"fix":{"range":[914,1008],"text":"\n    !relative ||\n    relative.includes('\\\\') ||\n    path.isAbsolute(relative) ||\n    relative\n      .split('/')\n      .some(\n        "}},{"ruleId":"prettie