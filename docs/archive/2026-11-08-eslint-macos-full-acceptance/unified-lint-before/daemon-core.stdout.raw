ALID'\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·verificationInstant(r.finishedAt);` with `⏎··verificationInstant(r.finishedAt);⏎·`","line":99,"column":36,"nodeType":null,"messageId":"replace","endLine":99,"endColumn":71,"fix":{"range":[12249,12284],"text":"\n  verificationInstant(r.finishedAt);\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·assets(r.assets);` with `⏎··assets(r.assets);⏎·`","line":100,"column":58,"nodeType":null,"messageId":"replace","endLine":100,"endColumn":76,"fix":{"range":[12440,12458],"text":"\n  assets(r.assets);\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `['passed','failed','not_executed','cancelled','interrupted'].includes(String(r.outcome))·&&·(r.failure·===·null·||·typeof·r.failure·===·'string'),·'RECEIPT_OUTCOME_INVALID'` with `⏎····['passed',·'failed',·'not_executed',·'cancelled',·'interrupted'].includes(String(r.outcome))·&&⏎······(r.failure·===·null·||·typeof·r.failure·===·'string'),⏎····'RECEIPT_OUTCOME_INVALID'⏎··`","line":101,"column":23,"nodeType":null,"messageId":"replace","endLine":101,"endColumn":195,"fix":{"range":[12499,12671],"text":"\n    ['passed', 'failed', 'not_executed', 'cancelled', 'interrupted'].includes(String(r.outcome)) &&\n      (r.failure === null || typeof r.failure === 'string'),\n    'RECEIPT_OUTCOME_INVALID'\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·verificationRequire(r.processStarted·&&·r.processResumed·&&·r.exitCode·===·0·&&·r.launcherExitCode·===·0·&&·r.jobEnded·&&·r.cleanupProved·&&·r.outputComplete·&&·r.nativeReceiptSha256·!==·null·&&·r.nativeEventsSha256·!==·null·&&·r.inspectionSha256·!==·null·&&·r.failure·===·null,·'PASSED_RECEIPT_INCOMPLETE'` with `⏎····verificationRequire(⏎······r.processStarted·&&⏎········r.processResumed·&&⏎········r.exitCode·===·0·&&⏎········r.launcherExitCode·===·0·&&⏎········r.jobEnded·&&⏎········r.cleanupProved·&&⏎········r.outputComplete·&&⏎········r.nativeReceiptSha256·!==·null·&&⏎········r.nativeEventsSha256·!==·null·&&⏎········r.inspectionSha256·!==·null·&&⏎········r.failure·===·null,⏎······'PASSED_RECEIPT_INCOMPLETE'⏎····`","line":102,"column":30,"nodeType":null,"messageId":"replace","endLine":102,"endColumn":337,"fix":{"range":[12703,13010],"text":"\n    verificationRequire(\n      r.processStarted &&\n        r.processResumed &&\n        r.exitCode === 0 &&\n        r.launcherExitCode === 0 &&\n        r.jobEnded &&\n        r.cleanupProved &&\n        r.outputComplete &&\n        r.nativeReceiptSha256 !== null &&\n        r.nativeEventsSha256 !== null &&\n        r.inspectionSha256 !== null &&\n        r.failure === null,\n      'PASSED_RECEIPT_INCOMPLETE'\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `value:unknown):` with `⏎··value:·unknown⏎):·`","line":105,"column":53,"nodeType":null,"messageId":"replace","endLine":105,"endColumn":68,"fix":{"range":[13068,13083],"text":"\n  value: unknown\n): "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=verificationRecord(value,['contract','planId','attemptId','reservationId','owner','startedAt','finishedAt','terminal','checks'` with `·=·verificationRecord(value,·[⏎····'contract',⏎····'planId',⏎····'attemptId',⏎····'reservationId',⏎····'owner',⏎····'startedAt',⏎····'finishedAt',⏎····'terminal',⏎····'checks',⏎··`","line":106,"column":10,"nodeType":null,"messageId":"replace","endLine":106,"endColumn":137,"fix":{"range":[13145,13272],"text":" = verificationRecord(value, [\n    'contract',\n    'planId',\n    'attemptId',\n    'reservationId',\n    'owner',\n    'startedAt',\n    'finishedAt',\n    'terminal',\n    'checks',\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `l.contract==='verification-invocation-lease/v1'&&typeof·l.attemptId==='string'&&/^[a-f0-9]{32}$/.test(l.attemptId),'LEASE_IDENTITY_INVALID'` with `⏎····l.contract·===·'verification-invocation-lease/v1'·&&⏎······typeof·l.attemptId·===·'string'·&&⏎······/^[a-f0-9]{32}$/.test(l.attemptId),⏎····'LEASE_IDENTITY_INVALID'⏎··`","line":107,"column":23,"nodeType":null,"messageId":"replace","endLine":107,"endColumn":162,"fix":{"range":[13298,13437],"text":"\n    l.contract === 'verification-invocation-lease/v1' &&\n      typeof l.attemptId === 'string' &&\n      /^[a-f0-9]{32}$/.test(l.attemptId),\n    'LEASE_IDENTITY_INVALID'\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `verificationHash(l.reservationId);validateTrustedInvocationProof(l.owner,'sf-verifier');verificationInstant(l.startedAt);` with `⏎··verificationHash(l.reservationId);⏎··validateTrustedInvocationProof(l.owner,·'sf-verifier');⏎··verificationInstant(l.startedAt);⏎··`","line":108,"column":30,"nodeType":null,"messageId":"replace","endLine":108,"endColumn":151,"fix":{"range":[13469,13590],"text":"\n  verificationHash(l.reservationId);\n  validateTrustedInvocationProof(l.owner, 'sf-verifier');\n  verificationInstant(l.startedAt);\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `Date.parse(l.finishedAt)>=Date.parse(l.startedAt)&&['completed','cancelled','lost'].includes(String(l.terminal))&&Array.isArray(l.checks)&&l.checks.length>=1&&l.checks.length<=361,'LEASE_SCHEMA_INVALID'` with `⏎····Date.parse(l.finishedAt)·>=·Date.parse(l.startedAt)·&&⏎······['completed',·'cancelled',·'lost'].includes(String(l.terminal))·&&⏎······Array.isArray(l.checks)·&&⏎······l.checks.length·>=·1·&&⏎······l.checks.length·<=·361,⏎····'LEASE_SCHEMA_INVALID'⏎··`","line":109,"column":23,"nodeType":null,"messageId":"replace","endLine":109,"endColumn":225,"fix":{"range":[13647,13849],"text":"\n    Date.parse(l.finishedAt) >= Date.parse(l.startedAt) &&\n      ['completed', 'cancelled', 'lost'].includes(String(l.terminal)) &&\n      Array.isArray(l.checks) &&\n      l.checks.length >= 1 &&\n      l.checks.length <= 361,\n    'LEASE_SCHEMA_INVALID'\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=Date.parse(l.startedAt),lost=` with `·=·Date.parse(l.startedAt),⏎····lost·=·`","line":110,"column":15,"nodeType":null,"messageId":"replace","endLine":110,"endColumn":45,"fix":{"range":[13866,13896],"text":" = Date.parse(l.startedAt),\n    lost = "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(const·value·of·l.checks)` with `·(const·value·of·l.checks)·`","line":111,"column":6,"nodeType":null,"messageId":"replace","endLine":111,"endColumn":31,"fix":{"range":[13908,13933],"text":" (const value of l.checks) "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=verificationRecord(value,['observedAt','active','projectionSha256','reason']);` with `·=·verificationRecord(value,·['observedAt',·'active',·'projectionSha256',·'reason']);⏎····`","line":112,"column":12,"nodeType":null,"messageId":"replace","endLine":112,"endColumn":91,"fix":{"range":[13946,14025],"text":" = verificationRecord(value, ['observedAt', 'active', 'projectionSha256', 'reason']);\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `!lost&&typeof·c.active==='boolean'&&Date.parse(c.observedAt)>=previous&&Date.parse(c.observedAt)<=Date.parse(l.finishedAt),'LEASE_CHECK_TIME_INVALID');previous=` with `⏎······!lost·&&⏎········typeof·c.active·===·'boolean'·&&⏎········Date.parse(c.observedAt)·>=·previous·&&⏎········Date.parse(c.observedAt)·<=·Date.parse(l.finishedAt),⏎······'LEASE_CHECK_TIME_INVALID'⏎····);⏎····previous·=·`","line":113,"column":25,"nodeType":null,"messageId":"replace","endLine":113,"endColumn":185,"fix":{"range":[14084,14244],"text":"\n      !lost &&\n        typeof c.active === 'boolean' &&\n        Date.parse(c.observedAt) >= previous &&\n        Date.parse(c.observedAt) <= Date.parse(l.finishedAt),\n      'LEASE_CHECK_TIME_INVALID'\n    );\n    previous = "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(c.active){verificationRequire(c.reason===null&&c.projectionSha256===(l.owner·as·TrustedToolInvocationProof).runtimeProjectionSha256,'LEASE_ACTIVE_PROOF_INVALID');}` with `·(c.active)·{⏎······verificationRequire(⏎········c.reason·===·null·&&⏎··········c.projectionSha256·===·(l.owner·as·TrustedToolInvocationProof).runtimeProjectionSha256,⏎········'LEASE_ACTIVE_PROOF_INVALID'⏎······);`","line":114,"column":7,"nodeType":null,"messageId":"replace","endLine":114,"endColumn":171,"fix":{"range":[14276,14440],"text":" (c.active) {\n      verificationRequire(\n        c.reason === null &&\n          c.projectionSha256 === (l.owner as TrustedToolInvocationProof).runtimeProjectionSha256,\n        'LEASE_ACTIVE_PROOF_INVALID'\n      );"}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":114,"column":77,"nodeType":"TSAsExpression","messageId":"unnecessaryAssertion","endLine":114,"endColumn":114,"fix":{"range":[14353,14383],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `else{verificationRequire(c.projectionSha256===null&&typeof·c.reason==='string'&&/^[A-Z][A-Z_]{1,127}$/.test(c.reason),'LEASE_LOSS_INVALID');lost=true;` with `}·else·{⏎······verificationRequire(⏎········c.projectionSha256·===·null·&&⏎··········typeof·c.reason·===·'string'·&&⏎··········/^[A-Z][A-Z_]{1,127}$/.test(c.reason),⏎········'LEASE_LOSS_INVALID'⏎······);⏎······lost·=·true;⏎····`","line":115,"column":5,"nodeType":null,"messageId":"replace","endLine":115,"endColumn":155,"fix":{"range":[14445,14595],"text":"} else {\n      verificationRequire(\n        c.projectionSha256 === null &&\n          typeof c.reason === 'string' &&\n          /^[A-Z][A-Z_]{1,127}$/.test(c.reason),\n        'LEASE_LOSS_INVALID'\n      );\n      lost = true;\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `==='lost'?lost:!lost,` with `·===·'lost'·?·lost·:·!lost,·`","line":117,"column":33,"nodeType":null,"messageId":"replace","endLine":117,"endColumn":54,"fix":{"range":[14633,14654],"text":" === 'lost' ? lost : !lost, "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(l.terminal==='completed')verificationRequire(l.checks.length>=2,` with `·(l.terminal·===·'completed')⏎····verificationRequire(l.checks.length·>=·2,·`","line":118,"column":5,"nodeType":null,"messageId":"replace","endLine":118,"endColumn":70,"fix":{"range":[14685,14750],"text":" (l.terminal === 'completed')\n    verificationRequire(l.checks.length >= 2, "}}],"suppressedMessages":[],"errorCount":86,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":86,"fixableWarningCount":0,"source":"import { SPEC_DIR_NAME } from \"@specforge/types/directory-layout\";\n/** Strict persistent schemas shared by producers and every execution-evidence consumer. */\nimport path from 'node:path';\nimport type { TrustedToolInvocationProof } from '@specforge/types/trusted-tool-invocation';\nimport { canonicalVerificationJson as json, verificationId as hash } from './owner-store';\nimport { assertVerificationRelativePath } from './source-snapshot';\nimport { VERIFICATION_BUDGET, VERIFICATION_PROFILE, PINNED_NODE_SHA256,\n  type VerificationPlan, type VerificationAttempt, type VerificationExecutionReceipt, type VerificationInvocationLeaseRecord } from './verification-plan';\n\nexport function verificationRequire(value: unknown, code: string): asserts value {\n  if (!value) throw new Error('VERIFICATION_' + code);\n}\nexport function verificationRecord(value: unknown, keys?: string[]): Record<string, unknown> {\n  verificationRequire(value !== null && typeof value === 'object' && !Array.isArray(value) && Object.getPrototypeOf(value) === Object.prototype, 'OBJECT_INVALID');\n  const record = value as Record<string, unknown>;\n  if (keys) verificationRequire(Object.keys(record).sort().join(',') === [...keys].sort().join(','), 'SCHEMA_FIELDS_INVALID');\n  return record;\n}\nexport function verificationHash(value: unknown): asserts value is string { verificationRequire(typeof value === 'string' && /^[a-f0-9]{64}$/.test(value), 'HASH_INVALID'); }\nexport function verificationInstant(value: unknown): asserts value is string {\n  verificationRequire(typeof value === 'string' && Number.isFinite(Date.parse(value)) && new Date(value).toISOString() === value, 'UTC_INVALID');\n}\nexport function sameVerificationPath(a: string, b: string): boolean {\n  return process.platform === 'win32' ? path.resolve(a).toLowerCase() === path.resolve(b).toLowerCase() : path.resolve(a) === path.resolve(b);\n}\nexport function validateTrustedInvocationProof(value: unknown, role: 'sf-orchestrator' | 'sf-verifier'): asserts value is TrustedToolInvocationProof {\n  const p = verificationRecord(value, ['source','sessionId','messageId','callId','agent','directory','tool','inputSha256','startedAt','observedAt','runtimeProjectionSha256']);\n  verificationRequire(p.source === 'runtime-tool-invocation/v1' && p.agent === role && p.tool === (role === 'sf-orchestrator' ? 'sf_verification_plan' : 'sf_verification_run') &&\n    typeof p.sessionId === 'string' && p.sessionId.length > 0 && p.sessionId.length <= 256 && typeof p.messageId === 'string' && p.messageId.length > 0 && p.messageId.length <= 256 &&\n    typeof p.callId === 'string' && p.callId.length > 0 && p.callId.length <= 256 && typeof p.directory === 'string' && path.isAbsolute(p.directory) &&\n    Number.isSafeInteger(p.startedAt) && (p.startedAt as number) >= 0, 'OWNER_PROOF_INVALID');\n  verificationHash(p.inputSha256); verificationHash(p.runtimeProjectionSha256); verificationInstant(p.observedAt);\n  verificationRequire((p.startedAt as number) <= Date.parse(p.observedAt), 'OWNER_TIME_INVALID');\n  const { source: _source, observedAt: _observed, runtimeProjectionSha256: _projection, ...projection } = p;\n  verificationRequire(hash(json(projection)) === p.runtimeProjectionSha256, 'OWNER_PROJECTION_INVALID');\n}\nfunction assets(value: unknown): void {\n  const a = verificationRecord(value, ['contract','profile','nodePath','nodeSha256','launcherPath','launcherSha256','daemonPath','daemonSha256','manifestSha256']);\n  verificationRequire(a.contract === 'verification-assets/v1' && a.profile === VERIFICATION_PROFILE && a.nodeSha256 === PINNED_NODE_SHA256, 'ASSET_CONTRACT_INVALID');\n  for (const field of ['nodePath','launcherPath','daemonPath']) verificationRequire(typeof a[field] === 'string' && path.isAbsolute(a[field] as string), 'ASSET_PATH_INVALID');\n  for (const field of ['nodeSha256','launcherSha256','daemonSha256','manifestSha256']) verificationHash(a[field]);\n}\nfunction budget(value: unknown): void { verificationRequire(json(value) === json(VERIFICATION_BUDGET), 'BUDGET_INVALID'); }\nexport function validateVerificationPlan(value: unknown): asserts value is VerificationPlan {\n  const p = verificationRecord(value, ['contract','createdAt','expiresAt','projectRoot','workItemId','authority','source','command','assets','profile','budget','permission','owner']);\n  verificationRequire(p.contract === 'verification-plan/v1' && p.profile === VERIFICATION_PROFILE && typeof p.projectRoot === 'string' && path.isAbsolute(p.projectRoot) &&\n    typeof p.workItemId === 'string' && /^WI-[0-9]{4,}$/.test(p.workItemId), 'PLAN_IDENTITY_INVALID');\n  verificationInstant(p.createdAt); verificationInstant(p.expiresAt);\n  verificationRequire(Date.parse(p.expiresAt) > Date.parse(p.createdAt) && Date.parse(p.expiresAt) - Date.parse(p.createdAt) === 600000, 'PLAN_LIFETIME_INVALID');\n  validateTrustedInvocationProof(p.owner, 'sf-orchestrator'); verificationRequire(sameVerificationPath(p.owner.directory, p.projectRoot), 'OWNER_PROJECT_MISMATCH');\n  verificationRequire(json(p.permission) === json({ kind:'independent-readonly-verification/v1',grantee:'sf-verifier',codeWriteGranted:false }), 'PERMISSION_INVALID');\n  assets(p.assets); budget(p.budget);\n  const s = verificationRecord(p.source, ['projectRoot','head','branch','indexSha256','configSha256','files','trackedPaths','identity']);\n  verificationRequire(s.projectRoot === p.projectRoot && typeof s.head === 'string' && /^[a-f0-9]{40}$/.test(s.head) && typeof s.branch === 'string' && s.branch.length > 0 && Array.isArray(s.files) && s.files.length <= 2048 && Array.isArray(s.trackedPaths), 'SOURCE_SCHEMA_INVALID');\n  for (const field of ['indexSha256','configSha256','identity']) verificationHash(s[field]);\n  const paths = new Set<string>(); let bytes = 0;\n  for (const value of s.files) {\n    const f = verificationRecord(value, ['path','bytes','sha256','device','inode']);\n    verificationRequire(typeof f.path === 'string', 'INPUT_PATH_INVALID'); assertVerificationRelativePath(f.path);\n    verificationRequire(!f.path.split('/').some(part => ['.git',SPEC_DIR_NAME,'node_modules'].includes(part.toLowerCase())), 'PROTECTED_INPUT');\n    const identity = process.platform === 'win32' ? f.path.toLowerCase() : f.path;\n    verificationRequire(!paths.has(identity) && Number.isSafeInteger(f.bytes) && (f.bytes as number) >= 0 && typeof f.device === 'string' && /^\\d+$/.test(f.device) && typeof f.inode === 'string' && /^\\d+$/.test(f.inode), 'INPUT_IDENTITY_INVALID');\n    paths.add(identity); bytes += f.bytes as number; verificationHash(f.sha256);\n  }\n  verificationRequire(bytes <= 16777216 && s.trackedPaths.every(v => typeof v === 'string'), 'INPUT_BUDGET_INVALID');\n  for (const name of s.trackedPaths as string[]) assertVerificationRelativePath(name);\n  const { identity: _sourceId, ...sourceBody } = s; verificationRequire(hash(json(sourceBody)) === s.identity, 'SOURCE_IDENTITY_INVALID');\n  const a = verificationRecord(p.authority, ['state','purpose','workItemId','psv','files','taskPath','taskId','verificationType','commandIndex','command','metadataRawSha256','metadataBasisSha256','basisIdentity','identity']);\n  verificationRequire(a.workItemId === p.workItemId && (a.state === 'implementation_running' && a.purpose === 'implementation' || a.state === 'verification_running' && a.purpose === 'formal') &&\n    typeof a.psv === 'string' && /^PSV-[0-9]{4,}$/.test(a.psv) && typeof a.taskId === 'string' && new RegExp('^TASK-'+p.workItemId+'-[0-9]{3}$').test(a.taskId) &&\n    ['unit','property','integration','e2e','regression'].includes(String(a.verificationType)) && Number.isSafeInteger(a.commandIndex) && (a.commandIndex as number) >= 0 && (a.commandIndex as number) <= 63 && typeof a.command === 'string' && typeof a.taskPath === 'string', 'AUTHORITY_SCHEMA_INVALID');\n  assertVerificationRelativePath(a.taskPath);\n  const files = verificationRecord(a.files); verificationRequire(Object.keys(files).length > 0 && Object.keys(files).length <= 2048, 'AUTHORITY_FILES_INVALID');\n  for (const [name, identity] of Object.entries(files)) { assertVerificationRelativePath(name); verificationRequire(name.startsWith((`${SPEC_DIR_NAME}/` as const)), 'AUTHORITY_PATH_INVALID'); verificationHash(identity); }\n  for (const key of ['metadataRawSha256','metadataBasisSha256','basisIdentity','identity']) verificationHash(a[key]);\n  const { identity: _id, basisIdentity: _basisId, ...body } = a;\n  const { state: _state, metadataRawSha256: _raw, ...basis } = body;\n  verificationRequire(hash(json(body)) === a.identity && hash(json(basis)) === a.basisIdentity, 'AUTHORITY_IDENTITY_INVALID');\n  const c = verificationRecord(p.command, ['contract','original','kind','argv','entry','inlineSource','semanticProof']);\n  verificationRequire(c.contract === 'readonly-node-command/v1' && c.original === a.command && ['node-test-file','node-inline'].includes(String(c.kind)) && Array.isArray(c.argv) && c.argv.every(v => typeof v === 'string'), 'COMMAND_SCHEMA_INVALID');\n  verificationRequire(c.kind === 'node-test-file' ? typeof c.entry === 'string' && c.inlineSource === null : c.entry === null && typeof c.inlineSource === 'string', 'COMMAND_KIND_INVALID');\n  const semantic = verificationRecord(c.semanticProof, ['rule','inputHashes']);\n  verificationRequire(['single-file-no-host-observation/v1','finite-posix-readonly-predicate/v1'].includes(String(semantic.rule)), 'SEMANTIC_PROOF_INVALID');\n  for (const [name, identity] of Object.entries(verificationRecord(semantic.inputHashes))) { assertVerificationRelativePath(name); verificationHash(identity); verificationRequire((s.files as Array<Record<string,unknown>>).some(f => f.path === name && f.sha256 === identity), 'PROOF_INPUT_MISMATCH'); }\n}\nexport function validateVerificationAttempt(value: unknown): asserts value is VerificationAttempt {\n  const a = verificationRecord(value, ['contract','planId','attemptId','createdAt','projectRoot','workItemId','owner','nativeConfigSha256','initialAttemptAbsent']);\n  verificationRequire(a.contract === 'verification-attempt/v1' && typeof a.attemptId === 'string' && /^[a-f0-9]{32}$/.test(a.attemptId) && a.initialAttemptAbsent === true && typeof a.projectRoot === 'string' && path.isAbsolute(a.projectRoot) && typeof a.workItemId === 'string' && /^WI-[0-9]{4,}$/.test(a.workItemId), 'ATTEMPT_INVALID');\n  verificationHash(a.planId); verificationHash(a.nativeConfigSha256); verificationInstant(a.createdAt); validateTrustedInvocationProof(a.owner, 'sf-verifier');\n  verificationRequire(sameVerificationPath(a.owner.directory, a.projectRoot), 'ATTEMPT_OWNER_PROJECT_INVALID');\n}\nexport function validateVerificationReceipt(value: unknown): asserts value is VerificationExecutionReceipt {\n  const r = verificationRecord(value, ['contract','planId','attemptId','projectRoot','workItemId','purpose','startedAt','finishedAt','owner','sourceIdentity','authorityIdentity','assets','profile','budget','processStarted','processResumed','exitCode','launcherExitCode','jobEnded','cleanupProved','outputComplete','stdoutSha256','stderrSha256','nativeReceiptSha256','nativeEventsSha256','inspectionSha256','reservationId','leaseId','outcome','failure']);\n  verificationRequire(r.contract === 'verification-execution/v1' && typeof r.attemptId === 'string' && /^[a-f0-9]{32}$/.test(r.attemptId) && typeof r.projectRoot === 'string' && path.isAbsolute(r.projectRoot) && typeof r.workItemId === 'string' && /^WI-[0-9]{4,}$/.test(r.workItemId) && ['implementation','formal'].includes(String(r.purpose)) && r.profile === VERIFICATION_PROFILE, 'RECEIPT_IDENTITY_INVALID');\n  for (const key of ['planId','sourceIdentity','authorityIdentity','stdoutSha256','stderrSha256','reservationId','leaseId']) verificationHash(r[key]);\n  for (const key of ['nativeReceiptSha256','nativeEventsSha256','inspectionSha256']) if (r[key] !== null) verificationHash(r[key]);\n  for (const key of ['processStarted','processResumed','jobEnded','cleanupProved','outputComplete']) verificationRequire(typeof r[key] === 'boolean', 'RECEIPT_BOOLEAN_INVALID');\n  for (const key of ['exitCode','launcherExitCode']) verificationRequire(r[key] === null || Number.isSafeInteger(r[key]) && (r[key] as number) >= 0 && (r[key] as number) <= 4294967295, 'RECEIPT_EXIT_INVALID');\n  verificationInstant(r.startedAt); verificationInstant(r.finishedAt); verificationRequire(Date.parse(r.finishedAt) >= Date.parse(r.startedAt), 'RECEIPT_TIME_INVALID');\n  validateTrustedInvocationProof(r.owner, 'sf-verifier'); assets(r.assets); budget(r.budget);\n  verificationRequire(['passed','failed','not_executed','cancelled','interrupted'].includes(String(r.outcome)) && (r.failure === null || typeof r.failure === 'string'), 'RECEIPT_OUTCOME_INVALID');\n  if (r.outcome === 'passed') verificationRequire(r.processStarted && r.processResumed && r.exitCode === 0 && r.launcherExitCode === 0 && r.jobEnded && r.cleanupProved && r.outputComplete && r.nativeReceiptSha256 !== null && r.nativeEventsSha256 !== null && r.inspectionSha256 !== null && r.failure === null, 'PASSED_RECEIPT_INCOMPLETE');\n}\n\nexport function validateVerificationInvocationLease(value:unknown):asserts value is VerificationInvocationLeaseRecord {\n  const l=verificationRecord(value,['contract','planId','attemptId','reservationId','owner','startedAt','finishedAt','terminal','checks']);\n  verificationRequire(l.contract==='verification-invocation-lease/v1'&&typeof l.attemptId==='string'&&/^[a-f0-9]{32}$/.test(l.attemptId),'LEASE_IDENTITY_INVALID');\n  verificationHash(l.planId);verificationHash(l.reservationId);validateTrustedInvocationProof(l.owner,'sf-verifier');verificationInstant(l.startedAt);verificationInstant(l.finishedAt);\n  verificationRequire(Date.parse(l.finishedAt)>=Date.parse(l.startedAt)&&['completed','cancelled','lost'].includes(String(l.terminal))&&Array.isArray(l.checks)&&l.checks.length>=1&&l.checks.length<=361,'LEASE_SCHEMA_INVALID');\n  let previous=Date.parse(l.startedAt),lost=false;\n  for(const value of l.checks){\n    const c=verificationRecord(value,['observedAt','active','projectionSha256','reason']);verificationInstant(c.observedAt);\n    verificationRequire(!lost&&typeof c.active==='boolean'&&Date.parse(c.observedAt)>=previous&&Date.parse(c.observedAt)<=Date.parse(l.finishedAt),'LEASE_CHECK_TIME_INVALID');previous=Date.parse(c.observedAt);\n    if(c.active){verificationRequire(c.reason===null&&c.projectionSha256===(l.owner as TrustedToolInvocationProof).runtimeProjectionSha256,'LEASE_ACTIVE_PROOF_INVALID');}\n    else{verificationRequire(c.projectionSha256===null&&typeof c.reason==='string'&&/^[A-Z][A-Z_]{1,127}$/.test(c.reason),'LEASE_LOSS_INVALID');lost=true;}\n  }\n  verificationRequire(l.terminal==='lost'?lost:!lost,'LEASE_TERMINAL_INVALID');\n  if(l.terminal==='completed')verificationRequire(l.checks.length>=2,'LEASE_COMPLETION_PROOF_REQUIRED');\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\wal\\WAL.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·isCurrentRuntimeEvent,·RUNTIME_SCHEMA_DESCRIPTORS·` with `⏎··isCurrentRuntimeEvent,⏎··RUNTIME_SCHEMA_DESCRIPTORS,⏎`","line":6,"column":9,"nodeType":null,"messageId":"replace","endLine":6,"endColumn":60,"fix":{"range":[230,281],"text":"\n  isCurrentRuntimeEvent,\n  RUNTIME_SCHEMA_DESCRIPTORS,\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·return·await·pending;·}⏎····finally·{·if·(operations.get(key)·===·pending)·operations.delete(key);` with `⏎······return·await·pending;⏎····}·finally·{⏎······if·(operations.get(key)·===·pending)·operations.delete(key);⏎···`","line":30,"column":10,"nodeType":null,"messageId":"replace","endLine":31,"endColumn":75,"fix":{"range":[1266,1365],"text":"\n      return await pending;\n    } finally {\n      if (operations.get(key) === pending) operations.delete(key);\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·this.supportedCategories.add(category);` with `⏎····this.supportedCategories.add(category);⏎·`","line":34,"column":45,"nodeType":null,"messageId":"replace","endLine":34,"endColumn":85,"fix":{"range":[1417,1457],"text":"\n    this.supportedCategories.add(category);\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·······`","line":48,"column":71,"nodeType":null,"messageId":"insert","endLine":48,"endColumn":71,"fix":{"range":[2029,2029],"text":"\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·await·handle.sync();·}·finally·{·await·handle.close();` with `⏎········await·handle.sync();⏎······}·finally·{⏎········await·handle.close();⏎·····`","line":55,"column":12,"nodeType":null,"messageId":"replace","endLine":55,"endColumn":67,"fix":{"range":[2433,2488],"text":"\n        await handle.sync();\n      } finally {\n        await handle.close();\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `projectId:·string,·category:·string,` with `⏎····projectId:·string,⏎····category:·string,⏎···`","line":61,"column":15,"nodeType":null,"messageId":"replace","endLine":61,"endColumn":51,"fix":{"range":[2628,2664],"text":"\n    projectId: string,\n    category: string,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":62,"column":38,"nodeType":null,"messageId":"insert","endLine":62,"endColumn":38,"fix":{"range":[2718,2718],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎··`","line":63,"column":55,"nodeType":null,"messageId":"insert","endLine":63,"endColumn":55,"fix":{"range":[2791,2791],"text":"\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·console.warn(`[WAL]·Unknown·category·'${category}'·—·event·will·be·written·but·may·not·be·replayed`` with `⏎······console.warn(⏎········`[WAL]·Unknown·category·'${category}'·—·event·will·be·written·but·may·not·be·replayed`⏎······`","line":65,"column":49,"nodeType":null,"messageId":"replace","endLine":65,"endColumn":149,"fix":{"range":[2871,2971],"text":"\n      console.warn(\n        `[WAL] Unknown category '${category}' — event will be written but may not be replayed`\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·schema_version:·'1.0',·eventId:·uuidv7(),` with `⏎······schema_version:·'1.0',⏎······eventId:·uuidv7(),⏎·····`","line":66,"column":13,"nodeType":null,"messageId":"replace","endLine":66,"endColumn":55,"fix":{"range":[2986,3028],"text":"\n      schema_version: '1.0',\n      eventId: uuidv7(),\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·projectId,·actor,·category,·action,` with `⏎······projectId,⏎······actor,⏎······category,⏎······action,⏎·····`","line":67,"column":35,"nodeType":null,"messageId":"replace","endLine":67,"endColumn":71,"fix":{"range":[3079,3115],"text":"\n      projectId,\n      actor,\n      category,\n      action,\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `,⏎···`","line":68,"column":62,"nodeType":null,"messageId":"insert","endLine":68,"endColumn":62,"fix":{"range":[3186,3186],"text":",\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":84,"column":69,"nodeType":null,"messageId":"insert","endLine":84,"endColumn":69,"fix":{"range":[3886,3886],"text":"\n     "}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":92,"column":22,"nodeType":"TSNonNullExpression","messageId":"unnecessaryAssertion","endLine":92,"endColumn":35,"fix":{"range":[4353,4354],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·parsed·=·JSON.parse(line);·}` with `⏎··········parsed·=·JSON.parse(line);`","line":95,"column":14,"nodeType":null,"messageId":"replace","endLine":95,"endColumn":43,"fix":{"range":[4434,4463],"text":"\n          parsed = JSON.parse(line);"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `catch·{·throw·new·Error(`WAL_CORRUPT_INPUT:file=${file}:line=${index·+·1}`);` with `}·catch·{⏎··········throw·new·Error(`WAL_CORRUPT_INPUT:file=${file}:line=${index·+·1}`);⏎·······`","line":96,"column":9,"nodeType":null,"messageId":"replace","endLine":96,"endColumn":85,"fix":{"range":[4472,4548],"text":"} catch {\n          throw new Error(`WAL_CORRUPT_INPUT:file=${file}:line=${index + 1}`);\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·········`","line":97,"column":44,"nodeType":null,"messageId":"insert","endLine":97,"endColumn":44,"fix":{"range":[4594,4594],"text":"\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·········`","line":100,"column":54,"nodeType":null,"messageId":"insert","endLine":100,"endColumn":54,"fix":{"range":[4839,4839],"text":"\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":105,"column":62,"nodeType":null,"messageId":"insert","endLine":105,"endColumn":62,"fix":{"range":[5024,5024],"text":"\n     "}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":110,"column":12,"nodeType":"TSNonNullExpression","messageId":"unnecessaryAssertion","endLine":110,"endColumn":59,"fix":{"range":[5388,5389],"text":""}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":110,"column":12,"nodeType":"TSNonNullExpression","messageId":"unnecessaryAssertion","endLine":110,"endColumn":42,"fix":{"range":[5371,5372],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·······`","line":110,"column":72,"nodeType":null,"messageId":"insert","endLine":110,"endColumn":72,"fix":{"range":[5402,5402],"text":"\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·········`","line":113,"column":67,"nodeType":null,"messageId":"insert","endLine":113,"endColumn":67,"fix":{"range":[5638,5638],"text":"\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·······`","line":114,"column":73,"nodeType":null,"messageId":"insert","endLine":114,"endColumn":73,"fix":{"range":[5753,5753],"text":"\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·return·(await·this.readAllEvents()).events.at(-1)·??·null;` with `⏎····return·(await·this.readAllEvents()).events.at(-1)·??·null;⏎·`","line":125,"column":48,"nodeType":null,"messageId":"replace","endLine":125,"endColumn":107,"fix":{"range":[6225,6284],"text":"\n    return (await this.readAllEvents()).events.at(-1) ?? null;\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·return·this._lastSeq;` with `⏎····return·this._lastSeq;⏎·`","line":126,"column":28,"nodeType":null,"messageId":"replace","endLine":126,"endColumn":50,"fix":{"range":[6314,6336],"text":"\n    return this._lastSeq;\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·return·this.eventsPath;` with `⏎····return·this.eventsPath;⏎·`","line":127,"column":28,"nodeType":null,"messageId":"replace","endLine":127,"endColumn":52,"fix":{"range":[6366,6390],"text":"\n    return this.eventsPath;\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·return·this.schemaVersion;` with `⏎····return·this.schemaVersion;⏎·`","line":128,"column":31,"nodeType":null,"messageId":"replace","endLine":128,"endColumn":58,"fix":{"range":[6423,6450],"text":"\n    return this.schemaVersion;\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `path.dirname(this.eventsPath),·`events-${timestamp}-${uuidv7()}.jsonl.bak`` with `⏎······path.dirname(this.eventsPath),⏎······`events-${timestamp}-${uuidv7()}.jsonl.bak`⏎····`","line":137,"column":35,"nodeType":null,"messageId":"replace","endLine":137,"endColumn":109,"fix":{"range":[6824,6898],"text":"\n      path.dirname(this.eventsPath),\n      `events-${timestamp}-${uuidv7()}.jsonl.bak`\n    "}}],"suppressedMessages":[],"errorCount":29,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":29,"fixableWarningCount":0,"source":"/** Authoritative append-only event history, including retained rotation segments. */\nimport * as fs from 'fs/promises';\nimport * as path from 'path';\nimport { v7 as uuidv7 } from 'uuid';\nimport { Event } from '../types';\nimport { isCurrentRuntimeEvent, RUNTIME_SCHEMA_DESCRIPTORS } from '../state/runtime-schema-descriptors';\n\nconst WAL_MAX_SIZE = 5 * 1024 * 1024;\nconst ARCHIVE_NAME = /^events-\\d{4}-\\d\\d-\\d\\dT\\d\\d-\\d\\d-\\d\\d-\\d{3}Z(?:-[a-f0-9-]+)?\\.jsonl\\.bak$/;\nconst operations = new Map<string, Promise<unknown>>();\n\nexport interface ReadAllEventsResult {\n  events: Event[];\n  corruptedLines: Array<{ lineNumber: number; content: string; error: string }>;\n}\n\nexport class WAL {\n  private schemaVersion = '1.0';\n  private _lastSeq = 0;\n  private lastObservedId = '';\n  private supportedCategories = new Set(['state', 'session', 'system']);\n  constructor(private eventsPath: string) {}\n\n  private async serialized<T>(action: () => Promise<T>): Promise<T> {\n    const resolved = path.resolve(this.eventsPath);\n    const key = process.platform === 'win32' ? resolved.toLowerCase() : resolved;\n    const previous = operations.get(key) ?? Promise.resolve();\n    const pending = previous.catch(() => undefined).then(action);\n    operations.set(key, pending);\n    try { return await pending; }\n    finally { if (operations.get(key) === pending) operations.delete(key); }\n  }\n\n  registerCategory(category: string): void { this.supportedCategories.add(category); }\n\n  async initialize(): Promise<void> {\n    await this.serialized(async () => {\n      const { events } = await this.readHistory();\n      this._lastSeq = events.at(-1)?.monotonicSeq ?? 0;\n      await fs.mkdir(path.dirname(this.eventsPath), { recursive: true });\n    });\n  }\n\n  async appendEvent(event: Event): Promise<void> {\n    if (!isCurrentRuntimeEvent(event)) throw new Error('WAL_EVENT_SCHEMA_INVALID');\n    await this.serialized(async () => {\n      const { events } = await this.readHistory();\n      if (events.some(previous => previous.eventId === event.eventId)) throw new Error('WAL_DUPLICATE_EVENT');\n      // Sequence belongs to durable insertion order, not reservation/caller order.\n      event.monotonicSeq = (events.at(-1)?.monotonicSeq ?? 0) + 1;\n      const line = JSON.stringify(event) + '\\n';\n      await this.rotateIfNeeded();\n      await fs.appendFile(this.eventsPath, line, 'utf-8');\n      const handle = await fs.open(this.eventsPath, 'a');\n      try { await handle.sync(); } finally { await handle.close(); }\n      this._lastSeq = Math.max(this._lastSeq, event.monotonicSeq);\n      this.lastObservedId = event.eventId;\n    });\n  }\n\n  createEvent(projectId: string, category: string, action: string,\n    payload: Record<string, unknown>, actor = 'system',\n    source: 'daemon' | 'client' | 'adapter' = 'daemon'): Event {\n    this._lastSeq++;\n    if (!this.supportedCategories.has(category)) console.warn(`[WAL] Unknown category '${category}' — event will be written but may not be replayed`);\n    return { schema_version: '1.0', eventId: uuidv7(), ts: Date.now(),\n      monotonicSeq: this._lastSeq, projectId, actor, category, action, payload,\n      metadata: { schemaVersion: this.schemaVersion, source } };\n  }\n\n  /** Every read validates every segment; no malformed record is silently skipped. */\n  async readAllEvents(): Promise<ReadAllEventsResult> {\n    return this.serialized(() => this.readHistory());\n  }\n\n  private async readHistory(): Promise<ReadAllEventsResult> {\n    const dir = path.dirname(this.eventsPath);\n    const names = await fs.readdir(dir).catch((error: NodeJS.ErrnoException) => {\n      if (error.code === 'ENOENT') return [] as string[];\n      throw error;\n    });\n    const archives = names.filter(name => ARCHIVE_NAME.test(name)).sort();\n    const hasCurrent = names.includes(path.basename(this.eventsPath));\n    if (!hasCurrent && (archives.length > 0 || this.lastObservedId)) throw new Error('WAL_HISTORY_MISSING');\n    const events: Event[] = [];\n    const ids = new Set<string>();\n    for (const file of [...archives, ...(hasCurrent ? [path.basename(this.eventsPath)] : [])]) {\n      const bytes = await fs.readFile(path.join(dir, file), 'utf-8');\n      if (!bytes.trim()) throw new Error('WAL_EMPTY_INPUT');\n      const lines = bytes.split('\\n');\n      for (let index = 0; index < lines.length; index++) {\n        const line = lines[index]!;\n        if (!line.trim()) continue;\n        let parsed: unknown;\n        try { parsed = JSON.parse(line); }\n        catch { throw new Error(`WAL_CORRUPT_INPUT:file=${file}:line=${index + 1}`); }\n        if (!isCurrentRuntimeEvent(parsed)) throw new Error(`WAL_EVENT_SCHEMA_INVALID:file=${file}:line=${index + 1}`);\n        const event = parsed as Event;\n        if (ids.has(event.eventId)) throw new Error('WAL_DUPLICATE_EVENT');\n        if (event.monotonicSeq !== events.length + 1) throw new Error('WAL_HISTORY_SEQUENCE_INVALID');\n        ids.add(event.eventId);\n        events.push(event);\n      }\n    }\n    if (this.lastObservedId && !ids.has(this.lastObservedId)) throw new Error('WAL_HISTORY_TRUNCATED');\n    // A persisted cursor proves this is not a fresh project, including when\n    // read/append is invoked by recovery or session owners without StateManager.\n    try {\n      const checkpoint = JSON.parse(await fs.readFile(path.join(dir, 'state.json'), 'utf-8'));\n      if (!RUNTIME_SCHEMA_DESCRIPTORS[0]!.validateCurrent!(checkpoint)) throw new Error('WAL_CHECKPOINT_INVALID');\n      if (checkpoint.lastEventId) {\n        const witnessed = events.find(event => event.eventId === checkpoint.lastEventId);\n        if (!witnessed || witnessed.ts !== checkpoint.lastEventTs) throw new Error('WAL_HISTORY_TRUNCATED');\n      } else if (checkpoint.workItems.length > 0 && events.length === 0) throw new Error('WAL_HISTORY_MISSING');\n    } catch (error) {\n      if ((error as NodeJS.ErrnoException).code !== 'ENOENT') throw error;\n    }\n    if (events.length) this.lastObservedId = events.at(-1)!.eventId;\n    return { events, corruptedLines: [] };\n  }\n\n  async readEventsByCategory(category: string): Promise<Event[]> {\n    return (await this.readAllEvents()).events.filter(event => event.category === category);\n  }\n  async getLastEvent(): Promise<Event | null> { return (await this.readAllEvents()).events.at(-1) ?? null; }\n  getCurrentSeq(): number { return this._lastSeq; }\n  getEventsPath(): string { return this.eventsPath; }\n  getSchemaVersion(): string { return this.schemaVersion; }\n\n  private async rotateIfNeeded(): Promise<void> {\n    const stat = await fs.stat(this.eventsPath).catch((error: NodeJS.ErrnoException) => {\n      if (error.code === 'ENOENT') return null;\n      throw error;\n    });\n    if (!stat || stat.size < WAL_MAX_SIZE) return;\n    const timestamp = new Date().toISOString().replace(/[:.]/g, '-');\n    const archivePath = path.join(path.dirname(this.eventsPath), `events-${timestamp}-${uuidv7()}.jsonl.bak`);\n    await fs.rename(this.eventsPath, archivePath);\n    // Segments are authoritative history, not disposable observability logs.\n    // Retain every segment; interrupted rotation is rejected, never treated as new.\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\wal\\index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]}]}
