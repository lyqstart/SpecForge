],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·input.fromState,·input.toState,·input.actorRole,` with `⏎····input.fromState,⏎····input.toState,⏎····input.actorRole,⏎···`","line":336,"column":22,"nodeType":null,"messageId":"replace","endLine":336,"endColumn":71,"fix":{"range":[15257,15306],"text":"\n    input.fromState,\n    input.toState,\n    input.actorRole,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·evidence:·input.evidence,·transition_context:·{·source:·'state_coordinator_v11',·...(input.transitionContext·??·{})·}·},` with `⏎······evidence:·input.evidence,⏎······transition_context:·{·source:·'state_coordinator_v11',·...(input.transitionContext·??·{})·},⏎····}`","line":337,"column":6,"nodeType":null,"messageId":"replace","endLine":337,"endColumn":127,"fix":{"range":[15332,15453],"text":"\n      evidence: input.evidence,\n      transition_context: { source: 'state_coordinator_v11', ...(input.transitionContext ?? {}) },\n    }"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·advanced:·true,·from_state:·input.fromState,·to_state:·input.toState,` with `⏎····advanced:·true,⏎····from_state:·input.fromState,⏎····to_state:·input.toState,⏎···`","line":340,"column":21,"nodeType":null,"messageId":"replace","endLine":340,"endColumn":91,"fix":{"range":[15490,15560],"text":"\n    advanced: true,\n    from_state: input.fromState,\n    to_state: input.toState,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·workItemId:·input.workItemId,` with `⏎······workItemId:·input.workItemId,⏎·····`","line":342,"column":30,"nodeType":null,"messageId":"replace","endLine":342,"endColumn":60,"fix":{"range":[15641,15671],"text":"\n      workItemId: input.workItemId,\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":343,"column":35,"nodeType":null,"messageId":"insert","endLine":343,"endColumn":35,"fix":{"range":[15738,15738],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":362,"column":103,"nodeType":null,"messageId":"delete","endLine":362,"endColumn":104,"fix":{"range":[16362,16363],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":379,"column":96,"nodeType":null,"messageId":"delete","endLine":379,"endColumn":97,"fix":{"range":[16884,16885],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎····`","line":384,"column":7,"nodeType":null,"messageId":"insert","endLine":384,"endColumn":7,"fix":{"range":[17052,17052],"text":"\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `··!/^[0-9a-f]{64}$/.test(String(archive?.manifest_sha256·??·''))` with `!/^[0-9a-f]{64}$/.test(String(archive?.manifest_sha256·??·''))⏎··`","line":385,"column":5,"nodeType":null,"messageId":"replace","endLine":385,"endColumn":69,"fix":{"range":[17152,17216],"text":"!/^[0-9a-f]{64}$/.test(String(archive?.manifest_sha256 ?? ''))\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED:·immutable·generation·archive·is·required'` with `⏎······'STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED:·immutable·generation·archive·is·required'⏎····`","line":386,"column":21,"nodeType":null,"messageId":"replace","endLine":386,"endColumn":106,"fix":{"range":[17240,17325],"text":"\n      'STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED: immutable generation archive is required'\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED:·generation·archive·manifest·is·not·a·regular·file'` with `⏎······'STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED:·generation·archive·manifest·is·not·a·regular·file'⏎····`","line":391,"column":21,"nodeType":null,"messageId":"replace","endLine":391,"endColumn":115,"fix":{"range":[17576,17670],"text":"\n      'STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED: generation archive manifest is not a regular file'\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·generation_id?:·string;·files?:·Array<{·path:·string;·size:·number;·sha256:·string·}>` with `⏎····generation_id?:·string;⏎····files?:·Array<{·path:·string;·size:·number;·sha256:·string·}>;⏎·`","line":397,"column":18,"nodeType":null,"messageId":"replace","endLine":397,"endColumn":104,"fix":{"range":[17961,18047],"text":"\n    generation_id?: string;\n    files?: Array<{ path: string; size: number; sha256: string }>;\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·archived·=·JSON.parse(archiveManifest.toString('utf-8'));·}⏎··catch·{·throw·new·Error('STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED:·generation·archive·manifest·invalid');` with `⏎····archived·=·JSON.parse(archiveManifest.toString('utf-8'));⏎··}·catch·{⏎····throw·new·Error(⏎······'STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED:·generation·archive·manifest·invalid'⏎····);⏎·`","line":398,"column":8,"nodeType":null,"messageId":"replace","endLine":399,"endColumn":109,"fix":{"range":[18058,18227],"text":"\n    archived = JSON.parse(archiveManifest.toString('utf-8'));\n  } catch {\n    throw new Error(\n      'STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED: generation archive manifest invalid'\n    );\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎····`","line":400,"column":7,"nodeType":null,"messageId":"insert","endLine":400,"endColumn":7,"fix":{"range":[18236,18236],"text":"\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":401,"column":5,"nodeType":null,"messageId":"delete","endLine":401,"endColumn":7,"fix":{"range":[18292,18294],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `······!archived.files.some(file·=>·file.path·===·'gates/close_gate.json')` with `····!archived.files.some(file·=>·file.path·===·'gates/close_gate.json')⏎··`","line":402,"column":1,"nodeType":null,"messageId":"replace","endLine":402,"endColumn":74,"fix":{"range":[18328,18401],"text":"    !archived.files.some(file => file.path === 'gates/close_gate.json')\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED:·generation·archive·identity·invalid'` with `⏎······'STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED:·generation·archive·identity·invalid'⏎····`","line":403,"column":21,"nodeType":null,"messageId":"replace","endLine":403,"endColumn":101,"fix":{"range":[18425,18505],"text":"\n      'STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED: generation archive identity invalid'\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED:·generation·archive·file·path·invalid'` with `⏎········'STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED:·generation·archive·file·path·invalid'⏎······`","line":409,"column":23,"nodeType":null,"messageId":"replace","endLine":409,"endColumn":104,"fix":{"range":[18810,18891],"text":"\n        'STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED: generation archive file path invalid'\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED:·generation·archive·file·is·not·regular'` with `⏎········'STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED:·generation·archive·file·is·not·regular'⏎······`","line":414,"column":23,"nodeType":null,"messageId":"replace","endLine":414,"endColumn":106,"fix":{"range":[19103,19186],"text":"\n        'STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED: generation archive file is not regular'\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎······`","line":417,"column":9,"nodeType":null,"messageId":"insert","endLine":417,"endColumn":9,"fix":{"range":[19254,19254],"text":"\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `········createHash('sha256').update(bytes).digest('hex')·!==·file.sha256` with `······createHash('sha256').update(bytes).digest('hex')·!==·file.sha256⏎····`","line":418,"column":1,"nodeType":null,"messageId":"replace","endLine":418,"endColumn":73,"fix":{"range":[19288,19360],"text":"      createHash('sha256').update(bytes).digest('hex') !== file.sha256\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":430,"column":113,"nodeType":null,"messageId":"delete","endLine":430,"endColumn":114,"fix":{"range":[19923,19924],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":448,"column":6,"nodeType":null,"messageId":"delete","endLine":448,"endColumn":7,"fix":{"range":[20344,20345],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":479,"column":92,"nodeType":null,"messageId":"delete","endLine":479,"endColumn":93,"fix":{"range":[21170,21171],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":484,"column":115,"nodeType":null,"messageId":"delete","endLine":484,"endColumn":116,"fix":{"range":[21364,21365],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":495,"column":92,"nodeType":null,"messageId":"delete","endLine":495,"endColumn":93,"fix":{"range":[21752,21753],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":506,"column":125,"nodeType":null,"messageId":"delete","endLine":506,"endColumn":126,"fix":{"range":[22227,22228],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":527,"column":6,"nodeType":null,"messageId":"delete","endLine":527,"endColumn":7,"fix":{"range":[22881,22882],"text":""}}],"suppressedMessages":[],"errorCount":95,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":91,"fixableWarningCount":0,"source":"import { SPEC_DIR_NAME } from \"@specforge/types/directory-layout\";\n/**\n * state-coordinator-v11.ts — SpecForge v1.1.3 state authority coordinator\n *\n * StateManager / events.jsonl is the authoritative state source.\n * runtime/state.json is a projection cache.\n * work_item.json is WI metadata and must not drive governance state.\n * MUST NOT call workflowEngine.transitionFull()\n */\nimport * as fs from 'node:fs/promises';\nimport * as path from 'node:path';\nimport { createHash } from 'node:crypto';\nimport {\n  WI_STATUSES_V11,\n  isForbiddenTransition,\n  isValidV11TransitionForWorkflow,\n  checkStateEvidenceRequirement,\n} from './state-machine-v11';\nimport { isSealTransition, getSealTransition } from '@specforge/types/seal-transitions';\nimport { ACTOR_ROLES } from '@specforge/types/actor-roles';\nimport { validateCurrentCandidateManifestValue } from '@specforge/types';\nimport { validateSemanticClosureProvenance } from './semantic-closure-provenance';\nimport { verifyInvalidMergedSpecRecoveryAuthorization } from './invalid-merged-spec-closure-recovery.js';\n\nexport type AuthoritativeStateRead = {\n  current_state: string | null;\n  source: 'StateManager' | 'missing';\n  rebuilt_from_events: boolean;\n};\nexport type TransitionWithEvidenceInput = {\n  deps: any;\n  context?: any;\n  projectRoot: string;\n  workItemId: string;\n  workItemDir: string;\n  fromState: string;\n  toState: string;\n  workflowType: string;\n  actorRole: string;\n  evidence: string;\n  transitionContext?: Record<string, unknown>;\n};\nexport type TransitionWithEvidenceResult = {\n  attempted: true;\n  advanced: true;\n  from_state: string;\n  to_state: string;\n  evidence: string;\n  transition_result: {\n    source: 'StateManager';\n    workItemId: string;\n    previousState: string;\n    currentState: string;\n    timestamp: string;\n  };\n};\n\nfunction normalizeState(value: unknown): string | null {\n  if (typeof value === 'string' && value.length > 0) return value;\n  if (value && typeof value === 'object') {\n    const obj = value as Record<string, unknown>;\n    if (typeof obj.current_state === 'string') return obj.current_state;\n    if (typeof obj.currentState === 'string') return obj.currentState;\n    if (typeof obj.status === 'string') return obj.status;\n    if (typeof obj.state === 'string') return obj.state;\n  }\n  return null;\n}\nasync function ensureFileExists(filePath: string, description: string): Promise<void> {\n  try { await fs.access(filePath); }\n  catch { throw new Error(`${description} missing: ${path.basename(filePath)}`); }\n}\n\nexport function isCanonicalNoCodeVerificationCandidateManifest(input: {\n  manifest: Record<string, unknown>;\n  workItemId: string;\n  workflowType: string;\n}): boolean {\n  const manifest = input.manifest;\n  if (!validateCurrentCandidateManifestValue(manifest, input.workItemId).valid) {\n    return false;\n  }\n  const integrationEffect = manifest.project_integration_effect;\n  const entries = manifest.entries;\n  if (input.workflowType === 'investigation') {\n    return manifest.workflow_type === 'investigation' &&\n      manifest.no_project_spec_change === true &&\n      typeof integrationEffect === 'string' &&\n      integrationEffect.trim().toLowerCase() === 'evidence_only' &&\n      manifest.merge_required === false &&\n      manifest.merge_applicable === false &&\n      Array.isArray(entries) &&\n      entries.length === 0;\n  }\n  if (input.workflowType === 'contract_change') {\n    return manifest.workflow_type === 'contract_change' &&\n      manifest.workflow_path === 'contract_change_path' &&\n      manifest.merge_required === true &&\n      Array.isArray(entries) &&\n      entries.length > 0 &&\n      entries.every(entry => entry && typeof entry === 'object' &&\n        String((entry as Record<string, unknown>).target_path ?? '').replace(/\\\\/g, '/')\n          .endsWith((`${SPEC_DIR_NAME}/project/extension_registry.json` as const)));\n  }\n  if (input.workflowType === 'spec_migration') {\n    const baseSpecVersion = manifest.base_spec_version;\n    const precondition = manifest.project_spec_precondition_sha256;\n    const repairEvidencePaths = manifest.repair_evidence_paths;\n    return manifest.work_item_id === input.workItemId &&\n      manifest.workflow_type === 'spec_migration' &&\n      manifest.workflow_path === 'spec_migration_path' &&\n      typeof baseSpecVersion === 'string' &&\n      /^PSV-[0-9]{4,}$/.test(baseSpecVersion) &&\n      typeof precondition === 'string' &&\n      /^sha256:[0-9a-f]{64}$/i.test(precondition) &&\n      Array.isArray(repairEvidencePaths) &&\n      repairEvidencePaths.length > 0 &&\n      repairEvidencePaths.every(value =>\n        typeof value === 'string' &&\n        value.startsWith((`${SPEC_DIR_NAME}/project/` as const)) &&\n        !value.split('/').includes('..')\n      ) &&\n      manifest.merge_required === true &&\n      Array.isArray(entries) &&\n      entries.length > 0 &&\n      entries.every(entry => {\n        if (!entry || typeof entry !== 'object' || Array.isArray(entry)) return false;\n        const record = entry as Record<string, unknown>;\n        const candidatePath = String(record.candidate_path ?? '').replace(/\\\\/g, '/');\n        const targetPath = String(record.target_path ?? '').replace(/\\\\/g, '/');\n        return record.operation === 'replace' &&\n          candidatePath.startsWith('candidates/') &&\n          !candidatePath.split('/').includes('..') &&\n          targetPath.startsWith((`${SPEC_DIR_NAME}/project/` as const)) &&\n          !targetPath.split('/').includes('..');\n      });\n  }\n  return false;\n}\nasync function assertNoCodeVerificationTransition(input: TransitionWithEvidenceInput): Promise<void> {\n  if (input.fromState !== 'post_merge_verified' || input.toState !== 'verification_running') return;\n  if (!['investigation', 'contract_change', 'spec_migration'].includes(input.workflowType)) {\n    throw new Error('STATE_COORDINATOR_TRANSITION_FAILED: post_merge_verified → verification_running is reserved for no-code verification workflows');\n  }\n  const manifestPath = path.join(input.workItemDir, 'candidate_manifest.json');\n  let manifest: Record<string, unknown>;\n  try { manifest = JSON.parse(await fs.readFile(manifestPath, 'utf-8')) as Record<string, unknown>; }\n  catch { throw new Error('STATE_COORDINATOR_TRANSITION_FAILED: no-code verification requires valid candidate_manifest.json'); }\n  if (!isCanonicalNoCodeVerificationCandidateManifest({\n    manifest,\n    workItemId: input.workItemId,\n    workflowType: input.workflowType,\n  })) {\n    throw new Error('STATE_COORDINATOR_TRANSITION_FAILED: no-code verification requires a canonical workflow-specific candidate manifest');\n  }\n}\n\nasync function assertSpecMigrationVerificationRecoveryTransition(\n  input: TransitionWithEvidenceInput,\n): Promise<void> {\n  if (input.fromState !== 'verification_done' || input.toState !== 'post_merge_verified') return;\n  if (input.workflowType !== 'spec_migration') {\n    throw new Error(\n      'STATE_COORDINATOR_TRANSITION_FAILED: verification_done → post_merge_verified is reserved for workflow_type=spec_migration',\n    );\n  }\n\n  const manifestPath = path.join(input.workItemDir, 'candidate_manifest.json');\n  let manifest: Record<string, unknown>;\n  try {\n    manifest = JSON.parse(await fs.readFile(manifestPath, 'utf-8')) as Record<string, unknown>;\n  } catch {\n    throw new Error(\n      'STATE_COORDINATOR_TRANSITION_FAILED: spec_migration verification recovery requires valid candidate_manifest.json',\n    );\n  }\n  if (!isCanonicalNoCodeVerificationCandidateManifest({\n    manifest,\n    workItemId: input.workItemId,\n    workflowType: input.workflowType,\n  })) {\n    throw new Error(\n      'STATE_COORDINATOR_TRANSITION_FAILED: spec_migration verification recovery requires the frozen canonical candidate manifest',\n    );\n  }\n\n  const closurePath = path.join(input.workItemDir, '.semantic_closure.json');\n  let closure: Record<string, unknown> | null = null;\n  try {\n    closure = JSON.parse(await fs.readFile(closurePath, 'utf-8')) as Record<string, unknown>;\n  } catch {\n    closure = null;\n  }\n  if (!closure) {\n    throw new Error(\n      'STATE_COORDINATOR_TRANSITION_FAILED: spec_migration verification recovery requires an existing semantic closure',\n    );\n  }\n\n  const provenance = await validateSemanticClosureProvenance(input.workItemDir, closure as any);\n  if (provenance.passed) {\n    throw new Error(\n      'STATE_COORDINATOR_TRANSITION_FAILED: spec_migration verification recovery is not allowed while semantic closure provenance is current',\n    );\n  }\n  if (\n    provenance.errors.length === 0 ||\n    provenance.errors.some(error => !error.startsWith('SEMANTIC_CLOSURE_INPUT_STALE:'))\n  ) {\n    throw new Error(\n      'STATE_COORDINATOR_TRANSITION_FAILED: spec_migration verification recovery only accepts stale governed input provenance',\n    );\n  }\n}\n\nasync function assertFormalVersionBeforeClose(input: TransitionWithEvidenceInput): Promise<void> {\n  if (input.fromState !== 'verification_done' || input.toState !== 'closed') return;\n\n  // Rollout compatibility: Formal Version Gate is mandatory for Work Items\n  // created under the Architecture Consistency governance contract. Older WIs\n  // do not have Impact Scope and must remain closable while the project is\n  // bootstrapped through spec_migration. Investigation/rollback are not version\n  // publication workflows and therefore do not require this gate.\n  if (input.workflowType === 'investigation' || input.workflowType === 'rollback') return;\n\n  let triggerResult: any = null;\n  try {\n    triggerResult = JSON.parse(\n      await fs.readFile(path.join(input.workItemDir, 'trigger_result.json'), 'utf-8'),\n    );\n  } catch {\n    triggerResult = null;\n  }\n  let governanceScope: any = null;\n  let gitContext: any = null;\n  try {\n    governanceScope = JSON.parse(\n      await fs.readFile(path.join(input.workItemDir, 'governance_scope.json'), 'utf-8'),\n    );\n  } catch {\n    governanceScope = null;\n  }\n  try {\n    gitContext = JSON.parse(\n      await fs.readFile(path.join(input.workItemDir, 'git_context.json'), 'utf-8'),\n    );\n  } catch {\n    gitContext = null;\n  }\n  const governedByFormalVersionContract =\n    (triggerResult?.impact_scope &&\n      typeof triggerResult.impact_scope === 'object' &&\n      !Array.isArray(triggerResult.impact_scope)) ||\n    governanceScope?.active === true ||\n    gitContext?.git_enabled === true;\n  if (!governedByFormalVersionContract) return;\n\n  const reportPath = path.join(input.workItemDir, 'gates', 'formal_version_gate.json');\n  let report: any = null;\n  try { report = JSON.parse(await fs.readFile(reportPath, 'utf-8')); } catch { report = null; }\n  if (report?.status !== 'passed') {\n    throw new Error('STATE_COORDINATOR_TRANSITION_FAILED: formal_version_gate must pass before verification_done → closed');\n  }\n}\n\nasync function validateTransitionRequest(input: TransitionWithEvidenceInput): Promise<void> {\n  if (!input.workItemId) throw new Error('STATE_COORDINATOR_TRANSITION_FAILED: workItemId is required');\n  if (!(WI_STATUSES_V11 as readonly string[]).includes(input.toState)) {\n    throw new Error(`STATE_COORDINATOR_TRANSITION_FAILED: invalid target state \"${input.toState}\"`);\n  }\n  if (input.fromState !== '' && !(WI_STATUSES_V11 as readonly string[]).includes(input.fromState)) {\n    throw new Error(`STATE_COORDINATOR_TRANSITION_FAILED: invalid from_state \"${input.fromState}\"`);\n  }\n  if (input.fromState !== '' && isForbiddenTransition(input.fromState, input.toState)) {\n    throw new Error(`STATE_COORDINATOR_TRANSITION_FAILED: forbidden transition ${input.fromState} → ${input.toState}`);\n  }\n  if (\n    input.fromState !== '' &&\n    !isValidV11TransitionForWorkflow(input.fromState, input.toState, input.workflowType)\n  ) {\n    throw new Error(`STATE_COORDINATOR_TRANSITION_FAILED: invalid transition ${input.fromState} → ${input.toState}`);\n  }\n  if (input.fromState === 'intake_ready' && input.toState === 'candidate_preparing' && input.workflowType !== 'contract_change') {\n    throw new Error('STATE_COORDINATOR_TRANSITION_FAILED: intake_ready → candidate_preparing is reserved for workflow_type=contract_change');\n  }\n  if (input.fromState === 'approved' && input.toState === 'blocked') {\n    const source = input.transitionContext?.source;\n    if (input.actorRole !== ACTOR_ROLES.userDecisionRecorder || source !== 'approval_invalidation') {\n      throw new Error(\"STATE_COORDINATOR_TRANSITION_FAILED: approved → blocked is reserved for the atomic approval-invalidation flow\");\n    }\n    await ensureFileExists(path.join(input.workItemDir, 'approval_invalidation.json'), 'STATE_COORDINATOR_TRANSITION_FAILED: approval invalidation evidence');\n  }\n\n  await assertNoCodeVerificationTransition(input);\n  await assertSpecMigrationVerificationRecoveryTransition(input);\n  await assertFormalVersionBeforeClose(input);\n\n  if (input.fromState !== '' && isSealTransition(input.fromState, input.toState)) {\n    const sealEntry = getSealTransition(input.fromState, input.toState);\n    if (sealEntry && input.actorRole !== sealEntry.authorizedSubject) {\n      throw new Error(`STATE_COORDINATOR_TRANSITION_FAILED: seal transition ${input.fromState} → ${input.toState} requires actor '${sealEntry.authorizedSubject}', got '${input.actorRole || 'none'}'`);\n    }\n    if (sealEntry?.evidenceRequired) {\n      await ensureFileExists(path.join(input.workItemDir, sealEntry.evidenceRequired), `STATE_COORDINATOR_TRANSITION_FAILED: seal transition evidence for ${input.fromState} → ${input.toState}`);\n    }\n  }\n  const evidenceResult = await checkStateEvidenceRequirement(input.toState, input.workItemDir);\n  if (!evidenceResult.met) {\n    throw new Error(`STATE_COORDINATOR_TRANSITION_FAILED: evidence requirement not met for ${input.toState}. Missing: ${evidenceResult.missing}. ${evidenceResult.description ?? ''}`.trim());\n  }\n}\n\nexport async function readAuthoritativeState(input: { deps: any; projectRoot: string; workItemId: string; }): Promise<AuthoritativeStateRead> {\n  const projectManager = input.deps?.projectManager;\n  if (!projectManager?.getProjectStateManager) return { current_state: null, source: 'missing', rebuilt_from_events: false };\n  const projectSm = await projectManager.getProjectStateManager(input.projectRoot);\n  let rebuilt = false;\n  if (typeof projectSm?.rebuildState === 'function') {\n    await projectSm.rebuildState();\n    const eventCount = typeof projectSm?.getLastReplayedEventCount === 'function'\n      ? projectSm.getLastReplayedEventCount()\n      : 0;\n    rebuilt = Number.isFinite(eventCount) && eventCount > 0;\n  }\n  if (typeof projectSm?.getState === 'function') {\n    const state = normalizeState(await projectSm.getState(input.workItemId));\n    if (state) return { current_state: state, source: 'StateManager', rebuilt_from_events: rebuilt };\n  }\n  return { current_state: null, source: 'missing', rebuilt_from_events: rebuilt };\n}\nexport async function transitionWithEvidence(input: TransitionWithEvidenceInput): Promise<TransitionWithEvidenceResult> {\n  if (!input.deps?.projectManager) throw new Error('STATE_COORDINATOR_TRANSITION_FAILED: ProjectManager not available');\n  await validateTransitionRequest(input);\n  const projectSm = await input.deps.projectManager.getProjectStateManager(input.projectRoot);\n  await projectSm.transition(\n    input.workItemId, input.fromState, input.toState, input.actorRole, input.workflowType,\n    { evidence: input.evidence, transition_context: { source: 'state_coordinator_v11', ...(input.transitionContext ?? {}) } },\n  );\n  return {\n    attempted: true, advanced: true, from_state: input.fromState, to_state: input.toState, evidence: input.evidence,\n    transition_result: {\n      source: 'StateManager', workItemId: input.workItemId, previousState: input.fromState,\n      currentState: input.toState, timestamp: new Date().toISOString(),\n    },\n  };\n}\n\nexport async function recoverInvalidClosureWithEvidence(input: {\n  deps: any;\n  projectRoot: string;\n  workItemId: string;\n  workItemDir: string;\n  workflowType: string;\n  evidence: string;\n  invalidityReasons: string[];\n}): Promise<TransitionWithEvidenceResult> {\n  if (!input.deps?.projectManager) {\n    throw new Error('STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED: ProjectManager not available');\n  }\n  if (input.invalidityReasons.length === 0) {\n    throw new Error(\n      'STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED: at least one verified invalidity reason is required',\n    );\n  }\n\n  const recoveryPath = path.join(input.workItemDir, 'closure_recovery.json');\n  let recovery: any = null;\n  try {\n    recovery = JSON.parse(await fs.readFile(recoveryPath, 'utf-8'));\n  } catch {\n    recovery = null;\n  }\n  if (\n    recovery?.work_item_id !== input.workItemId ||\n    recovery?.recovery_action !== 'closed_to_implementation_ready' ||\n    recovery?.status !== 'authorized'\n  ) {\n    throw new Error(\n      'STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED: authorized closure_recovery.json is required',\n    );\n  }\n  const archive = recovery?.prior_evidence?.generation_archive;\n  const manifestRelative = String(archive?.manifest_path ?? '').replace(/\\\\/g, '/');\n  if (!/^recovery_generations\\/invalid-closure-[0-9a-f-]+\\/manifest\\.json$/.test(manifestRelative) ||\n      !/^[0-9a-f]{64}$/.test(String(archive?.manifest_sha256 ?? ''))) {\n    throw new Error('STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED: immutable generation archive is required');\n  }\n  const archiveManifestPath = path.join(input.workItemDir, manifestRelative);\n  const archiveManifestStat = await fs.lstat(archiveManifestPath);\n  if (!archiveManifestStat.isFile() || archiveManifestStat.isSymbolicLink()) {\n    throw new Error('STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED: generation archive manifest is not a regular file');\n  }\n  const archiveManifest = await fs.readFile(archiveManifestPath);\n  if (createHash('sha256').update(archiveManifest).digest('hex') !== archive.manifest_sha256) {\n    throw new Error('STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED: generation archive manifest drift');\n  }\n  let archived: { generation_id?: string; files?: Array<{ path: string; size: number; sha256: string }> };\n  try { archived = JSON.parse(archiveManifest.toString('utf-8')); }\n  catch { throw new Error('STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED: generation archive manifest invalid'); }\n  if (archived.generation_id !== archive.generation_id ||\n      !Array.isArray(archived.files) ||\n      !archived.files.some(file => file.path === 'gates/close_gate.json')) {\n    throw new Error('STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED: generation archive identity invalid');\n  }\n  const archiveRoot = path.dirname(path.join(input.workItemDir, manifestRelative));\n  for (const file of archived.files) {\n    const relative = String(file.path ?? '').replace(/\\\\/g, '/');\n    if (!relative || relative.startsWith('/') || relative.split('/').includes('..')) {\n      throw new Error('STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED: generation archive file path invalid');\n    }\n    const archivedPath = path.join(archiveRoot, relative);\n    const archivedStat = await fs.lstat(archivedPath);\n    if (!archivedStat.isFile() || archivedStat.isSymbolicLink()) {\n      throw new Error('STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED: generation archive file is not regular');\n    }\n    const bytes = await fs.readFile(archivedPath);\n    if (bytes.byteLength !== file.size ||\n        createHash('sha256').update(bytes).digest('hex') !== file.sha256) {\n      throw new Error('STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED: generation archive file drift');\n    }\n  }\n\n  const projectSm = await input.deps.projectManager.getProjectStateManager(input.projectRoot);\n  if (typeof projectSm?.rebuildFromEventsFile === 'function') {\n    await projectSm.rebuildFromEventsFile();\n  }\n  const current = normalizeState(await projectSm.getState(input.workItemId));\n  if (current !== 'closed') {\n    throw new Error(\n      `STATE_COORDINATOR_CLOSURE_RECOVERY_FAILED: expected authoritative state closed, got ${current ?? 'null'}`,\n    );\n  }\n\n  await projectSm.transition(\n    input.workItemId,\n    'closed',\n    'implementation_ready',\n    ACTOR_ROLES.closeGate,\n    input.workflowType,\n    {\n      evidence: input.evidence,\n      transition_context: {\n        source: 'closure_invalidation',\n        recovery_record: 'closure_recovery.json',\n        invalidity_reasons: input.invalidityReasons,\n        compensating_transition: true,\n      },\n    },\n  );\n\n  return {\n    attempted: true,\n    advanced: true,\n    from_state: 'closed',\n    to_state: 'implementation_ready',\n    evidence: input.evidence,\n    transition_result: {\n      source: 'StateManager',\n      workItemId: input.workItemId,\n      previousState: 'closed',\n      currentState: 'implementation_ready',\n      timestamp: new Date().toISOString(),\n    },\n  };\n}\n\nexport async function recoverInvalidMergedSpecClosureWithEvidence(input: {\n  deps: any;\n  projectRoot: string;\n  workItemId: string;\n  workItemDir: string;\n  workflowType: string;\n  evidence: string;\n  invalidityReasons: string[];\n  generationId: string;\n}): Promise<TransitionWithEvidenceResult> {\n  if (!input.deps?.projectManager) {\n    throw new Error(\n      'STATE_COORDINATOR_INVALID_MERGED_SPEC_RECOVERY_FAILED: ProjectManager not available',\n    );\n  }\n  if (input.invalidityReasons.length === 0) {\n    throw new Error(\n      'STATE_COORDINATOR_INVALID_MERGED_SPEC_RECOVERY_FAILED: at least one verified invalidity reason is required',\n    );\n  }\n\n  const recovery = await verifyInvalidMergedSpecRecoveryAuthorization({\n    projectRoot: input.projectRoot,\n    workItemDir: input.workItemDir,\n    workItemId: input.workItemId,\n  });\n  if (String(recovery.archive?.generation_id ?? '') !== input.generationId) {\n    throw new Error(\n      'STATE_COORDINATOR_INVALID_MERGED_SPEC_RECOVERY_FAILED: recovery generation mismatch',\n    );\n  }\n\n  const projectSm = await input.deps.projectManager.getProjectStateManager(input.projectRoot);\n  if (typeof projectSm?.rebuildFromEventsFile === 'function') {\n    await projectSm.rebuildFromEventsFile();\n  }\n  const current = normalizeState(await projectSm.getState(input.workItemId));\n  if (current !== 'closed') {\n    throw new Error(\n      `STATE_COORDINATOR_INVALID_MERGED_SPEC_RECOVERY_FAILED: expected authoritative state closed, got ${current ?? 'null'}`,\n    );\n  }\n\n  const transitionResult = await projectSm.transition(\n    input.workItemId,\n    'closed',\n    'candidate_preparing',\n    ACTOR_ROLES.closeGate,\n    input.workflowType,\n    {\n      evidence: input.evidence,\n      transition_context: {\n        source: 'invalid_merged_spec_closure_recovery',\n        recovery_record: 'invalid_merged_spec_closure_recovery.json',\n        archive_generation: input.generationId,\n        archive_manifest: recovery.archive.manifest_path,\n        archive_manifest_sha256: recovery.archive.manifest_sha256,\n        invalidity_reasons: input.invalidityReasons,\n        compensating_transition: true,\n      },\n    },\n  );\n\n  return {\n    attempted: true,\n    advanced: true,\n    from_state: 'closed',\n    to_state: 'candidate_preparing',\n    evidence: input.evidence,\n    transition_result: {\n      source: 'StateManager',\n      workItemId: input.workItemId,\n      previousState: 'closed',\n      currentState: 'candidate_preparing',\n      timestamp: String(transitionResult?.timestamp ?? new Date().toISOString()),\n    },\n  };\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\state-machine-v11.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":98,"column":24,"nodeType":null,"messageId":"delete","endLine":98,"endColumn":25,"fix":{"range":[3138,3139],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `string,·{·requiredFile:·string;·description:·string·}` with `⏎··string,⏎··{·requiredFile:·string;·description:·string·}⏎`","line":128,"column":50,"nodeType":null,"messageId":"replace","endLine":128,"endColumn":103,"fix":{"range":[4225,4278],"text":"\n  string,\n  { requiredFile: string; description: string }\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'approval_required':·{·requiredFile:·'gate_summary.md',·description:·'Gate·Summary·must·exist·before·approval'` with `approval_required:·{⏎····requiredFile:·'gate_summary.md',⏎····description:·'Gate·Summary·must·exist·before·approval',⏎·`","line":129,"column":3,"nodeType":null,"messageId":"replace","endLine":129,"endColumn":113,"fix":{"range":[4286,4396],"text":"approval_required: {\n    requiredFile: 'gate_summary.md',\n    description: 'Gate Summary must exist before approval',\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'merge_ready':·{·requiredFile:·'user_decision.json',·description:·'User·Decision·must·exist·before·merge'` with `merge_ready:·{⏎····requiredFile:·'user_decision.json',⏎····description:·'User·Decision·must·exist·before·merge',⏎·`","line":130,"column":3,"nodeType":null,"messageId":"replace","endLine":130,"endColumn":108,"fix":{"range":[4402,4507],"text":"merge_ready: {\n    requiredFile: 'user_decision.json',\n    description: 'User Decision must exist before merge',\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'merging'` with `merging`","line":131,"column":3,"nodeType":null,"messageId":"replace","endLine":131,"endColumn":12,"fix":{"range":[4513,4522],"text":"merging"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'closed':·{·requiredFile:·'verification_report.md',·description:·'close_gate·verification·report·must·exist'` with `closed:·{⏎····requiredFile:·'verification_report.md',⏎····description:·'close_gate·verification·report·must·exist',⏎·`","line":132,"column":3,"nodeType":null,"messageId":"replace","endLine":132,"endColumn":111,"fix":{"range":[4613,4721],"text":"closed: {\n    requiredFile: 'verification_report.md',\n    description: 'close_gate verification report must exist',\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":154,"column":22,"nodeType":null,"messageId":"delete","endLine":154,"endColumn":23,"fix":{"range":[5634,5635],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":189,"column":22,"nodeType":null,"messageId":"delete","endLine":189,"endColumn":23,"fix":{"range":[6746,6747],"text":""}}],"suppressedMessages":[],"errorCount":8,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":8,"fixableWarningCount":0,"source":"/**\n * state-machine-v11.ts — v1.1 标准 WI 状态机引擎（§5）\n *\n * 产品边界：SPS-1.0。当前可执行合同由本模块导出、Runtime 消费者与回归测试固定；归档 v1.1 标准仅作历史证据。\n *\n * 职责：\n * - §5.1 主状态枚举（24 个状态）\n * - §5.2 禁止跳转规则\n * - §5.3 状态推进主体校验\n * - §5.4 恢复检查\n */\n\nimport * as fs from 'node:fs/promises';\nimport * as path from 'node:path';\nimport { STATE_ADVANCEMENT_SUBJECTS } from '@specforge/workflow-runtime';\nimport { FINAL_STATES, FINAL_TRANSITIONS } from './state_machine';\n\n// ---------------------------------------------------------------------------\n// §5.1 主状态枚举\n// ---------------------------------------------------------------------------\n\nexport const WI_STATUSES_V11 = FINAL_STATES;\n\nexport type WIStatusV11 = (typeof WI_STATUSES_V11)[number];\n\n// ---------------------------------------------------------------------------\n// §5.2 禁止跳转\n// ---------------------------------------------------------------------------\n\nconst FORBIDDEN: ReadonlyArray<readonly [string, string]> = [\n  ['created', 'implementation_running'],\n  ['intake_ready', 'implementation_running'],\n  ['impact_analyzing', 'implementation_running'],\n  ['impact_analyzed', 'implementation_running'],\n  ['workflow_selected', 'implementation_running'],\n  ['candidate_prepared', 'merging'],\n  ['approval_required', 'merging'],\n  ['approval_required', 'closed'],\n  ['merged', 'closed'],\n  ['blocked', 'closed'],\n  ['rejected', 'closed'],\n];\n\n/**\n * 校验状态跳转是否被禁止（§5.2）。\n * 注意：closed → any 也是禁止的。\n */\nexport function isForbiddenTransition(from: string, to: string): boolean {\n  if (from === 'closed') return true;\n  return FORBIDDEN.some(([f, t]) => f === from && t === to);\n}\n\n// ---------------------------------------------------------------------------\n// §5.3 状态推进主体\n// ---------------------------------------------------------------------------\n\n/**\n * 校验主体是否有权推进 WI 状态（§5.3）。\n */\nexport function isAuthorizedAdvancementSubject(subject: string): boolean {\n  return (STATE_ADVANCEMENT_SUBJECTS as readonly string[]).includes(subject);\n}\n\n// ---------------------------------------------------------------------------\n// v1.1 合法跳转表\n// ---------------------------------------------------------------------------\n\n/**\n * v1.1 标准 WI 主链路合法跳转表。\n */\n/** Compatibility export backed by the one authoritative transition table. */\nexport const V11_TRANSITIONS: ReadonlyMap<string, readonly string[]> = FINAL_TRANSITIONS;\n\n/**\n * 校验 v1.1 状态跳转是否合法。\n */\nexport function isValidV11Transition(from: string, to: string): boolean {\n  // 先检查禁止列表\n  if (isForbiddenTransition(from, to)) return false;\n  // 再检查合法列表\n  const targets = V11_TRANSITIONS.get(from);\n  if (!targets) return false;\n  return targets.includes(to);\n}\n\n/**\n * Workflow-aware verification recovery.\n *\n * The common lifecycle table remains unchanged. spec_migration is the no-code\n * exception: stale governed Verification input may recover from\n * verification_done to post_merge_verified, then reuse the existing\n * post_merge_verified -> verification_running -> verification_done path.\n * state-coordinator-v11 supplies the fail-closed provenance guard.\n */\nexport function isValidV11TransitionForWorkflow(\n  from: string,\n  to: string,\n  workflowType?: string,\n): boolean {\n  if (isValidV11Transition(from, to)) return true;\n  return (\n    workflowType === 'spec_migration' &&\n    from === 'verification_done' &&\n    to === 'post_merge_verified'\n  );\n}\n\n// ---------------------------------------------------------------------------\n// §5.4 恢复机制\n// ---------------------------------------------------------------------------\n\n// ---------------------------------------------------------------------------\n// §5.3 Evidence Prerequisites for Key States\n// ---------------------------------------------------------------------------\n\n/**\n * Key states that require specific evidence files before transition.\n *\n * Round C enhancement: `closed` now requires THREE evidence files:\n * - verification_report.md\n * - changed_files_audit.md\n * - close_gate.md (or close_gate.json)\n *\n * The single-file check (verification_report.md) is preserved for backward\n * compatibility in STATE_EVIDENCE_REQUIREMENTS. The comprehensive three-file\n * check is available via checkCloseGateEvidenceRequirements().\n */\nexport const STATE_EVIDENCE_REQUIREMENTS: Record<string, { requiredFile: string; description: string }> = {\n  'approval_required': { requiredFile: 'gate_summary.md', description: 'Gate Summary must exist before approval' },\n  'merge_ready': { requiredFile: 'user_decision.json', description: 'User Decision must exist before merge' },\n  'merging': { requiredFile: 'gate_summary.md', description: 'merge_ready_gate must have passed' },\n  'closed': { requiredFile: 'verification_report.md', description: 'close_gate verification report must exist' },\n};\n\n/**\n * All evidence files required before transitioning to `closed`.\n *\n * verification_done → closed is a seal transition that must be performed\n * by `close_gate`. Before closing, ALL three evidence files must exist.\n */\nexport const CLOSE_GATE_REQUIRED_EVIDENCE: ReadonlyArray<{ file: string; description: string }> = [\n  { file: 'verification_report.md', description: 'Verification report must exist before close' },\n  { file: 'changed_files_audit.md', description: 'Changed files audit must exist before close' },\n  { file: 'close_gate.md', description: 'Close gate evidence must exist before close' },\n];\n\n/**\n * Check all evidence requirements for transitioning to `closed`.\n *\n * Returns { met: true } if all three evidence files exist.\n * Returns { met: false, missing: string[] } with the list of missing files.\n */\nexport async function checkCloseGateEvidenceRequirements(\n  workItemDir: string,\n): Promise<{ met: boolean; missing: string[]; descriptions: string[] }> {\n  const missing: string[] = [];\n  const descriptions: string[] = [];\n\n  for (const req of CLOSE_GATE_REQUIRED_EVIDENCE) {\n    const fullPath = path.join(workItemDir, req.file);\n    try {\n      await fs.access(fullPath);\n    } catch {\n      // Also check .json variant for close_gate\n      if (req.file === 'close_gate.md') {\n        const jsonPath = path.join(workItemDir, 'close_gate.json');\n        try {\n          await fs.access(jsonPath);\n          continue; // .json variant exists\n        } catch {\n          // Neither variant exists\n        }\n      }\n      missing.push(req.file);\n      descriptions.push(req.description);\n    }\n  }\n\n  return { met: missing.length === 0, missing, descriptions };\n}\n\n/**\n * Check if a state transition's target has evidence prerequisites, and verify them.\n * Returns { met: true } if no prerequisites or all files exist.\n * Returns { met: false, missing } if prerequisites are not satisfied.\n */\nexport async function checkStateEvidenceRequirement(\n  targetStatus: string,\n  workItemDir: string,\n): Promise<{ met: boolean; missing?: string; description?: string }> {\n  const req = STATE_EVIDENCE_REQUIREMENTS[targetStatus];\n  if (!req) {\n    return { met: true };\n  }\n\n  const fullPath = path.join(workItemDir, req.requiredFile);\n  try {\n    await fs.access(fullPath);\n    return { met: true };\n  } catch {\n    return { met: false, missing: req.requiredFile, description: req.description };\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\state_machine.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"feature_spec\"` with `'feature_spec'`","line":18,"column":5,"nodeType":null,"messageId":"replace","endLine":18,"endColumn":19,"fix":{"range":[488,502],"text":"'feature_spec'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"bugfix_spec\"` with `'bugfix_spec'`","line":19,"column":5,"nodeType":null,"messageId":"replace","endLine":19,"endColumn":18,"fix":{"range":[507,520],"text":"'bugfix_spec'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"quick_change\"` with `'quick_change'`","line":20,"column":5,"nodeType":null,"messageId":"replace","endLine":20,"endColumn":19,"fix":{"range":[525,539],"text":"'quick_change'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"change_request\"` with `'change_request'`","line":21,"column":5,"nodeType":null,"messageId":"replace","endLine":21,"endColumn":21,"fix":{"range":[544,560],"text":"'change_request'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"feature_spec_design_first\"` with `'feature_spec_design_first'`","line":22,"column":5,"nodeType":null,"messageId":"replace","endLine":22,"endColumn":32,"fix":{"range":[565,592],"text":"'feature_spec_design_first'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"refactor\"` with `'refactor'`","line":23,"column":5,"nodeType":null,"messageId":"replace","endLine":23,"endColumn":15,"fix":{"range":[597,607],"text":"'refactor'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"ops_task\"` with `'ops_task'`","line":24,"column":5,"nodeType":null,"messageId":"replace","endLine":24,"endColumn":15,"fix":{"range":[612,622],"text":"'ops_task'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"investigation\"` with `'investigation'`","line":25,"column":5,"nodeType":null,"messageId":"replace