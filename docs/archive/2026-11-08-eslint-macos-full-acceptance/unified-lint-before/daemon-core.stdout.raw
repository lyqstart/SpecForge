horitativeWorkItems(_deps, baseDir);"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `catch·{·return·{·success:·false,·error:·'AUTHORITATIVE_STATE_UNAVAILABLE',·policy_violation:·true·};` with `}·catch·{⏎····return·{·success:·false,·error:·'AUTHORITATIVE_STATE_UNAVAILABLE',·policy_violation:·true·};⏎·`","line":305,"column":3,"nodeType":null,"messageId":"replace","endLine":305,"endColumn":103,"fix":{"range":[11074,11174],"text":"} catch {\n    return { success: false, error: 'AUTHORITATIVE_STATE_UNAVAILABLE', policy_violation: true };\n "}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":310,"column":26,"nodeType":"TSAsExpression","messageId":"unnecessaryAssertion","endLine":310,"endColumn":57,"fix":{"range":[11360,11387],"text":""}},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'context?.agent ?? 'unknown'' will use Object's default stringification format ('[object Object]') when stringified.","line":316,"column":50,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":316,"endColumn":77},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(`${SPEC_DIR_NAME}/**`·as·const)` with ``${SPEC_DIR_NAME}/**`·as·const`","line":318,"column":27,"nodeType":null,"messageId":"replace","endLine":318,"endColumn":59,"fix":{"range":[11854,11886],"text":"`${SPEC_DIR_NAME}/**` as const"}},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['blocked_step'] ?? 'protected_path_shell_access'' will use Object's default stringification format ('[object Object]') when stringified.","line":320,"column":32,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":320,"endColumn":85},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['resume_step'] ?? 'repeat evidence collection with a controlled read tool'' will use Object's default stringification format ('[object Object]') when stringified.","line":327,"column":13,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":327,"endColumn":92},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":358,"column":24,"nodeType":"TSAsExpression","messageId":"unnecessaryAssertion","endLine":358,"endColumn":55,"fix":{"range":[13621,13648],"text":""}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":363,"column":5,"nodeType":"TSAsExpression","messageId":"unnecessaryAssertion","endLine":363,"endColumn":36,"fix":{"range":[13763,13790],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎······`","line":402,"column":90,"nodeType":null,"messageId":"insert","endLine":402,"endColumn":90,"fix":{"range":[14915,14915],"text":"\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······baseDir,⏎······command,⏎······cwd,⏎······callerRole,⏎······'WRITE_GUARD_RUNTIME_BLOCKED',⏎····` with `baseDir,·command,·cwd,·callerRole,·'WRITE_GUARD_RUNTIME_BLOCKED'`","line":406,"column":32,"nodeType":null,"messageId":"replace","endLine":412,"endColumn":5,"fix":{"range":[15025,15126],"text":"baseDir, command, cwd, callerRole, 'WRITE_GUARD_RUNTIME_BLOCKED'"}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":437,"column":5,"nodeType":"TSAsExpression","messageId":"unnecessaryAssertion","endLine":437,"endColumn":36,"fix":{"range":[16305,16332],"text":""}}],"suppressedMessages":[],"errorCount":32,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":25,"fixableWarningCount":0,"source":"import { appendShellAudit, parseReadOnlyCommand } from '../lib/sf_safe_bash_executor';\nimport { registerHandler } from '../ToolDispatcher';\nimport { readAuthoritativeWorkItems } from '../lib/authoritative-work-items';\nimport { safeBashExecute } from '../lib/sf_safe_bash_core';\nimport { ACTOR_ROLES } from '@specforge/types/actor-roles';\nimport { checkHardStop, setHardStop } from '../lib/hard-stop-latch';\nimport { SPEC_DIR_NAME, workItemRoot } from '@specforge/types/directory-layout';\nimport {\n  enforceRuntimeWriteGuardForShell,\n  extractShellWriteTargets,\n} from '../lib/write-guard-runtime-v12';\nimport { findMatchingWriteGuardAuthorization } from '../lib/write-guard-authorization-log';\nimport { appendWriteGuardLog } from '../lib/write-guard-log';\nimport { isValidWorkItemId as isCanonicalWorkItemId } from '../lib/work-item-id-validator';\nimport * as fs from 'node:fs';\nimport * as path from 'node:path';\nimport {\n  readWorkItemMetadata,\n  readWorkItemMetadataSync,\n} from '../lib/work-item-metadata.js';\n\nconst VALID_ACTOR_ROLES: ReadonlySet<string> = new Set(Object.values(ACTOR_ROLES));\n\ntype ShellAccessKind = 'read' | 'write' | 'unknown';\n\nfunction isValidWorkItemId(value: unknown): value is string {\n  return typeof value === 'string' && isCanonicalWorkItemId(value);\n}\n\nfunction normalizeSlashes(value: string): string {\n  return String(value ?? '')\n    .replace(/\\\\/g, '/')\n    .replace(/\\/+/g, '/');\n}\n\nfunction normalizePathForCompare(value: string): string {\n  return normalizeSlashes(value).replace(/^\\.\\//, '').toLowerCase();\n}\n\nfunction extractCallerRole(agent: unknown): string | undefined {\n  if (typeof agent !== 'string' || !agent) return undefined;\n  if (VALID_ACTOR_ROLES.has(agent)) return agent;\n  return undefined;\n}\n\nfunction readJsonIfExists(filePath: string): any | null {\n  try {\n    if (!fs.existsSync(filePath)) return null;\n    return JSON.parse(fs.readFileSync(filePath, 'utf-8'));\n  } catch {\n    return null;\n  }\n}\n\nfunction toProjectRelative(\n  projectRoot: string,\n  cwd: string | undefined,\n  targetPath: string\n): string | null {\n  const cleaned = String(targetPath ?? '')\n    .trim()\n    .replace(/^[\"']|[\"']$/g, '');\n  if (!cleaned) return null;\n\n  const base = cwd && path.isAbsolute(cwd) ? cwd : projectRoot;\n  const absolute = path.isAbsolute(cleaned) ? path.resolve(cleaned) : path.resolve(base, cleaned);\n  const projectAbs = path.resolve(projectRoot);\n  const rel = path.relative(projectAbs, absolute);\n  if (rel.startsWith('..') || path.isAbsolute(rel)) return null;\n  return normalizeSlashes(rel);\n}\n\nconst TERMINAL_WI_STATES = new Set(['closed', 'rejected', 'superseded']);\n\nfunction findSingleActiveWorkItemIdForGovernance(\n  projectRoot: string,\n  args: Record<string, unknown>,\n  authoritativeItems: any[]\n): string | null {\n  const explicit = args['work_item_id'] ?? args['workItemId'] ?? args['wi'];\n  if (isValidWorkItemId(explicit)) return explicit;\n  const active = authoritativeItems\n    .filter(item => isValidWorkItemId(item?.work_item_id))\n    .filter(item => !TERMINAL_WI_STATES.has(String(item?.current_state ?? item?.status ?? '')))\n    .sort(sortByFreshest);\n  return active.length === 1 ? String(active[0].work_item_id) : null;\n}\n\nfunction appendGovernanceBlockedWrite(\n  projectRoot: string,\n  workItemId: string,\n  command: string,\n  reason: string,\n  hardStopId?: string\n): void {\n  appendWriteGuardLog(workItemRoot(projectRoot, workItemId), {\n    timestamp: new Date().toISOString(),\n    path: (`${SPEC_DIR_NAME}/**` as const),\n    operation: 'modify',\n    actor: 'agent',\n    allowed: false,\n    violations: [reason],\n    tool: 'sf_safe_bash',\n    command,\n    hard_stop_id: hardStopId,\n  });\n}\n\nfunction appendRejectedShellHistory(projectRoot: string, command: string, cwd: string | undefined, callerRole: string | undefined, rule: string): void {\n  appendShellAudit(projectRoot, {schema_version:'1.0',ts:new Date().toISOString(),command,cwd:cwd??projectRoot,shell:null,exitCode:null,durationMs:0,rejected:true,rule,timeout:false,success:false,stdout_size:0,stderr_size:0,callerRole:callerRole??null});\n}\n\nfunction readWorkItem(projectRoot: string, workItemId: string): any | null {\n  try {\n    return readWorkItemMetadataSync(workItemRoot(projectRoot, workItemId), workItemId);\n  } catch {\n    return null;\n  }\n}\n\nfunction allowedWriteEntryMatches(\n  projectRoot: string,\n  cwd: string | undefined,\n  entry: any,\n  targetRelative: string\n): boolean {\n  const raw = typeof entry === 'string' ? entry : entry?.path;\n  if (typeof raw !== 'string') return false;\n  const rel = toProjectRelative(projectRoot, cwd, raw) ?? normalizeSlashes(raw);\n  return normalizePathForCompare(rel) === normalizePathForCompare(targetRelative);\n}\n\nfunction timestampValue(value: unknown): number {\n  if (typeof value === 'number' && Number.isFinite(value)) return value;\n  const text = String(value ?? '');\n  const numeric = Number(text);\n  if (Number.isFinite(numeric) && numeric > 0) return numeric;\n  return Date.parse(text) || 0;\n}\n\nfunction sortByFreshest(a: any, b: any): number {\n  const au = timestampValue(a?.updated_at ?? a?.last_updated_at ?? a?.created_at);\n  const bu = timestampValue(b?.updated_at ?? b?.last_updated_at ?? b?.created_at);\n  return bu - au;\n}\n\nfunction isParentDirectoryOfAnyTarget(directoryTarget: string, targets: string[]): boolean {\n  const directory = normalizePathForCompare(directoryTarget).replace(/\\/+$/, '');\n  if (!directory || directory === '.' || directory.startsWith((`${SPEC_DIR_NAME}/` as const))) return false;\n\n  return targets.some(target => {\n    const normalized = normalizePathForCompare(target).replace(/\\/+$/, '');\n    return normalized !== directory && normalized.startsWith(directory + '/');\n  });\n}\n\nfunction filterDirectoryPreparationTargets(targets: string[]): string[] {\n  return targets.filter(target => !isParentDirectoryOfAnyTarget(target, targets));\n}\n\nexport function findActiveWorkItemIdForWrite(\n  projectRoot: string,\n  args: Record<string, unknown>,\n  command: string,\n  authoritativeItems: any[] = []\n): string | null {\n  const explicit = args['work_item_id'] ?? args['workItemId'] ?? args['wi'];\n  if (isValidWorkItemId(explicit)) return explicit;\n\n  const cwd = args['cwd'] as string | undefined;\n  const targets = filterDirectoryPreparationTargets(\n    extractShellWriteTargets(command)\n      .map(target => toProjectRelative(projectRoot, cwd, target.path))\n      .filter((value): value is string => typeof value === 'string')\n  );\n\n  const running = authoritativeItems\n    .filter(\n      item =>\n        item?.current_state === 'implementation_running' ||\n        item?.status === 'implementation_running'\n    )\n    .filter(item => isValidWorkItemId(item?.work_item_id))\n    .sort(sortByFreshest);\n\n  if (running.length === 0) return null;\n\n  for (const item of running) {\n    const wi = readWorkItem(projectRoot, String(item.work_item_id));\n    if (!wi || wi.code_change_allowed !== true || wi.code_permission_revoked === true) continue;\n\n    const allowed = Array.isArray(wi.allowed_write_files) ? wi.allowed_write_files : [];\n    if (\n      targets.length > 0 &&\n      targets.every(target =>\n        allowed.some((entry: any) => allowedWriteEntryMatches(projectRoot, cwd, entry, target))\n      )\n    ) {\n      return String(item.work_item_id);\n    }\n  }\n\n  return String(running[0].work_item_id);\n}\n\nfunction commandMentionsProtectedSpecForgePath(command: string): boolean {\n  const text = normalizePathForCompare(command);\n  return (\n    text.includes((`${SPEC_DIR_NAME}/project/` as const)) ||\n    text.includes((`${SPEC_DIR_NAME}/config/` as const)) ||\n    text.includes((`${SPEC_DIR_NAME}/runtime/` as const)) ||\n    text.includes((`${SPEC_DIR_NAME}/work-items/` as const)) ||\n    text.includes((`${SPEC_DIR_NAME}/logs/` as const)) ||\n    text.includes((`${SPEC_DIR_NAME}/specs/` as const)) ||\n    text.includes((`${SPEC_DIR_NAME}/cas/` as const))\n  );\n}\n\nfunction commandMentionsSensitiveSpecForgeRuntimeSecret(command: string): boolean {\n  const text = normalizePathForCompare(command).replace(/\\s+/g, '');\n  const mentionsRuntime =\n    text.includes((`${SPEC_DIR_NAME}/runtime/` as const)) || text.includes('/sf-user/runtime/');\n  if (!mentionsRuntime) return false;\n  return (\n    text.includes('handshake.json') ||\n    text.includes('token') ||\n    text.includes('authorization') ||\n    text.includes('bearer')\n  );\n}\n\nfunction commandHasReadOnlyShellProbe(command: string): boolean { return parseReadOnlyCommand(command) !== null; }\n\nexport function classifyProtectedSpecForgePathBashAccess(command: string): ShellAccessKind {\n  if (commandMentionsSensitiveSpecForgeRuntimeSecret(command)) return 'unknown';\n\n  const writeTargets = extractShellWriteTargets(command);\n  if (writeTargets.length > 0) return 'write';\n\n  const normalized = command.trim().toLowerCase();\n  const writeLikeCommand =\n    /(?:^|[;&|]\\s*)(set-content|add-content|out-file|new-item|copy-item|move-item|remove-item|del|erase|rm|rmdir|mkdir|ni|cp|mv|touch|tee|tee-object)\\b/.test(\n      normalized\n    );\n  if (writeLikeCommand) return 'write';\n\n  if (commandHasReadOnlyShellProbe(command)) return 'read';\n  return 'unknown';\n}\n\nfunction commandWritesOnlyReportPaths(projectRoot: string, command: string, cwd?: string): boolean {\n  const targets = extractShellWriteTargets(command);\n  if (targets.length === 0) return false;\n\n  return targets.every(target => {\n    const rel = toProjectRelative(projectRoot, cwd, target.path);\n    if (!rel) return false;\n    const normalized = normalizePathForCompare(rel);\n    return normalized === (`${SPEC_DIR_NAME}/reports` as const) || normalized.startsWith((`${SPEC_DIR_NAME}/reports/` as const));\n  });\n}\n\nfunction isDangerousEvenWithAuthorization(command: string): boolean {\n  const c = normalizePathForCompare(command);\n  return (\n    c.includes('--privileged') ||\n    /(^|\\s)-v\\s+\\/:/.test(c) ||\n    /source=\\/(,|\\s)/.test(c) ||\n    /(?:^|[;&|]\\s*)rm\\s+-rf\\s+\\/(\\s|$)/.test(c) ||\n    c.includes('/etc/passwd') ||\n    c.includes('/etc/shadow')\n  );\n}\n\nasync function executeSafe(\n  args: Record<string, unknown>,\n  baseDir: string,\n  command: string,\n  cwd: string | undefined,\n  callerRole: string | undefined\n) {\n  return safeBashExecute(\n    {\n      command,\n      cwd,\n      timeoutMs: args['timeoutMs'] as number | undefined,\n      env: args['env'] as Record<string, string> | undefined,\n      stdin: args['stdin'] as string | undefined,\n      outputLimit: args['outputLimit'] as number | undefined,\n      callerRole,\n    },\n    baseDir\n  );\n}\n\nregisterHandler('sf_safe_bash', async (args, context, _deps) => {\n  args = { timeoutMs: _deps.acceptedConfiguration?.merged.timeoutMs, ...args };\n  const baseDir = (context?.directory as string) || (context?.worktree as string) || process.cwd();\n  const callerRole = extractCallerRole((context as Record<string, unknown> | undefined)?.agent);\n  const command = (args['command'] as string) ?? '';\n  const cwd = args['cwd'] as string | undefined;\n\n  let authoritativeItems: any[];\n  try { authoritativeItems = await readAuthoritativeWorkItems(_deps, baseDir); }\n  catch { return { success: false, error: 'AUTHORITATIVE_STATE_UNAVAILABLE', policy_violation: true }; }\n\n  if (commandMentionsProtectedSpecForgePath(command)) {\n    const access = classifyProtectedSpecForgePathBashAccess(command);\n    if (access === 'read')\n      return executeSafe(args as Record<string, unknown>, baseDir, command, cwd, callerRole);\n\n    const activeWiId = findSingleActiveWorkItemIdForGovernance(baseDir, args, authoritativeItems);\n    const reason = 'SPEC_FORGE_RUNTIME_WRITE_FORBIDDEN';\n    const hardStopRecord = activeWiId\n      ? setHardStop(baseDir, activeWiId, reason, 'sf_safe_bash', 'work_item', {\n          triggering_agent: callerRole ?? String(context?.agent ?? 'unknown'),\n          blocked_action: command.slice(0, 500),\n          blocked_target: (`${SPEC_DIR_NAME}/**` as const),\n          policy_code: reason,\n          blocked_step: String(args['blocked_step'] ?? 'protected_path_shell_access'),\n          last_successful_step:\n            typeof args['last_successful_step'] === 'string' &&\n            args['last_successful_step'].trim().length > 0\n              ? args['last_successful_step'].trim()\n              : undefined,\n          resume_step: String(\n            args['resume_step'] ?? 'repeat evidence collection with a controlled read tool'\n          ),\n          retry_original_action: false,\n          safe_alternative_tool: 'read/glob/grep/sf_state_read',\n        })\n      : null;\n    if (activeWiId)\n      appendGovernanceBlockedWrite(\n        baseDir,\n        activeWiId,\n        command,\n        reason,\n        hardStopRecord?.hard_stop_id\n      );\n    appendRejectedShellHistory(baseDir, command, cwd, callerRole, reason);\n\n    return {\n      success: false,\n      error:\n        'SPEC_FORGE_PROTECTED_PATH_WRITE_REQUIRES_CONTROLLED_TOOL: sf_safe_bash cannot write protected .specforge paths.\\n' +\n        'Use sf_project_config for runtime project JSON, sf_artifact_write(file_type=project_prod_environment|project_rules) for configuration documents during intake_ready, canonical sf_artifact_write types for Work Item artifacts, or sf_merge_run for .specforge/project/**. Never fall back to native file tools, General Task, or helper scripts.',\n      hard_stop: hardStopRecord !== null,\n      hard_stop_record: hardStopRecord ?? undefined,\n      work_item_id: activeWiId ?? undefined,\n      policy_violation: true,\n      retry_allowed: false,\n      blocked_command: command.slice(0, 240),\n    };\n  }\n\n  if (commandWritesOnlyReportPaths(baseDir, command, cwd)) {\n    return executeSafe(args as Record<string, unknown>, baseDir, command, cwd, callerRole);\n  }\n\n  const activeWiId = findActiveWorkItemIdForWrite(\n    baseDir,\n    args as Record<string, unknown>,\n    command,\n    authoritativeItems\n  );\n  if (activeWiId) {\n    try {\n      await readWorkItemMetadata(workItemRoot(baseDir, activeWiId), activeWiId);\n    } catch (error) {\n      return {\n        success: false,\n        error: error instanceof Error ? error.message : String(error),\n        work_item_id: activeWiId,\n        hard_stop: false,\n        policy_violation: true,\n        retry_allowed: false,\n      };\n    }\n\n    const { blocked, record } = checkHardStop(baseDir, activeWiId);\n    if (blocked) {\n      return {\n        success: false,\n        error:\n          `HARD_STOP_ACTIVE: Work item ${activeWiId} is blocked.\\n` +\n          `Reason: ${record!.reason}.\\nSource: ${record!.source_tool}.\\n` +\n          'sf_safe_bash is blocked only for the affected work item.',\n        hard_stop: true,\n        hard_stop_record: record,\n      };\n    }\n  }\n\n  const runtimeGuard = enforceRuntimeWriteGuardForShell({\n    projectRoot: baseDir,\n    workItemId: activeWiId,\n    command,\n    cwd,\n    callerRole,\n    tool: 'sf_safe_bash',\n    authoritativeState: authoritativeItems.find(item => item.work_item_id === activeWiId)?.current_state,\n  });\n\n  if (runtimeGuard.checked && !runtimeGuard.allowed) {\n    appendRejectedShellHistory(\n      baseDir,\n      command,\n      cwd,\n      callerRole,\n      'WRITE_GUARD_RUNTIME_BLOCKED',\n    );\n    return {\n      success: false,\n      error:\n        'WRITE_GUARD_RUNTIME_BLOCKED: sf_safe_bash refused to execute a write command before it could modify files.\\n' +\n        'Use sf_project_config for runtime project JSON, sf_artifact_write(file_type=project_prod_environment|project_rules) for configuration documents during intake_ready, canonical sf_artifact_write types for Work Item artifacts, and sf_merge_run for Project Spec. Do not fall back to native file tools, General Task, or helper scripts.\\n' +\n        'Violations: ' +\n        runtimeGuard.violations.join('; '),\n      hard_stop: runtimeGuard.hard_stop === true,\n      policy_violation: true,\n      retry_allowed: false,\n      blocked_command: command.slice(0, 240),\n      write_guard_targets: runtimeGuard.targets,\n      user_action_required:\n        runtimeGuard.hard_stop === true\n          ? 'resolve_hard_stop_or_authorize_scoped_operation'\n          : undefined,\n    };\n  }\n\n  const matchingAuthorization =\n    activeWiId && !isDangerousEvenWithAuthorization(command)\n      ? findMatchingWriteGuardAuthorization(baseDir, command, activeWiId)\n      : null;\n  const result = await executeSafe(\n    args as Record<string, unknown>,\n    baseDir,\n    command,\n    cwd,\n    callerRole\n  );\n\n  if (!matchingAuthorization) return result;\n\n  return {\n    ...(typeof result === 'object' && result !== null ? result : { output: result }),\n    write_guard_authorized: true,\n    write_guard_authorization_id: matchingAuthorization.authorization_id ?? null,\n    write_guard_authorization_type: matchingAuthorization.authorization_type ?? null,\n    write_guard_authorization_scope: matchingAuthorization.scope ?? null,\n  };\n});\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\handlers\\sf-semantic-closure-run.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `SEMANTIC_CLOSURE_SCHEMA_VERSION` with `·SEMANTIC_CLOSURE_SCHEMA_VERSION·`","line":1,"column":9,"nodeType":null,"messageId":"replace","endLine":1,"endColumn":40,"fix":{"range":[8,39],"text":" SEMANTIC_CLOSURE_SCHEMA_VERSION "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"@specforge/types/directory-layout\"` with `'@specforge/types/directory-layout'`","line":2,"column":31,"nodeType":null,"messageId":"replace","endLine":2,"endColumn":66,"fix":{"range":[111,146],"text":"'@specforge/types/directory-layout'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(workItem.workflow_type!=='feature_spec')return·{success:false,error:'UNSUPPORTED_CURRENT_RELEASE_WORKFLOW',semantic_closure_valid:false` with `·(workItem.workflow_type·!==·'feature_spec')⏎····return·{⏎······success:·false,⏎······error:·'UNSUPPORTED_CURRENT_RELEASE_WORKFLOW',⏎······semantic_closure_valid:·false,⏎····`","line":163,"column":5,"nodeType":null,"messageId":"replace","endLine":163,"endColumn":141,"fix":{"range":[5596,5732],"text":" (workItem.workflow_type !== 'feature_spec')\n    return {\n      success: false,\n      error: 'UNSUPPORTED_CURRENT_RELEASE_WORKFLOW',\n      semantic_closure_valid: false,\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=(value:unknown)=>` with `·=·(value:·unknown)·=>·`","line":164,"column":23,"nodeType":null,"messageId":"replace","endLine":164,"endColumn":41,"fix":{"range":[5757,5775],"text":" = (value: unknown) => "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=` with `·=·`","line":165,"column":17,"nodeType":null,"messageId":"replace","endLine":165,"endColumn":18,"fix":{"range":[5793,5794],"text":" = "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `!parsed||((parsed.workflow_type===undefined||parsed.workflow_type==='feature_spec')&&(parsed.closure_profile===undefined||parsed.closure_profile==='feature_spec'))` with `(⏎······!parsed·||⏎······((parsed.workflow_type·===·undefined·||·parsed.workflow_type·===·'feature_spec')·&&⏎········(parsed.closure_profile·===·undefined·||·parsed.closure_profile·===·'feature_spec'))⏎····)`","line":166,"column":12,"nodeType":null,"messageId":"replace","endLine":166,"endColumn":175,"fix":{"range":[5842,6005],"text":"(\n      !parsed ||\n      ((parsed.workflow_type === undefined || parsed.workflow_type === 'feature_spec') &&\n        (parsed.closure_profile === undefined || parsed.closure_profile === 'feature_spec'))\n    )"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(suppliedSemanticClosure!==undefined&&!currentSubject(suppliedSemanticClosure))return·{success:false,error:'SEMANTIC_CLOSURE_CURRENT_WORKFLOW_MISMATCH',semantic_closure_valid:false` with `·(suppliedSemanticClosure·!==·undefined·&&·!currentSubject(suppliedSemanticClosure))⏎····return·{⏎······success:·false,⏎······error:·'SEMANTIC_CLOSURE_CURRENT_WORKFLOW_MISMATCH',⏎······semantic_closure_valid:·false,⏎····`","line":168,"column":5,"nodeType":null,"messageId":"replace","endLine":168,"endColumn":185,"fix":{"range":[6016,6196],"text":" (suppliedSemanticClosure !== undefined && !currentSubject(suppliedSemanticClosure))\n    return {\n      success: false,\n      error: 'SEMANTIC_CLOSURE_CURRENT_WORKFLOW_MISMATCH',\n      semantic_closure_valid: false,\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `!value·||·typeof·value·!==·'object'·||` with `⏎······!value·||⏎······typeof·value·!==·'object'·||⏎·····`","line":174,"column":9,"nodeType":null,"messageId":"replace","endLine":174,"endColumn":47,"fix":{"range":[6459,6497],"text":"\n      !value ||\n      typeof value !== 'object' ||\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `········(value·as·Record<string,·unknown>).schema_version·!==·SEMANTIC_CLOSURE_SCHEMA_VERSION` with `······(value·as·Record<string,·unknown>).schema_version·!==·SEMANTIC_CLOSURE_SCHEMA_VERSION⏎····`","line":175,"column":1,"nodeType":null,"messageId":"replace","endLine":175,"endColumn":94,"fix":{"range":[6522,6615],"text":"      (value as Record<string, unknown>).schema_version !== SEMANTIC_CLOSURE_SCHEMA_VERSION\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `success:false,error:'SEMANTIC_CLOSURE_SCHEMA_UNSUPPORTED',semantic_closure_valid:false` with `⏎········success:·false,⏎········error:·'SEMANTIC_CLOSURE_SCHEMA_UNSUPPORTED',⏎········semantic_closure_valid:·false,⏎······`","line":176,"column":15,"nodeType":null,"messageId":"replace","endLine":176,"endColumn":101,"fix":{"range":[6633,6719],"text":"\n        success: false,\n        error: 'SEMANTIC_CLOSURE_SCHEMA_UNSUPPORTED',\n        semantic_closure_valid: false,\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `success:false,error:'SEMANTIC_CLOSURE_SCHEMA_BLOCKED',semantic_closure_valid:false` with `⏎········success:·false,⏎········error:·'SEMANTIC_CLOSURE_SCHEMA_BLOCKED',⏎········semantic_closure_valid:·false,⏎······`","line":181,"column":15,"nodeType":null,"messageId":"replace","endLine":181,"endColumn":97,"fix":{"range":[6884,6966],"text":"\n        success: false,\n        error: 'SEMANTIC_CLOSURE_SCHEMA_BLOCKED',\n        semantic_closure_valid: false,\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `⏎·······`","line":216,"column":16,"nodeType":null,"messageId":"delete","endLine":217,"endColumn":8,"fix":{"range":[8138,8146],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(existing.schema_version!==SEMANTIC_CLOSURE_SCHEMA_VERSION)return·{success:false,error:'SEMANTIC_CLOSURE_SCHEMA_UNSUPPORTED',semantic_closure_valid:false` with `·(existing.schema_version·!==·SEMANTIC_CLOSURE_SCHEMA_VERSION)⏎········return·{⏎··········success:·false,⏎··········error:·'SEMANTIC_CLOSURE_SCHEMA_UNSUPPORTED',⏎··········semantic_closure_valid:·false,⏎········`","line":245,"column":9,"nodeType":null,"messageId":"replace","endLine":245,"endColumn":162,"fix":{"range":[9567,9720],"text":" (existing.schema_version !== SEMANTIC_CLOSURE_SCHEMA_VERSION)\n        return {\n          success: false,\n          error: 'SEMANTIC_CLOSURE_SCHEMA_UNSUPPORTED',\n          semantic_closure_valid: false,\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(!currentSubject(existing))return·{success:false,error:'SEMANTIC_CLOSURE_CURRENT_WORKFLOW_MISMATCH',semantic_closure_valid:false` with `·(!currentSubject(existing))⏎········return·{⏎··········success:·false,⏎··········error:·'SEMANTIC_CLOSURE_CURRENT_WORKFLOW_MISMATCH',⏎··········semantic_closure_valid:·false,⏎········`","line":246,"column":9,"nodeType":null,"messageId":"replace","endLine":246,"endColumn":137,"fix":{"range":[9731,9859],"text":" (!currentSubject(existing))\n        return {\n          success: false,\n          error: 'SEMANTIC_CLOSURE_CURRENT_WORKFLOW_MISMATCH',\n          semantic_closure_valid: false,\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `⏎·······`","line":295,"column":16,"nodeType":null,"messageId":"delete","endLine":296,"endColumn":8,"fix":{"range":[11733,11741],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(build.manifest.schema_version!==SEMANTIC_CLOSURE_SCHEMA_VERSION)return·{success:false,error:'SEMANTIC_CLOSURE_SCHEMA_UNSUPPORTED',semantic_closure_valid:false` with `·(build.manifest.schema_version·!==·SEMANTIC_CLOSURE_SCHEMA_VERSION)⏎····return·{⏎······success:·false,⏎······error:·'SEMANTIC_CLOSURE_SCHEMA_UNSUPPORTED',⏎······semantic_closure_valid:·false,⏎····`","line":353,"column":5,"nodeType":null,"messageId":"replace","endLine":353,"endColumn":164,"fix":{"range":[13653,13812],"text":" (build.manifest.schema_version !== SEMANTIC_CLOSURE_SCHEMA_VERSION)\n    return {\n      success: false,\n      error: 'SEMANTIC_CLOSURE_SCHEMA_UNSUPPORTED',\n      semantic_closure_valid: false,\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(!currentSubject(build.manifest))return·{success:false,error:'SEMANTIC_CLOSURE_CURRENT_WORKFLOW_MISMATCH',semantic_closure_valid:false` with `·(!currentSubject(build.manifest))⏎····return·{⏎······success:·false,⏎······error:·'SEMANTIC_CLOSURE_CURRENT_WORKFLOW_MISMATCH',⏎······semantic_closure_valid:·false,⏎····`","line":354,"column":5,"nodeType":null,"messageId":"replace","endLine":354,"endColumn":139,"fix":{"range":[13819,13953],"text":" (!currentSubject(build.manifest))\n    return {\n      success: false,\n      error: 'SEMANTIC_CLOSURE_CURRENT_WORKFLOW_MISMATCH',\n      semantic_closure_valid: false,\n    "}}],"suppressedMessages":[],"errorCount":17,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":17,"fixableWarningCount":0,"source":"import {SEMANTIC_CLOSURE_SCHEMA_VERSION} from '../lib/semantic-closure-core.js';\nimport { SPEC_DIR_NAME } from \"@specforge/types/directory-layout\";\n/**\n * sf-semantic-closure-run — generate and validate .semantic_closure.json.\n *\n * Public alias: sf_semantic_closure_run.\n * This tool writes only semantic closure artifacts inside the current WI:\n * - .semantic_closure.json\n * - semantic_closure_report.md\n * It does not advance workflow state and does not modify code or project truth source.\n */\n\nimport * as fs from 'node:fs/promises';\nimport * as path from 'node:path';\nimport { registerHandler } from '../ToolDispatcher.js';\nimport {\n  buildSemanticClosureFromArtifacts,\n  parseSemanticClosureManifest,\n} from '../lib/semantic-closure-builder.js';\nimport { validateSemanticClosure } from '../lib/semantic-closure-core.js';\nimport {\n  captureSemanticClosureProvenance,\n  SEMANTIC_CLOSURE_ACCEPTED_SOURCES,\n  SEMANTIC_CLOSURE_CONTRACT_ID,\n  validateSemanticClosureProvenance,\n} from '../lib/semantic-closure-provenance.js';\nimport { readAuthoritativeState } from '../lib/state-coordinator-v11.js';\nimport {\n  extractStructuredVerificationReport,\n  validateVerificationReportContract,\n  VERIFICATION_REPORT_CONTRACT_ID,\n} from '../lib/verification-report-contract.js';\nimport { resolveWorkItemSpecArtifacts } from '../lib/governance-invariants-v11.js';\nimport { isWorkItemSpecArtifactPlaceholder } from '@specforge/types/directory-layout';\nimport { readWorkItemMetadata } from '../lib/work-item-metadata.js';\nimport {\n  evidenceManifestSchemaBlockCode,\n  precheckEvidenceManifestSchema,\n} from '../lib/evidence-manifest.js';\n\nasync function readTextIfExists(filePath: string): Promise<string | undefined> {\n  try {\n    return await fs.readFile(filePath, 'utf-8');\n  } catch {\n    return undefined;\n  }\n}\n\nasync function readJsonIfExists<T = any>(filePath: string): Promise<T | null> {\n  try {\n    return JSON.parse(await fs.readFile(filePath, 'utf-8')) as T;\n  } catch {\n    return null;\n  }\n}\n\nfunction rel(projectRoot: string, filePath: string): string {\n  return path.relative(projectRoot, filePath).replace(/\\\\/g, '/');\n}\n\nfunction renderReport(input: {\n  workItemId: string;\n  manifestPath: string;\n  source: string;\n  validation: ReturnType<typeof validateSemanticClosure>;\n  diagnostics: string[];\n  overallPassed?: boolean;\n}): string {\n  const overallPassed = input.overallPassed ?? input.validation.passed;\n  const lines: string[] = [\n    '# Semantic Closure Report',\n    '',\n    `- Work Item: ${input.workItemId}`,\n    `- Status: ${overallPassed ? 'PASSED' : 'FAILED'}`,\n    `- Source: ${input.source}`,\n    `- Contract: ${SEMANTIC_CLOSURE_CONTRACT_ID}`,\n    `- Manifest: ${input.manifestPath}`,\n    `- Timestamp: ${new Date().toISOString()}`,\n    '',\n    '## Errors',\n    '',\n  ];\n\n  if (input.validation.errors.length === 0) {\n    lines.push('- None', '');\n  } else {\n    for (const issue of input.validation.errors) {\n      lines.push(`- ${issue.check_id}: ${issue.message}`);\n      for (const detail of issue.details ?? []) lines.push(`  - ${detail}`);\n    }\n    lines.push('');\n  }\n\n  lines.push('## Warnings', '');\n  if (input.validation.warnings.length === 0) {\n    lines.push('- None', '');\n  } else {\n    for (const issue of input.validation.warnings) {\n      lines.push(`- ${issue.check_id}: ${issue.message}`);\n      for (const detail of issue.details ?? []) lines.push(`  - ${detail}`);\n    }\n    lines.push('');\n  }\n\n  lines.push('## Diagnostics', '');\n  if (input.diagnostics.length === 0) {\n    lines.push('- None', '');\n  } else {\n    for (const diagnostic of input.diagnostics) lines.push(`- ${diagnostic}`);\n    lines.push('');\n  }\n\n  lines.push('## Recovery Contract', '');\n  lines.push(`- Preferred input: typed \\`semantic_closure\\` argument.`);\n  lines.push(\n    '- Required normal-flow sections: outcomes, requirements, design_decisions, tasks, evidence, project_integration.'\n  );\n  lines.push(\n    '- Evidence used for completion must be passed, non-weak, and reference the semantic target it proves.'\n  );\n  lines.push(\n    '- After any verification input changes, regenerate with force=true before running verification_gate.'\n  );\n  lines.push('');\n\n  lines.push('## Checks', '', '| Check ID | Passed | Description |', '|---|---:|---|');\n  for (const check of input.validation.checks) {\n    lines.push(\n      `| ${check.check_id} | ${check.passed ? 'yes' : 'no'} | ${check.description.replace(/\\|/g, '\\\\|')} |`\n    );\n  }\n  lines.push('');\n  return lines.join('\\n');\n}\n\nregisterHandler('sf_v11_semantic_closure_run', async (args, context, deps) => {\n  const projectRoot =\n    (context?.directory as string) || (context?.worktree as string) || process.cwd();\n  const workItemId = args['work_item_id'] as string;\n  const suppliedSemanticClosure = args['semantic_closure'];\n  const force = args['force'] === true || suppliedSemanticClosure !== undefined;\n\n  if (!workItemId) {\n    return { success: false, error: 'work_item_id is required' };\n  }\n\n  const workItemDir = path.join(projectRoot, SPEC_DIR_NAME, 'work-items', workItemId);\n  const semanticClosurePath = path.join(workItemDir, '.semantic_closure.json');\n  const reportPath = path.join(workItemDir, 'semantic_closure_report.md');\n  const verificationReportPath = path.join(workItemDir, 'verification_report.md');\n\n  let workItem: Record<string, any>;\n  try {\n    workItem = await readWorkItemMetadata(workItemDir, workItemId);\n  } catch (error) {\n    return {\n      success: false,\n      work_item_id: workItemId,\n      error: error instanceof Error ? error.message : String(error),\n    };\n  }\n\n  if(workItem.workflow_type!=='feature_spec')return {success:false,error:'UNSUPPORTED_CURRENT_RELEASE_WORKFLOW',semantic_closure_valid:false};\n  const currentSubject=(value:unknown)=>{\n    const parsed=parseSemanticClosureManifest(value);\n    return !parsed||((parsed.workflow_type===undefined||parsed.workflow_type==='feature_spec')&&(parsed.closure_profile===undefined||parsed.closure_profile==='feature_spec'));\n  };\n  if(suppliedSemanticClosure!==undefined&&!currentSubject(suppliedSemanticClosure))return {success:false,error:'SEMANTIC_CLOSURE_CURRENT_WORKFLOW_MISMATCH',semantic_closure_valid:false};\n\n  // force regenerates supported content; it never converts an unknown or corrupt schema.\n  let existingSemanticClosure: Record<string, any> | null = null;\n  try {\n    const value: unknown = JSON.parse(await fs.readFile(semanticClosurePath, 'utf8'));\n    if (!value || typeof value !== 'object' || Array.isArray(value) ||\n        (value as Record<string, unknown>).schema_version !== SEMANTIC_CLOSURE_SCHEMA_VERSION) {\n      return {success:false,error:'SEMANTIC_CLOSURE_SCHEMA_UNSUPPORTED',semantic_closure_valid:false};\n    }\n    existingSemanticClosure = value as Record<string, any>;\n  } catch (error) {\n    if ((error as NodeJS.ErrnoException).code !== 'ENOENT') {\n      return {success:false,error:'SEMANTIC_CLOSURE_SCHEMA_BLOCKED',semantic_closure_valid:false};\n    }\n  }\n\n  const evidenceSchemaPrecheck = await precheckEvidenceManifestSchema(workItemDir, workItemId);\n  const evidenceSchemaBlockCode = evidenceManifestSchemaBlockCode(evidenceSchemaPrecheck);\n  if (evidenceSchemaBlockCode) {\n    return {\n      success: false,\n      work_item_id: workItemId,\n      error: `EVIDENCE_MANIFEST_SCHEMA_BLOCKED: ${evidenceSchemaBlockCode}`,\n      semantic_closure_valid: false,\n      retry_allowed: false,\n    };\n  }\n\n  const authoritativeState = await readAuthoritativeState({\n    deps,\n    projectRoot,\n    workItemId,\n  });\n  const workflowType = String(workItem?.workflow_type ?? '');\n  const frozenRecoveryTarget =\n    workflowType === 'spec_migration' ? 'post_merge_verified' : 'implementation_ready';\n  const inputsFrozen = ['verification_done', 'closed', 'rejected', 'superseded'].includes(\n    String(authoritativeState.current_state ?? '')\n  );\n  if (force && inputsFrozen) {\n    return {\n      success: false,\n      work_item_id: workItemId,\n      error: 'SEMANTIC_CLOSURE_INPUTS_FROZEN',\n      current_state: authoritativeState.current_state,\n      semantic_closure_valid: false,\n      retry_allowed: false,\n      recovery:\n        `Recover the Work Item from verification_done to ${frozenRecoveryTarget}, update governed verification artifacts, regenerate semantic closure with force=true, then rerun verification_gate.`,\n    };\n  }\n\n  const verificationReportText = await readTextIfExists(verificationReportPath);\n  const verificationReport = verificationReportText\n    ? extractStructuredVerificationReport(verificationReportText)\n    : null;\n  const verificationContract = validateVerificationReportContract(verificationReport);\n  if (!verificationContract.valid) {\n    return {\n      success: false,\n      work_item_id: workItemId,\n      error: 'VERIFICATION_INPUT_CONTRACT_INVALID',\n      semantic_closure_valid: false,\n      retry_allowed: !inputsFrozen,\n      verification_contract_id: VERIFICATION_REPORT_CONTRACT_ID,\n      validation_errors: verificationContract.errors,\n      verification_report_path: rel(projectRoot, verificationReportPath),\n      recovery: inputsFrozen\n        ? `Recover the Work Item to ${frozenRecoveryTarget}, have sf-verifier rewrite verification_report with the complete ${VERIFICATION_REPORT_CONTRACT_ID} contract, then regenerate semantic closure.`\n        : `Have sf-verifier rewrite verification_report with the complete ${VERIFICATION_REPORT_CONTRACT_ID} contract, then call sf_semantic_closure_run again.`,\n    };\n  }\n\n  if (!force) {\n    const existing = existingSemanticClosure;\n    if (existing) {\n      if(existing.schema_version!==SEMANTIC_CLOSURE_SCHEMA_VERSION)return {success:false,error:'SEMANTIC_CLOSURE_SCHEMA_UNSUPPORTED',semantic_closure_valid:false};\n      if(!currentSubject(existing))return {success:false,error:'SEMANTIC_CLOSURE_CURRENT_WORKFLOW_MISMATCH',semantic_closure_valid:false};\n      const validation = validateSemanticClosure(existing);\n      const provenanceValidation = await validateSemanticClosureProvenance(workItemDir, existing);\n      const closureValid = validation.passed && provenanceValidation.passed;\n      await fs.writeFile(\n        reportPath,\n        renderReport({\n          workItemId,\n          manifestPath: rel(projectRoot, semanticClosurePath),\n          source: 'existing_semantic_closure',\n          validation,\n          overallPassed: closureValid,\n          diagnostics: [\n            'Existing .semantic_closure.json preserved because force=true was not supplied.',\n            ...provenanceValidation.errors,\n          ],\n        }),\n        'utf-8'\n      );\n      return {\n        success: closureValid,\n        work_item_id: workItemId,\n        semantic_closure_valid: closureValid,\n        source: 'existing_semantic_closure',\n        manifest_path: rel(projectRoot, semanticClosurePath),\n        report_path: rel(projectRoot, reportPath),\n        errors: validation.errors,\n        warnings: validation.warnings,\n        provenance_valid: provenanceValidation.passed,\n        provenance_errors: provenanceValidation.errors,\n        contract_id: SEMANTIC_CLOSURE_CONTRACT_ID,\n        accepted_sources: SEMANTIC_CLOSURE_ACCEPTED_SOURCES,\n        next_action: closureValid\n          ? 'Run verification_gate.'\n          : inputsFrozen\n            ? `Recover to ${frozenRecoveryTarget}, then regenerate semantic closure with force=true.`\n            : 'Regenerate semantic closure with force=true after correcting its inputs.',\n      };\n    }\n  }\n\n  if (inputsFrozen) {\n    return {\n      success: false,\n      work_item_id: workItemId,\n      error: 'SEMANTIC_CLOSURE_INPUTS_FROZEN',\n      current_state: authoritativeState.current_state,\n      semantic_closure_valid: false,\n      retry_allowed: false,\n      recovery:\n        `No existing semantic closure is available to validate. Recover the Work Item to ${frozenRecoveryTarget}, regenerate semantic closure, then rerun verification_gate.`,\n    };\n  }\n\n  const evidenceManifest = await readJsonIfExists<Record<string, any>>(\n    path.join(workItemDir, 'evidence', 'evidence_manifest.json')\n  );\n\n  if (suppliedSemanticClosure !== undefined) {\n    const parsed = parseSemanticClosureManifest(suppliedSemanticClosure);\n    if (!parsed) {\n      return {\n        success: false,\n        work_item_id: workItemId,\n        error: 'INVALID_SEMANTIC_CLOSURE_ARGUMENT',\n        semantic_closure_valid: false,\n        contract_id: SEMANTIC_CLOSURE_CONTRACT_ID,\n        accepted_sources: SEMANTIC_CLOSURE_ACCEPTED_SOURCES,\n        recovery:\n          'Pass semantic_closure as a manifest object with outcomes, requirements, design_decisions, tasks, evidence, and project_integration.',\n      };\n    }\n    if (parsed.work_item_id && parsed.work_item_id !== workItemId) {\n      return {\n        success: false,\n        work_item_id: workItemId,\n        error: 'SEMANTIC_CLOSURE_WORK_ITEM_MISMATCH',\n        supplied_work_item_id: parsed.work_item_id,\n        semantic_closure_valid: false,\n        retry_allowed: true,\n      };\n    }\n  }\n\n  const traceDeltaArtifact = (\n    await resolveWorkItemSpecArtifacts({\n      projectRoot,\n      workItemId,\n      kind: 'trace_delta',\n    })\n  )[0];\n  const traceDeltaMd =\n    traceDeltaArtifact &&\n    !isWorkItemSpecArtifactPlaceholder('trace_delta', traceDeltaArtifact.content)\n      ? traceDeltaArtifact.content\n      : undefined;\n\n  const build = buildSemanticClosureFromArtifacts({\n    workItemId,\n    workItem,\n    curatedSemanticClosure: suppliedSemanticClosure,\n    traceDeltaMd,\n    verificationReportMd: verificationReportText,\n    evidenceManifest,\n    mergeReportMd: await readTextIfExists(path.join(workItemDir, 'merge_report.md')),\n  });\n\n  if(build.manifest.schema_version!==SEMANTIC_CLOSURE_SCHEMA_VERSION)return {success:false,error:'SEMANTIC_CLOSURE_SCHEMA_UNSUPPORTED',semantic_closure_valid:false};\n  if(!currentSubject(build.manifest))return {success:false,error:'SEMANTIC_CLOSURE_CURRENT_WORKFLOW_MISMATCH',semantic_closure_valid:false};\n\n  const manifest = {\n    ...build.manifest,\n    provenance: await captureSemanticClosureProvenance({\n      workItemDir,\n      source: build.source,\n      manifest: build.manifest,\n    }),\n  };\n  const validation = validateSemanticClosure(manifest);\n\n  await fs.writeFile(semanticClosurePath, JSON.stringify(manifest, null, 2) + '\\n', 'utf-8');\n  await fs.writeFile(\n    reportPath,\n    renderReport({\n      workItemId,\n      manifestPath: rel(projectRoot, semanticClosurePath),\n      source: build.source,\n      validation,\n      diagnostics: build.diagnostics,\n    }),\n    'utf-8'\n  );\n\n  return {\n    success: validation.passed,\n    work_item_id: workItemId,\n    semantic_closure_valid: validation.passed,\n    source: build.source,\n    manifest_path: rel(projectRoot, semanticClosurePath),\n    report_path: rel(projectRoot, reportPath),\n    errors: validation.errors,\n    warnings: validation.warnings,\n    provenance_valid: true,\n    contract_id: SEMANTIC_CLOSURE_CONTRACT_ID,\n    accepted_sources: SEMANTIC_CLOSURE_ACCEPTED_SOURCES,\n    next_action: validation.passed\n      ? 'Run verification_gate. Do not mutate verification inputs after the gate passes.'\n      : 'Correct the returned validation errors and call sf_semantic_closure_run again with the typed semantic_closure argument.',\n  };\n});\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\handlers\\sf-state-read.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Delete `⏎···`","line":14,"column":22,"nodeType":null,"messageId":"delete","endLine":15,"endColumn":4,"fix":{"range":[452,456],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·typeof·sm.getLastReplayedEventCount·===·'function'⏎······?·sm.getLastReplayedEventCount()⏎·····` with `⏎······typeof·sm.getLastReplayedEventCount·===·'function'·?·sm.getLastReplayedEventCount()`","line":34,"column":23,"nodeType":null,"messageId":"replace","endLine":36,"endColumn":6,"fix":{"range":[1157,1253],"text":"\n      typeof sm.getLastReplayedEventCount === 'function' ? sm.getLastReplayedEventCount()"}}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":2,"fixableWarningCount":0,"source":"import { registerHandler } from '../ToolDispatcher';\n\n/**\n * sf_state_read\n *\n * State authority rule:\n * - read from project-level StateManager only;\n * - rebuild StateManager in memory from events.jsonl before reading when supported;\n * - do not read work_item.json.status or runtime/state.json directly.\n */\nregisterHandler('sf_state_read', async (args, context, deps) => {\n  const workItemId = args['work_item_id'] as string;\n\n  const projectPath =\n    (context?.directory as string) || (context?.worktree as string) || '';\n\n  if (!projectPath) {\n    return {\n      success: false,\n      error: 'projectPath required — provide context.directory or context.worktree',\n    };\n  }\n\n  if (!deps.projectManager) {\n    return { success: false, error: 'ProjectManager not available' };\n  }\n\n  const sm = await deps.projectManager.getProjectStateManager(projectPath);\n  // Nominal reads rebuild the in-memory authority from WAL only. Projection\n  // persistence remains the responsibility of explicit checkpoint/recovery paths.\n  let rebuilt_from_events = false;\n  if (typeof sm.rebuildState === 'function') {\n    await sm.rebuildState();\n    const eventCount = typeof sm.getLastReplayedEventCount === 'function'\n      ? sm.getLastReplayedEventCount()\n      : 0;\n    rebuilt_from_events = Number.isFinite(eventCount) && eventCount > 0;\n  }\n  if (workItemId === 'all') {\n    const all = await sm.getAllStates();\n    return { success: true, rebuilt_from_events, work_items: all ?? {} };\n  }\n\n  if (!workItemId) {\n    return { success: false, error: 'work_item_id required' };\n  }\n\n  const state = await sm.getState(workItemId);\n  if (!state) {\n    return { success: false, rebuilt_from_events, error: `${workItemId} not found` };\n  }\n\n  return { success: true, rebuilt_from_events, ...state };\n});\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\handlers\\sf-state-transition.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `CURRENT_RELEASE_WORKFLOW_TYPE` with `·CURRENT_RELEASE_WORKFLOW_TYPE·`","line":1,"column":9,"nodeType":null,"messageId":"replace","endLine":1,"endColumn":38,"fix":{"range":[8,37],"text":" CURRENT_RELEASE_WORKFLOW_TYPE "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"node:fs/promises\"` with `'node:fs/promises'`","line":2,"column":57,"nodeType":null,"messageId":"replace","endLine":2,"endColumn":75,"fix":{"range":[120,138],"text":"'node:fs/promises'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"node:crypto\"` with `'node:crypto'`","line":3,"column":28,"nodeType":null,"messageId":"replace","endLine":3,"endColumn":41,"fix":{"range":[167,180],"text":"'node:crypto'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"../ToolDispatcher\"` with `'../ToolDispatcher'`","line":4,"column":33,"nodeType":null,"messageId":"replace","endLine":4,"endColumn":52,"fix":{"range":[214,233],"text":"'../ToolDispatcher'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"@specforge/types/directory-layout\"` with `'@specforge/types/directory-layout'`","line":5,"column":31,"nodeType":null,"messageId