:";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":204,"column":77,"nodeType":null,"messageId":"insert","endLine":204,"endColumn":77,"fix":{"range":[4793,4793],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":205,"column":84,"nodeType":null,"messageId":"insert","endLine":205,"endColumn":84,"fix":{"range":[4877,4877],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"gate_result\"` with `'gate_result'`","line":208,"column":11,"nodeType":null,"messageId":"replace","endLine":208,"endColumn":24,"fix":{"range":[4924,4937],"text":"'gate_result'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"pass\"·|·\"fail\"·|·\"blocked\"` with `'pass'·|·'fail'·|·'blocked'`","line":212,"column":30,"nodeType":null,"messageId":"replace","endLine":212,"endColumn":57,"fix":{"range":[5059,5086],"text":"'pass' | 'fail' | 'blocked'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":215,"column":4,"nodeType":null,"messageId":"insert","endLine":215,"endColumn":4,"fix":{"range":[5167,5167],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":218,"column":41,"nodeType":null,"messageId":"insert","endLine":218,"endColumn":41,"fix":{"range":[5217,5217],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"ERROR\"` with `'ERROR'`","line":224,"column":16,"nodeType":null,"messageId":"replace","endLine":224,"endColumn":23,"fix":{"range":[5374,5381],"text":"'ERROR'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"gate_result_write_failed\"` with `'gate_result_write_failed'`","line":226,"column":16,"nodeType":null,"messageId":"replace","endLine":226,"endColumn":42,"fix":{"range":[5427,5453],"text":"'gate_result_write_failed'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":229,"column":8,"nodeType":null,"messageId":"insert","endLine":229,"endColumn":8,"fix":{"range":[5612,5612],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":230,"column":62,"nodeType":null,"messageId":"insert","endLine":230,"endColumn":62,"fix":{"range":[5674,5674],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"\\n\",·\"utf-8\")` with `'\\n',·'utf-8');`","line":231,"column":67,"nodeType":null,"messageId":"replace","endLine":231,"endColumn":81,"fix":{"range":[5741,5755],"text":"'\\n', 'utf-8');"}},{"ruleId":"@typescript-eslint/require-await","severity":2,"message":"Async function 'tryCheckCompatibility' has no 'await' expression.","line":247,"column":8,"nodeType":"FunctionDeclaration","messageId":"missingAwait","endLine":247,"endColumn":44,"suggestions":[{"messageId":"removeAsync","fix":{"range":[6186,6281],"text":"function tryCheckCompatibility(\n  _baseDir: string,\n  _component: string\n): void"},"desc":"Remove 'async'."}]},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎··_baseDir:·string,⏎··_component:·string⏎` with `_baseDir:·string,·_component:·string`","line":247,"column":45,"nodeType":null,"messageId":"replace","endLine":250,"endColumn":1,"fix":{"range":[6223,6265],"text":"_baseDir: string, _component: string"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":251,"column":9,"nodeType":null,"messageId":"insert","endLine":251,"endColumn":9,"fix":{"range":[6292,6292],"text":";"}}],"suppressedMessages":[],"errorCount":61,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":58,"fixableWarningCount":0,"source":"/**\n * SpecForge 共享工具函数\n * 提供日志写入、敏感信息脱敏、JSONL 追加写入等基础能力\n */\n\nimport { mkdir, appendFile } from \"node:fs/promises\"\nimport { dirname, join } from \"node:path\"\nimport { SPEC_DIR_NAME } from \"@specforge/types/directory-layout\"\n\n// ============================================================\n// Types\n// ============================================================\n\nexport type LogLevel = \"DEBUG\" | \"INFO\" | \"WARN\" | \"ERROR\"\n\nexport interface LogEntry {\n  timestamp: string\n  level: LogLevel\n  work_item_id: string\n  component: string\n  event: string\n  message: string\n  payload: Record<string, unknown>\n}\n\n// ============================================================\n// Sensitive Information Redaction\n// ============================================================\n\n/**\n * 敏感信息匹配模式\n * 匹配 key 名中包含以下关键词的字段\n */\nconst SENSITIVE_KEY_PATTERNS: RegExp[] = [\n  /api[_\\-]?key/i,\n  /token/i,\n  /password/i,\n  /secret/i,\n  /credential/i,\n  /auth/i,\n  /private[_\\-]?key/i,\n]\n\n/**\n * 递归脱敏对象中的敏感信息\n * 对匹配敏感模式的 key 对应的值替换为 \"[REDACTED]\"\n */\nexport function redactSensitive(obj: unknown): unknown {\n  if (obj === null || obj === undefined) {\n    return obj\n  }\n\n  if (typeof obj === \"string\") {\n    return obj\n  }\n\n  if (Array.isArray(obj)) {\n    return obj.map((item) => redactSensitive(item))\n  }\n\n  if (typeof obj === \"object\") {\n    const result: Record<string, unknown> = {}\n    for (const [key, value] of Object.entries(obj as Record<string, unknown>)) {\n      if (isSensitiveKey(key)) {\n        result[key] = \"[REDACTED]\"\n      } else {\n        result[key] = redactSensitive(value)\n      }\n    }\n    return result\n  }\n\n  return obj\n}\n\n/**\n * 判断 key 是否匹配敏感模式\n */\nfunction isSensitiveKey(key: string): boolean {\n  return SENSITIVE_KEY_PATTERNS.some((pattern) => pattern.test(key))\n}\n\n// ============================================================\n// JSONL Append\n// ============================================================\n\n/**\n * 追加一条 JSON 记录到指定文件（JSONL 格式）\n * 如果目录不存在则自动创建\n */\nexport async function appendJsonl(\n  filePath: string,\n  entry: object\n): Promise<void> {\n  const dir = dirname(filePath)\n  await mkdir(dir, { recursive: true })\n  const line = JSON.stringify(entry) + \"\\n\"\n  await appendFile(filePath, line, \"utf-8\")\n}\n\n// ============================================================\n// Log Writing\n// ============================================================\n\n/**\n * 写入结构化日志条目到指定日志文件\n * 日志以 JSONL 格式追加写入\n */\nexport async function writeLog(\n  logFile: string,\n  entry: LogEntry\n): Promise<void> {\n  // 对 payload 进行脱敏处理\n  const sanitizedEntry: LogEntry = {\n    ...entry,\n    payload: redactSensitive(entry.payload) as Record<string, unknown>,\n  }\n  await appendJsonl(logFile, sanitizedEntry)\n}\n\n/**\n * 创建一个 LogEntry 对象（便捷工厂函数）\n */\nexport function createLogEntry(\n  level: LogLevel,\n  workItemId: string,\n  component: string,\n  event: string,\n  message: string,\n  payload: Record<string, unknown> = {}\n): LogEntry {\n  return {\n    timestamp: new Date().toISOString(),\n    level,\n    work_item_id: workItemId,\n    component,\n    event,\n    message,\n    payload,\n  }\n}\n\n// ============================================================\n// Error Log Helper\n// ============================================================\n\n/**\n * 错误日志写入路径常量（相对于 baseDir）\n */\nexport const ERROR_LOG_RELATIVE_PATH = `${SPEC_DIR_NAME}/runtime/logs/error.log`\n\n/**\n * 将错误信息写入 Error_Log（specforge/logs/error.log）\n * 写入失败时静默，不抛出异常 — 日志写入失败不应影响调用方\n */\nexport async function logErrorToFile(\n  baseDir: string,\n  component: string,\n  event: string,\n  error: unknown\n): Promise<void> {\n  try {\n    const errorLogPath = join(baseDir, ERROR_LOG_RELATIVE_PATH)\n    // Ensure directory exists\n    const dir = join(baseDir, SPEC_DIR_NAME, 'runtime', 'logs')\n    await mkdir(dir, { recursive: true })\n    // Write error entry\n    await appendJsonl(errorLogPath, {\n      timestamp: new Date().toISOString(),\n      level: \"ERROR\",\n      component,\n      event,\n      message: error instanceof Error ? error.message : String(error),\n    })\n  } catch {\n    // Silently swallow — log write failure must not affect caller\n  }\n}\n\n// ============================================================\n// Gate Result Recording\n// ============================================================\n\nexport interface GateResultEntry {\n  type: \"gate_result\"\n  timestamp: string\n  work_item_id: string\n  gate: string\n  status: \"pass\" | \"fail\" | \"blocked\"\n  blocking_issues: string[]\n  warnings: string[]\n}\n\n/**\n * 记录 Gate 结果到 events.jsonl\n * 如果写入失败，记录错误到 error.log 但不阻塞工作流\n */\nexport async function recordGateResult(\n  workItemId: string,\n  gateName: string,\n  result: { status: string; blocking_issues: string[]; warnings: string[] },\n  baseDir: string\n): Promise<void> {\n  const eventsPath = join(baseDir, SPEC_DIR_NAME, 'runtime', 'events.jsonl')\n  const errorLogPath = join(baseDir, SPEC_DIR_NAME, 'runtime', 'logs', 'error.log')\n\n  const entry: GateResultEntry = {\n    type: \"gate_result\",\n    timestamp: new Date().toISOString(),\n    work_item_id: workItemId,\n    gate: gateName,\n    status: result.status as \"pass\" | \"fail\" | \"blocked\",\n    blocking_issues: result.blocking_issues,\n    warnings: result.warnings,\n  }\n\n  try {\n    await appendJsonl(eventsPath, entry)\n  } catch (err) {\n    // 写入 events.jsonl 失败时，记录到 error.log\n    try {\n      const errorEntry = {\n        timestamp: new Date().toISOString(),\n        level: \"ERROR\",\n        component: gateName,\n        event: \"gate_result_write_failed\",\n        message: `Failed to write gate result: ${(err as Error).message}`,\n        payload: { work_item_id: workItemId, gate_status: result.status },\n      }\n      await mkdir(dirname(errorLogPath), { recursive: true })\n      await appendFile(errorLogPath, JSON.stringify(errorEntry) + \"\\n\", \"utf-8\")\n    } catch {\n      // 完全静默\n    }\n  }\n}\n\n// ============================================================\n// Current Release Compatibility Boundary\n// ============================================================\n\n/**\n * Current releases have one supported project and user-level layout.\n * Callers retain this hook while the tool surface converges, but it must not\n * discover or execute retired compatibility adapters.\n */\nexport async function tryCheckCompatibility(\n  _baseDir: string,\n  _component: string\n): Promise<void> {\n  return\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\verification-evidence-integrity.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"@specforge/types/directory-layout\"` with `'@specforge/types/directory-layout'`","line":1,"column":31,"nodeType":null,"messageId":"replace","endLine":1,"endColumn":66,"fix":{"range":[30,65],"text":"'@specforge/types/directory-layout'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·inspectExecutionEvidence,·type·ExecutionEvidenceConsumer·` with `⏎··inspectExecutionEvidence,⏎··type·ExecutionEvidenceConsumer,⏎`","line":7,"column":9,"nodeType":null,"messageId":"replace","endLine":7,"endColumn":67,"fix":{"range":[321,379],"text":"\n  inspectExecutionEvidence,\n  type ExecutionEvidenceConsumer,\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":24,"column":95,"nodeType":null,"messageId":"insert","endLine":24,"endColumn":95,"fix":{"range":[1085,1085],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `await·new·WAL(path.join(projectRoot,·SPEC_DIR_NAME,·'runtime',·'events.jsonl')).readAllEvents()` with `⏎······await·new·WAL(⏎········path.join(projectRoot,·SPEC_DIR_NAME,·'runtime',·'events.jsonl')⏎······).readAllEvents()⏎····`","line":32,"column":15,"nodeType":null,"messageId":"replace","endLine":32,"endColumn":110,"fix":{"range":[1323,1418],"text":"\n      await new WAL(\n        path.join(projectRoot, SPEC_DIR_NAME, 'runtime', 'events.jsonl')\n      ).readAllEvents()\n    "}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":38,"column":21,"nodeType":"TSNonNullExpression","messageId":"unnecessaryAssertion","endLine":38,"endColumn":35,"fix":{"range":[1565,1566],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `event.projectId·!==·workItemId·||` with `⏎········event.projectId·!==·workItemId·||⏎·······`","line":39,"column":11,"nodeType":null,"messageId":"replace","endLine":39,"endColumn":44,"fix":{"range":[1578,1611],"text":"\n        event.projectId !== workItemId ||\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `··event.payload?.to_state·!==·'closed')` with `event.payload?.to_state·!==·'closed'⏎······)⏎·······`","line":40,"column":9,"nodeType":null,"messageId":"replace","endLine":40,"endColumn":48,"fix":{"range":[1659,1698],"text":"event.payload?.to_state !== 'closed'\n      )\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·?·await·readCloseEventAt(input.projectRoot,·input.workItemId)` with `⏎······?·await·readCloseEventAt(input.projectRoot,·input.workItemId)⏎·····`","line":67,"column":33,"nodeType":null,"messageId":"replace","endLine":67,"endColumn":95,"fix":{"range":[2817,2879],"text":"\n      ? await readCloseEventAt(input.projectRoot, input.workItemId)\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·reasons.push(`${name}_timestamp_after_${input.closed·&&·result.close_event_at·?·'close'·:·'runtime'}`` with `⏎······reasons.push(⏎········`${name}_timestamp_after_${input.closed·&&·result.close_event_at·?·'close'·:·'runtime'}`⏎······`","line":92,"column":35,"nodeType":null,"messageId":"replace","endLine":92,"endColumn":137,"fix":{"range":[3839,3941],"text":"\n      reasons.push(\n        `${name}_timestamp_after_${input.closed && result.close_event_at ? 'close' : 'runtime'}`\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `...await·inspectExecutionEvidence({projectRoot:input.projectRoot,workItemId:input.workItemId,report,` with `⏎····...(await·inspectExecutionEvidence({⏎······projectRoot:·input.projectRoot,⏎······workItemId:·input.workItemId,⏎······report,⏎······`","line":96,"column":16,"nodeType":null,"messageId":"replace","endLine":96,"endColumn":116,"fix":{"range":[4129,4229],"text":"\n    ...(await inspectExecutionEvidence({\n      projectRoot: input.projectRoot,\n      workItemId: input.workItemId,\n      report,\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `consumer:input.executionEvidenceConsumer,historicalClosed:input.closed})` with `··consumer:·input.executionEvidenceConsumer,⏎······historicalClosed:·input.closed,⏎····}))⏎··`","line":97,"column":5,"nodeType":null,"messageId":"replace","endLine":97,"endColumn":77,"fix":{"range":[4243,4315],"text":"  consumer: input.executionEvidenceConsumer,\n      historicalClosed: input.closed,\n    }))\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·reasons.push(`evidence_entry_${field}_after_${input.closed·&&·result.close_event_at·?·'close'·:·'runtime'}:${entryId}`` with `⏎··········reasons.push(⏎············`evidence_entry_${field}_after_${input.closed·&&·result.close_event_at·?·'close'·:·'runtime'}:${entryId}`⏎··········`","line":105,"column":39,"nodeType":null,"messageId":"replace","endLine":105,"endColumn":158,"fix":{"range":[4772,4891],"text":"\n          reasons.push(\n            `evidence_entry_${field}_after_${input.closed && result.close_event_at ? 'close' : 'runtime'}:${entryId}`\n          "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `!entry·||·typeof·entry·!==·'object'·||` with `⏎······!entry·||⏎······typeof·entry·!==·'object'·||⏎·····`","line":108,"column":9,"nodeType":null,"messageId":"replace","endLine":108,"endColumn":47,"fix":{"range":[4916,4954],"text":"\n      !entry ||\n      typeof entry !== 'object' ||\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `··entry.level·!==·'L5'·||·entry.evidence_type·!==·'manual_acceptance')` with `entry.level·!==·'L5'·||⏎······entry.evidence_type·!==·'manual_acceptance'⏎····)⏎·····`","line":109,"column":7,"nodeType":null,"messageId":"replace","endLine":109,"endColumn":77,"fix":{"range":[4990,5060],"text":"entry.level !== 'L5' ||\n      entry.evidence_type !== 'manual_acceptance'\n    )\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `!relative·||·path.isAbsolute(relative)·||·parts.includes('..')·||` with `⏎······!relative·||⏎······path.isAbsolute(relative)·||⏎······parts.includes('..')·||⏎·····`","line":113,"column":9,"nodeType":null,"messageId":"replace","endLine":113,"endColumn":74,"fix":{"range":[5252,5317],"text":"\n      !relative ||\n      path.isAbsolute(relative) ||\n      parts.includes('..') ||\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `··!relative.startsWith((`${SPEC_DIR_NAME}/work-items/`·as·const))·&&·!relative.startsWith('evidence/')` with `(!relative.startsWith(`${SPEC_DIR_NAME}/work-items/`·as·const)·&&⏎········!relative.startsWith('evidence/'))⏎····`","line":114,"column":7,"nodeType":null,"messageId":"replace","endLine":114,"endColumn":109,"fix":{"range":[5347,5449],"text":"(!relative.startsWith(`${SPEC_DIR_NAME}/work-items/` as const) &&\n        !relative.startsWith('evidence/'))\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `projectRelative.startsWith('..')·||` with `⏎······projectRelative.startsWith('..')·||⏎·····`","line":123,"column":9,"nodeType":null,"messageId":"replace","endLine":123,"endColumn":44,"fix":{"range":[5821,5856],"text":"\n      projectRelative.startsWith('..') ||\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `········[reportPath,·manifestPath].some(candidate·=>·samePath(candidate,·resolved))` with `······[reportPath,·manifestPath].some(candidate·=>·samePath(candidate,·resolved))⏎····`","line":124,"column":1,"nodeType":null,"messageId":"replace","endLine":124,"endColumn":84,"fix":{"range":[5893,5976],"text":"      [reportPath, manifestPath].some(candidate => samePath(candidate, resolved))\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·String(value).replace(/^sha256:/i,·'').toLowerCase()` with `⏎··········String(value)⏎············.replace(/^sha256:/i,·'')⏎············.toLowerCase()⏎········`","line":143,"column":22,"nodeType":null,"messageId":"replace","endLine":143,"endColumn":75,"fix":{"range":[6844,6897],"text":"\n          String(value)\n            .replace(/^sha256:/i, '')\n            .toLowerCase()\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `declared.length·===·0·||·declared.some(expected·=>⏎········!/^[0-9a-f]{64}$/.test(expected)·||·expected·!==·actual)` with `⏎········declared.length·===·0·||⏎········declared.some(expected·=>·!/^[0-9a-f]{64}$/.test(expected)·||·expected·!==·actual)⏎······`","line":145,"column":11,"nodeType":null,"messageId":"replace","endLine":146,"endColumn":65,"fix":{"range":[6966,7081],"text":"\n        declared.length === 0 ||\n        declared.some(expected => !/^[0-9a-f]{64}$/.test(expected) || expected !== actual)\n      "}}],"suppressedMessages":[],"errorCount":20,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":20,"fixableWarningCount":0,"source":"import { SPEC_DIR_NAME } from \"@specforge/types/directory-layout\";\nimport * as fs from 'node:fs/promises';\nimport * as path from 'node:path';\nimport { createHash } from 'node:crypto';\nimport { extractStructuredVerificationReport } from './verification-report-contract.js';\nimport { WAL } from '../../wal/WAL.js';\nimport { inspectExecutionEvidence, type ExecutionEvidenceConsumer } from '../../verification/execution-evidence-consumer';\n\nexport interface VerificationEvidenceIntegrity {\n  invalidity_reasons: string[];\n  report_sha256: string | null;\n  manifest_sha256: string | null;\n  close_event_at: string | null;\n}\n\nconst hash = (bytes: Uint8Array): string => createHash('sha256').update(bytes).digest('hex');\nconst samePath = (left: string, right: string): boolean => {\n  const a = path.resolve(left);\n  const b = path.resolve(right);\n  return process.platform === 'win32' ? a.toLowerCase() === b.toLowerCase() : a === b;\n};\n\nfunction parseDeclaredTime(value: unknown): number | null {\n  if (typeof value !== 'string' || !/^\\d{4}-\\d\\d-\\d\\dT\\d\\d:\\d\\d:\\d\\d(?:\\.\\d+)?Z$/.test(value)) return null;\n  const parsed = Date.parse(value);\n  return Number.isFinite(parsed) ? parsed : null;\n}\n\nasync function readCloseEventAt(projectRoot: string, workItemId: string): Promise<string | null> {\n  let events;\n  try {\n    events = (await new WAL(path.join(projectRoot, SPEC_DIR_NAME, 'runtime', 'events.jsonl')).readAllEvents()).events;\n  } catch {\n    return null;\n  }\n  for (let index = events.length - 1; index >= 0; index--) {\n    try {\n      const event = events[index]!;\n      if (event.projectId !== workItemId || event.action !== 'state.transition' ||\n          event.payload?.to_state !== 'closed') continue;\n      const milliseconds = Number(event.ts);\n      return Number.isFinite(milliseconds) ? new Date(milliseconds).toISOString() : null;\n    } catch {\n      // A malformed unrelated event cannot be used as a timestamp proof.\n    }\n  }\n  return null;\n}\n\nexport async function inspectVerificationEvidenceIntegrity(input: {\n  projectRoot: string;\n  workItemDir: string;\n  workItemId: string;\n  closed?: boolean;\n  now?: Date;\n  executionEvidenceConsumer?: ExecutionEvidenceConsumer;\n}): Promise<VerificationEvidenceIntegrity> {\n  const reportPath = path.join(input.workItemDir, 'verification_report.md');\n  const manifestPath = path.join(input.workItemDir, 'evidence', 'evidence_manifest.json');\n  const reasons: string[] = [];\n  const reportBytes = await fs.readFile(reportPath).catch(() => null);\n  const manifestBytes = await fs.readFile(manifestPath).catch(() => null);\n  const result: VerificationEvidenceIntegrity = {\n    invalidity_reasons: reasons,\n    report_sha256: reportBytes ? hash(reportBytes) : null,\n    manifest_sha256: manifestBytes ? hash(manifestBytes) : null,\n    close_event_at: input.closed ? await readCloseEventAt(input.projectRoot, input.workItemId) : null,\n  };\n  if (input.closed && !result.close_event_at) reasons.push('authoritative_close_event_unavailable');\n  if (!reportBytes || !manifestBytes) {\n    reasons.push('verification_evidence_missing');\n    return result;\n  }\n  const report = extractStructuredVerificationReport(reportBytes.toString('utf-8'));\n  let manifest: Record<string, any>;\n  try {\n    manifest = JSON.parse(manifestBytes.toString('utf-8'));\n  } catch {\n    reasons.push('evidence_manifest_invalid_json');\n    return result;\n  }\n  const latestAllowed = result.close_event_at\n    ? Date.parse(result.close_event_at)\n    : (input.now ?? new Date()).getTime();\n  for (const [name, value] of [\n    ['verification_report', report?.timestamp],\n    ['evidence_manifest', manifest.timestamp],\n  ] as const) {\n    if (value === undefined) continue;\n    const time = parseDeclaredTime(value);\n    if (time === null) reasons.push(`${name}_timestamp_invalid`);\n    else if (time > latestAllowed) reasons.push(`${name}_timestamp_after_${input.closed && result.close_event_at ? 'close' : 'runtime'}`);\n  }\n  if (!Array.isArray(manifest.entries)) reasons.push('evidence_manifest_entries_missing');\n  const entries = Array.isArray(manifest.entries) ? manifest.entries : [];\n  reasons.push(...await inspectExecutionEvidence({projectRoot:input.projectRoot,workItemId:input.workItemId,report,manifest,\n    consumer:input.executionEvidenceConsumer,historicalClosed:input.closed}));\n  for (const entry of entries) {\n    if (entry && typeof entry === 'object') {\n      const entryId = String(entry.evidence_id ?? entry.id ?? 'unknown');\n      for (const field of ['timestamp', 'created_at', 'recorded_at']) {\n        if (entry[field] === undefined) continue;\n        const time = parseDeclaredTime(entry[field]);\n        if (time === null) reasons.push(`evidence_entry_${field}_invalid:${entryId}`);\n        else if (time > latestAllowed) reasons.push(`evidence_entry_${field}_after_${input.closed && result.close_event_at ? 'close' : 'runtime'}:${entryId}`);\n      }\n    }\n    if (!entry || typeof entry !== 'object' || entry.status !== 'passed' ||\n        entry.level !== 'L5' || entry.evidence_type !== 'manual_acceptance') continue;\n    const id = String(entry.evidence_id ?? entry.id ?? 'unknown');\n    const relative = String(entry.path ?? '').replace(/\\\\/g, '/');\n    const parts = relative.split('/');\n    if (!relative || path.isAbsolute(relative) || parts.includes('..') || parts.includes('.') ||\n        !relative.startsWith((`${SPEC_DIR_NAME}/work-items/` as const)) && !relative.startsWith('evidence/')) {\n      reasons.push(`manual_acceptance_source_invalid:${id}`);\n      continue;\n    }\n    const source = relative.startsWith('evidence/')\n      ? path.join(input.workItemDir, relative)\n      : path.join(input.projectRoot, relative);\n    const resolved = path.resolve(source);\n    const projectRelative = path.relative(path.resolve(input.projectRoot), resolved);\n    if (projectRelative.startsWith('..') || path.isAbsolute(projectRelative) ||\n        [reportPath, manifestPath].some(candidate => samePath(candidate, resolved))) {\n      reasons.push(`manual_acceptance_source_self_referential_or_outside:${id}`);\n      continue;\n    }\n    try {\n      const stat = await fs.lstat(resolved);\n      if (!stat.isFile() || stat.isSymbolicLink()) throw new Error('not a regular file');\n      const real = await fs.realpath(resolved);\n      const realRelative = path.relative(path.resolve(input.projectRoot), real);\n      if (realRelative.startsWith('..') || path.isAbsolute(realRelative)) {\n        reasons.push(`manual_acceptance_source_outside_project:${id}`);\n        continue;\n      }\n      if ([reportPath, manifestPath].some(candidate => samePath(candidate, real))) {\n        reasons.push(`manual_acceptance_source_self_referential_or_outside:${id}`);\n        continue;\n      }\n      const declared = [entry.sha256, entry.hash]\n        .filter(value => value !== undefined)\n        .map(value => String(value).replace(/^sha256:/i, '').toLowerCase());\n      const actual = hash(await fs.readFile(resolved));\n      if (declared.length === 0 || declared.some(expected =>\n        !/^[0-9a-f]{64}$/.test(expected) || expected !== actual)) {\n        reasons.push(`manual_acceptance_source_hash_mismatch:${id}`);\n      }\n    } catch {\n      reasons.push(`manual_acceptance_source_missing:${id}`);\n    }\n  }\n  return result;\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\verification-evidence-v11.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":24,"column":41,"nodeType":null,"messageId":"insert","endLine":24,"endColumn":41,"fix":{"range":[892,892],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":25,"column":39,"nodeType":null,"messageId":"insert","endLine":25,"endColumn":39,"fix":{"range":[931,931],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":26,"column":30,"nodeType":null,"messageId":"insert","endLine":26,"endColumn":30,"fix":{"range":[961,961],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":27,"column":55,"nodeType":null,"messageId":"insert","endLine":27,"endColumn":55,"fix":{"range":[1016,1016],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":28,"column":47,"nodeType":null,"messageId":"insert","endLine":28,"endColumn":47,"fix":{"range":[1063,1063],"text":";"}},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'readFile' is defined but never used. Allowed unused vars must match /^_/u.","line":30,"column":10,"nodeType":"Identifier","messageId":"unusedVar","endLine":30,"endColumn":18,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"readFile"},"fix":{"range":[1074,1083],"text":""},"desc":"Remove unused variable \"readFile\"."}]},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":137,"column":17,"nodeType":null,"messageId":"delete","endLine":137,"endColumn":18,"fix":{"range":[4244,4245],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":175,"column":21,"nodeType":null,"messageId":"delete","endLine":175,"endColumn":22,"fix":{"range":[5225,5226],"text":""}}],"suppressedMessages":[],"errorCount":8,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":7,"fixableWarningCount":0,"source":"/**\n * verification-evidence-v11 — §13 Trace、Verification 与 Evidence\n *\n * §13.1 Trace 必须贯穿：REQ → AC → DD → TASK → FILE → TEST → EVIDENCE\n * §13.2 trace_delta.md：说明 WI 对 Trace 的影响\n * §13.3 verification_report.md：证明验证结论，不得只写\"已验证\"\n * §13.4 evidence_manifest.json：Evidence 清单\n *\n * 本模块提供：\n *   - trace_delta.md 校验\n *   - verification_report.md 校验（via verification-report.ts）\n *   - evidence_manifest.json 校验（via evidence-manifest.ts）\n *   - trace 完整性检查\n *\n * Re-exports from extracted sub-modules (TASK-6):\n *   - evidence.ts: core trace types (TraceEntry, TraceDelta, TraceValidationResult)\n *   - verification-report.ts: VerificationReport + validateVerificationReport\n *   - evidence-manifest.ts: EvidenceManifest + validateEvidenceManifest\n *\n * Re-exports from extracted sub-modules (TASK-3):\n *   - close-gate.ts: CloseGateResult, runCloseGate\n */\n\nexport * from './verification-report.js'\nexport * from './evidence-manifest.js'\nexport * from './evidence.js'\nexport type { CloseGateResult } from './close-gate.js'\nexport { runCloseGate } from './close-gate.js'\n\nimport { readFile, writeFile, mkdir } from 'node:fs/promises';\nimport { join } from 'node:path';\nimport type { TraceEntry, TraceDelta, TraceValidationResult } from './evidence.js';\nimport {\n  evidenceManifestSchemaBlockCode,\n  precheckEvidenceManifestSchema,\n  type EvidenceManifest,\n} from './evidence-manifest.js';\n\n// Re-export types locally so existing consumers see no breakage\n// (already covered by `export *` above, but kept for documentation clarity)\n\n// ── Trace Delta Validation ──\n\n/**\n * 校验 trace_delta.md 内容。\n * §13.1: Trace 不变也必须写 \"Trace Impact: none\"。\n */\nexport function validateTraceDelta(content: string): TraceValidationResult {\n  const errors: string[] = [];\n  const warnings: string[] = [];\n\n  if (!content || content.trim().length === 0) {\n    return { valid: false, errors: ['trace_delta.md must not be empty (§13.1)'], warnings };\n  }\n\n  const lower = content.toLowerCase();\n\n  // Must have Trace Impact section\n  if (!lower.includes('trace impact') && !lower.includes('impact')) {\n    errors.push('trace_delta.md must include Trace Impact section (§13.1)');\n  }\n\n  // \"none\" is a valid impact type\n  if (lower.includes('trace impact: none') || lower.includes('impact: none')) {\n    // Valid: explicitly stated no impact\n    if (!lower.includes('reason')) {\n      warnings.push('Trace Impact is none but no Reason provided (§13.2: must state reason)');\n    }\n  }\n\n  return { valid: errors.length === 0, errors, warnings };\n}\n\n// ── Full Trace Chain Check ──\n\nexport interface TraceChainResult {\n  complete: boolean;\n  coverage: Record<string, 'covered' | 'partial' | 'missing'>;\n  gaps: string[];\n}\n\n/**\n * 检查 Trace 链路完整性（§13.1: REQ→AC→DD→TASK→FILE→TEST→EVIDENCE）。\n */\nexport function checkTraceChain(entries: TraceEntry[]): TraceChainResult {\n  const gaps: string[] = [];\n  const coverage: Record<string, 'covered' | 'partial' | 'missing'> = {\n    req_to_ac: 'covered',\n    ac_to_dd: 'covered',\n    dd_to_task: 'covered',\n    task_to_file: 'covered',\n    file_to_test: 'covered',\n    test_to_evidence: 'covered',\n  };\n\n  for (const entry of entries) {\n    if (entry.ac_ids.length === 0) {\n      coverage.req_to_ac = 'partial';\n      gaps.push(`${entry.req_id}: no AC linked`);\n    }\n    if (entry.dd_ids.length === 0) {\n      coverage.ac_to_dd = 'partial';\n      gaps.push(`${entry.req_id}: no DD linked`);\n    }\n    if (entry.task_ids.length === 0) {\n      coverage.dd_to_task = 'partial';\n      gaps.push(`${entry.req_id}: no TASK linked`);\n    }\n    if (entry.file_paths.length === 0) {\n      coverage.task_to_file = 'partial';\n      gaps.push(`${entry.req_id}: no file linked`);\n    }\n    if (entry.test_ids.length === 0) {\n      coverage.file_to_test = 'partial';\n      gaps.push(`${entry.req_id}: no test linked`);\n    }\n    if (entry.evidence_ids.length === 0) {\n      coverage.test_to_evidence = 'partial';\n      gaps.push(`${entry.req_id}: no evidence linked`);\n    }\n  }\n\n  const complete = gaps.length === 0;\n\n  return { complete, coverage, gaps };\n}\n\n// ── File Writers ──\n\n/**\n * 生成 trace_delta.md 模板。\n */\nexport async function writeTraceDeltaTemplate(\n  wiDir: string,\n  workItemId: string,\n  impact: TraceDelta['impact'],\n  reason: string,\n): Promise<string> {\n  const lines: string[] = [\n    '# Trace Delta',\n    '',\n    `**Work Item**: ${workItemId}`,\n    '',\n    '## Trace Impact',\n    '',\n    impact === 'none' ? 'none' : impact,\n    '',\n    '## Reason',\n    '',\n    reason,\n    '',\n    '## Trace Entries',\n    '',\n    '| REQ | AC | DD | TASK | FILE | TEST | EVIDENCE |',\n    '|-----|----|----|------|------|------|----------|',\n    '| (to be filled) | | | | | | |',\n    '',\n    `## Module Trace Update Required: ${impact !== 'none' ? 'Yes' : 'No'}`,\n    `## Project Trace Matrix Update Required: ${impact !== 'none' ? 'Yes' : 'No'}`,\n    '',\n  ];\n\n  const candidateDir = join(wiDir, 'candidates');\n  await mkdir(candidateDir, { recursive: true });\n  const filePath = join(candidateDir, 'trace_delta.md');\n  await writeFile(filePath, lines.join('\\n'), 'utf-8');\n  return filePath;\n}\n\n/**\n * 生成 evidence_manifest.json 模板。\n */\nexport async function writeEvidenceManifestTemplate(\n  wiDir: string,\n  workItemId: string,\n): Promise<string> {\n  const schemaPrecheck = await precheckEvidenceManifestSchema(wiDir, workItemId);\n  const schemaBlockCode = evidenceManifestSchemaBlockCode(schemaPrecheck);\n  if (schemaBlockCode) {\n    throw new Error(`EVIDENCE_MANIFEST_SCHEMA_BLOCKED: ${schemaBlockCode}`);\n  }\n  const manifest: EvidenceManifest = {\n    schema_version: '1.0',\n    work_item_id: workItemId,\n    entries: [],\n  };\n\n  await mkdir(wiDir, { recursive: true });\n  const evidenceDir = join(wiDir, 'evidence');\n  await mkdir(evidenceDir, { recursive: true });\n  const filePath = join(evidenceDir, 'evidence_manifest.json');\n  await writeFile(filePath, JSON.stringify(manifest, null, 2) + '\\n', 'utf-8');\n  return filePath;\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\verification-governance-contract.ts","messages":[{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'value ?? ''' will use Object's default stringification format ('[object Object]') when stringified.","line":47,"column":17,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":47,"endColumn":28},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":216,"column":23,"nodeType":null,"messageId":"delete","endLine":216,"endColumn":24,"fix":{"range":[7580,7581],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `·`","line":230,"column":31,"nodeType":null,"messageId":"insert","endLine":230,"endColumn":31,"fix":{"range":[8164,8164],"text":" "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":237,"column":17,"nodeType":null,"messageId":"insert","endLine":237,"endColumn":17,"fix":{"range":[8440,8440],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `path.resolve(input.workItemDir,·'..',·'..',·'..'),·input.workItemDir,·auditText` with `⏎····path.resolve(input.workItemDir,·'..',·'..',·'..'),⏎····input.workItemDir,⏎····auditText⏎··`","line":337,"column":59,"nodeType":null,"messageId":"replace","endLine":337,"endColumn":138,"fix":{"range":[12743,12822],"text":"\n    path.resolve(input.workItemDir, '..', '..', '..'),\n    input.workItemDir,\n    auditText\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·check_id:·'verification_write_guard_audit_current',·description:·'Changed·Files·Audit·covers·current·Write·Guard·and·resolution·evidence',·passed:·guardAuditBinding.passed,·severity:·guardAuditBinding.passed·?·undefined·:·'error',·details:·guardAuditBinding.reason` with `⏎····check_id:·'verification_write_guard_audit_current',⏎····description:·'Changed·Files·Audit·covers·current·Write·Guard·and·resolution·evidence',⏎····passed:·guardAuditBinding.passed,⏎····severity:·guardAuditBinding.passed·?·undefined·:·'error',⏎····details:·guardAuditBinding.reason,⏎·`","line":338,"column":16,"nodeType":null,"messageId":"replace","endLine":338,"endColumn":281,"fix":{"range":[12840,13105],"text":"\n    check_id: 'verification_write_guard_audit_current',\n    description: 'Changed Files Audit covers current Write Guard and resolution evidence',\n    passed: guardAuditBinding.passed,\n    severity: guardAuditBinding.passed ? undefined : 'error',\n    details: guardAuditBinding.reason,\n "}}],"suppressedMessages":[],"errorCount":6,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":5,"fixableWarningCount":0,"source":"/**\n * verification-governance-contract.ts\n *\n * Deterministic §13.5 verification checks shared by verification_gate tests and\n * the active v1.1 gate runner. This is the enforcement bridge between verifier\n * output, Evidence Manifest, Semantic Closure, and state advancement.\n */\n\nimport * as fs from 'node:fs/promises';\nimport * as path from 'node:path';\nimport type { GateReportCheck } from './gate-report.js';\nimport {\n  evidenceManifestSchemaBlockCode,\n  precheckEvidenceManifestSchema,\n} from './evidence-manifest.js';\nimport {\n  validateSemanticClosure,\n  type SemanticClosureManifest,\n  type SemanticEvidence,\n} from './semantic-closure-core.js';\nimport { validateSemanticClosureProvenance } from './semantic-closure-provenance.js';\nimport { evaluateChangedFilesAuditVerdict } from './changed-files-audit-verdict.js';\nimport { inspectWriteGuardAuditBinding } from './write-guard-audit-binding.js';\nimport {\n  extractStructuredVerificationReport,\n  validateVerificationReportContract,\n  VERIFICATION_REPORT_CONTRACT_ID,\n} from './verification-report-contract.js';\nimport { inspectVerificationEvidenceIntegrity } from './verification-evidence-integrity.js';\n\nexport { extractStructuredVerificationReport } from './verification-report-contract.js';\n\nconst PASS_STATUSES = new Set(['pass', 'passed', 'success', 'succeeded']);\nconst NON_BLOCKING_TEST_STATUSES = new Set([\n  ...PASS_STATUSES,\n  'skip',\n  'skipped',\n  'not_applicable',\n  'not-applicable',\n]);\n\nfunction isRecord(value: unknown): value is Record<string, any> {\n  return typeof value === 'object' && value !== null && !Array.isArray(value);\n}\n\nfunction normalize(value: unknown): string {\n  return String(value ?? '')\n    .trim()\n    .toLowerCase();\n}\n\nasync function readText(filePath: string): Promise<string | null> {\n  try {\n    return await fs.readFile(filePath, 'utf-8');\n  } catch {\n    return null;\n  }\n}\n\nasync function readJson<T>(filePath: string): Promise<T | null> {\n  try {\n    return JSON.parse(await fs.readFile(filePath, 'utf-8')) as T;\n  } catch {\n    return null;\n  }\n}\n\nfunction verificationExecutionStatuses(report: Record<string, any> | null): string[] {\n  if (!report) return [];\n  const commandStatuses = Array.isArray(report.verification_commands)\n    ? report.verification_commands\n        .filter(isRecord)\n        .map(command => normalize(command.status))\n        .filter(Boolean)\n    : [];\n  const matrixStatuses = isRecord(report.test_matrix)\n    ? Object.values(report.test_matrix).map(normalize).filter(Boolean)\n    : [];\n  return [...commandStatuses, ...matrixStatuses];\n}\n\nfunction reportClaims(\n  report: Record<string, any> | null,\n  field: 'acceptance_criteria' | 'e2e_tests' | 'contract_reviews'\n): Record<string, any>[] {\n  return Array.isArray(report?.[field]) ? report[field].filter(isRecord) : [];\n}\n\nfunction evidenceEntries(manifest: Record<string, any> | null): Record<string, any>[] {\n  if (!manifest) return [];\n  if (Array.isArray(manifest.entries)) return manifest.entries.filter(isRecord);\n  if (Array.isArray(manifest.evidence)) return manifest.evidence.filter(isRecord);\n  return [];\n}\n\nfunction evidenceId(value: Record<string, any>): string {\n  return String(value.id ?? value.evidence_id ?? '').trim();\n}\n\nfunction refs(value: unknown): string[] {\n  return Array.isArray(value)\n    ? value.filter(item => typeof item === 'string' && item.trim()).map(item => item.trim())\n    : [];\n}\n\nfunction evidenceTargets(value: Record<string, any> | SemanticEvidence): Set<string> {\n  return new Set([\n    ...refs(value.supports),\n    ...refs(value.outcome_refs),\n    ...refs(value.requirement_refs),\n    ...refs(value.design_refs),\n    ...refs(value.task_refs),\n  ]);\n}\n\nfunction evidenceManifestAlignment(\n  semanticManifest: SemanticClosureManifest | null,\n  manifest: Record<string, any> | null\n): string[] {\n  const errors: string[] = [];\n  const entries = evidenceEntries(manifest);\n  const byId = new Map(entries.map(entry => [evidenceId(entry), entry]));\n  for (const semanticEvidence of Array.isArray(semanticManifest?.evidence)\n    ? semanticManifest.evidence\n    : []) {\n    const entry = byId.get(semanticEvidence.id);\n    if (!entry) {\n      errors.push(`${semanticEvidence.id} is absent from evidence_manifest entries.`);\n      continue;\n    }\n    if (!PASS_STATUSES.has(normalize(entry.status ?? entry.result))) {\n      errors.push(`${semanticEvidence.id} is not passed in evidence_manifest.`);\n    }\n\n    const manifestLevel = normalize(entry.level ?? entry.evidence_level);\n    const semanticLevel = normalize(semanticEvidence.level);\n    if (!manifestLevel || manifestLevel !== semanticLevel) {\n      errors.push(`${semanticEvidence.id} level differs from evidence_manifest.`);\n    }\n\n    const manifestType = normalize(entry.evidence_type ?? entry.type);\n    const semanticType = normalize(semanticEvidence.evidence_type);\n    if (!manifestType || manifestType !== semanticType) {\n      errors.push(`${semanticEvidence.id} type differs from evidence_manifest.`);\n    }\n\n    const declaredTargets = evidenceTargets(entry);\n    for (const target of evidenceTargets(semanticEvidence)) {\n      if (!declaredTargets.has(target)) {\n        errors.push(\n          `${semanticEvidence.id} claims target ${target} that evidence_manifest does not declare.`\n        );\n      }\n    }\n  }\n  return errors;\n}\n\nfunction reportEvidenceAlignment(\n  report: Record<string, any> | null,\n  manifest: Record<string, any> | null\n): string[] {\n  const errors: string[] = [];\n  const manifestIds = new Set(evidenceEntries(manifest).map(evidenceId).filter(Boolean));\n  const claims = [\n    ...reportClaims(report, 'acceptance_criteria').map((claim, index) => ({\n      label: `acceptance_criteria[${index}]`,\n      claim,\n    })),\n    ...reportClaims(report, 'e2e_tests').map((claim, index) => ({\n      label: `e2e_tests[${index}]`,\n      claim,\n    })),\n    ...reportClaims(report, 'contract_reviews').map((claim, index) => ({\n      label: `contract_reviews[${index}]`,\n      claim,\n    })),\n  ];\n\n  for (const { label, claim } of claims) {\n    const declaredRefs = new Set([\n      ...refs(claim.evidence_refs),\n      ...refs(claim.evidence),\n      ...(typeof claim.evidence === 'string'\n        ? [...manifestIds].filter(id => claim.evidence.includes(id))\n        : []),\n    ]);\n    if (declaredRefs.size === 0) {\n      errors.push(`${label} has no registered Evidence reference.`);\n      continue;\n    }\n    for (const ref of declaredRefs) {\n      if (!manifestIds.has(ref)) {\n        errors.push(`${label} references unknown Evidence ${ref}.`);\n      }\n    }\n  }\n  return errors;\n}\n\nexport async function evaluateVerificationGovernanceContract(input: {\n  executionEvidenceConsumer?: import('../../verification/execution-evidence-consumer').ExecutionEvidenceConsumer;\n  workItemDir: string;\n  workItemId?: string;\n  workflowType?: string;\n}): Promise<{ checks: GateReportCheck[]; inputFiles: string[] }> {\n  const reportPath = path.join(input.workItemDir, 'verification_report.md');\n  const evidencePath = path.join(input.workItemDir, 'evidence', 'evidence_manifest.json');\n  const auditPath = path.join(input.workItemDir, 'changed_files_audit.md');\n  const closurePath = path.join(input.workItemDir, '.semantic_closure.json');\n  const reportText = await readText(reportPath);\n  const structuredReport = reportText ? extractStructuredVerificationReport(reportText) : null;\n  const evidenceWorkItemId = input.workItemId ?? path.basename(input.workItemDir);\n  const evidenceSchemaPrecheck = await precheckEvidenceManifestSchema(\n    input.workItemDir,\n    evidenceWorkItemId,\n  );\n  const evidenceSchemaBlockCode = evidenceManifestSchemaBlockCode(evidenceSchemaPrecheck);\n  const evidenceManifest = evidenceSchemaBlockCode\n    ? null\n    : await readJson<Record<string, any>>(evidencePath);\n  const auditText = await readText(auditPath);\n  const contractWorkflow = input.workflowType === 'contract_change';\n  const semanticManifest = contractWorkflow\n    ? null\n    : await readJson<SemanticClosureManifest>(closurePath);\n\n  const checks: GateReportCheck[] = [];\n  const integrity = await inspectVerificationEvidenceIntegrity({\n    executionEvidenceConsumer:input.executionEvidenceConsumer,\n    projectRoot: path.resolve(input.workItemDir, '..', '..', '..'),\n    workItemDir: input.workItemDir,\n    workItemId: evidenceWorkItemId,\n  });\n  checks.push({\n    check_id: 'verification_evidence_source_and_time_integrity',\n    description: 'manual acceptance has independent content-bound evidence and declared times do not exceed runtime time',\n    passed: integrity.invalidity_reasons.length === 0,\n    severity: integrity.invalidity_reasons.length === 0 ? undefined : 'error',\n    details: integrity.invalidity_reasons.join('; ') || undefined,\n  });\n  checks.push({\n    check_id: 'evidence_manifest_schema_current',\n    description: 'evidence_manifest uses the current owner schema',\n    passed: evidenceSchemaBlockCode === undefined,\n    severity: evidenceSchemaBlockCode === undefined ? undefined : 'error',\n    details: evidenceSchemaBlockCode,\n  });\n  const reportContract = validateVerificationReportContract(structuredReport);\n  const conclusion = normalize(structuredReport?.conclusion);\n  checks.push({\n    check_id: 'verification_report_contract_valid',\n    description: `verification_report satisfies the shared ${VERIFICATION_REPORT_CONTRACT_ID} contract`,\n    passed: reportContract.valid,\n    severity: reportContract.valid ? undefined : 'error',\n    details: reportContract.errors.join('; ') || undefined,\n  });\n  checks.push({\n    check_id: 'verification_report_conclusion_pass',\n    description: 'verification_report conclusion is pass',\n    passed: conclusion === 'pass',\n    severity: conclusion === 'pass' ? undefined : 'error',\n    details: conclusion || 'missing',\n  });\n\n  const testStatuses = verificationExecutionStatuses(structuredReport);\n  const testsComplete =\n    testStatuses.length > 0 && testStatuses.every(status => NON_BLOCKING_TEST_STATUSES.has(status));\n  checks.push({\n    check_id: 'verification_required_tests_complete',\n    description: 'required tests were executed or explicitly marked not_applicable',\n    passed: testsComplete,\n    severity: testsComplete ? undefined : 'error',\n    details:\n      testStatuses.length > 0 ? `statuses=${testStatuses.join(',')}` : 'no structured test status',\n  });\n\n  const acceptanceStatuses = reportClaims(structuredReport, 'acceptance_criteria').map(claim =>\n    normalize(claim.status)\n  );\n  const acceptancePassed =\n    acceptanceStatuses.length > 0 && acceptanceStatuses.every(status => PASS_STATUSES.has(status));\n  checks.push({\n    check_id: 'verification_acceptance_criteria_passed',\n    description: 'acceptance criteria are present and passed',\n    passed: acceptancePassed,\n    severity: acceptancePassed ? undefined : 'error',\n    details:\n      acceptanceStatuses.length > 0\n        ? `statuses=${acceptanceStatuses.join(',')}`\n        : 'no structured acceptance criteria',\n  });\n\n  const e2eStatuses = reportClaims(structuredReport, 'e2e_tests').map(claim =>\n    normalize(claim.status)\n  );\n  const e2eComplete =\n    e2eStatuses.length > 0 && e2eStatuses.every(status => NON_BLOCKING_TEST_STATUSES.has(status));\n  checks.push({\n    check_id: 'verification_e2e_complete',\n    description: 'end-to-end verification passed or is explicitly not_applicable',\n    passed: e2eComplete,\n    severity: e2eComplete ? undefined : 'error',\n    details:\n      e2eStatuses.length > 0\n        ? `statuses=${e2eStatuses.join(',')}`\n        : 'no structured end-to-end status',\n  });\n\n  const entries = evidenceEntries(evidenceManifest);\n  checks.push({\n    check_id: 'verification_evidence_manifest_nonempty',\n    description: 'evidence_manifest exists and has registered entries',\n    passed: entries.length > 0,\n    severity: entries.length > 0 ? undefined : 'error',\n  });\n\n  const reportAlignmentErrors = reportEvidenceAlignment(structuredReport, evidenceManifest);\n  checks.push({\n    check_id: 'verification_report_claims_have_registered_evidence',\n    description: 'acceptance and end-to-end claims reference registered Evidence',\n    passed: reportAlignmentErrors.length === 0,\n    severity: reportAlignmentErrors.length === 0 ? undefined : 'error',\n    details: reportAlignmentErrors.join('; ') || undefined,\n  });\n\n  const sideEffectsDeclared =\n    typeof structuredReport?.side_effects === 'string' &&\n    structuredReport.side_effects.trim().length > 0;\n  checks.push({\n    check_id: 'verification_side_effects_declared',\n    description: 'verification side effects are explicitly declared',\n    passed: sideEffectsDeclared,\n    severity: sideEffectsDeclared ? undefined : 'error',\n  });\n\n  const guardAuditBinding = inspectWriteGuardAuditBinding(path.resolve(input.workItemDir, '..', '..', '..'), input.workItemDir, auditText);\n  checks.push({ check_id: 'verification_write_guard_audit_current', description: 'Changed Files Audit covers current Write Guard and resolution evidence', passed: guardAuditBinding.passed, severity: guardAuditBinding.passed ? undefined : 'error', details: guardAuditBinding.reason });\n  const auditVerdict = evaluateChangedFilesAuditVerdict(auditText ?? '', {\n    expectedWorkItemId: evidenceWorkItemId,\n  });\n  checks.push({\n    check_id: 'verification_changed_files_audit_passed',\n    description: 'changed_files_audit is complete and passed',\n    passed: auditVerdict.passed,\n    severity: auditVerdict.passed ? undefined : 'error',\n    details: auditVerdict.reason,\n  });\n\n  if (!contractWorkflow) {\n    const semanticValidation = validateSemanticClosure(semanticManifest);\n    checks.push({\n      check_id: 'verification_semantic_closure_valid',\n      description: 'semantic closure proves the user outcome to evidence chain',\n      passed: semanticValidation.passed,\n      severity: semanticValidation.passed ? undefined : 'error',\n      details: semanticValidation.errors.map(issue => issue.check_id).join(', ') || undefined,\n    });\n\n    const provenanceValidation = await validateSemanticClosureProvenance(\n      input.workItemDir,\n      semanticManifest\n    );\n    checks.push({\n      check_id: 'verification_semantic_closure_provenance_current',\n      description: 'semantic closure is bound to the current verification artifacts',\n      passed: provenanceValidation.passed,\n      severity: provenanceValidation.passed ? undefined : 'error',\n      details: provenanceValidation.errors.join('; ') || undefined,\n    });\n\n    const alignmentErrors = evidenceManifestAlignment(semanticManifest, evidenceManifest);\n    checks.push({\n      check_id: 'verification_claims_match_evidence_manifest',\n      description: 'semantic evidence claims match registered Evidence Manifest entries',\n      passed: alignmentErrors.length === 0,\n      severity: alignmentErrors.length === 0 ? undefined : 'error',\n      details: alignmentErrors.join('; ') || undefined,\n    });\n  }\n\n  return {\n    checks,\n    inputFiles: [reportPath, evidencePath, auditPath, ...(contractWorkflow ? [] : [closurePath])],\n  };\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\verification-report-contract.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `|` with `·|·`","line":38,"column":47,"nodeType":null,"messageId":"replace","endLine":38,"endColumn":48,"fix":{"range":[1423,1424],"text":" | "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `|'property'|'integration'|'e2e'|` with `·|·'property'·|·'integration'·|·'e2e'·|·`","line":41,"column":29,"nodeType":null,"messageId":"replace","endLine":41,"endColumn":61,"fix":{"range":[1530,1562],"text":" | 'property' | 'integration' | 'e2e' | "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(command.execution_kind!==undefined&&!['verification-execution/v1','manual-observation/v1'].includes(String(command.execution_kind)))` with `·(⏎········command.execution_kind·!==·undefined·&&⏎········!['verification-execution/v1',·'manual-observation/v1'].includes(⏎··········String(command.execution_kind)⏎········)⏎······)⏎········`","line":183,"column":9,"nodeType":null,"messageId":"replace","endLine":183,"endColumn":142,"fix":{"range":[6159,6292],"text":" (\n        command.execution_kind !== undefined &&\n        !['verification-execution/v1', 'manual-observation/v1'].includes(\n          String(command.execution_kind)\n        )\n      )\n        "}},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'command.execution_kind' may use Object's default stringification format ('[object Object]') when stringified.","line":183,"column":117,"nodeType":"MemberExpression","messageId":"baseToString","endLine":183,"endColumn":139},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(command.execution_receipt_id!==undefined&&(typeof·command.execution_receipt_id!=='string'||!·/^[a-f0-9]{64}$/.test(command.execution_receipt_id)))` with `·(⏎········command.execution_receipt_id·!==·undefined·&&⏎········(typeof·command.execution_receipt_id·!==·'string'·||⏎··········!/^[a-f0-9]{64}$/.test(command.execution_receipt_id))⏎······)⏎········`","line":184,"column":9,"nodeType":null,"messageId":"replace","endLine":184,"endColumn":156,"fix":{"range":[6358,6505],"text":" (\n        command.execution_receipt_id !== undefined &&\n        (typeof command.execution_receipt_id !== 'string' ||\n          !/^[a-f0-9]{64}$/.test(command.execution_receipt_id))\n      )\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(command.task_id!==undefined&&(typeof·command.task_id!=='string'||!·/^TASK-WI-[0-9]{4,}-[0-9]{3}$/.test(command.task_id)))` with `·(⏎········command.task_id·!==·undefined·&&⏎········(typeof·command.task_id·!==·'string'·||⏎··········!/^TASK-WI-[0-9]{4,}-[0-9]{3}$/.test(command.task_id))⏎······)⏎········`","line":185,"column":9,"nodeType":null,"messageId":"replace","endLine":185,"endColumn":131,"fix":{"range":[6577,6699],"text":" (\n        command.task_id !== undefined &&\n        (typeof command.task_id !== 'string' ||\n          !/^TASK-WI-[0-9]{4,}-[0-9]{3}$/.test(command.task_id))\n      )\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(command.verification_type!==undefined&&!['unit','property','integration','e2e','regression'].includes(String(command.verification_type)))` with `·(⏎········command.verification_type·!==·undefined·&&⏎········!['unit',·'property',·'integration',·'e2e',·'regression'].includes(⏎··········String(command.verification_type)⏎········)⏎······)⏎········`","line":186,"column":9,"nodeType":null,"messageId":"replace","endLine":186,"endColumn":147,"fix":{"range":[6758,6896],"text":" (\n        command.verification_type !== undefined &&\n        !['unit', 'property', 'integration', 'e2e', 'regression'].includes(\n          String(command.verification_type)\n        )\n      )\n        "}},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'command.verification_type' may use Object's default stringification format ('[object Object]') when stringified.","line":186,"column":119,"nodeType":"MemberExpression","messageId":"baseToString","endLine":186,"endColumn":144},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(command.command_index!==undefined&&(!Number.isSafeInteger(command.command_index)||(command.command_index·as·number)<0||(command.command_index·as·number)>63))` with `·(⏎········command.command_index·!==·undefined·&&⏎········(!Number.isSafeInteger(command.command_index)·||⏎··········(command.command_index·as·number)·<·0·||⏎··········(command.command_index·as·number)·>·63)⏎······)⏎········`","line":187,"column":9,"nodeType":null,"messageId":"replace","endLine":187,"endColumn":167,"fix":{"range":[6965,7123],"text":" (\n        command.command_index !== undefined &&\n        (!Number.isSafeInteger(command.command_index) ||\n          (command.command_index as number) < 0 ||\n          (command.command_index as number) > 63)\n      )\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(command.evidence_refs!==undefined&&(!Array.isArray(command.evidence_refs)||command.evidence_refs.length===0||!command.evidence_refs.every(id=>typeof·id==='string'&&EVIDENCE_ID_PATTERN.test(id))))` with `·(⏎········command.evidence_refs·!==·undefined·&&⏎········(!Array.isArray(command.evidence_refs)·||⏎··········command.evidence_refs.length·===·0·||⏎··········!command.evidence_refs.every(⏎············id·=>·typeof·id·===·'string'·&&·EVIDENCE_ID_PATTERN.test(id)⏎··········))⏎······)⏎········`","line":188,"column":9,"nodeType":null,"messageId":"replace","endLine":188,"endColumn":205,"fix":{"range":[7188,7384],"text":" (\n        command.evidence_refs !== undefined &&\n        (!Array.isArray(command.evidence_refs) ||\n          command.evidence_refs.length === 0 ||\n          !command.evidence_refs.every(\n            id => typeof id === 'string' && EVIDENCE_ID_PATTERN.test(id)\n          ))\n      )\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":260,"column":34,"nodeType":null,"messageId":"delete","endLine":260,"endColumn":35,"fix":{"range":[10321,10322],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":269,"column":38,"nodeType":null,"messageId":"delete","endLine":269,"endColumn":39,"fix":{"range":[10625,10626],"text":""}}],"suppressedMessages":[],"errorCount":12,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":10,"fixableWarningCount":0,"source":"/**\n * verification-report-contract.ts\n *\n * Single typed producer/consumer contract for verification_report.\n * Invalid reports must be rejected before rendering or semantic-closure\n * generation; later gates reuse the same structural validation.\n */\n\nexport const VERIFICATION_REPORT_CONTRACT_ID = 'verification-report/v1' as const;\n\nexport const REQUIRED_TEST_MATRIX_KEYS = [\n  'L1_unit',\n  'L2_integration',\n  'L3_pbt',\n  'L4_e2e',\n  'L5_smoke',\n  'L6_regression',\n  'L7_performance',\n  'L8_security',\n  'L9_compatibility',\n  'L10_uat',\n] as const;\n\nexport const VERIFICATION_CONCLUSIONS = ['pass', 'fail', 'blocked'] as const;\nexport const TEST_MATRIX_STATUSES = ['pass', 'fail', 'skip', 'not_applicable'] as const;\nexport const VERIFICATION_COMMAND_STATUSES = ['pass', 'fail', 'skipped'] as const;\nexport const ACCEPTANCE_STATUSES = ['pass', 'fail'] as const;\nexport const E2E_STATUSES = ['pass', 'fail', 'not_applicable'] as const;\nexport const CONTRACT_REVIEW_METHODS = ['manual'] as const;\nexport const CONTRACT_REVIEW_CONCLUSIONS = ['pass', 'fail'] as const;\nconst EVIDENCE_ID_PATTERN = /^[A-Z][A-Z0-9_]*-[A-Za-z0-9_.-]+$/;\n\nexport interface VerificationCommand {\n  command: string;\n  status: (typeof VERIFICATION_COMMAND_STATUSES)[number];\n  output_summary: string;\n  /** Live acceptance requires the common Runtime consumer, not this structural validator alone. */\n  execution_kind?: 'verification-execution/v1'|'manual-observation/v1';\n  execution_receipt_id?: string;\n  task_id?: string;\n  verification_type?: 'unit'|'property'|'integration'|'e2e'|'regression';\n  command_index?: number;\n  evidence_refs?: string[];\n}\n\nexport interface VerificationClaim {\n  evidence?: string;\n  evidence_refs?: string[];\n}\n\nexport interface VerificationAcceptanceCriterion extends VerificationClaim {\n  req_id: string;\n  name: string;\n  status: (typeof ACCEPTANCE_STATUSES)[number];\n}\n\nexport interface VerificationE2ETest extends VerificationClaim {\n  name: string;\n  status: (typeof E2E_STATUSES)[number];\n}\n\nexport interface VerificationContractReview extends VerificationClaim {\n  contract_id: string;\n  files: string[];\n  modules: string[];\n  review_method: (typeof CONTRACT_REVIEW_METHODS)[number];\n  reviewer: string;\n  conclusion: (typeof CONTRACT_REVIEW_CONCLUSIONS)[number];\n  summary: string;\n}\n\nexport interface VerificationReportContract {\n  conclusion: (typeof VERIFICATION_CONCLUSIONS)[number];\n  test_matrix: Record<string, (typeof TEST_MATRIX_STATUSES)[number]>;\n  verification_commands: VerificationCommand[];\n  acceptance_criteria: VerificationAcceptanceCriterion[];\n  e2e_tests: VerificationE2ETest[];\n  contract_reviews?: VerificationContractReview[];\n  side_effects: string;\n  summary: string;\n  semantic_closure: Record<string, unknown>;\n  [key: string]: unknown;\n}\n\nexport interface VerificationReportContractValidation {\n  valid: boolean;\n  errors: string[];\n  report: VerificationReportContract | null;\n}\n\nfunction isRecord(value: unknown): value is Record<string, unknown> {\n  return typeof value === 'object' && value !== null && !Array.isArray(value);\n}\n\nfunction isNonEmptyString(value: unknown): value is string {\n  return typeof value === 'string' && value.trim().length > 0;\n}\n\nfunction validateEnum(\n  errors: string[],\n  path: string,\n  value: unknown,\n  allowed: readonly string[]\n): void {\n  if (!isNonEmptyString(value)) {\n    errors.push(`MISSING_FIELD: ${path} must be a non-empty string`);\n    return;\n  }\n  if (!allowed.includes(value)) {\n    errors.push(`INVALID_VALUE: ${path} must be one of ${allowed.join(', ')}`);\n  }\n}\n\nfunction validateEvidenceReference(\n  errors: string[],\n  path: string,\n  claim: Record<string, unknown>\n): void {\n  if (Object.prototype.hasOwnProperty.call(claim, 'evidence_ref')) {\n    errors.push(\n      `FORBIDDEN_FIELD: ${path}.evidence_ref is not part of the contract; use evidence or evidence_refs`\n    );\n  }\n\n  const singularValid =\n    isNonEmptyString(claim.evidence) && EVIDENCE_ID_PATTERN.test(claim.evidence.trim());\n  const pluralValid =\n    Array.isArray(claim.evidence_refs) &&\n    claim.evidence_refs.length > 0 &&\n    claim.evidence_refs.every(\n      reference => isNonEmptyString(reference) && EVIDENCE_ID_PATTERN.test(reference.trim())\n    );\n  if (!singularValid && !pluralValid) {\n    errors.push(\n      `INVALID_EVIDENCE_REFERENCE: ${path} must contain an Evidence ID in evidence or a non-empty evidence_refs array`\n    );\n  }\n}\n\nexport function validateVerificationReportContract(\n  value: unknown\n): VerificationReportContractValidation {\n  const errors: string[] = [];\n  if (!isRecord(value)) {\n    return {\n      valid: false,\n      errors: ['INVALID_STRUCTURE: verification report must be a JSON object'],\n      report: null,\n    };\n  }\n\n  validateEnum(errors, 'conclusion', value.conclusion, VERIFICATION_CONCLUSIONS);\n\n  if (!isRecord(value.test_matrix)) {\n    errors.push('MISSING_FIELD: test_matrix must be an object');\n  } else {\n    for (const key of REQUIRED_TEST_MATRIX_KEYS) {\n      if (!Object.prototype.hasOwnProperty.call(value.test_matrix, key)) {\n        errors.push(`MISSING_FIELD: test_matrix.${key} is required`);\n      }\n    }\n    for (const [key, status] of Object.entries(value.test_matrix)) {\n      validateEnum(errors, `test_matrix.${key}`, status, TEST_MATRIX_STATUSES);\n    }\n  }\n\n  if (!Array.isArray(value.verification_commands) || value.verification_commands.length === 0) {\n    errors.push('MISSING_FIELD: verification_commands must be a non-empty array');\n  } else {\n    for (const [index, command] of value.verification_commands.entries()) {\n      const itemPath = `verification_commands[${index}]`;\n      if (!isRecord(command)) {\n        errors.push(`INVALID_STRUCTURE: ${itemPath} must be an object`);\n        continue;\n      }\n      if (!isNonEmptyString(command.command)) {\n        errors.push(`MISSING_FIELD: ${itemPath}.command must be a non-empty string`);\n      }\n      validateEnum(errors, `${itemPath}.status`, command.status, VERIFICATION_COMMAND_STATUSES);\n      if (!isNonEmptyString(command.output_summary)) {\n        errors.push(`MISSING_FIELD: ${itemPath}.output_summary must be a non-empty string`);\n      }\n      if(command.execution_kind!==undefined&&!['verification-execution/v1','manual-observation/v1'].includes(String(command.execution_kind)))errors.push(`INVALID_VALUE: ${itemPath}.execution_kind`);\n      if(command.execution_receipt_id!==undefined&&(typeof command.execution_receipt_id!=='string'||! /^[a-f0-9]{64}$/.test(command.execution_receipt_id)))errors.push(`INVALID_VALUE: ${itemPath}.execution_receipt_id`);\n      if(command.task_id!==undefined&&(typeof command.task_id!=='string'||! /^TASK-WI-[0-9]{4,}-[0-9]{3}$/.test(command.task_id)))errors.push(`INVALID_VALUE: ${itemPath}.task_id`);\n      if(command.verification_type!==undefined&&!['unit','property','integration','e2e','regression'].includes(String(command.verification_type)))errors.push(`INVALID_VALUE: ${itemPath}.verification_type`);\n      if(command.command_index!==undefined&&(!Number.isSafeInteger(command.command_index)||(command.command_index as number)<0||(command.command_index as number)>63))errors.push(`INVALID_VALUE: ${itemPath}.command_index`);\n      if(command.evidence_refs!==undefined&&(!Array.isArray(command.evidence_refs)||command.evidence_refs.length===0||!command.evidence_refs.every(id=>typeof id==='string'&&EVIDENCE_ID_PATTERN.test(id))))errors.push(`INVALID_VALUE: ${itemPath}.evidence_refs`);\n    }\n  }\n\n  if (!Array.isArray(value.acceptance_criteria) || value.acceptance_criteria.length === 0) {\n    errors.push('MISSING_FIELD: acceptance_criteria must be a non-empty array');\n  } else {\n    for (const [index, criterion] of value.acceptance_criteria.entries()) {\n      const itemPath = `acceptance_criteria[${index}]`;\n      if (!isRecord(criterion)) {\n        errors.push(`INVALID_STRUCTURE: ${itemPath} must be an object`);\n        continue;\n      }\n      if (!isNonEmptyString(criterion.req_id)) {\n        errors.push(`MISSING_FIELD: ${itemPath}.req_id must be a non-empty string`);\n      }\n      if (!isNonEmptyString(criterion.name)) {\n        errors.push(`MISSING_FIELD: ${itemPath}.name must be a non-empty string`);\n      }\n      validateEnum(errors, `${itemPath}.status`, criterion.status, ACCEPTANCE_STATUSES);\n      validateEvidenceReference(errors, itemPath, criterion);\n    }\n  }\n\n  if (!Array.isArray(value.e2e_tests) || value.e2e_tests.length === 0) {\n    errors.push('MISSING_FIELD: e2e_tests must be a non-empty array');\n  } else {\n    for (const [index, test] of value.e2e_tests.entries()) {\n      const itemPath = `e2e_tests[${index}]`;\n      if (!isRecord(test)) {\n        errors.push(`INVALID_STRUCTURE: ${itemPath} must be an object`);\n        continue;\n      }\n      if (!isNonEmptyString(test.name)) {\n        errors.push(`MISSING_FIELD: ${itemPath}.name must be a non-empty string`);\n      }\n      validateEnum(errors, `${itemPath}.status`, test.status, E2E_STATUSES);\n      validateEvidenceReference(errors, itemPath, test);\n    }\n  }\n\n  if (Object.prototype.hasOwnProperty.call(value, 'contract_reviews')) {\n    if (!Array.isArray(value.contract_reviews)) {\n      errors.push('INVALID_STRUCTURE: contract_reviews must be an array when provided');\n    } else {\n      for (const [index, review] of value.contract_reviews.entries()) {\n        const itemPath = `contract_reviews[${index}]`;\n        if (!isRecord(review)) {\n          errors.push(`INVALID_STRUCTURE: ${itemPath} must be an object`);\n          continue;\n        }\n        if (!isNonEmptyString(review.contract_id)) {\n          errors.push(`MISSING_FIELD: ${itemPath}.contract_id must be a non-empty string`);\n        }\n        if (\n          !Array.isArray(review.files) ||\n          review.files.length === 0 ||\n          !review.files.every(isNonEmptyString)\n        ) {\n          errors.push(`MISSING_FIELD: ${itemPath}.files must be a non-empty string array`);\n        }\n        if (\n          !Array.isArray(review.modules) ||\n          review.modules.length === 0 ||\n          !review.modules.every(isNonEmptyString)\n        ) {\n          errors.push(`MISSING_FIELD: ${itemPath}.modules must be a non-empty string array`);\n        }\n        validateEnum(\n          errors,\n          `${itemPath}.review_method`,\n          review.review_method,\n          CONTRACT_REVIEW_METHODS,\n        );\n        if (!isNonEmptyString(review.reviewer)) {\n          errors.push(`MISSING_FIELD: ${itemPath}.reviewer must be a non-empty string`);\n        }\n        validateEnum(\n          errors,\n          `${itemPath}.conclusion`,\n          review.conclusion,\n          CONTRACT_REVIEW_CONCLUSIONS,\n        );\n        if (!isNonEmptyString(review.summary)) {\n          errors.push(`MISSING_FIELD: ${itemPath}.summary must be a non-empty string`);\n        }\n        validateEvidenceReference(errors, itemPath, review);\n      }\n    }\n  }\n\n  if (!isNonEmptyString(value.side_effects)) {\n    errors.push('MISSING_FIELD: side_effects must be a non-empty string');\n  }\n  if (!isNonEmptyString(value.summary)) {\n    errors.push('MISSING_FIELD: summary must be a non-empty string');\n  }\n  if (!isRecord(value.semantic_closure)) {\n    errors.push('MISSING_FIELD: semantic_closure must be an object');\n  }\n\n  return {\n    valid: errors.length === 0,\n    errors,\n    report: errors.length === 0 ? (value as VerificationReportContract) : null,\n  };\n}\n\nexport function parseVerificationReportJson(content: string): VerificationReportContractValidation {\n  try {\n    return validateVerificationReportContract(JSON.parse(content));\n  } catch {\n    return {\n      valid: false,\n      errors: ['INVALID_JSON: verification report content is not valid JSON'],\n      report: null,\n    };\n  }\n}\n\nexport function extractStructuredVerificationReport(\n  content: string\n): Record<string, unknown> | null {\n  try {\n    const parsed = JSON.parse(content);\n    if (isRecord(parsed)) return parsed;\n  } catch {\n    // Markdown is the canonical on-disk representation.\n  }\n\n  const fenceRe = /```(?:json|verification_report)?\\s*([\\s\\S]*?)```/gi;\n  let match: RegExpExecArray | null;\n  while ((match = fenceRe.exec(content)) !== null) {\n    try {\n      const parsed = JSON.parse(String(match[1] ?? '').trim());\n      if (isRecord(parsed)) return parsed;\n    } catch {\n      // Keep searching later fenced blocks.\n    }\n  }\n  return null;\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\verification-report.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎····'已验证',·'verified',·'verified.',·'all·pass',·'全部通过',·'pass',⏎··` with `'已验证',·'verified',·'verified.',·'all·pass',·'全部通过',·'pass'`","line":62,"column":31,"nodeType":null,"messageId":"replace","endLine":64,"endColumn":3,"fix":{"range":[2290,2357],"text":"'已验证', 'verified', 'verified.', 'all pass', '全部通过', 'pass'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'verification_report.md·must·not·contain·only·\"已验证/verified\".·Must·reference·Evidence·(§13.3)'` with `⏎······'verification_report.md·must·not·contain·only·\"已验证/verified\".·Must·reference·Evidence·(§13.3)'⏎····`","line":66,"column":17,"nodeType":null,"messageId":"replace","endLine":66,"endColumn":111,"fix":{"range":[2443,2537],"text":"\n      'verification_report.md must not contain only \"已验证/verified\". Must reference Evidence (§13.3)'\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `!lower.includes('command')·&&·!lower.includes('test')·&&·!lower.includes('验证')·&&·!lower.includes('检查')` with `⏎····!lower.includes('command')·&&⏎····!lower.includes('test')·&&⏎····!lower.includes('验证')·&&⏎····!lower.includes('检查')⏎··`","line":73,"column":7,"nodeType":null,"messageId":"replace","endLine":73,"endColumn":110,"fix":{"range":[2697,2800],"text":"\n    !lower.includes('command') &&\n    !lower.includes('test') &&\n    !lower.includes('验证') &&\n    !lower.includes('检查')\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'verification_report·does·not·contain·structured·JSON;·using·legacy·fallback·validation'` with `⏎····'verification_report·does·not·contain·structured·JSON;·using·legacy·fallback·validation'⏎··`","line":77,"column":17,"nodeType":null,"messageId":"replace","endLine":77,"endColumn":105,"fix":{"range":[2914,3002],"text":"\n    'verification_report does not contain structured JSON; using legacy fallback validation'\n  "}}],"suppressedMessages":[],"errorCount":4,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":4,"fixableWarningCount":0,"source":"/**\n * verification-report.ts — §13.3 Verification Report types and validation\n *\n * @deprecated Use verification-report-contract.ts instead.\n * This module is kept for backward compatibility with consumers that\n * validate Markdown text. New consumers MUST use\n * `validateVerificationReportContract` from verification-report-contract.ts.\n *\n * The canonical producer/consumer contract lives in verification-report-contract.ts\n * and validates structured JSON, not loose Markdown text.\n */\n\nimport type { TraceValidationResult } from './evidence.js';\nimport {\n  validateVerificationReportContract,\n  extractStructuredVerificationReport,\n} from './verification-report-contract.js';\n\n/**\n * @deprecated Use validateVerificationReportContract from verification-report-contract.ts.\n *\n * Legacy validator that accepts Markdown text. It now delegates to the\n * canonical contract validator by extracting structured JSON from the\n * content. If no structured JSON is found, it falls back to basic\n * non-empty checks for backward compatibility with very old reports.\n */\nexport function validateVerificationReport(content: string): TraceValidationResult {\n  const errors: string[] = [];\n  const warnings: string[] = [];\n\n  if (!content || content.trim().length === 0) {\n    return { valid: false, errors: ['verification_report.md must not be empty (§13.3)'], warnings };\n  }\n\n  // Try canonical structured validation first\n  const structured = extractStructuredVerificationReport(content);\n  if (structured) {\n    const contractResult = validateVerificationReportContract(structured);\n    if (!contractResult.valid) {\n      return {\n        valid: false,\n        errors: contractResult.errors,\n        warnings: [\n          'verification_report validated via canonical contract; ' +\n            'consider migrating to validateVerificationReportContract directly',\n        ],\n      };\n    }\n    return {\n      valid: true,\n      errors: [],\n      warnings: [\n        'verification_report validated via canonical contract; ' +\n          'consider migrating to validateVerificationReportContract directly',\n      ],\n    };\n  }\n\n  // Fallback for legacy Markdown-only reports without fenced JSON\n  const lower = content.toLowerCase();\n  const trimmed = content.trim();\n  const forbiddenSummaries = [\n    '已验证', 'verified', 'verified.', 'all pass', '全部通过', 'pass',\n  ];\n  if (forbiddenSummaries.some(s => trimmed.toLowerCase() === s)) {\n    errors.push('verification_report.md must not contain only \"已验证/verified\". Must reference Evidence (§13.3)');\n  }\n\n  if (!lower.includes('evidence') && !lower.includes('证据')) {\n    warnings.push('verification_report.md should reference Evidence (§13.3)');\n  }\n\n  if (!lower.includes('command') && !lower.includes('test') && !lower.includes('验证') && !lower.includes('检查')) {\n    warnings.push('verification_report.md should describe verification method (§13.3)');\n  }\n\n  warnings.push('verification_report does not contain structured JSON; using legacy fallback validation');\n\n  return { valid: errors.length === 0, errors, warnings };\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\waiver.ts","messages":[{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'UserDecisionStatus' is defined but never used. Allowed unused vars must match /^_/u.","line":9,"column":15,"nodeType":"Identifier","messageId":"unusedVar","endLine":9,"endColumn":33,"suggestions":[{"messageId":"removeUnusedImportDeclaration","data":{"varName":"UserDecisionStatus"},"fix":{"range":[190,250],"text":""},"desc":"Remove unused import declaration."}]}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"/**\n * waiver.ts — §10.6 Waiver 记录与验证\n *\n * Waiver 是 User Decision 中对特定 Gate 的豁免声明。\n * - soft_gate waiver: 需要全部 4 个字段（reason, risk, expires_at, follow_up_wi）\n * - hard_gate waiver: 不允许\n */\n\nimport type { UserDecisionStatus } from '@specforge/types';\n\n// ---------------------------------------------------------------------------\n// §10.6 WaiverRecord\n// ---------------------------------------------------------------------------\n\nexport interface WaiverRecord {\n  waiver_id: string;\n  gate_id: string;\n  gate_type: 'soft_gate' | 'hard_gate';\n  reason: string;\n  risk: string;\n  expires_at?: string;\n  follow_up_wi?: string;\n}\n\n// ---------------------------------------------------------------------------\n// §10.6 validateWaiver\n// ---------------------------------------------------------------------------\n\nexport interface WaiverValidationResult {\n  valid: boolean;\n  errors: string[];\n}\n\n/**\n * 验证 Waiver 是否符合 §10.6 规则。\n *\n * - hard_gate 的 waiver 不被允许。\n * - soft_gate 的 waiver 必须填写全部 4 个字段：\n *     reason, risk, expires_at, follow_up_wi\n */\nexport function validateWaiver(waiver: WaiverRecord): WaiverValidationResult {\n  const errors: string[] = [];\n\n  // hard_gate waiver 不允许\n  if (waiver.gate_type === 'hard_gate') {\n    errors.push('hard_gate waiver is not allowed (§10.6)');\n  }\n\n  // soft_gate waiver 必须提供全部 4 个字段\n  if (waiver.gate_type === 'soft_gate') {\n    if (!waiver.reason) {\n      errors.push('soft_gate waiver requires \"reason\" (§10.6)');\n    }\n    if (!waiver.risk) {\n      errors.push('soft_gate waiver requires \"risk\" (§10.6)');\n    }\n    if (!waiver.expires_at) {\n      errors.push('soft_gate waiver requires \"expires_at\" (§10.6)');\n    }\n    if (!waiver.follow_up_wi) {\n      errors.push('soft_gate waiver requires \"follow_up_wi\" (§10.6)');\n    }\n  }\n\n  return { valid: errors.length === 0, errors };\n}\n\n// ---------------------------------------------------------------------------\n// Re-export for convenience (one-way dependency on user-decision)\n// ---------------------------------------------------------------------------\n\nexport type { UserDecisionStatus } from '@specforge/types';\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\work-item-id-validator.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\work-item-lifecycle-v11.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"@specforge/types/directory-layout\"` with `'@specforge/types/directory-layout'`","line":1,"column":31,"nodeType":null,"messageId":"replace","endLine":1,"endColumn":66,"fix":{"range":[30,65],"text":"'@specforge/types/directory-layout'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎··projectRoot:·string,⏎` with `projectRoot:·string`","line":114,"column":59,"nodeType":null,"messageId":"replace","endLine":116,"endColumn":1,"fix":{"range":[3869,3893],"text":"projectRoot: string"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎····projectRoot,⏎····SPEC_DIR_NAME,⏎····'project',⏎····'spec_manifest.json',⏎··` with `projectRoot,·SPEC_DIR_NAME,·'project',·'spec_manifest.json'`","line":117,"column":34,"nodeType":null,"messageId":"replace","endLine":122,"endColumn":3,"fix":{"range":[3947,4027],"text":"projectRoot, SPEC_DIR_NAME, 'project', 'spec_manifest.json'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······`PROJECT_SPEC_VERSION_UNAVAILABLE:·cannot·read·${manifestPath}:·${detail}`,⏎····` with ``PROJECT_SPEC_VERSION_UNAVAILABLE:·cannot·read·${manifestPath}:·${detail}``","line":129,"column":21,"nodeType":null,"messageId":"replace","endLine":131,"endColumn":5,"fix":{"range":[4244,4331],"text":"`PROJECT_SPEC_VERSION_UNAVAILABLE: cannot read ${manifestPath}: ${detail}`"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎····typeof·version·!==·'string'·||⏎····!PROJECT_SPEC_VERSION_PATTERN.test(version)⏎··` with `typeof·version·!==·'string'·||·!PROJECT_SPEC_VERSION_PATTERN.test(version)`","line":139,"column":7,"nodeType":null,"messageId":"replace","endLine":142,"endColumn":3,"fix":{"range":[4515,4601],"text":"typeof version !== 'string' || !PROJECT_SPEC_VERSION_PATTERN.test(version)"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":144,"column":100,"nodeType":null,"messageId":"delete","endLine":144,"endColumn":101,"fix":{"range":[4725,4726],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":163,"column":26,"nodeType":null,"messageId":"delete","endLine":163,"endColumn":27,"fix":{"range":[5167,5168],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······`PROJECT_SPEC_VERSION_INVALID:·${baseSpecVersion}`,⏎····` with ``PROJECT_SPEC_VERSION_INVALID:·${baseSpecVersion}``","line":166,"column":21,"nodeType":null,"messageId":"replace","endLine":168,"endColumn":5,"fix":{"range":[5269,5332],"text":"`PROJECT_SPEC_VERSION_INVALID: ${baseSpecVersion}`"}},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'isTaskChange' is assigned a value but never used. Allowed unused vars must match /^_/u.","line":172,"column":9,"nodeType":"Identifier","messageId":"unusedVar","endLine":172,"endColumn":21},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `path.join(workItemDir,·'change_classification.md'),` with `⏎····path.join(workItemDir,·'change_classification.md'),⏎···`","line":180,"column":20,"nodeType":null,"messageId":"replace","endLine":180,"endColumn":71,"fix":{"range":[5790,5841],"text":"\n    path.join(workItemD