everity":2,"message":"Delete `,`","line":412,"column":59,"nodeType":null,"messageId":"delete","endLine":412,"endColumn":60,"fix":{"range":[15067,15068],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":416,"column":94,"nodeType":null,"messageId":"delete","endLine":416,"endColumn":95,"fix":{"range":[15273,15274],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":423,"column":90,"nodeType":null,"messageId":"delete","endLine":423,"endColumn":91,"fix":{"range":[15514,15515],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":429,"column":103,"nodeType":null,"messageId":"delete","endLine":429,"endColumn":104,"fix":{"range":[15752,15753],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":434,"column":102,"nodeType":null,"messageId":"delete","endLine":434,"endColumn":103,"fix":{"range":[15980,15981],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":454,"column":103,"nodeType":null,"messageId":"delete","endLine":454,"endColumn":104,"fix":{"range":[16717,16718],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":469,"column":99,"nodeType":null,"messageId":"delete","endLine":469,"endColumn":100,"fix":{"range":[17357,17358],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":478,"column":105,"nodeType":null,"messageId":"delete","endLine":478,"endColumn":106,"fix":{"range":[17731,17732],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":483,"column":81,"nodeType":null,"messageId":"delete","endLine":483,"endColumn":82,"fix":{"range":[17860,17861],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":491,"column":102,"nodeType":null,"messageId":"delete","endLine":491,"endColumn":103,"fix":{"range":[18205,18206],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":500,"column":62,"nodeType":null,"messageId":"delete","endLine":500,"endColumn":63,"fix":{"range":[18495,18496],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":504,"column":62,"nodeType":null,"messageId":"delete","endLine":504,"endColumn":63,"fix":{"range":[18622,18623],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":508,"column":117,"nodeType":null,"messageId":"delete","endLine":508,"endColumn":118,"fix":{"range":[18857,18858],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":517,"column":34,"nodeType":null,"messageId":"delete","endLine":517,"endColumn":35,"fix":{"range":[19016,19017],"text":""}}],"suppressedMessages":[],"errorCount":52,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":52,"fixableWarningCount":0,"source":"import { SPEC_DIR_NAME } from \"@specforge/types/directory-layout\";\nimport * as fs from 'node:fs/promises';\nimport * as path from 'node:path';\nimport { createHash, randomUUID } from 'node:crypto';\nimport {\n  checkProjectGovernanceConsistency,\n  checkProjectGovernanceContracts,\n  checkProjectGovernanceTrace,\n  inspectProjectSpecCoreVersionCoherence,\n  readSuccessfulProjectSpecMergeHistoryEvidence,\n  type GovernanceCheckResult,\n  type ProjectSpecCoreVersionCoherence,\n  type ProjectSpecMergeHistoryEvidence,\n} from './project-governance-v2.js';\n\nconst RECOVERY_FILE = 'invalid_merged_spec_closure_recovery.json';\nconst RECOVERY_ROOT = 'recovery_generations';\nconst REQUIRED_WORK_ITEM_ARCHIVE_PATHS = [\n  'snapshot/work-item/candidate_manifest.json',\n  'snapshot/work-item/gate_summary.md',\n  'snapshot/work-item/user_decision.json',\n  'snapshot/work-item/merge_report.md',\n  'snapshot/work-item/verification_report.md',\n  'snapshot/work-item/gates/formal_version_gate.json',\n  'snapshot/work-item/gates/close_gate.json',\n];\n\nexport interface RecoveryEvidenceFile {\n  source_kind: 'work_item' | 'formal_project_spec';\n  source_relative_path: string;\n  archive_relative_path: string;\n  size: number;\n  sha256: string;\n}\n\nexport interface InvalidMergedSpecProof {\n  close_gate_status: 'passed';\n  merge_history: ProjectSpecMergeHistoryEvidence;\n  current_project_spec: {\n    project_spec_version: string;\n    last_merged_work_item: string;\n  };\n  project_spec_core_version: ProjectSpecCoreVersionCoherence;\n  governance_checks: {\n    consistency: GovernanceCheckResult;\n    contracts: GovernanceCheckResult;\n    trace: GovernanceCheckResult;\n  };\n  invalidity_reasons: string[];\n  input_files: Array<{\n    relative_path: string;\n    size: number;\n    sha256: string;\n  }>;\n}\n\nexport interface RecoveryArchive {\n  generation_id: string;\n  generation_root: string;\n  manifest_path: string;\n  manifest_relative_path: string;\n  manifest_sha256: string;\n  files: RecoveryEvidenceFile[];\n}\n\nfunction sha256(content: Uint8Array): string {\n  return createHash('sha256').update(content).digest('hex');\n}\n\nasync function readJson(filePath: string): Promise<any> {\n  return JSON.parse(await fs.readFile(filePath, 'utf-8'));\n}\n\nasync function writeJsonAtomic(filePath: string, value: unknown): Promise<void> {\n  const temporary = `${filePath}.tmp-${process.pid}-${Date.now()}-${randomUUID()}`;\n  await fs.writeFile(temporary, JSON.stringify(value, null, 2) + '\\n', 'utf-8');\n  await fs.rename(temporary, filePath);\n}\n\nfunction relativeInside(root: string, target: string, errorCode: string): string {\n  const relative = path.relative(path.resolve(root), path.resolve(target));\n  if (!relative || relative.startsWith('..') || path.isAbsolute(relative)) {\n    throw new Error(`${errorCode}: path is outside the expected root: ${target}`);\n  }\n  return relative.split(path.sep).join('/');\n}\n\nasync function readRegularFile(filePath: string, errorCode: string): Promise<Buffer> {\n  const stat = await fs.lstat(filePath);\n  if (stat.isSymbolicLink() || !stat.isFile()) {\n    throw new Error(`${errorCode}: evidence must be a regular non-symlink file: ${filePath}`);\n  }\n  return fs.readFile(filePath);\n}\n\nfunction failedChecks(name: string, result: GovernanceCheckResult): string[] {\n  return result.checks\n    .filter(check => !check.passed)\n    .map(check => `${name}:${check.check_id}${check.details ? `:${check.details}` : ''}`);\n}\n\nexport async function proveInvalidMergedSpecClosure(input: {\n  projectRoot: string;\n  workItemDir: string;\n  workItemId: string;\n  workItem: Record<string, unknown>;\n}): Promise<InvalidMergedSpecProof> {\n  if (input.workItem.code_change_allowed === true || input.workItem.code_permission_revoked !== true) {\n    throw new Error(\n      'INVALID_MERGED_SPEC_RECOVERY_PERMISSION_STATE_INVALID: code permission must remain revoked',\n    );\n  }\n\n  const closeGate = await readJson(path.join(input.workItemDir, 'gates', 'close_gate.json'))\n    .catch(() => null);\n  if (closeGate?.status !== 'passed') {\n    throw new Error(\n      'INVALID_MERGED_SPEC_RECOVERY_EVIDENCE_MISSING: prior close_gate.json with status=passed is required',\n    );\n  }\n\n  const mergeHistory = await readSuccessfulProjectSpecMergeHistoryEvidence({\n    projectRoot: input.projectRoot,\n    workItemDir: input.workItemDir,\n    workItemId: input.workItemId,\n  });\n  if (!mergeHistory) {\n    throw new Error(\n      'INVALID_MERGED_SPEC_RECOVERY_MERGE_PROOF_MISSING: active approved decision and successful Atomic Spec Merge evidence are required',\n    );\n  }\n\n  const manifestPath = path.join(input.projectRoot, SPEC_DIR_NAME, 'project', 'spec_manifest.json');\n  const manifest = await readJson(manifestPath).catch(() => null);\n  const currentVersion = String(manifest?.project_spec_version ?? '');\n  const lastMergedWorkItem = String(manifest?.last_merged_work_item ?? '');\n  if (lastMergedWorkItem !== input.workItemId || currentVersion !== mergeHistory.project_spec_version) {\n    throw new Error(\n      'INVALID_MERGED_SPEC_RECOVERY_PROJECT_SPEC_OWNERSHIP_MISMATCH: current Project Spec must still be the exact result of this Work Item merge',\n    );\n  }\n\n  let core: ProjectSpecCoreVersionCoherence;\n  let consistency: GovernanceCheckResult;\n  let contracts: GovernanceCheckResult;\n  let trace: GovernanceCheckResult;\n  try {\n    [core, consistency, contracts, trace] = await Promise.all([\n      inspectProjectSpecCoreVersionCoherence(input.projectRoot),\n      checkProjectGovernanceConsistency(input),\n      checkProjectGovernanceContracts(input),\n      checkProjectGovernanceTrace(input),\n    ]);\n  } catch (error) {\n    throw new Error(\n      `INVALID_MERGED_SPEC_RECOVERY_VALIDATION_UNAVAILABLE: ${\n        error instanceof Error ? error.message : String(error)\n      }`,\n    );\n  }\n\n  const invalidityReasons = [\n    ...(!core.passed ? [`project_spec_core_version:${core.reason}`] : []),\n    ...failedChecks('consistency', consistency),\n    ...failedChecks('contracts', contracts),\n    ...failedChecks('trace', trace),\n  ];\n  if (invalidityReasons.length === 0) {\n    throw new Error(\n      'INVALID_MERGED_SPEC_RECOVERY_NOT_PROVEN: shared formal Project Spec validators all pass',\n    );\n  }\n\n  const inputFiles: InvalidMergedSpecProof['input_files'] = [];\n  const uniquePaths = Array.from(new Set([\n    ...core.input_files,\n    ...consistency.inputFiles,\n    ...contracts.inputFiles,\n    ...trace.inputFiles,\n  ].map(filePath => path.resolve(filePath)))).sort();\n  for (const filePath of uniquePaths) {\n    const relativePath = relativeInside(\n      input.projectRoot,\n      filePath,\n      'INVALID_MERGED_SPEC_RECOVERY_VALIDATION_INPUT_OUTSIDE_PROJECT',\n    );\n    let content: Buffer;\n    try {\n      content = await readRegularFile(\n        filePath,\n        'INVALID_MERGED_SPEC_RECOVERY_VALIDATION_INPUT_INVALID',\n      );\n    } catch (error) {\n      throw new Error(\n        `INVALID_MERGED_SPEC_RECOVERY_VALIDATION_INPUT_UNAVAILABLE: ${\n          error instanceof Error ? error.message : String(error)\n        }`,\n      );\n    }\n    inputFiles.push({\n      relative_path: relativePath,\n      size: content.byteLength,\n      sha256: sha256(content),\n    });\n  }\n\n  return {\n    close_gate_status: 'passed',\n    merge_history: mergeHistory,\n    current_project_spec: {\n      project_spec_version: currentVersion,\n      last_merged_work_item: lastMergedWorkItem,\n    },\n    project_spec_core_version: core,\n    governance_checks: { consistency, contracts, trace },\n    invalidity_reasons: invalidityReasons,\n    input_files: inputFiles,\n  };\n}\n\nasync function collectWorkItemFiles(input: {\n  workItemDir: string;\n  directory?: string;\n}): Promise<string[]> {\n  const directory = input.directory ?? input.workItemDir;\n  const entries = await fs.readdir(directory, { withFileTypes: true });\n  const files: string[] = [];\n  for (const entry of entries.sort((left, right) => left.name.localeCompare(right.name))) {\n    if (directory === input.workItemDir && entry.name === RECOVERY_ROOT) continue;\n    const fullPath = path.join(directory, entry.name);\n    const stat = await fs.lstat(fullPath);\n    if (stat.isSymbolicLink()) {\n      throw new Error(\n        `INVALID_MERGED_SPEC_RECOVERY_ARCHIVE_SYMLINK_FORBIDDEN: ${fullPath}`,\n      );\n    }\n    if (stat.isDirectory()) {\n      files.push(...await collectWorkItemFiles({ ...input, directory: fullPath }));\n    } else if (stat.isFile()) {\n      files.push(fullPath);\n    }\n  }\n  return files;\n}\n\nasync function copyEvidenceFile(input: {\n  source: string;\n  target: string;\n  sourceKind: RecoveryEvidenceFile['source_kind'];\n  sourceRelativePath: string;\n  generationRoot: string;\n}): Promise<RecoveryEvidenceFile> {\n  const content = await readRegularFile(\n    input.source,\n    'INVALID_MERGED_SPEC_RECOVERY_ARCHIVE_SOURCE_INVALID',\n  );\n  await fs.mkdir(path.dirname(input.target), { recursive: true });\n  await fs.writeFile(input.target, content, { flag: 'wx' });\n  await fs.chmod(input.target, 0o444).catch(() => undefined);\n  return {\n    source_kind: input.sourceKind,\n    source_relative_path: input.sourceRelativePath,\n    archive_relative_path: path.relative(input.generationRoot, input.target).split(path.sep).join('/'),\n    size: content.byteLength,\n    sha256: sha256(content),\n  };\n}\n\nexport async function archiveInvalidMergedSpecGeneration(input: {\n  projectRoot: string;\n  workItemDir: string;\n  workItemId: string;\n  proof: InvalidMergedSpecProof;\n}): Promise<RecoveryArchive> {\n  const generationId = `generation-${new Date().toISOString().replace(/[:.]/g, '-')}-${randomUUID()}`;\n  const archiveRoot = path.join(input.workItemDir, RECOVERY_ROOT);\n  const temporaryRoot = path.join(archiveRoot, `.${generationId}.tmp`);\n  const generationRoot = path.join(archiveRoot, generationId);\n  await fs.mkdir(archiveRoot, { recursive: true });\n  await fs.mkdir(temporaryRoot, { recursive: false });\n\n  const files: RecoveryEvidenceFile[] = [];\n  try {\n    for (const source of await collectWorkItemFiles({ workItemDir: input.workItemDir })) {\n      const relative = relativeInside(\n        input.workItemDir,\n        source,\n        'INVALID_MERGED_SPEC_RECOVERY_ARCHIVE_PATH_INVALID',\n      );\n      files.push(await copyEvidenceFile({\n        source,\n        target: path.join(temporaryRoot, 'snapshot', 'work-item', ...relative.split('/')),\n        sourceKind: 'work_item',\n        sourceRelativePath: relative,\n        generationRoot: temporaryRoot,\n      }));\n    }\n\n    for (const evidence of input.proof.input_files) {\n      const source = path.join(input.projectRoot, ...evidence.relative_path.split('/'));\n      const archived = await copyEvidenceFile({\n        source,\n        target: path.join(\n          temporaryRoot,\n          'snapshot',\n          'formal-project-spec',\n          ...evidence.relative_path.split('/'),\n        ),\n        sourceKind: 'formal_project_spec',\n        sourceRelativePath: evidence.relative_path,\n        generationRoot: temporaryRoot,\n      });\n      if (archived.size !== evidence.size || archived.sha256 !== evidence.sha256) {\n        throw new Error(\n          `INVALID_MERGED_SPEC_RECOVERY_VALIDATION_INPUT_CHANGED_DURING_ARCHIVE: ${evidence.relative_path}`,\n        );\n      }\n      files.push(archived);\n    }\n\n    files.sort((left, right) => left.archive_relative_path.localeCompare(right.archive_relative_path));\n    const manifestPath = path.join(temporaryRoot, 'manifest.json');\n    const manifest = {\n      schema_version: '1.0',\n      work_item_id: input.workItemId,\n      generation_id: generationId,\n      created_at: new Date().toISOString(),\n      project_spec_version: input.proof.current_project_spec.project_spec_version,\n      last_merged_work_item: input.proof.current_project_spec.last_merged_work_item,\n      file_count: files.length,\n      files,\n    };\n    await fs.writeFile(manifestPath, JSON.stringify(manifest, null, 2) + '\\n', { flag: 'wx' });\n    const manifestBytes = await fs.readFile(manifestPath);\n    await fs.chmod(manifestPath, 0o444).catch(() => undefined);\n    await fs.rename(temporaryRoot, generationRoot);\n    const finalManifestPath = path.join(generationRoot, 'manifest.json');\n    return {\n      generation_id: generationId,\n      generation_root: generationRoot,\n      manifest_path: finalManifestPath,\n      manifest_relative_path: relativeInside(input.workItemDir, finalManifestPath, 'INVALID_MERGED_SPEC_RECOVERY_ARCHIVE_PATH_INVALID'),\n      manifest_sha256: sha256(manifestBytes),\n      files,\n    };\n  } catch (error) {\n    await fs.rm(temporaryRoot, { recursive: true, force: true }).catch(() => undefined);\n    throw error;\n  }\n}\n\nexport async function verifyRecoveryArchive(input: {\n  workItemDir: string;\n  manifestRelativePath: string;\n  manifestSha256: string;\n  expectedWorkItemId?: string;\n  expectedGenerationId?: string;\n}): Promise<void> {\n  const manifestPath = path.join(input.workItemDir, ...input.manifestRelativePath.split('/'));\n  relativeInside(\n    path.join(input.workItemDir, RECOVERY_ROOT),\n    manifestPath,\n    'INVALID_MERGED_SPEC_RECOVERY_ARCHIVE_PATH_INVALID',\n  );\n  const bytes = await readRegularFile(\n    manifestPath,\n    'INVALID_MERGED_SPEC_RECOVERY_ARCHIVE_MANIFEST_INVALID',\n  );\n  if (sha256(bytes) !== input.manifestSha256) {\n    throw new Error('INVALID_MERGED_SPEC_RECOVERY_ARCHIVE_MANIFEST_HASH_MISMATCH');\n  }\n  const manifest = JSON.parse(bytes.toString('utf-8'));\n  if (!Array.isArray(manifest.files) || manifest.files.length === 0) {\n    throw new Error('INVALID_MERGED_SPEC_RECOVERY_ARCHIVE_MANIFEST_EMPTY');\n  }\n  const generationRoot = path.dirname(manifestPath);\n  const generationId = path.basename(generationRoot);\n  if (\n    manifest.schema_version !== '1.0' ||\n    manifest.generation_id !== generationId ||\n    (input.expectedGenerationId !== undefined &&\n      manifest.generation_id !== input.expectedGenerationId) ||\n    (input.expectedWorkItemId !== undefined &&\n      manifest.work_item_id !== input.expectedWorkItemId) ||\n    manifest.file_count !== manifest.files.length\n  ) {\n    throw new Error('INVALID_MERGED_SPEC_RECOVERY_ARCHIVE_MANIFEST_IDENTITY_MISMATCH');\n  }\n  const archivePaths = new Set<string>();\n  for (const entry of manifest.files as RecoveryEvidenceFile[]) {\n    if (\n      !entry ||\n      !['work_item', 'formal_project_spec'].includes(entry.source_kind) ||\n      typeof entry.source_relative_path !== 'string' ||\n      typeof entry.archive_relative_path !== 'string' ||\n      !Number.isSafeInteger(entry.size) ||\n      entry.size < 0 ||\n      !/^[0-9a-f]{64}$/.test(entry.sha256) ||\n      archivePaths.has(entry.archive_relative_path)\n    ) {\n      throw new Error('INVALID_MERGED_SPEC_RECOVERY_ARCHIVE_MANIFEST_ENTRY_INVALID');\n    }\n    archivePaths.add(entry.archive_relative_path);\n    const archived = path.join(generationRoot, ...String(entry.archive_relative_path).split('/'));\n    relativeInside(\n      generationRoot,\n      archived,\n      'INVALID_MERGED_SPEC_RECOVERY_ARCHIVE_ENTRY_PATH_INVALID',\n    );\n    const content = await readRegularFile(\n      archived,\n      'INVALID_MERGED_SPEC_RECOVERY_ARCHIVE_ENTRY_INVALID',\n    );\n    if (content.byteLength !== entry.size || sha256(content) !== entry.sha256) {\n      throw new Error(\n        `INVALID_MERGED_SPEC_RECOVERY_ARCHIVE_ENTRY_MISMATCH: ${entry.archive_relative_path}`,\n      );\n    }\n  }\n  for (const requiredPath of REQUIRED_WORK_ITEM_ARCHIVE_PATHS) {\n    if (!archivePaths.has(requiredPath)) {\n      throw new Error(\n        `INVALID_MERGED_SPEC_RECOVERY_ARCHIVE_REQUIRED_EVIDENCE_MISSING: ${requiredPath}`,\n      );\n    }\n  }\n  if (![...archivePaths].some(value => value.startsWith('snapshot/work-item/candidates/'))) {\n    throw new Error(\n      'INVALID_MERGED_SPEC_RECOVERY_ARCHIVE_REQUIRED_EVIDENCE_MISSING: snapshot/work-item/candidates/',\n    );\n  }\n  if (![...archivePaths].some(value => value.startsWith('snapshot/formal-project-spec/'))) {\n    throw new Error(\n      'INVALID_MERGED_SPEC_RECOVERY_ARCHIVE_REQUIRED_EVIDENCE_MISSING: snapshot/formal-project-spec/',\n    );\n  }\n}\n\nexport async function verifyInvalidMergedSpecRecoveryAuthorization(input: {\n  projectRoot: string;\n  workItemDir: string;\n  workItemId: string;\n}): Promise<Record<string, any>> {\n  const recoveryPath = path.join(input.workItemDir, RECOVERY_FILE);\n  const recovery = await readJson(recoveryPath).catch(() => null);\n  if (\n    recovery?.work_item_id !== input.workItemId ||\n    recovery?.recovery_action !== 'closed_to_candidate_preparing' ||\n    recovery?.status !== 'authorized' ||\n    !Array.isArray(recovery?.proof?.invalidity_reasons) ||\n    recovery.proof.invalidity_reasons.length === 0\n  ) {\n    throw new Error(\n      `STATE_COORDINATOR_INVALID_MERGED_SPEC_RECOVERY_FAILED: authorized ${RECOVERY_FILE} is required`,\n    );\n  }\n\n  await verifyRecoveryArchive({\n    workItemDir: input.workItemDir,\n    manifestRelativePath: String(recovery.archive?.manifest_path ?? ''),\n    manifestSha256: String(recovery.archive?.manifest_sha256 ?? ''),\n    expectedWorkItemId: input.workItemId,\n    expectedGenerationId: String(recovery.archive?.generation_id ?? ''),\n  });\n\n  const workItem = await readJson(path.join(input.workItemDir, 'work_item.json'));\n  if (workItem.code_change_allowed === true || workItem.code_permission_revoked !== true) {\n    throw new Error(\n      'STATE_COORDINATOR_INVALID_MERGED_SPEC_RECOVERY_FAILED: code permission must remain revoked',\n    );\n  }\n  const decision = await readJson(path.join(input.workItemDir, 'user_decision.json'));\n  if (\n    decision.decision_status !== 'invalidated' ||\n    !['approved', 'waived'].includes(String(decision.previous_decision_status ?? ''))\n  ) {\n    throw new Error(\n      'STATE_COORDINATOR_INVALID_MERGED_SPEC_RECOVERY_FAILED: prior active decision must be invalidated',\n    );\n  }\n\n  const manifest = await readJson(\n    path.join(input.projectRoot, SPEC_DIR_NAME, 'project', 'spec_manifest.json'),\n  );\n  if (\n    String(manifest.last_merged_work_item ?? '') !== input.workItemId ||\n    String(manifest.project_spec_version ?? '') !==\n      String(recovery.proof.current_project_spec?.project_spec_version ?? '')\n  ) {\n    throw new Error(\n      'STATE_COORDINATOR_INVALID_MERGED_SPEC_RECOVERY_FAILED: current Project Spec ownership changed',\n    );\n  }\n\n  for (const evidence of recovery.proof.input_files ?? []) {\n    const source = path.join(input.projectRoot, ...String(evidence.relative_path).split('/'));\n    relativeInside(\n      input.projectRoot,\n      source,\n      'STATE_COORDINATOR_INVALID_MERGED_SPEC_RECOVERY_FAILED',\n    );\n    const content = await readRegularFile(\n      source,\n      'STATE_COORDINATOR_INVALID_MERGED_SPEC_RECOVERY_FAILED',\n    );\n    if (content.byteLength !== evidence.size || sha256(content) !== evidence.sha256) {\n      throw new Error(\n        `STATE_COORDINATOR_INVALID_MERGED_SPEC_RECOVERY_FAILED: validation input changed: ${evidence.relative_path}`,\n      );\n    }\n  }\n  return recovery;\n}\n\nexport async function writeInvalidMergedSpecRecoveryRecord(\n  workItemDir: string,\n  record: Record<string, unknown>,\n): Promise<string> {\n  const recoveryPath = path.join(workItemDir, RECOVERY_FILE);\n  await writeJsonAtomic(recoveryPath, record);\n  return recoveryPath;\n}\n\nexport async function restoreFileAtomically(filePath: string, content: Buffer): Promise<void> {\n  const temporary = `${filePath}.rollback-${process.pid}-${Date.now()}-${randomUUID()}`;\n  await fs.writeFile(temporary, content);\n  await fs.rename(temporary, filePath);\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\merge-runner-v11.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"@specforge/types/directory-layout\"` with `'@specforge/types/directory-layout'`","line":1,"column":31,"nodeType":null,"messageId":"replace","endLine":1,"endColumn":66,"fix":{"range":[30,65],"text":"'@specforge/types/directory-layout'"}},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'value ?? ''' will use Object's default stringification format ('[object Object]') when stringified.","line":155,"column":17,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":155,"endColumn":28},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":171,"column":23,"nodeType":"TSAsExpression","messageId":"unnecessaryAssertion","endLine":184,"endColumn":16,"fix":{"range":[5397,5409],"text":""}},{"ruleId":"@typescript-eslint/no-unsafe-argument","severity":2,"message":"Unsafe argument of type `any` assigned to a parameter of type `Iterable<string> | null | undefined`.","line":173,"column":7,"nodeType":"CallExpression","messageId":"unsafeArgument","endLine":182,"endColumn":25},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······projectRoot,⏎······SPEC_DIR_NAME,⏎······'project',⏎······'modules',⏎······moduleCode⏎····` with `projectRoot,·SPEC_DIR_NAME,·'project',·'modules',·moduleCode`","line":202,"column":34,"nodeType":null,"messageId":"replace","endLine":208,"endColumn":5,"fix":{"range":[6077,6173],"text":"projectRoot, SPEC_DIR_NAME, 'project', 'modules', moduleCode"}},{"ruleId":"@typescript-eslint/no-unsafe-argument","severity":2,"message":"Unsafe argument of type `any` assigned to a parameter of type `Iterable<string> | null | undefined`.","line":218,"column":13,"nodeType":"CallExpression","messageId":"unsafeArgument","endLine":220,"endColumn":31},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'value ?? ''' will use Object's default stringification format ('[object Object]') when stringified.","line":219,"column":47,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":219,"endColumn":58},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":224,"column":56,"nodeType":"TSAsExpression","messageId":"unnecessaryAssertion","endLine":224,"endColumn":71,"fix":{"range":[6722,6729],"text":""}},{"ruleId":"@typescript-eslint/no-unsafe-argument","severity":2,"message":"Unsafe argument of type `any` assigned to a parameter of type `Iterable<string> | null | undefined`.","line":227,"column":13,"nodeType":"CallExpression","messageId":"unsafeArgument","endLine":229,"endColumn":31},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":227,"column":14,"nodeType":"TSAsExpression","messageId":"unnecessaryAssertion","endLine":227,"endColumn":29,"fix":{"range":[6811,6818],"text":""}},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'value ?? ''' will use Object's default stringification format ('[object Object]') when stringified.","line":228,"column":47,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":228,"endColumn":58},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `.trim()` with `⏎······.trim()⏎······`","line":235,"column":68,"nodeType":null,"messageId":"replace","endLine":235,"endColumn":75,"fix":{"range":[7185,7192],"text":"\n      .trim()\n      "}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":254,"column":8,"nodeType":"TSAsExpression","messageId":"unnecessaryAssertion","endLine":254,"endColumn":26,"fix":{"range":[7967,7974],"text":""}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":256,"column":8,"nodeType":"TSAsExpression","messageId":"unnecessaryAssertion","endLine":256,"endColumn":26,"fix":{"range":[8079,8086],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'module.json',·'requirements.md',·'design.md',·'contracts.json',·'trace.md'` with `⏎··'module.json',⏎··'requirements.md',⏎··'design.md',⏎··'contracts.json',⏎··'trace.md',⏎`","line":265,"column":36,"nodeType":null,"messageId":"replace","endLine":265,"endColumn":111,"fix":{"range":[8297,8372],"text":"\n  'module.json',\n  'requirements.md',\n  'design.md',\n  'contracts.json',\n  'trace.md',\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎····input.workItemDir,⏎····input.workflowPath⏎··` with `input.workItemDir,·input.workflowPath`","line":316,"column":60,"nodeType":null,"messageId":"replace","endLine":319,"endColumn":3,"fix":{"range":[9851,9900],"text":"input.workItemDir, input.workflowPath"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":410,"column":19,"nodeType":null,"messageId":"delete","endLine":410,"endColumn":20,"fix":{"range":[13249,13250],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎··········.map((value:·unknown)·=>·String(value·??·'').trim())⏎··········` with `.map((value:·unknown)·=>·String(value·??·'').trim())`","line":433,"column":30,"nodeType":null,"messageId":"replace","endLine":435,"endColumn":11,"fix":{"range":[13938,14012],"text":".map((value: unknown) => String(value ?? '').trim())"}},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'value ?? ''' will use Object's default stringification format ('[object Object]') when stringified.","line":434,"column":43,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":434,"endColumn":54},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `⏎`","line":477,"column":1,"nodeType":null,"messageId":"delete","endLine":478,"endColumn":1,"fix":{"range":[15434,15435],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `new·Set(Array.from(filePaths).map(value·=>·path.resolve(value)))` with `⏎····new·Set(Array.from(filePaths).map(value·=>·path.resolve(value)))⏎··`","line":486,"column":37,"nodeType":null,"messageId":"replace","endLine":486,"endColumn":101,"fix":{"range":[15703,15767],"text":"\n    new Set(Array.from(filePaths).map(value => path.resolve(value)))\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `normalizeProjectSpecTargetPath(targetPath)·===·(`${SPEC_DIR_NAME}/project/trace_matrix.md`·as·const)` with `(⏎····normalizeProjectSpecTargetPath(targetPath)·===⏎····(`${SPEC_DIR_NAME}/project/trace_matrix.md`·as·const)⏎··)`","line":514,"column":10,"nodeType":null,"messageId":"replace","endLine":514,"endColumn":110,"fix":{"range":[16621,16721],"text":"(\n    normalizeProjectSpecTargetPath(targetPath) ===\n    (`${SPEC_DIR_NAME}/project/trace_matrix.md` as const)\n  )"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `projectRoot:·string,·entries:·ManifestEntry[]` with `⏎··projectRoot:·string,⏎··entries:·ManifestEntry[]⏎`","line":536,"column":36,"nodeType":null,"messageId":"replace","endLine":536,"endColumn":81,"fix":{"range":[17425,17470],"text":"\n  projectRoot: string,\n  entries: ManifestEntry[]\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":540,"column":77,"nodeType":null,"messageId":"delete","endLine":540,"endColumn":78,"fix":{"range":[17654,17655],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `.trim()` with `⏎········.trim()⏎········`","line":543,"column":71,"nodeType":null,"messageId":"replace","endLine":543,"endColumn":78,"fix":{"range":[17815,17822],"text":"\n        .trim()\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":551,"column":56,"nodeType":null,"messageId":"delete","endLine":551,"endColumn":57,"fix":{"range":[18083,18084],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎····input.projectRoot,⏎····SPEC_DIR_NAME,⏎····'project',⏎····'trace_matrix.md',⏎··` with `input.projectRoot,·SPEC_DIR_NAME,·'project',·'trace_matrix.md'`","line":571,"column":33,"nodeType":null,"messageId":"replace","endLine":576,"endColumn":3,"fix":{"range":[18600,18683],"text":"input.projectRoot, SPEC_DIR_NAME, 'project', 'trace_matrix.md'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":641,"column":29,"nodeType":null,"messageId":"delete","endLine":641,"endColumn":30,"fix":{"range":[20842,20843],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":665,"column":27,"nodeType":null,"messageId":"delete","endLine":665,"endColumn":28,"fix":{"range":[21603,21604],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎····manifest,⏎····input.workItemId,⏎··` with `manifest,·input.workItemId`","line":706,"column":68,"nodeType":null,"messageId":"replace","endLine":709,"endColumn":3,"fix":{"range":[22678,22717],"text":"manifest, input.workItemId"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎········error·=>·`CANDIDATE_MANIFEST_SCHEMA_BLOCKED:·${error}`,⏎······` with `error·=>·`CANDIDATE_MANIFEST_SCHEMA_BLOCKED:·${error}``","line":715,"column":45,"nodeType":null,"messageId":"replace","endLine":717,"endColumn":7,"fix":{"range":[22875,22946],"text":"error => `CANDIDATE_MANIFEST_SCHEMA_BLOCKED: ${error}`"}},{"ruleId":"@typescript-eslint/no-unsafe-argument","severity":2,"message":"Unsafe argument of type `any` assigned to a parameter of type `ManifestEntry[]`.","line":749,"column":56,"nodeType":"Identifier","messageId":"unsafeArgument","endLine":749,"endColumn":71},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `item·=>·item.moduleCode·&&·traceProjection.governanceActive·&&·!traceProjection.governanceChanged` with `⏎······item·=>⏎········item.moduleCode·&&·traceProjection.governanceActive·&&·!traceProjection.governanceChanged⏎····`","line":866,"column":13,"nodeType":null,"messageId":"replace","endLine":866,"endColumn":110,"fix":{"range":[28611,28708],"text":"\n      item =>\n        item.moduleCode && traceProjection.governanceActive && !traceProjection.governanceChanged\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":869,"column":142,"nodeType":null,"messageId":"delete","endLine":869,"endColumn":143,"fix":{"range":[28928,28929],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":888,"column":25,"nodeType":null,"messageId":"delete","endLine":888,"endColumn":26,"fix":{"range":[29330,29331],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":894,"column":30,"nodeType":null,"messageId":"delete","endLine":894,"endColumn":31,"fix":{"range":[29466,29467],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎········input.projectRoot,⏎········SPEC_DIR_NAME,⏎········'project',⏎········'modules',⏎········moduleCode,⏎········'trace.md',⏎······),` with `input.projectRoot,·SPEC_DIR_NAME,·'project',·'modules',·moduleCode,·'trace.md')`","line":902,"column":17,"nodeType":null,"messageId":"replace","endLine":909,"endColumn":9,"fix":{"range":[29787,29924],"text":"input.projectRoot, SPEC_DIR_NAME, 'project', 'modules', moduleCode, 'trace.md')"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·······`","line":944,"column":27,"nodeType":null,"messageId":"insert","endLine":944,"endColumn":27,"fix":{"range":[31237,31237],"text":"\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `?·'sha256:'·+` with `··?·'sha256:'·+⏎···········`","line":945,"column":9,"nodeType":null,"messageId":"replace","endLine":945,"endColumn":22,"fix":{"range":[31314,31327],"text":"  ? 'sha256:' +\n           "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":946,"column":13,"nodeType":null,"messageId":"insert","endLine":946,"endColumn":13,"fix":{"range":[31347,31347],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":947,"column":1,"nodeType":null,"messageId":"insert","endLine":947,"endColumn":1,"fix":{"range":[31369,31369],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":948,"column":13,"nodeType":null,"messageId":"insert","endLine":948,"endColumn":13,"fix":{"range":[31436,31436],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":949,"column":1,"nodeType":null,"messageId":"insert","endLine":949,"endColumn":1,"fix":{"range":[31451,31451],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":989,"column":31,"nodeType":null,"messageId":"delete","endLine":989,"endColumn":32,"fix":{"range":[33130,33131],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":994,"column":35,"nodeType":null,"messageId":"delete","endLine":994,"endColumn":36,"fix":{"range":[33266,33267],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":999,"column":16,"nodeType":null,"messageId":"delete","endLine":999,"endColumn":17,"fix":{"range":[33405,33406],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":1012,"column":18,"nodeType":null,"messageId":"delete","endLine":1012,"endColumn":19,"fix":{"range":[33948,33949],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":1021,"column":92,"nodeType":null,"messageId":"delete","endLine":1021,"endColumn":93,"fix":{"range":[34257,34258],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":1026,"column":89,"nodeType":null,"messageId":"delete","endLine":1026,"endColumn":90,"fix":{"range":[34477,34478],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":1041,"column":84,"nodeType":null,"messageId":"delete","endLine":1041,"endColumn":85,"fix":{"range":[35292,35293],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":1065,"column":16,"nodeType":null,"messageId":"delete","endLine":1065,"endColumn":17,"fix":{"range":[36085,36086],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(`${SPEC_DIR_NAME}/project/spec_manifest.json`·as·const)` with ``${SPEC_DIR_NAME}/project/spec_manifest.json`·as·const`","line":1075,"column":11,"nodeType":null,"messageId":"replace","endLine":1075,"endColumn":67,"fix":{"range":[36356,36412],"text":"`${SPEC_DIR_NAME}/project/spec_manifest.json` as const"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(`${SPEC_DIR_NAME}/project/extension_registry.json`·as·const)` with ``${SPEC_DIR_NAME}/project/extension_registry.json`·as·const`","line":1076,"column":11,"nodeType":null,"messageId":"replace","endLine":1076,"endColumn":72,"fix":{"range":[36424,36485],"text":"`${SPEC_DIR_NAME}/project/extension_registry.json` as const"}}],"suppressedMessages":[],"errorCount":53,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":45,"fixableWarningCount":0,"source":"import { SPEC_DIR_NAME } from \"@specforge/types/directory-layout\";\n/**\n * merge-runner-v11.ts - v1.1 Spec Merge Runner\n *\n * P0 governance:\n * - Merge must use the same manifest normalization rules as approval.\n * - Merge must not infer or mutate candidate_manifest.json after approval.\n * - Spec-changing workflows must merge at least one Project Spec artifact.\n * - evidence_only / no_project_spec_change workflows never merge Work Item evidence.\n */\nimport * as fs from 'node:fs/promises';\nimport * as path from 'node:path';\nimport * as crypto from 'node:crypto';\nimport {\n  validateApprovedUserDecisionForMerge,\n  entriesSemanticallyEqual,\n  inferManifestEntries,\n  normalizeSlash,\n} from './governance-invariants-v11.js';\nimport {\n  normalizeProjectSpecTargetPath,\n  readDeclaredProjectSpecTargetPaths,\n} from './path-policy.js';\nimport {\n  canonicalProjectSpecModuleEntry,\n  ContractRegistrySchema,\n  extractModuleFromDdId,\n  moduleCodeFromProjectSpecPath,\n  resolveSpecModuleIdentity,\n  validateCurrentCandidateManifestValue,\n  MERGE_REPORT_CONTRACT_ID,\n} from '@specforge/types';\nimport { readUnifiedContracts } from './contracts-registry.js';\nimport {\n  applyGovernanceTraceDelta,\n  parseGovernanceTrace,\n  parseGovernanceTraceDelta,\n  renderGovernanceModuleTrace,\n  renderGovernanceTraceDocument,\n  type GovernanceTraceEdge,\n} from './governance-trace-model.js';\nimport {\n  assertAtomicSpecMergeWriteProvenanceCurrent,\n  recordAtomicSpecMergeProjectWrites,\n} from './atomic-spec-merge-write-provenance.js';\nimport { validateModuleDefinitionCandidateJson } from './artifact-schema-validation.js';\nimport { isSameOrDescendantResolvedPath } from './path-identity.js';\n\nexport interface MergeInput {\n  projectRoot: string;\n  workItemId: string;\n  workItemDir: string;\n  candidateManifestPath: string;\n  userDecisionPath: string;\n}\n\nexport interface MergeEntryResult {\n  candidate_path: string;\n  target_path: string;\n  operation: string;\n  status: 'success' | 'skipped' | 'failed' | 'not_applicable';\n  hash_match: boolean;\n  error?: string;\n}\n\nexport interface MergeResult {\n  success: boolean;\n  merged_files: MergeEntryResult[];\n  spec_manifest_updated: boolean;\n  project_spec_version: string;\n  errors: string[];\n  status?: 'success' | 'failed' | 'not_applicable';\n  reason?: string;\n  rolled_back?: boolean;\n}\n\ntype ManifestEntry = {\n  candidate_path: string;\n  target_path: string;\n  operation: string;\n  type?: string;\n  inferred?: boolean;\n  normalized?: boolean;\n};\n\nasync function fileExists(filePath: string): Promise<boolean> {\n  try {\n    await fs.access(filePath);\n    return true;\n  } catch {\n    return false;\n  }\n}\n\nasync function computeFileHash(filePath: string): Promise<string> {\n  try {\n    const content = await fs.readFile(filePath);\n    return 'sha256:' + crypto.createHash('sha256').update(content).digest('hex');\n  } catch {\n    return '';\n  }\n}\n\nasync function readJsonFile(filePath: string): Promise<any> {\n  const content = await fs.readFile(filePath, 'utf-8');\n  return JSON.parse(content);\n}\n\nasync function readCurrentProjectSpecVersion(projectRoot: string): Promise<string> {\n  const projectSpecManifestPath = path.join(\n    projectRoot,\n    SPEC_DIR_NAME,\n    'project',\n    'spec_manifest.json'\n  );\n  try {\n    const specManifest = await readJsonFile(projectSpecManifestPath);\n    return specManifest.project_spec_version ?? 'PSV-0000';\n  } catch {\n    return 'PSV-0000';\n  }\n}\n\nfunction isEvidenceOnlyNoProjectSpecChange(manifest: any): boolean {\n  return (\n    manifest?.no_project_spec_change === true ||\n    String(manifest?.project_integration_effect ?? '')\n      .trim()\n      .toLowerCase() === 'evidence_only'\n  );\n}\n\nfunction isNoProjectSpecMerge(manifest: any): boolean {\n  return (\n    manifest?.workflow_path === 'code_only_fast_path' || isEvidenceOnlyNoProjectSpecChange(manifest)\n  );\n}\n\nfunction isSubPath(child: string, parent: string): boolean {\n  return isSameOrDescendantResolvedPath(child, parent);\n}\n\nfunction normalizeEntryForMerge(entry: ManifestEntry): ManifestEntry {\n  return {\n    candidate_path: normalizeSlash(entry.candidate_path),\n    target_path: normalizeSlash(entry.target_path),\n    operation: entry.operation ?? 'replace',\n    type: entry.type,\n    inferred: Boolean(entry.inferred),\n    normalized: Boolean(entry.normalized),\n  };\n}\n\nfunction normalizeProjectTargetPathV12(value: unknown): string {\n  return String(value ?? '')\n    .replace(/\\\\/g, '/')\n    .replace(/^\\.\\//, '');\n}\nfunction inferModuleCodeFromProjectTarget(value: unknown): string | null {\n  return moduleCodeFromProjectSpecPath(normalizeProjectTargetPathV12(value));\n}\nasync function registerMergedProjectModules(\n  specManifest: any,\n  projectRoot: string,\n  replaceLegacyModuleEntries = false\n): Promise<void> {\n  if (!specManifest || typeof specManifest !== 'object') return;\n  const targets = Array.isArray(specManifest.last_merged_targets)\n    ? specManifest.last_merged_targets\n    : [];\n  const moduleCodes = Array.from(\n    new Set(\n      targets\n        .map((target: unknown) => {\n          const moduleCode = inferModuleCodeFromProjectTarget(target);\n          const normalizedTarget = normalizeProjectTargetPathV12(target);\n          return moduleCode &&\n            normalizedTarget.startsWith(`${SPEC_DIR_NAME}/project/modules/${moduleCode}/`)\n            ? moduleCode\n            : null;\n        })\n        .filter(Boolean)\n    )\n  ) as string[];\n\n  if (moduleCodes.length === 0) {\n    specManifest.modules = Array.isArray(specManifest.modules) ? specManifest.modules : [];\n    return;\n  }\n\n  const modules = Array.isArray(specManifest.modules) ? [...specManifest.modules] : [];\n  for (const moduleCode of moduleCodes) {\n    const existingIndex = modules.findIndex(entry => {\n      const resolution = resolveSpecModuleIdentity(entry);\n      return resolution.valid && resolution.moduleCode === moduleCode;\n    });\n    const existing =\n      existingIndex >= 0 && modules[existingIndex] && typeof modules[existingIndex] === 'object'\n        ? modules[existingIndex]\n        : {};\n\n    const moduleRoot = path.join(\n      projectRoot,\n      SPEC_DIR_NAME,\n      'project',\n      'modules',\n      moduleCode\n    );\n    let moduleDefinition: any = null;\n    try {\n      moduleDefinition = await readJsonFile(path.join(moduleRoot, 'module.json'));\n    } catch {\n      moduleDefinition = null;\n    }\n    const moduleCodePaths: string[] = Array.isArray(moduleDefinition?.code_paths)\n      ? Array.from(\n          new Set<string>(\n            moduleDefinition.code_paths\n              .map((value: unknown) => String(value ?? '').trim())\n              .filter(Boolean)\n          )\n        )\n      : [];\n    const existingCodePaths: string[] = Array.isArray((existing as any).code_paths)\n      ? Array.from(\n          new Set<string>(\n            (existing as any).code_paths\n              .map((value: unknown) => String(value ?? '').trim())\n              .filter(Boolean)\n          )\n        )\n      : [];\n    const codePaths = moduleCodePaths.length > 0 ? moduleCodePaths : existingCodePaths;\n    const contractsPath = path.join(moduleRoot, 'contracts.json');\n    const defaultModule = String(specManifest.default_module ?? '').trim().toUpperCase();\n    const governanceOnlyDefault =\n      moduleCode === defaultModule &&\n      Array.isArray(moduleDefinition?.code_paths) &&\n      moduleCodePaths.length === 0;\n    const governanceReady =\n      (codePaths.length > 0 || governanceOnlyDefault) && (await fileExists(contractsPath));\n\n    const canonicalEntry = canonicalProjectSpecModuleEntry(moduleCode, {\n      include_governance: governanceReady,\n      code_paths: codePaths,\n    });\n\n    // Normal merges preserve forward-compatible fields. A governed Project\n    // Spec repair replaces the legacy record so deprecated aliases do not survive.\n    const mergedEntry = replaceLegacyModuleEntries\n      ? canonicalEntry\n      : { ...existing, ...canonicalEntry };\n    if (governanceReady) {\n      (mergedEntry as any).contracts =\n        `${SPEC_DIR_NAME}/project/modules/${moduleCode}/contracts.json`;\n      (mergedEntry as any).code_paths = codePaths;\n    }\n\n    if (existingIndex >= 0) modules[existingIndex] = mergedEntry;\n    else modules.push(mergedEntry);\n  }\n  specManifest.modules = modules;\n}\n\nconst NEW_MODULE_REQUIRED_FILES = ['module.json', 'requirements.md', 'design.md', 'contracts.json', 'trace.md'] as const;\n\nconst PROJECT_SPEC_REPAIR_REQUIRED_FILES = [\n  'module.json',\n  'requirements.md',\n  'design.md',\n  'trace.md',\n] as const;\n\nasync function isGovernedNewModuleAdmission(\n  workItemDir: string,\n  workflowPath: unknown\n): Promise<boolean> {\n  if (workflowPath === 'architecture_change_path' || workflowPath === 'spec_migration_path') {\n    return true;\n  }\n  if (workflowPath !== 'requirement_change_path') return false;\n  try {\n    const trigger = await readJsonFile(path.join(workItemDir, 'trigger_result.json'));\n    return (\n      trigger?.classification?.architecture_changed === true ||\n      trigger?.classification?.module_boundary_changed === true\n    );\n  } catch {\n    return false;\n  }\n}\n\nasync function isProjectSpecRepairMerge(\n  workItemDir: string,\n  workflowPath: unknown\n): Promise<boolean> {\n  return (\n    workflowPath === 'spec_migration_path' &&\n    (await fileExists(path.join(workItemDir, 'project_spec_repair_plan.json')))\n  );\n}\n\nasync function validateGovernedNewModuleTargets(input: {\n  projectRoot: string;\n  workItemDir: string;\n  workflowPath: unknown;\n  entries: ManifestEntry[];\n  declaredTargetPaths: Set<string>;\n}): Promise<{ allowedTargets: Set<string>; errors: string[] }> {\n  const allowedTargets = new Set<string>();\n  const errors: string[] = [];\n  const governedModuleAdmission = await isGovernedNewModuleAdmission(\n    input.workItemDir,\n    input.workflowPath\n  );\n  const projectSpecRepair = await isProjectSpecRepairMerge(\n    input.workItemDir,\n    input.workflowPath\n  );\n\n  const specManifestPath = path.join(\n    input.projectRoot,\n    SPEC_DIR_NAME,\n    'project',\n    'spec_manifest.json'\n  );\n  let modules: unknown[] = [];\n  try {\n    const specManifest = await readJsonFile(specManifestPath);\n    modules = Array.isArray(specManifest?.modules) ? specManifest.modules : [];\n  } catch (error: any) {\n    errors.push(`Cannot validate Project Spec module registry: ${error.message}`);\n  }\n\n  const resolutions = modules.map(entry => resolveSpecModuleIdentity(entry));\n  const registryErrors = resolutions.flatMap(resolution => resolution.errors);\n  if (registryErrors.length > 0) {\n    errors.push(`MODULE_REGISTRY_INVALID: ${registryErrors.join('; ')}`);\n  }\n\n  const entriesByGovernedModule = new Map<string, Map<string, ManifestEntry>>();\n  for (const entry of input.entries) {\n    const target = normalizeProjectSpecTargetPath(entry.target_path);\n    if (!target || input.declaredTargetPaths.has(target)) continue;\n\n    const moduleCode = moduleCodeFromProjectSpecPath(target);\n    if (!moduleCode) continue;\n\n    const canonicalRoot = `${SPEC_DIR_NAME}/project/modules/${moduleCode}/`;\n    if (!target.startsWith(canonicalRoot)) {\n      errors.push(\n        `New module target must use canonical MODULE_CODE directory ${canonicalRoot}: ${target}`\n      );\n      continue;\n    }\n\n    if (!governedModuleAdmission) {\n      errors.push(\n        `Only architecture_change_path or spec_migration_path, or a governed requirement_change_path with architecture/module-boundary impact, may introduce module ${moduleCode}: ${target}`\n      );\n      continue;\n    }\n\n    if (entry.operation === 'delete') {\n      errors.push(`A new module cannot be introduced with delete operation: ${target}`);\n      continue;\n    }\n\n    const filename = target.slice(canonicalRoot.length);\n    const supportedFiles = projectSpecRepair\n      ? PROJECT_SPEC_REPAIR_REQUIRED_FILES\n      : NEW_MODULE_REQUIRED_FILES;\n\n    if (!supportedFiles.includes(filename as never)) {\n      errors.push(`Unsupported new module target for ${moduleCode}: ${target}`);\n      continue;\n    }\n\n    const moduleEntries =\n      entriesByGovernedModule.get(moduleCode) ?? new Map<string, ManifestEntry>();\n    moduleEntries.set(filename, entry);\n    entriesByGovernedModule.set(moduleCode, moduleEntries);\n  }\n\n  for (const [moduleCode, moduleEntries] of entriesByGovernedModule) {\n    const requiredFiles = projectSpecRepair\n      ? PROJECT_SPEC_REPAIR_REQUIRED_FILES\n      : NEW_MODULE_REQUIRED_FILES;\n    const missing = requiredFiles.filter(filename => !moduleEntries.has(filename));\n\n    if (missing.length > 0) {\n      errors.push(\n        `New module ${moduleCode} requires one approved candidate for each required file; missing: ${missing.join(', ')}`\n      );\n      continue;\n    }\n\n    const definitionEntry = moduleEntries.get('module.json') as ManifestEntry;\n    const definitionPath = path.resolve(input.workItemDir, definitionEntry.candidate_path);\n    if (!isSubPath(definitionPath, path.resolve(input.workItemDir))) {\n      errors.push(`New module ${moduleCode} module.json candidate is outside the Work Item`);\n      continue;\n    }\n\n    let definition: any;\n    try {\n      definition = await readJsonFile(definitionPath);\n      const validation = validateModuleDefinitionCandidateJson(\n        JSON.stringify(definition),\n        moduleCode,\n      );\n      if (!validation.valid) {\n        errors.push(\n          `New module ${moduleCode} module.json must satisfy the current schema: ${validation.errors.join('; ')}`\n        );\n        continue;\n      }\n    } catch (error: any) {\n      errors.push(\n        `Cannot validate new module ${moduleCode} module.json candidate: ${error.message}`\n      );\n      continue;\n    }\n\n    if (projectSpecRepair) {\n      for (const filename of PROJECT_SPEC_REPAIR_REQUIRED_FILES) {\n        allowedTargets.add(`${SPEC_DIR_NAME}/project/modules/${moduleCode}/${filename}`);\n      }\n      continue;\n    }\n\n    const codePaths = Array.isArray(definition?.code_paths)\n      ? definition.code_paths\n          .map((value: unknown) => String(value ?? '').trim())\n          .filter(Boolean)\n      : [];\n    if (codePaths.length === 0) {\n      errors.push(`New module ${moduleCode} module.json must declare non-empty code_paths`);\n      continue;\n    }\n\n    const contractsEntry = moduleEntries.get('contracts.json') as ManifestEntry;\n    const contractsPath = path.resolve(input.workItemDir, contractsEntry.candidate_path);\n    if (!isSubPath(contractsPath, path.resolve(input.workItemDir))) {\n      errors.push(`New module ${moduleCode} contracts.json candidate is outside the Work Item`);\n      continue;\n    }\n\n    try {\n      const contracts = await readJsonFile(contractsPath);\n      const registry = ContractRegistrySchema.safeParse(contracts?.contracts);\n      if (\n        contracts?.schema_version !== '1.0' ||\n        String(contracts?.owner_module ?? '').trim() !== moduleCode ||\n        !registry.success\n      ) {\n        errors.push(\n          `New module ${moduleCode} contracts.json must declare schema_version=1.0, owner_module=${moduleCode}, and a valid contracts registry`\n        );\n        continue;\n      }\n    } catch (error: any) {\n      errors.push(\n        `Cannot validate new module ${moduleCode} contracts.json candidate: ${error.message}`\n      );\n      continue;\n    }\n\n    for (const filename of NEW_MODULE_REQUIRED_FILES) {\n      allowedTargets.add(`${SPEC_DIR_NAME}/project/modules/${moduleCode}/${filename}`);\n    }\n  }\n\n  return { allowedTargets, errors };\n}\n\n\ntype MergeFileSnapshot = {\n  filePath: string;\n  existed: boolean;\n  content: Buffer | null;\n};\n\nasync function snapshotFiles(filePaths: Iterable<string>): Promise<MergeFileSnapshot[]> {\n  const snapshots: MergeFileSnapshot[] = [];\n  for (const filePath of Array.from(new Set(Array.from(filePaths).map(value => path.resolve(value))))) {\n    try {\n      snapshots.push({ filePath, existed: true, content: await fs.readFile(filePath) });\n    } catch {\n      snapshots.push({ filePath, existed: false, content: null });\n    }\n  }\n  return snapshots;\n}\n\nasync function restoreSnapshots(snapshots: MergeFileSnapshot[]): Promise<string[]> {\n  const errors: string[] = [];\n  for (const snapshot of [...snapshots].reverse()) {\n    try {\n      if (snapshot.existed) {\n        await fs.mkdir(path.dirname(snapshot.filePath), { recursive: true });\n        await fs.writeFile(snapshot.filePath, snapshot.content as Buffer);\n      } else {\n        await fs.rm(snapshot.filePath, { force: true });\n      }\n    } catch (error) {\n      errors.push(`${snapshot.filePath}: ${(error as Error).message}`);\n    }\n  }\n  return errors;\n}\n\nfunction isProjectTraceTarget(targetPath: string): boolean {\n  return normalizeProjectSpecTargetPath(targetPath) === (`${SPEC_DIR_NAME}/project/trace_matrix.md` as const);\n}\n\nfunction targetModuleTrace(targetPath: string): string | null {\n  const normalized = normalizeProjectSpecTargetPath(targetPath);\n  const moduleCode = moduleCodeFromProjectSpecPath(normalized);\n  return moduleCode && normalized === `${SPEC_DIR_NAME}/project/modules/${moduleCode}/trace.md`\n    ? moduleCode\n    : null;\n}\n\nfunction designOwnersFromTrace(edges: Iterable<GovernanceTraceEdge>): Map<string, string> {\n  const owners = new Map<string, string>();\n  for (const edge of edges) {\n    for (const id of [edge.from, edge.to]) {\n      const moduleCode = extractModuleFromDdId(id);\n      if (moduleCode) owners.set(id, moduleCode);\n    }\n  }\n  return owners;\n}\n\nasync function governedModuleCodes(projectRoot: string, entries: ManifestEntry[]): Promise<string[]> {\n  const result = new Set<string>();\n  try {\n    const manifest = await readJsonFile(\n      path.join(projectRoot, SPEC_DIR_NAME, 'project', 'spec_manifest.json'),\n    );\n    for (const raw of Array.isArray(manifest?.modules) ? manifest.modules : []) {\n      const moduleCode = String(raw?.module_code ?? raw?.module ?? '').trim().toUpperCase();\n      if (moduleCode) result.add(moduleCode);\n    }\n  } catch {\n    // New Project Spec bootstrap.\n  }\n  for (const entry of entries) {\n    const moduleCode = moduleCodeFromProjectSpecPath(\n      normalizeProjectSpecTargetPath(entry.target_path),\n    );\n    if (moduleCode) result.add(moduleCode);\n  }\n  return Array.from(result).sort();\n}\n\nasync function projectTraceProjection(input: {\n  projectRoot: string;\n  workItemDir: string;\n  entries: ManifestEntry[];\n}): Promise<{\n  targeted: boolean;\n  governanceChanged: boolean;\n  governanceActive: boolean;\n  edges: GovernanceTraceEdge[];\n  content: string | null;\n  errors: string[];\n}> {\n  const traceEntry = input.entries.find(entry => isProjectTraceTarget(entry.target_path));\n  const currentPath = path.join(\n    input.projectRoot,\n    SPEC_DIR_NAME,\n    'project',\n    'trace_matrix.md',\n  );\n  let currentContent = '';\n  try {\n    currentContent = await fs.readFile(currentPath, 'utf-8');\n  } catch {\n    // Empty current Trace is valid during bootstrap.\n  }\n  const current = parseGovernanceTrace(currentContent, currentPath);\n  const currentGovernanceActive = current.marked_section || current.edges.length > 0;\n  if (!traceEntry) {\n    return {\n      targeted: false,\n      governanceChanged: false,\n      governanceActive: currentGovernanceActive,\n      edges: current.edges,\n      content: null,\n      errors: current.issues.map(issue => issue.message),\n    };\n  }\n\n  if (traceEntry.operation === 'delete') {\n    return {\n      targeted: true,\n      governanceChanged: false,\n      governanceActive: currentGovernanceActive,\n      edges: current.edges,\n      content: null,\n      errors: [\n        'The canonical Project Trace Matrix cannot be deleted; use explicit REMOVE operations in the Governance Relation Delta section.',\n      ],\n    };\n  }\n\n  const candidatePath = path.resolve(input.workItemDir, traceEntry.candidate_path);\n  let deltaContent = '';\n  try {\n    deltaContent = await fs.readFile(candidatePath, 'utf-8');\n  } catch (error) {\n    return {\n      targeted: true,\n      governanceChanged: false,\n      governanceActive: currentGovernanceActive,\n      edges: current.edges,\n      content: null,\n      errors: [`Cannot read Trace Delta ${traceEntry.candidate_path}: ${(error as Error).message}`],\n    };\n  }\n\n  const delta = parseGovernanceTraceDelta(deltaContent, candidatePath);\n  const candidateAsFormalTrace = parseGovernanceTrace(deltaContent, candidatePath);\n  if (\n    delta.operations.length === 0 &&\n    !delta.marked_section &&\n    candidateAsFormalTrace.edges.length > 0\n  ) {\n    delta.issues.push({\n      code: 'TRACE_DELTA_FULL_GOVERNANCE_MATRIX_FORBIDDEN',\n      message:\n        'trace_delta.md cannot replace Governance Relations with a full From/Relation/To matrix; use explicit ADD/REMOVE operations.',\n      source: candidatePath,\n    });\n  }\n\n  if (delta.operations.length === 0) {\n    const errors = [...current.issues, ...delta.issues, ...candidateAsFormalTrace.issues].map(\n      issue => issue.message,\n    );\n    const legacyContent = delta.marked_section\n      ? delta.content_without_governance_delta\n      : deltaContent;\n    let content: string | null = legacyContent;\n    if (currentGovernanceActive && errors.length === 0) {\n      content = renderGovernanceTraceDocument(legacyContent, current.edges);\n    }\n    return {\n      targeted: true,\n      governanceChanged: false,\n      governanceActive: currentGovernanceActive,\n      edges: current.edges,\n      content: errors.length === 0 ? content : null,\n      errors,\n    };\n  }\n\n  const projection = applyGovernanceTraceDelta({\n    current: current.edges,\n    operations: delta.operations,\n  });\n  const errors = [...current.issues, ...delta.issues, ...projection.issues].map(\n    issue => issue.message,\n  );\n  const baseContent =\n    delta.marked_section && delta.has_legacy_trace_payload\n      ? delta.content_without_governance_delta\n      : currentContent;\n  return {\n    targeted: true,\n    governanceChanged: true,\n    governanceActive: true,\n    edges: projection.prospective,\n    content:\n      errors.length === 0\n        ? renderGovernanceTraceDocument(baseContent, projection.prospective)\n        : null,\n    errors,\n  };\n}\n\nexport async function executeMerge(input: MergeInput): Promise<MergeResult> {\n  const result: MergeResult = {\n    success: true,\n    merged_files: [],\n    spec_manifest_updated: false,\n    project_spec_version: '',\n    errors: [],\n    status: 'success',\n  };\n  const preflightErrors: string[] = [];\n\n  let manifest: any;\n  try {\n    manifest = await readJsonFile(input.candidateManifestPath);\n  } catch (err: any) {\n    return {\n      ...result,\n      success: false,\n      status: 'failed',\n      errors: ['Cannot read candidate_manifest.json: ' + err.message],\n    };\n  }\n  const manifestValidation = validateCurrentCandidateManifestValue(\n    manifest,\n    input.workItemId,\n  );\n  if (!manifestValidation.valid) {\n    return {\n      ...result,\n      success: false,\n      status: 'failed',\n      errors: manifestValidation.errors.map(\n        error => `CANDIDATE_MANIFEST_SCHEMA_BLOCKED: ${error}`,\n      ),\n    };\n  }\n\n  const manifestEntries = Array.isArray(manifest.entries)\n    ? manifest.entries.map((entry: ManifestEntry) => normalizeEntryForMerge(entry))\n    : [];\n  const noProjectSpecMerge = isNoProjectSpecMerge(manifest);\n  const normalizedEntries = noProjectSpecMerge\n    ? []\n    : inferManifestEntries(manifest, input.workItemDir).map(normalizeEntryForMerge);\n  const entries = normalizedEntries;\n\n  result.project_spec_version = await readCurrentProjectSpecVersion(input.projectRoot);\n  const previousProjectSpecVersion = result.project_spec_version;\n\n  if (isEvidenceOnlyNoProjectSpecChange(manifest)) {\n    const evidenceOnlyCanonical =\n      manifest.no_project_spec_change === true &&\n      String(manifest.project_integration_effect ?? '')\n        .trim()\n        .toLowerCase() === 'evidence_only' &&\n      manifest.merge_required === false &&\n      manifest.merge_applicable === false &&\n      manifestEntries.length === 0;\n    if (!evidenceOnlyCanonical) {\n      preflightErrors.push(\n        'evidence_only candidate_manifest must set no_project_spec_change=true, project_integration_effect=evidence_only, merge_required=false, merge_applicable=false, and entries=[].'\n      );\n    }\n  }\n\n  if (!noProjectSpecMerge && !entriesSemanticallyEqual(manifestEntries, normalizedEntries)) {\n    preflightErrors.push(\n      'candidate_manifest.entries must be normalized before user approval; merge_runner uses the same inferManifestEntries() rules as approval and will not infer or mutate entries after approval.'\n    );\n  }\n\n  if (noProjectSpecMerge && preflightErrors.length === 0) {\n    const evidenceOnly = isEvidenceOnlyNoProjectSpecChange(manifest);\n    const notApplicable: MergeResult = {\n      ...result,\n      success: true,\n      status: 'not_applicable',\n      reason: evidenceOnly\n        ? 'evidence_only Work Item artifacts are retained as evidence and are not merged into Project Spec.'\n        : 'code_only_fast_path has no candidate spec artifacts to merge; candidate_manifest.entries is empty.',\n      merged_files: [],\n      spec_manifest_updated: false,\n    };\n    await generateMergeReport(input, notApplicable);\n    return notApplicable;\n  }\n\n  if (entries.length === 0) {\n    if (!noProjectSpecMerge) {\n      preflightErrors.push(\n        'Non-code-only workflow requires at least one merge entry. candidate_manifest.entries is empty.'\n      );\n    }\n  }\n\n  if (manifest.project_spec_precondition_sha256) {\n    const currentManifestPath = path.join(\n      input.projectRoot,\n      SPEC_DIR_NAME,\n      'project',\n      'spec_manifest.json'\n    );\n    const currentManifestHash = await computeFileHash(currentManifestPath);\n    if (currentManifestHash !== manifest.project_spec_precondition_sha256) {\n      preflightErrors.push(\n        'PROJECT_SPEC_PRECONDITION_STALE: spec_manifest.json changed after repair Candidates were prepared.'\n      );\n    }\n  }\n\n  const declaredTargetPaths = await readDeclaredProjectSpecTargetPaths(input.projectRoot);\n  const governedNewModules = await validateGovernedNewModuleTargets({\n    projectRoot: input.projectRoot,\n    workItemDir: input.workItemDir,\n    workflowPath: manifest.workflow_path,\n    entries,\n    declaredTargetPaths,\n  });\n  const undeclaredTargets = entries\n    .map(entry => normalizeProjectSpecTargetPath(entry.target_path))\n    .filter(\n      targetPath =>\n        !declaredTargetPaths.has(targetPath) && !governedNewModules.allowedTargets.has(targetPath)\n    );\n  if (governedNewModules.errors.length > 0 || undeclaredTargets.length > 0) {\n    preflightErrors.push(...governedNewModules.errors);\n    if (undeclaredTargets.length > 0) {\n      preflightErrors.push(\n        `candidate_manifest contains target_path values not declared by spec_manifest.json: ${Array.from(\n          new Set(undeclaredTargets)\n        ).join(', ')}`\n      );\n    }\n  }\n\n  const approvalValidation = await validateApprovedUserDecisionForMerge({\n    projectRoot: input.projectRoot,\n    workItemDir: input.workItemDir,\n    workItemId: input.workItemId,\n    candidateManifestPath: input.candidateManifestPath,\n    userDecisionPath: input.userDecisionPath,\n  });\n\n  if (!approvalValidation.valid) {\n    preflightErrors.push(...approvalValidation.errors);\n  }\n\n  const workItemRoot = path.resolve(input.workItemDir);\n  const projectSpecRoot = path.resolve(input.projectRoot, SPEC_DIR_NAME, 'project');\n\n  for (const entry of entries) {\n    const candidateFullPath = path.resolve(input.workItemDir, entry.candidate_path);\n    const targetFullPath = path.resolve(input.projectRoot, entry.target_path);\n    if (!isSubPath(candidateFullPath, workItemRoot)) {\n      preflightErrors.push('Security: candidate_path outside WI: ' + entry.candidate_path);\n    }\n    if (!isSubPath(targetFullPath, projectSpecRoot)) {\n      preflightErrors.push(\n        'Security: target_path outside .specforge/project/: ' + entry.target_path\n      );\n    }\n    if (!(await fileExists(candidateFullPath))) {\n      preflightErrors.push('Candidate file does not exist: ' + entry.candidate_path);\n    }\n  }\n\n  const traceProjection = await projectTraceProjection({\n    projectRoot: input.projectRoot,\n    workItemDir: input.workItemDir,\n    entries,\n  });\n  if (traceProjection.errors.length > 0) {\n    preflightErrors.push(...traceProjection.errors.map(error => `TRACE_DELTA_INVALID: ${error}`));\n  }\n\n  try {\n    assertAtomicSpecMergeWriteProvenanceCurrent(input.projectRoot);\n  } catch (error) {\n    preflightErrors.push(error instanceof Error ? error.message : String(error));\n  }\n  const independentModuleTraceTargets = entries\n    .map(entry => ({ entry, moduleCode: targetModuleTrace(entry.target_path) }))\n    .filter(item => item.moduleCode && traceProjection.governanceActive && !traceProjection.governanceChanged);\n  if (independentModuleTraceTargets.length > 0) {\n    preflightErrors.push(\n      'Module trace.md is a generated projection and cannot be merged independently; update the canonical Project Trace through Trace Delta.',\n    );\n  }\n\n  if (preflightErrors.length > 0) {\n    const failed: MergeResult = {\n      ...result,\n      success: false,\n      status: 'failed',\n      errors: Array.from(new Set(preflightErrors)),\n    };\n    await generateMergeReport(input, failed);\n    return failed;\n  }\n\n  const projectSpecManifestPath = path.join(\n    input.projectRoot,\n    SPEC_DIR_NAME,\n    'project',\n    'spec_manifest.json',\n  );\n  const extensionRegistryPath = path.join(\n    input.projectRoot,\n    SPEC_DIR_NAME,\n    'project',\n    'extension_registry.json',\n  );\n  const moduleCodes = await governedModuleCodes(input.projectRoot, entries);\n  const transactionTargets = new Set<string>([\n    projectSpecManifestPath,\n    extensionRegistryPath,\n    ...entries.map(entry => path.resolve(input.projectRoot, entry.target_path)),\n    ...moduleCodes.map(moduleCode =>\n      path.join(\n        input.projectRoot,\n        SPEC_DIR_NAME,\n        'project',\n        'modules',\n        moduleCode,\n        'trace.md',\n      ),\n    ),\n  ]);\n  const snapshots = await snapshotFiles(transactionTargets);\n\n  try {\n    for (const entry of entries) {\n      const candidateFullPath = path.resolve(input.workItemDir, entry.candidate_path);\n      const targetFullPath = path.resolve(input.projectRoot, entry.target_path);\n      const moduleTraceCode = targetModuleTrace(entry.target_path);\n\n      if (traceProjection.governanceChanged && moduleTraceCode) {\n        // Module Trace is a generated projection and is written after all formal\n        // objects and spec_manifest.json are committed inside this transaction.\n        continue;\n      }\n\n      if (entry.operation === 'delete') {\n        await fs.rm(targetFullPath, { force: true });\n        result.merged_files.push({\n          candidate_path: entry.candidate_path,\n          target_path: entry.target_path,\n          operation: 'delete',\n          status: 'success',\n          hash_match: true,\n        });\n        continue;\n      }\n\n      await fs.mkdir(path.dirname(targetFullPath), { recursive: true });\n      if (isProjectTraceTarget(entry.target_path) && traceProjection.targeted) {\n        await fs.writeFile(targetFullPath, traceProjection.content as string, 'utf-8');\n      } else {\n        await fs.copyFile(candidateFullPath, targetFullPath);\n      }\n      const expectedHash = isProjectTraceTarget(entry.target_path) && traceProjection.targeted\n        ? 'sha256:' + crypto\n            .createHash('sha256')\n            .update(traceProjection.content as string)\n            .digest('hex')\n        : await computeFileHash(candidateFullPath);\n      const targetHash = await computeFileHash(targetFullPath);\n      if (expectedHash !== targetHash) {\n        throw new Error(`Hash mismatch after writing ${entry.target_path}`);\n      }\n      result.merged_files.push({\n        candidate_path: entry.candidate_path,\n        target_path: entry.target_path,\n        operation: entry.operation,\n        status: 'success',\n        hash_match: true,\n      });\n    }\n\n    if (entries.length > 0) {\n      const versionMatch = /^PSV-(\\d+)$/.exec(result.project_spec_version);\n      if (!versionMatch) {\n        throw new Error(`Invalid current project_spec_version: ${result.project_spec_version}`);\n      }\n      const versionNum = Number.parseInt(versionMatch[1], 10);\n      const newVersion = 'PSV-' + String(versionNum + 1).padStart(4, '0');\n      result.project_spec_version = newVersion;\n\n      let specManifest: any = {};\n      try {\n        specManifest = await readJsonFile(projectSpecManifestPath);\n      } catch {\n        // First spec merge.\n      }\n      specManifest.schema_version = specManifest.schema_version ?? '1.0';\n      specManifest.project_spec_version = newVersion;\n      specManifest.last_merged_work_item = input.workItemId;\n      specManifest.last_merged_at = new Date().toISOString();\n      specManifest.last_merged_targets = result.merged_files\n        .filter(entry => entry.status === 'success')\n        .map(entry => entry.target_path);\n\n      await fs.mkdir(path.dirname(projectSpecManifestPath), { recursive: true });\n      const replaceLegacyModuleEntries = await isProjectSpecRepairMerge(\n        input.workItemDir,\n        manifest.workflow_path,\n      );\n      await registerMergedProjectModules(\n        specManifest,\n        input.projectRoot,\n        replaceLegacyModuleEntries,\n      );\n      await fs.writeFile(\n        projectSpecManifestPath,\n        JSON.stringify(specManifest, null, 2) + '\\n',\n        'utf-8',\n      );\n      result.spec_manifest_updated = true;\n\n      const registry = await readJsonFile(extensionRegistryPath);\n      if (!registry || typeof registry !== 'object' || Array.isArray(registry)) {\n        throw new Error('Project Spec Core extension_registry.json is missing or invalid');\n      }\n      if (registry.project_spec_version !== newVersion) {\n        registry.project_spec_version = newVersion;\n        await fs.writeFile(\n          extensionRegistryPath,\n          JSON.stringify(registry, null, 2) + '\\n',\n          'utf-8',\n        );\n      }\n    }\n\n    if (traceProjection.governanceChanged) {\n      const unifiedContracts = readUnifiedContracts(input.projectRoot);\n      if (unifiedContracts.errors.length > 0) {\n        throw new Error(\n          `Cannot generate Module Trace projections: ${unifiedContracts.errors.join('; ')}`,\n        );\n      }\n      const designOwners = designOwnersFromTrace(traceProjection.edges);\n      const contractOwners = new Map(\n        unifiedContracts.contracts.map(contract => [contract.id, contract.owner_module]),\n      );\n      const finalModuleCodes = await governedModuleCodes(input.projectRoot, entries);\n      for (const moduleCode of finalModuleCodes) {\n        const targetPath = `${SPEC_DIR_NAME}/project/modules/${moduleCode}/trace.md`;\n        const targetFullPath = path.join(input.projectRoot, ...targetPath.split('/'));\n        const content = renderGovernanceModuleTrace({\n          edges: traceProjection.edges,\n          module_code: moduleCode,\n          design_owners: designOwners,\n          contract_owners: contractOwners,\n        });\n        await fs.mkdir(path.dirname(targetFullPath), { recursive: true });\n        await fs.writeFile(targetFullPath, content, 'utf-8');\n        const existing = result.merged_files.find(\n          entry => normalizeProjectSpecTargetPath(entry.target_path) === targetPath,\n        );\n        if (existing) {\n          existing.status = 'success';\n          existing.hash_match = true;\n          existing.error = undefined;\n        } else {\n          result.merged_files.push({\n            candidate_path: 'generated:project_trace_projection',\n            target_path: targetPath,\n            operation: 'replace',\n            status: 'success',\n            hash_match: true,\n          });\n        }\n      }\n\n      const specManifest = await readJsonFile(projectSpecManifestPath);\n      specManifest.last_merged_targets = result.merged_files\n        .filter(entry => entry.status === 'success')\n        .map(entry => entry.target_path);\n      await fs.writeFile(\n        projectSpecManifestPath,\n        JSON.stringify(specManifest, null, 2) + '\\n',\n        'utf-8',\n      );\n    }\n\n    if (result.spec_manifest_updated) {\n      recordAtomicSpecMergeProjectWrites({\n        projectRoot: input.projectRoot,\n        workItemId: input.workItemId,\n        projectSpecVersion: result.project_spec_version,\n        relativePaths: [\n          (`${SPEC_DIR_NAME}/project/spec_manifest.json` as const),\n          (`${SPEC_DIR_NAME}/project/extension_registry.json` as const),\n          ...result.merged_files\n            .filter(entry => entry.status === 'success' && entry.operation !== 'delete')\n            .map(entry => entry.target_path),\n        ],\n      });\n    }\n  } catch (error) {\n    const rollbackErrors = await restoreSnapshots(snapshots);\n    result.success = false;\n    result.rolled_back = rollbackErrors.length === 0;\n    result.spec_manifest_updated = false;\n    result.project_spec_version = previousProjectSpecVersion;\n    result.errors.push(`Atomic merge failed and was rolled back: ${(error as Error).message}`);\n    if (rollbackErrors.length > 0) {\n      result.errors.push(`Rollback errors: ${rollbackErrors.join('; ')}`);\n    }\n    for (const entry of result.merged_files) {\n      if (entry.status === 'success') {\n        entry.status = 'failed';\n        entry.hash_match = false;\n        entry.error = 'Rolled back because another merge operation failed';\n      }\n    }\n  }\n\n  result.status = result.success ? 'success' : 'failed';\n  await generateMergeReport(input, result);\n  return result;\n}\n\nasync function generateMergeReport(input: MergeInput, result: MergeResult): Promise<void> {\n  const status = result.status ?? (result.success ? 'success' : 'failed');\n  const lines: string[] = [\n    '# Merge Report',\n    '',\n    'Contract: ' + MERGE_REPORT_CONTRACT_ID,\n    'Work Item: ' + input.workItemId,\n    'Status: ' + status,\n    'Timestamp: ' + new Date().toISOString(),\n    '',\n    '## Summary',\n    '',\n    '- Total entries: ' + result.merged_files.length,\n    '- Successful: ' + result.merged_files.filter(e => e.status === 'success').length,\n    '- Failed: ' + result.merged_files.filter(e => e.status === 'failed').length,\n    '- Spec Manifest Updated: ' + result.spec_manifest_updated,\n    '- Project Spec Version: ' + (result.project_spec_version || 'N/A'),\n  ];\n\n  if (status === 'not_applicable') {\n    lines.push(\n      '',\n      '## Not Applicable',\n      '',\n      result.reason ?? 'No Candidate artifacts need to be merged.'\n    );\n  }\n\n  lines.push(\n    '',\n    '## Inputs',\n    '',\n    '- candidate_manifest: ' + input.candidateManifestPath,\n    '- user_decision: ' + input.userDecisionPath,\n    '',\n    '## Merged Files',\n    ''\n  );\n\n  if (result.merged_files.length === 0) {\n    lines.push('No files merged.');\n  } else {\n    lines.push('| Status | Operation | Candidate | Target | Hash Match |');\n    lines.push('|--------|-----------|-----------|--------|------------|');\n    for (const entry of result.merged_files) {\n      lines.push(\n        '| ' +\n          entry.status +\n          ' | ' +\n          entry.operation +\n          ' | ' +\n          entry.candidate_path +\n          ' | ' +\n          entry.target_path +\n          ' | ' +\n          entry.hash_match +\n          ' |'\n      );\n      if (entry.error) lines.push('- Error: ' + entry.error);\n    }\n  }\n\n  if (result.errors.length > 0) {\n    lines.push('', '## Errors', '', ...result.errors.map(err => '- ' + err));\n  }\n\n  lines.push('', '## Evidence', '', '- merge_runner_execution_log');\n  await fs.writeFile(path.join(input.workItemDir, 'merge_report.md'), lines.join('\\n'), 'utf-8');\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\native-write-boundary.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"@specforge/types/directory-layout\"` with `'@specforge/types/directory-layout'`","line":1,"column":31,"nodeType":null,"messageId":"replace","endLine":1,"endColumn":66,"fix":{"range":[30,65],"text":"'@specforge/types/directory-layout'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'read',·'glob',·'grep',·'list',·'webfetch',·'websearch',·'codesearch',·'todowrite',·'todoread',·'question',·'task',·'skill',·'lsp'` with `⏎··'read',⏎··'glob',⏎··'grep',⏎··'list',⏎··'webfetch',⏎··'websearch',⏎··'codesearch',⏎··'todowrite',⏎··'todoread',⏎··'question',⏎··'task',⏎··'skill',⏎··'lsp',⏎`","line":13,"column":36,"nodeType":null,"messageId":"replace","endLine":13,"endColumn":166,"fix":{"range":[645,775],"text":"\n  'read',\n  'glob',\n  'grep',\n  '