ext":" reject) => "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'git',·['--no-pager',·'-c',·'core.fsmonitor=false',·'-c',` with `⏎······'git',⏎······[⏎········'--no-pager',⏎········'-c',⏎········'core.fsmonitor=false',⏎········'-c',⏎·······`","line":34,"column":14,"nodeType":null,"messageId":"replace","endLine":34,"endColumn":71,"fix":{"range":[1722,1779],"text":"\n      'git',\n      [\n        '--no-pager',\n        '-c',\n        'core.fsmonitor=false',\n        '-c',\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'-c',·`core.hooksPath=${process.platform·===·'win32'·?·'NUL'·:·'/dev/null'}`,·'-c',·'gc.auto=0',·...args` with `····'-c',⏎········`core.hooksPath=${process.platform·===·'win32'·?·'NUL'·:·'/dev/null'}`,⏎········'-c',⏎········'gc.auto=0',⏎········...args,⏎······`","line":35,"column":5,"nodeType":null,"messageId":"replace","endLine":35,"endColumn":109,"fix":{"range":[1808,1912],"text":"    '-c',\n        `core.hooksPath=${process.platform === 'win32' ? 'NUL' : '/dev/null'}`,\n        '-c',\n        'gc.auto=0',\n        ...args,\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `{·cwd:·root,·env,·encoding:·'utf8',·windowsHide:·true,·shell:false,·timeout:·15000,·maxBuffer:·16·*·1024·*·1024·},(error,stdout)=>` with `····{⏎········cwd:·root,⏎········env,⏎········encoding:·'utf8',⏎········windowsHide:·true,⏎········shell:·false,⏎········timeout:·15000,⏎········maxBuffer:·16·*·1024·*·1024,⏎······},⏎······(error,·stdout)·=>·`","line":36,"column":3,"nodeType":null,"messageId":"replace","endLine":36,"endColumn":133,"fix":{"range":[1917,2047],"text":"    {\n        cwd: root,\n        env,\n        encoding: 'utf8',\n        windowsHide: true,\n        shell: false,\n        timeout: 15000,\n        maxBuffer: 16 * 1024 * 1024,\n      },\n      (error, stdout) => "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `······if(error){console.error(JSON.stringify({...verificationRejectionDiagnostic(error),stage:'source_git_read',git_operation:args[0]}));reject(error);}` with `········if·(error)·{⏎··········console.error(⏎············JSON.stringify({⏎··············...verificationRejectionDiagnostic(error),⏎··············stage:·'source_git_read',⏎··············git_operation:·args[0],⏎············})⏎··········);⏎··········reject(error);`","line":37,"column":1,"nodeType":null,"messageId":"replace","endLine":37,"endColumn":153,"fix":{"range":[2049,2201],"text":"        if (error) {\n          console.error(\n            JSON.stringify({\n              ...verificationRejectionDiagnostic(error),\n              stage: 'source_git_read',\n              git_operation: args[0],\n            })\n          );\n          reject(error);"}},{"ruleId":"@typescript-eslint/prefer-promise-reject-errors","severity":2,"message":"Expected the Promise rejection reason to be an Error.","line":37,"column":138,"nodeType":"CallExpression","messageId":"rejectAnError","endLine":37,"endColumn":151},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··}·`","line":38,"column":7,"nodeType":null,"messageId":"insert","endLine":38,"endColumn":7,"fix":{"range":[2208,2208],"text":"  } "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `}` with `··}⏎····`","line":39,"column":5,"nodeType":null,"messageId":"replace","endLine":39,"endColumn":6,"fix":{"range":[2234,2235],"text":"  }\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `projectRoot:·string,·inputPaths?:·readonly·string[]` with `⏎··projectRoot:·string,⏎··inputPaths?:·readonly·string[]⏎`","line":43,"column":49,"nodeType":null,"messageId":"replace","endLine":43,"endColumn":100,"fix":{"range":[2295,2346],"text":"\n  projectRoot: string,\n  inputPaths?: readonly string[]\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":47,"column":64,"nodeType":null,"messageId":"insert","endLine":47,"endColumn":64,"fix":{"range":[2587,2587],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":49,"column":41,"nodeType":null,"messageId":"insert","endLine":49,"endColumn":41,"fix":{"range":[2778,2778],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `!same(top,·root)·||·!same(path.resolve(root,·(await·gitRead(root,·['rev-parse',·'--git-common-dir'])).trim()),·path.join(root,·'.git'))` with `⏎····!same(top,·root)·||⏎····!same(⏎······path.resolve(root,·(await·gitRead(root,·['rev-parse',·'--git-common-dir'])).trim()),⏎······path.join(root,·'.git')⏎····)⏎··`","line":50,"column":7,"nodeType":null,"messageId":"replace","endLine":50,"endColumn":142,"fix":{"range":[2863,2998],"text":"\n    !same(top, root) ||\n    !same(\n      path.resolve(root, (await gitRead(root, ['rev-parse', '--git-common-dir'])).trim()),\n      path.join(root, '.git')\n    )\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":55,"column":47,"nodeType":null,"messageId":"insert","endLine":55,"endColumn":47,"fix":{"range":[3289,3289],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `await·readVerificationFile(path.join(root,·'.git',·'config'))` with `⏎····await·readVerificationFile(path.join(root,·'.git',·'config'))⏎··`","line":57,"column":39,"nodeType":null,"messageId":"replace","endLine":57,"endColumn":100,"fix":{"range":[3483,3544],"text":"\n    await readVerificationFile(path.join(root, '.git', 'config'))\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `.split('\\0')` with `⏎····.split('\\0')⏎····`","line":58,"column":97,"nodeType":null,"messageId":"replace","endLine":58,"endColumn":109,"fix":{"range":[3643,3655],"text":"\n    .split('\\0')\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(`${SPEC_DIR_NAME}/`·as·const)))` with ``${SPEC_DIR_NAME}/`·as·const))⏎·····`","line":60,"column":40,"nodeType":null,"messageId":"replace","endLine":60,"endColumn":72,"fix":{"range":[3756,3788],"text":"`${SPEC_DIR_NAME}/` as const))\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·trackedPaths:·string[]·=·[],` with `⏎····trackedPaths:·string[]·=·[],⏎···`","line":62,"column":45,"nodeType":null,"messageId":"replace","endLine":62,"endColumn":74,"fix":{"range":[3894,3923],"text":"\n    trackedPaths: string[] = [],\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `.split('\\0')` with `⏎····.split('\\0')⏎····`","line":66,"column":76,"nodeType":null,"messageId":"replace","endLine":66,"endColumn":88,"fix":{"range":[4205,4217],"text":"\n    .split('\\0')\n    "}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":69,"column":22,"nodeType":"TSNonNullExpression","messageId":"unnecessaryAssertion","endLine":69,"endColumn":31,"fix":{"range":[4411,4412],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":74,"column":91,"nodeType":null,"messageId":"insert","endLine":74,"endColumn":91,"fix":{"range":[4751,4751],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(`${SPEC_DIR_NAME}/`·as·const)` with ``${SPEC_DIR_NAME}/`·as·const`","line":75,"column":43,"nodeType":null,"messageId":"replace","endLine":75,"endColumn":73,"fix":{"range":[4851,4881],"text":"`${SPEC_DIR_NAME}/` as const"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·bytes·=·await·readVerificationFile(full),` with `⏎······bytes·=·await·readVerificationFile(full),⏎·····`","line":78,"column":44,"nodeType":null,"messageId":"replace","endLine":78,"endColumn":86,"fix":{"range":[5025,5067],"text":"\n      bytes = await readVerificationFile(full),\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":80,"column":58,"nodeType":null,"messageId":"insert","endLine":80,"endColumn":58,"fix":{"range":[5199,5199],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·path:·relative,·bytes:·bytes.length,·sha256:·verificationId(bytes),·device:·stat.dev.toString(),·inode:·stat.ino.toString()` with `⏎······path:·relative,⏎······bytes:·bytes.length,⏎······sha256:·verificationId(bytes),⏎······device:·stat.dev.toString(),⏎······inode:·stat.ino.toString(),⏎···`","line":81,"column":17,"nodeType":null,"messageId":"replace","endLine":81,"endColumn":141,"fix":{"range":[5262,5386],"text":"\n      path: relative,\n      bytes: bytes.length,\n      sha256: verificationId(bytes),\n      device: stat.dev.toString(),\n      inode: stat.ino.toString(),\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":84,"column":50,"nodeType":null,"messageId":"insert","endLine":84,"endColumn":50,"fix":{"range":[5498,5498],"text":"\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·projectRoot:·root,·head,·branch,·indexSha256:·indexBefore,·configSha256:·configBefore,·files,·trackedPaths` with `⏎····projectRoot:·root,⏎····head,⏎····branch,⏎····indexSha256:·indexBefore,⏎····configSha256:·configBefore,⏎····files,⏎····trackedPaths,⏎·`","line":86,"column":21,"nodeType":null,"messageId":"replace","endLine":86,"endColumn":128,"fix":{"range":[5602,5709],"text":"\n    projectRoot: root,\n    head,\n    branch,\n    indexSha256: indexBefore,\n    configSha256: configBefore,\n    files,\n    trackedPaths,\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `head·!==·(await·gitRead(root,·['rev-parse',·'--verify',·'HEAD'])).trim()·||` with `⏎····head·!==·(await·gitRead(root,·['rev-parse',·'--verify',·'HEAD'])).trim()·||⏎···`","line":87,"column":7,"nodeType":null,"messageId":"replace","endLine":87,"endColumn":82,"fix":{"range":[5719,5794],"text":"\n    head !== (await gitRead(root, ['rev-parse', '--verify', 'HEAD'])).trim() ||\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":88,"column":1,"nodeType":null,"messageId":"delete","endLine":88,"endColumn":3,"fix":{"range":[5886,5888],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `······configBefore·!==·verificationId(await·readVerificationFile(path.join(root,·'.git',·'config'))))` with `····configBefore·!==·verificationId(await·readVerificationFile(path.join(root,·'.git',·'config')))⏎··)⏎···`","line":89,"column":1,"nodeType":null,"messageId":"replace","endLine":89,"endColumn":102,"fix":{"range":[5988,6089],"text":"    configBefore !== verificationId(await readVerificationFile(path.join(root, '.git', 'config')))\n  )\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `snapshot:·VerificationSourceSnapshot` with `⏎··snapshot:·VerificationSourceSnapshot⏎`","line":93,"column":52,"nodeType":null,"messageId":"replace","endLine":93,"endColumn":88,"fix":{"range":[6294,6330],"text":"\n  snapshot: VerificationSourceSnapshot\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·bytes·=·await·readVerificationFile(full),` with `⏎······bytes·=·await·readVerificationFile(full),⏎·····`","line":96,"column":61,"nodeType":null,"messageId":"replace","endLine":96,"endColumn":103,"fix":{"range":[6507,6549],"text":"\n      bytes = await readVerificationFile(full),\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `bytes.length·!==·file.bytes·||·verificationId(bytes)·!==·file.sha256·||·stat.dev.toString()·!==·file.device·||·stat.ino.toString()·!==·file.inode` with `⏎······bytes.length·!==·file.bytes·||⏎······verificationId(bytes)·!==·file.sha256·||⏎······stat.dev.toString()·!==·file.device·||⏎······stat.ino.toString()·!==·file.inode⏎····`","line":97,"column":9,"nodeType":null,"messageId":"replace","endLine":97,"endColumn":154,"fix":{"range":[6605,6750],"text":"\n      bytes.length !== file.bytes ||\n      verificationId(bytes) !== file.sha256 ||\n      stat.dev.toString() !== file.device ||\n      stat.ino.toString() !== file.inode\n    "}}],"suppressedMessages":[],"errorCount":40,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":38,"fixableWarningCount":0,"source":"import { SPEC_DIR_NAME } from \"@specforge/types/directory-layout\";\n/** Read-only Git plumbing plus physical/raw-byte inventory. Never invokes shell, filters or hooks. */\nimport * as fs from 'node:fs/promises';\nimport path from 'node:path';\nimport { execFile } from 'node:child_process';\nimport { assertVerificationPath, canonicalVerificationJson, readVerificationFile, verificationId } from './owner-store';\nimport { verificationRejectionDiagnostic } from './rejection-diagnostic';\n\nexport interface VerificationInputFile { path: string; bytes: number; sha256: string; device: string; inode: string; }\nexport interface VerificationSourceSnapshot {\n  projectRoot: string;\n  head: string;\n  branch: string;\n  indexSha256: string;\n  configSha256: string;\n  files: VerificationInputFile[];\n  trackedPaths: string[];\n  identity: string;\n}\n\nexport function assertVerificationRelativePath(relative: string): void {\n  if (!relative || relative.includes('\\\\') || path.isAbsolute(relative) || relative.split('/').some(part =>\n      !part || part === '.' || part === '..' || /[<>:\"|?*\\x00-\\x1f]/.test(part) || /[. ]$/.test(part) ||\n      /^(con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$)/i.test(part))) throw new Error('VERIFICATION_INPUT_PATH_INVALID');\n}\n\nfunction gitRead(root: string, args: string[]): Promise<string> {\n  const env: NodeJS.ProcessEnv = {};\n  for (const name of ['PATH', 'SystemRoot', 'WINDIR', 'TEMP', 'TMP', 'PATHEXT', 'SYSTEMDRIVE']) {\n    if (process.env[name] !== undefined) env[name] = process.env[name];\n  }\n  Object.assign(env, { GIT_OPTIONAL_LOCKS: '0', GIT_CONFIG_NOSYSTEM: '1', GIT_CONFIG_GLOBAL: process.platform === 'win32' ? 'NUL' : '/dev/null' });\n  return new Promise((resolve,reject)=>{\n    execFile('git', ['--no-pager', '-c', 'core.fsmonitor=false', '-c', 'protocol.allow=never',\n    '-c', `core.hooksPath=${process.platform === 'win32' ? 'NUL' : '/dev/null'}`, '-c', 'gc.auto=0', ...args],\n  { cwd: root, env, encoding: 'utf8', windowsHide: true, shell:false, timeout: 15000, maxBuffer: 16 * 1024 * 1024 },(error,stdout)=>{\n      if(error){console.error(JSON.stringify({...verificationRejectionDiagnostic(error),stage:'source_git_read',git_operation:args[0]}));reject(error);}\n      else resolve(stdout);\n    });\n  });\n}\n\nexport async function captureVerificationSource(projectRoot: string, inputPaths?: readonly string[]): Promise<VerificationSourceSnapshot> {\n  const root = path.resolve(projectRoot);\n  await assertVerificationPath(root);\n  await assertVerificationPath(path.join(root, '.git'));\n  if (!(await fs.lstat(path.join(root, '.git'))).isDirectory()) throw new Error('VERIFICATION_EXTERNAL_GIT_UNSUPPORTED');\n  const top = path.resolve((await gitRead(root, ['rev-parse', '--show-toplevel'])).trim());\n  const same = (a: string, b: string) => process.platform === 'win32' ? a.toLowerCase() === b.toLowerCase() : a === b;\n  if (!same(top, root) || !same(path.resolve(root, (await gitRead(root, ['rev-parse', '--git-common-dir'])).trim()), path.join(root, '.git'))) {\n    throw new Error('VERIFICATION_EXTERNAL_GIT_UNSUPPORTED');\n  }\n  const head = (await gitRead(root, ['rev-parse', '--verify', 'HEAD'])).trim();\n  const branch = (await gitRead(root, ['symbolic-ref', '--quiet', '--short', 'HEAD'])).trim();\n  if (!/^[a-f0-9]{40}$/.test(head) || !branch) throw new Error('VERIFICATION_GIT_IDENTITY_REQUIRED');\n  const indexBefore = verificationId(await readVerificationFile(path.join(root, '.git', 'index')));\n  const configBefore = verificationId(await readVerificationFile(path.join(root, '.git', 'config')));\n  for (const name of (await gitRead(root, ['ls-files', '--others', '--exclude-standard', '-z'])).split('\\0').filter(Boolean)) {\n    assertVerificationRelativePath(name);\n    if (!name.toLowerCase().startsWith((`${SPEC_DIR_NAME}/` as const))) throw new Error('VERIFICATION_UNTRACKED_INPUT:' + name);\n  }\n  const files: VerificationInputFile[] = [], trackedPaths: string[] = [], identities = new Set<string>();\n  const selected = inputPaths === undefined ? null : new Set(inputPaths);\n  if (selected) for (const name of selected) assertVerificationRelativePath(name);\n  let total = 0;\n  for (const record of (await gitRead(root, ['ls-files', '--stage', '-z'])).split('\\0').filter(Boolean)) {\n    const match = /^(100644|100755) [a-f0-9]{40} 0\\t(.+)$/.exec(record);\n    if (!match) throw new Error('VERIFICATION_INDEX_KIND_UNSUPPORTED');\n    const relative = match[2]!;\n    assertVerificationRelativePath(relative);\n    const identity = process.platform === 'win32' ? relative.toLowerCase() : relative;\n    if (identities.has(identity)) throw new Error('VERIFICATION_INPUT_PATH_ALIAS');\n    identities.add(identity);\n    if (relative.split('/').some(p => ['.git', 'node_modules'].includes(p.toLowerCase()))) throw new Error('VERIFICATION_DEPENDENCY_OR_GIT_INPUT');\n    if (relative.toLowerCase().startsWith((`${SPEC_DIR_NAME}/` as const))) continue;\n    trackedPaths.push(relative);\n    if (selected && !selected.has(relative)) continue;\n    const full = path.join(root, relative), bytes = await readVerificationFile(full), stat = await fs.lstat(full, { bigint: true });\n    total += bytes.length;\n    if (total > 16 * 1024 * 1024 || files.length >= 2048) throw new Error('VERIFICATION_INPUT_BUDGET');\n    files.push({ path: relative, bytes: bytes.length, sha256: verificationId(bytes), device: stat.dev.toString(), inode: stat.ino.toString() });\n  }\n  files.sort((a, b) => a.path.localeCompare(b.path));\n  if (selected && files.length !== selected.size) throw new Error('VERIFICATION_SELECTED_INPUT_NOT_TRACKED');\n  trackedPaths.sort();\n  const snapshot = { projectRoot: root, head, branch, indexSha256: indexBefore, configSha256: configBefore, files, trackedPaths };\n  if (head !== (await gitRead(root, ['rev-parse', '--verify', 'HEAD'])).trim() || branch !== (await gitRead(root, ['symbolic-ref', '--quiet', '--short', 'HEAD'])).trim() ||\n      indexBefore !== verificationId(await readVerificationFile(path.join(root, '.git', 'index'))) ||\n      configBefore !== verificationId(await readVerificationFile(path.join(root, '.git', 'config')))) throw new Error('VERIFICATION_GIT_CHANGED_DURING_SNAPSHOT');\n  return { ...snapshot, identity: verificationId(canonicalVerificationJson(snapshot)) };\n}\n\nexport async function readFrozenVerificationInputs(snapshot: VerificationSourceSnapshot): Promise<Map<string, Buffer>> {\n  const inputs = new Map<string, Buffer>();\n  for (const file of snapshot.files) {\n    const full = path.join(snapshot.projectRoot, file.path), bytes = await readVerificationFile(full), stat = await fs.lstat(full, { bigint: true });\n    if (bytes.length !== file.bytes || verificationId(bytes) !== file.sha256 || stat.dev.toString() !== file.device || stat.ino.toString() !== file.inode) {\n      throw new Error('VERIFICATION_SOURCE_CHANGED:' + file.path);\n    }\n    inputs.set(file.path, bytes);\n  }\n  return inputs;\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\verification\\static-task-command.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"@specforge/types/directory-layout\"` with `'@specforge/types/directory-layout'`","line":1,"column":31,"nodeType":null,"messageId":"replace","endLine":1,"endColumn":66,"fix":{"range":[30,65],"text":"'@specforge/types/directory-layout'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·{kind:'files';paths:string[]}·|·{kind:'grep';paths:[string];pattern:string;quiet:boolean;negate:boolean;extended:boolean` with `⏎··|·{·kind:·'files';·paths:·string[]·}⏎··|·{⏎······kind:·'grep';⏎······paths:·[string];⏎······pattern:·string;⏎······quiet:·boolean;⏎······negate:·boolean;⏎······extended:·boolean;⏎····`","line":10,"column":19,"nodeType":null,"messageId":"replace","endLine":10,"endColumn":140,"fix":{"range":[533,654],"text":"\n  | { kind: 'files'; paths: string[] }\n  | {\n      kind: 'grep';\n      paths: [string];\n      pattern: string;\n      quiet: boolean;\n      negate: boolean;\n      extended: boolean;\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `string):never·{throw·Error('NODE_COMMAND_UNSUPPORTED:STATIC_'+code);` with `·string):·never·{⏎··throw·Error('NODE_COMMAND_UNSUPPORTED:STATIC_'·+·code);⏎`","line":11,"column":20,"nodeType":null,"messageId":"replace","endLine":11,"endColumn":88,"fix":{"range":[676,744],"text":" string): never {\n  throw Error('NODE_COMMAND_UNSUPPORTED:STATIC_' + code);\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=(text:string)=>` with `·=·(text:·string)·=>·`","line":12,"column":10,"nodeType":null,"messageId":"replace","endLine":12,"endColumn":26,"fix":{"range":[755,771],"text":" = (text: string) => "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=['--no-addons','--preserve-symlinks',` with `·=·['--no-addons',·'--preserve-symlinks',·`","line":13,"column":12,"nodeType":null,"messageId":"replace","endLine":13,"endColumn":50,"fix":{"range":[831,869],"text":" = ['--no-addons', '--preserve-symlinks', "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=(value:string)=>` with `·=·(value:·string)·=>·`","line":14,"column":37,"nodeType":null,"messageId":"replace","endLine":14,"endColumn":54,"fix":{"range":[934,951],"text":" = (value: string) => "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `string):` with `·string):·`","line":15,"column":25,"nodeType":null,"messageId":"replace","endLine":15,"endColumn":33,"fix":{"range":[1009,1017],"text":" string): "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(!/^[A-Za-z0-9_.\\-/]+$/.test(value)||value.split('/').some(p=>['.git',SPEC_DIR_NAME,'node_modules'].includes(p.toLowerCase()))||!/(?:\\.md|\\.json|\\.[cm]?js|\\.ts)$/.test(value))` with `·(⏎····!/^[A-Za-z0-9_.\