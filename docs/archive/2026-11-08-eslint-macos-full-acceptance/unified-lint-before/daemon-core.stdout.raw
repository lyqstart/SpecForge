ementation'·?·['implementation_running',·'implementation_done',·'verification_running']·:` with `···:·input.consumePurpose·===·'implementation'⏎········?·['implementation_running',·'implementation_done',·'verification_running']`","line":37,"column":4,"nodeType":null,"messageId":"replace","endLine":37,"endColumn":124,"fix":{"range":[2425,2545],"text":"   : input.consumePurpose === 'implementation'\n        ? ['implementation_running', 'implementation_done', 'verification_running']"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `···` with `········:`","line":38,"column":1,"nodeType":null,"messageId":"replace","endLine":38,"endColumn":4,"fix":{"range":[2546,2549],"text":"        :"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":47,"column":65,"nodeType":null,"messageId":"insert","endLine":47,"endColumn":65,"fix":{"range":[3083,3083],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":50,"column":70,"nodeType":null,"messageId":"insert","endLine":50,"endColumn":70,"fix":{"range":[3287,3287],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `await·readVerificationFile(path.join(wiRoot,·'work_item.json'))` with `⏎····await·readVerificationFile(path.join(wiRoot,·'work_item.json'))⏎··`","line":54,"column":44,"nodeType":null,"messageId":"replace","endLine":54,"endColumn":107,"fix":{"range":[3444,3507],"text":"\n    await readVerificationFile(path.join(wiRoot, 'work_item.json'))\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·updated_at:·_updated,·code_permission_revoked_at:·_revokedAt,·...metadataBasis` with `⏎····updated_at:·_updated,⏎····code_permission_revoked_at:·_revokedAt,⏎····...metadataBasis⏎·`","line":56,"column":10,"nodeType":null,"messageId":"replace","endLine":56,"endColumn":89,"fix":{"range":[3620,3699],"text":"\n    updated_at: _updated,\n    code_permission_revoked_at: _revokedAt,\n    ...metadataBasis\n "}},{"rul