`⏎····this.root·=·path.resolve(root);⏎·`","line":63,"column":82,"nodeType":null,"messageId":"replace","endLine":63,"endColumn":114,"fix":{"range":[3707,3739],"text":"\n    this.root = path.resolve(root);\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":66,"column":56,"nodeType":null,"messageId":"insert","endLine":66,"endColumn":56,"fix":{"range":[3871,3871],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·await·fs.writeFile(keyPath,·randomBytes(32),·{·flag:·'wx',·mode:·0o600·});·}` with `⏎········await·fs.writeFile(keyPath,·randomBytes(32),·{·flag:·'wx',·mode:·0o600·});`","line":76,"column":12,"nodeType":null,"messageId":"replace","endLine":76,"endColumn":89,"fix":{"range":[4275,4352],"text":"\n        await fs.writeFile(keyPath, randomBytes(32), { flag: 'wx', mode: 0o600 });"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `catch·(error)·{·if·((error·as·NodeJS.ErrnoException).code·!==·'EEXIST')·throw·error;` with `}·catch·(error)·{⏎········if·((error·as·NodeJS.ErrnoException).code·!==·'EEXIST')·throw·error;⏎·····`","line":77,"column":7,"nodeType":null,"messageId":"replace","endLine":77,"endColumn":91,"fix":{"range":[4359,4443],"text":"} catch (error) {\n        if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error;\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":86,"column":74,"nodeType":null,"messageId":"insert","endLine":86,"endColumn":74,"fix":{"range":[4863,4863],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·contentId·=·digest(body),` with `⏎······contentId·=·digest(body),⏎·····`","line":87,"column":53,"nodeType":null,"messageId":"replace","endLine":87,"endColumn":79,"fix":{"range":[4969,4995],"text":"\n      contentId = digest(body),\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(Buffer.byteLength(body,'utf8')>16*1024*1024-65536)` with `·(Buffer.byteLength(body,·'utf8')·>·16·*·1024·*·1024·-·65536)⏎······`","line":88,"column":7,"nodeType":null,"messageId":"replace","endLine":88,"endColumn":58,"fix":{"range":[5029,5080],"text":" (Buffer.byteLength(body, 'utf8') > 16 * 1024 * 1024 - 65536)\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":89,"column":46,"nodeType":null,"messageId":"insert","endLine":89,"endColumn":46,"fix":{"range":[5172,5172],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·flag:·'wx',·mode:·0o600` with `⏎······flag:·'wx',⏎······mode:·0o600,⏎···`","line":95,"column":87,"nodeType":null,"messageId":"replace","endLine":95,"endColumn":111,"fix":{"range":[5645,5669],"text":"\n      flag: 'wx',\n      mode: 0o600,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":100,"column":46,"nodeType":null,"messageId":"insert","endLine":100,"endColumn":46,"fix":{"range":[5820,5820],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":101,"column":54,"nodeType":null,"messageId":"insert","endLine":101,"endColumn":54,"fix":{"range":[5903,5903],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":102,"column":72,"nodeType":null,"messageId":"insert","endLine":102,"endColumn":72,"fix":{"range":[6029,6029],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎······`","line":104,"column":9,"nodeType":null,"messageId":"insert","endLine":104,"endColumn":9,"fix":{"range":[6139,6139],"text":"\n      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `··env['contract']·!==·VERIFICATION_OWNER_CONTRACT·||·env['kind']·!==·kind·||` with `env['contract']·!==·VERIFICATION_OWNER_CONTRACT·||⏎······env['kind']·!==·kind·||⏎·····`","line":105,"column":7,"nodeType":null,"messageId":"replace","endLine":105,"endColumn":83,"fix":{"range":[6227,6303],"text":"env['contract'] !== VERIFICATION_OWNER_CONTRACT ||\n      env['kind'] !== kind ||\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":106,"column":1,"nodeType":null,"messageId":"delete","endLine":106,"endColumn":3,"fix":{"range":[6324,6326],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `··!['invocation',·'revocation',·'start'].includes(kind)·&&·env['contentId']·!==·id` with `(!['invocation',·'revocation',·'start'].includes(kind)·&&·env['contentId']·!==·id)`","line":107,"column":7,"nodeType":null,"messageId":"replace","endLine":107,"endColumn":89,"fix":{"range":[6412,6494],"text":"(!['invocation', 'revocation', 'start'].includes(kind) && env['contentId'] !== id)"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `··typeof·env['mac']·!==·'string'·||·!/^[a-f0-9]{64}$/.test(env['mac']))` with `typeof·env['mac']·!==·'string'·||⏎······!/^[a-f0-9]{64}$/.test(env['mac'])⏎····)⏎·····`","line":108,"column":7,"nodeType":null,"messageId":"replace","endLine":108,"endColumn":78,"fix":{"range":[6504,6575],"text":"typeof env['mac'] !== 'string' ||\n      !/^[a-f0-9]{64}$/.test(env['mac'])\n    )\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·contract:·env['contract'],·kind,·id,·contentId:·env['contentId'],·payload:·env['payload']` with `⏎······contract:·env['contract'],⏎······kind,⏎······id,⏎······contentId:·env['contentId'],⏎······payload:·env['payload'],⏎···`","line":109,"column":21,"nodeType":null,"messageId":"replace","endLine":109,"endColumn":111,"fix":{"range":[6646,6736],"text":"\n      contract: env['contract'],\n      kind,\n      id,\n      contentId: env['contentId'],\n      payload: env['payload'],\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":111,"column":68,"nodeType":null,"messageId":"insert","endLine":111,"endColumn":68,"fix":{"range":[6906,6906],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·await·this.get(kind,·id);·return·true;·}` with `⏎······await·this.get(kind,·id);⏎······return·true;`","line":116,"column":10,"nodeType":null,"messageId":"replace","endLine":116,"endColumn":51,"fix":{"range":[7084,7125],"text":"\n      await this.get(kind, id);\n      return true;"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `catch·(error)·{·if·((error·as·NodeJS.ErrnoException).code·===·'ENOENT')·return·false;·throw·error;` with `}·catch·(error)·{⏎······if·((error·as·NodeJS.ErrnoException).code·===·'ENOENT')·return·false;⏎······throw·error;⏎···`","line":117,"column":5,"nodeType":null,"messageId":"replace","endLine":117,"endColumn":103,"fix":{"range":[7130,7228],"text":"} catch (error) {\n      if ((error as NodeJS.ErrnoException).code === 'ENOENT') return false;\n      throw error;\n   "}}],"suppressedMessages":[],"errorCount":37,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":37,"fixableWarningCount":0,"source":"/** Runtime-private, immutable, authenticated verification objects. Never an artifact-write target. */\nimport * as fs from 'node:fs/promises';\nimport path from 'node:path';\nimport { createHash, createHmac, randomBytes, timingSafeEqual } from 'node:crypto';\nimport { resolveSpecForgeUserPath } from '@specforge/types/user-level-paths';\n\nexport type VerificationObjectKind = 'plan' | 'receipt' | 'revocation' | 'invocation' | 'attempt' | 'start' | 'recovery' | 'lease';\nexport const VERIFICATION_OWNER_CONTRACT = 'verification-owner/v1' as const;\nconst kinds = new Set<VerificationObjectKind>(['plan', 'receipt', 'revocation', 'invocation', 'attempt', 'start', 'recovery', 'lease']);\nconst digest = (raw: string | Buffer): string => createHash('sha256').update(raw).digest('hex');\nexport const verificationId = digest;\n\nexport function canonicalVerificationJson(value: unknown): string {\n  if (value === null || typeof value === 'string' || typeof value === 'boolean') return JSON.stringify(value);\n  if (typeof value === 'number' && Number.isFinite(value)) return JSON.stringify(value);\n  if (Array.isArray(value)) return '[' + value.map(canonicalVerificationJson).join(',') + ']';\n  if (typeof value === 'object' && value !== null && Object.getPrototypeOf(value) === Object.prototype) {\n    const obj = value as Record<string, unknown>;\n    return '{' + Object.keys(obj).sort().map(k => JSON.stringify(k) + ':' + canonicalVerificationJson(obj[k])).join(',') + '}';\n  }\n  throw new Error('VERIFICATION_NON_JSON_OBJECT');\n}\n\n/** Check ancestors before opening the final file; never follow an unexamined link. */\nexport async function assertVerificationPath(file: string, allowMissing = false): Promise<void> {\n  const absolute = path.resolve(file), ancestors: string[] = [];\n  for (let current = absolute;; current = path.dirname(current)) {\n    ancestors.unshift(current);\n    if (path.dirname(current) === current) break;\n  }\n  let missing = false;\n  for (const ancestor of ancestors) {\n    if (missing) continue;\n    try {\n      const stat = await fs.lstat(ancestor);\n      if (stat.isSymbolicLink()) throw new Error('VERIFICATION_LINK_FORBIDDEN');\n      if (!stat.isDirectory() && !stat.isFile()) throw new Error('VERIFICATION_SPECIAL_FILE_FORBIDDEN');\n      if (ancestor !== absolute && !stat.isDirectory()) throw new Error('VERIFICATION_ANCESTOR_NOT_DIRECTORY');\n      if (stat.isFile() && stat.nlink !== 1) throw new Error('VERIFICATION_HARDLINK_FORBIDDEN');\n    } catch (error) {\n      if (allowMissing && (error as NodeJS.ErrnoException).code === 'ENOENT') missing = true;\n      else throw error;\n    }\n  }\n}\n\nexport async function readVerificationFile(file: string, limit = 16 * 1024 * 1024): Promise<Buffer> {\n  await assertVerificationPath(file);\n  const handle = await fs.open(file, 'r');\n  try {\n    const before = await handle.stat({ bigint: true });\n    if (!before.isFile() || before.nlink !== 1n || before.size > BigInt(limit)) throw new Error('VERIFICATION_FILE_INVALID');\n    const bytes = await handle.readFile(), after = await handle.stat({ bigint: true }), current = await fs.lstat(file, { bigint: true });\n    if (BigInt(bytes.length) !== before.size || before.dev !== after.dev || before.ino !== after.ino ||\n        before.size !== after.size || before.mtimeNs !== after.mtimeNs || before.ctimeNs !== after.ctimeNs || after.ino !== current.ino ||\n        after.dev !== current.dev || current.nlink !== 1n || current.isSymbolicLink()) throw new Error('VERIFICATION_FILE_CHANGED');\n    return bytes;\n  } finally { await handle.close(); }\n}\n\nexport class VerificationOwnerStore {\n  readonly root: string;\n  constructor(root = resolveSpecForgeUserPath('runtime', 'verification-owner')) { this.root = path.resolve(root); }\n\n  private objectPath(kind: VerificationObjectKind, id: string): string {\n    if (!kinds.has(kind) || !/^[a-f0-9]{64}$/.test(id)) throw new Error('VERIFICATION_OBJECT_ID_INVALID');\n    return path.join(this.root, kind, id + '.json');\n  }\n\n  private async key(create: boolean): Promise<Buffer> {\n    await assertVerificationPath(this.root, create);\n    const keyPath = path.join(this.root, 'owner.key');\n    if (create) {\n      await fs.mkdir(this.root, { recursive: true });\n      await assertVerificationPath(this.root);\n      try { await fs.writeFile(keyPath, randomBytes(32), { flag: 'wx', mode: 0o600 }); }\n      catch (error) { if ((error as NodeJS.ErrnoException).code !== 'EEXIST') throw error; }\n    }\n    const bytes = await readVerificationFile(keyPath, 32);\n    if (bytes.length !== 32) throw new Error('VERIFICATION_OWNER_KEY_INVALID');\n    return bytes;\n  }\n\n  async put(kind: VerificationObjectKind, payload: unknown, fixedId?: string): Promise<string> {\n    if (!kinds.has(kind)) throw new Error('VERIFICATION_OBJECT_KIND_INVALID');\n    if (fixedId && !['invocation', 'revocation', 'start'].includes(kind)) throw new Error('VERIFICATION_CONTENT_ID_REQUIRED');\n    const body = canonicalVerificationJson(payload), contentId = digest(body), id = fixedId ?? contentId;\n    if(Buffer.byteLength(body,'utf8')>16*1024*1024-65536)throw new Error('VERIFICATION_OBJECT_BUDGET');\n    const target = this.objectPath(kind, id), key = await this.key(true);\n    await assertVerificationPath(target, true);\n    await fs.mkdir(path.dirname(target), { recursive: true });\n    await assertVerificationPath(path.dirname(target));\n    const signed = { contract: VERIFICATION_OWNER_CONTRACT, kind, id, contentId, payload };\n    const mac = createHmac('sha256', key).update(canonicalVerificationJson(signed)).digest('hex');\n    await fs.writeFile(target, canonicalVerificationJson({ ...signed, mac }) + '\\n', { flag: 'wx', mode: 0o600 });\n    return id;\n  }\n\n  async get<T = unknown>(kind: VerificationObjectKind, id: string): Promise<T> {\n    const target = this.objectPath(kind, id), key = await this.key(false);\n    const bytes = await readVerificationFile(target), parsed: unknown = JSON.parse(bytes.toString('utf8'));\n    if (!parsed || typeof parsed !== 'object' || Array.isArray(parsed)) throw new Error('VERIFICATION_ENVELOPE_INVALID');\n    const env = parsed as Record<string, unknown>;\n    if (Object.keys(env).sort().join(',') !== 'contentId,contract,id,kind,mac,payload' ||\n        env['contract'] !== VERIFICATION_OWNER_CONTRACT || env['kind'] !== kind || env['id'] !== id ||\n        env['contentId'] !== digest(canonicalVerificationJson(env['payload'])) ||\n        !['invocation', 'revocation', 'start'].includes(kind) && env['contentId'] !== id ||\n        typeof env['mac'] !== 'string' || !/^[a-f0-9]{64}$/.test(env['mac'])) throw new Error('VERIFICATION_ENVELOPE_INVALID');\n    const signed = { contract: env['contract'], kind, id, contentId: env['contentId'], payload: env['payload'] };\n    const expected = createHmac('sha256', key).update(canonicalVerificationJson(signed)).digest();\n    if (!timingSafeEqual(expected, Buffer.from(env['mac'], 'hex'))) throw new Error('VERIFICATION_OWNER_SIGNATURE_INVALID');\n    return env['payload'] as T;\n  }\n\n  async has(kind: VerificationObjectKind, id: string): Promise<boolean> {\n    try { await this.get(kind, id); return true; }\n    catch (error) { if ((error as NodeJS.ErrnoException).code === 'ENOENT') return false; throw error; }\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\verification\\rejection-diagnostic.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `createHash` with `·createHash·`","line":2,"column":9,"nodeType":null,"messageId":"replace","endLine":2,"endColumn":19,"fix":{"range":[107,117],"text":" createHash "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `unknown):Record<string,unknown>` with `·unknown):·Record<string,·unknown>·`","line":3,"column":55,"nodeType":null,"messageId":"replace","endLine":3,"endColumn":86,"fix":{"range":[193,224],"text":" unknown): Record<string, unknown> "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=error·instanceof·Error?error:null,extended=value·as·(Error&{code?:unknown;syscall?:unknown;statusCode?:unknown})|` with `·=·error·instanceof·Error·?·error·:·null,⏎····extended·=·value·as⏎······|·(Error·&·{·code?:·unknown;·syscall?:·unknown;·statusCode?:·unknown·})⏎······|·`","line":4,"column":14,"nodeType":null,"messageId":"replace","endLine":4,"endColumn":128,"fix":{"range":[239,353],"text":" = error instanceof Error ? error : null,\n    extended = value as\n      | (Error & { code?: unknown; syscall?: unknown; statusCode?: unknown })\n      | "}},{"ruleId":"@typescript-eslint/no-unnecessary-type-assertion","severity":2,"message":"This assertion is unnecessary since it does not change the type of the expression.","line":4,"column":58,"nodeType":"TSAsExpression","messageId":"unnecessaryAssertion","endLine":4,"endColumn":132,"fix":{"range":[288,357],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=(input:unknown,pattern:RegExp)=>typeof·input==='string'&&p