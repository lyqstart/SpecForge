":{"range":[3408,3447],"text":" string, pattern: string, unicode: boolean): "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(text==='')return·0;const·lines=text.split('\\n');if(lines[lines.length-1]==='')` with `·(text·===·'')·return·0;⏎··const·lines·=·text.split('\\n');⏎··if·(lines[lines.length·-·1]·===·'')·`","line":53,"column":5,"nodeType":null,"messageId":"replace","endLine":53,"endColumn":84,"fix":{"range":[3460,3539],"text":" (text === '') return 0;\n  const lines = text.split('\\n');\n  if (lines[lines.length - 1] === '') "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=new·RegExp(pattern,unicode?'u':'');return·lines.reduce((count,line)=>count+(regex.test(line)?1:0),` with `·=·new·RegExp(pattern,·unicode·?·'u'·:·'');⏎··return·lines.reduce((count,·line)·=>·count·+·(regex.test(line)·?·1·:·0),·`","line":54,"column":14,"nodeType":null,"messageId":"replace","endLine":54,"endColumn":113,"fix":{"range":[3565,3664],"text":" = new RegExp(pattern, unicode ? 'u' : '');\n  return lines.reduce((count, line) => count + (regex.test(line) ? 1 : 0), "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `root:string,command:string,trackedPaths:readonly·string[]):Promise<{sources:FrozenNodeSource[];inputPaths:string[]` with `⏎··root:·string,⏎··command:·string,⏎··trackedPaths:·readonly·string[]⏎):·Promise<{·sources:·FrozenNodeSource[];·inputPaths:·string[]·`","line":56,"column":47,"nodeType":null,"messageId":"replace","endLine":56,"endColumn":161,"fix":{"range":[3716,3830],"text":"\n  root: string,\n  command: string,\n  trackedPaths: readonly string[]\n): Promise<{ sources: FrozenNodeSource[]; inputPaths: string[] "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `=parseStaticTaskDeclaration(command),inputPaths=[...new·Set(declaration.paths)].sort(),tracked=new·Set(trackedPaths),sources:FrozenNodeSource[]=` with `·=·parseStaticTaskDeclaration(command),⏎····inputPaths·=·[...new·Set(declaration.paths)].sort(),⏎····