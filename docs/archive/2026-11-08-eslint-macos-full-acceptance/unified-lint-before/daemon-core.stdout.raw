:25,"nodeType":null,"messageId":"replace","endLine":189,"endColumn":83,"fix":{"range":[6143,6201],"text":"'初始化: project-rules.md', status: 'ok', detail: '项目规则存在' });"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"初始化:·project-rules.md\",·status:·\"warning\",·detail:·\"项目规则缺失\"·})` with `'初始化:·project-rules.md',·status:·'warning',·detail:·'项目规则缺失'·});`","line":191,"column":25,"nodeType":null,"messageId":"replace","endLine":191,"endColumn":88,"fix":{"range":[6237,6300],"text":"'初始化: project-rules.md', status: 'warning', detail: '项目规则缺失' });"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":194,"column":16,"nodeType":null,"messageId":"insert","endLine":194,"endColumn":16,"fix":{"range":[6321,6321],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"healthy\"·|·\"warning\"·|·\"error\"` with `'healthy'·|·'warning'·|·'error'`","line":200,"column":52,"nodeType":null,"messageId":"replace","endLine":200,"endColumn":83,"fix":{"range":[6400,6431],"text":"'healthy' | 'warning' | 'error'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `((c)·=>·c.status·===·\"error\"))·return·\"error\"` with `(c·=>·c.status·===·'error'))·return·'error';`","line":201,"column":18,"nodeType":null,"messageId":"replace","endLine":201,"endColumn":63,"fix":{"range":[6451,6496],"text":"(c => c.status === 'error')) return 'error';"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(c)·=>·c.status·===·\"warning\"))·return·\"warning\"` with `c·=>·c.status·===·'warning'))·return·'warning';`","line":202,"column":19,"nodeType":null,"messageId":"replace","endLine":202,"endColumn":67,"fix":{"range":[6515,6563],"text":"c => c.status === 'warning')) return 'warning';"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"healthy\"` with `'healthy';`","line":203,"column":10,"nodeType":null,"messageId":"replace","endLine":203,"endColumn":19,"fix":{"range":[6573,6582],"text":"'healthy';"}}],"suppressedMessages":[],"errorCount":72,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":72,"fixableWarningCount":0,"source":"/**\n * sf_doctor 核心逻辑 — 用户级安装检查\n *\n * 检查当前发布安装与项目布局的健康状态，包括：\n * 1. 用户级目录关键文件存在性\n * 2. 项目运行时关键文件存在性\n * 3. 当前项目初始化完整性\n */\n\nimport { existsSync, readFileSync, statSync } from \"node:fs\"\nimport { join } from \"node:path\"\nimport { LAYOUT, SPEC_DIR_NAME } from \"@specforge/types/directory-layout\"\nimport { resolveOpenCodeConfigRoot, resolveSpecForgeUserRoot } from \"@specforge/types/user-level-paths\"\nimport { logErrorToFile } from \"./utils\"\n\nfunction resolveUserLevelDirectory(): string {\n  return resolveOpenCodeConfigRoot()\n}\n\n// ============================================================\n// Types\n// ============================================================\n\nexport interface DoctorCheckItem {\n  name: string\n  status: \"ok\" | \"warning\" | \"error\"\n  detail: string\n}\n\nexport interface UserLevelDoctorReport {\n  checks: DoctorCheckItem[]\n  overall: \"healthy\" | \"warning\" | \"error\"\n}\n\n// ============================================================\n// Key file lists\n// ============================================================\n\n/** User-level directory key files to verify */\nconst USER_LEVEL_KEY_FILES = [\n  process.platform === \"win32\" ? \"sf-user/bin/specforge.exe\" : \"sf-user/bin/specforge\",\n  process.platform === \"win32\" ? \"sf-user/bin/specforged.exe\" : \"sf-user/bin/specforged\",\n  \"specforge-manifest.json\",\n  \"agents/sf-orchestrator.md\",\n  \"plugins/sf_specforge.ts\",\n  \"sf-user/lib/sf_thin_plugin.ts\",\n]\n\n/** Project runtime key files to verify */\nconst PROJECT_RUNTIME_KEY_FILES = [\n  join(SPEC_DIR_NAME, \"project\", \"spec_manifest.json\"),\n  join(SPEC_DIR_NAME, LAYOUT.runtimeFiles.state),\n]\n\n// ============================================================\n// Core Logic\n// ============================================================\n\n/**\n * 检查用户级安装的健康状态\n *\n * @param baseDir - 项目根目录\n * @returns 检查报告\n */\nexport async function checkUserLevelInstallation(\n  baseDir: string,\n  installRoot?: string,\n): Promise<UserLevelDoctorReport> {\n  try {\n    const checks: DoctorCheckItem[] = []\n\n    // --- 1. 用户级目录关键文件检查 ---\n    let userLevelDir: string\n    try {\n      userLevelDir = installRoot ?? resolveUserLevelDirectory()\n    } catch {\n      checks.push({\n        name: \"用户级目录解析\",\n        status: \"error\",\n        detail: \"无法解析用户级目录路径\",\n      })\n      return { checks, overall: \"error\" }\n    }\n\n    for (const relPath of USER_LEVEL_KEY_FILES) {\n      const fullPath = join(userLevelDir, relPath)\n      if (existsSync(fullPath)) {\n        checks.push({\n          name: `用户级文件: ${relPath}`,\n          status: \"ok\",\n          detail: fullPath,\n        })\n      } else {\n        checks.push({\n          name: `用户级文件: ${relPath}`,\n          status: \"error\",\n          detail: `缺失: ${fullPath}`,\n        })\n      }\n    }\n\n    // --- 2. 项目运行时关键文件检查 ---\n    for (const relPath of PROJECT_RUNTIME_KEY_FILES) {\n      const fullPath = join(baseDir, relPath)\n      if (existsSync(fullPath)) {\n        checks.push({\n          name: `项目运行时: ${relPath}`,\n          status: \"ok\",\n          detail: fullPath,\n        })\n      } else {\n        checks.push({\n          name: `项目运行时: ${relPath}`,\n          status: \"error\",\n          detail: `缺失: ${fullPath}`,\n        })\n      }\n    }\n\n    // --- 3. 初始化完整性检查 ---\n    const privateUserRoot = installRoot ? join(installRoot, \"sf-user\") : resolveSpecForgeUserRoot()\n    const initChecks = checkInitializationCompleteness(baseDir, privateUserRoot)\n    checks.push(...initChecks)\n\n    return { checks, overall: deriveOverall(checks) }\n  } catch (err) {\n    await logErrorToFile(baseDir, \"sf_doctor_core\", \"checkUserLevelInstallation\", err)\n    throw err\n  }\n}\n\n/**\n * 检查项目初始化完整性\n *\n * 检查：\n * 1. project/spec_manifest.json — 当前 Project Spec 权威\n * 2. host-profile.json — 主机环境配置（<OpenCode config>/sf-user/host-profile.json）\n * 3. prod-environment.md — 生产环境配置\n * 4. project-rules.md — 项目规则\n */\nfunction checkInitializationCompleteness(\n  baseDir: string,\n  userLevelDir: string,\n): Array<{ name: string; status: \"ok\" | \"warning\" | \"error\"; detail: string }> {\n  const specDir = join(baseDir, SPEC_DIR_NAME)\n  const checks: Array<{ name: string; status: \"ok\" | \"warning\" | \"error\"; detail: string }> = []\n\n  // Current Project Spec manifest.\n  const manifestPath = join(specDir, \"project\", \"spec_manifest.json\")\n  if (existsSync(manifestPath)) {\n    checks.push({ name: \"初始化: spec_manifest.json\", status: \"ok\", detail: \"当前 Project Spec 权威存在\" })\n  } else {\n    checks.push({ name: \"初始化: spec_manifest.json\", status: \"error\", detail: \"项目未初始化（project/spec_manifest.json 不存在）\" })\n  }\n\n  // host-profile.json（用户级：<OpenCode config>/sf-user/host-profile.json）\n  const hostProfilePath = join(userLevelDir, 'host-profile.json')\n  if (existsSync(hostProfilePath)) {\n    // 检查新鲜度（30 天）。优先使用档案自身的 scanned_at，\n    // 与 @specforge/host-profile 的缓存判定保持一致；旧档案缺少该字段时回退到文件时间。\n    try {\n      const profile = JSON.parse(readFileSync(hostProfilePath, \"utf-8\")) as { scanned_at?: unknown }\n      const scannedAt = typeof profile.scanned_at === \"string\" ? Date.parse(profile.scanned_at) : Number.NaN\n      const generatedAt = Number.isFinite(scannedAt) ? scannedAt : statSync(hostProfilePath).mtimeMs\n      const ageDays = (Date.now() - generatedAt) / (1000 * 60 * 60 * 24)\n      if (ageDays > 30) {\n        checks.push({ name: \"初始化: host-profile.json\", status: \"warning\", detail: `主机环境配置已过期（${Math.floor(ageDays)} 天前生成）` })\n      } else {\n        checks.push({ name: \"初始化: host-profile.json\", status: \"ok\", detail: \"主机环境配置存在且新鲜\" })\n      }\n    } catch {\n      checks.push({ name: \"初始化: host-profile.json\", status: \"warning\", detail: \"主机环境配置读取失败\" })\n    }\n  } else {\n    checks.push({ name: \"初始化: host-profile.json\", status: \"warning\", detail: \"主机环境配置缺失（将在下次初始化时自动生成）\" })\n  }\n\n  // prod-environment.md\n  const prodEnvPath = join(specDir, LAYOUT.configFiles.prodEnv)\n  if (existsSync(prodEnvPath)) {\n    checks.push({ name: \"初始化: prod-environment.md\", status: \"ok\", detail: \"生产环境配置存在\" })\n  } else {\n    checks.push({ name: \"初始化: prod-environment.md\", status: \"warning\", detail: \"生产环境配置缺失\" })\n  }\n\n  // project-rules.md\n  const rulesPath = join(specDir, LAYOUT.configFiles.projectRules)\n  if (existsSync(rulesPath)) {\n    checks.push({ name: \"初始化: project-rules.md\", status: \"ok\", detail: \"项目规则存在\" })\n  } else {\n    checks.push({ name: \"初始化: project-rules.md\", status: \"warning\", detail: \"项目规则缺失\" })\n  }\n\n  return checks\n}\n\n/**\n * 从检查项列表推导总体状态\n */\nfunction deriveOverall(checks: DoctorCheckItem[]): \"healthy\" | \"warning\" | \"error\" {\n  if (checks.some((c) => c.status === \"error\")) return \"error\"\n  if (checks.some((c) => c.status === \"warning\")) return \"warning\"\n  return \"healthy\"\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\lib\\sf_ears_parser.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"node:path\"` with `'node:path';`","line":10,"column":23,"nodeType":null,"messageId":"replace","endLine":10,"endColumn":34,"fix":{"range":[187,198],"text":"'node:path';"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"./sf_ears_types\"` with `'./sf_ears_types';`","line":49,"column":8,"nodeType":null,"messageId":"replace","endLine":49,"endColumn":25,"fix":{"range":[1000,1017],"text":"'./sf_ears_types';"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·body:·string;·declaredPattern:·EarsPattern·|·undefined·` with `⏎··body:·string;⏎··declaredPattern:·EarsPattern·|·undefined;⏎`","line":63,"column":46,"nodeType":null,"messageId":"replace","endLine":63,"endColumn":102,"fix":{"range":[1399,1455],"text":"\n  body: string;\n  declaredPattern: EarsPattern | undefined;\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"\")` with `'');`","line":65,"column":43,"nodeType":null,"messageId":"replace","endLine":65,"endColumn":46,"fix":{"range":[1534,1537],"text":"'');"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":68,"column":59,"nodeType":null,"messageId":"insert","endLine":68,"endColumn":59,"fix":{"range":[1631,1631],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":69,"column":50,"nodeType":null,"messageId":"insert","endLine":69,"endColumn":50,"fix":{"range":[1681,1681],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":72,"column":32,"nodeType":null,"messageId":"insert","endLine":72,"endColumn":32,"fix":{"range":[1734,1734],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":74,"column":44,"nodeType":null,"messageId":"insert","endLine":74,"endColumn":44,"fix":{"range":[1807,1807],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":78,"column":45,"nodeType":null,"messageId":"insert","endLine":78,"endColumn":45,"fix":{"range":[1944,1944],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":84,"column":41,"nodeType":null,"messageId":"insert","endLine":84,"endColumn":41,"fix":{"range":[2080,2080],"text":";"}},{"ruleId":"no-useless-escape","severity":2,"message":"Unnecessary escape character: \\/.","line":108,"column":49,"nodeType":"Literal","messageId":"unnecessaryEscape","endLine":108,"endColumn":50,"suggestions":[{"messageId":"removeEscape","fix":{"range":[2704,2705],"text":""},"desc":"Remove the `\\`. This maintains the current functionality."},{"messageId":"escapeBackslash","fix":{"range":[2704,2704],"text":"\\"},"desc":"Replace the `\\` with `\\\\` to include the actual backslash character."}]},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":109,"column":78,"nodeType":null,"messageId":"insert","endLine":109,"endColumn":78,"fix":{"range":[2808,2808],"text":";"}},{"ruleId":"no-useless-escape","severity":2,"message":"Unnecessary escape character: \\/.","line":113,"column":41,"nodeType":"Literal","messageId":"unnecessaryEscape","endLine":113,"endColumn":42,"suggestions":[{"messageId":"removeEscape","fix":{"range":[2897,2898],"text":""},"desc":"Remove the `\\`. This maintains the current functionality."},{"messageId":"escapeBackslash","fix":{"range":[2897,2897],"text":"\\"},"desc":"Replace the `\\` with `\\\\` to include the actual backslash character."}]},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":113,"column":48,"nodeType":null,"messageId":"insert","endLine":113,"endColumn":48,"fix":{"range":[2904,2904],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"..\"` with `'..'`","line":114,"column":25,"nodeType":null,"messageId":"replace","endLine":114,"endColumn":29,"fix":{"range":[2929,2933],"text":"'..'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":115,"column":79,"nodeType":null,"messageId":"insert","endLine":115,"endColumn":79,"fix":{"range":[3016,3016],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":119,"column":65,"nodeType":null,"messageId":"insert","endLine":119,"endColumn":65,"fix":{"range":[3110,3110],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":124,"column":31,"nodeType":null,"messageId":"insert","endLine":124,"endColumn":31,"fix":{"range":[3265,3265],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `!resolvedPath.startsWith(normalizedSpecDir)·&&·resolvedPath·!==·specDirectory.replace(/[\\/\\\\]$/,·\"\")` with `⏎····!resolvedPath.startsWith(normalizedSpecDir)·&&⏎····resolvedPath·!==·specDirectory.replace(/[\\/\\\\]$/,·'')⏎··`","line":128,"column":7,"nodeType":null,"mes