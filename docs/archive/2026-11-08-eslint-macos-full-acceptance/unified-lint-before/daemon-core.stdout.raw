":null,"messageId":"replace","endLine":107,"endColumn":8,"fix":{"range":[4328,4402],"text":" !LEGACY_MODULE_IDENTITY_FIELDS.some(field => field in value)"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":108,"column":6,"nodeType":null,"messageId":"insert","endLine":108,"endColumn":6,"fix":{"range":[4409,4409],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":109,"column":5,"nodeType":null,"messageId":"insert","endLine":109,"endColumn":5,"fix":{"range":[4414,4414],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":113,"column":22,"nodeType":null,"messageId":"delete","endLine":113,"endColumn":23,"fix":{"range":[4497,4498],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":117,"column":44,"nodeType":null,"messageId":"delete","endLine":117,"endColumn":45,"fix":{"range":[4660,4661],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":118,"column":4,"nodeType":null,"messageId":"insert","endLine":118,"endColumn":4,"fix":{"range":[4665,4665],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":119,"column":44,"nodeType":null,"messageId":"insert","endLine":119,"endColumn":44,"fix":{"range":[4709,4709],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `await·readFile(⏎····join(projectPath,·SPEC_DIR_NAME,·'project',·'spec_manifest.json'),⏎····'utf8',` with `⏎····await·readFile(join(projectPath,·SPEC_DIR_NAME,·'project',·'spec_manifest.json'),·'utf8')`","line":121,"column":31,"nodeType":null,"messageId":"replace","endLine":123,"endColumn":12,"fix":{"range":[4741,4839],"text":"\n    await readFile(join(projectPath, SPEC_DIR_NAME, 'project', 'spec_manifest.json'), 'utf8')"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `))·as·unknown` with `)·as·unknown;`","line":124,"column":3,"nodeType":null,"messageId":"replace","endLine":124,"endColumn":16,"fix":{"range":[4842,4855],"text":") as unknown;"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":127,"column":51,"nodeType":null,"messageId":"delete","endLine":127,"endColumn":52,"fix":{"range":[4979,4980],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":128,"column":4,"nodeType":null,"messageId":"insert","endLine":128,"endColumn":4,"fix":{"range":[4984,4984],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":132,"column":4,"nodeType":null,"messageId":"insert","endLine":132,"endColumn":4,"fix":{"range":[5086,5086],"text":";"}}],"suppressedMessages":[],"errorCount":63,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":63,"fixableWarningCount":0,"source":"import { SPEC_DIR_NAME } from \"@specforge/types/directory-layout\";\nimport type { PersistentFileSchemaDescriptor } from '@specforge/types/schema-contract'\nimport { precheckSchemaDescriptors, type SchemaDescriptorPrecheckResult } from '@specforge/types/schema-contract'\nimport { PROJECT_CONFIG_SCHEMA_DESCRIPTOR } from '@specforge/configuration'\nimport { OBSERVABILITY_CONFIG_SCHEMA_DESCRIPTOR } from '@specforge/observability'\nimport { MODULE_CODE_PATTERN } from '@specforge/types'\nimport { readFile } from 'node:fs/promises'\nimport { join } from 'node:path'\n\nconst PROJECT_SPEC_MANIFEST_SCHEMA_VERSION = '1.0' as const\nconst PROJECT_REGISTRY_SCHEMA_VERSION = '1.0' as const\nconst PROJECT_MODULE_SCHEMA_VERSION = '1.0' as const\nconst LEGACY_MODULE_IDENTITY_FIELDS = ['name', 'module_id', 'module', 'id'] as const\n\nfunction isRecord(value: unknown): value is Record<string, unknown> {\n  return typeof value === 'object' && value !== null && !Array.isArray(value)\n}\n\nfunction isCanonicalModuleCode(value: unknown): value is string {\n  return typeof value === 'string' && MODULE_CODE_PATTERN.test(value)\n}\n\nfunction canonicalModuleRoot(moduleCode: string): string {\n  return `${SPEC_DIR_NAME}/project/modules/${moduleCode}`\n}\n\nfunction isCanonicalModuleManifestEntry(value: unknown): value is Record<string, unknown> {\n  if (!isRecord(value) || !isCanonicalModuleCode(value.module_code)) return false\n  if (LEGACY_MODULE_IDENTITY_FIELDS.some((field) => field in value)) return false\n  const root = canonicalModuleRoot(value.module_code)\n  return (\n    value.path === root\n    && value.module_file === `${root}/module.json`\n    && value.requirements === `${root}/requirements.md`\n    && value.design === `${root}/design.md`\n    && value.trace === `${root}/trace.md`\n  )\n}\n\nfunction isCurrentProjectSpecManifest(value: unknown): value is Record<string, unknown> & {\n  default_module: string\n  modules: Record<string, unknown>[]\n} {\n  if (!isRecord(value) || !isRecord(value.project)) return false\n  if (\n    typeof value.project_spec_version !== 'string'\n    || value.project_spec_version.length === 0\n    || typeof value.project_name !== 'string'\n    || value.project_name.length === 0\n    || !isCanonicalModuleCode(value.default_module)\n    || !Array.isArray(value.modules)\n    || value.modules.length === 0\n    || !value.modules.every(isCanonicalModuleManifestEntry)\n  ) return false\n  const moduleCodes = value.modules.map((module) => module.module_code as string)\n  return new Set(moduleCodes).size === moduleCodes.length && moduleCodes.includes(value.default_module)\n}\n\nexport const PROJECT_REGISTRATION_SCHEMA_DESCRIPTORS: readonly PersistentFileSchemaDescriptor[] = [\n  {\n    id: 'project-spec-manifest',\n    owner: '@specforge/daemon-core/project-spec',\n    relativePath: (`${SPEC_DIR_NAME}/project/spec_manifest.json` as const),\n    format: 'json',\n    required: true,\n    currentSchemaId: PROJECT_SPEC_MANIFEST_SCHEMA_VERSION,\n    validateCurrent: isCurrentProjectSpecManifest,\n  },\n  PROJECT_CONFIG_SCHEMA_DESCRIPTOR,\n  OBSERVABILITY_CONFIG_SCHEMA_DESCRIPTOR,\n  {\n    id: 'project-extension-registry',\n    owner: '@specforge/daemon-core/project-spec-merge',\n    relativePath: (`${SPEC_DIR_NAME}/project/extension_registry.json` as const),\n    format: 'json',\n    required: true,\n    currentSchemaId: PROJECT_REGISTRY_SCHEMA_VERSION,\n    validateCurrent: (value: unknown): boolean => {\n      if (!isRecord(value)) return false\n      return (\n        typeof value.project_spec_version === 'string'\n        && value.project_spec_version.length > 0\n        && isRecord(value.namespaces)\n        && isRecord(value.contracts)\n      )\n    },\n  },\n]\n\nexport function createProjectModuleSchemaDescriptors(\n  manifest: unknown,\n): readonly PersistentFileSchemaDescriptor[] {\n  if (!isCurrentProjectSpecManifest(manifest)) return []\n  return manifest.modules.map((entry) => {\n    const moduleCode = entry.module_code as string\n    return {\n      id: `project-module-${moduleCode}`,\n      owner: '@specforge/daemon-core/project-module',\n      relativePath: `${canonicalModuleRoot(moduleCode)}/module.json`,\n      format: 'json',\n      required: true,\n      currentSchemaId: PROJECT_MODULE_SCHEMA_VERSION,\n      validateCurrent: (value: unknown): boolean => (\n        isRecord(value)\n        && value.module_code === moduleCode\n        && !LEGACY_MODULE_IDENTITY_FIELDS.some((field) => field in value)\n      ),\n    }\n  })\n}\n\nexport async function precheckProjectRegistrationSchemas(\n  projectPath: string,\n): Promise<SchemaDescriptorPrecheckResult> {\n  const staticResult = await precheckSchemaDescriptors(\n    projectPath,\n    PROJECT_REGISTRATION_SCHEMA_DESCRIPTORS,\n  )\n  if (!staticResult.ok) return staticResult\n\n  const manifest = JSON.parse(await readFile(\n    join(projectPath, SPEC_DIR_NAME, 'project', 'spec_manifest.json'),\n    'utf8',\n  )) as unknown\n  const moduleResult = await precheckSchemaDescriptors(\n    projectPath,\n    createProjectModuleSchemaDescriptors(manifest),\n  )\n  return {\n    ok: moduleResult.ok,\n    checks: [...staticResult.checks, ...moduleResult.checks],\n  }\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\recovery\\ProjectArchiveRestore.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"@specforge/types/directory-layout\"` with `'@specforge/types/directory-layout'`","line":1,"column":31,"nodeType":null,"messageId":"replace","endLine":1,"endColumn":66,"fix":{"range":[30,65],"text":"'@specforge/types/directory-layout'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·schema_version:·'1.0';·input:·ProjectArchiveRestoreInput;` with `⏎··schema_version:·'1.0';⏎··input:·ProjectArchiveRestoreInput;⏎·`","line":21,"column":14,"nodeType":null,"messageId":"replace","endLine":21,"endColumn":72,"fix":{"range":[823,881],"text":"\n  schema_version: '1.0';\n  input: ProjectArchiveRestoreInput;\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·objects:·Entry[];·stage:·string;·residue:·string·` with `⏎··objects:·Entry[];⏎··stage:·string;⏎··residue:·string;⏎`","line":22,"column":21,"nodeType":null,"messageId":"replace","endLine":22,"endColumn":71,"fix":{"range":[923,973],"text":"\n  objects: Entry[];\n  stage: string;\n  residue: string;\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·`","line":24,"column":65,"nodeType":null,"messageId":"insert","endLine":24,"endColumn":65,"fix":{"range":[1074,1074],"text":"\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·`","line":25,"column":54,"nodeType":null,"messageId":"insert","endLine":25,"endColumn":54,"fix":{"range":[1179,1179],"text":"\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·throw·new·Error(`ARCHIVE_RECOVERY_${reason}`);·` with `⏎··throw·new·Error(`ARCHIVE_RECOVERY_${reason}`);⏎`","line":26,"column":39,"nodeType":null,"messageId":"replace","endLine":26,"endColumn":87,"fix":{"range":[1306,1354],"text":"\n  throw new Error(`ARCHIVE_RECOVERY_${reason}`);\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·fs.lstat(file).then(()·=>·true,` with `⏎··fs.lstat(file).then(⏎····()·=>·true,⏎···`","line":27,"column":39,"nodeType":null,"messageId":"replace","endLine":27,"endColumn":71,"fix":{"range":[1394,1426],"text":"\n  fs.lstat(file).then(\n    () => true,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `····`","line":28,"column":3,"nodeType":null,"messageId":"insert","endLine":28,"endColumn":3,"fix":{"range":[1440,1440],"text":"    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `····`","line":29,"column":3,"nodeType":null,"messageId":"insert","endLine":29,"endColumn":3,"fix":{"range":[1485,1485],"text":"    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `}` with `····}⏎··`","line":30,"column":1,"nodeType":null,"messageId":"replace","endLine":30,"endColumn":2,"fix":{"range":[1498,1499],"text":"    }\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `typeof·value·!==·'string'·||·!value·||·value.length·>·1024·||` with `⏎····typeof·value·!==·'string'·||⏎····!value·||⏎····value.length·>·1024·||⏎···`","line":34,"column":7,"nodeType":null,"messageId":"replace","endLine":34,"endColumn":68,"fix":{"range":[1663,1724],"text":"\n    typeof value !== 'string' ||\n    !value ||\n    value.length > 1024 ||\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `··value.split('/').some(part·=>·!part·||·part·===·'.'·||·part·===·'..'·||` with `value⏎······.split('/')⏎······.some(⏎········part·=>⏎··········!part·||⏎··········part·===·'.'·||⏎··········part·===·'..'·||⏎·········`","line":35,"column":5,"nodeType":null,"messageId":"replace","endLine":35,"endColumn":78,"fix":{"range":[1753,1826],"text":"value\n      .split('/')\n      .some(\n        part =>\n          !part ||\n          part === '.' ||\n          part === '..' ||\n         "}},{"ruleId":"no-control-regex","severity":2,"message":"Unexpected control character(s) in regular expression: \\x00, \\x1f.","line":35,"column":79,"nodeType":"Literal","messageId":"unexpected","endLine":35,"endColumn":99},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `/[.·]$/.test(part)·||·/^(con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$)/i.test(part)))` with `··/[.·]$/.test(part)·||⏎··········/^(con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$)/i.test(part)⏎······)⏎··)⏎···`","line":36,"column":9,"nodeType":null,"messageId":"replace","endLine":36,"endColumn":91,"fix":{"range":[1870,1952],"text":"  /[. ]$/.test(part) ||\n          /^(con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$)/i.test(part)\n      )\n  )\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `await·exists(cursor` with `(await·exists(cursor)`","line":44,"column":10,"nodeType":null,"messageId":"replace","endLine":44,"endColumn":29,"fix":{"range":[2253,2272],"text":"(await exists(cursor)"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·····`","line":46,"column":96,"nodeType":null,"messageId":"insert","endLine":46,"endColumn":96,"fix":{"range":[2421,2421],"text":"\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·await·handle.writeFile(data);·await·handle.sync();·}·finally·{·await·handle.close();` with `⏎····await·handle.writeFile(data);⏎····await·handle.sync();⏎··}·finally·{⏎····await·handle.close();⏎·`","line":76,"column":8,"nodeType":null,"messageId":"replace","endLine":76,"endColumn":93,"fix":{"range":[3552,3637],"text":"\n    await handle.writeFile(data);\n    await handle.sync();\n  } finally {\n    await handle.close();\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·await·handle.writeFile(JSON.stringify({·utc:·new·Date().toISOString(),·...event·})·+·'\\n');·await·handle.sync();·}⏎··finally·{·await·handle.close();` with `⏎····await·handle.writeFile(JSON.stringify({·utc:·new·Date().toISOString(),·...event·})·+·'\\n');⏎····await·handle.sync();⏎··}·finally·{⏎····await·handle.close();⏎·`","line":96,"column":8,"nodeType":null,"messageId":"replace","endLine":97,"endColumn":34,"fix":{"range":[4497,4646],"text":"\n    await handle.writeFile(JSON.stringify({ utc: new Date().toISOString(), ...event }) + '\\n');\n    await handle.sync();\n  } finally {\n    await handle.close();\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `!Number.isSafeInteger(entry.size)·||·entry.size·<·0·||` with `⏎····!Number.isSafeInteger(entry.size)·||⏎····entry.size·<·0·||⏎···`","line":102,"column":7,"nodeType":null,"messageId":"replace","endLine":102,"endColumn":61,"fix":{"range":[4731,4785],"text":"\n    !Number.isSafeInteger(entry.size) ||\n    entry.size < 0 ||\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `······typeof·entry.bytes_base64·!==·'string'·||·!/^[a-f0-9]{64}$/.test(entry.sha256))` with `····typeof·entry.bytes_base64·!==·'string'·||⏎····!/^[a-f0-9]{64}$/.test(entry.sha256)⏎··)⏎···`","line":103,"column":1,"nodeType":null,"messageId":"replace","endLine":103,"endColumn":86,"fix":{"range":[4819,4904],"text":"    typeof entry.bytes_base64 !== 'string' ||\n    !/^[a-f0-9]{64}$/.test(entry.sha256)\n  )\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `bytes.toString('base64')·!==·entry.bytes_base64·||·bytes.length·!==·entry.size·||·digest(bytes)·!==·entry.sha256)` with `⏎····bytes.toString('base64')·!==·entry.bytes_base64·||⏎····bytes.length·!==·entry.size·||⏎····digest(bytes)·!==·entry.sha256⏎··)⏎···`","line":105,"column":7,"nodeType":null,"messageId":"replace","endLine":105,"endColumn":120,"fix":{"range":[4993,5106],"text":"\n    bytes.toString('base64') !== entry.bytes_base64 ||\n    bytes.length !== entry.size ||\n    digest(bytes) !== entry.sha256\n  )\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `typeof·archive.project·!==·'string'·||·projectPathIdentity(archive.project)·!==·projectPathIdentity(input.project_path))` with `⏎····typeof·archive.project·!==·'string'·||⏎····projectPathIdentity(archive.project)·!==·projectPathIdentity(input.project_path)⏎··)⏎···`"