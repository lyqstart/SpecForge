atch` with `⏎····req:·http.IncomingMessage,⏎····res:·http.ServerResponse,⏎····body:·string,⏎····match:·RouteMatch⏎··`","line":135,"column":4,"nodeType":null,"messageId":"replace","endLine":135,"endColumn":88,"fix":{"range":[4611,4695],"text":"\n    req: http.IncomingMessage,\n    res: http.ServerResponse,\n    body: string,\n    match: RouteMatch\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·topic:·string;·handler:·(event:·Event)·=>·void;·unsubscribe:·()·=>·void` with `⏎····topic:·string;⏎····handler:·(event:·Event)·=>·void;⏎····unsubscribe:·()·=>·void;⏎·`","line":171,"column":29,"nodeType":null,"messageId":"replace","endLine":171,"endColumn":101,"fix":{"range":[5678,5750],"text":"\n    topic: string;\n    handler: (event: Event) => void;\n    unsubscribe: () => void;\n "}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":201,"column":5,"nodeType":null,"messageId":"delete","endLine":201,"endColumn":6,"fix":{"range":[6759,6760],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":216,"column":67,"nodeType":null,"messageId":"delete","endLine":216,"endColumn":68,"fix":{"range":[7238,7239],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·······`","line":228,"column":23,"nodeType":null,"messageId":"insert","endLine":228,"endColumn":23,"fix":{"range":[7690,7690],"text":"\n       "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·maxFileSize:·10·*·1024·*·1024,·maxArchiveFiles:·3,·fsync:·false` with `⏎········maxFileSize:·10·*·1024·*·1024,⏎········maxArchiveFiles:·3,⏎········fsync:·false,⏎·····`","line":230,"column":47,"nodeType":null,"messageId":"replace","endLine":230,"endColumn":111,"fix":{"range":[7911,7975],"text":"\n        maxFileSize: 10 * 1024 * 1024,\n        maxArchiveFiles: 3,\n        fsync: false,\n     "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `.initialize()` with `⏎········.initialize()⏎········`","line":231,"column":15,"nodeType":null,"messageId":"replace","endLine":231,"endColumn":28,"fix":{"range":[7994,8007],"text":"\n        .initialize()\n        "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(err)` with `err`","line":267,"column":27,"nodeType":null,"messageId":"replace","endLine":267,"endColumn":32,"fix":{"range":[9039,9044],"text":"err"}},{"ruleId":"@typescript-eslint/no-floating-promises","severity":2,"message":"Promises must be awaited, end with a call to .catch, end with a call to .then with a rejection handler or be explicitly marked as ignored with the `void` operator.","line":284,"column":7,"nodeType":"ExpressionStatement","messageId":"floatingVoid","endLine":284,"endColumn":36,"suggestions":[{"messageId":"floatingFixVoid","fix":{"range":[9349,9349],"text":"void "},"desc":"Add void operator to ignore."},{"messageId":"floatingFixAwait","fix":{"range":[9349,9349],"text":"await "},"desc":"Add await operator."}]},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'POST',·'/api/v1/kernel/session/spawn',·this.handleKernelSessionSpawn.bind(this)` with `⏎······'POST',⏎······'/api/v1/kernel/session/spawn',⏎······this.handleKernelSessionSpawn.bind(this)⏎····`","line":305,"column":24,"nodeType":null,"messageId":"replace","endLine":305,"endColumn":104,"fix":{"range":[10451,10531],"text":"\n      'POST',\n      '/api/v1/kernel/session/spawn',\n      this.handleKernelSessionSpawn.bind(this)\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `'POST',·'/api/v1/kernel/session/prompt',·this.handleKernelSessionPrompt.bind(this)` with `⏎······'POST',⏎······'/api/v1/kernel/session/prompt',⏎······this.handleKernelSessionPrompt.bind(this)⏎····`","line":306,"column":24,"nodeType":null,"messageId":"replace","endLine":306,"endColumn":106,"fix":{"range":[10557,10639],"text":"\n      'POST',\n      '/api/v1/kernel/session/prompt',\n      this.handleKernelSessionPrompt.bind(this)\n    "}},{"ruleId":"prettier/prettier","severity":2,"mess