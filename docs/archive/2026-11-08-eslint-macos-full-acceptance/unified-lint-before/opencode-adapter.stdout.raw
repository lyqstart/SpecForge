Type":null,"messageId":"delete","endLine":474,"endColumn":3,"fix":{"range":[13769,13771],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":475,"column":1,"nodeType":null,"messageId":"delete","endLine":475,"endColumn":3,"fix":{"range":[13789,13791],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":476,"column":7,"nodeType":null,"messageId":"delete","endLine":476,"endColumn":9,"fix":{"range":[13894,13896],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `··}⏎····` with `}`","line":477,"column":5,"nodeType":null,"messageId":"replace","endLine":478,"endColumn":5,"fix":{"range":[13918,13926],"text":"}"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·········`","line":499,"column":20,"nodeType":null,"messageId":"insert","endLine":499,"endColumn":20,"fix":{"range":[14456,14456],"text":"\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·details.suggestion·??` with `⏎··········details.suggestion·??⏎·········`","line":518,"column":20,"nodeType":null,"messageId":"replace","endLine":518,"endColumn":42,"fix":{"range":[14986,15008],"text":"\n          details.suggestion ??\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······message,⏎······AdapterErrorCode.PROMPT_DELIVERY_FAILED,⏎······sessionId,⏎·····` with `message,·AdapterErrorCode.PROMPT_DELIVERY_FAILED,·sessionId,`","line":530,"column":11,"nodeType":null,"messageId":"replace","endLine":534,"endColumn":6,"fix":{"range":[15332,15417],"text":"message, AdapterErrorCode.PROMPT_DELIVERY_FAILED, sessionId,"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":535,"column":1,"nodeType":null,"messageId":"delete","endLine":535,"endColumn":3,"fix":{"range":[15420,15422],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":536,"column":1,"nodeType":null,"messageId":"delete","endLine":536,"endColumn":3,"fix":{"range":[15440,15442],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":537,"column":7,"nodeType":null,"messageId":"delete","endLine":537,"endColumn":9,"fix":{"range":[15544,15546],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":538,"column":7,"nodeType":null,"messageId":"delete","endLine":538,"endColumn":9,"fix":{"range":[15569,15571],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `······}⏎····` with `····}`","line":539,"column":1,"nodeType":null,"messageId":"replace","endLine":540,"endColumn":5,"fix":{"range":[15586,15598],"text":"    }"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·········`","line":555,"column":20,"nodeType":null,"messageId":"insert","endLine":555,"endColumn":20,"fix":{"range":[15990,15990],"text":"\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·details.suggestion·??` with `⏎··········details.suggestion·??⏎·········`","line":586,"column":20,"nodeType":null,"messageId":"replace","endLine":586,"endColumn":42,"fix":{"range":[16747,16769],"text":"\n          details.suggestion ??\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·········`","line":633,"column":20,"nodeType":null,"messageId":"insert","endLine":633,"endColumn":20,"fix":{"range":[17953,17953],"text":"\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·········`","line":658,"column":20,"nodeType":null,"messageId":"insert","endLine":658,"endColumn":20,"fix":{"range":[18609,18609],"text":"\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·········`","line":684,"column":20,"nodeType":null,"messageId":"insert","endLine":684,"endColumn":20,"fix":{"range":[19302,19302],"text":"\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `endpoint:·string,·attempts:·number,·lastError:·string·|·undefined,·details:·ErrorDetails·=·{}` with `⏎····endpoint:·string,⏎····attempts:·number,⏎····lastError:·string·|·undefined,⏎····details:·ErrorDetails·=·{}⏎··`","line":699,"column":15,"nodeType":null,"messageId":"replace","endLine":699,"endColumn":108,"fix":{"range":[19723,19816],"text":"\n    endpoint: string,\n    attempts: number,\n    lastError: string | undefined,\n    details: ErrorDetails = {}\n  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·details.suggestion·??` with `⏎··········details.suggestion·??⏎·········`","line":711,"column":20,"nodeType":null,"messageId":"replace","endLine":711,"endColumn":42,"fix":{"range":[20110,20132],"text":"\n          details.suggestion ??\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎·········`","line":731,"column":20,"nodeType":null,"messageId":"insert","endLine":731,"endColumn":20,"fix":{"range":[20712,20712],"text":"\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·details.suggestion·??` with `⏎··········details.suggestion·??⏎·········`","line":755,"column":20,"nodeType":null,"messageId":"replace","endLine":755,"endColumn":42,"fix":{"range":[21359,21381],"text":"\n          details.suggestion ??\n         "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······`Invalid·parameter·'${paramName}':·${reason}`,⏎······AdapterErrorCode.INVALID_PARAMS,⏎·····` with ``Invalid·parameter·'${paramName}':·${reason}`,·AdapterErrorCode.INVALID_PARAMS,`","line":774,"column":11,"nodeType":null,"messageId":"replace","endLine":777,"endColumn":6,"fix":{"range":[21931,22029],"text":"`Invalid parameter '${paramName}': ${reason}`, AdapterErrorCode.INVALID_PARAMS,"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":778,"column":1,"nodeType":null,"messageId":"delete","endLine":778,"endColumn":3,"fix":{"range":[22032,22034],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":779,"column":7,"nodeType":null,"messageId":"delete","endLine":779,"endColumn":9,"fix":{"range":[22058,22060],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":780,"column":1,"nodeType":null,"messageId":"delete","endLine":780,"endColumn":3,"fix":{"range":[22071,22073],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":781,"column":1,"nodeType":null,"messageId":"delete","endLine":781,"endColumn":3,"fix":{"range":[22101,22103],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":782,"column":7,"nodeType":null,"messageId":"delete","endLine":782,"endColumn":9,"fix":{"range":[22128,22130],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":783,"column":1,"nodeType":null,"messageId":"delete","endLine":783,"endColumn":3,"fix":{"range":[22133,22135],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":784,"column":7,"nodeType":null,"messageId":"delete","endLine":784,"endColumn":9,"fix":{"range":[22232,22234],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `··}⏎····` with `}`","line":785,"column":5,"nodeType":null,"messageId":"replace","endLine":786,"endColumn":5,"fix":{"range":[22256,22264],"text":"}"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `⏎······`Internal·adapter·error:·${message}`,⏎······AdapterErrorCode.INTERNAL_ERROR,⏎·····` with ``Internal·adapter·error:·${message}`,·AdapterErrorCode.INTERNAL_ERROR,`","line":796,"column":11,"nodeType":null,"messageId":"replace","endLine":799,"endColumn":6,"fix":{"range":[22486,22575],"text":"`Internal adapter error: ${message}`, AdapterErrorCode.INTERNAL_ERROR,"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `··`","line":800,"column":1,"nodeType":null,"messageId":"delete","endLine":800,"endColumn":3,"fix":{"range":[22578,22580],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `········suggestion:` with `······suggestion:⏎·······`","line":801,"column":