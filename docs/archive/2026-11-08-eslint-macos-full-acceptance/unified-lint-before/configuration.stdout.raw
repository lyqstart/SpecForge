:"prettier/prettier","severity":2,"message":"Insert `;`","line":161,"column":67,"nodeType":null,"messageId":"insert","endLine":161,"endColumn":67,"fix":{"range":[5578,5578],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":162,"column":35,"nodeType":null,"messageId":"insert","endLine":162,"endColumn":35,"fix":{"range":[5613,5613],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":165,"column":49,"nodeType":null,"messageId":"insert","endLine":165,"endColumn":49,"fix":{"range":[5721,5721],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":166,"column":28,"nodeType":null,"messageId":"insert","endLine":166,"endColumn":28,"fix":{"range":[5749,5749],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":167,"column":69,"nodeType":null,"messageId":"insert","endLine":167,"endColumn":69,"fix":{"range":[5818,5818],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":169,"column":43,"nodeType":null,"messageId":"insert","endLine":169,"endColumn":43,"fix":{"range":[5862,5862],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":170,"column":25,"nodeType":null,"messageId":"insert","endLine":170,"endColumn":25,"fix":{"range":[5887,5887],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":171,"column":85,"nodeType":null,"messageId":"insert","endLine":171,"endColumn":85,"fix":{"range":[5972,5972],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":174,"column":60,"nodeType":null,"messageId":"insert","endLine":174,"endColumn":60,"fix":{"range":[6109,6109],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":175,"column":28,"nodeType":null,"messageId":"insert","endLine":175,"endColumn":28,"fix":{"range":[6137,6137],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":176,"column":94,"nodeType":null,"messageId":"insert","endLine":176,"endColumn":94,"fix":{"range":[6231,6231],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":178,"column":56,"nodeType":null,"messageId":"insert","endLine":178,"endColumn":56,"fix":{"range":[6288,6288],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":179,"column":28,"nodeType":null,"messageId":"insert","endLine":179,"endColumn":28,"fix":{"range":[6316,6316],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":180,"column":69,"nodeType":null,"messageId":"insert","endLine":180,"endColumn":69,"fix":{"range":[6385,6385],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":182,"column":93,"nodeType":null,"messageId":"insert","endLine":182,"endColumn":93,"fix":{"range":[6479,6479],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":183,"column":16,"nodeType":null,"messageId":"insert","endLine":183,"endColumn":16,"fix":{"range":[6495,6495],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":188,"column":3,"nodeType":null,"messageId":"delete","endLine":188,"endColumn":4,"fix":{"range":[6548,6549],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":195,"column":29,"nodeType":null,"messageId":"delete","endLine":195,"endColumn":30,"fix":{"range":[6817,6818],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":197,"column":68,"nodeType":null,"messageId":"insert","endLine":197,"endColumn":68,"fix":{"range":[6913,6913],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":198,"column":71,"nodeType":null,"messageId":"insert","endLine":198,"endColumn":71,"fix":{"range":[6984,6984],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":199,"column":52,"nodeType":null,"messageId":"insert","endLine":199,"endColumn":52,"fix":{"range":[7036,7036],"text":";"}}],"suppressedMessages":[],"errorCount":84,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":83,"fixableWarningCount":0,"source":"/**\n * Configuration file loading with error handling and logging\n */\n\nimport fs from 'node:fs/promises'\nimport path from 'node:path'\nimport { ConfigLayer, ConfigLayerType, MergedConfig } from './types'\nimport { CONFIG_SCHEMA_VERSION, DEFAULT_CONFIG, SENSITIVE_FIELDS } from './constants'\nimport { logger } from './logger'\nimport { mergeConfigLayers } from './config-merge'\nimport { LAYOUT, SPEC_DIR_NAME } from '@specforge/types/directory-layout'\nimport { resolveSpecForgeUserRoot } from '@specforge/types/user-level-paths'\n\n/**\n * Runtime configuration source\n */\nexport interface RuntimeConfigSource {\n  cliArgs?: Record<string, unknown>\n  envVars?: Record<string, unknown>\n}\n\n/**\n * Load configuration from a JSON file\n */\nexport async function loadConfigFile(filePath: string): Promise<Record<string, unknown>> {\n  try {\n    logger.debug('Loading configuration file', { filePath })\n    const content = await fs.readFile(filePath, 'utf-8')\n    const data = JSON.parse(content)\n    logger.info('Configuration file loaded successfully', { filePath })\n    return data\n  } catch (error) {\n    const err = error as NodeJS.ErrnoException & { message?: string; code?: string }\n    if (err.code === 'ENOENT') {\n      logger.debug('Configuration file not found', { filePath })\n      throw new Error(`Configuration file not found: ${filePath}`)\n    }\n    if (err instanceof SyntaxError) {\n      logger.error('Invalid JSON in configuration file', { filePath, message: err.message })\n      throw new Error(`Invalid JSON in configuration file ${filePath}: ${err.message}`)\n    }\n    logger.error('Failed to load configuration file', { filePath, message: err.message })\n    throw new Error(`Failed to load configuration file ${filePath}: ${err.message}`)\n  }\n}\n\n/**\n * Create a config layer with timestamp\n */\nfunction createConfigLayer(\n  type: ConfigLayerType,\n  path: string | undefined,\n  data: Record<string, unknown>,\n): ConfigLayer {\n  return {\n    type,\n    path,\n    timestamp: Date.now(),\n    data,\n    schemaVersion: CONFIG_SCHEMA_VERSION,\n  }\n}\n\n/**\n * Load builtin configuration from code constants\n */\nexport async function loadBuiltinConfig(): Promise<ConfigLayer> {\n  logger.debug('Loading builtin configuration')\n  return createConfigLayer('builtin', undefined, DEFAULT_CONFIG)\n}\n\n/**\n * Load user-level configuration from <OpenCode config>/sf-user/config/\n */\nexport async function loadUserConfig(\n  userRoot: string = resolveSpecForgeUserRoot(),\n): Promise<ConfigLayer> {\n  const configPath = path.join(userRoot, 'config', 'config.json')\n  logger.debug('Loading user-level configuration', { configPath })\n\n  const data = await loadConfigFile(configPath)\n  return createConfigLayer('user', configPath, data)\n}\n\n/**\n * Load project-level configuration from <project>/.specforge/config/\n * \n * CRITICAL: Project-level configuration is mandatory.\n * If it fails to load, error immediately without falling back to user-level or builtin.\n */\nexport async function loadProjectConfig(projectPath: string): Promise<ConfigLayer> {\n  const configPath = path.join(projectPath, SPEC_DIR_NAME, LAYOUT.configFiles.project)\n  logger.debug('Loading project-level configuration', { configPath, projectPath })\n\n  let data: Record<string, unknown>\n  try {\n    data = await loadConfigFile(configPath)\n  } catch (error) {\n    const err = error as NodeJS.ErrnoException & { message?: string }\n    // Re-throw with clear context for project-level config failures\n    if (err.code === 'ENOENT') {\n      logger.error('Project-level configuration file not found', { \n        configPath, \n        projectPath,\n        hint: 'Project-level configuration is mandatory. Create .specforge/config/project.json or ensure project initialization completed.'\n      })\n      throw new Error(\n        `Project-level configuration file not found: ${configPath}. ` +\n        `Project-level configuration is mandatory for this project. ` +\n        `Create .specforge/config/project.json or ensure project path is correct.`\n      )\n    }\n    // For other errors (parse errors, permissions, etc.), also throw with context\n    logger.error('Failed to load project-level configuration', { \n      configPath, \n      projectPath,\n      message: err.message\n    })\n    throw new Error(\n      `Failed to load project-level configuration ${configPath}: ${err.message}. ` +\n      `Project-level configuration is mandatory. Check file permissions and JSON syntax.`\n    )\n  }\n  \n  return createConfigLayer('project', configPath, data)\n}\n\n/**\n * Load runtime configuration from CLI args and environment variables\n */\nexport function loadRuntimeConfig(source?: RuntimeConfigSource): ConfigLayer {\n  logger.debug('Loading runtime configuration')\n\n  const cliArgs = source?.cliArgs ?? {}\n  const envVars = source?.envVars ?? {}\n\n  // Convert environment variables to config format\n  const envConfig: Record<string, unknown> = {}\n  for (const [key, value] of Object.entries(envVars)) {\n    if (value !== undefined) {\n      envConfig[key] = value\n    }\n  }\n\n  const runtimeData = { ...cliArgs, ...envConfig }\n  logger.debug('Runtime configuration loaded', { data: runtimeData })\n\n  return createConfigLayer('runtime', 'cli/env', runtimeData)\n}\n\n/**\n * Load all configuration layers in order\n * \n * CRITICAL: Project-level configuration is mandatory.\n * If project-level config fails to load, the entire loading process fails.\n */\nexport async function loadAllConfigLayers(\n  projectPath: string,\n  runtimeSource?: RuntimeConfigSource,\n): Promise<ConfigLayer[]> {\n  logger.info('Loading all configuration layers', { projectPath })\n  const layers: ConfigLayer[] = []\n\n  // Load in order: builtin -> user -> project -> runtime\n  const builtinLayer = await loadBuiltinConfig()\n  layers.push(builtinLayer)\n  logger.debug('Loaded builtin layer', { layer: builtinLayer.type })\n\n  const userLayer = await loadUserConfig()\n  layers.push(userLayer)\n  logger.debug('Loaded user layer', { layer: userLayer.type, path: userLayer.path })\n\n  // Project-level config is mandatory - if it fails, the entire load fails\n  const projectLayer = await loadProjectConfig(projectPath)\n  layers.push(projectLayer)\n  logger.debug('Loaded project layer', { layer: projectLayer.type, path: projectLayer.path })\n\n  const runtimeLayer = loadRuntimeConfig(runtimeSource)\n  layers.push(runtimeLayer)\n  logger.debug('Loaded runtime layer', { layer: runtimeLayer.type })\n\n  logger.info('All configuration layers loaded successfully', { layerCount: layers.length })\n  return layers\n}\n\n/**\n * Load and merge all configuration layers\n * \n * CRITICAL: Project-level configuration is mandatory.\n * If project-level config fails to load, the entire loading process fails.\n */\nexport async function loadAndMergeConfig(\n  projectPath: string,\n  runtimeSource?: RuntimeConfigSource,\n  sensitiveFields?: string[],\n): Promise<MergedConfig> {\n  logger.info('Loading and merging configuration', { projectPath })\n  const layers = await loadAllConfigLayers(projectPath, runtimeSource)\n  return mergeConfigLayers(layers, sensitiveFields)\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\configuration\\src\\config-merge.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":6,"column":86,"nodeType":null,"messageId":"insert","endLine":6,"endColumn":86,"fix":{"range":[213,213],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":7,"column":70,"nodeType":null,"messageId":"insert","endLine":7,"endColumn":70,"fix":{"range":[283,283],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":8,"column":34,"nodeType":null,"messageId":"insert","endLine":8,"endColumn":34,"fix":{"range":[317,317],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `target:·Record<string,·unknown>,·source:·Record<string,·unknown>` with `⏎··target:·Record<string,·unknown>,⏎··source:·Record<string,·unknown>⏎`","line":14,"column":20,"nodeType":null,"messageId":"replace","endLine":14,"endColumn":84,"fix":{"range":[424,488],"text":"\n  target: Record<string, unknown>,\n  source: Record<string, unknown>\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":15,"column":31,"nodeType":null,"messageId":"insert","endLine":15,"endColumn":31,"fix":{"range":[547,547],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":18,"column":36,"nodeType":null,"messageId":"insert","endLine":18,"endColumn":36,"fix":{"range":[645,645],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":22,"column":32,"nodeType":null,"messageId":"insert","endLine":22,"endColumn":32,"fix":{"range":[794,794],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `targetValue·as·Record<string,·unknown>,·sourceValue·as·Record<string,·unknown>)` with `⏎········targetValue·as·Record<string,·unknown>,⏎········sourceValue·as·Record<string,·unknown>⏎······);`","line":33,"column":31,"nodeType":null,"messageId":"replace","endLine":33,"endColumn":110,"fix":{"range":[1082,1161],"text":"\n        targetValue as Record<string, unknown>,\n        sourceValue as Record<string, unknown>\n      );"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":37,"column":32,"nodeType":null,"messageId":"insert","endLine":37,"endColumn":32,"fix":{"range":[1260,1260],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":41,"column":16,"nodeType":null,"messageId":"insert","endLine":41,"endColumn":16,"fix":{"range":[1287,