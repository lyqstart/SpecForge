ange":[1680,1680],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":82,"column":28,"nodeType":null,"messageId":"insert","endLine":82,"endColumn":28,"fix":{"range":[1708,1708],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":83,"column":27,"nodeType":null,"messageId":"insert","endLine":83,"endColumn":27,"fix":{"range":[1735,1735],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":90,"column":18,"nodeType":null,"messageId":"insert","endLine":90,"endColumn":18,"fix":{"range":[1821,1821],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":91,"column":20,"nodeType":null,"messageId":"insert","endLine":91,"endColumn":20,"fix":{"range":[1841,1841],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":92,"column":55,"nodeType":null,"messageId":"insert","endLine":92,"endColumn":55,"fix":{"range":[1896,1896],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":93,"column":35,"nodeType":null,"messageId":"insert","endLine":93,"endColumn":35,"fix":{"range":[1931,1931],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":94,"column":29,"nodeType":null,"messageId":"insert","endLine":94,"endColumn":29,"fix":{"range":[1960,1960],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":101,"column":34,"nodeType":null,"messageId":"insert","endLine":101,"endColumn":34,"fix":{"range":[2090,2090],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":102,"column":43,"nodeType":null,"messageId":"insert","endLine":102,"endColumn":43,"fix":{"range":[2133,2133],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":104,"column":21,"nodeType":null,"messageId":"insert","endLine":104,"endColumn":21,"fix":{"range":[2168,2168],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":105,"column":26,"nodeType":null,"messageId":"insert","endLine":105,"endColumn":26,"fix":{"range":[2194,2194],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":106,"column":31,"nodeType":null,"messageId":"insert","endLine":106,"endColumn":31,"fix":{"range":[2225,2225],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":107,"column":41,"nodeType":null,"messageId":"insert","endLine":107,"endColumn":41,"fix":{"range":[2266,2266],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":108,"column":4,"nodeType":null,"messageId":"insert","endLine":108,"endColumn":4,"fix":{"range":[2270,2270],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":115,"column":19,"nodeType":null,"messageId":"insert","endLine":115,"endColumn":19,"fix":{"range":[2359,2359],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":116,"column":20,"nodeType":null,"messageId":"insert","endLine":116,"endColumn":20,"fix":{"range":[2379,2379],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":117,"column":18,"nodeType":null,"messageId":"insert","endLine":117,"endColumn":18,"fix":{"range":[2397,2397],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":118,"column":36,"nodeType":null,"messageId":"insert","endLine":118,"endColumn":36,"fix":{"range":[2433,2433],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":119,"column":17,"nodeType":null,"messageId":"insert","endLine":119,"endColumn":17,"fix":{"range":[2450,2450],"text":";"}}],"suppressedMessages":[],"errorCount":50,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":50,"fixableWarningCount":0,"source":"/**\n * Configuration types and interfaces\n */\n\nimport { ZodSchema } from 'zod'\n\n/**\n * Configuration layer types\n */\nexport type ConfigLayerType = 'builtin' | 'user' | 'project' | 'runtime'\n\n/**\n * Configuration layer interface\n */\nexport interface ConfigLayer {\n  type: ConfigLayerType\n  path?: string\n  timestamp: number\n  data: Record<string, unknown>\n  schemaVersion?: string\n}\n\n/**\n * Merged configuration result\n */\nexport interface MergedConfig {\n  layers: ConfigLayer[]\n  merged: Record<string, unknown>\n  sources: Record<string, ConfigLayerType> // Key -> layer type that provides the value\n  metadata: {\n    mergedAt: number\n    schemaVersion: string\n    sensitiveFields: string[]\n    validationErrors: ValidationError[]\n  }\n}\n\n/**\n * Validation error interface\n */\nexport interface ValidationError {\n  field: string\n  message: string\n  layer?: ConfigLayerType\n  path?: string\n}\n\n/**\n * Sensitive fields configuration\n */\nexport interface SensitiveFieldsConfig {\n  fields: string[] // Dot-notation paths like \"apiKeys.openai\"\n  rejectOnOverride: boolean\n}\n\n/**\n * Hot-reload configuration\n */\nexport interface HotReloadConfig {\n  enabled: boolean\n  debounceMs: number\n  watchPaths: string[]\n  maxCacheSize?: number // Maximum number of work items to cache (default: 1000)\n  cacheTTLMs?: number // Cache time-to-live in milliseconds (default: 3600000 = 1 hour)\n  enableLRU?: boolean // Enable LRU eviction (default: true)\n}\n\n/**\n * Configuration access options\n */\nexport interface ConfigAccessOptions {\n  layer?: ConfigLayerType\n  throwOnMissing?: boolean\n}\n\n/**\n * Configuration schema interface\n */\nexport interface ConfigSchema {\n  version: string\n  schema: ZodSchema\n  sensitiveFields: string[]\n  requiredFields: string[]\n}\n\n/**\n * Reload event interface\n */\nexport interface ReloadEvent {\n  eventId: string\n  timestamp: number\n  trigger: 'file-watcher' | 'cli-command' | 'api-call'\n  layersChanged: ConfigLayerType[]\n  activationBoundary: number\n}\n\n/**\n * Configuration snapshot for per-workitem caching\n */\nexport interface ConfigSnapshot {\n  merged: Record<string, unknown>\n  sources: Record<string, ConfigLayerType>\n  metadata: {\n    mergedAt: number\n    schemaVersion: string\n    sensitiveFields?: string[]\n    validationErrors?: ValidationError[]\n  }\n}\n\n/**\n * Reload result interface\n */\nexport interface ReloadResult {\n  success: boolean\n  timestamp: number\n  eventId: string\n  layersReloaded: ConfigLayerType[]\n  error?: string\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\configuration\\src\\types\\specforge-types-directory-layout.d.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]}]}
