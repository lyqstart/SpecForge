e":573,"endColumn":33,"fix":{"range":[17744,17744],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":575,"column":1,"nodeType":null,"messageId":"delete","endLine":575,"endColumn":5,"fix":{"range":[17751,17755],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":580,"column":7,"nodeType":null,"messageId":"insert","endLine":580,"endColumn":7,"fix":{"range":[17913,17913],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":581,"column":1,"nodeType":null,"messageId":"delete","endLine":581,"endColumn":5,"fix":{"range":[17914,17918],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":584,"column":69,"nodeType":null,"messageId":"insert","endLine":584,"endColumn":69,"fix":{"range":[18092,18092],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":594,"column":47,"nodeType":null,"messageId":"insert","endLine":594,"endColumn":47,"fix":{"range":[18354,18354],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":596,"column":18,"nodeType":null,"messageId":"insert","endLine":596,"endColumn":18,"fix":{"range":[18415,18415],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":605,"column":13,"nodeType":null,"messageId":"insert","endLine":605,"endColumn":13,"fix":{"range":[18617,18617],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":607,"column":1,"nodeType":null,"messageId":"delete","endLine":607,"endColumn":5,"fix":{"range":[18624,18628],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `.sort(`","line":609,"column":65,"nodeType":null,"messageId":"insert","endLine":609,"endColumn":65,"fix":{"range":[18746,18746],"text":".sort("}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `.sort((a,·b)·=>·a[1].lastAccessedAt·-·b[1].lastAccessedAt)` with `(a,·b)·=>·a[1].lastAccessedAt·-·b[1].lastAccessedAt`","line":610,"column":7,"nodeType":null,"messageId":"replace","endLine":610,"endColumn":65,"fix":{"range":[18753,18811],"text":"(a, b) => a[1].lastAccessedAt - b[1].lastAccessedAt"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `);⏎`","line":611,"column":5,"nodeType":null,"messageId":"insert","endLine":611,"endColumn":5,"fix":{"range":[18816,18816],"text":");\n"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":612,"column":52,"nodeType":null,"messageId":"insert","endLine":612,"endColumn":52,"fix":{"range":[18868,18868],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":613,"column":1,"nodeType":null,"messageId":"delete","endLine":613,"endColumn":5,"fix":{"range":[18869,18873],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":615,"column":38,"nodeType":null,"messageId":"insert","endLine":615,"endColumn":38,"fix":{"range":[18951,18951],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":616,"column":48,"nodeType":null,"messageId":"insert","endLine":616,"endColumn":48,"fix":{"range":[18999,18999],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":617,"column":28,"nodeType":null,"messageId":"insert","endLine":617,"endColumn":28,"fix":{"range":[19027,19027],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":619,"column":1,"nodeType":null,"messageId":"delete","endLine":619,"endColumn":5,"fix":{"range":[19034,19038],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·count:·toEvict,·remaining:·this.workItemSnapshots.size·})` with `⏎······count:·toEvict,⏎······remaining:·this.workItemSnapshots.size,⏎····});`","line":620,"column":45,"nodeType":null,"messageId":"replace","endLine":620,"endColumn":103,"fix":{"range":[19083,19141],"text":"\n      count: toEvict,\n      remaining: this.workItemSnapshots.size,\n    });"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":628,"column":15,"nodeType":null,"messageId":"insert","endLine":628,"endColumn":15,"fix":{"range":[19280,19280],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":630,"column":1,"nodeType":null,"messageId":"delete","endLine":630,"endColumn":5,"fix":{"range":[19287,19291],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":631,"column":27,"nodeType":null,"messageId":"insert","endLine":631,"endColumn":27,"fix":{"range":[19318,19318],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":632,"column":20,"nodeType":null,"messageId":"insert","endLine":632,"endColumn":20,"fix":{"range":[19338,19338],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":633,"column":1,"nodeType":null,"messageId":"delete","endLine":633,"endColumn":5,"fix":{"range":[19339,19343],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":636,"column":50,"nodeType":null,"messageId":"insert","endLine":636,"endColumn":50,"fix":{"range":[19520,19520],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":637,"column":18,"nodeType":null,"messageId":"insert","endLine":637,"endColumn":18,"fix":{"range":[19538,19538],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `····`","line":640,"column":1,"nodeType":null,"messageId":"delete","endLine":640,"endColumn":5,"fix":{"range":[19553,19557],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":642,"column":37,"nodeType":null,"messageId":"insert","endLine":642,"endColumn":37,"fix":{"range":[19617,19617],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·count:·evicted,·remaining:·this.workItemSnapshots.size·})⏎····}` with `⏎········count:·evicted,⏎········remaining:·this.workItemSnapshots.size,⏎······});