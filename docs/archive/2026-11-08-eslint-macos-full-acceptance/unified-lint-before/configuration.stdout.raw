ull,"messageId":"delete","endLine":155,"endColumn":4,"fix":{"range":[4888,4889],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":160,"column":3,"nodeType":null,"messageId":"delete","endLine":160,"endColumn":4,"fix":{"range":[5072,5073],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":167,"column":52,"nodeType":null,"messageId":"delete","endLine":167,"endColumn":53,"fix":{"range":[5362,5363],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":169,"column":78,"nodeType":null,"messageId":"insert","endLine":169,"endColumn":78,"fix":{"range":[5459,5459],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":172,"column":85,"nodeType":null,"messageId":"insert","endLine":172,"endColumn":85,"fix":{"range":[5586,5586],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":175,"column":52,"nodeType":null,"messageId":"insert","endLine":175,"endColumn":52,"fix":{"range":[5691,5691],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":178,"column":45,"nodeType":null,"messageId":"insert","endLine":178,"endColumn":45,"fix":{"range":[5756,5756],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":179,"column":54,"nodeType":null,"messageId":"insert","endLine":179,"endColumn":54,"fix":{"range":[5810,5810],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":182,"column":75,"nodeType":null,"messageId":"insert","endLine":182,"endColumn":75,"fix":{"range":[5924,5924],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":187,"column":77,"nodeType":null,"messageId":"insert","endLine":187,"endColumn":77,"fix":{"range":[6202,6202],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":188,"column":17,"nodeType":null,"messageId":"insert","endLine":188,"endColumn":17,"fix":{"range":[6219,6219],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":203,"column":43,"nodeType":null,"messageId":"delete","endLine":203,"endColumn":44,"fix":{"range":[6649,6650],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":204,"column":10,"nodeType":null,"messageId":"insert","endLine":204,"endColumn":10,"fix":{"range":[6660,6660],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":206,"column":28,"nodeType":null,"messageId":"insert","endLine":206,"endColumn":28,"fix":{"range":[6703,6703],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":208,"column":32,"nodeType":null,"messageId":"insert","endLine":208,"endColumn":32,"fix":{"range":[6743,6743],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":213,"column":48,"nodeType":null,"messageId":"insert","endLine":213,"endColumn":48,"fix":{"range":[6880,6880],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":214,"column":51,"nodeType":null,"messageId":"insert","endLine":214,"endColumn":51,"fix":{"range":[6931,6931],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":215,"column":60,"nodeType":null,"messageId":"insert","endLine":215,"endColumn":60,"fix":{"range":[6991,6991],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":218,"column":36,"nodeType":null,"messageId":"insert","endLine":218,"endColumn":36,"fix":{"range":[7062,7062],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":219,"column":38,"nodeType":null,"messageId":"insert","endLine":219,"endColumn":38,"fix":{"range":[7100,7100],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":232,"column":4,"nodeType":null,"messageId":"insert","endLine":232,"endColumn":4,"fix":{"range":[7401,7401],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":238,"column":5,"nodeType":null,"messageId":"insert","endLine":238,"endColumn":5,"fix":{"range":[7588,7588],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":240,"column":16,"nodeType":null,"messageId":"insert","endLine":240,"endColumn":16,"fix":{"range":[7605,7605],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":246,"column":3,"nodeType":null,"messageId":"delete","endLine":246,"endColumn":4,"fix":{"range":[7730,7731],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Delete `,`","line":253,"column":52,"nodeType":null,"messageId":"delete","endLine":253,"endColumn":53,"fix":{"range":[8001,8002],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":255,"column":40,"nodeType":null,"messageId":"insert","endLine":255,"endColumn":40,"fix":{"range":[8060,8060],"text":";"}}],"suppressedMessages":[],"errorCount":63,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":63,"fixableWarningCount":0,"source":"/**\n * Configuration Merge Engine\n * \n * Implements deterministic four-layer configuration merging with sensitive field protection.\n * \n * Layer priority (lowest to highest):\n * 1. Builtin defaults (code constants)\n * 2. User-level overrides (<OpenCode config>/sf-user/config/)\n * 3. Project-level overrides (<project>/.specforge/config/)\n * 4. Runtime overrides (CLI/env)\n * \n * Merge rules:\n * - Simple values: later layer overrides earlier\n * - Objects: deep merge recursively\n * - Arrays: replace (not concatenate)\n * - Sensitive fields: project-level overrides are rejected with validation error\n * \n * Determinism guarantee (Property 11):\n * - Same inputs always produce same output\n * - Output depends only on layer contents and order, not on timing or environment\n * - Keys are sorted for consistent output\n * - Merge timestamp is deterministic (0 instead of Date.now())\n */\n\nimport { ConfigLayer, ConfigLayerType, MergedConfig, ValidationError } from './types'\nimport { SENSITIVE_FIELDS, CONFIG_SCHEMA_VERSION, CONFIG_LAYER_ORDER } from './constants'\nimport { logger } from './logger'\n\n/**\n * Deep merge two objects recursively\n * Later values override earlier values\n * \n * @param target - The base object\n * @param source - The object to merge into target\n * @returns A new merged object\n */\nfunction deepMerge(\n  target: Record<string, unknown>,\n  source: Record<string, unknown>,\n): Record<string, unknown> {\n  const result = { ...target }\n\n  for (const [key, sourceValue] of Object.entries(source)) {\n    const targetValue = result[key]\n\n    // Handle arrays: replace (not concatenate)\n    if (Array.isArray(sourceValue)) {\n      result[key] = sourceValue\n    }\n    // Handle objects: deep merge\n    else if (\n      sourceValue &&\n      typeof sourceValue === 'object' &&\n      !Array.isArray(sourceValue) &&\n      targetValue &&\n      typeof targetValue === 'object' &&\n      !Array.isArray(targetValue) &&\n      targetValue !== null\n    ) {\n      result[key] = deepMerge(\n        targetValue as Record<string, unknown>,\n        sourceValue as Record<string, unknown>,\n      )\n    }\n    // Handle primitives and mixed types: replace\n    else {\n      result[key] = sourceValue\n    }\n  }\n\n  return result\n}\n\n/**\n * Check if a field is sensitive (protected from project-level override)\n * \n * @param key - The configuration key to check\n * @param sensitiveFields - List of sensitive field names\n * @returns true if the key is a sensitive field\n */\nfunction isSensitiveField(key: string, sensitiveFields: string[]): boolean {\n  const keyParts = key.split('.')\n  const firstPart = keyParts[0]\n\n  return sensitiveFields.some((sensitive) => {\n    const sensitiveParts = sensitive.split('.')\n    return firstPart === sensitiveParts[0]\n  })\n}\n\n/**\n * Validate that project layer doesn't override sensitive fields\n * \n * @param layers - Configuration layers to validate\n * @param sensitiveFields - List of sensitive field names\n * @returns Array of validation errors (empty if no violations)\n */\nfunction validateSensitiveFieldProtection(\n  layers: ConfigLayer[],\n  sensitiveFields: string[],\n): ValidationError[] {\n  const validationErrors: ValidationError[] = []\n  const projectLayer = layers.find((l) => l.type === 'project')\n\n  if (!projectLayer || Object.keys(projectLayer.data).length === 0) {\n    return validationErrors\n  }\n\n  // Check if project layer tries to define any sensitive fields\n  for (const [key] of Object.entries(projectLayer.data)) {\n    if (isSensitiveField(key, sensitiveFields)) {\n      const error: ValidationError = {\n        field: key,\n        message: `Project-level configuration cannot define sensitive field \"${key}\". Sensitive fields must be configured at user-level (<OpenCode config>/sf-user/) or runtime (CLI/env).`,\n        layer: 'project',\n        path: projectLayer.path,\n      }\n      validationErrors.push(error)\n      logger.warn('Sensitive field protection violation', {\n        field: key,\n        path: projectLayer.path,\n      })\n    }\n  }\n\n  return validationErrors\n}\n\n/**\n * Sort configuration layers by priority\n * \n * @param layers - Unsorted layers\n * @returns Layers sorted by priority (builtin → user → project → runtime)\n */\nfunction sortLayersByPriority(layers: ConfigLayer[]): ConfigLayer[] {\n  return [...layers].sort(\n    (a, b) => CONFIG_LAYER_ORDER.indexOf(a.type) - CONFIG_LAYER_ORDER.indexOf(b.type),\n  )\n}\n\n/**\n * Merge configuration layers with deterministic behavior\n * \n * Implements the four-layer configuration model:\n * 1. Builtin defaults (code constants)\n * 2. User-level overrides (<OpenCode config>/sf-user/config/)\n * 3. Project-level overrides (<project>/.specforge/config/)\n * 4. Runtime overrides (CLI/env)\n * \n * Merge rules:\n * - Simple values: later layer overrides earlier\n * - Objects: deep merge\n * - Arrays: replace (not concatenate)\n * - Sensitive fields: project-level overrides are rejected\n * \n * Determinism guarantee (Property 11):\n * - Same inputs always produce same output\n * - Output depends only on layer contents and order\n * - Keys are sorted for consistent output\n * \n * @param layers - Configuration layers to merge\n * @param sensitiveFields - List of sensitive field names (defaults to SENSITIVE_FIELDS)\n * @returns Merged configuration with metadata\n */\nexport function merge(\n  layers: ConfigLayer[],\n  sensitiveFields: string[] = [...SENSITIVE_FIELDS],\n): MergedConfig {\n  logger.debug('Starting configuration merge', { layerCount: layers.length })\n\n  // Validate sensitive field protection\n  const validationErrors = validateSensitiveFieldProtection(layers, sensitiveFields)\n\n  // Sort layers by priority (ensure correct order)\n  const sortedLayers = sortLayersByPriority(layers)\n\n  // Perform merge\n  const merged: Record<string, unknown> = {}\n  const sources: Record<string, ConfigLayerType> = {}\n\n  for (const layer of sortedLayers) {\n    logger.debug('Merging layer', { layer: layer.type, path: layer.path })\n\n    for (const [key, value] of Object.entries(layer.data)) {\n      // Skip sensitive field overrides from project layer\n      if (layer.type === 'project' && isSensitiveField(key, sensitiveFields)) {\n        logger.debug('Skipping sensitive field from project layer', { key })\n        continue\n      }\n\n      // For objects, deep merge; otherwise, replace\n      if (\n        value &&\n        typeof value === 'object' &&\n        !Array.isArray(value) &&\n        merged[key] &&\n        typeof merged[key] === 'object' &&\n        merged[key] !== null &&\n        !Array.isArray(merged[key])\n      ) {\n        merged[key] = deepMerge(\n          merged[key] as Record<string, unknown>,\n          value as Record<string, unknown>,\n        )\n      } else {\n        merged[key] = value\n      }\n      sources[key] = layer.type\n    }\n  }\n\n  // Sort keys for deterministic output (Object.keys order is not guaranteed)\n  const sortedKeys = Object.keys(merged).sort()\n  const sortedMerged: Record<string, unknown> = {}\n  const sortedSources: Record<string, ConfigLayerType> = {}\n\n  for (const key of sortedKeys) {\n    sortedMerged[key] = merged[key]\n    sortedSources[key] = sources[key]\n  }\n\n  const result: MergedConfig = {\n    layers: sortedLayers,\n    merged: sortedMerged,\n    sources: sortedSources,\n    metadata: {\n      mergedAt: 0, // Deterministic: use 0 instead of Date.now()\n      schemaVersion: CONFIG_SCHEMA_VERSION,\n      sensitiveFields,\n      validationErrors,\n    },\n  }\n\n  logger.info('Configuration merge completed', {\n    keyCount: Object.keys(sortedMerged).length,\n    layerCount: sortedLayers.length,\n    validationErrors: validationErrors.length,\n  })\n\n  return result\n}\n\n/**\n * Merge configuration layers (alias for merge function)\n * Provided for backward compatibility with existing code\n * \n * @param layers - Configuration layers to merge\n * @param sensitiveFields - List of sensitive field names\n * @returns Merged configuration with metadata\n */\nexport function mergeConfigLayers(\n  layers: ConfigLayer[],\n  sensitiveFields: string[] = [...SENSITIVE_FIELDS],\n): MergedConfig {\n  return merge(layers, sensitiveFields)\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\configuration\\src\\project-schema-descriptor.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Replace `\"@specforge/types/directory-layout\"` with `'@specforge/types/directory-layout'`","line":1,"column":31,"nodeType":null,"messageId":"replace","endLine":1,"endColumn":66,"fix":{"range":[30,65],"text":"'@specforge/types/directory-layout'"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":2,"column":87,"nodeType":null,"messageId":"insert","endLine":2,"endColumn":87,"fix":{"range":[153,153],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":4,"column":52,"nodeType":null,"messageId":"insert","endLine":4,"endColumn":52,"fix":{"range":[206,206],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":7,"column":78,"nodeType":null,"messageId":"insert","endLine":7,"endColumn":78,"fix":{"range":[355,355],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `(`${SPEC_DIR_NAME}/config/project.json`·as·const)` with ``${SPEC_DIR_NAME}/config/project.json`·as·const`","line":17,"column":17,"nodeType":null,"messageId":"replace","endLine":17,"endColumn":66,"fix":{"range":[683,732],"text":"`${SPEC_DIR_NAME}/config/project.json` as const"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":22,"column":2,"nodeType":null,"messageId":"insert","endLine":22,"endColumn":2,"fix":{"range":[842,842],"text":";"}}],"suppressedMessages":[],"errorCount":6,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":6,"fixableWarningCount":0,"source":"import { SPEC_DIR_NAME } from \"@specforge/types/directory-layout\";\nimport type { PersistentFileSchemaDescriptor } from '@specforge/types/schema-contract'\n\nimport { CONFIG_SCHEMA_VERSION } from './constants'\n\nfunction isRecord(value: unknown): value is Record<string, unknown> {\n  return typeof value === 'object' && value !== null && !Array.isArray(value)\n}\n\n/**\n * Current project configuration contract consumed before Daemon accepts a\n * project context. The registry itself verifies the root schema_version.\n */\nexport const PROJECT_CONFIG_SCHEMA_DESCRIPTOR: PersistentFileSchemaDescriptor = {\n  id: 'project-config',\n  owner: '@specforge/configuration/project',\n  relativePath: (`${SPEC_DIR_NAME}/config/project.json` as const),\n  format: 'json',\n  required: true,\n  currentSchemaId: CONFIG_SCHEMA_VERSION,\n  validateCurrent: isRecord,\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\configuration\\src\\types.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":5,"column":32,"nodeType":null,"messageId":"insert","endLine":5,"endColumn":32,"fix":{"range":[78,78],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":10,"column":73,"nodeType":null,"messageId":"insert","endLine":10,"endColumn":73,"fix":{"range":[189,189],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":16,"column":24,"nodeType":null,"messageId":"insert","endLine":16,"endColumn":24,"fix":{"range":[286,286],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":17,"column":16,"nodeType":null,"messageId":"insert","endLine":17,"endColumn":16,"fix":{"range":[302,302],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":18,"column":20,"nodeType":null,"messageId":"insert","endLine":18,"endColumn":20,"fix":{"range":[322,322],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":19,"column":32,"nodeType":null,"messageId":"insert","endLine":19,"endColumn":32,"fix":{"range":[354,354],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":20,"column":25,"nodeType":null,"messageId":"insert","endLine":20,"endColumn":25,"fix":{"range":[379,379],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":27,"column":24,"nodeType":null,"messageId":"insert","endLine":27,"endColumn":24,"fix":{"range":[477,477],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":28,"column":34,"nodeType":null,"messageId":"insert","endLine":28,"endColumn":34,"fix":{"range":[511,511],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":29,"column":43,"nodeType":null,"messageId":"insert","endLine":29,"endColumn":43,"fix":{"range":[554,554],"text":";"}},