EMA_VERSION,⏎···`","line":41,"column":6,"nodeType":null,"messageId":"replace","endLine":41,"endColumn":136,"fix":{"range":[1948,2078],"text":"\n      type: 'user',\n      data: readObject(join(userRoot, 'config', 'config.json'), true),\n      timestamp: 0,\n      schemaVersion: CONFIG_SCHEMA_VERSION,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·type:·'project',·data:·options.projectData·??·(options.projectPath·?·readObject(join(options.projectPath,·SPEC_DIR_NAME,·'config',·'project.json'),·false)·:·{}),·timestamp:·0,·schemaVersion:·CONFIG_SCHEMA_VERSION` with `⏎······type:·'project',⏎······data:⏎········options.projectData·??⏎········(options.projectPath⏎··········?·readObject(join(options.projectPath,·SPEC_DIR_NAME,·'config',·'project.json'),·false)⏎··········:·{}),⏎······timestamp:·0,⏎······schemaVersion:·CONFIG_SCHEMA_VERSION,⏎···`","line":42,"column":6,"nodeType":null,"messageId":"replace","endLine":42,"endColumn":219,"fix":{"range":[2087,2300],"text":"\n      type: 'project',\n      data:\n        options.projectData ??\n        (options.projectPath\n          ? readObject(join(options.projectPath, SPEC_DIR_NAME, 'config', 'project.json'), false)\n          : {}),\n      timestamp: 0,\n      schemaVersion: CONFIG_SCHEMA_VERSION,\n   "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `layer.data.schema_version·!==·undefined·&&·layer.data.schema_version·!==·CONFIG_SCHEMA_VERSION` with `⏎······layer.data.schema_version·!==·undefined·&&⏎······layer.data.schema_version·!==·CONFIG_SCHEMA_VERSION⏎····`","line":46,"column":9,"nodeType":null,"messageId":"replace","endLine":46,"endColumn":103,"fix":{"range":[2441,2535],"text":"\n      layer.data.schema_version !== undefined &&\n      layer.data.schema_version !== CONFIG_SCHEMA_VERSION\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎···`","line":52,"column":68,"nodeType":null,"messageId":"insert","endLine":52,"endColumn":68,"fix":{"range":[2767,2767],"text":"\n   "}}],"suppressedMessages":[],"errorCount":15,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":15,"fixableWarningCount":0,"source":"import { SPEC_DIR_NAME } from \"@specforge/types/directory-layout\";\nimport { readFileSync } from 'node:fs';\nimport { join } from 'node:path';\nimport { resolveSpecForgeUserRoot } from '@specforge/types/user-level-paths';\nimport { DEFAULT_CONFIG, CONFIG_SCHEMA_VERSION } from './constants';\nimport { mergeConfigLayers } from './config-merge';\nimport { validateAllLayers } from './config-validator';\nimport type { ConfigLayer, MergedConfig } from './types';\n\nfunction readObject(file: string, optional: boolean): Record<string, unknown> {\n  let text: string;\n  try { text = readFileSync(file, 'utf8'); }\n  catch (error) {\n    if (optional && (error as NodeJS.ErrnoException).code === 'ENOENT') return {};\n    throw new Error('CONFIGURATION_READ_FAILED');\n  }\n  return parseObject(text);\n}\n\nexport function parseConfigurationObject(text: string): Record<string, unknown> {\n  try {\n    const value = JSON.parse(text);\n    if (!value || typeof value !== 'object' || Array.isArray(value)) throw new Error();\n    return value;\n  } catch { throw new Error('CONFIGURATION_INVALID_OBJECT'); }\n}\nconst parseObject = parseConfigurationObject;\n\n/** Shared CLI/Daemon acceptance. Missing optional user config is not corruption. */\nexport function loadAcceptedConfigSync(options: {\n  projectPath?: string; userRoot?: string; runtime?: Record<string, unknown>;\n  env?: Record<string, string | undefined>;\n  /** Validated prospective project layer; controlled producer only, never a new persisted source. */\n  projectData?: Record<string, unknown>;\n} = {}): MergedConfig {\n  const env = options.env ?? process.env;\n  const runtime = { ...(env.SPECFORGE_CONFIG_OVERRIDES ? parseObject(env.SPECFORGE_CONFIG_OVERRIDES) : {}), ...options.runtime };\n  const userRoot = options.userRoot ?? resolveSpecForgeUserRoot();\n  const layers: ConfigLayer[] = [\n    { type: 'builtin', data: structuredClone(DEFAULT_CONFIG), timestamp: 0, schemaVersion: CONFIG_SCHEMA_VERSION },\n    { type: 'user', data: readObject(join(userRoot, 'config', 'config.json'), true), timestamp: 0, schemaVersion: CONFIG_SCHEMA_VERSION },\n    { type: 'project', data: options.projectData ?? (options.projectPath ? readObject(join(options.projectPath, SPEC_DIR_NAME, 'config', 'project.json'), false) : {}), timestamp: 0, schemaVersion: CONFIG_SCHEMA_VERSION },\n    { type: 'runtime', data: runtime, timestamp: 0, schemaVersion: CONFIG_SCHEMA_VERSION },\n  ];\n  for (const layer of layers) {\n    if (layer.data.schema_version !== undefined && layer.data.schema_version !== CONFIG_SCHEMA_VERSION) {\n      throw new Error('CONFIGURATION_SCHEMA_UNSUPPORTED');\n    }\n  }\n  const validation = validateAllLayers(layers);\n  const merged = mergeConfigLayers(layers);\n  if (!validation.valid || merged.metadata.validationErrors.length) throw new Error('CONFIGURATION_VALIDATION_FAILED');\n  return merged;\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\configuration\\src\\config-access.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":3,"column":3,"nodeType":null,"messageId":"delete","endLine":3,"endColumn":4,"fix":{"range":[34,35],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":11,"column":77,"nodeType":null,"messageId":"insert","endLine":11,"endColumn":77,"fix":{"range":[352,352],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":12,"column":34,"nodeType":null,"messageId":"insert","endLine":12,"endColumn":34,"fix":{"range":[386,386],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `message:·string,·public·readonly·code?:·string` with `⏎····message:·string,⏎····public·readonly·code?:·string⏎··`","line":18,"column":15,"nodeType":null,"messageId":"replace","endLine":18,"e