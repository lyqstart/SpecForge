with `⏎··········merged[key]·as·Record<string,·unknown>,⏎··········value·as·Record<string,·unknown>⏎········);`","line":151,"column":33,"nodeType":null,"messageId":"replace","endLine":151,"endColumn":106,"fix":{"range":[5116,5189],"text":"\n          merged[key] as Record<string, unknown>,\n          value as Record<string, unknown>\n        );"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":153,"column":28,"nodeType":null,"messageId":"insert","endLine":153,"endColumn":28,"fix":{"range":[5232,5232],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":155,"column":32,"nodeType":null,"messageId":"insert","endLine":155,"endColumn":32,"fix":{"range":[5272,5272],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":160,"column":48,"nodeType":null,"messageId":"insert","endLine":160,"endColumn":48,"fix":{"range":[5409,5409],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":161,"column":51,"nodeType":null,"messageId":"insert","endLine":161,"endColumn":51,"fix":{"range":[5460,5460],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":162,"column":60,"nodeType":null,"messageId":"insert","endLine":162,"endColumn":60,"fix":{"range":[5520,5520],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":165,"column":36,"nodeType":null,"messageId":"insert","endLine":165,"endColumn":36,"fix":{"range":[5591,5591],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":166,"column":38,"nodeType":null,"messageId":"insert","endLine":166,"endColumn":38,"fix":{"range":[5629,5629],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":179,"column":4,"nodeType":null,"messageId":"insert","endLine":179,"endColumn":4,"fix":{"range":[5930,5930],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":185,"column":5,"nodeType":null,"messageId":"insert","endLine":185,"endColumn":5,"fix":{"range":[6117,6117],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":187,"column":16,"nodeType":null,"messageId":"insert","endLine":187,"endColumn":16,"fix":{"range":[6134,6134],"text":";"}}],"suppressedMessages":[],"errorCount":63,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":63,"fixableWarningCount":0,"source":"/**\n * Configuration merge logic\n * Implements four-layer merge with deterministic behavior and sensitive field protection\n */\n\nimport { ConfigLayer, ConfigLayerType, MergedConfig, ValidationError } from './types'\nimport { SENSITIVE_FIELDS, CONFIG_SCHEMA_VERSION } from './constants'\nimport { logger } from './logger'\n\n/**\n * Deep merge two objects recursively\n * Later values override earlier values\n */\nfunction deepMerge(target: Record<string, unknown>, source: Record<string, unknown>): Record<string, unknown> {\n  const result = { ...target }\n\n  for (const [key, sourceValue] of Object.entries(source)) {\n    const targetValue = result[key]\n\n    // Handle arrays: replace (not concatenate)\n    if (Array.isArray(sourceValue) && Array.isArray(targetValue)) {\n      result[key] = sourceValue\n    }\n    // Handle objects: deep merge\n    else if (\n      sourceValue &&\n      typeof sourceValue === 'object' &&\n      !Array.isArray(sourceValue) &&\n      targetValue &&\n      typeof targetValue === 'object' &&\n      !Array.isArray(targetValue)\n    ) {\n      result[key] = deepMerge(targetValue as Record<string, unknown>, sourceValue as Record<string, unknown>)\n    }\n    // Handle primitives and mixed types: replace\n    else {\n      result[key] = sourceValue\n    }\n  }\n\n  return result\n}\n\n/**\n * Check if a field is sensitive\n */\nfunction isSensitiveField(key: string, sensitiveFields: string[]): boolean {\n  const keyParts = key.split('.')\n  const firstPart = keyParts[0]\n\n  // Credential aliases are protected at every nesting level, including arrays.\n  if (keyParts.some(part => /^(api[_-]?keys?|tokens?|secrets?|credentials?|passwords?|auth|authorization|bearer[_-]?tokens?|provider[_-]?credentials?|access[_-]?tokens?|refresh[_-]?tokens?|private[_-]?keys?)$/i.test(part))) return true\n\n  return sensitiveFields.some((sensitive) => {\n    const sensitiveParts = sensitive.split('.')\n    return firstPart === sensitiveParts[0]\n  })\n}\n\n/**\n * Validate that project layer doesn't override sensitive fields\n */\nfunction validateSensitiveFieldProtection(\n  layers: ConfigLayer[],\n  sensitiveFields: string[],\n): ValidationError[] {\n  const validationErrors: ValidationError[] = []\n  const projectLayer = layers.find((l) => l.type === 'project')\n\n  if (!projectLayer || Object.keys(projectLayer.data).length === 0) {\n    return validationErrors\n  }\n\n  // Check if project layer tries to define any sensitive fields\n  const visit = (data: Record<string, unknown>, prefix = ''): void => {\n  for (const [name, value] of Object.entries(data)) {\n    const key = prefix ? `${prefix}.${name}` : name\n    if (isSensitiveField(key, sensitiveFields)) {\n      const error: ValidationError = {\n        field: key,\n        message: `Project-level configuration cannot define sensitive field \"${key}\"`,\n        layer: 'project',\n        path: projectLayer.path,\n      }\n      validationErrors.push(error)\n      logger.warn('Sensitive field protection violation', { field: key, path: projectLayer.path })\n    } else if (value && typeof value === 'object') {\n      visit(value as Record<string, unknown>, key)\n    }\n  }\n  }\n  visit(projectLayer.data)\n\n  return validationErrors\n}\n\n/**\n * Merge configuration layers with deterministic behavior\n * \n * Layer priority (lowest to highest):\n * 1. Builtin defaults (code constants)\n * 2. User-level overrides (<OpenCode config>/sf-user/config/)\n * 3. Project-level overrides (<project>/.specforge/config/)\n * 4. Runtime overrides (CLI/env)\n * \n * Merge rules:\n * - Simple values: later layer overrides earlier\n * - Objects: deep merge\n * - Arrays: replace (not concatenate)\n * - Sensitive fields: project-level overrides are rejected\n */\nexport function mergeConfigLayers(\n  layers: ConfigLayer[],\n  sensitiveFields: string[] = [...SENSITIVE_FIELDS],\n): MergedConfig {\n  logger.debug('Starting configuration merge', { layerCount: layers.length })\n\n  // Validate sensitive field protection\n  const validationErrors = validateSensitiveFieldProtection(layers, sensitiveFields)\n\n  // Sort layers by priority (ensure correct order)\n  const layerOrder: ConfigLayerType[] = ['builtin', 'user', 'project', 'runtime']\n  const sortedLayers = [...layers].sort(\n    (a, b) => layerOrder.indexOf(a.type) - layerOrder.indexOf(b.type),\n  )\n\n  // Perform merge\n  const merged: Record<string, unknown> = {}\n  const sources: Record<string, ConfigLayerType> = {}\n\n  for (const layer of sortedLayers) {\n    logger.debug('Merging layer', { layer: layer.type, path: layer.path })\n\n    for (const [key, value] of Object.entries(layer.data)) {\n      // Skip sensitive field overrides from project layer\n      if (layer.type === 'project' && isSensitiveField(key, sensitiveFields)) {\n        logger.debug('Skipping sensitive field from project layer', { key })\n        continue\n      }\n\n      // For objects, deep merge; otherwise, replace\n      if (\n        value &&\n        typeof value === 'object' &&\n        !Array.isArray(value) &&\n        merged[key] &&\n        typeof merged[key] === 'object' &&\n        merged[key] !== null &&\n        !Array.isArray(merged[key])\n      ) {\n        merged[key] = deepMerge(merged[key] as Record<string, unknown>, value as Record<string, unknown>)\n      } else {\n        merged[key] = value\n      }\n      sources[key] = layer.type\n    }\n  }\n\n  // Sort keys for deterministic output (Object.keys order is not guaranteed)\n  const sortedKeys = Object.keys(merged).sort()\n  const sortedMerged: Record<string, unknown> = {}\n  const sortedSources: Record<string, ConfigLayerType> = {}\n\n  for (const key of sortedKeys) {\n    sortedMerged[key] = merged[key]\n    sortedSources[key] = sources[key]\n  }\n\n  const result: MergedConfig = {\n    layers: sortedLayers,\n    merged: sortedMerged,\n    sources: sortedSources,\n    metadata: {\n      mergedAt: 0, // Deterministic: use 0 instead of Date.now()\n      schemaVersion: CONFIG_SCHEMA_VERSION,\n      sensitiveFields,\n      validationErrors,\n    },\n  }\n\n  logger.info('Configuration merge completed', {\n    keyCount: Object.keys(sortedMerged).length,\n    layerCount: sortedLayers.length,\n    validationErrors: validationErrors.length,\n  })\n\n  return result\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\configuration\\src\\config-validator.ts","messages":[{"ruleId":"prettier/prettier","severity":2,"message":"Delete `·`","line":3,"column":3,"nodeType":null,"messageId":"delete","endLine":3,"endColumn":4,"fix":{"range":[34,35],"text":""}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":8,"column":55,"nodeType":null,"messageId":"insert","endLine":8,"endColumn":55,"fix":{"range":[225,225],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `·ConfigLayer,·ConfigLayerType,·ConfigSchema,·SensitiveFieldsConfig,·ValidationError·}·from·'./types'` with `⏎··ConfigLayer,⏎··ConfigLayerType,⏎··ConfigSchema,⏎··SensitiveFieldsConfig,⏎··ValidationError,⏎}·from·'./types';`","line":9,"column":9,"nodeType":null,"messageId":"replace","endLine":9,"endColumn":109,"fix":{"range":[234,334],"text":"\n  ConfigLayer,\n  ConfigLayerType,\n  ConfigSchema,\n  SensitiveFieldsConfig,\n  ValidationError,\n} from './types';"}},{"ruleId":"@typescript-eslint/no-unused-vars","severity":2,"message":"'CONFIG_SCHEMA_VERSION' is defined but never used.","line":10,"column":28,"nodeType":"Identifier","messageId":"unusedVar","endLine":10,"endColumn":49,"suggestions":[{"messageId":"removeUnusedVar","data":{"varName":"CONFIG_SCHEMA_VERSION"},"fix":{"range":[360,383],"text":""},"desc":"Remove unused variable \"CONFIG_SCHEMA_VERSION\"."}]},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":10,"column":70,"nodeType":null,"messageId":"insert","endLine":10,"endColumn":70,"fix":{"range":[404,404],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `;`","line":11,"column":34,"nodeType":null,"messageId":"insert","endLine":11,"endColumn":34,"fix":{"range":[438,438],"text":";"}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `⏎····`","line":21,"column":24,"nodeType":null,"messageId":"insert","endLine":21,"endColumn":24,"fix":{"range":[764,764],"text":"\n    "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":22,"column":5,"nodeType":null,"messageId":"insert","endLine":22,"endColumn":5,"fix":{"range":[778,778],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····` with `······`","line":23,"column":1,"nodeType":null,"messageId":"replace","endLine":23,"endColumn":5,"fix":{"range":[823,827],"text":"      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····` with `······`","line":24,"column":1,"nodeType":null,"messageId":"replace","endLine":24,"endColumn":5,"fix":{"range":[872,876],"text":"      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":25,"column":1,"nodeType":null,"messageId":"insert","endLine":25,"endColumn":1,"fix":{"range":[928,928],"text":"  "}},{"ruleId":"prettier/prettier","severity":2,"message":"Replace `····` with `······`","line":26,"column":1,"nodeType":null,"messageId":"replace","endLine":26,"endColumn":5,"fix":{"range":[992,996],"text":"      "}},{"ruleId":"prettier/prettier","severity":2,"message":"Insert `··`","line":27,"column":1,"nodeType":null,"messageId":"insert","endLine":27,"endColumn":1,"fix":{"range":[1060,1060],"text":"  