{
  "command": "services",
  "subcommand": "stop",
  "description": "stop the installed SpecForge/OpenCode user services",
  "parameters": [
    {
      "name": "--json",
      "type": "boolean",
      "required": false,
      "description": "Output as JSON"
    },
    {
      "name": "--timeout",
      "type": "number",
      "required": false,
      "description": "Stop timeout in seconds; default comes from accepted configuration"
    }
  ],
  "examples": [
    {
      "description": "Linux systemd user service operation",
      "command": "specforge services stop --json"
    }
  ]
}
