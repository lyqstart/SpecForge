ecuteDetachedGitBootstrap({\n        projectRoot,\n        workItemId,\n        baseBranch,\n        branchName,\n        planSha256: String(args['bootstrap_plan_sha256']),\n        confirmationQuote: String(args['bootstrap_confirmation_quote'] || ''),\n      });\n    }\n    if (args['bootstrap_confirmation_quote'] !== undefined)\n      throw Error('DETACHED_GIT_BOOTSTRAP_PLAN_REQUIRED');\n    return await createBranch({\n      projectRoot,\n      workItemId,\n      branchName,\n      baseBranch,\n      requireClean: args['require_clean'] !== false,\n    });\n  } catch (err) {\n    return {\n      success: false,\n      error: err instanceof Error ? err.message : String(err),\n    };\n  }\n});\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\handlers\\sf-git-branch-plan.ts","messages":[{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['work_item_id'] || ''' will use Object's default stringification format ('[object Object]') when stringified.","line":7,"column":29,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":7,"endColumn":55},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['title'] || ''' will use Object's default stringification format ('[object Object]') when stringified.","line":8,"column":24,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":8,"endColumn":43},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['work_item_type'] || 'feature'' will use Object's default stringification format ('[object Object]') when stringified.","line":9,"column":31,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":9,"endColumn":66},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'context?.directory || context?.worktree || process.cwd()' will use Object's default stringification format ('[object Object]') when stringified.","line":15,"column":32,"