 ? String(args['provider']) : undefined,\n      method,\n      sshKeyPath: args['ssh_key_path'] ? String(args['ssh_key_path']) : undefined,\n      sshHostAlias: args['ssh_host_alias'] ? String(args['ssh_host_alias']) : undefined,\n      tokenEnvVar: args['token_env_var'] ? String(args['token_env_var']) : undefined,\n      gitUserName: args['git_user_name'] ? String(args['git_user_name']) : undefined,\n      gitUserEmail: args['git_user_email'] ? String(args['git_user_email']) : undefined,\n      confirmed: args['confirmed'] === true,\n    });\n  } catch (err) {\n    return { success: false, error: err instanceof Error ? err.message : String(err) };\n  }\n});\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\tools\\handlers\\sf-git-branch-create.ts","messages":[{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['work_item_id'] || ''' will use Object's default stringification format ('[object Object]') when stringified.","line":9,"column":29,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":9,"endColumn":55},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['branch_name'] || ''' will use Object's default stringification format ('[object Object]') when stringified.","line":10,"column":29,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":10,"endColumn":54},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['base_branch'] || 'main'' will use Object's default stringification format ('[object Object]') when stringified.","line":12,"column":29,"nodeType":"LogicalExpression","messageId":"baseToString","endLine":12,"endColumn":58},{"ruleId":"@typescript-eslint/no-base-to-string","severity":2,"message":"'args['bootstrap_plan_sha256']' may use Object's default stringification format ('[object Object]') when stringified.","line":37,"column":28,"nodeType":"MemberExpression","messageId":"baseToString","e