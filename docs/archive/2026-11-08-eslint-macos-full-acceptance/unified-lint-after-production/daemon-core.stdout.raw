","endLine":124,"endColumn":64}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { SPEC_DIR_NAME } from '@specforge/types/directory-layout';\n/** Finite Task command grammar and conservative proof for single-file isolation normalization. */\nimport path from 'node:path';\nimport { createHash } from 'node:crypto';\nimport ts from 'typescript';\nimport { readVerificationFile } from './owner-store';\nimport {\n  isStaticTaskDeclaration,\n  compileStaticTaskCommand,\n  collectStaticTaskInputs,\n} from './static-task-command';\n\nexport const NODE_COMMAND_CONTRACT = 'readonly-node-command/v1' as const;\nexport interface FrozenNodeSource {\n  path: string;\n  content: string;\n  sha256: string;\n}\nexport interface NodeCommandPlan {\n  contract: typeof NODE_COMMAND_CONTRACT;\n  original: string;\n  kind: 'node-test-file' | 'node-inline';\n  argv: string[];\n  entry: string | null;\n  inlineSource: string | null;\n  semanticProof: {\n    rule: 'single-file-no-host-observation/v1' | 'finite-posix-readonly-predicate/v1';\n    inputHashes: Record<string, string>;\n  };\n}\n\nconst fail = (reason: string): never => {\n  throw new Error(`NODE_COMMAND_UNSUPPORTED:${reason}`);\n};\nconst hash = (text: string): string => createHash('sha256').update(text).digest('hex');\nconst commonFlags = ['--no-addons', '--preserve-symlinks', '--preserve-symlinks-main'];\nconst forbiddenNames = new Set([\n  'globalThis',\n  'global',\n  'Date',\n  'performance',\n  'crypto',\n  'Buffer',\n  'eval',\n  'Function',\n  '__dirname',\n  '__filename',\n  'WeakRef',\n  'FinalizationRegistry',\n  'Atomics',\n  'SharedArrayBuffer',\n  'Intl',\n  'navigator',\n  'setTimeout',\n  'setInterval',\n  'setImmediate',\n  'queueMicrotask',\n  'fetch',\n  'WebAssembly',\n  'Proxy',\n  'Reflect',\n  'Object',\n]);\nconst forbiddenProperties = new Set([\n  'constructor',\n  '__proto__',\n  'prototype',\n  'getPrototypeOf',\n  'setPrototypeOf',\n  'getOwnPropertyDescriptor',\n  'getOwnPropertyDescriptors',\n  'getOwnPropertyNames',\n  'getOwnPropertySymbols',\n  '__defineGetter__',\n  '__defineSetter__',\n  '__lookupGetter__',\n  '__lookupSetter__',\n  'caller',\n  'callee',\n  'arguments',\n  'stack',\n  'random',\n  'execArgv',\n  'argv',\n  'env',\n  'pid',\n  'ppid',\n  'main',\n  'parent',\n  'children',\n  'filename',\n  'resolve',\n  'cache',\n  'timeout',\n  'concurrency',\n  'skip',\n  'only',\n  'todo',\n  'run',\n  'mock',\n  'before',\n  'after',\n  'beforeEach',\n  'afterEach',\n]);\nconst pureGlobals = new Set([\n  'undefined',\n  'NaN',\n  'Infinity',\n  'String',\n  'Number',\n  'Boolean',\n  'BigInt',\n  'Math',\n  'JSON',\n  'Array',\n  'RegExp',\n]);\nconst builtins = new Set(['node:test', 'node:assert/strict']);\nconst inlineVirtualPath = '__sf_verification_inline.cjs';\n\n/** Quoting groups exact literals. No shell expansion, escaping or command operators are evaluated. */\nexport function tokenizeNodeDeclaration(command: string): string[] {\n  if (!command || command.length > 32768 || /[\\x00-\\x1f\\x7f$`]/.test(command)) fail('DECLARATION');\n  const tokens: string[] = [];\n  let token = '',\n    quote = '',\n    started = false,\n    closedQuote = false;\n  for (const char of command) {\n    if (quote) {\n      if (char === quote) {\n        quote = '';\n        closedQuote = true;\n      } else token += char;\n      started = true;\n      continue;\n    }\n    if (closedQuote && !/\\s/.test(char)) fail('CONCATENATED_QUOTING');\n    if (char === '\"' || char === \"'\") {\n      if (started) fail('CONCATENATED_QUOTING');\n      quote = char;\n      started = true;\n    } else if (/\\s/.test(char)) {\n      if (started) {\n        tokens.push(token);\n        token = '';\n        started = false;\n        closedQuote = false;\n      }\n    } else {\n      if (/[;&|<>`$%\\\\]/.test(char)) fail('SHELL_SYNTAX');\n      token += char;\n      started = true;\n    }\n  }\n  if (quote) fail('UNTERMINATED_QUOTE');\n  if (started) tokens.push(token);\n  return tokens;\n}\n\nfunction sourcePath(value: string): string {\n  if (\n    !value ||\n    value.includes('\\\\') ||\n    value.includes(':') ||\n    path.posix.isAbsolute(value) ||\n    value.split('/').some(p => !p || p === '..' || p === '.') ||\n    !/\\.(?:[cm]?js|ts)$/.test(value)\n  )\n    fail('SOURCE_PATH');\n  return value;\n}\n\nexport function compileNodeCommand(\n  original: string,\n  sources: readonly FrozenNodeSource[]\n): NodeCommandPlan {\n  if (isStaticTaskDeclaration(original)) return compileStaticTaskCommand(original, sources);\n  const argv = tokenizeNodeDeclaration(original);\n  if (argv[0] !== 'node' || argv.length !== 3 || !['--test', '-e'].includes(argv[1]))\n    fail('FIXED_NODE_GRAMMAR');\n  const kind = argv[1] === '--test' ? 'node-test-file' : 'node-inline';\n  const entry = kind === 'node-test-file' ? sourcePath(argv[2]) : null;\n  const inlineSource = kind === 'node-inline' ? argv[2] : null;\n  const byPath = new Map<string, FrozenNodeSource>();\n  for (const source of sources) {\n    const key = sourcePath(source.path);\n    if (byPath.has(key) || hash(source.content) !== source.sha256) fail('SOURCE_IDENTITY');\n    byPath.set(key, source);\n  }\n  const visited = new Set<string>(),\n    inputHashes: Record<string, string> = {};\n  function dependency(specifier: string, owner: string): void {\n    if (builtins.has(specifier)) return;\n    if (!specifier.startsWith('./') && !specifier.startsWith('../')) fail('DEPENDENCY');\n    const resolved = path.posix.normalize(path.posix.join(path.posix.dirname(owner), specifier));\n    sourcePath(resolved);\n    if (inlineSource !== null && resolved === inlineVirtualPath) fail('INLINE_INPUT_COLLISION');\n    inspect(resolved);\n  }\n  function inspect(name: string, inline?: string): void {\n    if (visited.has(name)) return;\n    visited.add(name);\n    const source = inline === undefined ? byPath.get(name) : undefined;\n    if (inline === undefined && !source) fail('SOURCE_MISSING:' + name);\n    const content = inline ?? source!.content;\n    if (source) inputHashes[name] = source.sha256;\n    const virtualName = '/__specforge_frozen__/' + name;\n    const file = ts.createSourceFile(\n      virtualName,\n      content,\n      ts.ScriptTarget.Latest,\n      true,\n      name.endsWith('.ts') ? ts.ScriptKind.TS : ts.ScriptKind.JS\n    );\n    if (\n      (file as ts.SourceFile & { parseDiagnostics: readonly ts.Diagnostic[] }).parseDiagnostics\n        .length\n    )\n      fail('SOURCE_SYNTAX');\n    const options: ts.CompilerOptions = {\n      noLib: true,\n      noResolve: true,\n      allowJs: true,\n      target: ts.ScriptTarget.Latest,\n    };\n    const host: ts.CompilerHost = {\n      getSourceFile: fileName => (fileName === virtualName ? file : undefined),\n      writeFile: () => {},\n      getDefaultLibFileName: () => '/__no_lib__.d.ts',\n      getCurrentDirectory: () => '/__specforge_frozen__',\n      getDirectories: () => [],\n      directoryExists: () => false,\n      fileExists: fileName => fileName === virtualName,\n      readFile: fileName => (fileName === virtualName ? content : undefined),\n      getCanonicalFileName: name => name,\n      useCaseSensitiveFileNames: () => true,\n      getNewLine: () => '\\n',\n      realpath: name => name,\n    };\n    const checker = ts.createProgram([virtualName], options, host).getTypeChecker();\n    const locallyBound = (node: ts.Identifier): boolean =>\n      (\n        (ts.isShorthandPropertyAssignment(node.parent)\n          ? checker.getShorthandAssignmentValueSymbol(node.parent)\n          : checker.getSymbolAtLocation(node)\n        )?.declarations ?? []\n      ).some(\n        d =>\n          d.getSourceFile() === file &&\n          (ts.isVariableDeclaration(d) ||\n            ts.isBindingElement(d) ||\n            ts.isParameter(d) ||\n            ts.isFunctionDeclaration(d) ||\n            ts.isFunctionExpression(d) ||\n            ts.isImportClause(d) ||\n            ts.isImportSpecifier(d) ||\n            ts.isNamespaceImport(d))\n      );\n    function visit(node: ts.Node): void {\n      if (\n        [\n          ts.SyntaxKind.MetaProperty,\n          ts.SyntaxKind.ElementAccessExpression,\n          ts.SyntaxKind.NewExpression,\n          ts.SyntaxKind.ThisKeyword,\n          ts.SyntaxKind.SuperKeyword,\n          ts.SyntaxKind.WithStatement,\n          ts.SyntaxKind.AwaitExpression,\n          ts.SyntaxKind.YieldExpression,\n          ts.SyntaxKind.ClassDeclaration,\n          ts.SyntaxKind.ClassExpression,\n          ts.SyntaxKind.EnumDeclaration,\n          ts.SyntaxKind.ModuleDeclaration,\n          ts.SyntaxKind.AsyncKeyword,\n          ts.SyntaxKind.ImportEqualsDeclaration,\n          ts.SyntaxKind.ComputedPropertyName,\n          ts.SyntaxKind.DeclareKeyword,\n        ].includes(node.kind)\n      )\n        fail('HOST_OBSERVATION_OR_UNSUPPORTED_SYNTAX');\n      if (\n        (ts.isImportClause(node) && node.isTypeOnly) ||\n        (ts.isImportSpecifier(node) && node.isTypeOnly)\n      )\n        fail('TYPE_ONLY_RUNTIME_BINDING');\n      if (ts.isImportDeclaration(node) || ts.isExportDeclaration(node)) {\n        const specifier = node.moduleSpecifier;\n        if (specifier) {\n          if (!ts.isStringLiteral(specifier)) fail('DYNAMIC_MODULE');\n          dependency((specifier as ts.StringLiteral).text, name);\n        }\n        if (\n          ts.isImportDeclaration(node) &&\n          ts.isStringLiteral(node.moduleSpecifier) &&\n          node.moduleSpecifier.text === 'node:test'\n        ) {\n          const bindings = node.importClause?.namedBindings;\n          if (\n            bindings &&\n            (!ts.isNamedImports(bindings) ||\n              bindings.elements.some(e => (e.propertyName ?? e.name).text !== 'test'))\n          )\n            fail('TEST_HOOK_OR_CONTEXT');\n        }\n      }\n      if (\n        ts.isCallExpression(node) &&\n        (node.expression.kind === ts.SyntaxKind.ImportKeyword ||\n          (ts.isIdentifier(node.expression) && node.expression.text === 'require'))\n      ) {\n        if (node.arguments.length !== 1 || !ts.isStringLiteral(node.arguments[0]))\n          fail('DYNAMIC_MODULE');\n        dependency((node.arguments[0] as ts.StringLiteral).text, name);\n      }\n      if (ts.isPropertyAccessExpression(node)) {\n        if (forbiddenProperties.has(node.name.text)) fail('OBSERVABLE_PROPERTY:' + node.name.text);\n        if (\n          ts.isIdentifier(node.expression) &&\n          node.expression.text === 'process' &&\n          (inline === undefined || node.name.text !== 'exit')\n        )\n          fail('PROCESS_OBSERVATION');\n        if (\n          ts.isIdentifier(node.expression) &&\n          node.expression.text === 'console' &&\n          (inline === undefined || node.name.text !== 'log')\n        )\n          fail('CONSOLE_OBSERVATION');\n      }\n      if (\n        ts.isPropertyAssignment(node) &&\n        ts.isStringLiteral(node.name) &&\n        forbiddenProperties.has(node.name.text)\n      )\n        fail('OBSERVABLE_OPTION');\n      if (ts.isIdentifier(node)) {\n        if (forbiddenNames.has(node.text) || forbiddenProperties.has(node.text))\n          fail('HOST_GLOBAL_OR_PROPERTY:' + node.text);\n        const parent = node.parent;\n        const property =\n          (ts.isPropertyAccessExpression(parent) && parent.name === node) ||\n          ((ts.isPropertyAssignment(parent) || ts.isMethodDeclaration(parent)) &&\n            parent.name === node) ||\n          ts.isImportSpecifier(parent) ||\n          ts.isExportSpecifier(parent);\n        const calledMember =\n          ts.isPropertyAccessExpression(parent) &&\n          parent.expression === node &&\n          ts.isCallExpression(parent.parent) &&\n          parent.parent.expression === parent;\n        const special =\n          (node.text === 'require' && ts.isCallExpression(parent) && parent.expression === node) ||\n          (/\\.cjs$/.test(name) &&\n            ts.isPropertyAccessExpression(parent) &&\n            parent.expression === node &&\n            ((node.text === 'module' && parent.name.text === 'exports') ||\n              node.text === 'exports')) ||\n          (inline !== undefined &&\n            calledMember &&\n            ((node.text === 'process' && parent.name.text === 'exit') ||\n              (node.text === 'console' && parent.name.text === 'log')));\n        if (\n          !property &&\n          !special &&\n          ['process', 'console', 'require', 'module', 'exports'].includes(node.text)\n        )\n          fail('HOST_IDENTIFIER_ALIAS:' + node.text);\n        if (!property && !special && !locallyBound(node) && !pureGlobals.has(node.text))\n          fail('UNBOUND_OR_HOST_IDENTIFIER:' + node.text);\n      }\n      if (\n        ts.isBindingElement(node) &&\n        node.propertyName &&\n        ts.isStringLiteral(node.propertyName) &&\n        forbiddenProperties.has(node.propertyName.text)\n      )\n        fail('DESTRUCTURED_HOST_PROPERTY');\n      ts.forEachChild(node, visit);\n    }\n    visit(file);\n  }\n  if (entry) inspect(entry);\n  else inspect(inlineVirtualPath, inlineSource!);\n  return {\n    contract: NODE_COMMAND_CONTRACT,\n    original,\n    kind,\n    entry,\n    inlineSource,\n    argv:\n      kind === 'node-test-file'\n        ? [...commonFlags, '--test-reporter=tap', '--test', '--test-isolation=none', entry!]\n        : [...commonFlags, '-e', inlineSource!],\n    semanticProof: { rule: 'single-file-no-host-observation/v1', inputHashes },\n  };\n}\n\n/** Discover only literal local code imports and required package metadata, never all project contents. */\nexport async function collectNodeCommandInputs(\n  projectRoot: string,\n  original: string,\n  trackedPaths: readonly string[]\n): Promise<{\n  sources: FrozenNodeSource[];\n  inputPaths: string[];\n}> {\n  if (isStaticTaskDeclaration(original))\n    return collectStaticTaskInputs(projectRoot, original, trackedPaths);\n  const args = tokenizeNodeDeclaration(original),\n    tracked = new Set(trackedPaths),\n    found = new Map<string, FrozenNodeSource>();\n  const metadata = new Set<string>();\n  if (args.length !== 3 || args[0] !== 'node' || !['--test', '-e'].includes(args[1]))\n    fail('FIXED_NODE_GRAMMAR');\n  async function inspect(name: string, inline?: string): Promise<void> {\n    if (found.has(name)) return;\n    let text = inline;\n    if (inline === undefined) {\n      sourcePath(name);\n      if (\n        name\n          .split('/')\n          .some(p => ['.git', SPEC_DIR_NAME, 'node_modules'].includes(p.toLowerCase())) ||\n        !tracked.has(name)\n      )\n        fail('INPUT_NOT_TRACKED_CODE');\n      const raw = await readVerificationFile(path.join(projectRoot, name));\n      text = raw.toString('utf8');\n      if (!Buffer.from(text).equals(raw)) fail('SOURCE_ENCODING');\n      found.set(name, { path: name, content: text, sha256: hash(text) });\n      if (found.size > 2048) fail('INPUT_COUNT');\n    }\n    for (let directory = path.posix.dirname(name); ; directory = path.posix.dirname(directory)) {\n      const pkg = path.posix.join(directory, 'package.json');\n      if (tracked.has(pkg)) metadata.add(pkg);\n      if (directory === '.') break;\n    }\n    const file = ts.createSourceFile(\n      name,\n      text!,\n      ts.ScriptTarget.Latest,\n      true,\n      name.endsWith('.ts') ? ts.ScriptKind.TS : ts.ScriptKind.JS\n    );\n    const dependencies: string[] = [];\n    function scan(node: ts.Node): void {\n      if ((ts.isImportDeclaration(node) || ts.isExportDeclaration(node)) && node.moduleSpecifier) {\n        if (!ts.isStringLiteral(node.moduleSpecifier)) fail('DYNAMIC_MODULE');\n        dependencies.push((node.moduleSpecifier as ts.StringLiteral).text);\n      }\n      if (\n        ts.isCallExpression(node) &&\n        (node.expression.kind === ts.SyntaxKind.ImportKeyword ||\n          (ts.isIdentifier(node.expression) && node.expression.text === 'require'))\n      ) {\n        if (node.arguments.length !== 1 || !ts.isStringLiteral(node.arguments[0]))\n          fail('DYNAMIC_MODULE');\n        dependencies.push((node.arguments[0] as ts.StringLiteral).text);\n      }\n      ts.forEachChild(node, scan);\n    }\n    scan(file);\n    for (const specifier of dependencies) {\n      if (builtins.has(specifier)) continue;\n      if (!specifier.startsWith('./') && !specifier.startsWith('../')) fail('DEPENDENCY');\n      const resolved = sourcePath(\n        path.posix.normalize(path.posix.join(path.posix.dirname(name), specifier))\n      );\n      if (args[1] === '-e' && resolved === inlineVirtualPath) fail('INLINE_INPUT_COLLISION');\n      await inspect(resolved);\n    }\n  }\n  if (args[1] === '--test') await inspect(sourcePath(args[2]));\n  else await inspect(inlineVirtualPath, args[2]);\n  return {\n    sources: [...found.values()],\n    inputPaths: [...new Set([...found.keys(), ...metadata])].sort(),\n  };\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\verification\\owner-store.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\verification\\rejection-diagnostic.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\verification\\request-context.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\verification\\source-snapshot.ts","messages":[{"ruleId":"no-control-regex","severity":2,"message":"Unexpected control character(s) in regular expression: \\x00, \\x1f.","line":44,"column":11,"nodeType":"Literal","messageId":"unexpected","endLine":44,"endColumn":31},{"ruleId":"@typescript-eslint/prefer-promise-reject-errors","severity":2,"message":"Expected the Promise rejection reason to be an Error.","line":95,"column":11,"nodeType":"CallExpression","messageId":"rejectAnError","endLine":95,"endColumn":24}],"suppressedMessages":[],"errorCount":2,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { SPEC_DIR_NAME } from '@specforge/types/directory-layout';\n/** Read-only Git plumbing plus physical/raw-byte inventory. Never invokes shell, filters or hooks. */\nimport * as fs from 'node:fs/promises';\nimport path from 'node:path';\nimport { execFile } from 'node:child_process';\nimport {\n  assertVerificationPath,\n  canonicalVerificationJson,\n  readVerificationFile,\n  verificationId,\n} from './owner-store';\nimport { verificationRejectionDiagnostic } from './rejection-diagnostic';\n\nexport interface VerificationInputFile {\n  path: string;\n  bytes: number;\n  sha256: string;\n  device: string;\n  inode: string;\n}\nexport interface VerificationSourceSnapshot {\n  projectRoot: string;\n  head: string;\n  branch: string;\n  indexSha256: string;\n  configSha256: string;\n  files: VerificationInputFile[];\n  trackedPaths: string[];\n  identity: string;\n}\n\nexport function assertVerificationRelativePath(relative: string): void {\n  if (\n    !relative ||\n    relative.includes('\\\\') ||\n    path.isAbsolute(relative) ||\n    relative\n      .split('/')\n      .some(\n        part =>\n          !part ||\n          part === '.' ||\n          part === '..' ||\n          /[<>:\"|?*\\x00-\\x1f]/.test(part) ||\n          /[. ]$/.test(part) ||\n          /^(con|prn|aux|nul|com[1-9]|lpt[1-9])(?:\\.|$)/i.test(part)\n      )\n  )\n    throw new Error('VERIFICATION_INPUT_PATH_INVALID');\n}\n\nfunction gitRead(root: string, args: string[]): Promise<string> {\n  const env: NodeJS.ProcessEnv = {};\n  for (const name of ['PATH', 'SystemRoot', 'WINDIR', 'TEMP', 'TMP', 'PATHEXT', 'SYSTEMDRIVE']) {\n    if (process.env[name] !== undefined) env[name] = process.env[name];\n  }\n  Object.assign(env, {\n    GIT_OPTIONAL_LOCKS: '0',\n    GIT_CONFIG_NOSYSTEM: '1',\n    GIT_CONFIG_GLOBAL: process.platform === 'win32' ? 'NUL' : '/dev/null',\n  });\n  return new Promise((resolve, reject) => {\n    execFile(\n      'git',\n      [\n        '--no-pager',\n        '-c',\n        'core.fsmonitor=false',\n        '-c',\n        'protocol.allow=never',\n        '-c',\n        `core.hooksPath=${process.platform === 'win32' ? 'NUL' : '/dev/null'}`,\n        '-c',\n        'gc.auto=0',\n        ...args,\n      ],\n      {\n        cwd: root,\n        env,\n        encoding: 'utf8',\n        windowsHide: true,\n        shell: false,\n        timeout: 15000,\n        maxBuffer: 16 * 1024 * 1024,\n      },\n      (error, stdout) => {\n        if (error) {\n          console.error(\n            JSON.stringify({\n              ...verificationRejectionDiagnostic(error),\n              stage: 'source_git_read',\n              git_operation: args[0],\n            })\n          );\n          reject(error);\n        } else resolve(stdout);\n      }\n    );\n  });\n}\n\nexport async function captureVerificationSource(\n  projectRoot: string,\n  inputPaths?: readonly string[]\n): Promise<VerificationSourceSnapshot> {\n  const root = path.resolve(projectRoot);\n  await assertVerificationPath(root);\n  await assertVerificationPath(path.join(root, '.git'));\n  if (!(await fs.lstat(path.join(root, '.git'))).isDirectory())\n    throw new Error('VERIFICATION_EXTERNAL_GIT_UNSUPPORTED');\n  const top = path.resolve((await gitRead(root, ['rev-parse', '--show-toplevel'])).trim());\n  const same = (a: string, b: string) =>\n    process.platform === 'win32' ? a.toLowerCase() === b.toLowerCase() : a === b;\n  if (\n    !same(top, root) ||\n    !same(\n      path.resolve(root, (await gitRead(root, ['rev-parse', '--git-common-dir'])).trim()),\n      path.join(root, '.git')\n    )\n  ) {\n    throw new Error('VERIFICATION_EXTERNAL_GIT_UNSUPPORTED');\n  }\n  const head = (await gitRead(root, ['rev-parse', '--verify', 'HEAD'])).trim();\n  const branch = (await gitRead(root, ['symbolic-ref', '--quiet', '--short', 'HEAD'])).trim();\n  if (!/^[a-f0-9]{40}$/.test(head) || !branch)\n    throw new Error('VERIFICATION_GIT_IDENTITY_REQUIRED');\n  const indexBefore = verificationId(await readVerificationFile(path.join(root, '.git', 'index')));\n  const configBefore = verificationId(\n    await readVerificationFile(path.join(root, '.git', 'config'))\n  );\n  for (const name of (await gitRead(root, ['ls-files', '--others', '--exclude-standard', '-z']))\n    .split('\\0')\n    .filter(Boolean)) {\n    assertVerificationRelativePath(name);\n    if (!name.toLowerCase().startsWith(`${SPEC_DIR_NAME}/` as const))\n      throw new Error('VERIFICATION_UNTRACKED_INPUT:' + name);\n  }\n  const files: VerificationInputFile[] = [],\n    trackedPaths: string[] = [],\n    identities = new Set<string>();\n  const selected = inputPaths === undefined ? null : new Set(inputPaths);\n  if (selected) for (const name of selected) assertVerificationRelativePath(name);\n  let total = 0;\n  for (const record of (await gitRead(root, ['ls-files', '--stage', '-z']))\n    .split('\\0')\n    .filter(Boolean)) {\n    const match = /^(100644|100755) [a-f0-9]{40} 0\\t(.+)$/.exec(record);\n    if (!match) throw new Error('VERIFICATION_INDEX_KIND_UNSUPPORTED');\n    const relative = match[2];\n    assertVerificationRelativePath(relative);\n    const identity = process.platform === 'win32' ? relative.toLowerCase() : relative;\n    if (identities.has(identity)) throw new Error('VERIFICATION_INPUT_PATH_ALIAS');\n    identities.add(identity);\n    if (relative.split('/').some(p => ['.git', 'node_modules'].includes(p.toLowerCase())))\n      throw new Error('VERIFICATION_DEPENDENCY_OR_GIT_INPUT');\n    if (relative.toLowerCase().startsWith(`${SPEC_DIR_NAME}/` as const)) continue;\n    trackedPaths.push(relative);\n    if (selected && !selected.has(relative)) continue;\n    const full = path.join(root, relative),\n      bytes = await readVerificationFile(full),\n      stat = await fs.lstat(full, { bigint: true });\n    total += bytes.length;\n    if (total > 16 * 1024 * 1024 || files.length >= 2048)\n      throw new Error('VERIFICATION_INPUT_BUDGET');\n    files.push({\n      path: relative,\n      bytes: bytes.length,\n      sha256: verificationId(bytes),\n      device: stat.dev.toString(),\n      inode: stat.ino.toString(),\n    });\n  }\n  files.sort((a, b) => a.path.localeCompare(b.path));\n  if (selected && files.length !== selected.size)\n    throw new Error('VERIFICATION_SELECTED_INPUT_NOT_TRACKED');\n  trackedPaths.sort();\n  const snapshot = {\n    projectRoot: root,\n    head,\n    branch,\n    indexSha256: indexBefore,\n    configSha256: configBefore,\n    files,\n    trackedPaths,\n  };\n  if (\n    head !== (await gitRead(root, ['rev-parse', '--verify', 'HEAD'])).trim() ||\n    branch !== (await gitRead(root, ['symbolic-ref', '--quiet', '--short', 'HEAD'])).trim() ||\n    indexBefore !== verificationId(await readVerificationFile(path.join(root, '.git', 'index'))) ||\n    configBefore !== verificationId(await readVerificationFile(path.join(root, '.git', 'config')))\n  )\n    throw new Error('VERIFICATION_GIT_CHANGED_DURING_SNAPSHOT');\n  return { ...snapshot, identity: verificationId(canonicalVerificationJson(snapshot)) };\n}\n\nexport async function readFrozenVerificationInputs(\n  snapshot: VerificationSourceSnapshot\n): Promise<Map<string, Buffer>> {\n  const inputs = new Map<string, Buffer>();\n  for (const file of snapshot.files) {\n    const full = path.join(snapshot.projectRoot, file.path),\n      bytes = await readVerificationFile(full),\n      stat = await fs.lstat(full, { bigint: true });\n    if (\n      bytes.length !== file.bytes ||\n      verificationId(bytes) !== file.sha256 ||\n      stat.dev.toString() !== file.device ||\n      stat.ino.toString() !== file.inode\n    ) {\n      throw new Error('VERIFICATION_SOURCE_CHANGED:' + file.path);\n    }\n    inputs.set(file.path, bytes);\n  }\n  return inputs;\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\verification\\static-task-command.ts","messages":[{"ruleId":"no-control-regex","severity":2,"message":"Unexpected control character(s) in regular expression: \\x00, \\x1f.","line":37,"column":45,"nodeType":"Literal","messageId":"unexpected","endLine":37,"endColumn":63}],"suppressedMessages":[],"errorCount":1,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"source":"import { SPEC_DIR_NAME } from '@specforge/types/directory-layout';\n/** Finite readonly predicates, normalized to the existing isolated Node inline backend. */\nimport path from 'node:path';\nimport { createHash } from 'node:crypto';\nimport { assertVerificationRelativePath } from './source-snapshot';\nimport { readVerificationFile } from './owner-store';\nimport type { FrozenNodeSource, NodeCommandPlan } from './node-command-contract';\n\nexport const STATIC_TASK_RULE = 'finite-posix-readonly-predicate/v1' as const;\ntype Declaration =\n  | { kind: 'files'; paths: string[] }\n  | {\n      kind: 'grep';\n      paths: [string];\n      pattern: string;\n      quiet: boolean;\n      negate: boolean;\n      extended: boolean;\n    };\nfunction fail(code: string): never {\n  throw Error('NODE_COMMAND_UNSUPPORTED:STATIC_' + code);\n}\nconst sha = (text: string) => createHash('sha256').update(text).digest('hex');\nconst flags = ['--no-addons', '--preserve-symlinks', '--preserve-symlinks-main'];\nexport const isStaticTaskDeclaration = (value: string) => /^(?:test|grep|!)\\s/.test(value);\nfunction relative(value: string): string {\n  assertVerificationRelativePath(value);\n  if (\n    !/^[A-Za-z0-9_.\\-/]+$/.test(value) ||\n    value.split('/').some(p => ['.git', SPEC_DIR_NAME, 'node_modules'].includes(p.toLowerCase())) ||\n    !/(?:\\.md|\\.json|\\.[cm]?js|\\.ts)$/.test(value)\n  )\n    fail('PATH');\n  return value;\n}\nexport function parseStaticTaskDeclaration(command: string): Declaration {\n  if (!command || command.length > 32768 || /[\\x00-\\x1f\\x7f`]/.test(command)) fail('DECLARATION');\n  if (command.startsWith('test ')) {\n    const pieces = command.split(' && ');\n    if (pieces.length > 64) fail('FILE_COUNT');\n    const paths = pieces.map(piece => {\n      const m = /^test -f ([A-Za-z0-9_.\\-/]+)$/.exec(piece);\n      if (!m) fail('FILE_GRAMMAR');\n      return relative(m[1]);\n    });\n    return { kind: 'files', paths };\n  }\n  const match = /^(! )?grep -(cE|qE|c|q) (['\"])(.*?)\\3 ([A-Za-z0-9_.\\-/]+)$/.exec(command);\n  if (!match || (match[1] && !match[2].startsWith('q'))) fail('GREP_GRAMMAR');\n  const pattern = match[4];\n  if (\n    !pattern ||\n    pattern.length > 1024 ||\n    /[^\\x20-\\x7e]/.test(pattern) ||\n    pattern.includes(match[3])\n  )\n    fail('PATTERN');\n  // Double quoted shell variables/substitution cannot be reproduced as fixed literals.\n  if (\n    match[3] === '\"' &&\n    (/\\$(?!$)|\\\\[^(){}|.*^$\\\\]/.test(pattern) ||\n      pattern.includes('\\\\\\\\') ||\n      pattern.includes('\\\\$'))\n  )\n    fail('QUOTED_EXPANSION');\n  return {\n    kind: 'grep',\n    paths: [relative(match[5])],\n    pattern,\n    quiet: match[2].startsWith('q'),\n    negate: !!match[1],\n    extended: match[2].endsWith('E'),\n  };\n}\nfunction finiteRegex(pattern: string, extended: boolean): string {\n  let output = '',\n    alternative = false;\n  const literal = (char: string) => char.replace(/[.*+?^${}()|[\\]\\\\]/g, '\\\\$&');\n  for (let i = 0; i < pattern.length; i++) {\n    const c = pattern[i];\n    if (c === '\\\\') {\n      const next = pattern[++i];\n      if (!next || !extended || !'(){}|.*^$\\\\[]'.includes(next)) fail('ESCAPE');\n      output += literal(next);\n      alternative = true;\n    } else if (c === '|' && extended) {\n      if (!alternative) fail('EMPTY_ALTERNATIVE');\n      output += '|';\n      alternative = false;\n    } else if (c === '^') {\n      if (alternative) fail('ANCHOR');\n      output += '^';\n    } else if (c === '$') {\n      if (i !== pattern.length - 1 && !(extended && pattern[i + 1] === '|')) fail('ANCHOR');\n      output += '(?![\\\\s\\\\S])';\n    } else if (c === '*') {\n      fail('REPETITION');\n    } else if (c === '.') {\n      output += '[\\\\s\\\\S]';\n      alternative = true;\n    } else {\n      if ('[]'.includes(c) || (extended && '()+?{}'.includes(c))) fail('REGEX_SYNTAX');\n      output += literal(c);\n      alternative = true;\n    }\n  }\n  if (!alternative) fail('EMPTY_ALTERNATIVE');\n  return output;\n}\nfunction countLines(text: string, pattern: string, unicode: boolean): number {\n  if (text === '') return 0;\n  const lines = text.split('\\n');\n  if (lines[lines.length - 1] === '') lines.pop();\n  const regex = new RegExp(pattern, unicode ? 'u' : '');\n  return lines.reduce((count, line) => count + (regex.test(line) ? 1 : 0), 0);\n}\nexport async function collectStaticTaskInputs(\n  root: string,\n  command: string,\n  trackedPaths: readonly string[]\n): Promise<{ sources: FrozenNodeSource[]; inputPaths: string[] }> {\n  const declaration = parseStaticTaskDeclaration(command),\n    inputPaths = [...new Set(declaration.paths)].sort(),\n    tracked = new Set(trackedPaths),\n    sources: FrozenNodeSource[] = [];\n  for (const name of inputPaths) {\n    if (!tracked.has(name)) fail('INPUT_NOT_TRACKED');\n    const raw = await readVerificationFile(path.join(root, name), 32768),\n      content = raw.toString('utf8');\n    if (!Buffer.from(content).equals(raw) || raw.includes(0)) fail('ENCODING');\n    sources.push({ path: name, content, sha256: sha(content) });\n  }\n  return { sources, inputPaths };\n}\nexport function compileStaticTaskCommand(\n  original: string,\n  sources: readonly FrozenNodeSource[]\n): NodeCommandPlan {\n  const declaration = parseStaticTaskDeclaration(original),\n    paths = [...new Set(declaration.paths)].sort(),\n    byPath = new Map(sources.map(s => [s.path, s]));\n  if (\n    byPath.size !== sources.length ||\n    JSON.stringify([...byPath.keys()].sort()) !== JSON.stringify(paths)\n  )\n    fail('INPUT_SET');\n  const inputHashes: Record<string, string> = {};\n  for (const name of paths) {\n    const source = byPath.get(name)!;\n    if (\n      source.sha256 !== sha(source.content) ||\n      Buffer.byteLength(source.content) > 32768 ||\n      source.content.includes('\\0')\n    )\n      fail('SOURCE_IDENTITY');\n    inputHashes[name] = source.sha256;\n  }\n  let inlineSource: string;\n  if (declaration.kind === 'files') {\n    // The complete native input-copy precondition proves every selected ordinary file exists.\n    inlineSource = 'process.exit(0);';\n  } else {\n    const source = byPath.get(declaration.paths[0])!,\n      pattern = finiteRegex(declaration.pattern, declaration.extended);\n    const bytes = Buffer.from(source.content, 'utf8').toString('latin1');\n    // Byte-oriented C matching and Unicode scalar matching must give identical evidence on these actual inputs.\n    if (countLines(bytes, pattern, false) !== countLines(source.content, pattern, true))\n      fail('LOCALE_AMBIGUITY');\n    inlineSource =\n      `const text=${JSON.stringify(bytes)};const lines=text===\"\"?[]:text.split(\"\\\\n\");if(lines.length&&lines[lines.length-1]===\"\")lines.pop();const regex=RegExp(${JSON.stringify(pattern)});let count=0;for(const line of lines){if(regex.test(line))count++;}` +\n      (declaration.quiet ? '' : 'console.log(String(count));') +\n      `process.exit(${declaration.negate ? 'count===0?0:1' : 'count>0?0:1'});`;\n  }\n  if (inlineSource.length > 32768 || Buffer.byteLength(inlineSource) > 32768) fail('INLINE_BUDGET');\n  return {\n    contract: 'readonly-node-command/v1',\n    original,\n    kind: 'node-inline',\n    argv: [...flags, '-e', inlineSource],\n    entry: null,\n    inlineSource,\n    semanticProof: { rule: STATIC_TASK_RULE, inputHashes },\n  };\n}\n","usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\verification\\verification-assets.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\verification\\verification-plan.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\verification\\verification-schema.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\wal\\WAL.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]},{"filePath":"D:\\code\\SpecForge\\.lint-review-a01\\packages\\daemon-core\\src\\wal\\index.ts","messages":[],"suppressedMessages":[],"errorCount":0,"fatalErrorCount":0,"warningCount":0,"fixableErrorCount":0,"fixableWarningCount":0,"usedDeprecatedRules":[]}]}
