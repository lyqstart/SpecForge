diff --git a/.github/workflows/code-quality.yml b/.github/workflows/code-quality.yml
index 7a4bd914..85113165 100644
--- a/.github/workflows/code-quality.yml
+++ b/.github/workflows/code-quality.yml
@@ -1,9 +1,9 @@
 name: Code Quality
 
-# 触发时机：向 main 推送，或提交 PR 到 main
+# 触发时机：main 与 codex 工作分支推送；保留已有平台事件兼容配置
 on:
   push:
-    branches: [main]
+    branches: [main, 'codex/**']
   pull_request:
     branches: [main]
 
@@ -89,26 +89,50 @@ jobs:
       - name: Verify workflow docs in sync with JSON
         run: bun run check-workflows
 
-  # ─── 单元测试 ────────────────────────────────────────────────────────────────
+  # Actual full regression and complete lint on every supported host.
   test:
-    name: 单元测试
-    runs-on: ubuntu-latest
-    timeout-minutes: 45
+    name: Full lint/build/regression (${{ matrix.os }})
+    runs-on: ${{ matrix.os }}
+    timeout-minutes: 60
+    strategy:
+      fail-fast: false
+      matrix:
+        os: [ubuntu-latest, windows-latest, macos-latest]
+    env:
+      SPECFORGE_CI_REPORT_DIR: ${{ runner.temp }}/specforge-full-regression
     steps:
       - name: 检出代码
         uses: actions/checkout@v4
+      - name: 安装 Node
+        uses: actions/setup-node@v4
+        with:
+          node-version: '24.19.0'
       - name: 安装 Bun
         uses: oven-sh/setup-bun@v2
         with:
           bun-version: '1.3.14'
+      - name: Bind pinned Windows verification Node
+        if: runner.os == 'Windows'
+        shell: pwsh
+        run: '"SPECFORGE_VERIFICATION_NODE_SOURCE=$((Get-Command node).Source)" >> $env:GITHUB_ENV'
       - name: 安装依赖
         run: bun install --frozen-lockfile
       - name: 构建当前发布 workspace
-        run: bun scripts/prepare-current-release.ts
+        run: node scripts/run-ci-regression.mjs build
+      - name: 完整 ESLint
+        run: node scripts/run-ci-regression.mjs lint
       - name: 运行当前发布 workspace 测试
-        run: bun scripts/test-workspace.ts
+        run: node scripts/run-ci-regression.mjs workspace
       - name: 运行当前 Root 测试
-        run: node scripts/run-root-tests.mjs current
+        run: node scripts/run-ci-regression.mjs root
+      - name: Upload complete raw regression evidence
+        if: always()
+        uses: actions/upload-artifact@v4
+        with:
+          name: full-regression-evidence-${{ matrix.os }}
+          path: ${{ runner.temp }}/specforge-full-regression
+          if-no-files-found: error
+          retention-days: 14
 
   # ─── 硬编码路径 Lint ────────────────────────────────────────────────────────
   lint-hardcoded-paths:
