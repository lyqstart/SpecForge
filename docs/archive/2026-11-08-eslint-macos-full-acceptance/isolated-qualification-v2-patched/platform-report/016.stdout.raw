{
  "command": "services",
  "subcommand": "start",
  "description": "start the installed SpecForge/OpenCode user services",
  "parameters": [
    {
      "name": "--json",
      "type": "boolean",
      "required": false,
      "description": "Output as JSON"
    }
  ],
  "examples": [
    {
      "description": "Linux systemd user service operation",
      "command": "specforge services start --json"
    }
  ]
}
