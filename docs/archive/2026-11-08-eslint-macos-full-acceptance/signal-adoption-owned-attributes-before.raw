# Source code executed or linted by Bun, TypeScript, ESLint, or Prettier must
# remain LF-idempotent across Windows, Linux, and macOS clean worktrees.
*.ts text eol=lf
*.tsx text eol=lf
*.mts text eol=lf
*.cts text eol=lf
*.js text eol=lf
*.jsx text eol=lf
*.mjs text eol=lf
*.cjs text eol=lf
packages/daemon-core/src/verification/windows/*.cs text eol=lf

# SpecForge generated workflow Skill docs are rendered and compared byte-for-byte.
setup/userlevel-opencode/skills/sf-workflow-*/SKILL.md text eol=lf
setup/userlevel-opencode/agents/sf-verifier.md text eol=lf
setup/userlevel-opencode/skills/superpowers-verification-before-completion/SKILL.md text eol=lf

# Kiro governance specifications are reviewed with git diff --check and must
# not reintroduce CRLF-only whitespace noise from Windows authoring tools.

# Sealed raw test outputs and source-byte snapshots must survive Git unchanged.
docs/archive/2026-10-19-config-activation-loss-evidence/** -text -diff

/templates/.specforge/config/observability.json text eol=lf
/setup/userlevel-opencode/templates/.specforge/config/observability.json text eol=lf
