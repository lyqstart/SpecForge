{
  "command": "opencode-server",
  "subcommand": "stop",
  "description": "stop the OpenCode user service",
  "parameters": [
    {
      "name": "--json",
      "type": "boolean",
      "required": false,
      "description": "Output as JSON",
      "aliases": [
        "-j"
      ],
      "default": false
    },
    {
      "name": "--timeout",
      "type": "number",
      "required": false,
      "description": "Stop timeout in seconds; default comes from accepted configuration"
    }
  ],
  "examples": [
    {
      "description": "Linux systemd user service operation",
      "command": "specforge opencode-server stop --json"
    }
  ]
}
