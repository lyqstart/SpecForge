-  hotReload: {
-    enabled: true,
-    debounceMs: 250,
-    watchPaths: [
-      '.env',
-      'config/',
-      'src/config/',
-      'settings.json'
-    ]
-  }
-})
+specforge config
+specforge config --help
 ```
 
