-  async verifyConnection(): Promise<void> {
-    return new Promise((resolve, reject) => {
-      const req = http.request(
-        {
-          hostname: '127.0.0.1',
-          port: this.port,
-          path: '/',
-          method: 'GET',
-          timeout: 5000,
-        },
-        (res) => {
-          if (res.statusCode === 200) {
-            resolve();
-          } else {
-            reject(new Error(`Unexpected status: ${res.statusCode}`));
-          }
-        }
-      );
-
-      req.on('error', (error) => {
