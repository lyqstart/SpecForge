-### Validating a Definition
-
-```typescript
-const result = loader.validate(definition);
-
-if (result.valid) {
-  console.log('Workflow definition is valid');
-} else {
-  console.log('Validation errors:');
-  result.errors.forEach(error => {
-    console.log(`  ${error.field}: ${error.message}`);
-  });
-}
