{
  "command": "opencode-server",
  "subcommand": "install-service",
  "description": "install-service the OpenCode user service",
  "parameters": [
    {
      "name": "--json",
      "type": "boolean",
      "required": false,
      "description": "Output as JSON",
      "aliases": [
        "-j"
      ],
      "default": false
    }
  ],
  "examples": [
    {
      "description": "Linux systemd user service operation",
      "command": "specforge opencode-server install-service --json"
    }
  ]
}
